uccessor of a `pos_num`.", "p": "mathlib"}, {"name": "num.has_le", "description": "", "p": "mathlib"}, {"name": "cast_pos_num", "description": "`cast_pos_num` casts a `pos_num` into any type which has `1` and `+`.", "p": "mathlib"}, {"name": "znum.has_reflect", "description": "", "p": "mathlib"}, {"name": "pos_num.mod'", "description": "Modulus of `pos_num`s.", "p": "mathlib"}, {"name": "pos_num.pred'", "description": "The predecessor of a `pos_num` as a `num`.", "p": "mathlib"}, {"name": "num.gcd", "description": "Greatest Common Divisor (GCD) of two `num`s.", "p": "mathlib"}, {"name": "num.div", "description": "Division of `num`s, where `x / 0 = 0`.", "p": "mathlib"}, {"name": "pos_num.has_mul", "description": "", "p": "mathlib"}, {"name": "num.mul", "description": "Multiplication of two `num`s.", "p": "mathlib"}, {"name": "pos_num.size", "description": "The number of bits of a `pos_num`, as a `pos_num`.", "p": "mathlib"}, {"name": "pos_num.div'", "description": "Division of `pos_num`,", "p": "mathlib"}, {"name": "pos_num.divmod", "description": "`divmod x y = (y / x, y % x)`.", "p": "mathlib"}, {"name": "num.decidable_le", "description": "", "p": "mathlib"}, {"name": "pos_num.sub", "description": "Subtraction of `pos_num`s, where if `a < b`, then `a - b = 1`.", "p": "mathlib"}, {"name": "cast_num", "description": "`cast_num` casts a `num` into any type which has `0`, `1` and `+`.", "p": "mathlib"}, {"name": "pos_num.decidable_lt", "description": "", "p": "mathlib"}, {"name": "znum.succ", "description": "The successor of a `znum`.", "p": "mathlib"}, {"name": "num.mod", "description": "Modulus of `num`s.", "p": "mathlib"}, {"name": "num.decidable_lt", "description": "", "p": "mathlib"}, {"name": "cast_znum", "description": "`cast_znum` casts a `znum` into any type which has `0`, `1`, `+` and `neg`", "p": "mathlib"}, {"name": "znum.pred", "description": "The predecessor of a `znum`.", "p": "mathlib"}, {"name": "num.has_sub", "description": "", "p": "mathlib"}, {"name": "num.succ", "description": "The successor of a `num` as a `num`.", "p": "mathlib"}, {"name": "pos_num.pred", "description": "The predecessor of a `pos_num` as a `pos_num`. This means that `pred 1 = 1`.", "p": "mathlib"}, {"name": "num.to_znum_neg", "description": "Converts `x : num` to `-x : znum`.", "p": "mathlib"}, {"name": "num.of_znum'", "description": "Converts a `znum` to an `option num`, where `of_znum' p = none` if `p < 0`.", "p": "mathlib"}, {"name": "znum.bitm1", "description": "`bitm1 x` appends a `1` to the end of `x`, mapping `x` to `2 * x - 1`.", "p": "mathlib"}, {"name": "znum.has_one", "description": "", "p": "mathlib"}, {"name": "znum.add", "description": "Addition of `znum`s.", "p": "mathlib"}, {"name": "pos_num.has_one", "description": "", "p": "mathlib"}, {"name": "pos_num.mul", "description": "Multiplication of two `pos_num`s.", "p": "mathlib"}, {"name": "pos_num.nat_size", "description": "The number of bits of a `pos_num`, as a `nat`.", "p": "mathlib"}, {"name": "num.bit", "description": "`bit b n` appends the bit `b` to the end of `n`, where `bit tt x = x1` and `bit ff x = x0`.", "p": "mathlib"}, {"name": "pos_num.cmp", "description": "Ordering of `pos_num`s.", "p": "mathlib"}, {"name": "num", "description": "The type of nonnegative binary numbers, using `pos_num`.\n\n    13 = 1101(base 2) = pos (bit1 (bit0 (bit1 one)))", "p": "mathlib"}, {"name": "num.zero", "description": "The type of nonnegative binary numbers, using `pos_num`.\n\n    13 = 1101(base 2) = pos (bit1 (bit0 (bit1 one)))", "p": "mathlib"}, {"name": "num.pos", "description": "The type of nonnegative binary numbers, using `pos_num`.\n\n    13 = 1101(base 2) = pos (bit1 (bit0 (bit1 one)))", "p": "mathlib"}, {"name": "pos_num.has_sub", "description": "", "p": "mathlib"}, {"name": "num.add", "description": "Addition of two `num`s.", "p": "mathlib"}, {"name": "znum.inhabited", "description": "", "p": "mathlib"}, {"name": "num.nat_size", "description": "The number of bits required to represent a `num`, as a `nat`. `size 0` is defined to be `0`.", "p": "mathlib"}, {"name": "pos_num.has_reflect", "description": "", "p": "mathlib"}, {"name": "znum.has_lt", "description": "", "p": "mathlib"}, {"name": "znum.gcd", "description": "Greatest Common Divisor (GCD) of two `znum`s.", "p": "mathlib"}, {"name": "num.has_zero", "description": "", "p": "mathlib"}, {"name": "num.decidable_eq", "description": "", "p": "mathlib"}, {"name": "znum.has_mod", "description": "", "p": "mathlib"}, {"name": "pos_num.of_nat_succ", "description": "`of_nat_succ n` is the `pos_num` corresponding to `n + 1`.", "p": "mathlib"}, {"name": "znum.mod", "description": "Modulus of `znum`s.", "p": "mathlib"}, {"name": "pos_num.decidable_le", "description": "", "p": "mathlib"}, {"name": "num.bit0", "description": "`bit0 n` appends a `0` to the end of `n`, where `bit0 n = n0`.", "p": "mathlib"}, {"name": "num.of_znum", "description": "Converts a `znum` to an `option num`, where `of_znum p = 0` if `p < 0`.", "p": "mathlib"}, {"name": "pos_num.is_one", "description": "Returns a boolean for whether the `pos_num` is `one`.", "p": "mathlib"}, {"name": "znum.bit1", "description": "`bit1 x` appends a `1` to the end of `x`, mapping `x` to `2 * x + 1`.", "p": "mathlib"}, {"name": "znum.cmp", "description": "Ordering on `znum`s.", "p": "mathlib"}, {"name": "pos_num.inhabited", "description": "", "p": "mathlib"}, {"name": "pos_num", "description": "The type of positive binary numbers.\n\n    13 = 1101(base 2) = bit1 (bit0 (bit1 one))", "p": "mathlib"}, {"name": "pos_num.one", "description": "The type of positive binary numbers.\n\n    13 = 1101(base 2) = bit1 (bit0 (bit1 one))", "p": "mathlib"}, {"name": "pos_num.bit1", "description": "The type of positive binary numbers.\n\n    13 = 1101(base 2) = bit1 (bit0 (bit1 one))", "p": "mathlib"}, {"name": "pos_num.bit0", "description": "The type of positive binary numbers.\n\n    13 = 1101(base 2) = bit1 (bit0 (bit1 one))", "p": "mathlib"}, {"name": "znum.has_repr", "description": "", "p": "mathlib"}, {"name": "pos_num.of_nat", "description": "`of_nat n` is the `pos_num` corresponding to `n`, except for `of_nat 0 = 1`.", "p": "mathlib"}, {"name": "pos_num_coe", "description": "", "p": "mathlib"}, {"name": "num.cmp", "description": "Ordering of `num`s.", "p": "mathlib"}, {"name": "num.psub", "description": "Subtraction of two `num`s, producing an `option num`.", "p": "mathlib"}, {"name": "znum.zneg", "description": "The negation of a `znum`.", "p": "mathlib"}, {"name": "num.has_add", "description": "", "p": "mathlib"}, {"name": "znum.div", "description": "Division of `znum`, where `x / 0 = 0`.", "p": "mathlib"}, {"name": "num.has_reflect", "description": "", "p": "mathlib"}, {"name": "pos_num.add", "description": "Addition of two `pos_num`s.", "p": "mathlib"}, {"name": "pos_num.decidable_eq", "description": "", "p": "mathlib"}, {"name": "num.of_nat'", "description": "Converts a `nat` to a `num`.", "p": "mathlib"}, {"name": "num.div2", "description": "Divides a `num` by `2`", "p": "mathlib"}, {"name": "pos_num.of_znum", "description": "Converts a `znum` to a `pos_num`, mapping all out of range values to `1`.", "p": "mathlib"}, {"name": "znum.mul", "description": "Multiplication of `znum`s.", "p": "mathlib"}, {"name": "num.size", "description": "The number of bits required to represent a `num`, as a `num`. `size 0` is defined to be `0`.", "p": "mathlib"}, {"name": "pos_num.has_le", "description": "", "p": "mathlib"}, {"name": "znum.of_int'", "description": "Converts an `int` to a `znum`.", "p": "mathlib"}, {"name": "pos_num.has_add", "description": "", "p": "mathlib"}, {"name": "num.to_znum", "description": "Converts a `num` to a `znum`.", "p": "mathlib"}, {"name": "znum", "description": "Representation of integers using trichotomy around zero.\n\n    13 = 1101(base 2) = pos (bit1 (bit0 (bit1 one)))\n    -13 = -1101(base 2) = neg (bit1 (bit0 (bit1 one)))", "p": "mathlib"}, {"name": "znum.zero", "description": "Representation of integers using trichotomy around zero.\n\n    13 = 1101(base 2) = pos (bit1 (bit0 (bit1 one)))\n    -13 = -1101(base 2) = neg (bit1 (bit0 (bit1 one)))", "p": "mathlib"}, {"name": "znum.pos", "description": "Representation of integers using trichotomy around zero.\n\n    13 = 1101(base 2) = pos (bit1 (bit0 (bit1 one)))\n    -13 = -1101(base 2) = neg (bit1 (bit0 (bit1 one)))", "p": "mathlib"}, {"name": "znum.neg", "description": "Representation of integers using trichotomy around zero.\n\n    13 = 1101(base 2) = pos (bit1 (bit0 (bit1 one)))\n    -13 = -1101(base 2) = neg (bit1 (bit0 (bit1 one)))", "p": "mathlib"}, {"name": "pos_num.bit", "description": "`bit b n` appends the bit `b` to the end of `n`, where `bit tt x = x1` and `bit ff x = x0`.", "p": "mathlib"}, {"name": "num.sub", "description": "Subtraction of two `num`s, where if `a < b`, `a - b = 0`.", "p": "mathlib"}, {"name": "znum.abs", "description": "The absolute value of a `znum` as a `num`.", "p": "mathlib"}, {"name": "num_nat_coe", "description": "", "p": "mathlib"}, {"name": "znum.decidable_le", "description": "", "p": "mathlib"}, {"name": "num.ppred", "description": "The predecessor of a `num` as an `option num`, where `ppred 0 = none`", "p": "mathlib"}, {"name": "num.has_div", "description": "", "p": "mathlib"}, {"name": "pos_num.divmod_aux", "description": "Auxiliary definition for `pos_num.divmod`.", "p": "mathlib"}, {"name": "num.has_one", "description": "", "p": "mathlib"}, {"name": "num.pred", "description": "The predecessor of a `num` as a `num`, where `pred 0 = 0`.", "p": "mathlib"}, {"name": "num.gcd_aux", "description": "Auxiliary definition for `num.gcd`.", "p": "mathlib"}, {"name": "num.inhabited", "description": "", "p": "mathlib"}, {"name": "num.bit1", "description": "`bit1 n` appends a `1` to the end of `n`, where `bit1 n = n1`.", "p": "mathlib"}, {"name": "pos_num.has_repr", "description": "", "p": "mathlib"}, {"name": "num.has_repr", "description": "", "p": "mathlib"}, {"name": "znum.has_mul", "description": "", "p": "mathlib"}, {"name": "znum.bit0", "description": "`bit0 n` appends a `0` to the end of `n`, where `bit0 n = n0`.", "p": "mathlib"}, {"name": "znum.has_le", "description": "", "p": "mathlib"}, {"name": "num.has_mod", "description": "", "p": "mathlib"}, {"name": "pos_num.sub'", "description": "Subtraction of two `pos_num`s, producing a `znum`.", "p": "mathlib"}, {"name": "pos_num.of_znum'", "description": "Converts a `znum` to `option pos_num`, where it is `some` if the `znum` was positive and `none`\notherwise.", "p": "mathlib"}, {"name": "znum.has_zero", "description": "", "p": "mathlib"}, {"name": "pos_num.has_lt", "description": "", "p": "mathlib"}, {"name": "znum.has_add", "description": "", "p": "mathlib"}, {"name": "num.has_lt", "description": "", "p": "mathlib"}, {"name": "num.has_mul", "description": "", "p": "mathlib"}, {"name": "num.sub'", "description": "Subtraction of two `num`s, producing a `znum`.", "p": "mathlib"}, {"name": "znum_coe", "description": "", "p": "mathlib"}, {"name": "znum.has_div", "description": "", "p": "mathlib"}, {"name": "znum.has_neg", "description": "", "p": "mathlib"}, {"name": "num.succ'", "description": "The successor of a `num` as a `pos_num`.", "p": "mathlib"}, {"name": "equiv.perm.same_cycle.of_apply_left", "description": "**Alias** of the forward direction of `equiv.perm.same_cycle_apply_left`.", "p": "mathlib"}, {"name": "equiv.perm.is_cycle_on.zpow_apply_eq", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle.conj", "description": "", "p": "mathlib"}, {"name": "equiv.perm.same_cycle_pow_right", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle.is_cycle_on", "description": "", "p": "mathlib"}, {"name": "equiv.perm.same_cycle.trans", "description": "", "p": "mathlib"}, {"name": "equiv.perm.same_cycle.rfl", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle.cycle_of_eq", "description": "", "p": "mathlib"}, {"name": "equiv.perm.cycle_of_