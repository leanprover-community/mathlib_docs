_.equiv_lax_monoidal_functor_punit.Mon_to_lax_monoidal_obj_\u03b5", "description": "", "p": "mathlib"}, {"name": "Mon_.Mon_tensor_mul_one", "description": "", "p": "mathlib"}, {"name": "Mon_.one_mul_hom", "description": "", "p": "mathlib"}, {"name": "Mon_.equiv_lax_monoidal_functor_punit_counit_iso", "description": "", "p": "mathlib"}, {"name": "Mon_.quiver.hom.hom.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "Mon_.one_left_unitor", "description": "", "p": "mathlib"}, {"name": "Mon_.mul_one_hom", "description": "", "p": "mathlib"}, {"name": "Mon_.trivial", "description": "The trivial monoid object. We later show this is initial in `Mon_ C`.", "p": "mathlib"}, {"name": "Mon_.Mon_monoidal", "description": "", "p": "mathlib"}, {"name": "Mon_.mul_assoc", "description": "", "p": "mathlib"}, {"name": "Mon_.comp", "description": "Composition of morphisms of monoid objects.", "p": "mathlib"}, {"name": "category_theory.lax_monoidal_functor.map_Mon_functor", "description": "`map_Mon` is functorial in the lax monoidal functor.", "p": "mathlib"}, {"name": "Mon_.equiv_lax_monoidal_functor_punit.lax_monoidal_to_Mon_map", "description": "", "p": "mathlib"}, {"name": "Mon_.trivial_mul", "description": "", "p": "mathlib"}, {"name": "Mon_.category_theory.category", "description": "", "p": "mathlib"}, {"name": "Mon_.one_mul", "description": "", "p": "mathlib"}, {"name": "category_theory.lax_monoidal_functor.map_Mon_obj_one", "description": "", "p": "mathlib"}, {"name": "Mon_.equiv_lax_monoidal_functor_punit.Mon_to_lax_monoidal_obj_\u03bc", "description": "", "p": "mathlib"}, {"name": "Mon_.one_associator", "description": "", "p": "mathlib"}, {"name": "Mon_.equiv_lax_monoidal_functor_punit_inverse", "description": "", "p": "mathlib"}, {"name": "Mon_.equiv_lax_monoidal_functor_punit.counit_iso_inv_app_hom", "description": "", "p": "mathlib"}, {"name": "Mon_.mul_left_unitor", "description": "", "p": "mathlib"}, {"name": "Mon_.equiv_lax_monoidal_functor_punit.Mon_