.commute.zpow_self", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_neg_mul_zpow_self", "description": "", "p": "mathlib"}, {"name": "matrix.one_zpow", "description": "", "p": "mathlib"}, {"name": "matrix.pow_inv_comm'", "description": "", "p": "mathlib"}, {"name": "matrix.semiconj_by.zpow_right", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_neg_one", "description": "", "p": "mathlib"}, {"name": "matrix.div_inv_monoid", "description": "", "p": "mathlib"}, {"name": "matrix.commute.zpow_right", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_one_add", "description": "", "p": "mathlib"}, {"name": "matrix.commute.zpow_zpow", "description": "", "p": "mathlib"}, {"name": "matrix.conj_transpose_zpow", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_add_of_nonneg", "description": "", "p": "mathlib"}, {"name": "matrix.transpose_zpow", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_add", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_neg", "description": "", "p": "mathlib"}, {"name": "matrix.inv_pow'", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_add_of_nonpos", "description": "", "p": "mathlib"}, {"name": "matrix.pow_sub'", "description": "", "p": "mathlib"}, {"name": "matrix.zero_zpow", "description": "", "p": "mathlib"}, {"name": "matrix.one_div_zpow", "description": "", "p": "mathlib"}, {"name": "matrix.is_unit_det_zpow_iff", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_bit1", "description": "", "p": "mathlib"}, {"name": "matrix.zero_zpow_eq", "description": "", "p": "mathlib"}, {"name": "matrix.commute.mul_zpow", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_ne_zero_of_is_unit_det", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_sub_one", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_neg_coe_nat", "description": "", "p": "mathlib"}, {"name": "matrix.inv_zpow'", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_bit1'", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_add_one", "description": "", "p": "mathlib"}, {"name": "matrix.commute.zpow_zpow_self", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_add_one_of_ne_neg_one", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_sub", "description": "", "p": "mathlib"}, {"name": "matrix.one_div_pow", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_coe_nat", "description": "", "p": "mathlib"}, {"name": "matrix.zpow_mul", "description": "", "p": "mathlib"}, {"name": "ring_hom.stable_under_composition.respects_iso", "description": "", "p": "mathlib"}, {"name": "ring_hom.stable_under_base_change.mk", "description": "", "p": "mathlib"}, {"name": "ring_hom.respects_iso.cancel_left_is_iso", "description": "", "p": "mathlib"}, {"name": "ring_hom.stable_under_base_change.pushout_inl", "description": "", "p": "mathlib"}, {"name": "ring_hom.stable_under_composition", "description": " A property is `stable_under_composition` if the composition of two such morphisms\nstill falls in the class.", "p": "mathlib"}, {"name": "ring_hom.stable_under_base_change", "description": " A morphism property `P` is `stable_under_base_change` if `P(S \u2192+* A)` implies\n`P(B \u2192+* A \u2297[S] B)`.", "p": "mathlib"}, {"name": "ring_hom.respects_iso.is_localization_away_iff", "description": "", "p": "mathlib"}, {"name": "ring_hom.respects_iso.cancel_right_is_iso", "description": "", "p": "mathlib"}, {"name": "ring_hom.respects_iso", "description": "A property `respects_iso` if it still holds when composed with an isomorphism", "p": "mathlib"}, {"name": "projectivization.independent_iff_complete_lattice_independent", "description": " A family of points in projective space is independent if and only if the family of\nsubmodules which the points determine is independent in the lattice-theoretic sense.", "p": "mathlib"}, {"name": "projectivization.dependent_pair_iff_eq", "description": "Two points in a projective space are dependent if and only if they are equal.", "p": "mathlib"}, {"name": "projectivization.dependent_iff", "description": " A family of points in a projective space is dependent if and only if their\nrepresentatives are linearly dependent.", "p": "mathlib"}, {"name": "projectivization.dependent_iff_not_independent", "description": "Dependence is the negation of independence.", "p": "mathlib"}, {"name": "projectivization.independent_iff_not_dependent", "description": "Independence is the negation of dependence.", "p": "mathlib"}, {"name": "projectivization.independent_iff", "description": " A family of points in a projective space is independent if and only if the representative\nvectors determined by the family are linearly independent.", "p": "mathlib"}, {"name": "projectivization.dependent", "description": " A linearly dependent family of nonzero vectors gives a dependent family of points\nin projective space.", "p": "mathlib"}, {"name": "projectivization.dependent.mk", "description": " A linearly dependent family of nonzero vectors gives a dependent family of points\nin projective space.", "p": "mathlib"}, {"name": "projectivization.independent_pair_iff_neq", "description": "Two points in a projective space are independent if and only if the points are not equal.", "p": "mathlib"}, {"name": "projectivization.independent", "description": " A linearly independent family of nonzero vectors gives an independent family of points\nin projective space.", "p": "mathlib"}, {"name": "projectivization.independent.mk", "description": " A linearly independent family of nonzero vectors gives an independent family of points\nin projective space.", "p": "mathlib"}, {"name": "nat.double_factorial_add_two", "description": "", "p": "mathlib"}, {"name": "nat.double_factorial_eq_prod_even", "description": "", "p": "mathlib"}, {"name": "nat.double_factorial_two_mul", "description": "", "p": "mathlib"}, {"name": "nat.double_factorial", "description": "`nat.double_factorial n` is the double factorial of `n`.", "p": "mathlib"}, {"name": "nat.double_factorial_add_one", "description": "", "p": "mathlib"}, {"name": "nat.factorial_eq_mul_double_factorial", "description": "", "p": "mathlib"}, {"name": "nat.double_factorial_eq_prod_odd", "description": "", "p": "mathlib"}, {"name": "witt_vector.from_padic_int_comp_to_padic_int", "description": "", "p": "mathlib"}, {"name": "witt_vector.from_padic_int_comp_to_padic_int_ext", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.eq_of_le_of_cast_pow_eq_zero", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.card_zmod", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.commutes", "description": "The following diagram commutes:\n```text\n          zmod (p^n) ----------------------------> zmod (p^m)\n            |                                        |\n            |                                        |\n            v                                        v\ntruncated_witt_vector p n (zmod p) ----> truncated_witt_vector p m (zmod p)\n```\nHere the vertical arrows are `truncated_witt_vector.zmod_equiv_trunc`,\nthe horizontal arrow at the top is `zmod.cast_hom`,\nand the horizontal arrow at the bottom is `truncated_witt_vector.truncate`.", "p": "mathlib"}, {"name": "witt_vector.from_padic_int", "description": "`from_padic_int` uses `witt_vector.lift` to lift `truncated_witt_vector.zmod_equiv_trunc`\ncomposed with `padic_int.to_zmod_pow` to a ring hom `\u2124_[p] \u2192+* \ud835\udd4e (zmod p)`.", "p": "mathlib"}, {"name": "witt_vector.equiv", "description": "The ring of Witt vectors over `zmod p` is isomorphic to the ring of `p`-adic integers. This\nequivalence is witnessed by `witt_vector.to_padic_int` with inverse `witt_vector.from_padic_int`.", "p": "mathlib"}, {"name": "truncated_witt_vector.commutes'", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.zmod_equiv_trunc_apply", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.commutes_symm", "description": "The following diagram commutes:\n```text\ntruncated_witt_vector p n (zmod p) ----> truncated_witt_vector p m (zmod p)\n            |                                        |\n            |                                        |\n            v                                        v\n          zmod (p^n) ----------------------------> zmod (p^m)\n```\nHere the vertical arrows are `(truncated_witt_vector.zmod_equiv_trunc p _).symm`,\nthe horizontal arrow at the top is `zmod.cast_hom`,\nand the horizontal arrow at the bottom is `truncated_witt_vector.truncate`.", "p": "mathlib"}, {"name": "truncated_witt_vector.commutes_symm'", "description": "", "p": "mathlib"}, {"name": "witt_vector.to_zmod_pow", "description": "`to_zmod_pow` is a family of compatible ring homs. We get this family by composing\n`truncated_witt_vector.zmod_equiv_trunc` (in right-to-left direction)\nwith `witt_vector.truncate`.", "p": "mathlib"}, {"name": "witt_vector.to_padic_int_comp_from_padic_int", "description": "", "p": "mathlib"}, {"name": "witt_vector.to_padic_int_comp_from_padic_int_ext", "description": "", "p": "mathlib"}, {"name": "witt_vector.zmod_equiv_trunc_compat", "description": "", "p": "mathlib"}, {"name": "witt_vector.to_zmod_pow_compat", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.char_p_zmod", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.zmod_equiv_trunc", "description": "The unique isomorphism between `zmod p^n` and `truncated_witt_vector p n (zmod p)`.\n\nThis isomorphism exists, because `truncated_witt_vector p n (zmod p)` is a finite ring\nwith characteristic and cardinality `p^n`.", "p": "mathlib"}, {"name": "witt_vector.to_padic_int", "description": "`to_padic_int` lifts `to_zmod_pow : \ud835\udd4e (zmod p) \u2192+* zmod (p ^ k)` to a ring hom to `\u2124_[p]`\nusing `padic_int.lift`, the universal property of `\u2124_[p]`.", "p": "mathlib"}, {"name": "valued.continuous_extension", "description": "", "p": "mathlib"}, {"name": "valued.extension", "description": "The extension of the valuation of a valued field to the completion of the field.", "p": "mathlib"}, {"name": "valued.valued_completion_apply", "description": "", "p": "mathlib"}, {"name": "valued.completable", "description": "A valued field is completable.", "p": "mathlib"}, {"name": "valued.continuous_valuation", "description": "", "p": "mathlib"}, {"name": "valued_ring.separated", "description": "A valued division ring is separated.", "p": "mathlib"}, {"name": "valuation.inversion_estimate", "description": "", "p": "mathlib"}, {"name": "valued.extension_valuation", "description": "the extension of a valuation on a division ring to its completion.", "p": "mathlib"}, {"name": "valued.topological_division_ring", "description": "The topology coming from a valuation on a division ring makes it a topological division ring\n   [BouAC, VI.5.1 middle of Proposition 1]", "p": "mathlib"}, {"name": "valued.closure_coe_completion_v_lt", "description": "", "p": "mathlib"}, {"name": "valued.valued_completion", "description": "", "p": "mathlib"}, {"name": "valued.extension_extends", "description": "", "p": "mathlib"}, {"name": "list.smul_prod", "description": "", "p": "mathlib"}, {"name": "list.smul_sum", "description": "", "p": "mathlib"}, {"name": "multiset.smul_sum", "description": "", "p": "mathlib"}, {"name": "finset.smul_prod", "description": "", "p": "mathlib"}, {"name": "finset.smul_sum", "description": "", "p": "mathlib"}, {"name": "multiset.smul_prod", "description": "", "p": "mathlib"}, {"name": "Inf_neg", "description": "", "p": "mathlib"}, {"name": "Inf_div", "description": "", "p": "mathlib"}, {"name": "cSup_zero", "description": "", "p": "mathlib"}, {"name": "cSup_add", "description": "", "p": "mathlib"}, {"name": "linear_ordered_field.smul_Iic", "description": "", "p": "mathlib"}, {"name": "linear_ordered_field.smul_Iio", "description": "", "p": "mathlib"}, {"name": "cInf_zero", "description": "", "p": "mathlib"}, {"name": "cInf_sub", "description": "", "p": "mathlib"}, {"name": "Inf_zero", "description": "", "p": "mathlib"}, {"name": "cInf_neg", "description": "", "p": "mathlib"}, {"name": "Inf_one", "description": "", "p": "mathlib"}, {"name": "linear_ordered_field.smul_Ico", "description": "", "p": "mathlib"}, {"name": "Sup_neg", "description": "", "p": "mathlib"}, {"name": "cInf_div", "description": "", "p": "mathlib"}, {"name": "Sup_div", "description": "", "p": "mathlib"}, {"name": "cSup_div", "description": "", "p": "mathlib"}, {"name": "linear_ordered_field.smul_Ioi", "description": "", "p": "mathlib"}, {"name": "Inf_add", "description": "", "p": "mathlib"}, {"name": "Sup_mul", "description": "", "p": "mathlib"}, {"name": "linear_ordered_field.smul_Icc", "description": "", "p": "mathlib"}, {"name": "linear_ordered_field.smul_Ioo", "description": "", "p": "mathlib"}, {"name": "Sup_sub", "description": "", "p": "mathlib"}, {"name": "cInf_one", "description": "", "p": "mathlib"}, {"name": "cSup_sub", "description": "", "p": "mathlib"}, {"name": "linear_ordered_field.smul_Ici", "description": "", "p": "mathlib"}, {"name": "Sup_zero", "description": "", "p": "mathlib"}, {"name": "Sup_one", "description": "", "p": "mathlib"}, {"name": "cInf_mul", "description": "", "p": "mathlib"}, {"name": "cInf_add", "description": "", "p": "mathlib"}, {"name": "Inf_mul", "description": "", "p": "mathlib"}, {"name": "Inf_sub", "description": "", "p": "mathlib"}, {"name": "cSup_one", "description": "", "p": "mathlib"}, {"name": "Sup_add", "description": "", "p": "mathlib"}, {"name": "Sup_inv", "description": "", "p": "mathlib"}, {"name": "cInf_inv", "description": "", "p": "mathlib"}, {"name": "cSup_mul", "description": "", "p": "mathlib"}, {"name": "linear_ordered_field.smul_Ioc", "description": "", "p": "mathlib"}, {"name": "Inf_inv", "description": "", "p": "mathlib"}, {"name": "cSup_inv", "description": "", "p": "mathlib"}, {"name": "cSup_neg", "description": "", "p": "mathlib"}, {"name": "tactic.continuity_tactics", "description": "List of tactics used by `continuity` internally.", "p": "mathlib"}, {"name": "continuous_id'", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.continuity", "description": "Solve goals of the form `continuous f`. `continuity?` reports back the proof term it found.", "p": "mathlib"}, {"name": "continuity", "description": "User attribute used to mark tactics used by `continuity`.", "p": "mathlib"}, {"name": "tactic.interactive.continuity'", "description": "Version of `continuity` for use with auto_param.", "p": "mathlib"}, {"name": "tactic.apply_continuous.comp", "description": "Tactic to apply `continuous.comp` when appropriate.\n\nApplying `continuous.comp` is not always a good idea, so we have some\nextra logic here to try to avoid bad cases.\n\n* If the function we're trying to prove continuous is actually\n  constant, and that constant is a function application `f z`, then\n  continuous.comp would produce new goals `continuous f`, `continuous\n  (\u03bb _, z)`, which is silly. We avoid this by failing if we could\n  apply continuous_const.\n\n* continuous.comp will always succeed on `continuous (\u03bb x, f x)` and\n  produce new goals `continuous (\u03bb x, x)`, `continuous f`. We detect\n  this by failing if a new goal can be closed by applying\n  continuous_id.", "p": "mathlib"}, {"name": "tactic_doc.tactic.continuity / continuity'", "description": "`continuity` solves goals of the form `continuous f` by applying lemmas tagged with the\n`continuity` user attribute.\n\n```lean\nexample {X Y : Type*} [topological_space X] [topological_space Y]\n  (f\u2081 f\u2082 : X \u2192 Y) (hf\u2081 : continuous f\u2081) (hf\u2082 : continuous f\u2082)\n  (g : Y \u2192 \u211d) (hg : continuous g) : continuous (\u03bb x, (max (g (f\u2081 x)) (g (f\u2082 x))) + 1) :=\nby continuity\n```\nwill discharge the goal, generating a proof term like\n`((continuous.comp hg hf\u2081).max (continuous.comp hg hf\u2082)).add continuous_const`\n\nYou can also use `continuity!`, which applies lemmas with `{ md := semireducible }`.\nThe default behaviour is more conservative, and only unfolds `reducible` definitions\nwhen attempting to match lemmas with the goal.\n\n`continuity?` reports back the proof term it found.", "p": "mathlib"}, {"name": "commute.sub_right", "description": "", "p": "mathlib"}, {"name": "commute.neg_one_right", "description": "", "p": "mathlib"}, {"name": "commute.bit1_right", "description": "", "p": "mathlib"}, {"name": "commute.neg_right_iff", "description": "", "p": "mathlib"}, {"name": "units.inv_eq_self_iff", "description": "In the unit group of an integral domain, a unit is its own inverse iff the unit is one or\n one's additive inverse.", "p": "mathlib"}, {"name": "commute.mul_self_sub_mul_self_eq'", "description": "", "p": "mathlib"}, {"name": "commute.add_left", "description": "", "p": "mathlib"}, {"name": "commute.bit0_right", "description": "", "p": "mathlib"}, {"name": "commute.bit0_left", "description": "", "p": "mathlib"}, {"name": "commute.add_right", "description": "", "p": "mathlib"}, {"name": "mul_self_sub_one", "description": "", "p": "mathlib"}, {"name": "commute.mul_self_eq_mul_self_iff", "description": "", "p": "mathlib"}, {"name": "commute.neg_one_left", "description": "", "p": "mathlib"}, {"name": "commute.mul_self_sub_mul_self_eq", "description": "Representation of a difference of two squares of commuting elements as a product.", "p": "mathlib"}, {"name": "commute.sub_left", "description": "", "p": "mathlib"}, {"name": "mul_self_eq_mul_self_iff", "description": "", "p": "mathlib"}, {"name": "commute.neg_left", "description": "", "p": "mathlib"}, {"name": "commute.bit1_left", "description": "", "p": "mathlib"}, {"name": "commute.neg_right", "description": "", "p": "mathlib"}, {"name": "commute.neg_left_iff", "description": "", "p": "mathlib"}, {"name": "mul_self_sub_mul_self", "description": "Representation of a difference of two squares in a commutative ring as a product.", "p": "mathlib"}, {"name": "mul_self_eq_one_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_hom.is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.congr_arg_mpr_hom_right", "description": "If we (perhaps unintentionally) perform equational rewriting on\nthe target object of a morphism,\nwe can replace the resulting `_.mpr f` term by a composition with an `eq_to_hom`.\n\nIt may be advisable to introduce any necessary `eq_to_hom` morphisms manually,\nrather than relying on this lemma firing.", "p": "mathlib"}, {"name": "category_theory.functor.hext", "description": "Proving equality between functors using heterogeneous equality.", "p": "mathlib"}, {"name": "category_theory.eq_to_iso.hom", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_comp_heq'", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.precomp_map_heq", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_hom", "description": "An equality `X = Y` gives us a morphism `X \u27f6 Y`.\n\nIt is typically better to use this, rather than rewriting by the equality then using `\ud835\udfd9 _`\nwhich usually leads to dependent type theory hell.", "p": "mathlib"}, {"name": "category_theory.functor.hcongr_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_conj_eq_to_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_hom_comp_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_iso_refl", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_iso_map", "description": "See the note on `eq_to_hom_map` regarding using this as a `simp` lemma.", "p": "mathlib"}, {"name": "category_theory.congr_arg_mpr_hom_left", "description": "If we (perhaps unintentionally) perform equational rewriting on\nthe source object of a morphism,\nwe can replace the resulting `_.mpr f` term by a composition with an `eq_to_hom`.\n\nIt may be advisable to introduce any necessary `eq_to_hom` morphisms manually,\nrather than relying on this lemma firing.", "p": "mathlib"}, {"name": "category_theory.eq_to_iso.inv", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.postcomp_map_heq", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_hom_refl", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.comp_eq_to_hom_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_hom_unop", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.ext", "description": "Proving equality between functors. This isn't an extensionality lemma,\n because usually you don't really want to do this.", "p": "mathlib"}, {"name": "category_theory.functor.postcomp_map_heq'", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.congr_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_comp_heq", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_hom_op", "description": "", "p": "mathlib"}, {"name": "category_theory.dcongr_arg", "description": "", "p": "mathlib"}, {"name": "category_theory.inv_eq_to_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_hom_trans_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_iso", "description": "An equality `X = Y` gives us an isomorphism `X \u2245 Y`.\n\nIt is typically better to use this, rather than rewriting by the equality then using `iso.refl _`\nwhich usually leads to dependent type theory hell.", "p": "mathlib"}, {"name": "category_theory.functor.congr_map", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.congr_inv_of_congr_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.congr_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.conj_eq_to_hom_iff_heq", "description": "Two morphisms are conjugate via eq_to_hom if and only if they are heterogeneously equal.", "p": "mathlib"}, {"name": "category_theory.eq_to_hom_map", "description": "This is not always a good idea as a `@[simp]` lemma,\nas we lose the ability to use results that interact with `F`,\ne.g. the naturality of a natural transformation.\n\nIn some files it may be appropriate to use `local attribute [simp] eq_to_hom_map`, however.", "p": "mathlib"}, {"name": "category_theory.eq_to_hom_trans", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_to_iso_trans", "description": "", "p": "mathlib"}, {"name": "category_theory.nat_trans.congr", "description": "", "p": "mathlib"}, {"name": "cardinal.cantor_function_aux_tt", "description": "", "p": "mathlib"}, {"name": "cardinal.not_countable_real", "description": "**Non-Denumerability of the Continuum**: The reals are not countable.", "p": "mathlib"}, {"name": "cardinal.mk_Icc_real", "description": "The cardinality of the interval [a, b].", "p": "mathlib"}, {"name": "cardinal.cantor_function_aux_eq", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_Ioo_real", "description": "The cardinality of the interval (a, b).", "p": "mathlib"}, {"name": "cardinal.mk_Ioc_real", "description": "The cardinality of the interval (a, b].", "p": "mathlib"}, {"name": "cardinal.increasing_cantor_function", "description": " `cantor_function c` is strictly increasing with if `0 < c < 1/2`, if we endow `\u2115 \u2192 bool` with a\nlexicographic order. The lexicographic order doesn't exist for these infinitary products, so we\nexplicitly write out what it means.", "p": "mathlib"}, {"name": "cardinal.mk_real", "description": "The cardinality of the reals, as a type.", "p": "mathlib"}, {"name": "cardinal.cantor_function_succ", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_Ico_real", "description": "The cardinality of the interval [a, b).", "p": "mathlib"}, {"name": "cardinal.mk_Ioi_real", "description": "The cardinality of the interval (a, \u221e).", "p": "mathlib"}, {"name": "cardinal.summable_cantor_function", "description": "", "p": "mathlib"}, {"name": "cardinal.cantor_function_aux_succ", "description": "", "p": "mathlib"}, {"name": "cardinal.cantor_function_aux", "description": " The body of the sum in `cantor_function`.\n`cantor_function_aux c f n = c ^ n` if `f n = tt`;\n`cantor_function_aux c f n = 0` if `f n = ff`.", "p": "mathlib"}, {"name": "cardinal.cantor_function_aux_nonneg", "description": "", "p": "mathlib"}, {"name": "cardinal.cantor_function_injective", "description": "`cantor_function c` is injective if `0 < c < 1/2`.", "p": "mathlib"}, {"name": "cardinal.cantor_function_le", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_Ici_real", "description": "The cardinality of the interval [a, \u221e).", "p": "mathlib"}, {"name": "cardinal.cantor_function", "description": " `cantor_function c (f : \u2115 \u2192 bool)` is `\u03a3 n, f n * c ^ n`, where `tt` is interpreted as `1` and\n`ff` is interpreted as `0`. It is implemented using `cantor_function_aux`.", "p": "mathlib"}, {"name": "cardinal.cantor_function_aux_zero", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_Iic_real", "description": "The cardinality of the interval (-\u221e, a].", "p": "mathlib"}, {"name": "cardinal.mk_Iio_real", "description": "The cardinality of the interval (-\u221e, a).", "p": "mathlib"}, {"name": "cardinal.cantor_function_aux_ff", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_univ_real", "description": "The cardinality of the reals, as a set.", "p": "mathlib"}, {"name": "units.min_coe", "description": "", "p": "mathlib"}, {"name": "units.linear_order", "description": "", "p": "mathlib"}, {"name": "units.order_embedding_coe", "description": "`coe : \u03b1\u02e3 \u2192 \u03b1` as an order embedding.", "p": "mathlib"}, {"name": "add_units.coe_lt_coe", "description": "", "p": "mathlib"}, {"name": "units.order_embedding_coe_apply", "description": "", "p": "mathlib"}, {"name": "add_units.partial_order", "description": "", "p": "mathlib"}, {"name": "add_units.preorder", "description": "", "p": "mathlib"}, {"name": "add_units.linear_order", "description": "", "p": "mathlib"}, {"name": "add_units.min_coe", "description": "", "p": "mathlib"}, {"name": "add_units.coe_le_coe", "description": "", "p": "mathlib"}, {"name": "add_units.order_embedding_coe_apply", "description": "", "p": "mathlib"}, {"name": "units.partial_order", "description": "", "p": "mathlib"}, {"name": "units.coe_le_coe", "description": "", "p": "mathlib"}, {"name": "add_units.order_embedding_coe", "description": "`coe : add_units \u03b1 \u2192 \u03b1` as an order embedding.", "p": "mathlib"}, {"name": "add_units.max_coe", "description": "", "p": "mathlib"}, {"name": "units.preorder", "description": "", "p": "mathlib"}, {"name": "units.coe_lt_coe", "description": "", "p": "mathlib"}, {"name": "units.max_coe", "description": "", "p": "mathlib"}, {"name": "is_valid_char_range_1", "description": "", "p": "core"}, {"name": "char.decidable_eq", "description": "", "p": "core"}, {"name": "is_valid_char_range_2", "description": "", "p": "core"}, {"name": "char.decidable_lt", "description": "", "p": "core"}, {"name": "char.has_le", "description": "", "p": "core"}, {"name": "char.of_nat", "description": "", "p": "core"}, {"name": "char.veq_of_eq", "description": "", "p": "core"}, {"name": "char", "description": "The `char` type represents an unicode scalar value.\n   See http://www.unicode.org/glossary/#unicode_scalar_value).", "p": "core"}, {"name": "char.val", "description": "The `char` type represents an unicode scalar value.\n   See http://www.unicode.org/glossary/#unicode_scalar_value).", "p": "core"}, {"name": "char.valid", "description": "The `char` type represents an unicode scalar value.\n   See http://www.unicode.org/glossary/#unicode_scalar_value).", "p": "core"}, {"name": "char.has_sizeof", "description": "", "p": "core"}, {"name": "char.le", "description": "", "p": "core"}, {"name": "char.ne_of_vne", "description": "", "p": "core"}, {"name": "char.to_nat", "description": "", "p": "core"}, {"name": "char.has_lt", "description": "", "p": "core"}, {"name": "char.vne_of_ne", "description": "", "p": "core"}, {"name": "char.inhabited", "description": "", "p": "core"}, {"name": "char.decidable_le", "description": "", "p": "core"}, {"name": "char.eq_of_veq", "description": "", "p": "core"}, {"name": "is_valid_char", "description": "", "p": "core"}, {"name": "char.lt", "description": "", "p": "core"}, {"name": "char.zero_lt_d800", "description": "", "p": "core"}, {"name": "simple_graph.component_compl_functor_obj", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.hom_refl", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.set_like", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl_mk_mem", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.supp_inj", "description": "", "p": "mathlib"}, {"name": "simple_graph.end_hom_mk_of_mk", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl_mk_eq_of_adj", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.hom_eq_iff_le", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.hom_trans", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.ind", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl_functor_map", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.subset_hom", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl", "description": "The components outside a given set of vertices `K`", "p": "mathlib"}, {"name": "simple_graph.component_compl.supp", "description": "The set of vertices of `G` making up the connected component `C`", "p": "mathlib"}, {"name": "simple_graph.infinite_iff_in_eventual_range", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl_mk", "description": "The connected component of `v` in `G.induce K\u1d9c`.", "p": "mathlib"}, {"name": "simple_graph.end", "description": "The end of a graph, defined as the sections of the functor `component_compl_functor` .", "p": "mathlib"}, {"name": "simple_graph.component_compl.exists_adj_boundary_pair", "description": "Assuming `G` is preconnected and `K` not empty, given any connected component `C` outside of `K`,\nthere exists a vertex `k \u2208 K` adjacent to a vertex `v \u2208 C`.", "p": "mathlib"}, {"name": "simple_graph.component_compl_functor", "description": "The functor assigning, to a finite set in `V`, the set of connected components in its complement.", "p": "mathlib"}, {"name": "simple_graph.component_compl.disjoint_right", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.infinite_iff_in_all_ranges", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.hom_eq_iff_not_disjoint", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.mem_of_adj", "description": "Any vertex adjacent to a vertex of `C` and not lying in `K` must lie in `C`.", "p": "mathlib"}, {"name": "simple_graph.component_compl.hom_infinite", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.hom", "description": "If `K \u2286 L`, the components outside of `L` are all contained in a single component outside of `K`.", "p": "mathlib"}, {"name": "simple_graph.component_compl.supp_injective", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.lift", "description": "A `component_compl` specialization of `quot.lift`, where soundness has to be proved only\nfor adjacent vertices.", "p": "mathlib"}, {"name": "simple_graph.component_compl.coe_inj", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.exists_eq_mk", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.coe_graph", "description": "The induced graph on the vertices `C`.", "p": "mathlib"}, {"name": "simple_graph.component_compl.hom_mk", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.mem_supp_iff", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl_mk_mem_hom", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.pairwise_disjoint", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.not_mem_of_mem", "description": "", "p": "mathlib"}, {"name": "simple_graph.component_compl.nonempty", "description": "", "p": "mathlib"}, {"name": "equiv.nat_sum_nat_equiv_nat", "description": "An equivalence between `\u2115 \u2295 \u2115` and `\u2115`, by mapping `(sum.inl x)` to `2 * x` and `(sum.inr x)` to\n`2 * x + 1`.", "p": "mathlib"}, {"name": "equiv.nat_sum_nat_equiv_nat_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.int_equiv_nat", "description": "An equivalence between `\u2124` and `\u2115`, through `\u2124 \u2243 \u2115 \u2295 \u2115` and `\u2115 \u2295 \u2115 \u2243 \u2115`.", "p": "mathlib"}, {"name": "equiv.bool_prod_nat_equiv_nat", "description": "An equivalence between `bool \u00d7 \u2115` and `\u2115`, by mapping `(tt, x)` to `2 * x + 1` and `(ff, x)` to\n`2 * x`.", "p": "mathlib"}, {"name": "equiv.bool_prod_nat_equiv_nat_apply", "description": "", "p": "mathlib"}, {"name": "equiv.bool_prod_nat_equiv_nat_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.nat_sum_nat_equiv_nat_apply", "description": "", "p": "mathlib"}, {"name": "equiv.prod_equiv_of_equiv_nat", "description": "An equivalence between `\u03b1 \u00d7 \u03b1` and `\u03b1`, given that there is an equivalence between `\u03b1` and `\u2115`.", "p": "mathlib"}, {"name": "matrix_equiv_tensor.to_fun_alg_hom_apply", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor.inv_fun_add", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor.to_fun_alg_hom", "description": "The function `(A \u2297[R] matrix n n R) \u2192\u2090[R] matrix n n A`, as an algebra homomorphism.", "p": "mathlib"}, {"name": "matrix_equiv_tensor_apply_symm", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor.equiv", "description": "(Implementation detail)\n\nThe equivalence, ignoring the algebra structure, `(A \u2297[R] matrix n n R) \u2243 matrix n n A`.", "p": "mathlib"}, {"name": "matrix_equiv_tensor.to_fun_bilinear_apply", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor.right_inv", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor.to_fun_linear", "description": "(Implementation detail).\nThe function underlying `(A \u2297[R] matrix n n R) \u2192\u2090[R] matrix n n A`,\nas an `R`-linear map.", "p": "mathlib"}, {"name": "matrix_equiv_tensor.inv_fun_zero", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor.to_fun_bilinear", "description": "(Implementation detail).\nThe function underlying `(A \u2297[R] matrix n n R) \u2192\u2090[R] matrix n n A`,\nas an `R`-bilinear map.", "p": "mathlib"}, {"name": "matrix_equiv_tensor.inv_fun_smul", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor_apply_std_basis", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor.inv_fun_algebra_map", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor.inv_fun", "description": "(Implementation detail.)\n\nThe bare function `matrix n n A \u2192 A \u2297[R] matrix n n R`.\n(We don't need to show that it's an algebra map, thankfully --- just that it's an inverse.)", "p": "mathlib"}, {"name": "matrix_equiv_tensor", "description": "The `R`-algebra isomorphism `matrix n n A \u2243\u2090[R] (A \u2297[R] matrix n n R)`.", "p": "mathlib"}, {"name": "matrix_equiv_tensor_apply", "description": "", "p": "mathlib"}, {"name": "matrix_equiv_tensor.left_inv", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_mul", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_choose", "description": "The multiplicity of `p` in `choose n k` is the number of carries when `k` and `n - k`\n are added in base `p`. The set is expressed by filtering `Ico 1 b` where `b`\n is any bound greater than `log p n`.", "p": "mathlib"}, {"name": "nat.prime.dvd_choose_pow_iff", "description": "", "p": "mathlib"}, {"name": "nat.multiplicity_two_factorial_lt", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_factorial_mul", "description": "The multiplicity of `p` in `(p * n)!` is `n` more than that of `n!`.", "p": "mathlib"}, {"name": "nat.prime.multiplicity_factorial_mul_succ", "description": "The multiplicity of `p` in `(p * (n + 1))!` is one more than the sum\n of the multiplicities of `p` in `(p * n)!` and `n + 1`.", "p": "mathlib"}, {"name": "nat.prime.dvd_choose_pow", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_le_multiplicity_choose_add", "description": "A lower bound on the multiplicity of `p` in `choose n k`.", "p": "mathlib"}, {"name": "nat.prime.multiplicity_choose_prime_pow_add_multiplicity", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_factorial_le_div_pred", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_self", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_factorial", "description": " **Legendre's Theorem**\n\nThe multiplicity of a prime in `n!` is the sum of the quotients `n / p ^ i`. This sum is expressed\nover the finset `Ico 1 b` where `b` is any bound greater than `log p n`.", "p": "mathlib"}, {"name": "nat.multiplicity_eq_card_pow_dvd", "description": " The multiplicity of `m` in `n` is the number of positive natural numbers `i` such that `m ^ i`\ndivides `n`. This set is expressed by filtering `Ico 1 b` where `b` is any bound greater than\n`log m n`.", "p": "mathlib"}, {"name": "nat.prime.multiplicity_one", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_pow", "description": "", "p": "mathlib"}, {"name": "nat.prime.pow_dvd_factorial_iff", "description": "A prime power divides `n!` iff it is at most the sum of the quotients `n / p ^ i`.\n This sum is expressed over the set `Ico 1 b` where `b` is any bound greater than `log p n`", "p": "mathlib"}, {"name": "nat.prime.multiplicity_pow_self", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_choose_prime_pow", "description": "", "p": "mathlib"}, {"name": "nat.prime.multiplicity_choose_aux", "description": "", "p": "mathlib"}, {"name": "module.free.tensor", "description": "", "p": "mathlib"}, {"name": "module.free.of_equiv'", "description": " A variation of `of_equiv`: the assumption `module.free R P` here is explicit rather than an\ninstance.", "p": "mathlib"}, {"name": "module.free.direct_sum", "description": "", "p": "mathlib"}, {"name": "module.free.matrix", "description": "The module of finite matrices is free.", "p": "mathlib"}, {"name": "module.free.of_subsingleton'", "description": "", "p": "mathlib"}, {"name": "module.free.choose_basis_index", "description": "If `module.free R M` then `choose_basis_index R M` is the `\u03b9` which indexes the basis\n `\u03b9 \u2192 M`.", "p": "mathlib"}, {"name": "module.free.choose_basis_index.nonempty", "description": "", "p": "mathlib"}, {"name": "module.free.choose_basis", "description": " If `module.free R M` then `choose_basis : \u03b9 \u2192 M` is the basis.\nHere `\u03b9 = choose_basis_index R M`.", "p": "mathlib"}, {"name": "module.free.no_zero_smul_divisors", "description": "", "p": "mathlib"}, {"name": "module.free.of_equiv", "description": "", "p": "mathlib"}, {"name": "module.free.pi", "description": "The product of finitely many free modules is free.", "p": "mathlib"}, {"name": "module.free.function", "description": " The product of finitely many free modules is free (non-dependent version to help with typeclass\nsearch).", "p": "mathlib"}, {"name": "module.free.repr", "description": "The isomorphism `M \u2243\u2097[R] (choose_basis_index R M \u2192\u2080 R)`.", "p": "mathlib"}, {"name": "module.free.finsupp", "description": "", "p": "mathlib"}, {"name": "module.free_def", "description": "", "p": "mathlib"}, {"name": "module.free.of_subsingleton", "description": "", "p": "mathlib"}, {"name": "module.free.of_basis", "description": "", "p": "mathlib"}, {"name": "module.free_iff_set", "description": "", "p": "mathlib"}, {"name": "module.free.of_division_ring", "description": "", "p": "mathlib"}, {"name": "module.free.constr", "description": " The universal property of free modules: giving a functon `(choose_basis_index R M) \u2192 N`, for `N`\nan `R`-module, is the same as giving an `R`-linear map `M \u2192\u2097[R] N`.\n\nThis definition is parameterized over an extra `semiring S`,\nsuch that `smul_comm_class R S M'` holds.\nIf `R` is commutative, you can set `S := R`; if `R` is not commutative,\nyou can recover an `add_equiv` by setting `S := \u2115`.\nSee library note [bundled maps over different rings].", "p": "mathlib"}, {"name": "module.free.prod", "description": "", "p": "mathlib"}, {"name": "module.free", "description": "`module.free R M` is the statement that the `R`-module `M` is free.", "p": "mathlib"}, {"name": "module.free.exists_basis", "description": "`module.free R M` is the statement that the `R`-module `M` is free.", "p": "mathlib"}, {"name": "module.free.self", "description": "The module structure provided by `semiring.to_module` is free.", "p": "mathlib"}, {"name": "module.free.dfinsupp", "description": "", "p": "mathlib"}, {"name": "graded_monoid.grade_zero.monoid", "description": "The `monoid` structure derived from `gmonoid A`.", "p": "mathlib"}, {"name": "set_like.graded_monoid.to_has_graded_mul", "description": "", "p": "mathlib"}, {"name": "set_like.has_graded_one", "description": "A version of `graded_monoid.ghas_one` for internally graded objects.", "p": "mathlib"}, {"name": "set_like.has_graded_one.one_mem", "description": "A version of `graded_monoid.ghas_one` for internally graded objects.", "p": "mathlib"}, {"name": "graded_monoid.grade_zero.has_one", "description": "`1 : A 0` is the value provided in `ghas_one.one`.", "p": "mathlib"}, {"name": "monoid.gmonoid_gnpow", "description": "", "p": "mathlib"}, {"name": "graded_monoid.grade_zero.comm_monoid", "description": "The `comm_monoid` structure derived from `gcomm_monoid A`.", "p": "mathlib"}, {"name": "graded_monoid.inhabited", "description": "", "p": "mathlib"}, {"name": "set_like.pow_mem_graded", "description": "", "p": "mathlib"}, {"name": "set_like.gcomm_monoid", "description": "Build a `gcomm_monoid` instance for a collection of subobjects.", "p": "mathlib"}, {"name": "set_like.one_mem_graded", "description": "", "p": "mathlib"}, {"name": "list.dprod_index", "description": " The index used by `list.dprod`. Propositionally this is equal to `(l.map f\u03b9).sum`, but\ndefinitionally it needs to have a different form to avoid introducing `eq.rec`s in `list.dprod`.", "p": "mathlib"}, {"name": "graded_monoid.grade_zero.mul_action", "description": "Each grade `A i` derives a `A 0`-action structure from `gmonoid A`.", "p": "mathlib"}, {"name": "graded_monoid.ghas_mul", "description": " A graded version of `has_mul`. Multiplication combines grades additively, like\n`add_monoid_algebra`.", "p": "mathlib"}, {"name": "graded_monoid.ghas_mul.mul", "description": " A graded version of `has_mul`. Multiplication combines grades additively, like\n`add_monoid_algebra`.", "p": "mathlib"}, {"name": "set_like.ghas_one", "description": "", "p": "mathlib"}, {"name": "set_like.is_homogeneous_one", "description": "", "p": "mathlib"}, {"name": "set_like.has_graded_mul", "description": "A version of `graded_monoid.ghas_one` for internally graded objects.", "p": "mathlib"}, {"name": "set_like.has_graded_mul.mul_mem", "description": "A version of `graded_monoid.ghas_one` for internally graded objects.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.to_ghas_mul", "description": "", "p": "mathlib"}, {"name": "graded_monoid.mk_zero_monoid_hom", "description": "`graded_monoid.mk 0` is a `monoid_hom`, using the `graded_monoid.grade_zero.monoid` structure.", "p": "mathlib"}, {"name": "set_like.graded_monoid.to_has_graded_one", "description": "", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.apply_gnpow_rec_zero_tac", "description": " Tactic used to autofill `graded_monoid.gmonoid.gnpow_zero'` when the default\n`graded_monoid.gmonoid.gnpow_rec` is used.", "p": "mathlib"}, {"name": "monoid.gmonoid", "description": " If all grades are the same type and themselves form a monoid, then there is a trivial grading\nstructure.", "p": "mathlib"}, {"name": "graded_monoid.mk_zero_smul", "description": "", "p": "mathlib"}, {"name": "graded_monoid.ghas_one.to_has_one", "description": "`ghas_one` implies `has_one (graded_monoid A)`", "p": "mathlib"}, {"name": "graded_monoid.mk_list_dprod", "description": "", "p": "mathlib"}, {"name": "set_like.coe_ghas_one", "description": "", "p": "mathlib"}, {"name": "set_like.homogeneous_submonoid", "description": "When `A` is a `set_like.graded_monoid A`, then the homogeneous elements forms a submonoid.", "p": "mathlib"}, {"name": "set_like.ghas_mul", "description": "", "p": "mathlib"}, {"name": "graded_monoid.list_prod_of_fn_eq_dprod", "description": "", "p": "mathlib"}, {"name": "list.dprod", "description": " A dependent product for graded monoids represented by the indexed family of types `A i`.\nThis is a dependent version of `(l.map fA).prod`.\n\nFor a list `l : list \u03b1`, this computes the product of `fA a` over `a`, where each `fA` is of type\n`A (f\u03b9 a)`.", "p": "mathlib"}, {"name": "comm_monoid.gcomm_monoid", "description": " If all grades are the same type and themselves form a commutative monoid, then there is a\ntrivial grading structure.", "p": "mathlib"}, {"name": "set_like.coe_gnpow", "description": "", "p": "mathlib"}, {"name": "has_one.ghas_one_one", "description": "", "p": "mathlib"}, {"name": "graded_monoid.mk_mul_mk", "description": "", "p": "mathlib"}, {"name": "graded_monoid.ghas_mul.to_has_mul", "description": "`ghas_mul` implies `has_mul (graded_monoid A)`.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.gnpow_rec_succ", "description": "", "p": "mathlib"}, {"name": "has_mul.ghas_mul_mul", "description": "", "p": "mathlib"}, {"name": "set_like.coe_ghas_mul", "description": "", "p": "mathlib"}, {"name": "list.dprod_index_cons", "description": "", "p": "mathlib"}, {"name": "graded_monoid.nat.has_pow", "description": "", "p": "mathlib"}, {"name": "graded_monoid.mk", "description": "Construct an element of a graded monoid.", "p": "mathlib"}, {"name": "set_like.coe_list_dprod", "description": " Coercing a dependent product of subtypes is the same as taking the regular product of the\ncoercions.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.gnpow_rec", "description": " A default implementation of power on a graded monoid, like `npow_rec`.\n`gmonoid.gnpow` should be used instead.", "p": "mathlib"}, {"name": "graded_monoid.grade_zero.has_mul", "description": " `(*) : A 0 \u2192 A 0 \u2192 A 0` is the value provided in `graded_monoid.ghas_mul.mul`, composed with\nan `eq.rec` to turn `A (0 + 0)` into `A 0`.", "p": "mathlib"}, {"name": "set_like.list_dprod_eq", "description": "A version of `list.coe_dprod_set_like` with `subtype.mk`.", "p": "mathlib"}, {"name": "has_mul.ghas_mul", "description": "", "p": "mathlib"}, {"name": "set_like.is_homogeneous.mul", "description": "", "p": "mathlib"}, {"name": "graded_monoid.grade_zero.smul_eq_mul", "description": "", "p": "mathlib"}, {"name": "list.dprod_monoid", "description": "When all the indexed types are the same, the dependent product is just the regular product.", "p": "mathlib"}, {"name": "set_like.is_homogeneous", "description": "An element `a : R` is said to be homogeneous if there is some `i : \u03b9` such that `a \u2208 A i`.", "p": "mathlib"}, {"name": "graded_monoid.grade_zero.has_smul", "description": " `(\u2022) : A 0 \u2192 A i \u2192 A i` is the value provided in `graded_monoid.ghas_mul.mul`, composed with\nan `eq.rec` to turn `A (0 + i)` into `A i`.", "p": "mathlib"}, {"name": "graded_monoid.list_prod_map_eq_dprod", "description": "A variant of `graded_monoid.mk_list_dprod` for rewriting in the other direction.", "p": "mathlib"}, {"name": "list.dprod_index_eq_map_sum", "description": "", "p": "mathlib"}, {"name": "graded_monoid.mk_pow", "description": "", "p": "mathlib"}, {"name": "set_like.mul_mem_graded", "description": "", "p": "mathlib"}, {"name": "set_like.list_prod_map_mem_graded", "description": "", "p": "mathlib"}, {"name": "set_like.gmonoid", "description": "Build a `gmonoid` instance for a collection of subobjects.", "p": "mathlib"}, {"name": "set_like.is_homogeneous_coe", "description": "", "p": "mathlib"}, {"name": "set_like.list_prod_of_fn_mem_graded", "description": "", "p": "mathlib"}, {"name": "has_one.ghas_one", "description": "", "p": "mathlib"}, {"name": "graded_monoid.ghas_one", "description": "A graded version of `has_one`, which must be of grade 0.", "p": "mathlib"}, {"name": "graded_monoid.ghas_one.one", "description": "A graded version of `has_one`, which must be of grade 0.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.to_comm_monoid", "description": " `gcomm_monoid` implies a `comm_monoid (graded_monoid A)`, although this is only used as an\ninstance locally to define notation in `gmonoid` and similar typeclasses.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.apply_gnpow_rec_succ_tac", "description": " Tactic used to autofill `graded_monoid.gmonoid.gnpow_succ'` when the default\n`graded_monoid.gmonoid.gnpow_rec` is used.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.to_gmonoid", "description": "", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.to_ghas_one", "description": "", "p": "mathlib"}, {"name": "set_like.graded_monoid", "description": "A version of `graded_monoid.gmonoid` for internally graded objects.", "p": "mathlib"}, {"name": "set_like.graded_monoid.one_mem", "description": "A version of `graded_monoid.gmonoid` for internally graded objects.", "p": "mathlib"}, {"name": "set_like.graded_monoid.mul_mem", "description": "A version of `graded_monoid.gmonoid` for internally graded objects.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.gnpow_rec_zero", "description": "", "p": "mathlib"}, {"name": "graded_monoid.gmonoid", "description": " A graded version of `monoid`.\n\nLike `monoid.npow`, this has an optional `gmonoid.gnpow` field to allow definitional control of\nnatural powers of a graded monoid.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.mul", "description": " A graded version of `monoid`.\n\nLike `monoid.npow`, this has an optional `gmonoid.gnpow` field to allow definitional control of\nnatural powers of a graded monoid.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.one", "description": " A graded version of `monoid`.\n\nLike `monoid.npow`, this has an optional `gmonoid.gnpow` field to allow definitional control of\nnatural powers of a graded monoid.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.one_mul", "description": " A graded version of `monoid`.\n\nLike `monoid.npow`, this has an optional `gmonoid.gnpow` field to allow definitional control of\nnatural powers of a graded monoid.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.mul_one", "description": " A graded version of `monoid`.\n\nLike `monoid.npow`, this has an optional `gmonoid.gnpow` field to allow definitional control of\nnatural powers of a graded monoid.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.mul_assoc", "description": " A graded version of `monoid`.\n\nLike `monoid.npow`, this has an optional `gmonoid.gnpow` field to allow definitional control of\nnatural powers of a graded monoid.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.gnpow", "description": " A graded version of `monoid`.\n\nLike `monoid.npow`, this has an optional `gmonoid.gnpow` field to allow definitional control of\nnatural powers of a graded monoid.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.gnpow_zero'", "description": " A graded version of `monoid`.\n\nLike `monoid.npow`, this has an optional `gmonoid.gnpow` field to allow definitional control of\nnatural powers of a graded monoid.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.gnpow_succ'", "description": " A graded version of `monoid`.\n\nLike `monoid.npow`, this has an optional `gmonoid.gnpow` field to allow definitional control of\nnatural powers of a graded monoid.", "p": "mathlib"}, {"name": "graded_monoid.gmonoid.to_monoid", "description": "`gmonoid` implies a `monoid (graded_monoid A)`.", "p": "mathlib"}, {"name": "list.dprod_nil", "description": "", "p": "mathlib"}, {"name": "graded_monoid", "description": "A type alias of sigma types for graded monoids.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.mul", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.one", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.one_mul", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.mul_one", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.mul_assoc", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.gnpow", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.gnpow_zero'", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.gnpow_succ'", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "graded_monoid.gcomm_monoid.mul_comm", "description": "A graded version of `comm_monoid`.", "p": "mathlib"}, {"name": "list.dprod_index_nil", "description": "", "p": "mathlib"}, {"name": "list.dprod_cons", "description": "", "p": "mathlib"}, {"name": "graded_monoid.mk_zero_pow", "description": "", "p": "mathlib"}, {"name": "box_integral.box.with_bot.lattice", "description": "", "p": "mathlib"}, {"name": "box_integral.box.injective_coe", "description": "", "p": "mathlib"}, {"name": "box_integral.box.Ioo_subset_coe", "description": "", "p": "mathlib"}, {"name": "box_integral.box.distortion_eq_of_sub_eq_div", "description": "", "p": "mathlib"}, {"name": "box_integral.box.face", "description": " Face of a box in `\u211d\u207f\u207a\u00b9 = fin (n + 1) \u2192 \u211d`: the box in `\u211d\u207f = fin n \u2192 \u211d` with corners at\n`I.lower \u2218 fin.succ_above i` and `I.upper \u2218 fin.succ_above i`.", "p": "mathlib"}, {"name": "box_integral.box.partial_order", "description": "", "p": "mathlib"}, {"name": "box_integral.box.has_le", "description": "", "p": "mathlib"}, {"name": "box_integral.box.lower_mem_Icc", "description": "", "p": "mathlib"}, {"name": "box_integral.box.coe_ne_empty", "description": "", "p": "mathlib"}, {"name": "box_integral.box.mk'", "description": " Make a `with_bot (box \u03b9)` from a pair of corners `l u : \u03b9 \u2192 \u211d`. If `l i < u i` for all `i`,\nthen the result is `\u27e8l, u, _\u27e9 : box \u03b9`, otherwise it is `\u22a5`. In any case, the result interpreted\nas a set in `\u03b9 \u2192 \u211d` is the set `{x : \u03b9 \u2192 \u211d | \u2200 i, x i \u2208 Ioc (l i) (u i)}`.", "p": "mathlib"}, {"name": "box_integral.box.upper_mem", "description": "", "p": "mathlib"}, {"name": "box_integral.box.with_bot_coe", "description": "", "p": "mathlib"}, {"name": "box_integral.box.mk'_eq_coe", "description": "", "p": "mathlib"}, {"name": "box_integral.box.ext", "description": "", "p": "mathlib"}, {"name": "box_integral.box.Ioo", "description": "The interior of a box.", "p": "mathlib"}, {"name": "box_integral.box.Union_Ioo_of_tendsto", "description": "", "p": "mathlib"}, {"name": "box_integral.box.Icc_def", "description": "", "p": "mathlib"}, {"name": "box_integral.box.not_disjoint_coe_iff_nonempty_inter", "description": "", "p": "mathlib"}, {"name": "box_integral.box.le_iff_Icc", "description": "", "p": "mathlib"}, {"name": "box_integral.box.coe_inf", "description": "", "p": "mathlib"}, {"name": "box_integral.box.face_mk", "description": "", "p": "mathlib"}, {"name": "box_integral.box.with_bot_coe_subset_iff", "description": "", "p": "mathlib"}, {"name": "box_integral.box.mem_def", "description": "", "p": "mathlib"}, {"name": "box_integral.box.coe_eq_pi", "description": "", "p": "mathlib"}, {"name": "box_integral.box.bUnion_coe_eq_coe", "description": "", "p": "mathlib"}, {"name": "box_integral.box.nonempty_coe", "description": "", "p": "mathlib"}, {"name": "box_integral.box.face_upper", "description": "", "p": "mathlib"}, {"name": "box_integral.box.le_iff_bounds", "description": "", "p": "mathlib"}, {"name": "box_integral.box.distortion", "description": " The distortion of a box `I` is the maximum of the ratios of the lengths of its edges.\nIt is defined as the maximum of the ratios\n`nndist I.lower I.upper / nndist (I.lower i) (I.upper i)`.", "p": "mathlib"}, {"name": "box_integral.box.ne_of_disjoint_coe", "description": "", "p": "mathlib"}, {"name": "box_integral.box.nndist_le_distortion_mul", "description": "", "p": "mathlib"}, {"name": "box_integral.box.monotone_upper", "description": "", "p": "mathlib"}, {"name": "box_integral.box", "description": " A nontrivial rectangular box in `\u03b9 \u2192 \u211d` with corners `lower` and `upper`. Repesents the product\nof half-open intervals `(lower i, upper i]`.", "p": "mathlib"}, {"name": "box_integral.box.lower", "description": " A nontrivial rectangular box in `\u03b9 \u2192 \u211d` with corners `lower` and `upper`. Repesents the product\nof half-open intervals `(lower i, upper i]`.", "p": "mathlib"}, {"name": "box_integral.box.upper", "description": " A nontrivial rectangular box in `\u03b9 \u2192 \u211d` with corners `lower` and `upper`. Repesents the product\nof half-open intervals `(lower i, upper i]`.", "p": "mathlib"}, {"name": "box_integral.box.lower_lt_upper", "description": " A nontrivial rectangular box in `\u03b9 \u2192 \u211d` with corners `lower` and `upper`. Repesents the product\nof half-open intervals `(lower i, upper i]`.", "p": "mathlib"}, {"name": "box_integral.box.upper_mem_Icc", "description": "", "p": "mathlib"}, {"name": "box_integral.box.antitone_lower", "description": "", "p": "mathlib"}, {"name": "box_integral.box.face_lower", "description": "", "p": "mathlib"}, {"name": "box_integral.box.exists_mem", "description": "", "p": "mathlib"}, {"name": "box_integral.box.dist_le_distortion_mul", "description": "", "p": "mathlib"}, {"name": "box_integral.box.has_sup", "description": " `I \u2294 J` is the least box that includes both `I` and `J`. Since `\u2191I \u222a \u2191J` is usually not a box,\n`\u2191(I \u2294 J)` is larger than `\u2191I \u222a \u2191J`.", "p": "mathlib"}, {"name": "box_integral.box.is_compact_Icc", "description": "", "p": "mathlib"}, {"name": "box_integral.box.coe_bot", "description": "", "p": "mathlib"}, {"name": "box_integral.box.diam_Icc_le_of_distortion_le", "description": "", "p": "mathlib"}, {"name": "box_integral.box.mem_mk", "description": "", "p": "mathlib"}, {"name": "box_integral.box.le_def", "description": "", "p": "mathlib"}, {"name": "box_integral.box.Icc_eq_pi", "description": "", "p": "mathlib"}, {"name": "box_integral.box.lower_le_upper", "description": "", "p": "mathlib"}, {"name": "box_integral.box.coe_coe", "description": "", "p": "mathlib"}, {"name": "box_integral.box.le_tfae", "description": "", "p": "mathlib"}, {"name": "box_integral.box.coe_mk'", "description": "", "p": "mathlib"}, {"name": "box_integral.box.inhabited", "description": "", "p": "mathlib"}, {"name": "box_integral.box.with_bot.has_inf", "description": "", "p": "mathlib"}, {"name": "box_integral.box.