 "algebraic_closure.span_eval", "description": " The span of `f(x_f)` across monic irreducible polynomials `f` where `x_f` is an\nindeterminate.", "p": "mathlib"}, {"name": "algebraic_closure.max_ideal.is_maximal", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.algebra_map_def", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.adjoin_monic.algebra", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.exists_root", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.to_step_of_le.directed_system", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.exists_of_step", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.adjoin_monic.inhabited", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.adjoin_monic.field", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.to_splitting_field", "description": " Given a finset of monic irreducible polynomials, construct an algebra homomorphism to the\nsplitting field of the product of the polynomials sending each indeterminate `x_f` represented by\nthe polynomial `f` in the finset to a root of `f`.", "p": "mathlib"}, {"name": "algebraic_closure.to_step_zero", "description": "The canonical inclusion to the `0`th step.", "p": "mathlib"}, {"name": "algebraic_closure.step", "description": "The `n`th step of constructing `algebraic_closure`.", "p": "mathlib"}, {"name": "algebraic_closure.is_alg_closure", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.eval_X_self", "description": "Sends a monic irreducible polynomial `f` to `f(x_f)` where `x_f` is a formal indeterminate.", "p": "mathlib"}, {"name": "algebraic_closure.of_step_hom", "description": "Canonical algebra embedding from the `n`th step to the algebraic closure.", "p": "mathlib"}, {"name": "algebraic_closure.of_step", "description": "The canonical ring embedding from the `n`th step to the algebraic closure.", "p": "mathlib"}, {"name": "algebraic_closure.adjoin_monic.is_integral", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.step.field", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.step_aux", "description": "The `n`th step of constructing `algebraic_closure`, together with its `field` instance.", "p": "mathlib"}, {"name": "algebraic_closure.algebra", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.to_step_of_le", "description": "The canonical ring homomorphism to a step with a greater index.", "p": "mathlib"}, {"name": "algebraic_closure.field", "description": "", "p": "mathlib"}, {"name": "algebraic_closure", "description": " The canonical algebraic closure of a field, the direct limit of adding roots to the field for\neach polynomial over the field.", "p": "mathlib"}, {"name": "algebraic_closure.coe_to_step_of_le", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.le_max_ideal", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.to_adjoin_monic", "description": "The canonical ring homomorphism to `adjoin_monic k`.", "p": "mathlib"}, {"name": "algebraic_closure.adjoin_monic.exists_root", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.is_alg_closed", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.step.algebra_succ", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.adjoin_monic.algebra_map", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.of_step_succ", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.to_splitting_field_eval_X_self", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.span_eval_ne_top", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.max_ideal", "description": "A random maximal ideal that contains `span_eval k`", "p": "mathlib"}, {"name": "algebraic_closure.step.is_integral", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.is_algebraic", "description": "", "p": "mathlib"}, {"name": "algebraic_closure.monic_irreducible", "description": "The subtype of monic irreducible polynomials", "p": "mathlib"}, {"name": "pmf.mem_support_bind_on_support_iff", "description": "", "p": "mathlib"}, {"name": "pmf.bind_pure", "description": "", "p": "mathlib"}, {"name": "pmf.pure", "description": "The pure `pmf` is the `pmf` where all the mass lies in one point.\n The value of `pure a` is `1` at `a` and `0` elsewhere.", "p": "mathlib"}, {"name": "pmf.bind_on_support", "description": "Generalized version of `bind` allowing `f` to only be defined on the support of `p`.\n `p.bind f` is equivalent to `p.bind_on_support (\u03bb a _, f a)`, see `bind_on_support_eq_bind`", "p": "mathlib"}, {"name": "pmf.bind_on_support_bind_on_support", "description": "", "p": "mathlib"}, {"name": "pmf.bind_on_support_pure", "description": "", "p": "mathlib"}, {"name": "pmf.bind_const", "description": "", "p": "mathlib"}, {"name": "pmf.bind_on_support_eq_bind", "description": "`bind_on_support` reduces to `bind` if `f` doesn't depend on the additional hypothesis", "p": "mathlib"}, {"name": "pmf.bind_on_support_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "pmf.to_outer_measure_bind_apply", "description": "", "p": "mathlib"}, {"name": "pmf.pure_apply", "description": "", "p": "mathlib"}, {"name": "pmf.to_outer_measure_bind_on_support_apply", "description": "", "p": "mathlib"}, {"name": "pmf.bind", "description": "The monadic bind operation for `pmf`.", "p": "mathlib"}, {"name": "pmf.to_measure_pure_apply", "description": "The measure of a set under `pure a` is `1` for sets containing `a` and `0` otherwise", "p": "mathlib"}, {"name": "pmf.monad", "description": "", "p": "mathlib"}, {"name": "pmf.to_measure_bind_on_support_apply", "description": "The measure of a set under `p.bind_on_support f` is the sum over `a : \u03b1`\n of the probability of `a` under `p` times the measure of the set under `f a _`.\n The additional if statement is needed since `f` is only a partial function", "p": "mathlib"}, {"name": "pmf.pure_bind_on_support", "description": "", "p": "mathlib"}, {"name": "pmf.bind_apply", "description": "", "p": "mathlib"}, {"name": "pmf.to_pmf_dirac", "description": "", "p": "mathlib"}, {"name": "pmf.mem_support_pure_iff", "description": "", "p": "mathlib"}, {"name": "pmf.mem_support_bind_iff", "description": "", "p": "mathlib"}, {"name": "pmf.support_bind_on_support", "description": "", "p": "mathlib"}, {"name": "pmf.bind_comm", "description": "", "p": "mathlib"}, {"name": "pmf.to_measure_bind_apply", "description": "The measure of a set under `p.bind f` is the sum over `a : \u03b1`\n of the probability of `a` under `p` times the measure of the set under `f a`", "p": "mathlib"}, {"name": "pmf.bind_on_support_comm", "description": "", "p": "mathlib"}, {"name": "pmf.support_bind", "description": "", "p": "mathlib"}, {"name": "pmf.bind_on_support_apply", "description": "", "p": "mathlib"}, {"name": "pmf.pure_bind", "description": "", "p": "mathlib"}, {"name": "pmf.pure_apply_of_ne", "description": "", "p": "mathlib"}, {"name": "pmf.to_outer_measure_pure_apply", "description": "", "p": "mathlib"}, {"name": "pmf.pure_apply_self", "description": "", "p": "mathlib"}, {"name": "pmf.bind_bind", "description": "", "p": "mathlib"}, {"name": "pmf.to_measure_pure", "description": "", "p": "mathlib"}, {"name": "pmf.inhabited", "description": "", "p": "mathlib"}, {"name": "pmf.support_pure", "description": "", "p": "mathlib"}, {"name": "number_field.canonical_embedding.integer_lattice.inter_ball_finite", "description": "", "p": "mathlib"}, {"name": "number_field.canonical_embedding.nnnorm_eq", "description": "", "p": "mathlib"}, {"name": "number_field.canonical_embedding.integer_lattice", "description": "The image of `\ud835\udcde K` as a subring of `\u211d^r\u2081 \u00d7 \u2102^r\u2082`.", "p": "mathlib"}, {"name": "number_field.canonical_embedding.equiv_integer_lattice", "description": "The linear equiv between `\ud835\udcde K` and the integer lattice.", "p": "mathlib"}, {"name": "number_field.canonical_embedding.space_rank", "description": "", "p": "mathlib"}, {"name": "number_field.canonical_embedding.apply_at_real_infinite_place", "description": "", "p": "mathlib"}, {"name": "number_field.canonical_embedding", "description": "The canonical embedding of a number field `K` of signature `(r\u2081, r\u2082)` into `\u211d^r\u2081 \u00d7 \u2102^r\u2082`.", "p": "mathlib"}, {"name": "number_field.canonical_embedding.apply_at_complex_infinite_place", "description": "", "p": "mathlib"}, {"name": "number_field.canonical_embedding_injective", "description": "", "p": "mathlib"}, {"name": "number_field.canonical_embedding.non_trivial_space", "description": "", "p": "mathlib"}, {"name": "number_field.canonical_embedding.integer_lattice.countable", "description": "", "p": "mathlib"}, {"name": "number_field.canonical_embedding.norm_le_iff", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.eval_from_nil", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.inhabited", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.eval_from", "description": " `M.eval_from S x` computes all possible paths through `M` with input `x` starting at an element\nof `S`.", "p": "mathlib"}, {"name": "\u03b5_NFA.to_NFA", "description": "`M.to_NFA` is an `NFA` constructed from an `\u03b5_NFA` `M`.", "p": "mathlib"}, {"name": "\u03b5_NFA.mem_step_set_iff", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.start_zero", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.step_set", "description": "`M.step_set S a` is the union of the \u03b5-closure of `M.step s a` for all `s \u2208 S`.", "p": "mathlib"}, {"name": "\u03b5_NFA.eval_from_append_singleton", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.step_set_empty", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.start_one", "description": "", "p": "mathlib"}, {"name": "NFA.to_\u03b5_NFA_\u03b5_closure", "description": "", "p": "mathlib"}, {"name": "NFA.to_\u03b5_NFA_eval_from_match", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.has_one", "description": "", "p": "mathlib"}, {"name": "NFA.to_\u03b5_NFA_correct", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.\u03b5_closure_univ", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.accepts", "description": "`M.accepts` is the language of `x` such that there is an accept state in `M.eval x`.", "p": "mathlib"}, {"name": "\u03b5_NFA.to_NFA_correct", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.\u03b5_closure_empty", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.\u03b5_closure", "description": " The `\u03b5_closure` of a set is the set of states which can be reached by taking a finite string of\n\u03b5-transitions from an element of the set.", "p": "mathlib"}, {"name": "\u03b5_NFA.\u03b5_closure.base", "description": " The `\u03b5_closure` of a set is the set of states which can be reached by taking a finite string of\n\u03b5-transitions from an element of the set.", "p": "mathlib"}, {"name": "\u03b5_NFA.\u03b5_closure.step", "description": " The `\u03b5_closure` of a set is the set of states which can be reached by taking a finite string of\n\u03b5-transitions from an element of the set.", "p": "mathlib"}, {"name": "\u03b5_NFA.eval", "description": " `M.eval x` computes all possible paths through `M` with input `x` starting at an element of\n`M.start`.", "p": "mathlib"}, {"name": "\u03b5_NFA.has_zero", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA", "description": "An `\u03b5_NFA` is a set of states (`\u03c3`), a transition function from state to state labelled by the\n alphabet (`step`), a starting state (`start`) and a set of acceptance states (`accept`).\n Note the transition function sends a state to a `set` of states and can make \u03b5-transitions by\n inputing `none`.\n Since this definition allows for Automata with infinite states, a `fintype` instance must be\n supplied for true `\u03b5_NFA`'s.", "p": "mathlib"}, {"name": "\u03b5_NFA.step", "description": "An `\u03b5_NFA` is a set of states (`\u03c3`), a transition function from state to state labelled by the\n alphabet (`step`), a starting state (`start`) and a set of acceptance states (`accept`).\n Note the transition function sends a state to a `set` of states and can make \u03b5-transitions by\n inputing `none`.\n Since this definition allows for Automata with infinite states, a `fintype` instance must be\n supplied for true `\u03b5_NFA`'s.", "p": "mathlib"}, {"name": "\u03b5_NFA.start", "description": "An `\u03b5_NFA` is a set of states (`\u03c3`), a transition function from state to state labelled by the\n alphabet (`step`), a starting state (`start`) and a set of acceptance states (`accept`).\n Note the transition function sends a state to a `set` of states and can make \u03b5-transitions by\n inputing `none`.\n Since this definition allows for Automata with infinite states, a `fintype` instance must be\n supplied for true `\u03b5_NFA`'s.", "p": "mathlib"}, {"name": "\u03b5_NFA.accept", "description": "An `\u03b5_NFA` is a set of states (`\u03c3`), a transition function from state to state labelled by the\n alphabet (`step`), a starting state (`start`) and a set of acceptance states (`accept`).\n Note the transition function sends a state to a `set` of states and can make \u03b5-transitions by\n inputing `none`.\n Since this definition allows for Automata with infinite states, a `fintype` instance must be\n supplied for true `\u03b5_NFA`'s.", "p": "mathlib"}, {"name": "\u03b5_NFA.pumping_lemma", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.accept_zero", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.step_one", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.eval_from_empty", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.to_NFA_eval_from_match", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.eval_nil", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.eval_from_singleton", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.step_zero", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.subset_\u03b5_closure", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.accept_one", "description": "", "p": "mathlib"}, {"name": "\u03b5_NFA.eval_singleton", "description": "", "p": "mathlib"}, {"name": "NFA.to_\u03b5_NFA", "description": "`M.to_\u03b5_NFA` is an `\u03b5_NFA` constructed from an `NFA` `M` by using the same start and accept\n states and transition functions.", "p": "mathlib"}, {"name": "\u03b5_NFA.eval_append_singleton", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra_preadditive_hom_group_neg_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra_preadditive", "description": "The category of algebras over an additive endofunctor on a preadditive category is preadditive.", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra_preadditive_hom_group_neg_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra_preadditive_hom_group_nsmul_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra_preadditive_hom_group_add_f", "description": "", "p": "mathlib"}, {"name": "category_theory.algebra.forget_additive", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra_preadditive_hom_group_zero_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra_preadditive_hom_group_sub_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra_preadditive_hom_group_add_f", "description": "", "p": "mathlib"}, {"name": "category_theory.coalgebra.forget_additive", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra_preadditive_hom_group_sub_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra_preadditive_hom_group_nsmul_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra_preadditive_hom_group_zsmul_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra_preadditive_hom_group_zsmul_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra_preadditive_hom_group_zero_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra_preadditive", "description": "", "p": "mathlib"}, {"name": "ssyt.inhabited", "description": "", "p": "mathlib"}, {"name": "ssyt.copy_eq", "description": "", "p": "mathlib"}, {"name": "ssyt.fun_like", "description": "", "p": "mathlib"}, {"name": "ssyt.col_weak", "description": "", "p": "mathlib"}, {"name": "ssyt.highest_weight_apply", "description": "", "p": "mathlib"}, {"name": "ssyt.coe_copy", "description": "", "p": "mathlib"}, {"name": "ssyt.zeros", "description": "", "p": "mathlib"}, {"name": "ssyt.row_weak", "description": "", "p": "mathlib"}, {"name": "ssyt.has_coe_to_fun", "description": " Helper instance for when there's too many metavariables to apply\n`fun_like.has_coe_to_fun` directly.", "p": "mathlib"}, {"name": "ssyt.to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "ssyt.col_strict", "description": "", "p": "mathlib"}, {"name": "ssyt.highest_weight", "description": "The \"highest weight\" SSYT of a given shape is has all i's in row i, for each i.", "p": "mathlib"}, {"name": "ssyt.row_weak_of_le", "description": "", "p": "mathlib"}, {"name": "ssyt.copy", "description": " Copy of an `ssyt \u03bc` with a new `entry` equal to the old one. Useful to fix definitional\nequalities.", "p": "mathlib"}, {"name": "ssyt.ext", "description": "", "p": "mathlib"}, {"name": "ssyt", "description": " A semistandard Young tableau (SSYT) is a filling of the cells of a Young diagram by natural\nnumbers, such that the entries in each row are weakly increasing (left to right), and the entries\nin each column are strictly increasing (top to bottom).\n\nHere, an SSYT is represented as an unrestricted function `\u2115 \u2192 \u2115 \u2192 \u2115` that, for reasons\nof extensionality, is required to vanish outside `\u03bc`.", "p": "mathlib"}, {"name": "ssyt.entry", "description": " A semistandard Young tableau (SSYT) is a filling of the cells of a Young diagram by natural\nnumbers, such that the entries in each row are weakly increasing (left to right), and the entries\nin each column are strictly increasing (top to bottom).\n\nHere, an SSYT is represented as an unrestricted function `\u2115 \u2192 \u2115 \u2192 \u2115` that, for reasons\nof extensionality, is required to vanish outside `\u03bc`.", "p": "mathlib"}, {"name": "ssyt.row_weak'", "description": " A semistandard Young tableau (SSYT) is a filling of the cells of a Young diagram by natural\nnumbers, such that the entries in each row are weakly increasing (left to right), and the entries\nin each column are strictly increasing (top to bottom).\n\nHere, an SSYT is represented as an unrestricted function `\u2115 \u2192 \u2115 \u2192 \u2115` that, for reasons\nof extensionality, is required to vanish outside `\u03bc`.", "p": "mathlib"}, {"name": "ssyt.col_strict'", "description": " A semistandard Young tableau (SSYT) is a filling of the cells of a Young diagram by natural\nnumbers, such that the entries in each row are weakly increasing (left to right), and the entries\nin each column are strictly increasing (top to bottom).\n\nHere, an SSYT is represented as an unrestricted function `\u2115 \u2192 \u2115 \u2192 \u2115` that, for reasons\nof extensionality, is required to vanish outside `\u03bc`.", "p": "mathlib"}, {"name": "ssyt.zeros'", "description": " A semistandard Young tableau (SSYT) is a filling of the cells of a Young diagram by natural\nnumbers, such that the entries in each row are weakly increasing (left to right), and the entries\nin each column are strictly increasing (top to bottom).\n\nHere, an SSYT is represented as an unrestricted function `\u2115 \u2192 \u2115 \u2192 \u2115` that, for reasons\nof extensionality, is required to vanish outside `\u03bc`.", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.dual_equiv", "description": "The equivalence between `NonemptyFinLinOrd` and itself induced by `order_dual` both ways.", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.iso.mk_inv", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd_dual_comp_forget_to_FinPartOrd", "description": "The forgetful functor `NonemptyFinLinOrd \u2964 FinPartOrd` and `order_dual` commute.", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.nonempty_fin_lin_ord", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.has_forget_to_FinPartOrd", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.category_theory.split_epi_category", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.dual_obj", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.dual_map", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.has_forget_to_LinOrd", "description": "", "p": "mathlib"}, {"name": "ulift.nonempty_fin_lin_ord", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.iso.mk", "description": " Constructs an equivalence between nonempty finite linear orders from an order isomorphism\nbetween them.", "p": "mathlib"}, {"name": "order_dual.nonempty_fin_lin_ord", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.mono_iff_injective", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.iso.mk_hom", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.coe_of", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd", "description": "The category of nonempty finite linear orders.", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.inhabited", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.concrete_category", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.epi_iff_surjective", "description": "", "p": "mathlib"}, {"name": "punit.nonempty_fin_lin_ord", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.large_category", "description": "", "p": "mathlib"}, {"name": "fin.nonempty_fin_lin_ord", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.category_theory.limits.has_strong_epi_mono_factorisations", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.dual", "description": "`order_dual` as a functor.", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd_dual_comp_forget_to_LinOrd", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.dual_equiv_functor", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.nonempty_fin_lin_ord.to_linear_order.category_theory.bundled_hom.parent_projection", "description": "", "p": "mathlib"}, {"name": "nonempty_fin_lin_ord.to_bounded_order", "description": "", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.of", "description": "Construct a bundled `NonemptyFinLinOrd` from the underlying type and typeclass.", "p": "mathlib"}, {"name": "nonempty_fin_lin_ord", "description": "A typeclass for nonempty finite linear orders.", "p": "mathlib"}, {"name": "nonempty_fin_lin_ord.to_fintype", "description": "A typeclass for nonempty finite linear orders.", "p": "mathlib"}, {"name": "nonempty_fin_lin_ord.to_linear_order", "description": "A typeclass for nonempty finite linear orders.", "p": "mathlib"}, {"name": "nonempty_fin_lin_ord.nonempty", "description": "A typeclass for nonempty finite linear orders.", "p": "mathlib"}, {"name": "NonemptyFinLinOrd.dual_equiv_inverse", "description": "", "p": "mathlib"}, {"name": "counterexample.sorgenfrey_line.is_closed_iff", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.topological_space", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.is_open_Ici", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.map_to_real_nhds", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.is_open_iff", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.nhds_basis_Ico", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.is_open_Ico", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.exists_Ico_disjoint_closed", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.linear_ordered_field", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.is_closed_of_subset_antidiagonal", "description": "Any subset of an antidiagonal `{(x, y) : \u211d\u2097 \u00d7 \u211d\u2097| x + y = c}` is a closed set.", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.is_clopen_Ici_prod", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.nhds_basis_Ico_rat", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.t5_space", "description": "Sorgenfrey line is a completely normal Hausdorff topological space.", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.nhds_eq_comap", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.topological_space.first_countable_topology", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.archimedean", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.nhds_antitone_basis_Ico_inv_pnat", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.conditionally_complete_linear_order", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.not_metrizable_space", "description": "Topology on the Sorgenfrey line is not metrizable.", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.to_real", "description": "Ring homomorphism between the Sorgenfrey line and the standard real line.", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.nhds_basis_Ico_inv_pnat", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.nhds_eq_map", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.is_clopen_Ici", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.not_second_countable_topology", "description": "Topology on the Sorgenfrey line is not second countable.", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.nhds_countable_basis_Ico_inv_pnat", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.has_continuous_add", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.continuous_to_real", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.order_closed_topology", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.is_clopen_Ico", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.is_closed_antidiagonal", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.topological_space.separable_space", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line", "description": " The Sorgenfrey line. It is the real line with the topology space structure generated by\nhalf-open intervals `set.Ico a b`.", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.is_clopen_Iio", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.dense_range_coe_rat", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.nhds_prod_antitone_basis_inv_pnat", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.not_normal_space_prod", "description": "The product of the Sorgenfrey line and itself is not a normal topological space.", "p": "mathlib-counterexamples"}, {"name": "counterexample.sorgenfrey_line.totally_disconnected_space", "description": "", "p": "mathlib-counterexamples"}, {"name": "tactic.interactive.dsimp_result", "description": "`dsimp_result { tac }`\nattempts to run a tactic block `tac`,\nintercepts any results the tactic block would have assigned to the goals,\nand runs `dsimp` on those results\nbefore assigning the simplified values to the original goals.\n\nYou can use the usual interactive syntax for `dsimp`, e.g.\n`dsimp_result only [a, b, c] with attr { tac }`.", "p": "mathlib"}, {"name": "tactic.interactive.simp_result", "description": "`simp_result { tac }`\nattempts to run a tactic block `tac`,\nintercepts any results the tactic block would have assigned to the goals,\nand runs `simp` on those results\nbefore assigning the simplified values to the original goals.\n\nYou can use the usual interactive syntax for `simp`, e.g.\n`simp_result only [a, b, c] with attr { tac }`.", "p": "mathlib"}, {"name": "tactic.intercept_result", "description": "`intercept_result m t`\nattempts to run a tactic `t`,\nintercepts any results `t` assigns to the goals,\nand runs `m : expr \u2192 tactic expr` on each of the expressions\nbefore assigning the returned values to the original goals.\n\nBecause `intercept_result` uses `unsafe.type_context.assign` rather than `unify`,\nif the tactic `m` does something unreasonable\nyou may produce terms that don't typecheck,\npossibly with mysterious error messages.\nBe careful!", "p": "mathlib"}, {"name": "tactic.simp_result", "description": "`simp_result t`\nattempts to run a tactic `t`,\nintercepts any results `t` assigns to the goals,\nand runs `simp` on those results\nbefore assigning the simplified values to the original goals.", "p": "mathlib"}, {"name": "tactic_doc.tactic.simp_result", "description": "`simp_result { tac }`\nattempts to run a tactic block `tac`,\nintercepts any results the tactic block would have assigned to the goals,\nand runs `simp` on those results\nbefore assigning the simplified values to the original goals.\n\nYou can use the usual interactive syntax for `simp`, e.g.\n`simp_result only [a, b, c] with attr { tac }`.\n\n`dsimp_result { tac }` works similarly, internally using `dsimp`\n(and so only simplifiying along definitional lemmas).", "p": "mathlib"}, {"name": "tactic.dsimp_result", "description": "`dsimp_result t`\nattempts to run a tactic `t`,\nintercepts any results it assigns to the goals,\nand runs `dsimp` on those results\nbefore assigning the simplified values to the original goals.", "p": "mathlib"}, {"name": "measure_theory.content.le_inner_content", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.inner_content", "description": "Constructing the inner content of a content. From a content defined on the compact sets, we\n obtain a function defined on all open sets, by taking the supremum of the content of all compact\n subsets.", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.is_mul_left_invariant_outer_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.apply_eq_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_mono", "description": "This is \"unbundled\", because that it required for the API of `induced_outer_measure`.", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_exists_compact", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.empty", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.has_coe_to_fun", "description": " Although the `to_fun` field of a content takes values in `\u211d\u22650`, we register a coercion to\nfunctions taking values in `\u211d\u22650\u221e` as most constructions below rely on taking suprs and infs, which\nis more convenient in a complete lattice, and aim at constructing a measure.", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_preimage", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_eq_infi", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_interior_compacts", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.content_regular_exists_compact", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.sup_disjoint", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_Union_nat", "description": "The inner content of a union of sets is at most the sum of the individual inner contents.\n This is the \"unbundled\" version of `inner_content_Sup_nat`.\n It required for the API of `induced_outer_measure`.", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_bot", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.measure_eq_content_of_regular", "description": "If `\u03bc` is a regular content, then the measure induced by `\u03bc` will agree with `\u03bc`\n  on compact sets.", "p": "mathlib"}, {"name": "measure_theory.content.inhabited", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.is_add_left_invariant_outer_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure", "description": "Extending a content on compact sets to an outer measure on all sets.", "p": "mathlib"}, {"name": "measure_theory.content.regular", "description": "In a locally compact space, any measure constructed from a content is regular.", "p": "mathlib"}, {"name": "measure_theory.content.le_outer_measure_compacts", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.is_mul_left_invariant_inner_content", "description": "", "p": "mathlib"}, {"name": "measure_theory.content", "description": " A content is an additive function on compact sets taking values in `\u211d\u22650`. It is a device\nfrom which one can define a measure.", "p": "mathlib"}, {"name": "measure_theory.content.to_fun", "description": " A content is an additive function on compact sets taking values in `\u211d\u22650`. It is a device\nfrom which one can define a measure.", "p": "mathlib"}, {"name": "measure_theory.content.mono'", "description": " A content is an additive function on compact sets taking values in `\u211d\u22650`. It is a device\nfrom which one can define a measure.", "p": "mathlib"}, {"name": "measure_theory.content.sup_disjoint'", "description": " A content is an additive function on compact sets taking values in `\u211d\u22650`. It is a device\nfrom which one can define a measure.", "p": "mathlib"}, {"name": "measure_theory.content.sup_le'", "description": " A content is an additive function on compact sets taking values in `\u211d\u22650`. It is a device\nfrom which one can define a measure.", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_pos_of_is_add_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.is_add_left_invariant_inner_content", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.measure", "description": "The measure induced by the outer measure coming from a content, on the Borel sigma-algebra.", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_pos_of_is_mul_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_mono'", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_pos_of_is_mul_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_Sup_nat", "description": " The inner content of a supremum of opens is at most the sum of the individual inner\ncontents.", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_of_is_compact", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.sup_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_opens", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.content_regular", "description": "A content `\u03bc` is called regular if for every compact set `K`,\n `\u03bc(K) = inf {\u03bc(K') : K \u2282 int K' \u2282 K'`. See Paul Halmos (1950), Measure Theory, \u00a754", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_pos_of_is_add_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_exists_compact", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.measure_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_of_is_open", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_lt_top_of_is_compact", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.inner_content_comap", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.outer_measure_exists_open", "description": "", "p": "mathlib"}, {"name": "measure_theory.content.borel_le_caratheodory", "description": "For the outer measure coming from a content, all Borel sets are measurable.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.as_cofork", "description": "A split coequalizer clearly induces a cofork.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.as_cofork_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.has_split_coequalizer.coequalizer_of_split", "description": "Get the coequalizer object from the typeclass `is_split_pair`.", "p": "mathlib"}, {"name": "category_theory.limits.has_coequalizer_of_has_split_coequalizer", "description": "If a pair has a split coequalizer, it has a coequalizer.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.map", "description": "Split coequalizers are absolute: they are preserved by any functor.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.is_coequalizer", "description": "The cofork induced by a split coequalizer is a coequalizer, justifying the name. In some cases it\nis more convenient to show a given cofork is a coequalizer by showing it is split.", "p": "mathlib"}, {"name": "category_theory.map_is_split_pair", "description": "If `f, g` is split, then `G f, G g` is split.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.right_section_\u03c0_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.map_left_section", "description": "", "p": "mathlib"}, {"name": "category_theory.has_split_coequalizer", "description": "The pair `f,g` is a split pair if there is a `h : Y \u27f6 Z` so that `f, g, h` forms a split coequalizer\nin `C`.", "p": "mathlib"}, {"name": "category_theory.has_split_coequalizer.splittable", "description": "The pair `f,g` is a split pair if there is a `h : Y \u27f6 Z` so that `f, g, h` forms a split coequalizer\nin `C`.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.left_section_top_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.is_split_pair", "description": "The pair `f,g` is a `G`-split pair if there is a `h : G Y \u27f6 Z` so that `G f, G g, h` forms a split\ncoequalizer in `D`.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.left_section_bottom_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.map_right_section", "description": "", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.condition_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer", "description": "A split coequalizer diagram consists of morphisms\n\n      f   \u03c0\n    X \u21c9 Y \u2192 Z\n      g\n\nsatisfying `f \u226b \u03c0 = g \u226b \u03c0` together with morphisms\n\n      t   s\n    X \u2190 Y \u2190 Z\n\nsatisfying `s \u226b \u03c0 = \ud835\udfd9 Z`, `t \u226b g = \ud835\udfd9 Y` and `t \u226b f = \u03c0 \u226b s`.\n\nThe name \"coequalizer\" is appropriate, since any split coequalizer is a coequalizer, see\n`category_theory.is_split_coequalizer.is_coequalizer`.\nSplit coequalizers are also absolute, since a functor preserves all the structure above.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.right_section", "description": "A split coequalizer diagram consists of morphisms\n\n      f   \u03c0\n    X \u21c9 Y \u2192 Z\n      g\n\nsatisfying `f \u226b \u03c0 = g \u226b \u03c0` together with morphisms\n\n      t   s\n    X \u2190 Y \u2190 Z\n\nsatisfying `s \u226b \u03c0 = \ud835\udfd9 Z`, `t \u226b g = \ud835\udfd9 Y` and `t \u226b f = \u03c0 \u226b s`.\n\nThe name \"coequalizer\" is appropriate, since any split coequalizer is a coequalizer, see\n`category_theory.is_split_coequalizer.is_coequalizer`.\nSplit coequalizers are also absolute, since a functor preserves all the structure above.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.left_section", "description": "A split coequalizer diagram consists of morphisms\n\n      f   \u03c0\n    X \u21c9 Y \u2192 Z\n      g\n\nsatisfying `f \u226b \u03c0 = g \u226b \u03c0` together with morphisms\n\n      t   s\n    X \u2190 Y \u2190 Z\n\nsatisfying `s \u226b \u03c0 = \ud835\udfd9 Z`, `t \u226b g = \ud835\udfd9 Y` and `t \u226b f = \u03c0 \u226b s`.\n\nThe name \"coequalizer\" is appropriate, since any split coequalizer is a coequalizer, see\n`category_theory.is_split_coequalizer.is_coequalizer`.\nSplit coequalizers are also absolute, since a functor preserves all the structure above.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.condition", "description": "A split coequalizer diagram consists of morphisms\n\n      f   \u03c0\n    X \u21c9 Y \u2192 Z\n      g\n\nsatisfying `f \u226b \u03c0 = g \u226b \u03c0` together with morphisms\n\n      t   s\n    X \u2190 Y \u2190 Z\n\nsatisfying `s \u226b \u03c0 = \ud835\udfd9 Z`, `t \u226b g = \ud835\udfd9 Y` and `t \u226b f = \u03c0 \u226b s`.\n\nThe name \"coequalizer\" is appropriate, since any split coequalizer is a coequalizer, see\n`category_theory.is_split_coequalizer.is_coequalizer`.\nSplit coequalizers are also absolute, since a functor preserves all the structure above.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.right_section_\u03c0", "description": "A split coequalizer diagram consists of morphisms\n\n      f   \u03c0\n    X \u21c9 Y \u2192 Z\n      g\n\nsatisfying `f \u226b \u03c0 = g \u226b \u03c0` together with morphisms\n\n      t   s\n    X \u2190 Y \u2190 Z\n\nsatisfying `s \u226b \u03c0 = \ud835\udfd9 Z`, `t \u226b g = \ud835\udfd9 Y` and `t \u226b f = \u03c0 \u226b s`.\n\nThe name \"coequalizer\" is appropriate, since any split coequalizer is a coequalizer, see\n`category_theory.is_split_coequalizer.is_coequalizer`.\nSplit coequalizers are also absolute, since a functor preserves all the structure above.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.left_section_bottom", "description": "A split coequalizer diagram consists of morphisms\n\n      f   \u03c0\n    X \u21c9 Y \u2192 Z\n      g\n\nsatisfying `f \u226b \u03c0 = g \u226b \u03c0` together with morphisms\n\n      t   s\n    X \u2190 Y \u2190 Z\n\nsatisfying `s \u226b \u03c0 = \ud835\udfd9 Z`, `t \u226b g = \ud835\udfd9 Y` and `t \u226b f = \u03c0 \u226b s`.\n\nThe name \"coequalizer\" is appropriate, since any split coequalizer is a coequalizer, see\n`category_theory.is_split_coequalizer.is_coequalizer`.\nSplit coequalizers are also absolute, since a functor preserves all the structure above.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.left_section_top", "description": "A split coequalizer diagram consists of morphisms\n\n      f   \u03c0\n    X \u21c9 Y \u2192 Z\n      g\n\nsatisfying `f \u226b \u03c0 = g \u226b \u03c0` together with morphisms\n\n      t   s\n    X \u2190 Y \u2190 Z\n\nsatisfying `s \u226b \u03c0 = \ud835\udfd9 Z`, `t \u226b g = \ud835\udfd9 Y` and `t \u226b f = \u03c0 \u226b s`.\n\nThe name \"coequalizer\" is appropriate, since any split coequalizer is a coequalizer, see\n`category_theory.is_split_coequalizer.is_coequalizer`.\nSplit coequalizers are also absolute, since a functor preserves all the structure above.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.as_cofork_X", "description": "", "p": "mathlib"}, {"name": "category_theory.has_split_coequalizer.coequalizer_\u03c0", "description": "Get the coequalizer morphism from the typeclass `is_split_pair`.", "p": "mathlib"}, {"name": "category_theory.is_split_coequalizer.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.has_split_coequalizer.is_split_coequalizer", "description": "The coequalizer morphism `coequalizer_\u03b9` gives a split coequalizer on `f,g`.", "p": "mathlib"}, {"name": "Lat.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "Lat.category_theory.concrete_category", "description": "", "p": "mathlib"}, {"name": "Lat.coe_of", "description": "", "p": "mathlib"}, {"name": "Lat", "description": "The category of lattices.", "p": "mathlib"}, {"name": "Lat.dual_equiv_inverse", "description": "", "p": "mathlib"}, {"name": "Lat.dual_equiv_functor", "description": "", "p": "mathlib"}, {"name": "Lat.iso.mk", "description": "Constructs an isomorphism of lattices from an order isomorphism between them.", "p": "mathlib"}, {"name": "Lat.lattice", "description": "", "p": "mathlib"}, {"name": "Lat.lattice_hom.category_theory.bundled_hom", "description": "", "p": "mathlib"}, {"name": "Lat.has_forget_to_PartOrd", "description": "", "p": "mathlib"}, {"name": "Lat.inhabited", "description": "", "p": "mathlib"}, {"name": "Lat.dual_obj", "description": "", "p": "mathlib"}, {"name": "Lat.dual_map", "description": "", "p": "mathlib"}, {"name": "Lat.iso.mk_inv", "description": "", "p": "mathlib"}, {"name": "Lat.dual", "description": "`order_dual` as a functor.", "p": "mathlib"}, {"name": "Lat.of", "description": "Construct a bundled `Lat` from a `lattice`.", "p": "mathlib"}, {"name": "Lat.dual_equiv", "description": "The equivalence between `Lat` and itself induced by `order_dual` both ways.", "p": "mathlib"}, {"name": "Lat.category_theory.large_category", "description": "", "p": "mathlib"}, {"name": "Lat_dual_comp_forget_to_PartOrd", "description": "", "p": "mathlib"}, {"name": "Lat.iso.mk_hom", "description": "", "p": "mathlib"}, {"name": "left_cancel_monoid.to_monoid_injective", "description": "", "p": "mathlib"}, {"name": "add_right_cancel_monoid.to_add_monoid_injective", "description": "", "p": "mathlib"}, {"name": "comm_monoid.to_monoid_injective", "description": "", "p": "mathlib"}, {"name": "add_cancel_monoid.ext", "description": "", "p": "mathlib"}, {"name": "monoid.ext", "description": "", "p": "mathlib"}, {"name": "left_cancel_monoid.ext", "description": "", "p": "mathlib"}, {"name": "add_cancel_comm_monoid.ext", "description": "", "p": "mathlib"}, {"name": "comm_group.ext", "description": "", "p": "mathlib"}, {"name": "right_cancel_monoid.to_monoid_injective", "description": "", "p": "mathlib"}, {"name": "add_cancel_comm_monoid.to_add_comm_monoid_injective", "description": "", "p": "mathlib"}, {"name": "div_inv_monoid.ext", "description": "", "p": "mathlib"}, {"name": "add_comm_group.ext", "description": "", "p": "mathlib"}, {"name": "add_comm_monoid.to_add_monoid_injective", "description": "", "p": "mathlib"}, {"name": "comm_monoid.ext", "description": "", "p": "mathlib"}, {"name": "cancel_monoid.ext", "description": "", "p": "mathlib"}, {"name": "sub_neg_monoid.ext", "description": "", "p": "mathlib"}, {"name": "cancel_comm_monoid.to_comm_monoid_injective", "description": "", "p": "mathlib"}, {"name": "add_right_cancel_monoid.ext", "description": "", "p": "mathlib"}, {"name": "add_cancel_monoid.to_left_cancel_add_monoid_injective", "description": "", "p": "mathlib"}, {"name": "cancel_monoid.to_left_cancel_monoid_injective", "description": "", "p": "mathlib"}, {"name": "add_left_cancel_monoid.to_add_monoid_injective", "description": "", "p": "mathlib"}, {"name": "cancel_comm_monoid.ext", "description": "", "p": "mathlib"}, {"name": "right_cancel_monoid.ext", "description": "", "p": "mathlib"}, {"name": "add_left_cancel_monoid.ext", "description": "", "p": "mathlib"}, {"name": "add_comm_monoid.ext", "description": "", "p": "mathlib"}, {"name": "add_monoid.ext", "description": "", "p": "mathlib"}, {"name": "group.ext", "description": "", "p": "mathlib"}, {"name": "add_group.ext", "description": "", "p": "mathlib"}, {"name": "pexpr.get_uninst_pis", "description": "", "p": "mathlib"}, {"name": "expr.get_pis", "description": "", "p": "mathlib"}, {"name": "find_cmd", "description": "The `find` command from `tactic.find` allows to find definitions lemmas using\npattern matching on the type. For instance:\n\n```lean\nimport tactic.find\n\nrun_cmd tactic.skip\n\n#find _ + _ = _ + _\n#find (_ : \u2115) + _ = _ + _\n#find \u2115 \u2192 \u2115\n```\n\nThe tactic `library_search` is an alternate way to find lemmas in the library.", "p": "mathlib"}, {"name": "tactic_doc.command.#find", "description": "The `find` command from `tactic.find` allows to find definitions lemmas using\npattern matching on the type. For instance:\n\n```lean\nimport tactic.find\n\nrun_cmd tactic.skip\n\n#find _ + _ = _ + _\n#find (_ : \u2115) + _ = _ + _\n#find \u2115 \u2192 \u2115\n```\n\nThe tactic `library_search` is an alternate way to find lemmas in the library.", "p": "mathlib"}, {"name": "continuous_map.normed_star_group", "description": "", "p": "mathlib"}, {"name": "continuous_map.normed_ring", "description": "", "p": "mathlib"}, {"name": "continuous_map.equiv_bounded_of_compact_apply", "description": "", "p": "mathlib"}, {"name": "continuous_map.isometry_equiv_bounded_of_compact_to_equiv", "description": "", "p": "mathlib"}, {"name": "continuous_map.comp_right_continuous_map", "description": "Precomposition by a continuous map is itself a continuous map between spaces of continuous maps.", "p": "mathlib"}, {"name": "bounded_continuous_function.dist_to_continuous_map", "description": "", "p": "mathlib"}, {"name": "continuous_map.neg_norm_le_apply", "description": "", "p": "mathlib"}, {"name": "continuous_map.add_equiv_bounded_of_compact_symm_apply", "description": "", "p": "mathlib"}, {"name": "continuous_map.nnnorm_lt_iff", "description": "", "p": "mathlib"}, {"name": "continuous_map.metric_space", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.comp_left_continuous_compact", "description": "Postcomposition of continuous functions into a normed module by a continuous linear map is a\ncontinuous linear map.\nTransferred version of `continuous_linear_map.comp_left_continuous_bounded`,\nupgraded version of `continuous_linear_map.comp_left_continuous`,\nsimilar to `linear_map.comp_left`.", "p": "mathlib"}, {"name": "continuous_map.comp_right_alg_hom_continuous", "description": "", "p": "mathlib"}, {"name": "continuous_map.uniform_embedding_equiv_bounded_of_compact", "description": "", "p": "mathlib"}, {"name": "continuous_map.linear_isometry_bounded_of_compact_to_add_equiv", "description": "", "p": "mathlib"}, {"name": "continuous_map.dist_lt_of_dist_lt_modulus", "description": "", "p": "mathlib"}, {"name": "