thlib"}, {"name": "linear_equiv.conj", "description": " If `M` and `M\u2082` are linearly isomorphic then the two spaces of linear maps from `M` and `M\u2082` to\nthemselves are linearly isomorphic.", "p": "mathlib"}, {"name": "linear_equiv.of_submodule'_to_linear_map", "description": "", "p": "mathlib"}, {"name": "submodule.gi_map_comap", "description": "`map f` and `comap f` form a `galois_insertion` when `f` is surjective.", "p": "mathlib"}, {"name": "linear_equiv.of_linear_symm_apply", "description": "", "p": "mathlib"}, {"name": "submodule.mem_comap", "description": "", "p": "mathlib"}, {"name": "submodule.map_infi_comap_of_surjective", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_submodules_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.arrow_congr", "description": " A linear isomorphism between the domains and codomains of two spaces of linear maps gives a\nlinear isomorphism between the two function spaces.", "p": "mathlib"}, {"name": "add_monoid_hom_lequiv_nat_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.range_cod_restrict", "description": "", "p": "mathlib"}, {"name": "submodule.comap_le_comap_iff_of_surjective", "description": "", "p": "mathlib"}, {"name": "linear_map_class.ker_eq_bot", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom_lequiv_int_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_left_inverse_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.ker", "description": " The kernel of a linear map `f : M \u2192 M\u2082` is defined to be `comap f \u22a5`. This is equivalent to the\nset of `x : M` such that `f x = 0`. The kernel is a submodule of `M`.", "p": "mathlib"}, {"name": "linear_map.cod_restrict", "description": " A linear map `f : M\u2082 \u2192 M` whose values lie in a submodule `p \u2286 M` can be restricted to a\nlinear map M\u2082 \u2192 p.", "p": "mathlib"}, {"name": "linear_map.range_comp_le_range", "description": "", "p": "mathlib"}, {"name": "submodule.comap_smul", "description": "", "p": "mathlib"}, {"name": "finsupp.linear_equiv.finsupp_unique_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.linear_equiv_fun_on_finite_symm_coe", "description": "", "p": "mathlib"}, {"name": "linear_equiv.zero_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map", "description": "The pushforward of a submodule `p \u2286 M` by `f : M \u2192 M\u2082`", "p": "mathlib"}, {"name": "submodule.mem_left_iff_eq_zero_of_disjoint", "description": "", "p": "mathlib"}, {"name": "linear_map.fun_left_surjective_of_injective", "description": "", "p": "mathlib"}, {"name": "submodule.comap_subtype_equiv_of_le_apply_coe", "description": "", "p": "mathlib"}, {"name": "linear_equiv.arrow_congr_trans", "description": "", "p": "mathlib"}, {"name": "linear_map.sub_mem_ker_iff", "description": "", "p": "mathlib"}, {"name": "submodule.comap_inf", "description": "", "p": "mathlib"}, {"name": "linear_map.le_ker_iff_map", "description": "", "p": "mathlib"}, {"name": "linear_map.restrict_eq_cod_restrict_dom_restrict", "description": "", "p": "mathlib"}, {"name": "linear_equiv.eq_bot_of_equiv", "description": "", "p": "mathlib"}, {"name": "submodule.compatible_maps", "description": " Given modules `M`, `M\u2082` over a commutative ring, together with submodules `p \u2286 M`, `q \u2286 M\u2082`,\nthe set of maps $\\{f \u2208 Hom(M, M\u2082) | f(p) \u2286 q \\}$ is a submodule of `Hom(M, M\u2082)`.", "p": "mathlib"}, {"name": "submodule.map_supr", "description": "", "p": "mathlib"}, {"name": "linear_map.sum_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_smul", "description": "", "p": "mathlib"}, {"name": "submodule.map_add_le", "description": "", "p": "mathlib"}, {"name": "linear_map.comp_right_apply", "description": "", "p": "mathlib"}, {"name": "pi_eq_sum_univ", "description": "decomposing `x : \u03b9 \u2192 R` as a sum along the canonical basis", "p": "mathlib"}, {"name": "linear_equiv.arrow_congr_apply", "description": "", "p": "mathlib"}, {"name": "submodule.comap_strict_mono_of_surjective", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_finsupp_sum", "description": "", "p": "mathlib"}, {"name": "linear_equiv.arrow_congr_comp", "description": "", "p": "mathlib"}, {"name": "linear_equiv.conj_id", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_eq_bot", "description": "", "p": "mathlib"}, {"name": "linear_map.range_range_restrict", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_smul_index_linear_map'", "description": "", "p": "mathlib"}, {"name": "submodule.eq_zero_of_bot_submodule", "description": "", "p": "mathlib"}, {"name": "submodule.neg_coe", "description": "", "p": "mathlib"}, {"name": "linear_equiv.coe_of_top_symm_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_strict_mono_of_injective", "description": "", "p": "mathlib"}, {"name": "linear_equiv.fun_congr_left_id", "description": "", "p": "mathlib"}, {"name": "linear_map.pow_apply_mem_of_forall_mem", "description": "", "p": "mathlib"}, {"name": "finsupp.linear_equiv.finsupp_unique_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.range_eq_map", "description": "", "p": "mathlib"}, {"name": "linear_map.dom_restrict", "description": " The restriction of a linear map `f : M \u2192 M\u2082` to a submodule `p \u2286 M` gives a linear map\n`p \u2192 M\u2082`.", "p": "mathlib"}, {"name": "linear_map.mem_ker", "description": "", "p": "mathlib"}, {"name": "submodule.map_subtype.rel_iso", "description": "If `N \u2286 M` then submodules of `N` are the same as submodules of `M` contained in `N`", "p": "mathlib"}, {"name": "submodule.unique", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_linear", "description": "If a linear map has an inverse, it is a linear equivalence.", "p": "mathlib"}, {"name": "linear_equiv.arrow_congr_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.iterate_surjective", "description": "", "p": "mathlib"}, {"name": "linear_map.unique_of_left", "description": "", "p": "mathlib"}, {"name": "linear_map.mem_submodule_image", "description": "", "p": "mathlib"}, {"name": "submodule.map_comp", "description": "", "p": "mathlib"}, {"name": "submodule.coe_of_le", "description": "", "p": "mathlib"}, {"name": "equiv.to_linear_equiv", "description": "An equivalence whose underlying function is linear is a linear equivalence.", "p": "mathlib"}, {"name": "linear_map.commute_pow_left_of_commute", "description": "", "p": "mathlib"}, {"name": "linear_equiv.coe_curry", "description": "", "p": "mathlib"}, {"name": "submodule.map_surjective_of_surjective", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_submodule'", "description": " A linear equivalence of two modules restricts to a linear equivalence from the preimage of any\nsubmodule to that submodule.\n\nThis is `linear_equiv.of_submodule` but with `comap` on the left instead of `map` on the right.", "p": "mathlib"}, {"name": "linear_map.map_dfinsupp_sum", "description": "", "p": "mathlib"}, {"name": "submodule.equiv_map_of_injective", "description": " The pushforward of a submodule by an injective linear map is\nlinearly equivalent to the original submodule. See also `linear_equiv.submodule_map` for a\ncomputable version when `f` has an explicit inverse.", "p": "mathlib"}, {"name": "linear_map.eq_locus_eq_ker_sub", "description": "", "p": "mathlib"}, {"name": "linear_map.fun_left_injective_of_surjective", "description": "", "p": "mathlib"}, {"name": "linear_map.range_eq_bot", "description": "", "p": "mathlib"}, {"name": "linear_map.comp_right", "description": " Composition by `f : M\u2082 \u2192 M\u2083` is a linear map from the space of linear maps `M \u2192 M\u2082`\nto the space of linear maps `M\u2082 \u2192 M\u2083`.", "p": "mathlib"}, {"name": "linear_map.fun_left_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.range", "description": " The range of a linear map `f : M \u2192 M\u2082` is a submodule of `M\u2082`.\nSee Note [range copy pattern].", "p": "mathlib"}, {"name": "linear_map.submodule_image_apply_of_le", "description": "", "p": "mathlib"}, {"name": "submodule.comap_le_comap_smul", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_eq_bot'", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_eq_top", "description": "", "p": "mathlib"}, {"name": "submodule.comap_surjective_of_injective", "description": "", "p": "mathlib"}, {"name": "submodule.order_iso_map_comap_apply'", "description": "", "p": "mathlib"}, {"name": "submodule.order_iso_map_comap_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.iterate_range_coe", "description": "", "p": "mathlib"}, {"name": "submodule.comap_mono", "description": "", "p": "mathlib"}, {"name": "linear_map.range_zero", "description": "", "p": "mathlib"}, {"name": "linear_map.apply\u2097", "description": " Applying a linear map at `v : M`, seen as a linear map from `M \u2192\u2097[R] M\u2082` to `M\u2082`.\nSee also `linear_map.apply\u2097'` for a version that works with two different semirings.\n\nThis is the `linear_map` version of `add_monoid_hom.eval`.", "p": "mathlib"}, {"name": "submodule.mem_map", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_bijective_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.map_le_range", "description": "", "p": "mathlib"}, {"name": "linear_equiv.unique", "description": "Between two zero modules, the zero map is the only equivalence.", "p": "mathlib"}, {"name": "submodule.comap_subtype_self", "description": "", "p": "mathlib"}, {"name": "linear_map.range_to_add_subgroup", "description": "", "p": "mathlib"}, {"name": "submodule.map_subtype_embedding_eq", "description": "", "p": "mathlib"}, {"name": "submodule.map_sup", "description": "", "p": "mathlib"}, {"name": "linear_equiv.coe_curry_symm", "description": "", "p": "mathlib"}, {"name": "linear_equiv.map_sum", "description": "", "p": "mathlib"}, {"name": "linear_map.restrict_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_top_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.ring_lmap_equiv_self_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_neg", "description": "", "p": "mathlib"}, {"name": "linear_map.iterate_bijective", "description": "", "p": "mathlib"}, {"name": "linear_map.dom_restrict'_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_to_add_submonoid'", "description": "", "p": "mathlib"}, {"name": "linear_equiv.fun_congr_left_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.eq_locus_to_add_submonoid", "description": "", "p": "mathlib"}, {"name": "linear_map.iterate_succ", "description": "", "p": "mathlib"}, {"name": "linear_equiv.has_zero", "description": "Between two zero modules, the zero map is an equivalence.", "p": "mathlib"}, {"name": "submodule.map_subtype_range_of_le", "description": "", "p": "mathlib"}, {"name": "linear_equiv.conj_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_injective", "description": " An `injective` linear map `f : M \u2192\u2097[R] M\u2082` defines a linear equivalence\nbetween `M` and `f.range`. See also `linear_map.of_left_inverse`.", "p": "mathlib"}, {"name": "submodule.map_id", "description": "", "p": "mathlib"}, {"name": "submodule.map_bot", "description": "", "p": "mathlib"}, {"name": "submodule.comap_top", "description": "", "p": "mathlib"}, {"name": "linear_equiv.smul_of_ne_zero_apply", "description": "", "p": "mathlib"}, {"name": "submodule.mem_map_of_mem", "description": "", "p": "mathlib"}, {"name": "submodule.coe_equiv_map_of_injective_apply", "description": "", "p": "mathlib"}, {"name": "submodule.mem_map_equiv", "description": "", "p": "mathlib"}, {"name": "submodule.comap_id", "description": "", "p": "mathlib"}, {"name": "submodule.gci_map_comap", "description": "`map f` and `comap f` form a `galois_coinsertion` when `f` is injective.", "p": "mathlib"}, {"name": "linear_equiv.coe_neg", "description": "", "p": "mathlib"}, {"name": "linear_map.range_neg", "description": "", "p": "mathlib"}, {"name": "submodule.map_le_map_iff_of_injective", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_left_inverse", "description": " An linear map `f : M \u2192\u2097[R] M\u2082` with a left-inverse `g : M\u2082 \u2192\u2097[R] M` defines a linear\nequivalence between `M` and `f.range`.\n\nThis is a computable alternative to `linear_equiv.of_injective`, and a bidirectional version of\n`linear_map.range_restrict`.", "p": "mathlib"}, {"name": "linear_map.restrict_coe_apply", "description": "", "p": "mathlib"}, {"name": "submodule.range_subtype", "description": "", "p": "mathlib"}, {"name": "linear_equiv.map_finsupp_sum", "description": "", "p": "mathlib"}, {"name": "linear_map.apply\u2097'_apply_apply", "description": "", "p": "mathlib"}, {"name": "submodule.comap_subtype_equiv_of_le_symm_apply_coe_coe", "description": "", "p": "mathlib"}, {"name": "submodule.apply_coe_mem_map", "description": "", "p": "mathlib"}, {"name": "submodule.comap_zero", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_submodule'_symm_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_subtype_top", "description": " Under the canonical linear map from a submodule `p` to the ambient space `M`, the image of the\nmaximal submodule of `p` is just `p `.", "p": "mathlib"}, {"name": "submodule.comap_infi_map_of_injective", "description": "", "p": "mathlib"}, {"name": "linear_map.iterate_ker", "description": "The increasing sequence of submodules consisting of the kernels of the iterates of a linear map.", "p": "mathlib"}, {"name": "linear_map.ker_to_add_subgroup", "description": "", "p": "mathlib"}, {"name": "linear_map.inj_on_of_disjoint_ker", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_range_restrict", "description": "", "p": "mathlib"}, {"name": "linear_map.range_restrict", "description": " Restrict the codomain of a linear map `f` to `f.range`.\n\nThis is the bundled version of `set.range_factorization`.", "p": "mathlib"}, {"name": "linear_map.ker_le_ker_comp", "description": "", "p": "mathlib"}, {"name": "submodule.equiv_subtype_map_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.range_comp_of_range_eq_top", "description": "", "p": "mathlib"}, {"name": "linear_equiv.fun_congr_left", "description": " Given an `R`-module `M` and an equivalence `m \u2243 n` between arbitrary types,\nconstruct a linear equivalence `(n \u2192 M) \u2243\u2097[R] (m \u2192 M)`", "p": "mathlib"}, {"name": "submodule.mem_right_iff_eq_zero_of_disjoint", "description": "", "p": "mathlib"}, {"name": "submodule.map_subtype_le", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_comp", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom_lequiv_int", "description": "The `R`-linear equivalence between additive morphisms `A \u2192+ B` and `\u2124`-linear morphisms `A \u2192\u2097[\u2124] B`.", "p": "mathlib"}, {"name": "linear_map.restrict", "description": "Restrict domain and codomain of a linear map.", "p": "mathlib"}, {"name": "linear_equiv.neg_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.smul_right\u2097", "description": "The family of linear maps `M\u2082 \u2192 M` parameterised by `f \u2208 M\u2082 \u2192 R`, `x \u2208 M`, is linear in `f`, `x`.", "p": "mathlib"}, {"name": "linear_equiv.neg", "description": "`x \u21a6 -x` as a `linear_equiv`", "p": "mathlib"}, {"name": "linear_map.range_coe", "description": "", "p": "mathlib"}, {"name": "linear_map.finsupp_sum_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.range_comp", "description": "", "p": "mathlib"}, {"name": "submodule.disjoint_iff_comap_eq_bot", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_linear_apply", "description": "", "p": "mathlib"}, {"name": "is_linear_map.is_linear_map_sub", "description": "", "p": "mathlib"}, {"name": "submodule.map_le_iff_le_comap", "description": "", "p": "mathlib"}, {"name": "linear_map.smul_right\u2097_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.submodule_map_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.comp_cod_restrict", "description": "", "p": "mathlib"}, {"name": "linear_map.range_eq_top", "description": "", "p": "mathlib"}, {"name": "submodule.equiv_subtype_map", "description": " Given `p` a submodule of the module `M` and `q` a submodule of `p`, `p.equiv_subtype_map q`\nis the natural `linear_equiv` between `q` and `q.map p.subtype`.", "p": "mathlib"}, {"name": "linear_map.mem_submodule_image_of_le", "description": "", "p": "mathlib"}, {"name": "submodule.nontrivial_iff", "description": "", "p": "mathlib"}, {"name": "linear_map.module.End.nontrivial", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_fn_sum", "description": "", "p": "mathlib"}, {"name": "submodule.order_iso_map_comap", "description": "A linear isomorphism induces an order isomorphism of submodules.", "p": "mathlib"}, {"name": "linear_map.ker_eq_bot_of_cancel", "description": "A monomorphism is injective.", "p": "mathlib"}, {"name": "submodule.gc_map_comap", "description": "", "p": "mathlib"}, {"name": "linear_map.range_comp", "description": "", "p": "mathlib"}, {"name": "submodule.map_subtype.order_embedding", "description": " If `p \u2286 M` is a submodule, the ordering of submodules of `p` is embedded in the ordering of\nsubmodules of `M`.", "p": "mathlib"}, {"name": "linear_equiv.map_neg", "description": "", "p": "mathlib"}, {"name": "linear_map.range_id", "description": "", "p": "mathlib"}, {"name": "linear_map.smul_right_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.comap_cod_restrict", "description": "", "p": "mathlib"}, {"name": "linear_map.injective_of_iterate_injective", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_eq", "description": "Linear equivalence between two equal submodules.", "p": "mathlib"}, {"name": "submodule.comap_sup_map_of_injective", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_comp_of_ker_eq_bot", "description": "", "p": "mathlib"}, {"name": "submodule.comap", "description": "The pullback of a submodule `p \u2286 M\u2082` along `f : M \u2192 M\u2082`", "p": "mathlib"}, {"name": "submodule.range_of_le", "description": "", "p": "mathlib"}, {"name": "submodule.nontrivial", "description": "", "p": "mathlib"}, {"name": "finsupp.linear_equiv_fun_on_finite_single", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_eq_bot_of_inverse", "description": "", "p": "mathlib"}, {"name": "linear_equiv.map_dfinsupp_sum", "description": "", "p": "mathlib"}, {"name": "linear_equiv.range", "description": "", "p": "mathlib"}, {"name": "linear_map.pow_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_comap_eq", "description": "", "p": "mathlib"}, {"name": "linear_map.ring_lmap_equiv_self_symm_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_symm_eq_iff", "description": "", "p": "mathlib"}, {"name": "linear_equiv.ker_comp", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_submodules", "description": " A linear equivalence which maps a submodule of one module onto another, restricts to a linear\nequivalence of the two submodules.", "p": "mathlib"}, {"name": "linear_map.ker_zero", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_submodules_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.zero_symm", "description": "", "p": "mathlib"}, {"name": "linear_map.eq_locus", "description": "A linear map version of `add_monoid_hom.eq_locus`", "p": "mathlib"}, {"name": "add_monoid_hom_lequiv_int_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.map_dfinsupp_sum_add_hom", "description": "", "p": "mathlib"}, {"name": "linear_map.mem_range_self", "description": "", "p": "mathlib"}, {"name": "linear_equiv.fun_congr_left_symm", "description": "", "p": "mathlib"}, {"name": "linear_map.mem_eq_locus", "description": "", "p": "mathlib"}, {"name": "linear_map.infi_invariant", "description": " The infimum of a family of invariant submodule of an endomorphism is also an invariant\nsubmodule.", "p": "mathlib"}, {"name": "linear_map.comap_injective", "description": "", "p": "mathlib"}, {"name": "linear_map.to_add_monoid_hom'", "description": "`linear_map.to_add_monoid_hom` promoted to an `add_monoid_hom`", "p": "mathlib"}, {"name": "submodule.of_le", "description": " If two submodules `p` and `p'` satisfy `p \u2286 p'`, then `of_le p p'` is the linear map version of\nthis inclusion.", "p": "mathlib"}, {"name": "linear_equiv.curry", "description": "Linear equivalence between a curried and uncurried function.\n Differs from `tensor_product.curry`.", "p": "mathlib"}, {"name": "submodule.comap_coe", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_smul_right", "description": "", "p": "mathlib"}, {"name": "submodule.subtype_comp_of_le", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_smul'", "description": "", "p": "mathlib"}, {"name": "submodule.comap_inf_map_of_injective", "description": "", "p": "mathlib"}, {"name": "linear_map.dom_restrict'", "description": "Alternative version of `dom_restrict` as a linear map.", "p": "mathlib"}, {"name": "submodule.map_supr_comap_of_sujective", "description": "", "p": "mathlib"}, {"name": "submodule.map_inf_eq_map_inf_comap", "description": "", "p": "mathlib"}, {"name": "submodule.map_top", "description": "", "p": "mathlib"}, {"name": "finsupp.linear_equiv.finsupp_unique", "description": " If `\u03b1` has a unique term, then the type of finitely supported functions `\u03b1 \u2192\u2080 M` is\n`R`-linearly equivalent to `M`.", "p": "mathlib"}, {"name": "submodule.of_le_apply", "description": "", "p": "mathlib"}, {"name": "submodule.comap_smul'", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_restrict", "description": "", "p": "mathlib"}, {"name": "submodule.map_mono", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_top", "description": "The top submodule of `M` is linearly equivalent to `M`.", "p": "mathlib"}, {"name": "linear_equiv.submodule_map_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.symm_neg", "description": "", "p": "mathlib"}, {"name": "submodule.map_comap_eq_of_surjective", "description": "", "p": "mathlib"}, {"name": "submodule.comap_bot", "description": "", "p": "mathlib"}, {"name": "linear_map.fintype_range", "description": " The range of a linear map is finite if the domain is finite.\nNote: this instance can form a diamond with `subtype.fintype` in the\n  presence of `fintype M\u2082`.", "p": "mathlib"}, {"name": "add_monoid_hom_lequiv_nat", "description": "The `R`-linear equivalence between additive morphisms `A \u2192+ B` and `\u2115`-linear morphisms `A \u2192\u2097[\u2115] B`.", "p": "mathlib"}, {"name": "submodule.inf_comap_le_comap_add", "description": "", "p": "mathlib"}, {"name": "linear_map.iterate_range", "description": "The decreasing sequence of submodules consisting of the ranges of the iterates of a linear map.", "p": "mathlib"}, {"name": "linear_map.eq_locus_same", "description": "", "p": "mathlib"}, {"name": "linear_equiv.smul_of_ne_zero_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.conj_trans", "description": "", "p": "mathlib"}, {"name": "submodule.map_comap_subtype", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_submodule'_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_coe", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_pow", "description": "", "p": "mathlib"}, {"name": "submodule.le_comap_map", "description": "", "p": "mathlib"}, {"name": "linear_equiv.map_sub", "description": "", "p": "mathlib"}, {"name": "linear_map.fun_left_comp", "description": "", "p": "mathlib"}, {"name": "submodule.unique'", "description": "", "p": "mathlib"}, {"name": "submodule.comap_supr_map_of_injective", "description": "", "p": "mathlib"}, {"name": "linear_map.map_dfinsupp_sum_add_hom", "description": "", "p": "mathlib"}, {"name": "linear_equiv.fun_congr_left_comp", "description": "", "p": "mathlib"}, {"name": "linear_equiv.coe_of_eq_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.subtype_comp_cod_restrict", "description": "", "p": "mathlib"}, {"name": "linear_map.submodule_image", "description": " If `O` is a submodule of `M`, and `\u03a6 : O \u2192\u2097 M'` is a linear map,\nthen `(\u03d5 : O \u2192\u2097 M').submodule_image N` is `\u03d5(N)` as a submodule of `M'`", "p": "mathlib"}, {"name": "linear_equiv.congr_right", "description": " If `M\u2082` and `M\u2083` are linearly isomorphic then the two spaces of linear maps from `M` into `M\u2082`\nand `M` into `M\u2083` are linearly isomorphic.", "p": "mathlib"}, {"name": "linear_map.apply\u2097'", "description": "Applying a linear map at `v : M`, seen as `S`-linear map from `M \u2192\u2097[R] M\u2082` to `M\u2082`.\n\nSee `linear_map.apply\u2097` for a version where `S = R`.", "p": "mathlib"}, {"name": "linear_map.map_sum", "description": "", "p": "mathlib"}, {"name": "submodule.ker_subtype", "description": "", "p": "mathlib"}, {"name": "submodule.subsingleton_iff", "description": "", "p": "mathlib"}, {"name": "submodule.map_injective_of_injective", "description": "", "p": "mathlib"}, {"name": "linear_map.pow_map_zero_of_le", "description": "", "p": "mathlib"}, {"name": "submodule.le_comap_pow_of_le_comap", "description": "", "p": "mathlib"}, {"name": "linear_equiv.smul_of_ne_zero", "description": "Multiplying by a nonzero element `a` of the field `K` is a linear equivalence.", "p": "mathlib"}, {"name": "linear_map.fun_left_id", "description": "", "p": "mathlib"}, {"name": "linear_map.disjoint_ker", "description": "", "p": "mathlib"}, {"name": "submodule.of_le_injective", "description": "", "p": "mathlib"}, {"name": "linear_map.comap_le_comap_iff", "description": "", "p": "mathlib"}, {"name": "submodule.comap_equiv_eq_map_symm", "description": "", "p": "mathlib"}, {"name": "linear_map.dfinsupp_sum_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.ring_lmap_equiv_self", "description": "The equivalence between R-linear maps from `R` to `M`, and points of `M` itself.\nThis says that the forgetful functor from `R`-modules to types is representable, by `R`.\n\nThis as an `S`-linear equivalence, under the assumption that `S` acts on `M` commuting with `R`.\nWhen `R` is commutative, we can take this to be the usual action with `S = R`.\nOtherwise, `S = \u2115` shows that the equivalence is additive.\nSee note [bundled maps over different rings].", "p": "mathlib"}, {"name": "linear_map.pi_apply_eq_sum_univ", "description": " A linear map `f` applied to `x : \u03b9 \u2192 R` can be computed using the image under `f` of elements\nof the canonical basis.", "p": "mathlib"}, {"name": "linear_map.cod_restrict_apply", "description": "", "p": "mathlib"}, {"name": "linear_equiv.conj_apply_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.restrict_eq_dom_restrict_cod_restrict", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_left_inverse_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_smul'", "description": "", "p": "mathlib"}, {"name": "submodule.comap_comp", "description": "", "p": "mathlib"}, {"name": "linear_map.range_le_ker_iff", "description": "", "p": "mathlib"}, {"name": "linear_map.range_le_bot_iff", "description": "", "p": "mathlib"}, {"name": "linear_map.pow_restrict", "description": "", "p": "mathlib"}, {"name": "linear_map.disjoint_ker'", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_top_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.submodule_pow_eq_zero_of_pow_eq_zero", "description": "", "p": "mathlib"}, {"name": "submodule.map_comap_le", "description": "", "p": "mathlib"}, {"name": "linear_map.map_cod_restrict", "description": "", "p": "mathlib"}, {"name": "submodule.comap_infi", "description": "", "p": "mathlib"}, {"name": "submodule.map_sup_comap_of_surjective", "description": "", "p": "mathlib"}, {"name": "submodule.comap_map_eq_of_injective", "description": "", "p": "mathlib"}, {"name": "submodule.comap_subtype_equiv_of_le", "description": " If `s \u2264 t`, then we can view `s` as a submodule of `t` by taking the comap\nof `t.subtype`.", "p": "mathlib"}, {"name": "linear_equiv.of_eq_rfl", "description": "", "p": "mathlib"}, {"name": "linear_map.unique_of_right", "description": "", "p": "mathlib"}, {"name": "linear_map.range_le_iff_comap", "description": "", "p": "mathlib"}, {"name": "is_linear_map.is_linear_map_add", "description": "", "p": "mathlib"}, {"name": "submodule.order_iso_map_comap_symm_apply'", "description": "", "p": "mathlib"}, {"name": "linear_map.range_smul'", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_to_add_submonoid", "description": "", "p": "mathlib"}, {"name": "submodule.order_iso_map_comap_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.surjective_of_iterate_surjective", "description": "", "p": "mathlib"}, {"name": "linear_map.subtype_comp_restrict", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_le_iff", "description": "", "p": "mathlib"}, {"name": "linear_map.fun_left", "description": " Given an `R`-module `M` and a function `m \u2192 n` between arbitrary types,\nconstruct a linear map `(n \u2192 M) \u2192\u2097[R] (m \u2192 M)`", "p": "mathlib"}, {"name": "linear_map.ker_cod_restrict", "description": "", "p": "mathlib"}, {"name": "submodule.map_equiv_eq_comap_symm", "description": "", "p": "mathlib"}, {"name": "submodule.map_comap_eq_self", "description": "", "p": "mathlib"}, {"name": "linear_map.range_smul", "description": "", "p": "mathlib"}, {"name": "submodule.map_zero", "description": "", "p": "mathlib"}, {"name": "submodule.comap_subtype_eq_top", "description": "", "p": "mathlib"}, {"name": "linear_map.dom_restrict_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_to_add_submonoid", "description": "", "p": "mathlib"}, {"name": "linear_map.smul_right", "description": "When `f` is an `R`-linear map taking values in `S`, then `\u03bbb, f b \u2022 x` is an `R`-linear map.", "p": "mathlib"}, {"name": "linear_map.coe_dfinsupp_sum", "description": "", "p": "mathlib"}, {"name": "linear_map.map_coe_ker", "description": "", "p": "mathlib"}, {"name": "finsupp.smul_sum", "description": "", "p": "mathlib"}, {"name": "submodule.comap_injective_of_surjective", "description": "", "p": "mathlib"}, {"name": "finsupp.linear_equiv_fun_on_finite_apply", "description": "", "p": "mathlib"}, {"name": "submodule.map_inf_comap_of_surjective", "description": "", "p": "mathlib"}, {"name": "linear_equiv.smul_of_unit", "description": "Multiplying by a unit `a` of the ring `R` is a linear equivalence.", "p": "mathlib"}, {"name": "linear_map.ker_eq_bot_of_injective", "description": "", "p": "mathlib"}, {"name": "linear_equiv.unique_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "linear_map.mem_range", "description": "", "p": "mathlib"}, {"name": "linear_equiv.conj_comp", "description": "", "p": "mathlib"}, {"name": "submodule.ker_of_le", "description": "", "p": "mathlib"}, {"name": "linear_map.comp_ker_subtype", "description": "", "p": "mathlib"}, {"name": "linear_map.comp_assoc", "description": "", "p": "mathlib"}, {"name": "linear_map.id_pow", "description": "", "p": "mathlib"}, {"name": "linear_equiv.symm_conj_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.map_finsupp_sum", "description": "", "p": "mathlib"}, {"name": "linear_equiv.map_eq_comap", "description": "", "p": "mathlib"}, {"name": "onote.NF_below_zero", "description": "", "p": "mathlib"}, {"name": "nonote.lt_wf", "description": "", "p": "mathlib"}, {"name": "nonote.repr_add", "description": "", "p": "mathlib"}, {"name": "onote.NF_below_of_nat", "description": "", "p": "mathlib"}, {"name": "onote.NF_one", "description": "", "p": "mathlib"}, {"name": "onote.repr_scale", "description": "", "p": "mathlib"}, {"name": "onote.NF_below.lt", "description": "", "p": "mathlib"}, {"name": "onote.fast_growing_def", "description": "", "p": "mathlib"}, {"name": "nonote", "description": "The type of normal ordinal notations. (It would have been\n nicer to define this right in the inductive type, but `NF o`\n requires `repr` which requires `onote`, so all these things\n would have to be defined at once, which messes up the VM\n representation.)", "p": "mathlib"}, {"name": "onote.repr", "description": "The ordinal denoted by a notation", "p": "mathlib"}, {"name": "onote.NF_below", "description": "`NF_below o b` says that `o` is a normal form ordinal notation\n satisfying `repr o < \u03c9 ^ b`.", "p": "mathlib"}, {"name": "onote.NF_below.zero", "description": "`NF_below o b` says that `o` is a normal form ordinal notation\n satisfying `repr o < \u03c9 ^ b`.", "p": "mathlib"}, {"name": "onote.NF_below.oadd'", "description": "`NF_below o b` says that `o` is a normal form ordinal notation\n satisfying `repr o < \u03c9 ^ b`.", "p": "mathlib"}, {"name": "nonote.cmp_compares", "description": "", "p": "mathlib"}, {"name": "onote.fundamental_sequence", "description": "Given an ordinal, returns `inl none` for `0`, `inl (some a)` for `a+1`, and\n `inr f` for a limit ordinal `a`, where `f i` is a sequence converging to `a`.", "p": "mathlib"}, {"name": "nonote.linear_order", "description": "", "p": "mathlib"}, {"name": "onote.oadd_pos", "description": "", "p": "mathlib"}, {"name": "onote.sub_NF_below", "description": "", "p": "mathlib"}, {"name": "nonote.has_sub", "description": "Subtraction of ordinal notations", "p": "mathlib"}, {"name": "onote.add_NF_below", "description": "", "p": "mathlib"}, {"name": "onote.has_to_string", "description": "", "p": "mathlib"}, {"name": "onote.oadd_lt_oadd_2", "description": "", "p": "mathlib"}, {"name": "onote.NF.oadd_zero", "description": "", "p": "mathlib"}, {"name": "onote.NF.zero", "description": "", "p": "mathlib"}, {"name": "onote.omega_le_oadd", "description": "", "p": "mathlib"}, {"name": "onote.lt_def", "description": "", "p": "mathlib"}, {"name": "onote.repr_one", "description": "", "p": "mathlib"}, {"name": "nonote.repr_mul", "description": "", "p": "mathlib"}, {"name": "onote.NF.below_of_lt", "description": "", "p": "mathlib"}, {"name": "onote.NF.fst", "description": "", "p": "mathlib"}, {"name": "onote.opow", "description": "`opow o\u2081 o\u2082` calculates the ordinal notation for\n the ordinal exponential `o\u2081 ^ o\u2082`.", "p": "mathlib"}, {"name": "nonote.has_repr", "description": "", "p": "mathlib"}, {"name": "onote.mul", "description": "Multiplication of ordinal notations (correct only for normal input)", "p": "mathlib"}, {"name": "onote.scale_eq_mul", "description": "", "p": "mathlib"}, {"name": "onote.top_below", "description": "`top_below b o` asserts that the largest exponent in `o`, if\n it exists, is less than `b`. This is an auxiliary definition\n for decidability of `NF`.", "p": "mathlib"}, {"name": "onote.NF.snd", "description": "", "p": "mathlib"}, {"name": "onote.NF_repr_split'", "description": "", "p": "mathlib"}, {"name": "nonote.has_to_string", "description": "", "p": "mathlib"}, {"name": "nonote.cmp", "description": "Compare ordinal notations", "p": "mathlib"}, {"name": "onote.inhabited", "description": "", "p": "mathlib"}, {"name": "onote.repr'", "description": "Print an ordinal notation", "p": "mathlib"}, {"name": "onote.has_add", "description": "", "p": "mathlib"}, {"name": "onote.scale", "description": "`scale x o` is the ordinal notation for `\u03c9 ^ x * o`.", "p": "mathlib"}, {"name": "onote.repr_opow_aux\u2081", "description": "", "p": "mathlib"}, {"name": "onote.mul_zero_class", "description": "", "p": "mathlib"}, {"name": "onote.zero_def", "description": "", "p": "mathlib"}, {"name": "onote.mul_nat_eq_mul", "description": "", "p": "mathlib"}, {"name": "onote.fast_growing_one", "description": "", "p": "mathlib"}, {"name": "onote.has_zero", "description": "Notation for 0", "p": "mathlib"}, {"name": "nonote.repr", "description": "The ordinal represented by an ordinal notation.\n (This function is noncomputable because ordinal\n arithmetic is noncomputable. In computational applications\n `nonote` can be used exclusively without reference\n to `ordinal`, but this function allows for correctness\n results to be stated.)", "p": "mathlib"}, {"name": "onote.fast_growing_\u03b5\u2080_two", "description": "", "p": "mathlib"}, {"name": "nonote.preorder", "description": "", "p": "mathlib"}, {"name": "onote.oadd_add", "description": "", "p": "mathlib"}, {"name": "onote.zero_lt_one", "description": "", "p": "mathlib"}, {"name": "nonote.has_lt.lt.is_well_order", "description": "", "p": "mathlib"}, {"name": "onote.decidable_NF", "description": "", "p": "mathlib"}, {"name": "onote.fast_growing", "description": " The fast growing hierarchy for ordinal notations `< \u03b5\u2080`. This is a sequence of\nfunctions `\u2115 \u2192 \u2115` indexed by ordinals, with the definition:\n* `f_0(n) = n + 1`\n* `f_(\u03b1+1)(n) = f_\u03b1^[n](n)`\n* `f_\u03b1(n) = f_(\u03b1[n])(n)` where `\u03b1` is a limit ordinal\n   and `\u03b1[i]` is the fundamental sequence converging to `\u03b1`", "p": "mathlib"}, {"name": "onote.split", "description": "Calculate division and remainder of `o` mod \u03c9.\n `split o = (a, n)` means `o = a + n`, where `\u03c9 \u2223 a`.", "p": "mathlib"}, {"name": "nonote.below", "description": "Asserts that `repr a < \u03c9 ^ repr b`. Used in `nonote.rec_on`", "p": "mathlib"}, {"name": "onote.NF.oadd", "description": "", "p": "mathlib"}, {"name": "nonote.decidable_eq", "description": "", "p": "mathlib"}, {"name": "nonote.has_add", "description": "Addition of ordinal notations", "p": "mathlib"}, {"name": "onote.NF_below.oadd", "description": "", "p": "mathlib"}, {"name": "nonote.inhabited", "description": "", "p": "mathlib"}, {"name": "onote.fast_growing_limit", "description": "", "p": "mathlib"}, {"name": "onote.NF.below_of_lt'", "description": "", "p": "mathlib"}, {"name": "onote.opow_def", "description": "", "p": "mathlib"}, {"name": "onote.decidable_top_below", "description": "", "p": "mathlib"}, {"name": "onote.split'", "description": "Calculate division and remainder of `o` mod \u03c9.\n `split' o = (a, n)` means `o = \u03c9 * a + n`.", "p": "mathlib"}, {"name": "nonote.of_nat", "description": "Convert a natural number to an ordinal notation", "p": "mathlib"}, {"name": "onote.NF_below_iff_top_below", "description": "", "p": "mathlib"}, {"name": "nonote.opow", "description": "Exponentiation of ordinal notations", "p": "mathlib"}, {"name": "onote.has_one", "description": "Notation for 1", "p": "mathlib"}, {"name": "onote.NF_below.snd", "description": "", "p": "mathlib"}, {"name": "onote.fast_growing_\u03b5\u2080_one", "description": "", "p": "mathlib"}, {"name": "onote.NF.of_dvd_omega_opow", "description": "", "p": "mathlib"}, {"name": "onote.oadd_lt_oadd_1", "description": "", "p": "mathlib"}, {"name": "onote.preorder", "description": "", "p": "mathlib"}, {"name": "nonote.well_founded_lt", "description": "", "p": "mathlib"}, {"name": "onote.NF.snd'", "description": "", "p": "mathlib"}, {"name": "onote.sub_NF", "description": "", "p": "mathlib"}, {"name": "onote.add_NF", "description": "", "p": "mathlib"}, {"name": "onote", "description": "Recursive definition of an ordinal notation. `zero` denotes the\n ordinal 0, and `oadd e n a` is intended to refer to `\u03c9^e * n + a`.\n For this to be valid Cantor normal form, we must have the exponents\n decrease to the right, but we can't state this condition until we've\n defined `repr`, so it is a separate definition `NF`.", "p": "mathlib"}, {"name": "onote.zero", "description": "Recursive definition of an ordinal notation. `zero` denotes the\n ordinal 0, and `oadd e n a` is intended to refer to `\u03c9^e * n + a`.\n For this to be valid Cantor normal form, we must have the exponents\n decrease to the right, but we can't state this condition until we've\n defined `repr`, so it is a separate definition `NF`.", "p": "mathlib"}, {"name": "onote.oadd", "description": "Recursive definition of an ordinal notation. `zero` denotes the\n ordinal 0, and `oadd e n a` is intended to refer to `\u03c9^e * n + a`.\n For this to be valid Cantor normal form, we must have the exponents\n decrease to the right, but we can't state this condition until we've\n defined `repr`, so it is a separate definition `NF`.", "p": "mathlib"}, {"name": "onote.repr_of_nat", "description": "", "p": "mathlib"}, {"name": "onote.NF_opow_aux", "description": "", "p": "mathlib"}, {"name": "onote.NF_below.mono", "description": "", "p": "mathlib"}, {"name": "onote.fundamental_sequence_prop", "description": "The property satisfied by `fundamental_sequence o`:\n * `inl none` means `o = 0`\n * `inl (some a)` means `o = succ a`\n * `inr f` means `o` is a limit ordinal and `f` is a\n   strictly increasing sequence which converges to `o`", "p": "mathlib"}, {"name": "onote.oadd_mul_NF_below", "description": "", "p": "mathlib"}, {"name": "onote.fast_growing_\u03b5\u2080", "description": "We can extend the fast growing hierarchy one more step to `\u03b5\u2080` itself,\n using `\u03c9^(\u03c9^...^\u03c9^0)` as the fundamental sequence converging to `\u03b5\u2080` (which is not an `onote`).\n Extending the fast growing hierarchy beyond this requires a definition of fundamental sequence\n for larger ordinals.", "p": "mathlib"}, {"name": "onote.mul_nat", "description": "`mul_nat o n` is the ordinal notation for `o * n`.", "p": "mathlib"}, {"name": "onote.eq_of_cmp_eq", "description": "", "p": "mathlib"}, {"name": "onote.repr_mul", "description": "", "p": "mathlib"}, {"name": "onote.NF_repr_split", "description": "", "p": "mathlib"}, {"name": "onote.NF_scale", "description": "", "p": "mathlib"}, {"name": "nonote.mk", "description": "Construct a `nonote` from an ordinal notation\n (and infer normality)", "p": "mathlib"}, {"name": "onote.fast_growing_two", "description": "", "p": "mathlib"}, {"name": "onote.NF", "description": "A normal form ordinal notation has the form\n\n    \u03c9 ^ a\u2081 * n\u2081 + \u03c9 ^ a\u2082 * n\u2082 + ... \u03c9 ^ a\u2096 * n\u2096\n where `a\u2081 > a\u2082 > ... > a\u2096` and all the `a\u1d62` are\n also in normal form.\n\n We will essentially only be interested in normal form\n ordinal notations, but to avoid complicating the algorithms\n we define everything over general ordinal notations and\n only prove correctness with normal form as an invariant.", "p": "mathlib"}, {"name": "onote.NF.out", "description": "A normal form ordinal notation has the form\n\n    \u03c9 ^ a\u2081 * n\u2081 + \u03c9 ^ a\u2082 * n\u2082 + ... \u03c9 ^ a\u2096 * n\u2096\n where `a\u2081 > a\u2082 > ... > a\u2096` and all the `a\u1d62` are\n also in normal form.\n\n We will essentially only be interested in normal form\n ordinal notations, but to avoid complicating the algorithms\n we define everything over general ordinal notations and\n only prove correctness with normal form as an invariant.", "p": "mathlib"}, {"name": "onote.NF_opow", "description": "", "p": "mathlib"}, {"name": "onote.has_sub", "description": "", "p": "mathlib"}, {"name": "onote.repr_sub", "description": "", "p": "mathlib"}, {"name": "nonote.oadd", "description": "The `oadd` pseudo-constructor for `nonote`", "p": "mathlib"}, {"name": "onote.repr_add", "description": "", "p": "mathlib"}, {"name": "onote.repr_opow", "description": "", "p": "mathlib"}, {"name": "nonote.has_zero", "description": "", "p": "mathlib"}, {"name": "nonote.rec_on", "description": "This is a recursor-like theorem for `nonote` suggesting an\n inductive definition, which can't actually be defined this\n way due to conflicting dependencies.", "p": "mathlib"}, {"name": "onote.fast_growing_zero", "description": "", "p": "mathlib"}, {"name": "onote.decidable_eq", "description": "", "p": "mathlib"}, {"name": "onote.to_string_aux1", "description": "Auxiliary definition to print an ordinal notation", "p": "mathlib"}, {"name": "nonote.has_mul", "description": "Multiplication of ordinal notations", "p": "mathlib"}, {"name": "onote.le_def", "description": "", "p": "mathlib"}, {"name": "onote.opow_aux", "description": " Auxiliary definition to compute the ordinal notation for the ordinal\nexponentiation in `opow`", "p": "mathlib"}, {"name": "onote.omega", "description": "Notation for \u03c9", "p": "mathlib"}, {"name": "onote.oadd_lt_oadd_3", "description": "", "p": "mathlib"}, {"name": "onote.has_repr", "description": "", "p": "mathlib"}, {"name": "onote.NF_below.fst", "description": "", "p": "mathlib"}, {"name": "nonote.NF", "description": "", "p": "mathlib"}, {"name": "nonote.repr_opow", "description": "", "p": "mathlib"}, {"name": "onote.of_nat_one", "description": "", "p": "mathlib"}, {"name": "onote.split_add_lt", "description": "", "p": "mathlib"}, {"name": "onote.split_eq_scale_split'", "description": "", "p": "mathlib"}, {"name": "onote.oadd_mul", "description": "", "p": "mathlib"}, {"name": "onote.scale_opow_aux", "description": "", "p": "mathlib"}, {"name": "onote.fast_growing_succ", "description": "", "p": "mathlib"}, {"name": "onote.split_dvd", "description": "", "p": "mathlib"}, {"name": "onote.zero_add", "description": "", "p": "mathlib"}, {"name": "onote.to_string", "description": "Print an ordinal notation", "p": "mathlib"}, {"name": "onote.repr_inj", "description": "", "p": "mathlib"}, {"name": "onote.fundamental_sequence_has_prop", "description": "", "p": "mathlib"}, {"name": "nonote.repr_sub", "description": "", "p": "mathlib"}, {"name": "nonote.has_well_founded", "description": "", "p": "mathlib"}, {"name": "onote.add", "description": "Addition of ordinal notations (correct only for normal input)", "p": "mathlib"}, {"name": "onote.NF_mul_nat", "description": "", "p": "mathlib"}, {"name": "onote.has_pow", "description": "", "p": "mathlib"}, {"name": "onote.fast_growing_zero'", "description": "", "p": "mathlib"}, {"name": "onote.NF_below.repr_lt", "description": "", "p": "mathlib"}, {"name": "onote.cmp", "description": "Compare ordinal notations", "p": "mathlib"}, {"name": "onote.sub", "description": "Subtraction of ordinal notations (correct only for normal input)", "p": "mathlib"}, {"name": "onote.of_nat", "description": "Convert a `nat` into an ordinal", "p": "mathlib"}, {"name": "onote.NF.of_dvd_omega", "description": "", "p": "mathlib"}, {"name": "onote.fast_growing_\u03b5\u2080_zero", "description": "", "p": "mathlib"}, {"name": "onote.NF.zero_of_zero", "description": "", "p": "mathlib"}, {"name": "onote.has_mul", "description": "", "p": "mathlib"}, {"name": "onote.NF_of_nat", "description": "", "p": "mathlib"}, {"name": "onote.mul_NF", "description": "", "p": "mathlib"}, {"name": "onote.cmp_compares", "description": "", "p": "mathlib"}, {"name": "onote.repr_opow_aux\u2082", "description": "", "p": "mathlib"}, {"name": "lift_of_splits", "description": " If `K` and `L` are field extensions of `F` and we have `s : finset K` such that\nthe minimal polynomial of each `x \u2208 s` splits in `L` then `algebra.adjoin F s` embeds in `L`.", "p": "mathlib"}, {"name": "alg_equiv.adjoin_singleton_equiv_adjoin_root_minpoly", "description": "If `p` is the minimal polynomial of `a` over `F` then `F[a] \u2243\u2090[F] F[x]/(p)`", "p": "mathlib"}, {"name": "codisjoint_top_left", "description": "", "p": "mathlib"}, {"name": "is_compl.inf_left_le_of_le_sup_right", "description": "", "p": "mathlib"}, {"name": "complementeds.complemented_lattice", "description": "", "p": "mathlib"}, {"name": "codisjoint.sup_left'", "description": "", "p": "mathlib"}, {"name": "is_compl.of_le", "description": "", "p": "mathlib"}, {"name": "disjoint_sup_left", "description": "", "p": "mathlib"}, {"name": "disjoint_bot_right", "description": "", "p": "mathlib"}, {"name": "disjoint_sup_right", "description": "", "p": "mathlib"}, {"name": "disjoint_to_dual_iff", "description": "", "p": "mathlib"}, {"name": "disjoint.ne", "description": "", "p": "mathlib"}, {"name": "disjoint.eq_bot_of_le", "description": "", "p": "mathlib"}, {"name": "is_compl.sup_eq_top", "description": "", "p": "mathlib"}, {"name": "complementeds.partial_order", "description": "", "p": "mathlib"}, {"name": "is_complemented_bot", "description": "", "p": "mathlib"}, {"name": "disjoint", "description": " Two elements of a lattice are disjoint if their inf is the bottom element.\n  (This generalizes disjoint sets, viewed as members of the subset lattice.)\n\nNote that we define this without reference to `\u2293`, as this allows us to talk about orders where\nthe infimum is not unique, or where implementing `has_inf` would require additional `decidable`\narguments.", "p": "mathlib"}, {"name": "is_compl.left_unique", "description": "", "p": "mathlib"}, {"name": "top_disjoint", "description": "", "p": "mathlib"}, {"name": "disjoint.inf_left'", "description": "", "p": "mathlib"}, {"name": "complementeds.disjoint_coe", "description": "", "p": "mathlib"}, {"name": "is_compl.inf_eq_bot", "description": "", "p": "mathlib"}, {"name": "disjoint_self", "description": "", "p": "mathlib"}, {"name": "complementeds.bounded_order", "description": "", "p": "mathlib"}, {"name": "disjoint.eq_bot_of_ge", "description": "", "p": "mathlib"}, {"name": "complementeds.mk_top", "description": "", "p": "mathlib"}, {"name": "codisjoint.sup_left", "description": "", "p": "mathlib"}, {"name": "codisjoint_iff_le_sup", "description": "", "p": "mathlib"}, {"name": "complementeds.coe_bot", "description": "", "p": "mathlib"}, {"name": "disjoint.symm", "description": "", "p": "mathlib"}, {"name": "codisjoint.of_codisjoint_sup_of_le'", "description": "", "p": "mathlib"}, {"name": "bot_codisjoint", "description": "", "p": "mathlib"}, {"name": "codisjoint.left_le_of_le_inf_left", "description": "", "p": "mathlib"}, {"name": "eq_bot_of_is_compl_top", "description": "", "p": "mathlib"}, {"name": "is_compl.right_unique", "description": "", "p": "mathlib"}, {"name": "codisjoint_iff", "description": "", "p": "mathlib"}, {"name": "codisjoint.mono", "description": "", "p": "mathlib"}, {"name": "complemented_lattice", "description": " A complemented bounded lattice is one where every element has a (not necessarily unique)\ncomplement.", "p": "mathlib"}, {"name": "complemented_lattice.exists_is_compl", "description": " A complemented bounded lattice is one where every element has a (not necessarily unique)\ncomplement.", "p": "mathlib"}, {"name": "is_compl.dual", "description": "", "p": "mathlib"}, {"name": "is_compl.sup_inf", "description": "", "p": "mathlib"}, {"name": "disjoint.mono_right", "description": "", "p": "mathlib"}, {"name": "codisjoint.symm", "description": "", "p": "mathlib"}, {"name": "complementeds.mk_bot", "description": "", "p": "mathlib"}, {"name": "prod.is_compl_iff", "description": "", "p": "mathlib"}, {"name": "codisjoint.of_codisjoint_sup_of_le", "description": "", "p": "mathlib"}, {"name": "disjoint_assoc", "description": "", "p": "mathlib"}, {"name": "codisjoint.eq_top_of_le", "description": "", "p": "mathlib"}, {"name": "is_compl.left_le_iff", "description": "", "p": "mathlib"}, {"name": "disjoint_top", "description": "", "p": "mathlib"}, {"name": "complementeds.codisjoint_coe", "description": "", "p": "mathlib"}, {"name": "codisjoint_left_comm", "description": "", "p": "mathlib"}, {"name": "is_complemented", "description": "An element is *complemented* if it has a complement.", "p": "mathlib"}, {"name": "is_compl.right_le_iff", "description": "", "p": "mathlib"}, {"name": "disjoint.eq_bot_of_self", "description": "**Alias** of the forward direction of `disjoint_self`.", "p": "mathlib"}, {"name": "is_compl_iff", "description": "", "p": "mathlib"}, {"name": "complementeds.coe_le_coe", "description": "", "p": "mathlib"}, {"name": "prod.codisjoint_iff", "description"