escription": "", "p": "mathlib"}, {"name": "polynomial.has_add", "description": "", "p": "mathlib"}, {"name": "polynomial.C_eq_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "polynomial.support_eq_empty", "description": "", "p": "mathlib"}, {"name": "polynomial.C_bit1", "description": "", "p": "mathlib"}, {"name": "polynomial.smul_comm_class", "description": "", "p": "mathlib"}, {"name": "polynomial.update", "description": " Replace the coefficient of a `p : R[X]` at a given degree `n : \u2115`\nby a given value `a : R`. If `a = 0`, this is equal to `p.erase n`\nIf `p.nat_degree < n` and `a \u2260 0`, this increases the degree to `n`.", "p": "mathlib"}, {"name": "is_smul_regular.polynomial", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_def", "description": "", "p": "mathlib"}, {"name": "polynomial.C_mul_X_eq_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.subsingleton_iff_subsingleton", "description": "", "p": "mathlib"}, {"name": "polynomial.comm_semiring", "description": "", "p": "mathlib"}, {"name": "polynomial.has_faithful_smul", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_add_index", "description": "", "p": "mathlib"}, {"name": "polynomial.X_mul_C", "description": " Prefer putting constants to the left of `X`.\n\nThis lemma is the loop-avoiding `simp` version of `polynomial.X_mul`.", "p": "mathlib"}, {"name": "polynomial.erase_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.support_update_ne_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.nontrivial", "description": "", "p": "mathlib"}, {"name": "polynomial.X_ne_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.C_eq_int_cast", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff_X_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.C_mul_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.monomial_