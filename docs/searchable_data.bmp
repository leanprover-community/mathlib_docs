p": "mathlib"}, {"name": "emetric_space.to_metric_space_of_dist", "description": " One gets a metric space from an emetric space if the edistance\nis everywhere finite, by pushing the edistance to reals. We set it up so that the edist and the\nuniformity are defeq in the metric space and the emetric space. In this definition, the distance\nis given separately, to be able to prescribe some expression which is not defeq to the push-forward\nof the edistance to reals.", "p": "mathlib"}, {"name": "metric.second_countable_of_almost_dense_set", "description": " A pseudometric space is second countable if, for every `\u03b5 > 0`, there is a countable set which\nis `\u03b5`-dense.", "p": "mathlib"}, {"name": "metric.bounded_Ioc", "description": "", "p": "mathlib"}, {"name": "metric.closed_embedding_of_pairwise_le_dist", "description": "", "p": "mathlib"}, {"name": "real.dist_le_of_mem_Icc", "description": "", "p": "mathlib"}, {"name": "real.closed_ball_eq_Icc", "description": "", "p": "mathlib"}, {"name": "metric.subsingleton_closed_ball", "description": "", "p": "mathlib"}, {"name": "nndist_triangle_left", "description": "", "p": "mathlib"}, {"name": "proper_space", "description": "A pseudometric space is proper if all closed balls are compact.", "p": "mathlib"}, {"name": "proper_space.is_compact_closed_ball", "description": "A pseudometric space is proper if all closed balls are compact.", "p": "mathlib"}, {"name": "metric.dist_mem_uniformity", "description": "A constant size neighborhood of the diagonal is an entourage.", "p": "mathlib"}, {"name": "real.order_topology", "description": "", "p": "mathlib"}, {"name": "metric.tendsto_uniformly_on_filter_iff", "description": "Expressing uniform convergence using `dist`", "p": "mathlib"}, {"name": "dist_pi_const_le", "description": "", "p": "mathlib"}, {"name": "metric.mem_sphere_comm", "description": "", "p": "mathlib"}, {"name": "metric.sphere_is_empty_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "metric.Union_ball_nat_succ", "description": "", "p": "mathlib"}, {"name": "exists_pos_lt_subset_ball", "description": " If a nonempty ball in a proper space includes a closed set `s`, then there exists a nonempty\nball with the same center and a strictly smaller radius that includes `s`.", "p": "mathlib"}, {"name": "metric.uniformity_basis_dist_pow", "description": "", "p": "mathlib"}, {"name": "mul_opposite.metric_space", "description": "", "p": "mathlib"}, {"name": "metric.forall_of_forall_mem_ball", "description": " If a property holds for all points in balls of arbitrarily large radii, then it holds for all\npoints.", "p": "mathlib"}, {"name": "dist_to_mul", "description": "", "p": "mathlib"}, {"name": "finite_cover_balls_of_compact", "description": " Any compact set in a pseudometric space can be covered by finitely many balls of a given\npositive radius", "p": "mathlib"}, {"name": "metric.uniform_continuous_on_iff", "description": "", "p": "mathlib"}, {"name": "squeeze_zero'", "description": " Special case of the sandwich theorem; see `tendsto_of_tendsto_of_tendsto_of_le_of_le'` for the\ngeneral case.", "p": "mathlib"}, {"name": "real.dist_right_le_of_mem_uIcc", "description": "", "p": "mathlib"}, {"name": "metric.nhds_basis_ball", "description": "", "p": "mathlib"}, {"name": "metric.cauchy_seq_iff'", "description": "A variation around the pseudometric characterization of Cauchy sequences", "p": "mathlib"}, {"name": "metric.closed_ball_mem_nhds", "description": "", "p": "mathlib"}, {"name": "metric.ediam_le_of_forall_dist_le", "description": " If the distance between any two points in a set is bounded by some constant `C`,\nthen `ennreal.of_real C`  bounds the emetric diameter of this set.", "p": "mathlib"}, {"name": "totally_bounded.bounded", "description": "A totally bounded set is bounded", "p": "mathlib"}, {"name": "metric.ball_subset", "description": "", "p": "mathlib"}, {"name": "metric.closed_ball", "description": "`closed_ball x \u03b5` is the set of all points `y` with `dist y x \u2264 \u03b5`", "p": "mathlib"}, {"name": "metric.mem_closure_range_iff", "description": "", "p": "mathlib"}, {"name": "metric.uniformity_basis_dist", "description": "", "p": "mathlib"}, {"name": "totally_bounded_Ioc", "description": "", "p": "mathlib"}, {"name": "metric.uniformity_basis_dist_inv_nat_succ", "description": "", "p": "mathlib"}, {"name": "metric.exists_is_open_bounded_image_of_is_compact_of_continuous_on", "description": " If a function is continuous on a neighborhood of a compact set `k`, then it is bounded on\nsome open neighborhood of `k`.", "p": "mathlib"}, {"name": "metric.ball_subset_ball", "description": "", "p": "mathlib"}, {"name": "dist_lt_coe", "description": "", "p": "mathlib"}, {"name": "metric.diam_ball", "description": "The diameter of a ball of radius `r` is at most `2 r`.", "p": "mathlib"}, {"name": "metric.ball_union_sphere", "description": "", "p": "mathlib"}, {"name": "metric.exists_local_min_mem_ball", "description": "", "p": "mathlib"}, {"name": "metric.continuous_on_iff", "description": "", "p": "mathlib"}, {"name": "dist_pi_eq_iff", "description": "", "p": "mathlib"}, {"name": "dist_triangle", "description": "", "p": "mathlib"}, {"name": "metric.bounded_Ioo", "description": "", "p": "mathlib"}, {"name": "metric.bounded_range_iff", "description": "Characterization of the boundedness of the range of a function", "p": "mathlib"}, {"name": "real.nndist_eq'", "description": "", "p": "mathlib"}, {"name": "metric.subsingleton_sphere", "description": "", "p": "mathlib"}, {"name": "add_opposite.nndist_op", "description": "", "p": "mathlib"}, {"name": "additive.metric_space", "description": "", "p": "mathlib"}, {"name": "ulift.nndist_up_up", "description": "", "p": "mathlib"}, {"name": "nndist_to_dual", "description": "", "p": "mathlib"}, {"name": "metric.diam_eq_zero_of_unbounded", "description": " An unbounded set has zero diameter. If you would prefer to get the value \u221e, use `emetric.diam`.\nThis lemma makes it possible to avoid side conditions in some situations", "p": "mathlib"}, {"name": "pseudo_emetric_space.to_pseudo_metric_space_of_dist", "description": " One gets a pseudometric space from an emetric space if the edistance\nis everywhere finite, by pushing the edistance to reals. We set it up so that the edist and the\nuniformity are defeq in the pseudometric space and the pseudoemetric space. In this definition, the\ndistance is given separately, to be able to prescribe some expression which is not defeq to the\npush-forward of the edistance to reals.", "p": "mathlib"}, {"name": "set.finite.bounded", "description": "**Alias** of `metric.bounded_of_finite`.", "p": "mathlib"}, {"name": "real.ball_eq_Ioo", "description": "", "p": "mathlib"}, {"name": "add_opposite.metric_space", "description": "", "p": "mathlib"}, {"name": "metric.totally_bounded_of_finite_discretization", "description": " A pseudometric space is totally bounded if one can reconstruct up to any \u03b5>0 any element of the\nspace from finitely many data.", "p": "mathlib"}, {"name": "abs_dist_sub_le", "description": "", "p": "mathlib"}, {"name": "metric.second_countable_of_countable_discretization", "description": " A metric space is second countable if one can reconstruct up to any `\u03b5>0` any element of the\nspace from countably many data.", "p": "mathlib"}, {"name": "metric.ball_disjoint_ball", "description": "", "p": "mathlib"}, {"name": "metric.diam_le_of_subset_closed_ball", "description": "", "p": "mathlib"}, {"name": "metric.tendsto_locally_uniformly_on_iff", "description": "Expressing locally uniform convergence on a set using `dist`.", "p": "mathlib"}, {"name": "real.dist_eq", "description": "", "p": "mathlib"}, {"name": "metric.tendsto_nhds_nhds", "description": "", "p": "mathlib"}, {"name": "metric.mem_closure_range_iff_nat", "description": "", "p": "mathlib"}, {"name": "metric_space.replace_bornology", "description": " Build a new metric space from an old one where the bundled bornology structure is provably\n(but typically non-definitionaly) equal to some given bornology structure.\nSee Note [forgetful inheritance].", "p": "mathlib"}, {"name": "metric.eventually_nhds_iff", "description": "", "p": "mathlib"}, {"name": "metric.closed_ball_eq_empty", "description": "", "p": "mathlib"}, {"name": "closed_ball_pi'", "description": " A closed ball in a product space is a product of closed balls. See also `metric.closed_ball_pi`\nfor a version assuming `0 \u2264 r` instead of `nonempty \u03b2`.", "p": "mathlib"}, {"name": "pseudo_metric_space.replace_uniformity_eq", "description": "", "p": "mathlib"}, {"name": "additive.has_dist", "description": "", "p": "mathlib"}, {"name": "metric.pos_of_mem_ball", "description": "", "p": "mathlib"}, {"name": "zero_eq_nndist", "description": "", "p": "mathlib"}, {"name": "metric.frontier_ball_subset_sphere", "description": "", "p": "mathlib"}, {"name": "metric.Union_ball_nat", "description": "", "p": "mathlib"}, {"name": "metric.diam_triple", "description": "", "p": "mathlib"}, {"name": "metric.mem_sphere'", "description": "", "p": "mathlib"}, {"name": "metric.complete_of_convergent_controlled_sequences", "description": " A very useful criterion to show that a space is complete is to show that all sequences\nwhich satisfy a bound of the form `dist (u n) (u m) < B N` for all `n m \u2265 N` are\nconverging. This is often applied for `B N = 2^{-N}`, i.e., with a very fast convergence to\n`0`, which makes it possible to use arguments of converging series, while this is impossible\nto do in general for arbitrary Cauchy sequences.", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.has_dist", "description": "", "p": "mathlib"}, {"name": "nnreal.nndist_zero_eq_val'", "description": "", "p": "mathlib"}, {"name": "metric.bounded_of_bdd_above_of_bdd_below", "description": "In a pseudo metric space with a conditionally complete linear order such that the order and the\n   metric structure give the same topology, any order-bounded set is metric-bounded.", "p": "mathlib"}, {"name": "metric_space.of_t0_pseudo_metric_space", "description": "If a `pseudo_metric_space` is a T\u2080 space, then it is a `metric_space`.", "p": "mathlib"}, {"name": "totally_bounded_Icc", "description": "", "p": "mathlib"}, {"name": "metric.closed_ball_eq_bInter_ball", "description": "", "p": "mathlib"}, {"name": "metric.ball_eq_ball", "description": "", "p": "mathlib"}, {"name": "metric.uniform_cauchy_seq_on_iff", "description": " In a pseudometric space, unifom Cauchy sequences are characterized by the fact that, eventually,\nthe distance between all its elements is uniformly, arbitrarily small", "p": "mathlib"}, {"name": "metric.uniform_embedding_iff'", "description": " A map between metric spaces is a uniform embedding if and only if the distance between `f x`\nand `f y` is controlled in terms of the distance between `x` and `y` and conversely.", "p": "mathlib"}, {"name": "metric_space.to_emetric_space", "description": "A metric space induces an emetric space", "p": "mathlib"}, {"name": "dist_of_dual", "description": "", "p": "mathlib"}, {"name": "metric.diam_one", "description": "", "p": "mathlib"}, {"name": "dist_of_mul", "description": "", "p": "mathlib"}, {"name": "dist_self", "description": "", "p": "mathlib"}, {"name": "real.pseudo_metric_space", "description": "Instantiate the reals as a pseudometric space.", "p": "mathlib"}, {"name": "metric.sphere_eq_empty_of_neg", "description": "", "p": "mathlib"}, {"name": "dist_nonneg", "description": "", "p": "mathlib"}, {"name": "subtype.metric_space", "description": "", "p": "mathlib"}, {"name": "metric.exists_lt_mem_ball_of_mem_ball", "description": " If a point belongs to an open ball, then there is a strictly smaller radius whose ball also\ncontains it.\n\nSee also `exists_lt_subset_ball`.", "p": "mathlib"}, {"name": "metric.mem_closure_iff", "description": "\u03b5-characterization of the closure in pseudometric spaces", "p": "mathlib"}, {"name": "metric.cauchy_seq_iff", "description": " In a pseudometric space, Cauchy sequences are characterized by the fact that, eventually,\nthe distance between its elements is arbitrarily small", "p": "mathlib"}, {"name": "pseudo_metric_space.to_has_edist", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.dist", "description": "", "p": "mathlib"}, {"name": "pi_proper_space", "description": "A finite product of proper spaces is proper.", "p": "mathlib"}, {"name": "metric.dist_lt_add_of_nonempty_ball_inter_closed_ball", "description": "", "p": "mathlib"}, {"name": "is_compact.is_separable", "description": "", "p": "mathlib"}, {"name": "metric.finite_approx_of_totally_bounded", "description": "", "p": "mathlib"}, {"name": "metric.bounded_union", "description": "The union of two sets is bounded iff each of the sets is bounded.", "p": "mathlib"}, {"name": "punit.metric_space", "description": "", "p": "mathlib"}, {"name": "nndist_pi_const_le", "description": "", "p": "mathlib"}, {"name": "metric.emetric_ball_nnreal", "description": "Balls defined using the distance or the edistance coincide", "p": "mathlib"}, {"name": "metric.to_uniform_space_eq", "description": "", "p": "mathlib"}, {"name": "has_dist.ext", "description": "", "p": "mathlib"}, {"name": "is_complete.nonempty_Inter_of_nonempty_bInter", "description": " If a family of complete sets with diameter tending to `0` is such that each finite intersection\nis nonempty, then the total intersection is also nonempty.", "p": "mathlib"}, {"name": "metric.emetric_closed_ball", "description": "Closed balls defined using the distance or the edistance coincide", "p": "mathlib"}, {"name": "metric.nhds_basis_ball_pow", "description": "", "p": "mathlib"}, {"name": "metric.tendsto_nhds_within_nhds", "description": "", "p": "mathlib"}, {"name": "is_compact.bounded", "description": "A compact set is bounded", "p": "mathlib"}, {"name": "metric.nonempty_ball", "description": "", "p": "mathlib"}, {"name": "metric.uniformity_basis_dist_rat", "description": "", "p": "mathlib"}, {"name": "metric_space.replace_topology", "description": " Build a new metric space from an old one where the bundled topological structure is provably\n(but typically non-definitionaly) equal to some given topological structure.\nSee Note [forgetful inheritance].", "p": "mathlib"}, {"name": "metric.closed_ball_diff_sphere", "description": "", "p": "mathlib"}, {"name": "metric.mem_nhds_iff", "description": "", "p": "mathlib"}, {"name": "metric.mk_uniformity_basis", "description": " Given `f : \u03b2 \u2192 \u211d`, if `f` sends `{i | p i}` to a set of positive numbers\naccumulating to zero, then `f i`-neighborhoods of the diagonal form a basis of `\ud835\udce4 \u03b1`.\n\nFor specific bases see `uniformity_basis_dist`, `uniformity_basis_dist_inv_nat_succ`,\nand `uniformity_basis_dist_inv_nat_pos`.", "p": "mathlib"}, {"name": "comap_dist_left_at_top_le_cocompact", "description": "", "p": "mathlib"}, {"name": "monoid_hom.compl\u2082_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.mul_left_apply_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.mul_right", "description": "The right multiplication map: `(a, b) \u21a6 b * a`. See also `add_monoid_hom.mul_right`.", "p": "mathlib"}, {"name": "add_monoid_hom.comp_hom'_apply_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.nat_cast_apply", "description": "See also `add_monoid.End.nat_cast_def`.", "p": "mathlib"}, {"name": "add_monoid_hom.compl\u2082", "description": "The expression `\u03bb m q, f m (g q)` as an `add_monoid_hom`.\n\nNote that the expression `\u03bb q n, f (g q) n` is simply `add_monoid_hom.comp`.\n\nThis also exists as a `linear_map` version, `linear_map.compl\u2082`", "p": "mathlib"}, {"name": "add_monoid_hom.flip_hom", "description": "Flipping arguments of additive monoid morphisms (`add_monoid_hom.flip`)\nas an additive monoid morphism.", "p": "mathlib"}, {"name": "monoid_hom.flip", "description": "`flip` arguments of `f : M \u2192* N \u2192* P`", "p": "mathlib"}, {"name": "add_monoid_hom.coe_flip_mul", "description": "", "p": "mathlib"}, {"name": "monoid_hom.comm_group", "description": "If `G` is a commutative group, then `M \u2192* G` is a commutative group too.", "p": "mathlib"}, {"name": "add_monoid.End.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "monoid_hom.compr\u2082_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_mul\u2082", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_one\u2082", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.ring", "description": "", "p": "mathlib"}, {"name": "monoid_hom.flip_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.ext_iff\u2082", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.comp_hom'", "description": "The expression `\u03bb g m, g (f m)` as a `add_monoid_hom`.\nEquivalently, `(\u03bb g, monoid_hom.comp g f)` as a `add_monoid_hom`.\n\nThis also exists in a `linear_map` version, `linear_map.lcomp`.", "p": "mathlib"}, {"name": "add_monoid_hom.map_mul_iff", "description": " An `add_monoid_hom` preserves multiplication if pre- and post- composition with\n`add_monoid_hom.mul` are equivalent. By converting the statement into an equality of\n`add_monoid_hom`s, this lemma allows various specialized `ext` lemmas about `\u2192+` to then be applied.", "p": "mathlib"}, {"name": "monoid_hom.compl\u2082", "description": " The expression `\u03bb m q, f m (g q)` as a `monoid_hom`.\n\nNote that the expression `\u03bb q n, f (g q) n` is simply `monoid_hom.comp`.", "p": "mathlib"}, {"name": "monoid_hom.eval_apply_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.int_cast_apply", "description": "See also `add_monoid.End.int_cast_def`.", "p": "mathlib"}, {"name": "add_monoid_hom.add_comm_group", "description": "If `G` is an additive commutative group, then `M \u2192+ G` is an additive commutative\ngroup too.", "p": "mathlib"}, {"name": "add_monoid_hom.flip_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.flip_hom_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.compr\u2082", "description": "The expression `\u03bb m n, g (f m n)` as a `monoid_hom`.", "p": "mathlib"}, {"name": "monoid_hom.comp_hom_apply_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.map_inv\u2082", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_inv\u2082", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.mul_right_apply_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.mul", "description": " Multiplication of an element of a (semi)ring is an `add_monoid_hom` in both arguments.\n\nThis is a more-strongly bundled version of `add_monoid_hom.mul_left` and `add_monoid_hom.mul_right`.\n\nStronger versions of this exists for algebras as `linear_map.mul`, `non_unital_alg_hom.mul`\nand `algebra.lmul`.", "p": "mathlib"}, {"name": "monoid_hom.comp_hom", "description": " Composition of monoid morphisms (`monoid_hom.comp`) as a monoid morphism.\n\nNote that unlike `monoid_hom.comp_hom'` this requires commutativity of `N`.", "p": "mathlib"}, {"name": "add_monoid_hom.compr\u2082_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.compr\u2082", "description": "The expression `\u03bb m n, g (f m n)` as an `add_monoid_hom`.\n\nThis also exists as a linear_map version, `linear_map.compr\u2082`", "p": "mathlib"}, {"name": "monoid_hom.comp_hom'", "description": " The expression `\u03bb g m, g (f m)` as a `monoid_hom`.\nEquivalently, `(\u03bb g, monoid_hom.comp g f)` as a `monoid_hom`.", "p": "mathlib"}, {"name": "add_monoid_hom.add_comm_monoid", "description": "`(M \u2192+ N)` is an `add_comm_monoid` if `N` is commutative.", "p": "mathlib"}, {"name": "add_monoid_hom.comp_hom", "description": "Composition of additive monoid morphisms (`add_monoid_hom.comp`) as an additive\nmonoid morphism.\n\nNote that unlike `add_monoid_hom.comp_hom'` this requires commutativity of `N`.\n\nThis also exists in a `linear_map` version, `linear_map.llcomp`.", "p": "mathlib"}, {"name": "add_monoid_hom.comp_hom_apply_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.ext_iff\u2082", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.eval", "description": "Evaluation of an `add_monoid_hom` at a point as an additive monoid homomorphism.\nSee also `add_monoid_hom.apply` for the evaluation of any function at a point.", "p": "mathlib"}, {"name": "monoid_hom.comm_monoid", "description": "`(M \u2192* N)` is a `comm_monoid` if `N` is commutative.", "p": "mathlib"}, {"name": "add_monoid_hom.compl\u2082_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.eval_apply_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.map_div\u2082", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.flip", "description": "`flip` arguments of `f : M \u2192+ N \u2192+ P`", "p": "mathlib"}, {"name": "monoid_hom.comp_hom'_apply_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.semiring", "description": "", "p": "mathlib"}, {"name": "monoid_hom.eval", "description": " Evaluation of a `monoid_hom` at a point as a monoid homomorphism. See also `monoid_hom.apply`\nfor the evaluation of any function at a point.", "p": "mathlib"}, {"name": "monoid_hom.flip_hom", "description": "Flipping arguments of monoid morphisms (`monoid_hom.flip`) as a monoid morphism.", "p": "mathlib"}, {"name": "add_monoid.End.mul_left", "description": "The left multiplication map: `(a, b) \u21a6 a * b`. See also `add_monoid_hom.mul_left`.", "p": "mathlib"}, {"name": "monoid_hom.map_mul\u2082", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.mul_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_div\u2082", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coe_mul", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.add_comm_gro