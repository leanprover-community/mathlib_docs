scription": "", "p": "mathlib"}, {"name": "padic_seq.stationary_point_spec", "description": "", "p": "mathlib"}, {"name": "padic.add_valuation_def", "description": "The additive `p`-adic valuation on `\u211a_[p]`, with values in `with_top \u2124`.", "p": "mathlib"}, {"name": "padic_seq.ne_zero_iff_nequiv_zero", "description": "", "p": "mathlib"}, {"name": "padic_norm_e.norm_int_le_pow_iff_dvd", "description": "", "p": "mathlib"}, {"name": "padic.valuation_map_add", "description": "", "p": "mathlib"}, {"name": "padic_norm_e.image", "description": "", "p": "mathlib"}, {"name": "padic.valuation_zero", "description": "", "p": "mathlib"}, {"name": "padic.norm_le_pow_iff_norm_lt_pow_add_one", "description": "", "p": "mathlib"}, {"name": "padic.complete", "description": "", "p": "mathlib"}, {"name": "padic.has_norm", "description": "", "p": "mathlib"}, {"name": "padic_norm_e.eq_rat_norm", "description": "", "p": "mathlib"}, {"name": "padic_seq.not_equiv_zero_const_of_nonzero", "description": "", "p": "mathlib"}, {"name": "padic.add_valuation.map_add", "description": "", "p": "mathlib"}, {"name": "padic_seq.lift_index_left", "description": "An auxiliary lemma for manipulating sequence indices.", "p": "mathlib"}, {"name": "padic_norm_e.norm_p_pow", "description": "", "p": "mathlib"}, {"name": "padic.add_valuation", "description": "The additive `p`-adic valuation on `\u211a_[p]`, as an `add_valuation`.", "p": "mathlib"}, {"name": "padic_seq.not_lim_zero_const_of_nonzero", "description": "", "p": "mathlib"}, {"name": "padic_seq.norm_eq_pow_val", "description": "", "p": "mathlib"}, {"name": "padic", "description": "The `p`-adic numbers `\u211a_[p]` are the Cauchy completion of `\u211a` with respect to the `p`-adic norm.", "p": "mathlib"}, {"name": "padic_norm_e.norm_p", "description": "", "p": "mathlib"}, {"name": "padic_norm_e.eq_padic_norm", "description": "", "p": "mathlib"}, {"name": "padic_seq.norm_nonneg", "description": "", "p": "mathlib"}, {"name": "padic.add_valuation.