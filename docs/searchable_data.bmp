03b1 is directed (with respect to a relation `\u227c` on \u03b1)\n if there is a member of the family `\u227c`-above any pair in the family.", "p": "mathlib"}, {"name": "directed_on_univ", "description": "", "p": "mathlib"}, {"name": "directed_on_singleton", "description": "", "p": "mathlib"}, {"name": "directed_on.is_top_of_is_max", "description": "", "p": "mathlib"}, {"name": "is_top_iff_is_max", "description": "", "p": "mathlib"}, {"name": "is_total.directed", "description": "", "p": "mathlib"}, {"name": "directed_on.mono'", "description": "", "p": "mathlib"}, {"name": "directed_id_iff", "description": "", "p": "mathlib"}, {"name": "exists_le_le", "description": "", "p": "mathlib"}, {"name": "antitone.directed_le", "description": "", "p": "mathlib"}, {"name": "exists_lt_of_directed_le", "description": "", "p": "mathlib"}, {"name": "directed_of_sup", "description": "A monotone function on a sup-semilattice is directed.", "p": "mathlib"}, {"name": "exists_ge_ge", "description": "", "p": "mathlib"}, {"name": "directed_of", "description": "", "p": "mathlib"}, {"name": "monotone.directed_ge", "description": "", "p": "mathlib"}, {"name": "is_min.is_bot", "description": "", "p": "mathlib"}, {"name": "directed_comp", "description": "", "p": "mathlib"}, {"name": "antitone.directed_ge", "description": "", "p": "mathlib"}, {"name": "order_top.to_is_directed_le", "description": "", "p": "mathlib"}, {"name": "directed_on", "description": "A subset of \u03b1 is directed if there is an element of the set `\u227c`-above any\n pair of elements in the set.", "p": "mathlib"}, {"name": "order_dual.is_directed_le", "description": "", "p": "mathlib"}, {"name": "is_total.to_is_directed", "description": "", "p": "mathlib"}, {"name": "is_top_or_exists_gt", "description": "", "p": "mathlib"}, {"name": "is_directed", "description": " `is_directed \u03b1 r` states that for any elements `a`, `b` there exists an element `c` such that\n`r a c` and `r b c`.", "p": "mathlib"}, {"name": "is_directed.directed", "description": " `is_directed \u03b1 r` states that for any elements `a`, `b` there exists an element `c` such that\n`r a c` and `r b c`.", "p": "mathlib"}, {"name": "directed_on_univ_iff", "description": "", "p": "mathlib"}, {"name": "directed_on_of_sup_mem", "description": "A set stable by supremum is `\u2264`-directed.", "p": "mathlib"}, {"name": "directed_of_inf", "description": "An antitone function on an inf-semilattice is directed.", "p": "mathlib"}, {"name": "is_bot_iff_is_min", "description": "", "p": "mathlib"}, {"name": "directed_on.directed_coe", "description": "**Alias** of the forward direction of `directed_on_iff_directed`.", "p": "mathlib"}, {"name": "directed_on_iff_directed", "description": "", "p": "mathlib"}, {"name": "directed_on_of_inf_mem", "description": "A set stable by infimum is `\u2265`-directed.", "p": "mathlib"}, {"name": "directed.mono", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.mk_derivation\u2097_monomial", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.derivation_ext", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.mk_derivation_equiv", "description": "`mv_polynomial.mk_derivation` as a linear equivalence.", "p": "mathlib"}, {"name": "mv_polynomial.mk_derivation_X", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.derivation_C", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.derivation_eq_of_forall_mem_vars", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.mk_derivation\u2097", "description": " The derivation on `mv_polynomial \u03c3 R` that takes value `f i` on `X i`, as a linear map.\nUse `mv_polynomial.mk_derivation` instead.", "p": "mathlib"}, {"name": "mv_polynomial.mk_derivation\u2097_X", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.mk_derivation", "description": "The derivation on `mv_polynomial \u03c3 R` that takes value `f i` on `X i`.", "p": "mathlib"}, {"name": "mv_polynomial.derivation_eq_on_supported", "description": " If two derivations agree on `X i`, `i \u2208 s`, then they agree on all polynomials from\n`mv_polynomial.supported R s`.", "p": "mathlib"}, {"name": "mv_polynomial.derivation_eq_zero_of_forall_mem_vars", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.derivation_C_mul", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.mk_derivation_monomial", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.mk_derivation\u2097_C", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.leibniz_iff_X", "description": "", "p": "mathlib"}, {"name": "lazy_list.monad", "description": "", "p": "mathlib"}, {"name": "lazy_list.append_assoc", "description": "", "p": "mathlib"}, {"name": "thunk.decidable_eq", "description": "", "p": "mathlib"}, {"name": "lazy_list.is_lawful_traversable", "description": "", "p": "mathlib"}, {"name": "lazy_list.forall_mem_cons", "description": "", "p": "mathlib"}, {"name": "lazy_list.mfirst", "description": " Try applying function `f` to every element of a `lazy_list` and\nreturn the result of the first attempt that succeeds.", "p": "mathlib"}, {"name": "lazy_list.traverse", "description": "Traversal of lazy lists using an applicative effect.", "p": "mathlib"}, {"name": "lazy_list.mem", "description": "Membership in lazy lists", "p": "mathlib"}, {"name": "lazy_list.mem_cons", "description": "", "p": "mathlib"}, {"name": "lazy_list.mem_nil", "description": "", "p": "mathlib"}, {"name": "thunk.mk", "description": "Creates a thunk with a (non-lazy) constant value.", "p": "mathlib"}, {"name": "lazy_list.traversable", "description": "", "p": "mathlib"}, {"name": "lazy_list.bind", "description": "Monadic bind operation for `lazy_list`.", "p": "mathlib"}, {"name": "lazy_list.attach", "description": "\"Attach\" the proof that the elements of `l` are in `l` to produce a new `lazy_list`\n with the same elements but in the type `{x // x \u2208 l}`.", "p": "mathlib"}, {"name": "lazy_list.has_mem", "description": "", "p": "mathlib"}, {"name": "lazy_list.pmap", "description": "Partial map. If `f : \u03a0 a, p a \u2192 \u03b2` is a partial function defined on\n `a : \u03b1` satisfying `p`, then `pmap f l h` is essentially the same as `map f l`\n but is defined only when all members of `l` satisfy `p`, using the proof\n to apply `f`.", "p": "mathlib"}, {"name": "lazy_list.append_nil", "description": "", "p": "mathlib"}, {"name": "lazy_list.has_repr", "description": "", "p": "mathlib"}, {"name": "lazy_list.list_equiv_lazy_list", "description": "Isomorphism between strict and lazy lists.", "p": "mathlib"}, {"name": "lazy_list.init", "description": " `init xs`, if `xs` non-empty, drops the last element of the list.\nOtherwise, return the empty list.", "p": "mathlib"}, {"name": "lazy_list.interleave_all", "description": " `interleave_all (xs::ys::zs::xss)` creates a list where elements of `xs`, `ys`\nand `zs` and the rest alternate. Every other element of the resulting list is taken from\n`xs`, every fourth is taken from `ys`, every eighth is taken from `zs` and so on.", "p": "mathlib"}, {"name": "lazy_list.decidable_eq", "description": "", "p": "mathlib"}, {"name": "lazy_list.find", "description": " Return the first object contained in the list that satisfies\npredicate `p`", "p": "mathlib"}, {"name": "lazy_list.mem.decidable", "description": "", "p": "mathlib"}, {"name": "lazy_list.is_lawful_monad", "description": "", "p": "mathlib"}, {"name": "lazy_list.interleave", "description": "`interleave xs ys` creates a list where elements of `xs` and `ys` alternate.", "p": "mathlib"}, {"name": "lazy_list.reverse", "description": " Reverse the order of a `lazy_list`.\nIt is done by converting to a `list` first because reversal involves evaluating all\nthe list and if the list is all evaluated, `list` is a better representation for\nit than a series of thunks.", "p": "mathlib"}, {"name": "lazy_list.append_bind", "description": "", "p": "mathlib"}, {"name": "nat.nth_eq_Inf", "description": " An alternative recursive definition of `nat.nth`: `nat.nth s n` is the infimum of `x \u2208 s` such\nthat `nat.nth s k < x` for all `k < n`, if this set is nonempty. We do not assume that the set is\nnonempty because we use the same \"garbage value\" `0` both for `Inf` on `\u2115` and for `nat.nth s n` for\n`n \u2265 card s`.", "p": "mathlib"}, {"name": "nat.le_nth_of_count_le", "description": "", "p": "mathlib"}, {"name": "nat.image_nth_Iio_card", "description": "", "p": "mathlib"}, {"name": "nat.is_least_nth_of_lt_card", "description": "", "p": "mathlib"}, {"name": "nat.lt_nth_iff_count_lt", "description": "", "p": "mathlib"}, {"name": "nat.nth_lt_nth'", "description": "", "p": "mathlib"}, {"name": "nat.le_nth", "description": "", "p": "mathlib"}, {"name": "nat.nth_lt_nth_of_lt_card", "description": "", "p": "mathlib"}, {"name": "nat.exists_lt_card_nth_eq", "description": "", "p": "mathlib"}, {"name": "nat.nth_zero", "description": "", "p": "mathlib"}, {"name": "nat.count_le_iff_le_nth", "description": "", "p": "mathlib"}, {"name": "nat.le_nth_count", "description": "", "p": "mathlib"}, {"name": "nat.nth_strict_mono_on", "description": "", "p": "mathlib"}, {"name": "nat.subset_range_nth", "description": "", "p": "mathlib"}, {"name": "nat.nth_mem_of_infinite", "description": "", "p": "mathlib"}, {"name": "nat.nth_le_nth_of_lt_card", "description": "", "p": "mathlib"}, {"name": "nat.nth_mem_of_lt_card", "description": "", "p": "mathlib"}, {"name": "nat.le_nth_count'", "description": "", "p": "mathlib"}, {"name": "nat.gc_count_nth", "description": "", "p": "mathlib"}, {"name": "nat.nth_strict_mono", "description": "", "p": "mathlib"}, {"name": "nat.count_nth", "description": "", "p": "mathlib"}, {"name": "nat.is_least_nth", "description": "", "p": "mathlib"}, {"name": "nat.nth_eq_order_iso_of_nat", "description": "When `s` is an infinite set, `nth` agrees with `nat.subtype.order_iso_of_nat`.", "p": "mathlib"}, {"name": "nat.filter_range_nth_subset_insert", "description": "", "p": "mathlib"}, {"name": "nat.is_least_nth_of_infinite", "description": "", "p": "mathlib"}, {"name": "nat.nth_le_nth", "description": "", "p": "mathlib"}, {"name": "nat.range_nth_subset", "description": "", "p": "mathlib"}, {"name": "nat.nth_mem", "description": "", "p": "mathlib"}, {"name": "nat.nth_eq_order_emb_of_fin", "description": "", "p": "mathlib"}, {"name": "nat.nth_monotone", "description": "", "p": "mathlib"}, {"name": "nat.nth_inj_on", "description": "", "p": "mathlib"}, {"name": "nat.nth_eq_zero_mono", "description": "", "p": "mathlib"}, {"name": "nat.count_nth_zero", "description": "", "p": "mathlib"}, {"name": "nat.nth", "description": " Find the `n`-th natural number satisfying `p` (indexed from `0`, so `nth p 0` is the first\nnatural number satisfying `p`), or `0` if there is no such number. See also\n`subtype.order_iso_of_nat` for the order isomorphism with \u2115 when `p` is infinitely often true.", "p": "mathlib"}, {"name": "nat.le_nth_of_lt_nth_succ", "description": "", "p": "mathlib"}, {"name": "nat.nth_le_nth'", "description": "", "p": "mathlib"}, {"name": "nat.nth_zero_of_zero", "description": "", "p": "mathlib"}, {"name": "nat.nth_eq_nthd_sort", "description": "", "p": "mathlib"}, {"name": "nat.nth_count_eq_Inf", "description": "", "p": "mathlib"}, {"name": "nat.count_nth_succ", "description": "", "p": "mathlib"}, {"name": "nat.range_nth_of_infinite", "description": "", "p": "mathlib"}, {"name": "nat.nth_of_card_le", "description": "", "p": "mathlib"}, {"name": "nat.filter_range_nth_eq_insert", "description": "", "p": "mathlib"}, {"name": "nat.filter_range_nth_eq_insert_of_finite", "description": "", "p": "mathlib"}, {"name": "nat.nth_lt_of_lt_count", "description": "", "p": "mathlib"}, {"name": "nat.filter_range_nth_eq_insert_of_infinite", "description": "", "p": "mathlib"}, {"name": "nat.lt_of_nth_lt_nth_of_lt_card", "description": "", "p": "mathlib"}, {"name": "nat.nth_injective", "description": "", "p": "mathlib"}, {"name": "nat.gi_count_n