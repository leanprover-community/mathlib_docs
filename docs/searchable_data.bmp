_lt", "description": "", "p": "mathlib"}, {"name": "nat.coprime_of_lt_prime", "description": "", "p": "mathlib"}, {"name": "nat.decidable_prime", "description": "This instance is faster in the virtual machine than `decidable_prime_1`,\nbut slower in the kernel.\n\nIf you need to prove that a particular number is prime, in any case\nyou should not use `dec_trivial`, but rather `by norm_num`, which is\nmuch faster.", "p": "mathlib"}, {"name": "nat.dvd_prime_two_le", "description": "", "p": "mathlib"}, {"name": "nat.not_prime_mul", "description": "", "p": "mathlib"}, {"name": "nat.monoid.prime_pow", "description": "", "p": "mathlib"}, {"name": "nat.exists_dvd_of_not_prime2", "description": "", "p": "mathlib"}, {"name": "nat.not_prime_mul'", "description": "", "p": "mathlib"}, {"name": "nat.min_fac_prime", "description": "", "p": "mathlib"}, {"name": "nat.prime_def_lt''", "description": "", "p": "mathlib"}, {"name": "nat.not_prime_iff_min_fac_lt", "description": "", "p": "mathlib"}, {"name": "irreducible_iff_nat_prime", "description": "", "p": "mathlib"}, {"name": "nat.prime.pow_min_fac", "description": "", "p": "mathlib"}, {"name": "nat.prime_three", "description": "", "p": "mathlib"}, {"name": "nat.coprime_primes", "description": "", "p": "mathlib"}, {"name": "nat.prime.ne_zero", "description": "", "p": "mathlib"}, {"name": "nat.primes.inhabited_primes", "description": "", "p": "mathlib"}, {"name": "nat.irreducible_iff_prime", "description": "", "p": "mathlib"}, {"name": "nat.pow_min_fac", "description": "", "p": "mathlib"}, {"name": "nat.coprime_of_dvd", "description": "", "p": "mathlib"}, {"name": "nat.primes", "description": "The type of prime numbers", "p": "mathlib"}, {"name": "nat.prime.eq_two_or_odd'", "description": "", "p": "mathlib"}, {"name": "nat.prime_iff_prime_int", "description": "", "p": "mathlib"}, {"name": "nat.prime.even_iff", "description": "", "p": "mathlib"}, {"name": "nat.prime.dvd_factorial", "description": "", "p": "mathlib"}, {"name": "nat.prime.mul_eq_prime_sq_iff", "description": "", "p": "mathlib"}, {"name": "nat.min_fac_aux_has_prop", "description": "", "p": "mathlib"}, {"name": "nat.eq_one_iff_not_exists_prime_dvd", "description": "", "p": "mathlib"}, {"name": "nat.prime.prime", "description": "**Alias** of the forward direction of `nat.prime_iff`.", "p": "mathlib"}, {"name": "nat.succ_pred_prime", "description": "", "p": "mathlib"}, {"name": "nat.prime", "description": "`nat.prime p` means that `p` is a prime number, that is, a natural number\n at least 2 whose only divisors are `p` and `1`.", "p": "mathlib"}, {"name": "nat.min_fac_le_div", "description": "", "p": "mathlib"}, {"name": "nat.prime.not_dvd_one", "description": "", "p": "mathlib"}, {"name": "nat.prime_def_min_fac", "description": "", "p": "mathlib"}, {"name": "nat.eq_prime_pow_of_dvd_least_prime_pow", "description": "If `p` is prime,\nand `a` doesn't divide `p^k`, but `a` does divide `p^(k+1)`\nthen `a = p^(k+1)`.", "p": "mathlib"}, {"name": "nat.prime.dvd_of_dvd_pow", "description": "", "p": "mathlib"}, {"name": "nat.dvd_prime_pow", "description": "", "p": "mathlib"}, {"name": "nat.min_fac", "description": "Returns the smallest prime factor of `n \u2260 1`.", "p": "mathlib"}, {"name": "nat.prime.even_sub_one", "description": "", "p": "mathlib"}, {"name": "nat.prime.min_fac_eq", "description": "", "p": "mathlib"}, {"name": "nat.min_fac_eq_two_iff", "description": "", "p": "mathlib"}, {"name": "nat.min_fac_aux", "description": "If `n < k * k`, then `min_fac_aux n k = n`, if `k | n`, then `min_fac_aux n k = k`.\n Otherwise, `min_fac_aux n k = min_fac_aux n (k+2)` using well-founded recursion.\n If `n` is odd and `1 < n`, then then `min_fac_aux n 3` is the smallest prime factor of `n`.", "p": "mathlib"}, {"name": "nat.le_min_fac'", "description": "", "p": "mathlib"}, {"name": "nat.coprime_pow_primes", "description": "", "p": "mathlib"}, {"name": "nat.not_prime_zero", "description": "", "p": "mathlib"}, {"name": "nat.min_fac_dvd", "descri