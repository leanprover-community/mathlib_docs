me": "seminorm.absorbent_closed_ball", "description": "Seminorm-balls containing the origin are absorbent.", "p": "mathlib"}, {"name": "seminorm.closed_ball_comp", "description": "", "p": "mathlib"}, {"name": "coe_norm_seminorm", "description": "", "p": "mathlib"}, {"name": "seminorm.preimage_metric_ball", "description": "", "p": "mathlib"}, {"name": "seminorm.preimage_metric_closed_ball", "description": "", "p": "mathlib"}, {"name": "seminorm.closed_ball_finset_sup", "description": "", "p": "mathlib"}, {"name": "seminorm.convex_ball", "description": "Seminorm-balls are convex.", "p": "mathlib"}, {"name": "seminorm.comp_id", "description": "", "p": "mathlib"}, {"name": "seminorm.module", "description": "", "p": "mathlib"}, {"name": "seminorm.ball_sup", "description": "", "p": "mathlib"}, {"name": "seminorm.partial_order", "description": "", "p": "mathlib"}, {"name": "seminorm.ball_smul", "description": "", "p": "mathlib"}, {"name": "seminorm.has_zero", "description": "", "p": "mathlib"}, {"name": "seminorm.finset_sup_le_sum", "description": "", "p": "mathlib"}, {"name": "seminorm.coe_sup", "description": "", "p": "mathlib"}, {"name": "seminorm.has_add", "description": "", "p": "mathlib"}, {"name": "seminorm_class", "description": " `seminorm_class F \ud835\udd5c E` states that `F` is a type of seminorms on the `\ud835\udd5c`-module E.\n\nYou should extend this class when you extend `seminorm`.", "p": "mathlib"}, {"name": "seminorm_class.coe", "description": " `seminorm_class F \ud835\udd5c E` states that `F` is a type of seminorms on the `\ud835\udd5c`-module E.\n\nYou should extend this class when you extend `seminorm`.", "p": "mathlib"}, {"name": "seminorm_class.coe_injective'", "description": " `seminorm_class F \ud835\udd5c E` states that `F` is a type of seminorms on the `\ud835\udd5c`-module E.\n\nYou should extend this class when you extend `seminorm`.", "p": "mathlib"}, {"name": "seminorm_class.map_add_le_add", "description": " `seminorm_class F \ud835\udd5c E` states that `F` is a type of seminorms on the `\ud835\udd5c`-module E.\n\nYou should extend this class when you extend `seminorm`.", "p": "mathlib"}, {"name": "seminorm_class.map_zero", "description": " `seminorm_class F \ud835\udd5c E` states that `F` is a type of seminorms on the `\ud835\udd5c`-module E.\n\nYou should extend this class when you extend `seminorm`.", "p": "mathlib"}, {"name": "seminorm_class.map_neg_eq_map", "description": " `seminorm_class F \ud835\udd5c E` states that `F` is a type of seminorms on the `\ud835\udd5c`-module E.\n\nYou should extend this class when you extend `seminorm`.", "p": "mathlib"}, {"name": "seminorm_class.map_smul_eq_mul", "description": " `seminorm_class F \ud835\udd5c E` states that `F` is a type of seminorms on the `\ud835\udd5c`-module E.\n\nYou should extend this class when you extend `seminorm`.", "p": "mathlib"}, {"name": "seminorm.smul_closed_ball_zero", "description": "", "p": "mathlib"}, {"name": "seminorm.smul_le_smul", "description": "", "p": "mathlib"}, {"name": "seminorm.ball_zero'", "description": "", "p": "mathlib"}, {"name": "seminorm.semilattice_sup", "description": "", "p": "mathlib"}, {"name": "seminorm.sup_apply", "description": "", "p": "mathlib"}, {"name": "seminorm.coe_le_coe", "description": "", "p": "mathlib"}, {"name": "seminorm", "description": " A seminorm on a module over a normed ring is a function to the reals that is positive\nsemidefinite, positive homogeneous, and subadditive.", "p": "mathlib"}, {"name": "seminorm.to_fun", "description": " A seminorm on a module over a normed ring is a function to the reals that is positive\nsemidefinite, positive homogeneous, and subadditive.", "p": "mathlib"}, {"name": "seminorm.map_zero'", "description": " A seminorm on a module over a normed ring is a function to the reals that is positive\nsemidefinite, positive homogeneous, and subadditive.", "p": "mathlib"}, {"name": "seminorm.add_le'", "description": " A seminorm on a module over a normed ring is a function to the reals that is positive\nsemidefinite, positive homogeneous, and subadditive.", "p": "mathlib"}, {"name": "seminorm.neg'", "description": " A seminorm on a module over a normed ring is a function to the reals that is positive\nsemidefinite, positive homogeneous, and subadditive.", "p": "mathlib"}, {"name": "seminorm.smul'", "description": " A seminorm on a module over a normed ring is a function to the reals that is positive\nsemidefinite, positive homogeneous, and subadditive.", "p": "mathlib"}, {"name": "seminorm.ball_zero_eq_preimage_ball", "description": "", "p": "mathlib"}, {"name": "seminorm.inhabited", "description": "", "p": "mathlib"}, {"name": "seminorm.smul_apply", "description": "", "p": "mathlib"}, {"name": "seminorm.coe_fn_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "seminorm.ball_subset_closed_ball", "description": "", "p": "mathlib"}, {"name": "seminorm.uniform_continuous'", "description": "", "p": "mathlib"}, {"name": "seminorm.ball_finset_sup", "description": "", "p": "mathlib"}, {"name": "seminorm.of_smul_le", "description": " Alternative constructor for a `seminorm` over a normed field `\ud835\udd5c` that only assumes `f 0 = 0`\nand an inequality for the scalar multiplication.", "p": "mathlib"}, {"name": "seminorm.ball_eq_emptyset", "description": "", "p": "mathlib"}, {"name": "seminorm.symmetric_ball_zero", "description": "", "p": "mathlib"}, {"name": "seminorm.has_Sup", "description": " We define the supremum of an arbitrary subset of `seminorm \ud835\udd5c E` as follows:\n* if `s` is `bdd_above` *as a set of functions `E \u2192 \u211d`* (that is, if `s` is pointwise bounded\nabove), we take the pointwise supremum of all elements of `s`, and we prove that it is indeed a\nseminorm.\n* otherwise, we take the zero seminorm `\u22a5`.\n\nThere are two things worth mentionning here:\n* First, it is not trivial at first that `s` being bounded above *by a function* implies\nbeing bounded above *as a seminorm*. We show this in `seminorm.bdd_above_iff` by using\nthat the `Sup s` as defined here is then a bounding seminorm for `s`. So it is important to make\nthe case disjunction on `bdd_above (coe_fn '' s : set (E \u2192 \u211d))` and not `bdd_above s`.\n* Since the pointwise `Sup` already gives `0` at points where a family of functions is\nnot bounded above, one could hope that just using the pointwise `Sup` would work here, without the\nneed for an additional case disjunction. As discussed on Zulip, this doesn't work because this can\ngive a function which does *not* satisfy the seminorm axioms (typically sub-additivity).", "p": "mathlib"}, {"name": "seminorm.absorbent_ball", "description": "Seminorm-balls containing the origin are absorbent.", "p": "mathlib"}, {"name": "seminorm.ball_comp", "description": "", "p": "mathlib"}, {"name": "seminorm.continuous", "description": "", "p": "mathlib"}, {"name": "seminorm.smul_sup", "description": "", "p": "mathlib"}, {"name": "seminorm.zero_apply", "description": "", "p": "mathlib"}, {"name": "balanced_ball_zero", "description": "Balls at the origin are balanced.", "p": "mathlib"}, {"name": "seminorm.smul_inf", "description": "", "p": "mathlib"}, {"name": "seminorm.of", "description": " Alternative constructor for a `seminorm` on an `add_comm_group E` that is a module over a\n`semi_norm_ring \ud835\udd5c`.", "p": "mathlib"}, {"name": "seminorm.pullback_apply", "description": "", "p": "mathlib"}, {"name": "seminorm.comp_smul", "description": "", "p": "mathlib"}, {"name": "seminorm.ball_finset_sup_eq_Inter", "description": "", "p": "mathlib"}, {"name": "seminorm.coe_bot", "description": "", "p": "mathlib"}, {"name": "seminorm.comp_mono", "description": "", "p": "mathlib"}, {"name": "sym_option_succ_equiv_apply", "description": "", "p": "mathlib"}, {"name": "sym.has_mem", "description": "`\u03b1 \u2208 s` means that `a` appears as one of the factors in `s`.", "p": "mathlib"}, {"name": "sym.replicate_succ", "description": "", "p": "mathlib"}, {"name": "sym.cons'", "description": "This is `cons` but for the alternative `sym'` definition.", "p": "mathlib"}, {"name": "sym.map_cons", "description": "", "p": "mathlib"}, {"name": "sym.map_id", "description": "", "p": "mathlib"}, {"name": "sym.coe_inj", "description": "", "p": "mathlib"}, {"name": "sym.cons_of_coe_eq", "description": "", "p": "mathlib"}, {"name": "sym.has_zero", "description": "", "p": "mathlib"}, {"name": "sym_option_succ_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "sym.filter_ne_fill", "description": "", "p": "mathlib"}, {"name": "sym.sym'", "description": "Another definition of the nth symmetric power, using vectors modulo permutations. (See `sym`.)", "p": "mathlib"}, {"name": "sym.map_map", "description": "", "p": "mathlib"}, {"name": "sym.map_congr", "description": "", "p": "mathlib"}, {"name": "sym.nil", "description": "The unique element in `sym \u03b1 0`.", "p": "mathlib"}, {"name": "sym.replicate_right_inj", "description": "", "p": "mathlib"}, {"name": "sym.filter_ne", "description": " Remove every `a` from a given `sym \u03b1 n`.\nYields the number of copies `i` and a term of `sym \u03b1 (n - i)`.", "p": "mathlib"}, {"name": "sym.attach", "description": " \"Attach\" a proof that `a \u2208 s` to each element `a` in `s` to produce\nan element of the symmetric power on `{x // x \u2208 s}`.", "p": "mathlib"}, {"name": "sym", "description": "The nth symmetric power is n-tuples up to permutation.  We define it\nas a subtype of `multiset` since these are well developed in the\nlibrary.  We also give a definition `sym.sym'` in terms of vectors, and we\nshow these are equivalent in `sym.sym_equiv_sym'`.", "p": "mathlib"}, {"name": "sym.equiv_congr", "description": " Mapping an equivalence `\u03b1 \u2243 \u03b2` using `sym.map` gives an equivalence between `sym \u03b1 n` and\n`sym \u03b2 n`.", "p": "mathlib"}, {"name": "sym.cast_cast", "description": "", "p": "mathlib"}, {"name": "sym.of_vector_cons", "description": "", "p": "mathlib"}, {"name": "sym.fill", "description": " Fill a term `m : sym \u03b1 (n - i)` with `i` copies of `a` to obtain a term of `sym \u03b1 n`.\nThis is a convenience wrapper for `m.append (replicate i a)` that adjusts the term using\n`sym.cast`.", "p": "mathlib"}, {"name": "sym.exists_eq_cons_of_succ", "description": "", "p": "mathlib"}, {"name": "sym.cast_rfl", "description": "", "p": "mathlib"}, {"name": "sym.unique_zero", "description": "", "p": "mathlib"}, {"name": "sym.eq_replicate_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "sym.exists_mem", "description": "", "p": "mathlib"}, {"name": "sym.map_mk", "description": "", "p": "mathlib"}, {"name": "sym.mem_replicate", "description": "", "p": "mathlib"}, {"name": "sym.mem_cons_of_mem", "description": "", "p": "mathlib"}, {"name": "sym.coe_nil", "description": "", "p": "mathlib"}, {"name": "sym.mem_map", "description": "", "p": "mathlib"}, {"name": "sym_option_succ_equiv", "description": "The symmetric product over `option` is a disjoint union over simpler symmetric products.", "p": "mathlib"}, {"name": "sym.mem_coe", "description": "", "p": "mathlib"}, {"name": "sym.attach_nil", "description": "", "p": "mathlib"}, {"name": "sym.erase_cons_head", "description": "", "p": "mathlib"}, {"name": "sym.cast", "description": " Change the length of a `sym` using an equality.\nThe simp-normal form is for the `cast` to be pushed outward.", "p": "mathlib"}, {"name": "sym.append_inj_left", "description": "", "p": "mathlib"}, {"name": "sym.erase_mk", "description": "", "p": "mathlib"}, {"name": "sym.equiv_congr_apply", "description": "", "p": "mathlib"}, {"name": "vector.perm.is_setoid", "description": "This is the `list.perm` setoid lifted to `vector`.\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "sym.of_vector_nil", "description": "", "p": "mathlib"}, {"name": "sym.cons_inj_right", "description": "", "p": "mathlib"}, {"name": "sym.mem_mk", "description": "", "p": "mathlib"}, {"name": "sym.mem_attach", "description": "", "p": "mathlib"}, {"name": "sym.cons_erase", "description": "", "p": "mathlib"}, {"name": "sym.coe_attach", "description": "", "p": "mathlib"}, {"name": "sym.append_inj_right", "description": "", "p": "mathlib"}, {"name": "sym.replicate", "description": "`replicate n a` is the sym containing only `a` with multiplicity `n`.", "p": "mathlib"}, {"name": "sym.mem_fill_iff", "description": "", "p": "mathlib"}, {"name": "sym.coe_fill", "description": "", "p": "mathlib"}, {"name": "sym.coe_replicate", "description": "", "p": "mathlib"}, {"name": "sym.map_injective", "description": "", "p": "mathlib"}, {"name": "sym.nontrivial", "description": "", "p": "mathlib"}, {"name": "sym_option_succ_equiv.decode", "description": "Inverse of `sym_option_succ_equiv.decode`.", "p": "mathlib"}, {"name": "sym.map", "description": " A function `\u03b1 \u2192 \u03b2` induces a function `sym \u03b1 n \u2192 sym \u03b2 n` by applying it to every element of\nthe underlying `n`-tuple.", "p": "mathlib"}, {"name": "sym.coe_append", "description": "", "p": "mathlib"}, {"name": "sym.has_lift", "description": "This is the quotient map that takes a list of n elements as an n-tuple and produces an nth\nsymmetric power.", "p": "mathlib"}, {"name": "sym.coe_cast", "description": "", "p": "mathlib"}, {"name": "sym.sigma_sub_ext", "description": "", "p": "mathlib"}, {"name": "sym.mk_coe", "description": "", "p": "mathlib"}, {"name": "sym_option_succ_equiv.encode", "description": " Function from the symmetric product over `option` splitting on whether or not\nit contains a `none`.", "p": "mathlib"}, {"name": "sym_option_succ_equiv.encode_decode", "description": "", "p": "mathlib"}, {"name": "sym.mk", "description": "Construct an element of the `n`th symmetric power from a multiset of cardinality `n`.", "p": "mathlib"}, {"name": "sym.sound", "description": "", "p": "mathlib"}, {"name": "sym.inhabited_sym", "description": "", "p": "mathlib"}, {"name": "sym.is_empty", "description": "", "p": "mathlib"}, {"name": "sym.sym_equiv_sym'", "description": "Multisets of cardinality n are equivalent to length-n vectors up to permutations.", "p": "mathlib"}, {"name": "sym.cons_swap", "description": "", "p": "mathlib"}, {"name": "sym.mem_cons", "description": "", "p": "mathlib"}, {"name": "sym.append_comm", "description": "", "p": "mathlib"}, {"name": "sym_option_succ_equiv.decode_encode", "description": "", "p": "mathlib"}, {"name": "sym_option_succ_equiv.encode_of_not_none_mem", "description": "", "p": "mathlib"}, {"name": "sym.append", "description": "Append a pair of `sym` terms.", "p": "mathlib"}, {"name": "sym.map_id'", "description": "Note: `sym.map_id` is not simp-normal, as simp ends up unfolding `id` with `sym.map_congr`", "p": "mathlib"}, {"name": "sym.decidable_mem", "description": "", "p": "mathlib"}, {"name": "sym.inhabited_sym'", "description": "", "p": "mathlib"}, {"name": "sym.eq_replicate_iff", "description": "", "p": "mathlib"}, {"name": "sym.has_emptyc", "description": "", "p": "mathlib"}, {"name": "sym.erase", "description": "`erase s a h` is the sym that subtracts 1 from the\n multiplicity of `a` if a is present in the sym.", "p": "mathlib"}, {"name": "sym.mem_append_iff", "description": "", "p": "mathlib"}, {"name": "sym.unique", "description": "", "p": "mathlib"}, {"name": "sym.eq_nil_of_card_zero", "description": "", "p": "mathlib"}, {"name": "sym.replicate_right_injective", "description": "", "p": "mathlib"}, {"name": "sym_option_succ_equiv.encode_of_none_mem", "description": "", "p": "mathlib"}, {"name": "sym.coe_erase", "description": "", "p": "mathlib"}, {"name": "sym.cons_inj_left", "description": "", "p": "mathlib"}, {"name": "sym.coe_injective", "description": "", "p": "mathlib"}, {"name": "sym.mem_cast", "description": "", "p": "mathlib"}, {"name": "sym.eq_replicate", "description": "", "p": "mathlib"}, {"name": "sym.has_coe", "description": "", "p": "mathlib"}, {"name": "sym.cons_equiv_eq_equiv_cons", "description": "", "p": "mathlib"}, {"name": "sym.mem_cons_self", "description": "", "p": "mathlib"}, {"name": "sym.subsingleton", "description": "", "p": "mathlib"}, {"name": "sym.attach_map_coe", "description": "", "p": "mathlib"}, {"name": "sym.cons", "description": "Inserts an element into the term of `sym \u03b1 n`, increasing the length by one.", "p": "mathlib"}, {"name": "sym.attach_cons", "description": "", "p": "mathlib"}, {"name": "sym.coe_map", "description": "", "p": "mathlib"}, {"name": "sym.attach_mk", "description": "", "p": "mathlib"}, {"name": "sym.coe_cons", "description": "", "p": "mathlib"}, {"name": "sym.fill_filter_ne", "description": "", "p": "mathlib"}, {"name": "sym.equiv_congr_symm_apply", "description": "", "p": "mathlib"}, {"name": "sym.map_zero", "description": "", "p": "mathlib"}, {"name": "function.injective.sigma_map", "description": "", "p": "mathlib"}, {"name": "psigma.forall", "description": "", "p": "mathlib"}, {"name": "psigma.elim", "description": "Nondependent eliminator for `psigma`.", "p": "mathlib"}, {"name": "sigma.curry", "description": " Interpret a function on `\u03a3 x : \u03b1, \u03b2 x` as a dependent function with two arguments.\n\nThis also exists as an `equiv` as `equiv.Pi_curry \u03b3`.", "p": "mathlib"}, {"name": "psigma.elim_val", "description": "", "p": "mathlib"}, {"name": "function.injective.sigma_map_iff", "description": "", "p": "mathlib"}, {"name": "sigma.uncurry", "description": " Interpret a dependent function with two arguments as a function on `\u03a3 x : \u03b1, \u03b2 x`.\n\nThis also exists as an `equiv` as `(equiv.Pi_curry \u03b3).symm`.", "p": "mathlib"}, {"name": "sigma_mk_injective", "description": "", "p": "mathlib"}, {"name": "sigma.map", "description": "Map the left and right components of a sigma", "p": "mathlib"}, {"name": "psigma.mk.inj_iff", "description": "", "p": "mathlib"}, {"name": "psigma.decidable_eq", "description": "", "p": "mathlib"}, {"name": "psigma.ext", "description": "", "p": "mathlib"}, {"name": "sigma.ext", "description": "", "p": "mathlib"}, {"name": "sigma.curry_uncurry", "description": "", "p": "mathlib"}, {"name": "sigma.subtype_ext", "description": "A specialized ext lemma for equality of sigma types over an indexed subtype.", "p": "mathlib"}, {"name": "prod.to_sigma_mk", "description": "", "p": "mathlib"}, {"name": "psigma.map", "description": "Map the left and right components of a sigma", "p": "mathlib"}, {"name": "prod.to_sigma", "description": "Convert a product type to a \u03a3-type.", "p": "mathlib"}, {"name": "sigma.eta", "description": "", "p": "mathlib"}, {"name": "psigma.inhabited", "description": "", "p": "mathlib"}, {"name": "psigma.exists", "description": "", "p": "mathlib"}, {"name": "sigma.inhabited", "description": "", "p": "mathlib"}, {"name": "sigma.forall", "description": "", "p": "mathlib"}, {"name": "sigma.exists", "description": "", "p": "mathlib"}, {"name": "function.surjective.sigma_map", "description": "", "p": "mathlib"}, {"name": "prod.fst_comp_to_sigma", "description": "", "p": "mathlib"}, {"name": "sigma.decidable_eq", "description": "", "p": "mathlib"}, {"name": "sigma.reflect", "description": "", "p": "mathlib"}, {"name": "sigma.uncurry_curry", "description": "", "p": "mathlib"}, {"name": "psigma.subtype_ext_iff", "description": "", "p": "mathlib"}, {"name": "function.injective.of_sigma_map", "description": "", "p": "mathlib"}, {"name": "psigma.subtype_ext", "description": "A specialized ext lemma for equality of psigma types over an indexed subtype.", "p": "mathlib"}, {"name": "sigma.mk.inj_iff", "description": "", "p": "mathlib"}, {"name": "psigma.ext_iff", "description": "", "p": "mathlib"}, {"name": "sigma.ext_iff", "description": "", "p": "mathlib"}, {"name": "prod.fst_to_sigma", "description": "", "p": "mathlib"}, {"name": "sigma.subtype_ext_iff", "description": "", "p": "mathlib"}, {"name": "prod.snd_to_sigma", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_surjective", "description": "", "p": "mathlib"}, {"name": "is_localized_module.eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "localized_module.lift", "description": "If `g` is a linear map `M \u2192 M''` such that all scalar multiplication by `s : S` is invertible, then\nthere is a linear map `localized_module S M \u2192 M''`.", "p": "mathlib"}, {"name": "is_localized_module.smul_injective", "description": "", "p": "mathlib"}, {"name": "is_localized_module.iso_symm_apply_aux", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_mul_mk'", "description": "", "p": "mathlib"}, {"name": "is_localized_module.from_localized_module_mk", "description": "", "p": "mathlib"}, {"name": "is_localized_module.from_localized_module'_add", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_eq_mk'_iff", "description": "", "p": "mathlib"}, {"name": "localized_module.induction_on\u2082", "description": "", "p": "mathlib"}, {"name": "is_localized_module.from_localized_module'_mk", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_one", "description": "", "p": "mathlib"}, {"name": "localized_module.comm_ring", "description": "", "p": "mathlib"}, {"name": "localized_module.r.is_equiv", "description": "", "p": "mathlib"}, {"name": "localized_module.lift'_add", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_linear_map", "description": "The function `m \u21a6 m / 1` as an `R`-linear map.", "p": "mathlib"}, {"name": "is_localized_module.mk'_eq_iff", "description": "", "p": "mathlib"}, {"name": "localized_module.ring", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_cancel_common_right", "description": "", "p": "mathlib"}, {"name": "localized_module.r.setoid", "description": "", "p": "mathlib"}, {"name": "localized_module.semiring", "description": "", "p": "mathlib"}, {"name": "is_localized_module.from_localized_module.surj", "description": "", "p": "mathlib"}, {"name": "is_localized_module.from_localized_module.inj", "description": "", "p": "mathlib"}, {"name": "localized_module.div_by", "description": "For any `s : S`, there is an `R`-linear map given by `a/b \u21a6 a/(b*s)`.", "p": "mathlib"}, {"name": "localized_module", "description": "If `S` is a multiplicative subset of a ring `R` and `M` an `R`-module, then\nwe can localize `M` by `S`.", "p": "mathlib"}, {"name": "is_localized_module.mk'_eq_zero'", "description": "", "p": "mathlib"}, {"name": "is_localized_module.ring_hom_ext", "description": "", "p": "mathlib"}, {"name": "localized_module.r", "description": "The equivalence relation on `M \u00d7 S` where `(m1, s1) \u2248 (m2, s2)` if and only if\nfor some (u : S), u * (s2 \u2022 m1 - s1 \u2022 m2) = 0", "p": "mathlib"}, {"name": "localized_module.has_smul", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_add_mk", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'", "description": "`mk' f m s` is the fraction `m/s` with respect to the localization map `f`.", "p": "mathlib"}, {"name": "is_localized_module.mk'_cancel", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_eq_zero", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_sub", "description": "", "p": "mathlib"}, {"name": "localized_module.smul'_mk", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_mul_mk", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_cancel'", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_sub_mk'", "description": "", "p": "mathlib"}, {"name": "localized_module.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "localized_module.zero_mk", "description": "", "p": "mathlib"}, {"name": "localized_module.algebra_map_mk", "description": "", "p": "mathlib"}, {"name": "is_localized_module.from_localized_module.bij", "description": "", "p": "mathlib"}, {"name": "localized_module.lift'_mk", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk_of_algebra", "description": "", "p": "mathlib"}, {"name": "localized_module.lift_on", "description": "If `f : M \u00d7 S \u2192 \u03b1` respects the equivalence relation `localized_module.r`, then\n`f` descents to a map `localized_module M S \u2192 \u03b1`.", "p": "mathlib"}, {"name": "is_localized_module.mk'_add", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_eq", "description": "", "p": "mathlib"}, {"name": "localized_module.algebra'", "description": "", "p": "mathlib"}, {"name": "localized_module.mk", "description": "The canonical map sending `(m, s) \u21a6 m/s`", "p": "mathlib"}, {"name": "is_localized_module.mk'_neg", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_zero", "description": "", "p": "mathlib"}, {"name": "is_localized_module.iso_apply_mk", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk_eq_mk'", "description": "", "p": "mathlib"}, {"name": "localized_module.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "is_localized_module.lift", "description": "If `M'` is a localized module and `g` is a linear map `M' \u2192 M''` such that all scalar multiplication\nby `s : S` is invertible, then there is a linear map `M' \u2192 M''`.", "p": "mathlib"}, {"name": "is_localized_module.mk'_smul", "description": "", "p": "mathlib"}, {"name": "localized_module.div_by_apply", "description": "", "p": "mathlib"}, {"name": "localized_module.induction_on", "description": "", "p": "mathlib"}, {"name": "is_localized_module.lift_unique", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_mul_mk'_of_map_mul", "description": "", "p": "mathlib"}, {"name": "is_localized_module.from_localized_module'_smul", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_cancel_common_left", "description": "", "p": "mathlib"}, {"name": "localized_module_is_localized_module", "description": "", "p": "mathlib"}, {"name": "localized_module.add_comm_group", "description": "", "p": "mathlib"}, {"name": "is_localized_module.iso", "description": "If `(M', f : M \u27f6 M')` satisfies universal property of localized module, then `M'` is isomorphic to\n`localized_module S M` as an `R`-module.", "p": "mathlib"}, {"name": "is_localized_module.mk'_cancel_right", "description": "", "p": "mathlib"}, {"name": "localized_module.algebra", "description": "", "p": "mathlib"}, {"name": "is_localized_module.from_localized_module", "description": "If `(M', f : M \u27f6 M')` satisfies universal property of localized module, there is a canonical map\n`localized_module S M \u27f6 M'`.", "p": "mathlib"}, {"name": "localized_module.lift_on\u2082_mk", "description": "", "p": "mathlib"}, {"name": "is_localized_module.iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "is_localized_module.linear_equiv", "description": "If `(M', f)` and `(M'', g)` both satisfy universal property of localized module, then `M', M''`\nare isomorphic as `R`-module", "p": "mathlib"}, {"name": "is_localized_module.lift_comp", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_cancel", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_smul_mk", "description": "", "p": "mathlib"}, {"name": "is_localized_module.is_universal", "description": "Universal property from localized module:\nIf `(M', f : M \u27f6 M')` is a localized module then it satisfies the following universal property:\nFor every `R`-module `M''` which every `s : S`-scalar multiplication is invertible and for every\n`R`-linear map `g : M \u27f6 M''`, there is a unique `R`-linear map `l : M' \u27f6 M''` such that\n`l \u2218 f = g`.\n```lean\nM -----f----> M'\n|           /\n|g       /\n|     /   l\nv   /\nM''\n```", "p": "mathlib"}, {"name": "localized_module.has_nat_smul", "description": "", "p": "mathlib"}, {"name": "is_localized_module.mk'_cancel_left", "description": "", "p": "mathlib"}, {"name": "localized_module.div_by_mul_by", "description": "", "p": "mathlib"}, {"name": "is_localized_module", "description": "The characteristic predicate for localized module.\n`is_localized_module S f` describes that `f : M \u27f6 M'` is the localization map identifying `M'` as\n`localized_module S M`.", "p": "mathlib"}, {"name": "is_localized_module.map_units", "description": "The characteristic predicate for localized module.\n`is_localized_module S f` describes that `f : M \u27f6 M'` is the localization map identifying `M'` as\n`localized_module S M`.", "p": "mathlib"}, {"name": "is_localized_module.surj", "description": "The characteristic predicate for localized module.\n`is_localized_module S f` describes that `f : M \u27f6 M'` is the localization map identifying `M'` as\n`localized_module S M`.", "p": "mathlib"}, {"name": "is_localized_module.eq_iff_exists", "description": "The characteristic predicate for localized module.\n`is_localized_module S f` describes that `f : M \u27f6 M'` is the localization map identifying `M'` as\n`localized_module S M`.", "p": "mathlib"}, {"name": "localized_module.is_module", "description": "", "p": "mathlib"}, {"name": "localized_module.lift'_smul", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_neg", "description": "", "p": "mathlib"}, {"name": "is_localized_module.iso_apply", "description": "", "p": "mathlib"}, {"name": "is_localized_module.iso_symm_apply'", "description": "", "p": "mathlib"}, {"name": "localized_module.lift_on\u2082", "description": "If `f : M \u00d7 S \u2192 M \u00d7 S \u2192 \u03b1` respects the equivalence relation `localized_module.r`, then\n`f` descents to a map `localized_module M S \u2192 localized_module M S \u2192 \u03b1`.", "p": "mathlib"}, {"name": "localized_module.is_module'", "description": "", "p": "mathlib"}, {"name": "localized_module.lift_mk", "description": "If `g` is a linear map `M \u2192 M''` such that all scalar multiplication by `s : S` is invertible, then\n`lift g m s = s\u207b\u00b9 \u2022 g m`.", "p": "mathlib"}, {"name": "localized_module.lift'", "description": "If `g` is a linear map `M \u2192 M''` such that all scalar multiplication by `s : S` is invertible, then\nthere is a linear map `localized_module S M \u2192 M''`.", "p": "mathlib"}, {"name": "is_localized_module.smul_inj", "description": "", "p": "mathlib"}, {"name": "localized_module.has_add", "description": "", "p": "mathlib"}, {"name": "localized_module.mul_by_div_by", "description": "", "p": "mathlib"}, {"name": "localized_module.mk_linear_map_apply", "description": "", "p": "mathlib"}, {"name": "is_localized_module.iso_symm_comp", "description": "", "p": "mathlib"}, {"name": "is_localized_module.from_localized_module'", "description": "If `(M', f : M \u27f6 M')` satisfies universal property of localized module, there is a canonical map\n`localized_module S M \u27f6 M'`.", "p": "mathlib"}, {"name": "localized_module.lift_on_mk", "description": "", "p": "mathlib"}, {"name": "localized_module.lift_comp", "description": "If `g` is a linear map `M \u2192 M''` such that all scalar multiplication by `s : S` is invertible, then\nthere is a linear map `lift g \u2218 mk_linear_map = g`.", "p": "mathlib"}, {"name": "localized_module.lift_unique", "description": "If `g` is a linear map `M \u2192 M''` such that all scalar multiplication by `s : S` is invertible and\n`l` is another linear map `localized_module S M \u27f6 M''` such that `l \u2218 mk_linear_map = g` then\n`l = lift g`", "p": "mathlib"}, {"name": "is_localized_module.mk'_add_mk'", "description": "", "p": "mathlib"}, {"name": "localized_module.comm_semiring", "description": "", "p": "mathlib"}, {"name": "localized_module.has_zero", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.coe_add", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.to_affine_map_eq_coe", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.has_coe_to_fun", "description": " Helper instance for when there's too many metavariables to apply\n`fun_like.has_coe_to_fun` directly.", "p": "mathlib"}, {"name": "continuous_affine_map.smul_apply", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.to_continuous_map_coe", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.coe_sub", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.ext", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.inhabited", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.coe_to_continuous_affine_map", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.zero_apply", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.coe_const", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.distrib_mul_action", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.module", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.coe_neg", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.coe_to_affine_map", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.to_affine_map_injective", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.coe_comp", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.continuous_map.has_coe", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.mul_action", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.to_continuous_map_injective", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.has_neg", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.comp", "description": "The composition of morphisms is a morphism.", "p": "mathlib"}, {"name": "continuous_affine_map.coe_affine_map_mk", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.neg_apply", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.mk_coe", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.to_continuous_affine_map_map_zero", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.has_zero", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.to_continuous_affine_map", "description": "A continuous linear map can be regarded as a continuous affine map.", "p": "mathlib"}, {"name": "continuous_affine_map.coe_mk", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.sub_apply", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.continuous_map_class", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.to_continuous_map", "description": "Forgetting its algebraic properties, a continuous affine map is a continuous map.", "p": "mathlib"}, {"name": "continuous_affine_map.coe_injective", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.has_add", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.comp_apply", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.continuous", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.affine_map.has_coe", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.has_sub", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.has_smul", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.coe_continuous_map_mk", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.coe_zero", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map", "description": "A continuous map of affine spaces.", "p": "mathlib"}, {"name": "continuous_affine_map.to_affine_map", "description": "A continuous map of affine spaces.", "p": "mathlib"}, {"name": "continuous_affine_map.cont", "description": "A continuous map of affine spaces.", "p": "mathlib"}, {"name": "continuous_affine_map.is_central_scalar", "description": "", "p": "mathlib"}, {"name": "continuous_affine_map.ext_iff", "description": "", "p": "mathlib"}, {"name":