mathlib"}, {"name": "eq.trans_gt", "description": "**Alias** of `lt_of_eq_of_lt'`.", "p": "mathlib"}, {"name": "preorder.to_has_le_injective", "description": "", "p": "mathlib"}, {"name": "lt_of_lt_of_le'", "description": "", "p": "mathlib"}, {"name": "has_le.le.lt_iff_ne", "description": "", "p": "mathlib"}, {"name": "function.const_le_const", "description": "", "p": "mathlib"}, {"name": "eq_of_forall_gt_iff", "description": "", "p": "mathlib"}, {"name": "order_dual.partial_order", "description": "", "p": "mathlib"}, {"name": "pi.has_sdiff", "description": "", "p": "mathlib"}, {"name": "decidable.eq_iff_le_not_lt", "description": "", "p": "mathlib"}, {"name": "forall_lt_iff_le'", "description": "", "p": "mathlib"}, {"name": "strong_lt", "description": "A function `a` is strongly less than a function `b`  if `a i < b i` for all `i`.", "p": "mathlib"}, {"name": "linear_order.to_partial_order_injective", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_coe_pnat_monoid_hom", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_pnat_monoid_hom", "description": " `coe_pnat`, the coercion from a multiset of primes to a multiset of positive\nnaturals, regarded as an `add_monoid_hom`.", "p": "mathlib"}, {"name": "prime_multiset.coe_pnat_injective", "description": "", "p": "mathlib"}, {"name": "prime_multiset.canonically_ordered_add_monoid", "description": "", "p": "mathlib"}, {"name": "prime_multiset.prod_dvd_iff", "description": "", "p": "mathlib"}, {"name": "prime_multiset.has_sub", "description": "", "p": "mathlib"}, {"name": "prime_multiset.has_ordered_sub", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_nat_injective", "description": "", "p": "mathlib"}, {"name": "prime_multiset.prod_of_pnat_list", "description": "", "p": "mathlib"}, {"name": "pnat.prod_factor_multiset", "description": "The product of the factors is the original number", "p": "mathlib"}, {"name": "prime_multiset.coe_prod", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_pnat", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_pnat_nat", "description": "", "p": "mathlib"}, {"name": "prime_multiset.prod_of_pnat_multiset", "description": "", "p": "mathlib"}, {"name": "prime_multiset.prod_inf", "description": "", "p": "mathlib"}, {"name": "prime_multiset.to_nat_multiset", "description": "We can forget the primality property and regard a multiset\nof primes as just a multiset of positive integers, or a multiset\nof natural numbers.  In the opposite direction, if we have a\nmultiset of positive integers or natural numbers, together with\na proof that all the elements are prime, then we can regard it\nas a multiset of primes.  The next block of results records\nobvious properties of these coercions.", "p": "mathlib"}, {"name": "prime_multiset.prod_of_nat_multiset", "description": "", "p": "mathlib"}, {"name": "prime_multiset.prod", "description": "The product of a `prime_multiset`, as a `\u2115+`.", "p": "mathlib"}, {"name": "prime_multiset", "description": "The type of multisets of prime numbers.  Unique factorization\ngives an equivalence between this set and \u2115+, as we will formalize\nbelow.", "p": "mathlib"}, {"name": "prime_multiset.of_pnat_list", "description": " If a `list \u2115+` consists only of primes, it can be recast as a `prime_multiset` with\nthe coercion from lists to multisets.", "p": "mathlib"}, {"name": "prime_multiset.of_prime", "description": "The multiset consisting of a single prime", "p": "mathlib"}, {"name": "pnat.factor_multiset_one", "description": "Factoring gives a homomorphism from the multiplicative\nmonoid \u2115+ to the additive monoid of multisets.", "p": "mathlib"}, {"name": "prime_multiset.of_nat_list", "description": " Lists can be coerced to multisets; here we have some results\nabout how this interacts with our constructions on multisets.", "p": "mathlib"}, {"name": "pnat.factor_multiset_gcd", "description": "The gcd and lcm operations on positive integers correspond\nto the inf and sup operations on multisets.", "p": "mathlib"}, {"name": "prime_multiset.to_of_nat_multiset", "description": "", "p": "mathlib"}, {"name": "prime_multiset.distrib_lattice", "description": "", "p": "mathlib"}, {"name": "prime_multiset.to_pnat_multiset", "description": "Converts a `prime_multiset` to a `multiset \u2115+`.", "p": "mathlib"}, {"name": "prime_multiset.prod_of_prime", "description": "", "p": "mathlib"}, {"name": "prime_multiset.prod_of_nat_list", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_nat", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_pnat_of_prime", "description": "", "p": "mathlib"}, {"name": "pnat.factor_multiset", "description": "The prime factors of n, regarded as a multiset", "p": "mathlib"}, {"name": "prime_multiset.factor_multiset_prod", "description": "If we start with a multiset of primes, take the product and\nthen factor it, we get back the original multiset.", "p": "mathlib"}, {"name": "prime_multiset.prod_dvd_iff'", "description": "", "p": "mathlib"}, {"name": "prime_multiset.card_of_prime", "description": "", "p": "mathlib"}, {"name": "prime_multiset.of_nat_multiset", "description": "If a `multiset \u2115` consists only of primes, it can be recast as a `prime_multiset`.", "p": "mathlib"}, {"name": "pnat.factor_multiset_lcm", "description": "", "p": "mathlib"}, {"name": "prime_multiset.of_pnat_multiset", "description": "If a `multiset \u2115+` consists only of primes, it can be recast as a `prime_multiset`.", "p": "mathlib"}, {"name": "pnat.factor_multiset_pow", "description": "", "p": "mathlib"}, {"name": "pnat.factor_multiset_le_iff'", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_nat_of_prime", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_pnat_prime", "description": "", "p": "mathlib"}, {"name": "prime_multiset.has_repr", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_coe_nat_monoid_hom", "description": "", "p": "mathlib"}, {"name": "prime_multiset.order_bot", "description": "", "p": "mathlib"}, {"name": "pnat.count_factor_multiset", "description": "The number of occurrences of p in the factor multiset of m\nis the same as the p-adic valuation of m.", "p": "mathlib"}, {"name": "prime_multiset.coe_nat_monoid_hom", "description": " `prime_multiset.coe`, the coercion from a multiset of primes to a multiset of\nnaturals, promoted to an `add_monoid_hom`.", "p": "mathlib"}, {"name": "prime_multiset.semilattice_sup", "description": "", "p": "mathlib"}, {"name": "prime_multiset.coe_nat_prime", "description": "", "p": "mathlib"}, {"name": "pnat.factor_multiset_mul", "description": "", "p": "mathlib"}, {"name": "pnat.factor_multiset_equiv", "description": "Positive integers biject with multisets of primes.", "p": "mathlib"}, {"name": "prime_multiset.prod_smul", "description": "", "p": "mathlib"}, {"name": "pnat.coe_nat_factor_multiset", "description": "", "p": "mathlib"}, {"name": "prime_multiset.prod_add", "description": "", "p": "mathlib"}, {"name": "prime_multiset.inhabited", "description": "", "p": "mathlib"}, {"name": "prime_multiset.prod_zero", "description": " The product map gives a homomorphism from the additive monoid\nof multisets to the multiplicative monoid \u2115+.", "p": "mathlib"}, {"name": "pnat.factor_multiset_le_iff", "description": "We now have four different results that all encode the\nidea that inequality of multisets corresponds to divisibility\nof positive integers.", "p": "mathlib"}, {"name": "prime_multiset.prod_sup", "description": "", "p": "mathlib"}, {"name": "pnat.factor_multiset_of_prime", "description": "Factoring a prime gives the corresponding one-element multiset.", "p": "mathlib"}, {"name": "prime_multiset.coe_multiset_pnat_nat", "description": "", "p": "mathlib"}, {"name": "prime_multiset.to_of_pnat_multiset", "description": "", "p": "mathlib"}, {"name": "add_left_eq_self", "description": "", "p": "mathlib"}, {"name": "sub_eq_sub_iff_sub_