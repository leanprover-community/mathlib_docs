lib-archive"}, {"name": "ballot.counted_left_zero", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_ne_nil_right", "description": "", "p": "mathlib-archive"}, {"name": "ballot.mem_of_mem_counted_sequence", "description": "", "p": "mathlib-archive"}, {"name": "ballot.length_of_mem_counted_sequence", "description": "", "p": "mathlib-archive"}, {"name": "ballot.stays_positive_cons_pos", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_sequence", "description": "`counted_sequence p q` is the set of lists of integers for which every element is `+1` or `-1`,\nthere are `p` lots of `+1` and `q` lots of `-1`.\n\nThis represents vote sequences where candidate `+1` receives `p` votes and candidate `-1` receives\n`q` votes.", "p": "mathlib-archive"}, {"name": "ballot.ballot_problem'", "description": "", "p": "mathlib-archive"}, {"name": "ballot.first_vote_pos", "description": "", "p": "mathlib-archive"}, {"name": "ballot.ballot_same", "description": "", "p": "mathlib-archive"}, {"name": "ballot.stays_positive_nil", "description": "", "p": "mathlib-archive"}, {"name": "ballot.count_counted_sequence", "description": "", "p": "mathlib-archive"}, {"name": "ballot.ballot_pos", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_sequence_int_pos_counted_succ_succ", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_right_zero", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_ne_nil_left", "description": "", "p": "mathlib-archive"}, {"name": "ballot.sum_of_mem_counted_sequence", "description": "", "p": "mathlib-archive"}, {"name": "ballot.ballot_neg", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_succ_succ", "description": "", "p": "mathlib-archive"}, {"name": "ballot.ballot_problem", "description": "The ballot problem.", "p": "mathlib-archive"}, {"name": "ballot.disjoint_bits", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_sequence_int_neg_counted_succ_succ", "description": "", "p": "mathlib-archive"}, {"name": "ballot.head_mem_of_nonempty", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_sequence_finite", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_sequence_nonempty", "description": "", "p": "mathlib-archive"}, {"name": "ballot.counted_eq_nil_iff", "description": "", "p": "mathlib-archive"}, {"name": "ballot.ballot_edge", "description": "", "p": "mathlib-archive"}, {"name": "ballot.mem_counted_sequence_iff_perm", "description": "An alternative definition of `counted_sequence` that uses `list.perm`.", "p": "mathlib-archive"}, {"name": "ballot.first_vote_neg", "description": "", "p": "mathlib-archive"}, {"name": "fin.of_nat_zero", "description": "", "p": "core"}, {"name": "fin.has_one", "description": "", "p": "core"}, {"name": "fin.mod", "description": "", "p": "core"}, {"name": "fin.succ", "description": "", "p": "core"}, {"name": "fin.sub", "description": "", "p": "core"}, {"name": "fin.has_sub", "description": "", "p": "core"}, {"name": "fin.le_def", "description": "", "p": "core"}, {"name": "fin.mod_def", "description": "", "p": "core"}, {"name": "fin.mul", "description": "", "p": "core"}, {"name": "fin.has_add", "description": "", "p": "core"}, {"name": "fin.add_def", "description": "", "p": "core"}, {"name": "fin.mul_def", "description": "", "p": "core"}, {"name": "fin.of_nat", "description": "", "p": "core"}, {"name": "fin.lt_def", "description": "", "p": "core"}, {"name": "fin.sub_def", "description": "", "p": "core"}, {"name": "fin.div", "description": "", "p": "core"}, {"name": "fin.has_mod", "description": "", "p": "core"}, {"name": "fin.has_mul", "description": "", "p": "core"}, {"name": "fin.add", "description": "", "p": "core"}, {"name": "fin.has_div", "description": "", "p": "core"}, {"name": "fin.div_def", "description": "", "p": "core"}, {"name": "fin.pred", "description": "", "p": "core"}, {"name": "fin.val_zero", "description": "", "p": "core"}, {"name": "fin.has_zero", "description": "", "p": "core"}, {"name": "subsemigroup.mem_Sup_of_mem", "description": "", "p": "mathlib"}, {"name": "subsemigroup.supr_induction'", "description": "A dependent version of `subsemigroup.supr_induction`.", "p": "mathlib"}, {"name": "subsemigroup.mem_sup_left", "description": "", "p": "mathlib"}, {"name": "subsemigroup.mem_Sup_of_directed_on", "description": "", "p": "mathlib"}, {"name": "add_subsemigroup.supr_induction'", "description": "A dependent version of `add_subsemigroup.supr_induction`.", "p": "mathlib"}, {"name": "add_subsemigroup.mem_Sup_of_mem", "description": "", "p": "mathlib"}, {"name": "subsemigroup.mem_supr_of_mem", "description": "", "p": "mathlib"}, {"name": "add_subsemigroup.supr_induction", "description": " An induction principle for elements of `\u2a06 i, S i`.\nIf `C` holds all elements of `S i` for all `i`, and is preserved under addition,\nthen it holds for all elements of the supremum of `S`.", "p": "mathlib"}, {"name": "subsemigroup.mem_supr_of_directed", "description": "", "p": "mathlib"}, {"name": "add_subsemigroup.mem_supr_of_mem", "description": "", "p": "mathlib"}, {"name": "add_subsemigroup.add_mem_sup", "description": "", "p": "mathlib"}, {"name": "add_subsemigroup.mem_sup_right", "description": "", "p": "mathlib"}, {"name": "add_subsemigroup.coe_supr_of_directed", "description": "", "p": "mathlib"}, {"name": "subsemigroup.mem_sup_right", "description": "", "p": "mathlib"}, {"name": "subsemigroup.coe_Sup_of_directed_on", "description": "", "p": "mathlib"}, {"name": "add_subsemigroup.mem_supr_of_directed", "description": "", "p": "mathlib"}, {"name": "subsemigroup.mul_mem_sup", "description": "", "p": "mathlib"}, {"name": "subsemigroup.supr_induction", "description": " An induction principle for elements of `\u2a06 i, S i`.\nIf `C` holds all elements of `S i` for all `i`, and is preserved under multiplication,\nthen it holds for all elements of the supremum of `S`.", "p": "mathlib"}, {"name": "add_subsemigroup.mem_Sup_of_directed_on", "description": "", "p": "mathlib"}, {"name": "add_subsemigroup.coe_Sup_of_directed_on", "description": "", "p": "mathlib"}, {"name": "subsemigroup.coe_supr_of_directed", "description": "", "p": "mathlib"}, {"name": "add_subsemigroup.mem_sup_left", "description": "", "p": "mathlib"}, {"name": "nnreal.inner_le_Lp_mul_Lq_has_sum", "description": " H\u00f6lder inequality: the scalar product of two functions is bounded by the product of their\n`L^p` and `L^q` norms when `p` and `q` are conjugate exponents. A version for `nnreal`-valued\nfunctions. For an alternative version, convenient if the infinite sums are not already expressed as\n`p`-th powers, see `inner_le_Lp_mul_Lq_tsum`.", "p": "mathlib"}, {"name": "real.Lp_add_le", "description": " Minkowski inequality: the `L_p` seminorm of the sum of two vectors is less than or equal\nto the sum of the `L_p`-seminorms of the summands. A version for `real`-valued functions.", "p": "mathlib"}, {"name": "real.geom_mean_le_arith_mean_weighted", "description": " AM-GM inequality: the **geometric mean is less than or equal to the arithmetic mean**, weighted\nversion for real-valued nonnegative functions.", "p": "mathlib"}, {"name": "nnreal.Lp_add_le_tsum", "description": " Minkowski inequality: the `L_p` seminorm of the infinite sum of two vectors is less than or\nequal to the infinite sum of the `L_p`-seminorms of the summands, if these infinite sums both\nexist. A version for `nnreal`-valued functions. For an alternative version, convenient if the\ninfinite sums are already expressed as `p`-th powers, see `Lp_add_le_has_sum_of_nonneg`.", "p": "mathlib"}, {"name": "nnreal.Lp_add_le_tsum'", "description": "", "p": "mathlib"}, {"name": "real.inner_le_Lp_mul_Lq_tsum_of_nonneg'", "description": "", "p": "mathlib"}, {"name": "nnreal.geom_mean_le_arith_mean4_weighted", "description": "", "p": "mathlib"}, {"name": "nnreal.young_inequality_real", "description": "Young's inequality, `\u211d\u22650` version with real conjugate exponents.", "p": "mathlib"}, {"name": "real.inner_le_Lp_mul_Lq", "description": " H\u00f6lder inequality: the scalar product of two functions is bounded by the product of their\n`L^p` and `L^q` norms when `p` and `q` are conjugate exponents. Version for sums over finite sets,\nwith real-valued functions.", "p": "mathlib"}, {"name": "real.arith_mean_weighted_of_constant", "description": "", "p": "mathlib"}, {"name": "real.geom_mean_le_arith_mean4_weighted", "description": "", "p": "mathlib"}, {"name": "real.inner_le_Lp_mul_Lq_tsum_of_nonneg", "description": " H\u00f6lder inequality: the scalar product of two functions is bounded by the product of their\n`L^p` and `L^q` norms when `p` and `q` are conjugate exponents. A version for `\u211d`-valued functions.\nFor an alternative version, convenient if the infinite sums are already expressed as `p`-th powers,\nsee `inner_le_Lp_mul_Lq_has_sum_of_nonneg`.", "p": "mathlib"}, {"name": "nnreal.geom_mean_le_arith_mean2_weighted", "description": " The geometric mean is less than or equal to the arithmetic mean, weighted version\nfor two `nnreal` numbers.", "p": "mathlib"}, {"name": "ennreal.young_inequality", "description": "Young's inequality, `\u211d\u22650\u221e` version with real conjugate exponents.", "p": "mathlib"}, {"name": "nnreal.young_inequality", "description": " Young's inequality, `\u211d\u22650` version. We use `{p q : \u211d\u22650}` in order to avoid constructing\nwitnesses of `0 \u2264 p` and `0 \u2264 q` for the denominators.", "p": "mathlib"}, {"name": "real.geom_mean_le_arith_mean2_weighted", "description": "", "p": "mathlib"}, {"name": "nnreal.Lp_add_le_has_sum", "description": " Minkowski inequality: the `L_p` seminorm of the infinite sum of two vectors is less than or\nequal to the infinite sum of the `L_p`-seminorms of the summands, if these infinite sums both\nexist. A version for `nnreal`-valued functions. For an alternative version, convenient if the\ninfinite sums are not already expressed as `p`-th powers, see `Lp_add_le_tsum_of_nonneg`.", "p": "mathlib"}, {"name": "real.rpow_sum_le_const_mul_sum_rpow", "description": " For `1 \u2264 p`, the `p`-th power of the sum of `f i` is bounded above by a constant times the\nsum of the `p`-th powers of `f i`. Version for sums over finite sets, with `\u211d`-valued functions.", "p": "mathlib"}, {"name": "real.young_inequality", "description": "Young's inequality, a version for arbitrary real numbers.", "p": "mathlib"}, {"name": "real.summable_mul_of_Lp_Lq_of_nonneg", "description": "", "p": "mathlib"}, {"name": "nnreal.summable_Lp_add", "description": "", "p": "mathlib"}, {"name": "nnreal.geom_mean_le_arith_mean3_weighted", "description": "", "p": "mathlib"}, {"name": "nnreal.Lp_add_le", "description": " Minkowski inequality: the `L_p` seminorm of the sum of two vectors is less than or equal\nto the sum of the `L_p`-seminorms of the summands. A version for `nnreal`-valued functions.", "p": "mathlib"}, {"name": "nnreal.rpow_sum_le_const_mul_sum_rpow", "description": " For `1 \u2264 p`, the `p`-th power of the sum of `f i` is bounded above by a constant times the\nsum of the `p`-th powers of `f i`. Version for sums over finite sets, with `\u211d\u22650`-valued functions.", "p": "mathlib"}, {"name": "nnreal.inner_le_Lp_mul_Lq", "description": " H\u00f6lder inequality: the scalar product of two functions is bounded by the product of their\n`L^p` and `L^q` norms when `p` and `q` are conjugate exponents. Version for sums over finite sets,\nwith `\u211d\u22650`-valued functions.", "p": "mathlib"}, {"name": "real.Lp_add_le_has_sum_of_nonneg", "description": " Minkowski inequality: the `L_p` seminorm of the infinite sum of two vectors is less than or\nequal to the infinite sum of the `L_p`-seminorms of the summands, if these infinite sums both\nexist. A version for `\u211d`-valued functions. For an alternative version, convenient if the infinite\nsums are not already expressed as `p`-th powers, see `Lp_add_le_tsum_of_nonneg`.", "p": "mathlib"}, {"name": "real.Lp_add_le_of_nonneg", "description": " Minkowski inequality: the `L_p` seminorm of the sum of two vectors is less than or equal\nto the sum of the `L_p`-seminorms of the summands. A version for `\u211d`-valued nonnegative\nfunctions.", "p": "mathlib"}, {"name": "real.young_inequality_of_nonneg", "description": "Young's inequality, a version for nonnegative real numbers.", "p": "mathlib"}, {"name": "ennreal.rpow_sum_le_const_mul_sum_rpow", "description": " For `1 \u2264 p`, the `p`-th power of the sum of `f i` is bounded above by a constant times the\nsum of the `p`-th powers of `f i`. Version for sums over finite sets, with `\u211d\u22650\u221e`-valued functions.", "p": "mathlib"}, {"name": "real.geom_mean_weighted_of_constant", "description": "", "p": "mathlib"}, {"name": "nnreal.geom_mean_le_arith_mean_weighted", "description": " The geometric mean is less than or equal to the arithmetic mean, weighted version\nfor `nnreal`-valued functions.", "p": "mathlib"}, {"name": "ennreal.Lp_add_le", "description": " Minkowski inequality: the `L_p` seminorm of the sum of two vectors is less than or equal\nto the sum of the `L_p`-seminorms of the summands. A version for `\u211d\u22650\u221e` valued nonnegative\nfunctions.", "p": "mathlib"}, {"name": "real.Lp_add_le_tsum_of_nonneg'", "description": "", "p": "mathlib"}, {"name": "nnreal.inner_le_Lp_mul_Lq_tsum", "description": " H\u00f6lder inequality: the scalar product of two functions is bounded by the product of their\n`L^p` and `L^q` norms when `p` and `q` are conjugate exponents. A version for `nnreal`-valued\nfunctions. For an alternative version, convenient if the infinite sums are already expressed as\n`p`-th powers, see `inner_le_Lp_mul_Lq_has_sum`.", "p": "mathlib"}, {"name": "nnreal.is_greatest_Lp", "description": " The `L_p` seminorm of a vector `f` is the greatest value of the inner product\n`\u2211 i in s, f i * g i` over functions `g` of `L_q` seminorm less than or equal to one.", "p": "mathlib"}, {"name": "real.Lp_add_le_tsum_of_nonneg", "description": " Minkowski inequality: the `L_p` seminorm of the infinite sum of two vectors is less than or\nequal to the infinite sum of the `L_p`-seminorms of the summands, if these infinite sums both\nexist. A version for `\u211d`-valued functions. For an alternative version, convenient if the infinite\nsums are already expressed as `p`-th powers, see `Lp_add_le_has_sum_of_nonneg`.", "p": "mathlib"}, {"name": "nnreal.summable_mul_of_Lp_Lq", "description": "", "p": "mathlib"}, {"name": "ennreal.inner_le_Lp_mul_Lq", "description": " H\u00f6lder inequality: the scalar product of two functions is bounded by the product of their\n`L^p` and `L^q` norms when `p` and `q` are conjugate exponents. Version for sums over finite sets,\nwith `\u211d\u22650\u221e`-valued functions.", "p": "mathlib"}, {"name": "real.inner_le_Lp_mul_Lq_of_nonneg", "description": " H\u00f6lder inequality: the scalar product of two functions is bounded by the product of their\n`L^p` and `L^q` norms when `p` and `q` are conjugate exponents. Version for sums over finite sets,\nwith real-valued nonnegative functions.", "p": "mathlib"}, {"name": "nnreal.inner_le_Lp_mul_Lq_tsum'", "description": "", "p": "mathlib"}, {"name": "real.summable_Lp_add_of_nonneg", "description": "", "p": "mathlib"}, {"name": "real.rpow_sum_le_const_mul_sum_rpow_of_nonneg", "description": " For `1 \u2264 p`, the `p`-th power of the sum of `f i` is bounded above by a constant times the\nsum of the `p`-th powers of `f i`. Version for sums over finite sets, with nonnegative `\u211d`-valued\nfunctions.", "p": "mathlib"}, {"name": "real.geom_mean_eq_arith_mean_weighted_of_constant", "description": "", "p": "mathlib"}, {"name": "real.inner_le_Lp_mul_Lq_has_sum_of_nonneg", "description": " H\u00f6lder inequality: the scalar product of two functions is bounded by the product of their\n`L^p` and `L^q` norms when `p` and `q` are conjugate 