mathlib"}, {"name": "add_submonoid_class.coe_nsmul", "description": "", "p": "mathlib"}, {"name": "add_submonoid.comap_strict_mono_of_surjective", "description": "", "p": "mathlib"}, {"name": "submonoid.one_def", "description": "", "p": "mathlib"}, {"name": "monoid_hom.mrange_eq_map", "description": "", "p": "mathlib"}, {"name": "submonoid.comap_inf", "description": "", "p": "mathlib"}, {"name": "submonoid.prod_equiv", "description": "The product of submonoids is isomorphic to their product as monoids.", "p": "mathlib"}, {"name": "add_submonoid.equiv_map_of_injective", "description": "An additive subgroup is isomorphic to its image under an injective function. If you\nhave an isomorphism, use `add_equiv.add_submonoid_map` for better definitional equalities.", "p": "mathlib"}, {"name": "add_submonoid.map_injective_of_injective", "description": "", "p": "mathlib"}, {"name": "submonoid.comap_equiv_eq_map_symm", "description": "", "p": "mathlib"}, {"name": "add_submonoid.to_add_comm_monoid", "description": "An `add_submonoid` of an `add_comm_monoid` is\nan `add_comm_monoid`.", "p": "mathlib"}, {"name": "submonoid.comap_id", "description": "", "p": "mathlib"}, {"name": "one_mem_class.has_one", "description": "A submonoid of a monoid inherits a 1.", "p": "mathlib"}, {"name": "add_submonoid.closure_closure_coe_preimage", "description": "", "p": "mathlib"}, {"name": "submonoid.distrib_mul_action", "description": "The action by a submonoid is the action by the underlying monoid.", "p": "mathlib"}, {"name": "add_submonoid.subtype", "description": "The natural monoid hom from an `add_submonoid` of `add_monoid` `M` to `M`.", "p": "mathlib"}, {"name": "submonoid.to_ordered_comm_monoid", "description": "A submonoid of an `ordered_comm_monoid` is an `ordered_comm_monoid`.", "p": "mathlib"}, {"name": "add_submonoid.map_strict_mono_of_injective", "description": "", "p": "mathlib"}, {"name": "monoid_hom.coe_mrange", "description": "", "p": "mathlib"}, {"name": "submonoid.gc_map_comap", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.mker_sum_map", "description": "", "p": "mathlib"}, {"name": "submonoid.comap_infi_map_of_injective", "description": "", "p": "mathlib"}, {"name": "submonoid.mrange_inr", "description": "", "p": "mathlib"}, {"name": "mul_equiv.of_left_inverse'", "description": " A monoid homomorphism `f : M \u2192* N` with a left-inverse `g : N \u2192 M` defines a multiplicative\nequivalence between `M` and `f.mrange`.\n\nThis is a bidirectional version of `monoid_hom.mrange_restrict`.", "p": "mathlib"}, {"name": "add_submonoid.top_equiv_symm_apply_coe", "description": "", "p": "mathlib"}, {"name": "add_submonoid.add_def", "description": "", "p": "mathlib"}, {"name": "submonoid.map_le_map_iff_of_injective", "description": "", "p": "mathlib"}, {"name": "add_submonoid_class.to_ordered_cancel_add_comm_monoid", "description": "An `add_submonoid` of an `ordered_cancel_add_comm_monoid` is\nan `ordered_cancel_add_comm_monoid`.", "p": "mathlib"}, {"name": "submonoid.comap_supr_map_of_injective", "description": "", "p": "mathlib"}, {"name": "add_submonoid.le_prod_iff", "description": "", "p": "mathlib"}, {"name": "add_submonoid.to_add_zero_class", "description": "An `add_submonoid` of an unital additive magma inherits an unital additive magma\nstructure.", "p": "mathlib"}, {"name": "submonoid.pow_mem", "description": "", "p": "mathlib"}, {"name": "submonoid.coe_map", "description": "", "p": "mathlib"}, {"name": "submonoid.mul_distrib_mul_action", "description": "The action by a submonoid is the action by the underlying monoid.", "p": "mathlib"}, {"name": "add_submonoid.comap_sup_map_of_injective", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.decidable_mem_mker", "description": "", "p": "mathlib"}, {"name": "add_submonoid.comap_le_comap_iff_of_surjective", "description": "", "p": "mathlib"}, {"name": "submonoid.prod_eq_top_iff", "description": "", "p": "mathlib"}, {"name": "submonoid.map_le_iff_le_comap", "description": "", "p": "mathlib"}, {"name": "mul_equiv.coe_submonoid_map_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.mem_mrange", "description": "", "p": "mathlib"}, {"name": "submonoid_class.to_comm_monoid", "description": "A submonoid of a `comm_monoid` is a `comm_monoid`.", "p": "mathlib"}, {"name": "monoid_hom.mem_mrange", "description": "", "p": "mathlib"}, {"name": "submonoid.le_comap_map", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.restrict_apply", "description": "", "p": "mathlib"}, {"name": "submonoid.inclusion", "description": "The monoid hom associated to an inclusion of submonoids.", "p": "mathlib"}, {"name": "add_monoid_hom.mker_inr", "description": "", "p": "mathlib"}, {"name": "submonoid_class.coe_pow", "description": "", "p": "mathlib"}, {"name": "submonoid.map_comap_le", "description": "", "p": "mathlib"}, {"name": "submonoid_class.subtype", "description": "The natural monoid hom from a submonoid of monoid `M` to `M`.", "p": "mathlib"}, {"name": "submonoid.map_map", "description": "", "p": "mathlib"}, {"name": "monoid_hom.mker_inr", "description": "", "p": "mathlib"}, {"name": "submonoid.map_sup", "description": "", "p": "mathlib"}, {"name": "submonoid.comap", "description": "The preimage of a submonoid along a monoid homomorphism is a submonoid.", "p": "mathlib"}, {"name": "add_submonoid.to_linear_ordered_cancel_add_comm_monoid", "description": "An `add_submonoid` of a `linear_ordered_cancel_add_comm_monoid` is\na `linear_ordered_cancel_add_comm_monoid`.", "p": "mathlib"}, {"name": "library_note.range copy pattern", "description": " For many categories (monoids, modules, rings, ...) the set-theoretic image of a morphism `f` is\na subobject of the codomain. When this is the case, it is useful to define the range of a morphism\nin such a way that the underlying carrier set of the range subobject is definitionally\n`set.range f`. In particular this means that the types `\u21a5(set.range f)` and `\u21a5f.range` are\ninterchangeable without proof obligations.\n\nA convenient candidate definition for range which is mathematically correct is `map \u22a4 f`, just as\n`set.range` could have been defined as `f '' set.univ`. However, this lacks the desired definitional\nconvenience, in that it both does not match `set.range`, and that it introduces a redudant `x \u2208 \u22a4`\nterm which clutters proofs. In such a case one may resort to the `copy`\npattern. A `copy` function converts the definitional problem for the carrier set of a subobject\ninto a one-off propositional proof obligation which one discharges while writing the definition of\nthe definitionally convenient range (the parameter `hs` in the example below).\n\nA good example is the case of a morphism of monoids. A convenient definition for\n`monoid_hom.mrange` would be `(\u22a4 : submonoid M).map f`. However since this lacks the required\ndefinitional convenience, we first define `submonoid.copy` as follows:\n```lean\nprotected def copy (S : submonoid M) (s : set M) (hs : s = S) : submonoid M :=\n{ carrier  := s,\n  one_mem' := hs.symm \u25b8 S.one_mem',\n  mul_mem' := hs.symm \u25b8 S.mul_mem' }\n```\nand then finally define:\n```lean\ndef mrange (f : M \u2192* N) : submonoid N :=\n((\u22a4 : submonoid M).map f).copy (set.range f) set.image_univ.symm\n```", "p": "mathlib"}, {"name": "add_submonoid.prod_equiv", "description": "The product of additive submonoids is isomorphic to their product\nas additive monoids", "p": "mathlib"}, {"name": "add_monoid_hom.coe_mrange_restrict", "description": "", "p": "mathlib"}, {"name": "submonoid.equiv_map_of_injective", "description": " A subgroup is isomorphic to its image under an injective function. If you have an isomorphism,\nuse `mul_equiv.submonoid_map` for better definitional equalities.", "p": "mathlib"}, {"name": "submonoid.to_add_submonoid_apply_coe", "description": "", "p": "mathlib"}, {"name": "submonoid.smul_def", "description": "", "p": "mathlib"}, {"name": "submonoid.to_ordered_cancel_comm_monoid", "description": "A submonoid of an `ordered_cancel_comm_monoid` is an `ordered_cancel_comm_monoid`.", "p": "mathlib"}, {"name": "add_submonoid.map_inl", "description": "", "p": "mathlib"}, {"name": "add_submonoid.comap", "description": "The preimage of an `add_submonoid` along an `add_monoid` homomorphism is an\n`add_submonoid`.", "p": "mathlib"}, {"name": "submonoid.to_add_submonoid_symm_apply_coe", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.comap_mker", "description": "", "p": "mathlib"}, {"name": "add_submonoid.bot_sum_bot", "description": "", "p": "mathlib"}, {"name": "add_submonoid.coe_nsmul", "description": "", "p": "mathlib"}, {"name": "monoid_hom.mker_prod_map", "description": "", "p": "mathlib"}, {"name": "submonoid.eq_bot_iff_forall", "description": "", "p": "mathlib"}, {"name": "add_submonoid.map_id", "description": "", "p": "mathlib"}, {"name": "add_submonoid.vadd_def", "description": "", "p": "mathlib"}, {"name": "monoid_hom.restrict_mrange", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.comap_bot'", "description": "", "p": "mathlib"}, {"name": "add_equiv.add_submonoid_map_symm_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.decidable_mem_mker", "description": "", "p": "mathlib"}, {"name": "add_submonoid.comap_surjective_of_injective", "description": "", "p": "mathlib"}, {"name": "submonoid.to_mul_one_class", "description": "A submonoid of a unital magma inherits a unital magma structure.", "p": "mathlib"}, {"name": "submonoid.subtype", "description": "The natural monoid hom from a submonoid of monoid `M` to `M`.", "p": "mathlib"}, {"name": "add_submonoid.top_prod_top", "description": "", "p": "mathlib"}, {"name": "add_submonoid.le_comap_map", "description": "", "p": "mathlib"}, {"name": "add_submonoid.coe_map", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.restrict_mker", "description": "", "p": "mathlib"}, {"name": "submonoid.mrange_snd", "description": "", "p