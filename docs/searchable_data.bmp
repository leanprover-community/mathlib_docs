: "mathlib"}, {"name": "eq_of_forall_edist_le", "description": "Two points coincide if their distance is `< \u03b5` for all positive \u03b5", "p": "mathlib"}, {"name": "emetric_space.replace_uniformity", "description": " Auxiliary function to replace the uniformity on an emetric space with\na uniformity which is equal to the original one, but maybe not defeq.\nThis is useful if one wants to construct an emetric space with a\nspecified uniformity. See Note [forgetful inheritance] explaining why having definitionally\nthe right uniformity is often important.", "p": "mathlib"}, {"name": "emetric.diam_closed_ball", "description": "", "p": "mathlib"}, {"name": "emetric.is_open_iff", "description": "", "p": "mathlib"}, {"name": "prod.edist_eq", "description": "", "p": "mathlib"}, {"name": "uniformity_basis_edist_nnreal_le", "description": "", "p": "mathlib"}, {"name": "ulift.emetric_space", "description": "", "p": "mathlib"}, {"name": "emetric.closed_ball_mem_nhds", "description": "", "p": "mathlib"}, {"name": "order_dual.pseudo_emetric_space", "description": "", "p": "mathlib"}, {"name": "finpartition.extend", "description": "Adds `b` to a finpartition of `a` to make a finpartition of `a \u2294 b`.", "p": "mathlib"}, {"name": "finpartition.unique", "description": "", "p": "mathlib"}, {"name": "finpartition.parts_eq_empty_iff", "description": "", "p": "mathlib"}, {"name": "finpartition.bind_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.le", "description": "", "p": "mathlib"}, {"name": "finpartition.has_le", "description": "We say that `P \u2264 Q` if `P` refines `Q`: each part of `P` is less than some part of `Q`.", "p": "mathlib"}, {"name": "finpartition.of_erase", "description": "A `finpartition` constructor which does not insist on `\u22a5` not being a part.", "p": "mathlib"}, {"name": "finpartition.extend_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.card_bind", "description": "", "p": "mathlib"}, {"name": "finpartition.inhabited", "description": "", "p": "mathlib"}, {"name": "is_atom.unique_finpartition", "description": "There's a unique partition of an atom.", "p": "mathlib"}, {"name": "finpartition.of_subset_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.decidable_eq", "description": "", "p": "mathlib"}, {"name": "finpartition.indiscrete_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.nonempty_of_mem_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.avoid", "description": "Restricts a finpartition to avoid a given element.", "p": "mathlib"}, {"name": "finpartition.atomise", "description": " Cuts `s` along the finsets in `F`: Two elements of `s` will be in the same part if they are\nin the same finsets of `F`.", "p": "mathlib"}, {"name": "finpartition.card_parts_le_card", "description": "", "p": "mathlib"}, {"name": "finpartition.card_extend", "description": "", "p": "mathlib"}, {"name": "finpartition.parts_nonempty", "description": "", "p": "mathlib"}, {"name": "finpartition.semilattice_inf", "description": "", "p": "mathlib"}, {"name": "finpartition.default_eq_empty", "description": "", "p": "mathlib"}, {"name": "finpartition.partial_order", "description": "", "p": "mathlib"}, {"name": "finpartition.card_bot", "description": "", "p": "mathlib"}, {"name": "finpartition.sum_card_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.ext_iff", "description": "", "p": "mathlib"}, {"name": "finpartition.card_filter_atomise_le_two_pow", "description": "", "p": "mathlib"}, {"name": "finpartition.of_erase_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.mem_avoid", "description": "", "p": "mathlib"}, {"name": "finpartition.avoid_parts_val", "description": "", "p": "mathlib"}, {"name": "finpartition.parts_inf", "description": "", "p": "mathlib"}, {"name": "finpartition.empty_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.mem_bot_iff", "description": "", "p": "mathlib"}, {"name": "finpartition.disjoint", "description": "", "p": "mathlib"}, {"name": "finpartition.indiscrete", "description": "The finpartition in one part, aka indiscrete finpartition.", "p": "mathlib"}, {"name": "finpartition.order_top", "description": "", "p": "mathlib"}, {"name": "finpartition.bUnion_filter_atomise", "description": "", "p": "mathlib"}, {"name": "finpartition.exists_le_of_le", "description": "", "p": "mathlib"}, {"name": "finpartition.copy", "description": "Changes the type of a finpartition to an equal one.", "p": "mathlib"}, {"name": "finpartition.parts_bot", "description": "", "p": "mathlib"}, {"name": "finpartition.of_subset", "description": "A `finpartition` constructor from a bigger existing finpartition.", "p": "mathlib"}, {"name": "finpartition.parts_top_subset", "description": "", "p": "mathlib"}, {"name": "finpartition.copy_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.has_inf", "description": "", "p": "mathlib"}, {"name": "finpartition.empty", "description": "The empty finpartition.", "p": "mathlib"}, {"name": "finpartition.card_atomise_le", "description": "", "p": "mathlib"}, {"name": "finpartition.ext", "description": "", "p": "mathlib"}, {"name": "finpartition.fintype", "description": "", "p": "mathlib"}, {"name": "finpartition.bUnion_parts", "description": "", "p": "mathlib"}, {"name": "finpartition.atomise_empty", "description": "", "p": "mathlib"}, {"name": "finpartition", "description": " A finite partition of `a : \u03b1` is a pairwise disjoint finite set of elements whose supremum is\n`a`. We forbid `\u22a5` as a part.", "p": "mathlib"}, {"name": "finpartition.parts", "description": " A finite partition of `a : \u03b1` is a pairwise disjoint finite set of elements whose supremum is\n`a`. We forbid `\u22a5` as a part.", "p": "mathlib"}, {"name": "finpartition.sup_indep", "description": " A finite partition of `a : \u03b1` is a pairwise disjoint finite set of elements whose supremum is\n`a`. We forbid `\u22a5` as a part.", "p": "mathlib"}, {"name": "finpartition.sup_parts", "description": " A finite partition of `a : \u03b1` is a pairwise disjoint finite set of elements whose supremum is\n`a`. We forbid `\u22a5` as a part.", "p": "mathlib"}, {"name": "finpartition.not_bot_mem", "description": " A finite partition of `a : \u03b1` is a pairwise disjoint finite set of elements whose supremum is\n`a`. We forbid `\u22a5` as a part.", "p": "mathlib"}, {"name": "finpartition.card_mono", "description": "", "p": "mathlib"}, {"name": "finpartition.bind", "description": " Given a finpartition `P` of `a` and finpartitions of each part of `P`, this yields the\nfinpartition of `a` obtained by juxtaposing all the subpartitions.", "p": "mathlib"}, {"name": "finpartition.parts_top_subsingleton", "description": "", "p": "mathlib"}, {"name": "finpartition.exists_mem", "description": "", "p": "mathlib"}, {"name": "finpartition.mem_bind", "description": "", "p": "mathlib"}, {"name": "finpartition.order_bot", "description": "", "p": "mathlib"}, {"name": "finpartition.parts_nonempty_iff", "description": "", "p": "mathlib"}, {"name": "finpartition.mem_atomise", "description": "", "p": "mathlib"}, {"name": "finpartition.ne_bot", "description": "", "p": "mathlib"}, {"name": "finpartition.has_bot", "description": "`\u22a5` is the partition in singletons, aka discrete partition.", "p": "mathlib"}, {"name": "set.preimage_bool_indicator_ff", "description": "", "p": "mathlib"}, {"name": "set.not_mem_iff_bool_indicator", "description": "", "p": "mathlib"}, {"name": "set.preimage_bool_indicator", "description": "", "p": "mathlib"}, {"name": "set.bool_indicator", "description": "`bool_indicator` maps `x` to `tt` if `x \u2208 s`, else to `ff`", "p": "mathlib"}, {"name": "set.preimage_bool_indicator_eq_union", "description": "", "p": "mathlib"}, {"name": "set.mem_iff_bool_indicator", "description": "", "p": "mathlib"}, {"name": "set.preimage_bool_indicator_tt", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.induction", "description": " To prove something for an arbitrary `Lp` simple function, with `0 < p < \u221e`, it suffices to show\nthat the property holds for (multiples of) characteristic functions of finite-measure measurable\nsets and is closed under addition (of functions with disjoint support).", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_Lp_sub", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func", "description": "`Lp.simple_func` is a subspace of Lp consisting of equivalence classes of an integrable simple\n   function.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_Lp", "description": "Construct the equivalence class `[f]` of a simple function `f` satisfying `mem_\u2112p`.", "p": "mathlib"}, {"name": "measure_theory.simple_func.integrable_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.tendsto_approx_on_L1_nnnorm", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.smul_to_simple_func", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.dense_embedding", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.sub_to_simple_func", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.has_bounded_smul", "description": " If `E` is a normed space, `Lp.simple_func E p \u03bc` is a normed space. Not declared as an\ninstance as it is (as of writing) used only in the construction of the Bochner integral.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.mem_\u2112p", "description": "`to_simple_func f` satisfies the predicate `mem_\u2112p`.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_Lp_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_Lp_eq_to_Lp", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_simple_func_eq_to_fun", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.coe_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.norm_approx_on_zero_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.mem_\u2112p_iff_fin_meas_supp", "description": "", "p": "mathlib"}, {"name": "measure_theory.integrable.induction", "description": " To prove something for an arbitrary integrable function in a normed group,\nit suffices to show that\n* the property holds for (multiples of) characteristic functions;\n* is closed under addition;\n* the set of functions in the `L\u00b9` space for which the property holds is closed.\n* the property is closed under the almost-everywhere equal relation.\n\nIt is possible to make the hypotheses in the induction steps a bit stronger, and such conditions\ncan be added once we need them (for example in `h_add` it is only necessary to consider the sum of\na simple function with a multiple of a characteristic function and that the intersection\nof their images is a subset of `{0}`).", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.norm_to_simple_func", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.ae_strongly_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.mem_\u2112p_approx_on_range", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.has_smul", "description": " If `E` is a normed space, `Lp.simple_func E p \u03bc` is a `has_smul`. Not declared as an\ninstance as it is (as of writing) used only in the construction of the Bochner integral.", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.induction", "description": " To prove something for an arbitrary `mem_\u2112p` function in a second countable\nBorel normed group, it suffices to show that\n* the property holds for (multiples of) characteristic functions;\n* is closed under addition;\n* the set of functions in the `L\u1d56` space for which the property holds is closed.\n* the property is closed under the almost-everywhere equal relation.\n\nIt is possible to make the hypotheses in the induction steps a bit stronger, and such conditions\ncan be added once we need them (for example in `h_add` it is only necessary to consider the sum of\na simple function with a multiple of a characteristic function and that the intersection\nof their images is a subset of `{0}`).", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.normed_space", "description": " If `E` is a normed space, `Lp.simple_func E p \u03bc` is a normed space. Not declared as an\ninstance as it is (as of writing) used only in the construction of the Bochner integral.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.uniform_embedding", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.eq'", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.dense_range", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.uniform_inducing", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.tendsto_approx_on_range_Lp", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.mem_\u2112p_iff_integrable", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_Lp_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.uniform_continuous", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.mem_\u2112p_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_Lp_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_Lp_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.norm_approx_on_y\u2080_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.integrable_pair", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_simple_func_to_Lp", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.exists_simple_func_snorm_sub_lt", "description": "Any function in `\u2112p` can be approximated by a simple function if `p < \u221e`.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_simple_func", "description": "Find a representative of a `Lp.simple_func`.", "p": "mathlib"}, {"name": "measure_theory.simple_func.nnnorm_approx_on_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.measure_preimage_lt_top_of_integrable", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.ae_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.tendsto_approx_on_Lp_snorm", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.induction_dense", "description": " If a set of ae strongly measurable functions is stable under addition and approximates\ncharacteristic functions in `\u2112p`, then it is dense in `\u2112p`.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.indicator_const", "description": "The characteristic function of a finite-measure measurable set `s`, as an `Lp` simple function.", "p": "mathlib"}, {"name": "measure_theory.simple_func.measure_preimage_lt_top_of_mem_\u2112p", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_Lp_eq_mk", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.measure_support_lt_top_of_integrable", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.mem_\u2112p_of_is_finite_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.measure_lt_top_of_mem_\u2112p_indicator", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.zero_to_simple_func", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.measurable", "description": "`(to_simple_func f)` is measurable.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.exists_simple_func_nonneg_ae_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.strongly_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.mem_\u2112p_approx_on", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.integrable_approx_on_range", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.mem_\u2112p_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.measure_support_lt_top_of_mem_\u2112p", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.mem_\u2112p_of_finite_measure_preimage", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_simple_func_indicator_const", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.integrable_iff_fin_meas_supp", "description": "", "p": "mathlib"}, {"name": "measure_theory.L1.simple_func.integrable", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.fin_meas_supp.integrable", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.coe_fn_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.L1.simple_func.to_Lp_one_eq_to_L1", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.mem_\u2112p_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.coe_fn_nonneg", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.to_Lp_to_simple_func", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.coe_simple_func_nonneg_to_Lp_nonneg", "description": "Coercion from nonnegative simple functions of Lp to nonnegative functions of Lp.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.dense_inducing", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.norm_to_Lp", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.add_to_simple_func", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.module", "description": " If `E` is a normed space, `Lp.simple_func E p \u03bc` is a module. Not declared as an\ninstance as it is (as of writing) used only in the construction of the Bochner integral.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.coe_to_Lp", "description": "The embedding of Lp simple functions into Lp functions, as a continuous linear map.", "p": "mathlib"}, {"name": "measure_theory.simple_func.exists_forall_norm_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.has_le.le.covariant_class", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.measure_support_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.dense_range_coe_simple_func_nonneg_to_Lp_nonneg", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.snorm'_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.coe_fn_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.integrable_of_is_finite_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.integrable_approx_on", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.tendsto_approx_on_range_L1_nnnorm", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.neg_to_simple_func", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.coe_indicator_const", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.induction", "description": " To prove something for an arbitrary `Lp` function in a second countable Borel normed group, it\nsuffices to show that\n* the property holds for (multiples of) characteristic functions;\n* is closed under addition;\n* the set of functions in `Lp` for which the property holds is closed.", "p": "mathlib"}, {"name": "measure_theory.Lp.simple_func.coe_coe", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.tendsto_approx_on_range_Lp_snorm", "description": "", "p": "mathlib"}, {"name": "has_compact_support.convolution_exists_left_of_continuous_right", "description": "", "p": "mathlib"}, {"name": "convolution_smul", "description": "", "p": "mathlib"}, {"name": "has_compact_support.convolution_exists_at", "description": "", "p": "mathlib"}, {"name": "has_compact_support.has_fderiv_at_convolution_right", "description": " Compute the total derivative of `f \u22c6 g` if `g` is `C^1` with compact support and `f` is locally\nintegrable. To write down the total derivative as a convolution, we use\n`continuous_linear_map.precompR`.", "p": "mathlib"}, {"name": "measure_theory.integrable.convolution_integrand", "description": "", "p": "mathlib"}, {"name": "integral_convolution", "description": "", "p": "mathlib"}, {"name": "has_compact_support.convolution_integrand_bound_left", "description": "", "p": "mathlib"}, {"name": "has_compact_support.convolution_integrand_bound_right", "description": "", "p": "mathlib"}, {"name": "has_compact_support.cont_diff_convolution_right", "description": "", "p": "mathlib"}, {"name": "has_compact_support.convolution", "description": "", "p": "mathlib"}, {"name": "convolution_exists_at_iff_integrable_swap", "description": "", "p": "mathlib"}, {"name": "convolution_exists_at", "description": " The convolution of `f` and `g` exists at `x` when the function `t \u21a6 L (f t) (g (x - t))` is\nintegrable. There are various conditions on `f` and `g` to prove this.", "p": "mathlib"}, {"name": "convolution_tendsto_right", "description": " `(\u03c6 i \u22c6 g i) (k i)` tends to `z\u2080` as `i` tends to some filter `l` if\n* `\u03c6` is a sequence of nonnegative functions with integral `1` as `i` tends to `l`;\n* The support of `\u03c6` tends to small neighborhoods around `(0 : G)` as `i` tends to `l`;\n* `g i` is `mu`-a.e. strongly measurable as `i` tends to `l`;\n* `g i x` tends to `z\u2080` as `(i, x)` tends to `l \u00d7\u1da0 \ud835\udcdd x\u2080`;\n* `k i` tends to `x\u2080`.\n\nSee also `cont_diff_bump.convolution_tendsto_right`.", "p": "mathlib"}, {"name": "cont_diff_bump.convolution_eq_right", "description": "If `\u03c6` is a bump function, compute `(\u03c6 \u22c6 g) x\u2080` if `g` is constant on `metric.ball x\u2080 \u03c6.R`.", "p": "mathlib"}, {"name": "convolution_exists.distrib_add", "description": "", "p": "mathlib"}, {"name": "pos_convolution", "description": " The forward convolution of two functions `f` and `g` on `\u211d`, with respect to a continuous\nbilinear map `L` and measure `\u03bd`. It is defined to be the function mapping `x` to\n`\u222b t in 0..x, L (f t) (g (x - t)) \u2202\u03bd` if `0 < x`, and 0 otherwise.", "p": "mathlib"}, {"name": "convolution_lsmul", "description": " The definition of convolution where the bilinear operator is scalar multiplication.\nNote: it often helps the elaborator to give the type of the convolution explicitly.", "p": "mathlib"}, {"name": "cont_diff_on_convolution_left_with_param_comp", "description": " The convolution `g * f` is `C^n` when `f` is locally integrable and `g` is `C^n` and compactly\nsupported. Version where `g` depends on an additional parameter in an open subset `s` of a\nparameter space `P` (and the compact support `k` is independent of the parameter in `s`),\ngiven in terms of composition with additional smooth functions.", "p": "mathlib"}, {"name": "dist_convolution_le'", "description": " Approximate `(f \u22c6 g) x\u2080` if the support of the `f` is bounded within a ball, and `g` is near\n`g x\u2080` on a ball with the same radius around `x\u2080`. See `dist_convolution_le` for a special case.\n\nWe can simplify the second argument of `dist` further if we add some extra type-classes on `E`\nand `\ud835\udd5c` or if `L` is scalar multiplication.", "p": "mathlib"}, {"name": "convolution_exists_at.integrable", "description": "", "p": "mathlib"}, {"name": "convolution_lsmul_swap", "description": "The symmetric definition of convolution where the bilinear operator is scalar multiplication.", "p": "mathlib"}, {"name": "continuous.convolution_integrand_fst", "description": "", "p": "mathlib"}, {"name": "convolution_exists", "description": " The convolution of `f` and `g` exists when the function `t \u21a6 L (f t) (g (x - t))` is integrable\nfor all `x : G`. There are various conditions on `f` and `g` to prove this.", "p": "mathlib"}, {"name": "support_convolution_subset_swap", "description": "", "p": "mathlib"}, {"name": "bdd_above.convolution_exists_at'", "description": " A sufficient condition to prove that `f \u22c6[L, \u03bc] g` exists.\nWe assume that `f` is integrable on a set `s` and `g` is bounded and ae strongly measurable\non `x\u2080 - s` (note that both properties hold if `g` is continuous with compact support).", "p": "mathlib"}, {"name": "convolution", "description": " The convolution of two functions `f` and `g` with respect to a continuous bilinear map `L` and\nmeasure `\u03bc`. It is defined to be `(f \u22c6[L, \u03bc] g) x = \u222b t, L (f t) (g (x - t)) \u2202\u03bc`.", "p": "mathlib"}, {"name": "convolution_exists_at.of_norm", "description": "If `\u2016f\u2016 *[\u03bc] \u2016g\u2016` exists, then `f *[L, \u03bc] g` exists.", "p": "mathlib"}, {"name": "dist_convolution_le", "description": " Approximate `f \u22c6 g` if the support of the `f` is bounded within a ball, and `g` is near `g x\u2080`\non a ball with the same radius around `x\u2080`.\n\nThis is a special case of `dist_convolution_le'` where `L` is `(\u2022)`, `f` has integral 1 and `f` is\nnonnegative.", "p": "mathlib"}, {"name": "has_compact_support.convolution_exists_right", "description": "", "p": "mathlib"}, {"name": "has_compact_support.has_fderiv_at_convolution_left", "description": "", "p": "mathlib"}, {"name": "has_compact_support.convolution_exists_left", "description": "", "p": "mathlib"}, {"name": "has_compact_support.continuous_convolution_right", "description": " The convolution is continuous if one function is locally integrable and the other has compact\nsupport and is continuous.", "p": "mathlib"}, {"name": "convolution_mul_swap", "description": "The symmetric definition of convolution where the bilinear operator is multiplication.", "p": "mathlib"}, {"name": "convolution_mono_right", "description": "", "p": "mathlib"}, {"name": "cont_diff_on_convolution_left_with_param", "description": " The convolution `g * f` is `C^n` when `f` is locally integrable and `g` is `C^n` and compactly\nsupported. Version where `g` depends on an additional parameter in an open subset `s` of a\nparameter space `P` (and the compact support `k` is independent of the parameter in `s`).", "p": "mathlib"}, {"name": "convolution_exists_at.distrib_add", "description": "", "p": "mathlib"}, {"name": "continuous_on_convolution_right_with_param_comp'", "description": " The convolution `f * g` is continuous if `f` is locally integrable and `g` is continuous and\ncompactly supported. Version where `g` depends on an additional parameter in an open subset `s` of\na parameter space `P` (and the compact support `k` is independent of the parameter in `s`),\ngiven in terms of compositions with an additional continuous map.\nVersion not assuming `t2_space G`.", "p": "mathlib"}, {"name": "convolution_assoc", "description": " Convolution is associative. This requires that\n* all maps are a.e. strongly measurable w.r.t one of the measures\n* `f \u22c6[L, \u03bd] g` exists almost everywhere\n* `\u2016g\u2016 \u22c6[\u03bc] \u2016k\u2016` exists almost everywhere\n* `\u2016f\u2016 \u22c6[\u03bd] (\u2016g\u2016 \u22c6[\u03bc] \u2016k\u2016)` exists at `x\u2080`", "p": "mathlib"}, {"name": "support_convolution_subset", "description": "", "p": "mathlib"}, {"name": "convolution_exists_at.of_norm'", "description": "If `\u2016f\u2016 *[\u03bc] \u2016g\u2016` exists, then `f *[L, \u03bc] g` exists.", "p": "mathlib"}, {"name": "has_compact_support.continuous_convolution_left", "description": "", "p": "mathlib"}, {"name": "continuous_on_convolution_right_with_param", "description": " The convolution `f * g` is continuous if `f` is locally integrable and `g` is continuous and\ncompactly supported. Version where `g` depends on an additional parameter in a subset `s` of\na parameter space `P` (and the compact support `k` is independent of the parameter in `s`).", "p": "mathlib"}, {"name": "convolution_def", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.convolution_integrand_swap_snd", "description": "", "p": "mathlib"}, {"name": "measure_theory.integrable.ae_convolution_exists", "description": "", "p": "mathlib"}, {"name": "has_compact_support.cont_diff_convolution_left", "description": "", "p": "mathlib"}, {"name": "convolution_zero", "description": "", "p": "mathlib"}, {"name": "convolution_eq_right'", "description": " Compute `(f \u22c6 g) x\u2080` if the support of the `f` is within `metric.ball 0 R`, and `g` is constant\non `metric.ball x\u2080 R`.\n\nWe can simplify the RHS further if we assume `f` is integrable, but also if `L = (\u2022)` or more\ngenerally if `L` has a `antilipschitz_with`-condition.", "p": "mathlib"}, {"name": "zero_convolution", "description": "", "p": "mathlib"}, {"name": "bdd_above.continuous_convolution_right_of_integrable", "description": " The convolution is continuous if one function is integrable and the other is bounded and\ncontinuous.", "p": "mathlib"}, {"name": "convolution_precompR_apply", "description": "", "p": "mathlib"}, {"name": "convolution_integrand_bound_right_of_le_of_subset", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.convolution_tendsto_right_of_continuous", "description": "Special case of `cont_diff_bump.convolution_tendsto_right` where `g` is continuous,\n and the limit is taken only in the first function.", "p": "mathlib"}, {"name": "convolution_exists.add_distrib", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.convolution_integrand_snd", "description": "", "p": "mathlib"}, {"name": "has_fderiv_at_convolution_right_with_param", "description": " The derivative of the convolution `f * g` is given by `f * Dg`, when `f` is locally integrable\nand `g` is `C^1` and compactly supported. Version where `g` depends on an additional parameter in an\nopen subset `s` of a parameter space `P` (and the compact support `k` is independent of the\nparameter in `s`).", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.convolution_integrand_snd'", "description": "", "p": "mathlib"}, {"name": "has_compact_support.has_deriv_at_convolution_right", "description": "", "p": "mathlib"}, {"name": "convolution_congr", "description": "", "p": "mathlib"}, {"name": "continuous_on_convolution_right_with_param_comp", "description": " The convolution `f * g` is continuous if `f` is locally integrable and `g` is continuous and\ncompactly supported. Version where `g` depends on an additional parameter in an open subset `s` of\na parameter space `P` (and the compact support `k` is independent of the parameter in `s`),\ngiven in terms of compositions with an additional continuous map.", "p": "mathlib"}, {"name": "measure_theory.integrable.integrable_convolution", "description": "", "p": "mathlib"}, {"name": "convolution_exists_at.add_distrib", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.normed_convolution_eq_right", "description": "If `\u03c6` is a normed bump function, compute `\u03c6 \u22c6 g` if `g` is constant on `metric.ball x\u2080 \u03c6.R`.", "p": "mathlib"}, {"name": "pos_convolution_eq_convolution_indicator", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.convolution_integrand'", "description": "", "p": "mathlib"}, {"name": "cont_diff_on_convolution_right_with_param", "description": " The convolution `f * g` is `C^n` when `f` is locally integrable and `g` is `C^n` and compactly\nsupported. Version where `g` depends on an additional parameter in an open subset `s` of a\nparameter space `P` (and the compact support `k` is independent of the parameter in `s`).", "p": "mathlib"}, {"name": "continuous_on_convolution_right_with_param'", "description": " The convolution `f * g` is continuous if `f` is locally integrable and `g` is continuous and\ncompactly supported. Version where `g` depends on an additional parameter in a subset `s` of\na parameter space `P` (and the compact support `k` is independent of the parameter in `s`),\nnot assuming `t2_space G`.", "p": "mathlib"}, {"name": "cont_diff_bump.dist_normed_convolution_le", "description": " If `\u03c6` is a normed bump function, approximate `(\u03c6 \u22c6 g) x\u2080` if `g` is near `g x\u2080` on a ball with\nradius `\u03c6.R` around `x\u2080`.", "p": "mathlib"}, {"name": "integrable_pos_convolution", "description": "", "p": "mathlib"}, {"name": "convolution_mono_right_of_nonneg", "description": "", "p": "mathlib"}, {"name": "has_compact_support.convolution_exists_right_of_continuous_left", "description": "", "p": "mathlib"}, {"name": "convolution_exists_at_flip", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.convolution_integrand_swap_snd'", "description": "", "p": "mathlib"}, {"name": "integral_pos_convolution", "description": " The integral over `Ioi 0` of a forward convolution of two functions is equal to the product\nof their integrals over this set. (Compare `integral_convolution` for the two-sided convolution.)", "p": "mathlib"}, {"name": "cont_diff_bump.convolution_tendsto_right", "description": " `(\u03c6 i \u22c6 g i) (k i)` tends to `z\u2080` as `i` tends to some filter `l` if\n* `\u03c6` is a sequence of normed bump functions such that `(\u03c6 i).R` tends to `0` as `i` tends to `l`;\n* `g i` is `mu`-a.e. strongly measurable as `i` tends to `l`;\n* `g i x` tends to `z\u2080` as `(i, x)` tends to `l \u00d7\u1da0 \ud835\udcdd x\u2080`;\n* `k i` tends to `x\u2080`.", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.convolution_integrand", "description": "", "p": "mathlib"}, {"name": "cont_diff_on_convolution_right_with_param_comp", "description": " The convolution `f * g` is `C^n` when `f` is locally integrable and `g` is `C^n` and compactly\nsupported. Version where `g` depends on an additional parameter in an open subset `s` of a\nparameter space `P` (and the compact support `k` is independent of the parameter in `s`),\ngiven in terms of composition with an additional smooth function.", "p": "mathlib"}, {"name": "convolution_neg_of_neg_eq", "description": "The convolution of two even functions is also even.", "p": "mathlib"}, {"name": "convolution_exists_at.integrable_swap", "description": "", "p": "mathlib"}, {"name": "convolution_flip", "description": "Commutativity of convolution", "p": "mathlib"}, {"name": "has_compact_support.convolution_integrand_bound_right_of_subset", "description": "", "p": "mathlib"}, {"name": "cont_diff_on_convolution_right_with_param_aux", "description": " The convolution `f * g` is `C^n` when `f` is locally integrable and `g` is `C^n` and compactly\nsupported. Version where `g` depends on an additional parameter in an open subset `s` of a\nparameter space `P` (and the compact support `k` is independent of the parameter in `s`).\nIn this version, all the types belong to the same universe (to get an induction working in the\nproof). Use instead `cont_diff_on_convolution_right_with_param`, which removes this restriction.", "p": "mathlib"}, {"name": "bdd_above.continuous_convolution_left_of_integrable", "description": "", "p": "mathlib"}, {"name": "bdd_above.convolution_exists_at", "description": " A sufficient condition to prove that `f \u22c6[L, \u03bc] g` exists.\nWe assume that the integrand has compact support and `g` is bounded on this support (note that\nboth properties hold if `g` is continuous with compact support). We also require that `f` is\nintegrable on the support of the integrand, and that both functions are strongly measurable.\n\nThis is a variant of `bdd_above.convolution_exists_at'` in an abelian group with a left-invariant\nmeasure. This allows us to state the boundedness and measurability of `g` in a more natural way.", "p": "mathlib"}, {"name": "convolution_mul", "description": "The definition of convolution where the bilinear operator is multiplication.", "p": "mathlib"}, {"name": "smul_convolution", "description": "", "p": "mathlib"}, {"name": "convolution_eq_swap", "description": "The symmetric definition of convolution.", "p": "mathlib"}, {"name": "convolution_assoc'", "description": " Convolution is associative. This has a weak but inconvenient integrability condition.\nSee also `convolution_assoc`.", "p": "mathlib"}, {"name": "has_compact_support.has_deriv_at_convolution_left", "description": "", "p": "mathlib"}, {"name": "lp_submodule", "description": " The `\ud835\udd5c`-submodule of elements of `\u03a0 i : \u03b1, E i` whose `lp` norm is finite.  This is `lp E p`,\nwith extra structure.", "p": "mathlib"}, {"name": "lp.has_norm", "description": "", "p": "mathlib"}, {"name": "lp.mem_lp_const_smul", "description": "", "p": "mathlib"}, {"name": "lp.single_apply", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p_gen_iff", "description": "", "p": "mathlib"}, {"name": "lp.norm_one_class", "description": "", "p": "mathlib"}, {"name": "lp.has_sum_single", "description": " The canonical finitely-supported approximations to an element `f` of `lp` converge to it, in the\n`lp` topology.", "p": "mathlib"}, {"name": "lp.sum_rpow_le_norm_rpow", "description": "", "p": "mathlib"}, {"name": "lp.mem_\u2113p", "description": "", "p": "mathlib"}, {"name": "lp.infty_normed_comm_ring", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.add", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.bdd_above", "description": "", "p": "mathlib"}, {"name": "lp.norm_le_of_forall_sum_le", "description": "", "p": "mathlib"}, {"name": "nat_cast_mem_\u2113p_infty", "description": "", "p": "mathlib"}, {"name": "lp.ext", "description": "", "p": "mathlib"}, {"name": "lp.normed_space", "description": "", "p": "mathlib"}, {"name": "lp.infty_normed_ring", "description": "", "p": "mathlib"}, {"name": "lp.summable_mul", "description": "", "p": "mathlib"}, {"name": "lp.normed_star_group", "description": "", "p": "mathlib"}, {"name": "lp.pre_lp.smul_comm_class", "description": "", "p": "mathlib"}, {"name": "lp.norm_single", "description": "", "p": "mathlib"}, {"name": "lp.single_apply_ne", "description": "", "p": "mathlib"}, {"name": "lp.non_unital_ring", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.of_exponent_ge", "description": "", "p": "mathlib"}, {"name": "lp.norm_eq_csupr", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.finite_dsupport", "description": "", "p": "mathlib"}, {"name": "lp.single_smul", "description": "", "p": "mathlib"}, {"name": "lp.infty_coe_fn_pow", "description": "", "p": "mathlib"}, {"name": "lp.norm_neg", "description": "", "p": "mathlib"}, {"name": "lp.norm_sum_single", "description": "", "p": "mathlib"}, {"name": "lp.norm_eq_tsum_rpow", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.infty_pow", "description": "", "p": "mathlib"}, {"name": "lp.coe_fn_neg", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p_zero", "description": "", "p": "mathlib"}, {"name": "int_cast_mem_\u2113p_infty", "description": "", "p": "mathlib"}, {"name": "lp.coe_fn_star", "description": "", "p": "mathlib"}, {"name": "lp.infty_normed_algebra", "description": "", "p": "mathlib"}, {"name": "lp.mem_\u2113p_of_tendsto", "description": "If `f` is the pointwise limit of a bounded sequence in `lp E p`, then `f` is in `lp E p`.", "p": "mathlib"}, {"name": "lp.infty_coe_fn_int_cast", "description": "", "p": "mathlib"}, {"name": "lp.coe_fn_add", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.const_smul", "description": "", "p": "mathlib"}, {"name": "lp.eq_zero'", "description": "", "p": "mathlib"}, {"name": "lp.has_star", "description": "", "p": "mathlib"}, {"name": "lp.infty_cstar_ring", "description": "", "p": "mathlib"}, {"name": "lp.has_mul", "description": "", "p": "mathlib"}, {"name": "lp.eq_zero_iff_coe_fn_eq_zero", "description": "", "p": "mathlib"}, {"name": "lp.ext_iff", "description": "", "p": "mathlib"}, {"name": "lp.star_module", "description": "", "p": "mathlib"}, {"name": "lp.pi.has_coe", "description": "", "p": "mathlib"}, {"name": "lp.infty_comm_ring", "description": "", "p": "mathlib"}, {"name": "lp.tsum_mul_le_mul_norm", "description": "H\u00f6lder inequality", "p": "mathlib"}, {"name": "lp.norm_const_smul", "description": "", "p": "mathlib"}, {"name": "lp.complete_space", "description": "", "p": "mathlib"}, {"name": "pre_lp.algebra", "description": "", "p": "mathlib"}, {"name": "lp.single", "description": "The element of `lp E p` which is `a : E i` at the index `i`, and zero elsewhere.", "p": "mathlib"}, {"name": "pre_lp.add_comm_group", "description": "", "p": "mathlib"}, {"name": "pre_lp.ring", "description": "", "p": "mathlib"}, {"name": "one_mem_\u2113p_infty", "description": "", "p": "mathlib"}, {"name": "lp.non_unital_normed_ring", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p_gen'", "description": "", "p": "mathlib"}, {"name": "lp.infty_star_ring", "description": "", "p": "mathlib"}, {"name": "lp.normed_add_comm_group", "description": "", "p": "mathlib"}, {"name": "lp.pre_lp.is_central_scalar", "description": "", "p": "mathlib"}, {"name": "lp.norm_compl_sum_single", "description": "", "p": "mathlib"}, {"name": "lp.norm_sub_norm_compl_sub_single", "description": "", "p": "mathlib"}, {"name": "lp.norm_const_smul_le", "description": "", "p": "mathlib"}, {"name": "lp.infty_ring", "description": "", "p": "mathlib"}, {"name": "lp.infty_coe_fn_one", "description": "", "p": "mathlib"}, {"name": "lp.smul_comm_class", "description": "", "p": "mathlib"}, {"name": "lp.has_involutive_star", "description": "", "p": "mathlib"}, {"name": "lp.star_add_monoid", "description": "", "p": "mathlib"}, {"name": "lp.is_lub_norm", "description": "", "p": "mathlib"}, {"name": "lp.single_apply_self", "description": "", "p": "mathlib"}, {"name": "lp.coe_lp_submodule", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p_infty_iff", "description": "", "p": "mathlib"}, {"name": "lp_infty_subalgebra", "description": " The `\ud835\udd5c`-subalgebra of elements of `\u03a0 i : \u03b1, B i` whose `lp` norm is finite. This is `lp E \u221e`,\nwith extra structure.", "p": "mathlib"}, {"name": "lp.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.star_iff", "description": "", "p": "mathlib"}, {"name": "lp.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "lp.star_apply", "description": "", "p": "mathlib"}, {"name": "lp_infty_subring", "description": " The `\ud835\udd5c`-subring of elements of `\u03a0 i : \u03b1, B i` whose `lp` norm is finite. This is `lp E \u221e`,\nwith extra structure.", "p": "mathlib"}, {"name": "lp.norm_zero", "description": "", "p": "mathlib"}, {"name": "lp.norm_le_of_tsum_le", "description": "", "p": "mathlib"}, {"name": "lp.norm_nonneg'", "description": "", "p": "mathlib"}, {"name": "lp.has_sum_norm", "description": "", "p": "mathlib"}, {"name": "algebra_map_mem_\u2113p_infty", "description": "", "p": "mathlib"}, {"name": "lp.pre_lp.module", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.sub", "description": "", "p": "mathlib"}, {"name": "lp.coe_fn_sub", "description": "", "p": "mathlib"}, {"name": "lp.norm_eq_card_dsupport", "description": "", "p": "mathlib"}, {"name": "lp.single_neg", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.neg", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.star_mem", "description": "", "p": "mathlib"}, {"name": "lp.coe_fn_zero", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p", "description": " The property that `f : \u03a0 i : \u03b1, E i`\n* is finitely supported, if `p = 0`, or\n* admits an upper bound for `set.range (\u03bb i, \u2016f i\u2016)`, if `p = \u221e`, or\n* has the series `\u2211' i, \u2016f i\u2016 ^ p` be summable, if `0 < p < \u221e`.", "p": "mathlib"}, {"name": "lp.module", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.const_mul", "description": "", "p": "mathlib"}, {"name": "lp.coe_fn_sum", "description": "", "p": "mathlib"}, {"name": "lp.norm_apply_le_of_tendsto", "description": "", "p": "mathlib"}, {"name": "lp.infty_is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "lp.monotone", "description": "", "p": "mathlib"}, {"name": "lp.infty_coe_fn_nat_cast", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.neg_iff", "description": "", "p": "mathlib"}, {"name": "lp.sum_rpow_le_of_tendsto", "description": "", "p": "mathlib"}, {"name": "pre_lp.unique", "description": "", "p": "mathlib"}, {"name": "lp.has_bounded_smul", "description": "", "p": "mathlib"}, {"name": "lp.infty_smul_comm_class", "description": "", "p": "mathlib"}, {"name": "lp.tendsto_lp_of_tendsto_pi", "description": " If a sequence is Cauchy in the `lp E p` topology and pointwise convergent to a element `f` of\n`lp E p`, then it converges to `f` in the `lp E p` topology.", "p": "mathlib"}, {"name": "lp.tsum_mul_le_mul_norm'", "description": "", "p": "mathlib"}, {"name": "lp.norm_rpow_eq_tsum", "description": "", "p": "mathlib"}, {"name": "lp.norm_le_of_tendsto", "description": "\"Semicontinuity of the `lp` norm\": If all sufficiently large elements of a sequence in `lp E p`\nhave `lp` norm `\u2264 C`, then the pointwise limit, if it exists, also has `lp` norm `\u2264 C`.", "p": "mathlib"}, {"name": "lp.norm_le_of_forall_le'", "description": "", "p": "mathlib"}, {"name": "pi.algebra_of_normed_algebra", "description": "A variant of `pi.algebra` that lean can't find otherwise.", "p": "mathlib"}, {"name": "mem_\u2113p_infty", "description": "", "p": "mathlib"}, {"name": "pre_lp", "description": " We define `pre_lp E` to be a type synonym for `\u03a0 i, E i` which, importantly, does not inherit\nthe `pi` topology on `\u03a0 i, E i` (otherwise this topology would descend to `lp E p` and conflict\nwith the normed group topology we will later equip it with.)\n\nWe choose to deal with this issue by making a type synonym for `\u03a0 i, E i` rather than for the `lp`\nsubgroup itself, because this allows all the spaces `lp E p` (for varying `p`) to be subgroups of\nthe same ambient group, which permits lemma statements like `lp.monotone` (below).", "p": "mathlib"}, {"name": "zero_mem_\u2113p", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p_zero_iff", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.infty_mul", "description": "", "p": "mathlib"}, {"name": "lp", "description": "lp space", "p": "mathlib"}, {"name": "lp.norm_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "lp.pre_lp.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "lp.norm_le_of_forall_le", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.finset_sum", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p_gen", "description": "", "p": "mathlib"}, {"name": "lp.is_central_scalar", "description": "", "p": "mathlib"}, {"name": "zero_mem_\u2113p'", "description": "", "p": "mathlib"}, {"name": "lp.coe_fn_smul", "description": "", "p": "mathlib"}, {"name": "lp.infty_coe_fn_mul", "description": "", "p": "mathlib"}, {"name": "lp.norm_apply_le_norm", "description": "", "p": "mathlib"}, {"name": "mem_\u2113p.summable", "description": "", "p": "mathlib"}, {"name": "lp.uniform_continuous_coe", "description": "The coercion from `lp E p` to `\u03a0 i, E i` is uniformly continuous.", "p": "mathlib"}, {"name": "measure_theory.adapted.integrable_upcrossings_before", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossing_strat_nonneg", "description": "", "p": "mathlib"}, {"name": "measure_theory.adapted.measurable_upcrossings", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings_before_eq_sum", "description": "", "p": "mathlib"}, {"name": "measure_theory.mul_integral_upcrossings_before_le_integral_pos_part_aux", "description": "", "p": "mathlib"}, {"name": "measure_theory.stopped_value_lower_crossing_time", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_lt_of_le_upcrossings_before", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.mul_lintegral_upcrossings_le_lintegral_pos_part", "description": "A variant of Doob's upcrossing estimate obtained by taking the supremum on both sides.", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_succ_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.adapted.is_stopping_time_crossing", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_lt_succ", "description": "", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings_before_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_eq_upper_crossing_time_of_lt", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings_before_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time_stabilize", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.sum_mul_upcrossing_strat_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.sum_sub_upcrossing_strat_mul", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_succ", "description": "", "p": "mathlib"}, {"name": "measure_theory.mul_upcrossings_before_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings_before", "description": "The number of upcrossings (strictly) before time `N`.", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_bound_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_zero'", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings_before_zero'", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_lt_nonempty", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossing_strat", "description": " `upcrossing_strat a b f N n` is 1 if `n` is between a consecutive pair of lower and upper\ncrossings and is 0 otherwise. `upcrossing_strat` is shifted by one index so that it is adapted\nrather than predictable.", "p": "mathlib"}, {"name": "measure_theory.crossing_eq_crossing_of_upper_crossing_time_lt", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time", "description": " `upper_crossing_time a b f N n` is the first time before time `N`, `f` reaches\nabove `b` after `f` reached below `a` for the `n - 1`-th time.", "p": "mathlib"}, {"name": "measure_theory.crossing_pos_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossing_strat_le_one", "description": "", "p": "mathlib"}, {"name": "measure_theory.adapted.upcrossing_strat_adapted", "description": "", "p": "mathlib"}, {"name": "measure_theory.integral_mul_upcrossings_before_le_integral", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings_lt_top_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_lt_bdd_above", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.mul_integral_upcrossings_before_le_integral_pos_part", "description": " **Doob's upcrossing estimate**: given a real valued discrete submartingale `f` and real\nvalues `a` and `b`, we have `(b - a) * \ud835\udd3c[upcrossings_before a b f N] \u2264 \ud835\udd3c[(f N - a)\u207a]` where\n`upcrossings_before a b f N` is the number of times the process `f` crossed from below `a` to above\n`b` before the time `N`.", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_eq_of_bound_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.sub_eq_zero_of_upcrossings_before_lt", "description": "", "p": "mathlib"}, {"name": "measure_theory.adapted.is_stopping_time_lower_crossing_time", "description": "", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time", "description": " `lower_crossing_time a b f N n` is the first time before time `N`, `f` reaches\nbelow `a` after `f` reached above `b` for the `n`-th time.", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time_stabilize'", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_upper_crossing_time_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.crossing_eq_crossing_of_lower_crossing_time_lt", "description": "", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time_lt_of_lt_upcrossings_before", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_stabilize'", "description": "", "p": "mathlib"}, {"name": "measure_theory.le_sub_of_le_upcrossings_before", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings_before_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time_le_upper_crossing_time_succ", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings_before_pos_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_eq_of_upcrossings_before_lt", "description": "", "p": "mathlib"}, {"name": "measure_theory.adapted.measurable_upcrossings_before", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.sum_upcrossing_strat_mul", "description": "", "p": "mathlib"}, {"name": "measure_theory.adapted.is_stopping_time_upper_crossing_time", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time_lt_upper_crossing_time", "description": "", "p": "mathlib"}, {"name": "measure_theory.stopped_value_upper_crossing_time", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings_before_lt_of_exists_upcrossing", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_lt_lower_crossing_time", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_stabilize", "description": "", "p": "mathlib"}, {"name": "measure_theory.upper_crossing_time_le_lower_crossing_time", "description": "", "p": "mathlib"}, {"name": "measure_theory.upcrossings", "description": " The number of upcrossings of a realization of a stochastic process (`upcrossing` takes value\nin `\u211d\u22650\u221e` and so is allowed to be `\u221e`).", "p": "mathlib"}, {"name": "measure_theory.lower_crossing_time_aux", "description": " `lower_crossing_time_aux a f c N` is the first time `f` reached below `a` after time `c` before\ntime `N`.", "p": "mathlib"}, {"name": "measure_theory.upcrossings_before_bot", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.to_subtype_range", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.eq_zero_of_aeval_eq_zero", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.restrict_scalars", "description": " A set of algebraically independent elements in an algebra `A` over a ring `K` is also\nalgebraically independent over a subring `R` of `K`.", "p": "mathlib"}, {"name": "algebraic_independent.mv_polynomial_option_equiv_polynomial_adjoin_X_none", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_empty", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.mono", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.image_of_comp", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.repr", "description": "The canonical map from the subalgebra generated by an algebraic independent family\n into the polynomial ring.", "p": "mathlib"}, {"name": "algebraic_independent.ne_zero", "description": "", "p": "mathlib"}, {"name": "exists_maximal_algebraic_independent", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.mv_polynomial_option_equiv_polynomial_adjoin", "description": " The isomorphism between `mv_polynomial (option \u03b9) R` and the polynomial ring over\nthe algebra generated by an algebraically independent family.", "p": "mathlib"}, {"name": "algebraic_independent.algebra_map_aeval_equiv", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.algebra_map_injective", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.aeval_repr", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.injective", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.comp", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.option_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_finset_map_embedding_subtype", "description": "Every finite subset of an algebraically independent set is algebraically independent.", "p": "mathlib"}, {"name": "algebraic_independent.aeval_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.aeval_comp_repr", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.of_comp", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_adjoin", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.linear_independent", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_empty_type", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.map", "description": "", "p": "mathlib"}, {"name": "is_transcendence_basis", "description": "A family is a transcendence basis if it is a maximal algebraically independent subset.", "p": "mathlib"}, {"name": "algebraic_independent_Union_of_directed", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.map'", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_iff_injective_aeval", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.to_subtype_range'", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_comp_subtype", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.is_transcendence_basis_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.coe_range", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_empty_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.of_subtype_range", "description": "**Alias** of the forward direction of `algebraic_independent_subtype_range`.", "p": "mathlib"}, {"name": "algebraic_independent.mv_polynomial_option_equiv_polynomial_adjoin_C", "description": "", "p": "mathlib"}, {"name": "exists_is_transcendence_basis", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_equiv'", "description": "", "p": "mathlib"}, {"name": "is_transcendence_basis.is_algebraic", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_bounded_of_finset_algebraic_independent_bounded", "description": "If every finite set of algebraically independent element has cardinality at most `n`,\nthen the same is true for arbitrary sets of algebraically independent elements.", "p": "mathlib"}, {"name": "algebraic_independent.restrict_of_comp_subtype", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_equiv", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.image", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_empty_type_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.aeval_equiv_apply_coe", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.mv_polynomial_option_equiv_polynomial_adjoin_X_some", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.mv_polynomial_option_equiv_polynomial_adjoin_apply", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_subtype_range", "description": "", "p": "mathlib"}, {"name": "algebraic_independent", "description": "`algebraic_independent R x` states the family of elements `x`\n is algebraically independent over `R`, meaning that the canonical\n map out of the multivariable polynomial ring is injective.", "p": "mathlib"}, {"name": "algebraic_independent.repr_ker", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.aeval_comp_mv_polynomial_option_equiv_polynomial_adjoin", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_iff_ker_eq_bot", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_of_finite", "description": "", "p": "mathlib"}, {"name": "algebraic_independent.aeval_equiv", "description": "Canonical isomorphism between polynomials and the subalgebra generated by\n algebraically independent elements.", "p": "mathlib"}, {"name": "alg_hom.algebraic_independent_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_sUnion_of_directed", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_image", "description": "", "p": "mathlib"}, {"name": "algebraic_independent_subtype", "description": "", "p": "mathlib"}, {"name": "put", "description": "Set the top-most state of a monad stack.", "p": "core"}, {"name": "state", "description": "", "p": "core"}, {"name": "state_t.monad_map", "description": "", "p": "core"}, {"name": "state_t.bind", "description": "", "p": "core"}, {"name": "state_t", "description": "", "p": "core"}, {"name": "state_t.run", "description": "", "p": "core"}, {"name": "state_t.put", "description": "", "p": "core"}, {"name": "monad_state_adapter_trans", "description": "", "p": "core"}, {"name": "monad_state", "description": "An implementation of [MonadState](https://hackage.haskell.org/package/mtl-2.2.2/docs/Control-Monad-State-Class.html).\n   In contrast to the Haskell implementation, we use overlapping instances to derive instances\n   automatically from `monad_lift`.\n\n   Note: This class can be seen as a simplification of the more \"principled\" definition\n   ```lean\n   class monad_state_lift (\u03c3 : out_param (Type u)) (n : Type u \u2192 Type u) :=\n   (lift {\u03b1 : Type u} : (\u2200 {m : Type u \u2192 Type u} [monad m], state_t \u03c3 m \u03b1) \u2192 n \u03b1)\n   ```\n   which better describes the intent of \"we can lift a `state_t` from anywhere in the monad stack\".\n   However, by parametricity the types `\u2200 m [monad m], \u03c3 \u2192 m (\u03b1 \u00d7 \u03c3)` and `\u03c3 \u2192 \u03b1 \u00d7 \u03c3` should be\n   equivalent because the only way to obtain an `m` is through `pure`.", "p": "core"}, {"name": "monad_state.lift", "description": "An implementation of [MonadState](https://hackage.haskell.org/package/mtl-2.2.2/docs/Control-Monad-State-Class.html).\n   In contrast to the Haskell implementation, we use overlapping instances to derive instances\n   automatically from `monad_lift`.\n\n   Note: This class can be seen as a simplification of the more \"principled\" definition\n   ```lean\n   class monad_state_lift (\u03c3 : out_param (Type u)) (n : Type u \u2192 Type u) :=\n   (lift {\u03b1 : Type u} : (\u2200 {m : Type u \u2192 Type u} [monad m], state_t \u03c3 m \u03b1) \u2192 n \u03b1)\n   ```\n   which better describes the intent of \"we can lift a `state_t` from anywhere in the monad stack\".\n   However, by parametricity the types `\u2200 m [monad m], \u03c3 \u2192 m (\u03b1 \u00d7 \u03c3)` and `\u03c3 \u2192 \u03b1 \u00d7 \u03c3` should be\n   equivalent because the only way to obtain an `m` is through `pure`.", "p": "core"}, {"name": "state_t.monad_except", "description": "", "p": "core"}, {"name": "monad_state_adapter", "description": "Adapt a monad stack, changing the type of its top-most state.\n\n   This class is comparable to [Control.Lens.Zoom](https://hackage.haskell.org/package/lens-4.15.4/docs/Control-Lens-Zoom.html#t:Zoom), but does not use lenses (yet?), and is derived automatically for any transformer implementing `monad_functor`.\n\n   For zooming into a part of the state, the `split` function should split \u03c3 into the part \u03c3' and the \"context\" \u03c3'' so that the potentially modified \u03c3' and the context can be rejoined by `join` in the end.\n   In the simplest case, the context can be chosen as the full outer state (ie. `\u03c3'' = \u03c3`), which makes `split` and `join` simpler to define. However, note that the state will not be used linearly in this case.\n\n   Example:\n   ```lean\n   def zoom_fst {\u03b1 \u03c3 \u03c3' : Type} : state \u03c3 \u03b1 \u2192 state (\u03c3 \u00d7 \u03c3') \u03b1 :=\n   adapt_state id prod.mk\n   ```\n\n   The function can also zoom out into a \"larger\" state, where the new parts are supplied by `split` and discarded by `join` in the end. The state is therefore not used linearly anymore but merely affinely, which is not a practically relevant distinction in Lean.\n\n   Example:\n   ```lean\n   def with_snd {\u03b1 \u03c3 \u03c3' : Type} (snd : \u03c3') : state (\u03c3 \u00d7 \u03c3') \u03b1 \u2192 state \u03c3 \u03b1 :=\n   adapt_state (\u03bb st, ((st, snd), ())) (\u03bb \u27e8st,snd\u27e9 _, st)\n   ```\n\n   Note: This class can be seen as a simplification of the more \"principled\" definition\n   ```lean\n   class monad_state_functor (\u03c3 \u03c3' : out_param (Type u)) (n n' : Type u \u2192 Type u) :=\n   (map {\u03b1 : Type u} : (\u2200 {m : Type u \u2192 Type u} [monad m], state_t \u03c3 m \u03b1 \u2192 state_t \u03c3' m \u03b1) \u2192 n \u03b1 \u2192 n' \u03b1)\n   ```\n   which better describes the intent of \"we can map a `state_t` anywhere in the monad stack\".\n   If we look at the unfolded type of the first argument `\u2200 m [monad m], (\u03c3 \u2192 m (\u03b1 \u00d7 \u03c3)) \u2192 \u03c3' \u2192 m (\u03b1 \u00d7 \u03c3')`, we see that it has the lens type `\u2200 f [functor f], (\u03b1 \u2192 f \u03b1) \u2192 \u03b2 \u2192 f \u03b2` with `f` specialized to `\u03bb \u03c3, m (\u03b1 \u00d7 \u03c3)` (exercise: show that this is a lawful functor). We can build all lenses we are insterested in from the functions `split` and `join` as\n   ```lean\n   \u03bb f _ st, let (st, ctx) := split st in\n             (\u03bb st', join st' ctx) <$> f st\n   ```", "p": "core"}, {"name": "monad_state_adapter.adapt_state", "description": "Adapt a monad stack, changing the type of its top-most state.\n\n   This class is comparable to [Control.Lens.Zoom](https://hackage.haskell.org/package/lens-4.15.4/docs/Control-Lens-Zoom.html#t:Zoom), but does not use lenses (yet?), and is derived automatically for any transformer implementing `monad_functor`.\n\n   For zooming into a part of the state, the `split` function should split \u03c3 into the part \u03c3' and the \"context\" \u03c3'' so that the potentially modified \u03c3' and the context can be rejoined by `join` in the end.\n   In the simplest case, the context can be chosen as the full outer state (ie. `\u03c3'' = \u03c3`), which makes `split` and `join` simpler to define. However, note that the state will not be used linearly in this case.\n\n   Example:\n   ```lean\n   def zoom_fst {\u03b1 \u03c3 \u03c3' : Type} : state \u03c3 \u03b1 \u2192 state (\u03c3 \u00d7 \u03c3') \u03b1 :=\n   adapt_state id prod.mk\n   ```\n\n   The function can also zoom out into a \"larger\" state, where the new parts are supplied by `split` and discarded by `join` in the end. The state is therefore not used linearly anymore but merely affinely, which is not a practically relevant distinction in Lean.\n\n   Example:\n   ```lean\n   def with_snd {\u03b1 \u03c3 \u03c3' : Type} (snd : \u03c3') : state (\u03c3 \u00d7 \u03c3') \u03b1 \u2192 state \u03c3 \u03b1 :=\n   adapt_state (\u03bb st, ((st, snd), ())) (\u03bb \u27e8st,snd\u27e9 _, st)\n   ```\n\n   Note: This class can be seen as a simplification of the more \"principled\" definition\n   ```lean\n   class monad_state_functor (\u03c3 \u03c3' : out_param (Type u)) (n n' : Type u \u2192 Type u) :=\n   (map {\u03b1 : Type u} : (\u2200 {m : Type u \u2192 Type u} [monad m], state_t \u03c3 m \u03b1 \u2192 state_t \u03c3' m \u03b1) \u2192 n \u03b1 \u2192 n' \u03b1)\n   ```\n   which better describes the intent of \"we can map a `state_t` anywhere in the monad stack\".\n   If we look at the unfolded type of the first argument `\u2200 m [monad m], (\u03c3 \u2192 m (\u03b1 \u00d7 \u03c3)) \u2192 \u03c3' \u2192 m (\u03b1 \u00d7 \u03c3')`, we see that it has the lens type `\u2200 f [functor f], (\u03b1 \u2192 f \u03b1) \u2192 \u03b2 \u2192 f \u03b2` with `f` specialized to `\u03bb \u03c3, m (\u03b1 \u00d7 \u03c3)` (exercise: show that this is a lawful functor). We can build all lenses we are insterested in from the functions `split` and `join` as\n   ```lean\n   \u03bb f _ st, let (st, ctx) := split st in\n             (\u03bb st', join st' ctx) <$> f st\n   ```", "p": "core"}, {"name": "state_t.adapt", "description": "", "p": "core"}, {"name": "state_t.alternative", "description": "", "p": "core"}, {"name": "state_t.lift", "description": "", "p": "core"}, {"name": "state_t.monad_state_adapter", "description": "", "p": "core"}, {"name": "monad_state_trans", "description": "", "p": "core"}, {"name": "modify", "description": "Map the top-most state of a monad stack.\n\n   Note: `modify f` may be preferable to `f <$> get >>= put` because the latter\n   does not use the state linearly (without sufficient inlining).", "p": "core"}, {"name": "state_t.has_monad_lift", "description": "", "p": "core"}, {"name": "state_t.orelse", "description": "", "p": "core"}, {"name": "state_t.monad_state", "description": "", "p": "core"}, {"name": "state_t.modify", "description": "", "p": "core"}, {"name": "state_t.monad_run", "description": "", "p": "core"}, {"name": "state_t.pure", "description": "", "p": "core"}, {"name": "state_t.monad", "description": "", "p": "core"}, {"name": "state_t.failure", "description": "", "p": "core"}, {"name": "state_t.monad_functor", "description": "", "p": "core"}, {"name": "state_t.get", "description": "", "p": "core"}, {"name": "get", "description": "Obtain the top-most state of a monad stack.", "p": "core"}, {"name": "fin_vec.eta_expand_eq", "description": "This can be use to prove\n```lean\nexample {f : \u03b1 \u2192 \u03b2} (a : fin 2 \u2192 \u03b1) : a = ![a 0, a 1] := (eta_expand_eq _).symm\n```", "p": "mathlib"}, {"name": "fin_vec.exists_iff", "description": "This can be use to prove\n```lean\nexample (P : (fin 2 \u2192 \u03b1) \u2192 Prop) : (\u2203 f, P f) \u2194 (\u2203 a\u2080 a\u2081, P ![a\u2080, a\u2081]) := (exists_iff _).symm\n```", "p": "mathlib"}, {"name": "fin_vec.forall_iff", "description": "This can be use to prove\n```lean\nexample (P : (fin 2 \u2192 \u03b1) \u2192 Prop) : (\u2200 f, P f) \u2194 (\u2200 a\u2080 a\u2081, P ![a\u2080, a\u2081]) := (forall_iff _).symm\n```", "p": "mathlib"}, {"name": "fin_vec.seq", "description": "Evaluate `fin_vec.seq f v = ![(f 0) (v 0), (f 1) (v 1), ...]`", "p": "mathlib"}, {"name": "fin_vec.forall", "description": "`\u2200` with better defeq for `\u2200 x : fin m \u2192 \u03b1, P x`.", "p": "mathlib"}, {"name": "fin_vec.eta_expand", "description": "Expand `v` to `![v 0, v 1, ...]`", "p": "mathlib"}, {"name": "fin_vec.map", "description": "`fin_vec.map f v = ![f (v 0), f (v 1), ...]`", "p": "mathlib"}, {"name": "fin_vec.exists", "description": "`\u2203` with better defeq for `\u2203 x : fin m \u2192 \u03b1, P x`.", "p": "mathlib"}, {"name": "fin_vec.seq_eq", "description": "", "p": "mathlib"}, {"name": "fin_vec.sum", "description": "`finset.univ.sum` with better defeq for `fin`", "p": "mathlib"}, {"name": "fin_vec.sum_eq", "description": " This can be used to prove\n```lean\nexample [add_comm_monoid \u03b1] (a : fin 3 \u2192 \u03b1) : \u2211 i, a i = a 0 + a 1 + a 2 :=\n(sum_eq _).symm\n```", "p": "mathlib"}, {"name": "fin_vec.map_eq", "description": "This can be use to prove\n```lean\nexample {f : \u03b1 \u2192 \u03b2} (a\u2081 a\u2082 : \u03b1) : f \u2218 ![a\u2081, a\u2082] = ![f a\u2081, f a\u2082] :=\n(map_eq _ _).symm\n```", "p": "mathlib"}, {"name": "bool.band_bor_distrib_right", "description": "", "p": "mathlib"}, {"name": "bool.bor_inl", "description": "", "p": "mathlib"}, {"name": "bool.bxor_comm", "description": "", "p": "mathlib"}, {"name": "bool.coe_bool_iff", "description": "", "p": "mathlib"}, {"name": "bool.band_le_right", "description": "", "p": "mathlib"}, {"name": "bool.to_bool_not", "description": "", "p": "mathlib"}, {"name": "bool.bor_band_distrib_right", "description": "", "p": "mathlib"}, {"name": "bool.ff_le", "description": "", "p": "mathlib"}, {"name": "bool.bxor_ff_left", "description": "", "p": "mathlib"}, {"name": "bool.band_comm", "description": "", "p": "mathlib"}, {"name": "bool.eq_bnot_iff", "description": "", "p": "mathlib"}, {"name": "bool.bnot_ff", "description": "", "p": "mathlib"}, {"name": "bool.ne_bnot", "description": "", "p": "mathlib"}, {"name": "bool.band_bor_distrib_left", "description": "", "p": "mathlib"}, {"name": "bool.le_band", "description": "", "p": "mathlib"}, {"name": "bool.bor_le", "description": "", "p": "mathlib"}, {"name": "bool.bxor_iff_ne", "description": "", "p": "mathlib"}, {"name": "bool.bnot_band_self", "description": "", "p": "mathlib"}, {"name": "bool.to_bool_false", "description": "", "p": "mathlib"}, {"name": "bool.to_nat", "description": "convert a `bool` to a `\u2115`, `false -> 0`, `true -> 1`", "p": "mathlib"}, {"name": "bool.bnot_band", "description": "", "p": "mathlib"}, {"name": "bool.to_bool_true", "description": "", "p": "mathlib"}, {"name": "bool.bnot_ne_id", "descri