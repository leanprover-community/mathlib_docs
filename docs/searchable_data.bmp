y.sheafification_iso_image_presheaf", "description": "The image of `F` in `J.sheafify F` is isomorphic to the sheafification.", "p": "mathlib"}, {"name": "category_theory.is_locally_surjective", "description": " A morphism of presheaves `f : F \u27f6 G` is locally surjective with respect to a grothendieck\ntopology if every section of `G` is locally in the image of `f`.", "p": "mathlib"}, {"name": "category_theory.is_locally_surjective_iff_whisker_forget", "description": "", "p": "mathlib"}, {"name": "eq_ff_of_not_eq_tt", "description": "", "p": "core"}, {"name": "bnot_eq_true_eq_eq_ff", "description": "", "p": "core"}, {"name": "tt_band", "description": "", "p": "core"}, {"name": "bnot_eq_ff_eq_eq_tt", "description": "", "p": "core"}, {"name": "eq_ff_eq_not_eq_tt", "description": "", "p": "core"}, {"name": "band_eq_true_eq_eq_tt_and_eq_tt", "description": "", "p": "core"}, {"name": "tt_eq_ff_eq_false", "description": "", "p": "core"}, {"name": "bor_ff", "description": "", "p": "core"}, {"name": "bxor_self", "description": "", "p": "core"}, {"name": "coe_ff", "description": "", "p": "core"}, {"name": "ff_eq_tt_eq_false", "description": "", "p": "core"}, {"name": "bor_eq_false_eq_eq_ff_and_eq_ff", "description": "", "p": "core"}, {"name": "bor_coe_iff", "description": "", "p": "core"}, {"name": "of_to_bool_ff", "description": "", "p": "core"}, {"name": "bor_self", "description": "", "p": "core"}, {"name": "eq_tt_eq_not_eq_ff", "description": "", "p": "core"}, {"name": "to_bool_true", "description": "", "p": "core"}, {"name": "ff_bor", "description": "", "p": "core"}, {"name": "bool_iff_false", "description": "", "p": "core"}, {"name": "to_bool_ff", "description": "", "p": "core"}, {"name": "coe_sort_tt", "description": "", "p": "core"}, {"name": "to_bool_iff", "description": "", "p": "core"}, {"name": "band_self", "description": "", "p": "core"}, {"name": "tt_bor", "description": "", "p": "core"}, {"name": "bor_tt", "description": "", "p": "core"}, {"name": "to_bool_