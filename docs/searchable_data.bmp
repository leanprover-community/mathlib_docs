test.upper_bounds_eq", "description": "", "p": "mathlib"}, {"name": "is_glb_Ioc", "description": "", "p": "mathlib"}, {"name": "lower_bounds", "description": "The set of lower bounds of a set.", "p": "mathlib"}, {"name": "is_glb.exists_between'", "description": "", "p": "mathlib"}, {"name": "is_lub.mono", "description": "", "p": "mathlib"}, {"name": "upper_bounds_mono_set", "description": "", "p": "mathlib"}, {"name": "bdd_above_Ioo", "description": "", "p": "mathlib"}, {"name": "le_glb_Ioi", "description": "", "p": "mathlib"}, {"name": "is_greatest.union", "description": " If `a` is the greatest element of `s` and `b` is the greatest element of `t`,\nthen `max a b` is the greatest element of `s \u222a t`.", "p": "mathlib"}, {"name": "mem_upper_bounds_image2_of_mem_lower_bounds", "description": "", "p": "mathlib"}, {"name": "order_top.upper_bounds_univ", "description": "", "p": "mathlib"}, {"name": "bdd_above_Iic", "description": "", "p": "mathlib"}, {"name": "is_least.lower_bounds_eq", "description": "", "p": "mathlib"}, {"name": "is_lub.dual", "description": "", "p": "mathlib"}, {"name": "is_least.order_bot", "description": "If `a` is the least element of a set `s`, then subtype `s` is an order with bottom element.", "p": "mathlib"}, {"name": "lub_Iio_eq_self_or_Iio_eq_Iic", "description": "", "p": "mathlib"}, {"name": "is_lub_Iio", "description": "", "p": "mathlib"}, {"name": "no_min_order.lower_bounds_univ", "description": "", "p": "mathlib"}, {"name": "bdd_below_Ioo", "description": "", "p": "mathlib"}, {"name": "is_glb.insert", "description": "", "p": "mathlib"}, {"name": "order_top.bdd_above", "description": "When there is a global maximum, every set is bounded above.", "p": "mathlib"}, {"name": "mem_upper_bounds_image2_of_mem_upper_bounds_of_mem_lower_bounds", "description": "", "p": "mathlib"}, {"name": "mem_upper_bounds_image2_of_mem_upper_bounds_of_mem_upper_bounds", "description": "", "p": "mathlib"}, {"name": "is_lub_lower_bounds", "description": "", "p": "mathlib"}, {"name": "bdd_above_empty", "description": "", "p": "mathlib"}, {"name": "is_least.mono", "description": "", "p": "mathlib"}, {"name": "bdd_above.image2_bdd_below", "description": "", "p": "mathlib"}, {"name": "monotone_on.mem_upper_bounds_image", "description": "", "p": "mathlib"}, {"name": "bdd_above_def", "description": "", "p": "mathlib"}, {"name": "scott_continuous", "description": " A function between preorders is said to be Scott continuous if it preserves `is_lub` on directed\nsets. It can be shown that a function is Scott continuous if and only if it is continuous wrt the\nScott topology.\n\nThe dual notion\n\n```lean\n\u2200 \u2983d : set \u03b1\u2984, d.nonempty \u2192 directed_on (\u2265) d \u2192 \u2200 \u2983a\u2984, is_glb d a \u2192 is_glb (f '' d) (f a)\n```\n\ndoes not appear to play a significant role in the literature, so is omitted here.", "p": "mathlib"}, {"name": "is_least.insert", "description": "", "p": "mathlib"}, {"name": "lower_bounds_empty", "description": "", "p": "mathlib"}, {"name": "is_lub_iff_le_iff", "description": "", "p": "mathlib"}, {"name": "monotone_on.map_bdd_above", "description": "The image under a monotone function on a set `t` of a subset which has an upper bound in `t`\n is bounded above.", "p": "mathlib"}, {"name": "is_lub_singleton", "description": "", "p": "mathlib"}, {"name": "bdd_below_Ici", "description": "", "p": "mathlib"}, {"name": "no_max_order.upper_bounds_univ", "description": "", "p": "mathlib"}, {"name": "upper_bounds_Iic", "description": "", "p": "mathlib"}, {"name": "mem_lower_bounds_image2_of_mem_lower_bounds_of_mem_lower_bounds", "description": "", "p": "mathlib"}, {"name": "bdd_above.image2", "description": "See also `monotone.map_bdd_above`.", "p": "mathlib"}, {"name": "monotone_on.image_upper_bounds_subset_upper_bounds_image", "description": "", "p": "mathlib"}, {"name": "bot_mem_lower_bounds", "description": "", "p": "mathlib"}, {"name": "monotone.image_upper_bounds_subset_upper_bound