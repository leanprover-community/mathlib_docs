athlib"}, {"name": "ordinal.nontrivial", "description": "", "p": "mathlib"}, {"name": "ordinal.type_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.lift_down", "description": "", "p": "mathlib"}, {"name": "ordinal.partial_order", "description": "", "p": "mathlib"}, {"name": "cardinal.ord_one", "description": "", "p": "mathlib"}, {"name": "ordinal.no_max_order", "description": "", "p": "mathlib"}, {"name": "ordinal.type_ne_zero_iff_nonempty", "description": "", "p": "mathlib"}, {"name": "ordinal.max_zero_right", "description": "", "p": "mathlib"}, {"name": "ordinal.typein_le_typein", "description": "", "p": "mathlib"}, {"name": "ordinal.has_well_founded", "description": "", "p": "mathlib"}, {"name": "ordinal.lt_lift_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.eq_to_hom_proj", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.eval_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_comp", "description": "The natural isomorphism comparing between\npulling back along two successive functions, and\npulling back along their composition", "p": "mathlib"}, {"name": "category_theory.pi.iso_app_symm", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_comp_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_eval_iso_eval_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.pi'_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_eval_iso_eval", "description": "The natural isomorphism between pulling back then evaluating, and just evaluating.", "p": "mathlib"}, {"name": "category_theory.functor.pi'_eval", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.pi", "description": "Assemble an `I`-indexed family of functors into a functor between the pi types.", "p": "mathlib"}, {"name": "category_theory.nat_trans.pi_app", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.sum_elim_category", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.iso_app_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.id_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_eval_iso_eval_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.pi'_map", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap", "description": "Pull back an `I`-indexed family of objects to an `J`-indexed family, along a function `J \u2192 I`.", "p": "mathlib"}, {"name": "category_theory.pi.sum_map_app", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_id_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.pi'", "description": "This provides some assistance to typeclass search in a common situation,\nwhich otherwise fails. (Without this `category_theory.pi.has_limit_of_has_limit_comp_eval` fails.)", "p": "mathlib"}, {"name": "category_theory.nat_trans.pi", "description": "Assemble an `I`-indexed family of natural transformations into a single natural transformation.", "p": "mathlib"}, {"name": "category_theory.pi.iso_app_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_id", "description": "The natural isomorphism between\npulling back a grading along the identity function,\nand the identity functor.", "p": "mathlib"}, {"name": "category_theory.pi.iso_app", "description": " An isomorphism between `I`-indexed objects gives an isomorphism between each\npair of corresponding components.", "p": "mathlib"}, {"name": "category_theory.pi.comp_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.iso_app_trans", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.pi_map", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_map", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_comp_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.sum_obj_map", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.eval_map", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.comap_id_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.pi'", "description": "Similar to `pi`, but all functors come from the same category `A`", "p": "mathlib"}, {"name": "category_theory.pi.sum", "description": "The bifunctor combining an `I`-indexed family of objects with a `J`-indexed family of objects\nto obtain an `I \u2295 J`-indexed family of objects.", "p": "mathlib"}, {"name": "category_theory.pi", "description": "`pi C` gives the cartesian product of an indexed family of categories.", "p": "mathlib"}, {"name": "category_theory.pi.sum_obj_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.iso_app_refl", "description": "", "p": "mathlib"}, {"name": "category_theory.pi.eval", "description": "The evaluation functor at `i : I`, sending an `I`-indexed family of objects to the object over `i`.", "p": "mathlib"}, {"name": "category_theory.functor.pi_ext", "description": "Two functors to a product category are equal iff they agree on every coordinate.", "p": "mathlib"}, {"name": "category_theory.functor.pi_obj", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_equiv_pi_span", "description": "We can write the quotient of an ideal over a PID as a product of quotients by principal ideals.", "p": "mathlib"}, {"name": "ideal.fintype_quotient_of_free_of_ne_bot", "description": " A nonzero ideal over a free finite extension of `\u2124` has a finite quotient.\n\nCan't be an instance because of the side condition `I \u2260 \u22a5`, and more importantly,\nbecause the choice of `fintype` instance is non-canonical.", "p": "mathlib"}, {"name": "ideal.finrank_quotient_eq_sum", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_equiv_direct_sum", "description": "Decompose `S\u29f8I` as a direct sum of cyclic `R`-modules\n (quotients by the ideals generated by Smith coefficients of `I`).", "p": "mathlib"}, {"name": "ideal.quotient_equiv_pi_zmod", "description": " Ideal quotients over a free finite extension of `\u2124` are isomorphic to a direct product of\n`zmod`.", "p": "mathlib"}, {"name": "expr.has_var_idx", "description": "`has_var_idx e n` returns true iff `e` has a free variable with de-Bruijn index `n`.", "p": "core"}, {"name": "expr.local_pp_name", "description": "", "p": "core"}, {"name": "expr.is_sorry", "description": "Checks whether e is sorry, and returns its type.", "p": "core"}, {"name": "expr.is_annotation", "description": " Expressions can be annotated using an annotation macro during compilation.\nFor example, a `have x:X, from p, q` expression will be compiled to `(\u03bb x:X,q)(p)`, but nested in an annotation macro with the name `\"have\"`.\nThese annotations have no real semantic meaning, but are useful for helping Lean's pretty printer.", "p": "core"}, {"name": "expr.is_arrow", "description": "", "p": "core"}, {"name": "macro_def", "description": "Macros are basically \"promises\" to build an expr by some C++ code, you can't build them in Lean.\n  You can unfold a macro and force it to evaluate.\n  They are used for\n  - `sorry`.\n  - Term placeholders (`_`) in `pexpr`s.\n  - Expression annotations. See `expr.is_annotation`.\n  - Meta-recursive calls. Eg:\n    ```lean\n    meta def Y : (\u03b1 \u2192 \u03b1) \u2192 \u03b1 | f := f (Y f)\n    ```\n    The `Y` that appears in `f (Y f)` is a macro.\n  - Builtin projections:\n    ```lean\n    structure foo := (mynat : \u2115)\n    #print foo.mynat\n    -- @[reducible]\n    -- def foo.mynat : foo \u2192 \u2115 :=\n    -- \u03bb (c : foo), [foo.mynat c]\n    ```\n    The thing in square brackets is a macro.\n  - Ephemeral structures inside certain specialised C++ implemented tactics.", "p": "core"}, {"name": "expr.is_iff", "description": "", "p": "core"}, {"name": "expr.get_app_args_aux", "description": "", "p": "core"}, {"name": "expr.mk_binding", "description": "", "p": "core"}, {"name": "expr.lam_arity", "description": "", "p": "core"}, {"name": "expr.macro_def_name", "description": "Get the name of the macro definition.", "p": "core"}, {"name": "expr.has_to_string", "description": "", "p": "core"}, {"name": "expr.has_decidable_eq", "description": "Compares expressions, including binder names.", "p": "core"}, {"name": "expr.inhabited", "description": "", "p": "core"}, {"name": "expr.is_napp_of", "description": "The same as `is_app_of` but must also have exactly `n` arguments.", "p": "core"}, {"name": "expr_map.mk", "description": "", "p": "core"}, {"name": "expr.is_ne", "description": "", "p": "core"}, {"name": "expr.hash", "description": " Each expression created by Lean carries a hash.\nThis is calculated upon creation of the expression.\nTwo structurally equal expressions will have the same hash.", "p": "core"}, {"name": "expr_set", "description": "", "p": "core"}, {"name": "expr.get_depth", "description": "Computes the maximum depth of the expression (constant time).", "p": "core"}, {"name": "expr.local_type", "description": "", "p": "core"}, {"name": "expr.is_ge", "description": "", "p": "core"}, {"name": "expr.binding_domain", "description": "The domain (type of bound variable) of a pi, lambda or let expression.", "p": "core"}, {"name": "binder_info", "description": " Auxiliary annotation for binders (Lambda and Pi).\n    This information is only used for elaboration.\n      The difference between `{}` and `\u2983\u2984` is how implicit arguments are treated that are *not* followed by explicit arguments.\n  `{}` arguments are applied eagerly, while `\u2983\u2984` arguments are left partially applied:\n```lean\ndef foo {x : \u2115} : \u2115 := x\ndef bar \u2983x : \u2115\u2984 : \u2115 := x\n#check foo -- foo : \u2115\n#check bar -- bar : \u03a0 \u2983x : \u2115\u2984, \u2115\n```", "p": "core"}, {"name": "binder_info.default", "description": " Auxiliary annotation for binders (Lambda and Pi).\n    This information is only used for elaboration.\n      The difference between `{}` and `\u2983\u2984` is how implicit arguments are treated that are *not* followed by explicit arguments.\n  `{}` arguments are applied eagerly, while `\u2983\u2984` arguments are left partially applied:\n```lean\ndef foo {x : \u2115} : \u2115 := x\ndef bar \u2983x : \u2115\u2984 : \u2115 := x\n#check foo -- foo : \u2115\n#check bar -- bar : \u03a0 \u2983x : \u2115\u2984, \u2115\n```", "p": "core"}, {"name": "binder_info.implicit", "description": " Auxiliary annotation for binders (Lambda and Pi).\n    This information is only used for elaboration.\n      The difference between `{}` and `\u2983\u2984` is how implicit arguments are treated that are *not* followed by explicit arguments.\n  `{}` arguments are applied eagerly, while `\u2983\u2984` arguments are left partially applied:\n```lean\ndef foo {x : \u2115} : \u2115 := x\ndef bar \u2983x : \u2115\u2984 : \u2115 := x\n#check foo -- foo : \u2115\n#check bar -- bar : \u03a0 \u2983x : \u2115\u2984, \u2115\n```", "p": "core"}, {"name": "binder_info.strict_implicit", "description": " Auxiliary annotation for binders (Lambda and Pi).\n    This information is only used for elaboration.\n      The difference between `{}` and `\u2983\u2984` is how implicit arguments are treated that are *not* followed by explicit arguments.\n  `{}` arguments are applied eagerly, while `\u2983\u2984` arguments are left partially applied:\n```lean\ndef foo {x : \u2115} : \u2115 := x\ndef bar \u2983x : \u2115\u2984 : \u2115 := x\n#check foo -- foo : \u2115\n#check bar -- bar : \u03a0 \u2983x : \u2115\u2984, \u2115\n```", "p": "core"}, {"name": "binder_info.inst_implicit", "description": " Auxiliary annotation for binders (Lambda and Pi).\n    This information is only used for elaboration.\n      The difference between `{}` and `\u2983\u2984` is how implicit arguments are treated that are *not* followed by explicit arguments.\n  `{}` arguments are applied eagerly, while `\u2983\u2984` arguments are left partially applied:\n```lean\ndef foo {x : \u2115} : \u2115 := x\ndef bar \u2983x : \u2115\u2984 : \u2115 := x\n#check foo -- foo : \u2115\n#check bar -- bar : \u03a0 \u2983x : \u2115\u2984, \u2115\n```", "p": "core"}, {"name": "binder_info.aux_decl", "description": " Auxiliary annotation for binders (Lambda and Pi).\n    This information is only used for elaboration.\n      The difference between `{}` and `\u2983\u2984` is how implicit arguments are treated that are *not* followed by explicit arguments.\n  `{}` arguments are applied eagerly, while `\u2983\u2984` arguments are left partially applied:\n```lean\ndef foo {x : \u2115} : \u2115 := x\ndef bar \u2983x : \u2115\u2984 : \u2115 := x\n#check foo -- foo : \u2115\n#check bar -- bar : \u03a0 \u2983x : \u2115\u2984, \u2115\n```", "p": "core"}, {"name": "expr.binding_body", "description": "The body of a pi, lambda or let expression.\n This definition doesn't instantiate bound variables, and therefore produces a term that is open.\n See note [open expressions] in mathlib.", "p": "core"}, {"name": "expr.subst", "description": " Perform beta-reduction if the left expression is a lambda, or construct an application otherwise.\nThat is: ``expr.subst `(\u03bb x, %%Y) Z = Y[x/Z]``, and\n``expr.subst X Z = X.app Z`` otherwise", "p": "core"}, {"name": "expr.binding_name", "description": "The name of the bound variable in a pi, lambda or let expression.", "p": "core"}, {"name": "expr.instantiate_locals", "description": "", "p": "core"}, {"name": "expr.is_heq", "description": "", "p": "core"}, {"name": "expr.has_local_in", "description": "Returns true if any of the names in the given `name_set` are present in the given `expr`.", "p": "core"}, {"name": "expr.occurs", "description": "`occurs e t` returns `tt` iff `e` occurs in `t` up to \u03b1-equivalence. Purely structural: no unification or definitional equality.", "p": "core"}, {"name": "expr.instantiate_var", "description": "`instantiate_var a b` takes the 0th de-Bruijn variable in `a` and replaces each occurrence with `b`.", "p": "core"}, {"name": "expr.lt_prop", "description": "", "p": "core"}, {"name": "expr.imp", "description": "", "p": "core"}, {"name": "expr.get_app_fn", "description": "", "p": "core"}, {"name": "expr.extract_opt_auto_param", "description": "", "p": "core"}, {"name": "expr.lambdas", "description": "`lambdas cs e` lambda binds `e` with each of the local constants in `cs`.", "p": "core"}, {"name": "expr.replace", "description": "`expr.replace e f`\nTraverse over an expr `e` with a function `f` which can decide to replace subexpressions or not.\nFor each subexpression `s` in the expression tree, `f s n` is called where `n` is how many binders are present above the given subexpression `s`.\nIf `f s n` returns `none`, the children of `s` will be traversed.\nOtherwise if `some s'` is returned, `s'` will replace `s` and this subexpression will not be traversed further.", "p": "core"}, {"name": "expr.has_meta_var", "description": "`has_meta_var e` returns true iff `e` contains a metavariable.", "p": "core"}, {"name": "expr.is_constant_of", "description": "", "p": "core"}, {"name": "mk_expr_set", "description": "", "p": "core"}, {"name": "expr.is_eq", "description": "", "p": "core"}, {"name": "expr.has_to_format", "description": "", "p": "core"}, {"name": "expr.const_name", "description": "", "p": "core"}, {"name": "reflected.has_to_format", "description": "", "p": "core"}, {"name": "string.reflect", "description": "", "p": "core"}, {"name": "expr.mk_delayed_abstraction", "description": "`mk_delayed_abstraction m ls` creates a delayed abstraction on the metavariable `m` with the unique names of the local constants `ls`.\n   If `m` is not a metavariable then this is equivalent to `abstract_locals`.", "p": "core"}, {"name": "expr.to_string", "description": "", "p": "core"}, {"name": "pos.decidable_eq", "description": "", "p": "core"}, {"name": "expr.is_gt", "description": "", "p": "core"}, {"name": "expr.is_false", "description": "", "p": "core"}, {"name": "expr.is_pi", "description": "", "p": "core"}, {"name": "expr.mk_sorry", "description": "Returns the sorry macro with the given type.", "p": "core"}, {"name": "expr.lower_vars", "description": "`lower_vars e s d` lowers the free variables >= s in `e` by `d`. Note that this can cause variable clashes.\n   examples:\n   -  ``lower_vars `(#2 #1 #0) 1 1 = `(#1 #0 #0)``\n   -  ``lower_vars `(\u03bb x, #2 #1 #0) 1 1 = `(\u03bb x, #1 #1 #0 )``", "p": "core"}, {"name": "expr.pos", "description": "Get the position of the given expression in the Lean source file, if anywhere.", "p": "core"}, {"name": "expr.erase_annotations", "description": "Remove all macro annotations from the given `expr`.", "p": "core"}, {"name": "expr.is_lambda", "description": "", "p": "core"}, {"name": "expr.mk_app", "description": "", "p": "core"}, {"name": "expr.instantiate_univ_params", "description": " Expressions depend on `level`s, and these may depend on universe parameters which have names.\n`instantiate_univ_params e [(n\u2081,l\u2081), ...]` will traverse `e` and replace any universe parameters with name `n\u1d62` with the corresponding level `l\u1d62`.", "p": "core"}, {"name": "expr.mk_true", "description": "", "p": "core"}, {"name": "expr.mk_var", "description": "", "p": "core"}, {"name": "expr.is_var", "description": "", "p": "core"}, {"name": "expr.lift_vars", "description": "Lifts free variables. `lift_vars e s d` will lift all free variables with index `\u2265 s` in `e` by `d`.", "p": "core"}, {"name": "expr.is_or", "description": "", "p": "core"}, {"name": "reflected", "description": "(reflected a) is a special opaque container for a closed `expr` representing `a`.\n   It can only be obtained via type class inference, which will use the representation\n   of `a` in the calling context. Local constants in the representation are replaced\n   by nested inference of `reflected` instances.\n\n   The quotation expression `` `(a) `` (outside of patterns) is equivalent to `reflect a`\n   and thus can be used as an explicit way of inferring an instance of `reflected a`.\n   \n   Note that the `\u03b1` argument is explicit to prevent it being treated as reducible by typeclass\n   inference, as this breaks `reflected` instances on type synonyms.", "p": "core"}, {"name": "expr.copy_pos_info", "description": "`copy_pos_info src tgt` copies position information from `src` to `tgt`.", "p": "core"}, {"name": "expr.mfold", "description": " Fold an accumulator `a` over each subexpression in the expression `e`.\nThe `nat` passed to `fn` is the number of binders above the subexpression.", "p": "core"}, {"name": "expr.reflect", "description": "", "p": "core"}, {"name": "expr.pi_arity", "description": "", "p": "core"}, {"name": "expr.app_fn", "description": "", "p": "core"}, {"name": "expr.is_le", "description": "", "p": "core"}, {"name": "expr.is_let", "description": "", "p": "core"}, {"name": "binder_info.has_repr", "description": "", "p": "core"}, {"name": "expr.has_coe", "description": "", "p": "core"}, {"name": "expr.app_of_list", "description": "", "p": "core"}, {"name": "expr.get_app_args", "description": "", "p": "core"}, {"name": "expr.is_bin_arith_app", "description": "", "p": "core"}, {"name": "expr.get_weight", "description": "Computes the number of sub-expressions (constant time).", "p": "core"}, {"name": "expr.abstract_local", "description": "`abstract_local e n` replaces each instance of the local constant with unique (not pretty) name `n` in `e` with a de-Bruijn variable.", "p": "core"}, {"name": "expr.is_numeral", "description": "", "p": "core"}, {"name": "expr.is_string_macro", "description": "", "p": "core"}, {"name": "expr.mk_false", "description": "", "p": "core"}, {"name": "expr.is_aux_decl", "description": "", "p": "core"}, {"name": "expr.has_var", "description": "`has_var e` returns true iff e has free variables.", "p": "core"}, {"name": "expr.alpha_eqv", "description": "Compares expressions while ignoring binder names.", "p": "core"}, {"name": "expr.is_local_constant", "description": "", "p": "core"}, {"name": "expr.lt_prop.decidable_rel", "description": "", "p": "core"}, {"name": "expr.app_arg", "description": "", "p": "core"}, {"name": "reflected.subst", "description": " This is a more strongly-typed version of `expr.subst` that keeps track of the value being\nreflected. To obtain a term of type `reflected _`, use `` (`(\u03bb x y, foo x y).subst ex).subst ey`` instead of\nusing `` `(foo %%ex %%ey) `` (which returns an `expr`).", "p": "core"}, {"name": "expr.has_lt", "description": "Compares expressions, ignoring binder names, and sorting by hash.", "p": "core"}, {"name": "expr.is_app", "description": "", "p": "core"}, {"name": "expr.instantiate_vars_core", "description": " Same as `instantiate_vars` except lifts and shifts the vars by the given amount.\n``instantiate_vars_core `(#0 #1 #2 #3) 0 [x,y] = `(x y #0 #1)``\n``instantiate_vars_core `(#0 #1 #2 #3) 1 [x,y] = `(#0 x y #1)``\n``instantiate_vars_core `(#0 #1 #2 #3) 2 [x,y] = `(#0 #1 x y)``", "p": "core"}, {"name": "expr.pis", "description": "Same as `expr.lambdas` but with `pi`.", "p": "core"}, {"name": "expr.bind_lambda", "description": "(bind_lambda e l) abstracts and lambda-binds the local `l` in `e`", "p": "core"}, {"name": "expr.to_raw_fmt", "description": "", "p": "core"}, {"name": "expr.has_coe_to_fun", "description": "Coercion for letting users write (f a) instead of (expr.app f a)", "p": "core"}, {"name": "pos", "description": "Column and line position in a Lean source file.", "p": "core"}, {"name": "pos.line", "description": "Column and line position in a Lean source file.", "p": "core"}, {"name": "pos.column", "description": "Column and line position in a Lean source file.", "p": "core"}, {"name": "expr.is_constant", "description": "", "p": "core"}, {"name": "expr.is_not", "description": "", "p": "core"}, {"name": "expr.ith_arg", "description": "", "p": "core"}, {"name": "expr.get_nat_value", "description": " There is a macro called a \"nat_value_macro\" holding a natural number which are used during compilation.\nThis function extracts that to a natural number. [NOTE] This is not used anywhere in Lean.", "p": "core"}, {"name": "expr.instantiate_local", "description": "Replace each instance of the local constant with name `n` by the expression `s` in `e`.", "p": "core"}, {"name": "reflect", "description": "", "p": "core"}, {"name": "expr.ith_arg_aux", "description": "", "p": "core"}, {"name": "expr.fold", "description": "`expr.fold e a f`: Traverses each subexpression of `e`. The `nat` passed to the folder `f` is the binder depth.", "p": "core"}, {"name": "expr.abstract_locals", "description": "Multi version of `abstract_local`. Note that the given expression will only be traversed once, so this is not the same as `list.foldl expr.abstract_local`.", "p": "core"}, {"name": "expr.get_delayed_abstraction_locals", "description": " If the given expression is a delayed abstraction macro, return `some ls`\nwhere `ls` is a list of unique names of locals that will be abstracted.", "p": "core"}, {"name": "expr.is_app_of", "description": "", "p": "core"}, {"name": "expr.instantiate_vars", "description": "``instantiate_vars `(#0 #1 #2) [x,y,z] = `(%%x %%y %%z)``", "p": "core"}, {"name": "expr.is_macro", "description": "", "p": "core"}, {"name": "expr_map", "description": "An dictionary from `data` to expressions.", "p": "core"}, {"name": "expr.instantiate_nth_var", "description": "`instantiate_nth_var n a b` takes the `n`th de-Bruijn variable in `a` and replaces each occurrence with `b`.", "p": "core"}, {"name": "expr.is_internal_cnstr", "description": " Returns `some n` when the given expression is a constant with the name `..._cnstr.n`\n```lean\nis_internal_cnstr : expr \u2192 option unsigned\n|(const (mk_numeral n (mk_string \"_cnstr\" _)) _) := some n\n|_ := none\n```\n[NOTE] This is not used anywhere in core Lean.", "p": "core"}, {"name": "expr.lt", "description": "Compares expressions, ignoring binder names, and sorting by hash.", "p": "core"}, {"name": "expr.get_free_var_range", "description": "`get_free_var_range e` returns one plus the maximum de-Bruijn value in `e`. Eg `get_free_var_range `(#1 #0)` yields `2`", "p": "core"}, {"name": "expr.binding_info", "description": "The binder info of a pi or lambda expression.", "p": "core"}, {"name": "expr.abstract", "description": "`abstract e x` Abstracts the expression `e` over the local constant `x`.", "p": "core"}, {"name": "expr.has_local", "description": "`has_local e` returns true if `e` contains a local constant.", "p": "core"}, {"name": "pos.has_to_format", "description": "", "p": "core"}, {"name": "expr.bind_pi", "description": "(bind_pi e l) abstracts and pi-binds the local `l` in `e`", "p": "core"}, {"name": "mk_expr_map", "description": "", "p": "core"}, {"name": "expr.is_lt", "description": "", "p": "core"}, {"name": "expr.is_and", "description": "", "p": "core"}, {"name": "expr", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.var", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.sort", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.const", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.mvar", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.local_const", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.app", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.lam", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.pi", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.elet", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.macro", "description": "An expression. eg ```(4+5)```.\n\n   The `elab` flag is indicates whether the `expr` has been elaborated and doesn't contain any placeholder macros.\n   For example the equality `x = x` is represented in `expr ff` as ``app (app (const `eq _) x) x`` while in `expr tt` it is represented as ``app (app (app (const `eq _) t) x) x`` (one more argument).\n   The VM replaces instances of this datatype with the C++ implementation.", "p": "core"}, {"name": "expr.nth_binding_body", "description": "`nth_binding_body n e` iterates `binding_body` `n` times to an iterated pi expression `e`.\n This definition doesn't instantiate bound variables, and therefore produces a term that is open.\n See note [open expressions] in mathlib.", "p": "core"}, {"name": "expr.lex_lt", "description": "Compares expressions, ignoring binder names.", "p": "core"}, {"name": "reflected.to_expr", "description": "", "p": "core"}, {"name": "expr.local_uniq_name", "description": "", "p": "core"}, {"name": "expr.get_app_num_args", "description": "", "p": "core"}, {"name": "expr.collect_univ_params", "description": "Get a list of all of the universe parameters that the given expression depends on.", "p": "core"}, {"name": "is_localization.at_prime.mk'_mem_maximal_iff", "description": "", "p": "mathlib"}, {"name": "is_localization.is_domain_of_local_at_prime", "description": "The localization of an integral domain at the complement of a prime ideal is an integral domain.", "p": "mathlib"}, {"name": "is_localization.at_prime", "description": " Given a prime ideal `P`, the typeclass `is_localization.at_prime S P` states that `S` is\nisomorphic to the localization of `R` at the complement of `P`.", "p": "mathlib"}, {"name": "localization.is_local_ring_hom_local_ring_hom", "description": "", "p": "mathlib"}, {"name": "is_localization.at_prime.local_ring", "description": "", "p": "mathlib"}, {"name": "localization.at_prime.local_ring", "description": "The localization of `R` at the complement of a prime ideal is a local ring.", "p": "mathlib"}, {"name": "localization.local_ring_hom_to_map", "description": "", "p": "mathlib"}, {"name": "ideal.prime_compl_le_non_zero_divisors", "description": "", "p": "mathlib"}, {"name": "localization.le_comap_prime_compl_iff", "description": "", "p": "mathlib"}, {"name": "ideal.prime_compl", "description": "The complement of a prime ideal `I \u2286 R` is a submonoid of `R`.", "p": "mathlib"}, {"name": "localization.at_prime.map_eq_maximal_ideal", "description": " The image of `I` in the localization at `I.prime_compl` is a maximal ideal, and in particular\nit is the unique maximal ideal given by the local ring structure `at_prime.local_ring`", "p": "mathlib"}, {"name": "is_localization.at_prime.nontrivial", "description": "", "p": "mathlib"}, {"name": "localization.at_prime.comap_maximal_ideal", "description": "The unique maximal ideal of the localization at `I.prime_compl` lies over the ideal `I`.", "p": "mathlib"}, {"name": "localization.local_ring_hom_id", "description": "", "p": "mathlib"}, {"name": "is_localization.at_prime.comap_maximal_ideal", "description": "", "p": "mathlib"}, {"name": "is_localization.at_prime.is_unit_mk'_iff", "description": "", "p": "mathlib"}, {"name": "localization.local_ring_hom_comp", "description": "", "p": "mathlib"}, {"name": "localization.local_ring_hom", "description": "For a ring hom `f : R \u2192+* S` and a prime ideal `J` in `S`, the induced ring hom from the\nlocalization of `R` at `J.comap f` to the localization of `S` at `J`.\n\nTo make this definition more flexible, we allow any ideal `I` of `R` as input, together with a proof\nthat `I = J.comap f`. This can be useful when `I` is not definitionally equal to `J.comap f`.", "p": "mathlib"}, {"name": "is_localization.at_prime.to_map_mem_maximal_iff", "description": "", "p": "mathlib"}, {"name": "localization.local_ring_hom_unique", "description": "", "p": "mathlib"}, {"name": "localization.at_prime", "description": " Given a prime ideal `P`, `localization.at_prime S P` is a localization of\n`R` at the complement of `P`, as a quotient type.", "p": "mathlib"}, {"name": "localization.local_ring_hom_mk'", "description": "", "p": "mathlib"}, {"name": "is_localization.at_prime.is_unit_to_map_iff", "description": "", "p": "mathlib"}, {"name": "module.finite_def", "description": "", "p": "mathlib"}, {"name": "module.finite.iff_add_group_fg", "description": "", "p": "mathlib"}, {"name": "submodule.fg_bsupr", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite", "description": " An algebra morphism `A \u2192\u2090[R] B` is finite if it is finite as ring morphism.\nIn other words, if `B` is finitely generated as `A`-module.", "p": "mathlib"}, {"name": "module.finite.tensor_product", "description": "", "p": "mathlib"}, {"name": "submodule.fg_span_singleton", "description": "", "p": "mathlib"}, {"name": "submodule.exists_mem_and_smul_eq_self_of_fg_of_le_smul", "description": "", "p": "mathlib"}, {"name": "submodule.fg_ker_comp", "description": " The kernel of the composition of two linear maps is finitely generated if both kernels are and\nthe first morphism is surjective.", "p": "mathlib"}, {"name": "submodule.fg_def", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite.of_comp_finite", "description": "", "p": "mathlib"}, {"name": "ring_hom.finite.comp", "description": "", "p": "mathlib"}, {"name": "submodule.fg.pow", "description": "", "p": "mathlib"}, {"name": "module.finite.pi", "description": "", "p": "mathlib"}, {"name": "module.finite.prod", "description": "", "p": "mathlib"}, {"name": "submodule.fg_pi", "description": "", "p": "mathlib"}, {"name": "submodule.fg_span", "description": "", "p": "mathlib"}, {"name": "module.finite.range", "description": "The range of a linear map from a finite module is finite.", "p": "mathlib"}, {"name": "module.finite.exists_fin", "description": "", "p": "mathlib"}, {"name": "ring_hom.finite", "description": "A ring morphism `A \u2192+* B` is `finite` if `B` is finitely generated as `A`-module.", "p": "mathlib"}, {"name": "module.finite.of_restrict_scalars_finite", "description": "", "p": "mathlib"}, {"name": "ideal.fg.map", "description": " The image of a finitely generated ideal is finitely generated.\n\nThis is the `ideal` version of `submodule.fg.map`.", "p": "mathlib"}, {"name": "ring_hom.finite.id", "description": "", "p": "mathlib"}, {"name": "submodule.fg", "description": "A submodule of `M` is finitely generated if it is the span of a finite subset of `M`.", "p": "mathlib"}, {"name": "ideal.fg_ker_comp", "description": "", "p": "mathlib"}, {"name": "submodule.fg_of_fg_map_injective", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite.comp", "description": "", "p": "mathlib"}, {"name": "ring_hom.finite.of_surjective", "description": "", "p": "mathlib"}, {"name": "submodule.fg_of_fg_map_of_fg_inf_ker", "description": " If 0 \u2192 M' \u2192 M \u2192 M'' \u2192 0 is exact and M' and M'' are\nfinitely generated then so is M.", "p": "mathlib"}, {"name": "module.finite.base_change", "description": "", "p": "mathlib"}, {"name": "subalgebra.fg_bot_to_submodule", "description": "", "p": "mathlib"}, {"name": "submodule.fg_finset_sup", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite.id", "description": "", "p": "mathlib"}, {"name": "submodule.fg_supr", "description": "", "p": "mathlib"}, {"name": "module.finite.iff_add_monoid_fg", "description": "", "p": "mathlib"}, {"name": "submodule.fg_restrict_scalars", "description": "", "p": "mathlib"}, {"name": "submodule.fg.stablizes_of_supr_eq", "description": "", "p": "mathlib"}, {"name": "submodule.fg_of_fg_map", "description": "", "p": "mathlib"}, {"name": "module.finite.equiv", "description": "", "p": "mathlib"}, {"name": "module.finite.map", "description": "Pushforwards of finite submodules are finite.", "p": "mathlib"}, {"name": "submodule.fg_of_linear_equiv", "description": "", "p": "mathlib"}, {"name": "submodule.fg.mul", "description": "", "p": "mathlib"}, {"name": "ideal.exists_radical_pow_le_of_fg", "description": "", "p": "mathlib"}, {"name": "module.finite.of_surjective", "description": "", "p": "mathlib"}, {"name": "submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul", "description": " **Nakayama's Lemma**. Atiyah-Macdonald 2.5, Eisenbud 4.7, Matsumura 2.2,\n[Stacks 00DV](https://stacks.math.columbia.edu/tag/00DV)", "p": "mathlib"}, {"name": "module.finite.trans", "description": "", "p": "mathlib"}, {"name": "submodule.fg_top", "description": "", "p": "mathlib"}, {"name": "submodule.fg.sup", "description": "", "p": "mathlib"}, {"name": "module.finite.self", "description": "", "p": "mathlib"}, {"name": "submodule.fg_iff_add_subgroup_fg", "description": "", "p": "mathlib"}, {"name": "submodule.fg_iff_add_submonoid_fg", "description": "", "p": "mathlib"}, {"name": "ideal.fg", "description": " An ideal of `R` is finitely generated if it is the span of a finite subset of `R`.\n\nThis is defeq to `submodule.fg`, but unfolds more nicely.", "p": "mathlib"}, {"name": "submodule.fg_of_is_unit", "description": "", "p": "mathlib"}, {"name": "ring_hom.finite.of_comp_finite", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite.of_surjective", "description": "", "p": "mathlib"}, {"name": "submodule.fg_bot", "description": "", "p": "mathlib"}, {"name": "module.finite", "description": "A module over a semiring is `finite` if it is finitely generated as a module.", "p": "mathlib"}, {"name": "module.finite.out", "description": "A module over a semiring is `finite` if it is finitely generated as a module.", "p": "mathlib"}, {"name": "submodule.fg_unit", "description": "", "p": "mathlib"}, {"name": "submodule.fg.prod", "description": "", "p": "mathlib"}, {"name": "submodule.fg_iff_exists_fin_generating_family", "description": "", "p": "mathlib"}, {"name": "submodule.fg.map\u2082", "description": "", "p": "mathlib"}, {"name": "submodule.fg.map", "description": "", "p": "mathlib"}, {"name": "submodule.fg_iff_compact", "description": "Finitely generated submodules are pr