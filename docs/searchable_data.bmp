at.iso.mk", "description": "Constructs an isomorphism of complete lattices from an order isomorphism between them.", "p": "mathlib"}, {"name": "CompleteLat.dual", "description": "`order_dual` as a functor.", "p": "mathlib"}, {"name": "CompleteLat.category_theory.large_category", "description": "", "p": "mathlib"}, {"name": "CompleteLat.dual_equiv", "description": "The equivalence between `CompleteLat` and itself induced by `order_dual` both ways.", "p": "mathlib"}, {"name": "CompleteLat.dual_obj", "description": "", "p": "mathlib"}, {"name": "CompleteLat_dual_comp_forget_to_BddLat", "description": "", "p": "mathlib"}, {"name": "CompleteLat.dual_map", "description": "", "p": "mathlib"}, {"name": "CompleteLat.iso.mk_hom", "description": "", "p": "mathlib"}, {"name": "wbtw", "description": "The point `y` is weakly between `x` and `z`.", "p": "mathlib"}, {"name": "wbtw_smul_vadd_smul_vadd_of_nonneg_of_nonpos", "description": "", "p": "mathlib"}, {"name": "mem_const_vsub_affine_segment", "description": "", "p": "mathlib"}, {"name": "sbtw_zero_one_iff", "description": "", "p": "mathlib"}, {"name": "wbtw_smul_vadd_smul_vadd_of_nonneg_of_le", "description": "", "p": "mathlib"}, {"name": "sbtw_iff_left_ne_and_right_mem_image_IoI", "description": "", "p": "mathlib"}, {"name": "affine_equiv.sbtw_map_iff", "description": "", "p": "mathlib"}, {"name": "affine_segment_same", "description": "", "p": "mathlib"}, {"name": "wbtw.mem_affine_span", "description": "", "p": "mathlib"}, {"name": "right_mem_affine_segment", "description": "", "p": "mathlib"}, {"name": "sbtw_midpoint_of_ne", "description": "", "p": "mathlib"}, {"name": "sbtw_vsub_const_iff", "description": "", "p": "mathlib"}, {"name": "wbtw_vadd_const_iff", "description": "", "p": "mathlib"}, {"name": "affine_segment_const_vadd_image", "description": "", "p": "mathlib"}, {"name": "wbtw_line_map_iff", "description": "", "p": "mathlib"}, {"name": "affine_segment", "description": " The segment of points weakly between `x` and