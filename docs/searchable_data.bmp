ory_theory.monad.algebra.hom.comp", "description": "Composition of Eilenberg\u2013Moore algebra homomorphisms.", "p": "mathlib"}, {"name": "category_theory.comonad.forget_map", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.forget_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_equiv_of_iso_monads_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra.hom.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_mono_of_mono", "description": "Given an algebra morphism whose carrier part is a monomorphism, we get an algebra monomorphism.", "p": "mathlib"}, {"name": "category_theory.comonad.forget_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_equiv_of_iso_monads_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.free", "description": "The free functor from the Eilenberg-Moore category, constructing an algebra for any object.", "p": "mathlib"}, {"name": "category_theory.monad.algebra.hom.h_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.forget", "description": "The forgetful functor from the Eilenberg-Moore category, forgetting the algebraic structure.", "p": "mathlib"}, {"name": "category_theory.monad.algebra.unit_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_equiv_of_iso_monads", "description": "Isomorphic monads give equivalent categories of algebras. Furthermore, they are equivalent as\ncategories over `C`, that is, we have `algebra_equiv_of_iso_monads h \u22d9 forget = forget`.", "p": "mathlib"}, {"name": "category_theory.monad.algebra.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.adj", "description": "The adjunction between the free and forgetful constructions for Eilenberg-Moore algebras for\n a monad. cf Lemma 5.2.8 of [Riehl][riehl2017].", "p": "mathlib"}, {"name": "category_theory.comonad.forget_faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_functor_of_monad_hom", "description": "Given a monad morphism from `T\u2082` to `T\u2081`, we get a functor from the algebras of `T\u2081` to algebras of\n`T\u2082`.", "p": "mathlib"}, {"name": "category_theory.monad.algebra.hom.h", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.free_obj_a", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_equiv_of_iso_monads_counit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra_iso_of_iso", "description": "Given a coalgebra morphism whose carrier part is an isomorphism, we get a coalgebra isomorphism.", "p": "mathlib"}, {"name": "category_theory.monad.free_map_f", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.of_left_adjoint_forget", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.hom.ext_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra.assoc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.cofree_map_f", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_functor_of_monad_hom_map_f", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra.comp_eq_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.cofree_obj_a", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.hom.h_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra.assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.algebra_mono_of_mono", "description": "Given a coalgebra morphism whose carrier part is a monomorphism, we get an algebra monomorphism.", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.category_theory.category_struct", "description": "The category of Eilenberg-Moore coalgebras for a comonad.", "p": "mathli