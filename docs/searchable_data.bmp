ame": "measure_theory.strongly_measurable_of_is_empty", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_fin_strongly_measurable.sigma_finite_set", "description": "A measurable set `t` such that `f =\u1d50[\u03bc.restrict t\u1d9c] 0` and `sigma_finite (\u03bc.restrict t)`.", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.mono'", "description": "", "p": "mathlib"}, {"name": "continuous.strongly_measurable", "description": " A continuous function is strongly measurable when either the source space or the target space\nis second-countable.", "p": "mathlib"}, {"name": "measure_theory.fin_strongly_measurable.neg", "description": "", "p": "mathlib"}, {"name": "exists_strongly_measurable_limit_of_tendsto_ae", "description": " If a sequence of almost everywhere strongly measurable functions converges almost everywhere,\none can select a strongly measurable function as the almost everywhere limit.", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.piecewise", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.measurable_set_support", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.fin_strongly_measurable_of_set_sigma_finite", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.norm", "description": "", "p": "mathlib"}, {"name": "multiset.strongly_measurable_prod'", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.const_add", "description": "", "p": "mathlib"}, {"name": "embedding.comp_strongly_measurable_iff", "description": "If `g` is a topological embedding, then `f` is strongly measurable iff `g \u2218 f` is.", "p": "mathlib"}, {"name": "continuous_linear_map.ae_strongly_measurable_comp\u2082", "description": "", "p": "mathlib"}, {"name": "is_unit.ae_strongly_measurable_const_smul_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.separable_space_range_union_singleto