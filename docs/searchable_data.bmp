name": "array.to_list_nth_le", "description": "", "p": "mathlib"}, {"name": "d_array.inhabited", "description": "", "p": "mathlib"}, {"name": "array.push_back_rev_list_aux", "description": "", "p": "mathlib"}, {"name": "array.mem_to_list_enum", "description": "", "p": "mathlib"}, {"name": "array.read_push_back_right", "description": "", "p": "mathlib"}, {"name": "fractional_ideal", "description": "The fractional ideals of a domain `R` are ideals of `R` divided by some `a \u2208 R`.\n\n More precisely, let `P` be a localization of `R` at some submonoid `S`,\n then a fractional ideal `I \u2286 P` is an `R`-submodule of `P`,\n such that there is a nonzero `a : R` with `a I \u2286 R`.", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_hom_apply", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mul_one_div_le_one", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_to_submodule_inj", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_sup", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.span_singleton", "description": "`span_singleton x` is the fractional ideal generated by `x` if `0 \u2209 S`", "p": "mathlib"}, {"name": "fractional_ideal.has_inf", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.span_singleton_zero", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.is_noetherian_zero", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.is_principal_iff", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_mul", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mul_induction_on", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_submodule_hom", "description": "`fractional_ideal.submodule.has_coe` as a bundled `ring_hom`.", "p": "mathlib"}, {"name": "fractional_ideal.order_bot", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.span_singleton_mul_le_iff", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_to_submodule_injective", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_top", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_le_coe_ideal'", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mul_self_le_self", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mem_coe_ideal_of_mem", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.one_div_span_singleton", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_inj", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_one_eq_coe_submodule_top", "description": " `(1 : fractional_ideal S P)` is defined as the R-submodule `f(R) \u2264 P`.\n\nHowever, this is not definitionally equal to `1 : submodule R P`,\nwhich is proved in the actual `simp` lemma `coe_one`.", "p": "mathlib"}, {"name": "fractional_ideal.set_like", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.has_add", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_div", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.has_mul", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mul_div_self_cancel_iff", "description": "", "p": "mathlib"}, {"name": "is_fractional.sup", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.map_equiv", "description": "If `g` is an equivalence, `map g` is an isomorphism", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_injective", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_fun_map_equiv", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.span_finset", "description": "`fractional_ideal.span_finset R\u2081 s f` is the fractional ideal of `R\u2081` generated by `f '' s`.", "p": "mathlib"}, {"name": "fractional_ideal.adjoin_integral_coe", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_mul", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mem_div_iff_of_non