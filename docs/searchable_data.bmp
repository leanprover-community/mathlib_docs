_mem_argmax", "description": "", "p": "mathlib"}, {"name": "list.minimum_mem", "description": "", "p": "mathlib"}, {"name": "list.mem_argmin_iff", "description": "", "p": "mathlib"}, {"name": "list.le_of_mem_argmin", "description": "", "p": "mathlib"}, {"name": "list.argmin_cons", "description": "", "p": "mathlib"}, {"name": "list.argmax", "description": " `argmax f l` returns `some a`, where `f a` is maximal among the elements of `l`, in the sense\nthat there is no `b \u2208 l` with `f a < f b`. If `a`, `b` are such that `f a = f b`, it returns\nwhichever of `a` or `b` comes first in the list. `argmax f []` = none`.", "p": "mathlib"}, {"name": "list.arg_aux", "description": "Auxiliary definition for `argmax` and `argmin`.", "p": "mathlib"}, {"name": "list.maximum", "description": " `maximum l` returns an `with_bot \u03b1`, the largest element of `l` for nonempty lists, and `\u22a5` for\n`[]`", "p": "mathlib"}, {"name": "list.not_lt_maximum_of_mem'", "description": "", "p": "mathlib"}, {"name": "list.not_lt_maximum_of_mem", "description": "", "p": "mathlib"}, {"name": "list.max_le_of_forall_le", "description": "", "p": "mathlib"}, {"name": "list.argmin_nil", "description": "", "p": "mathlib"}, {"name": "list.argmax_nil", "description": "", "p": "mathlib"}, {"name": "list.index_of_argmin", "description": "", "p": "mathlib"}, {"name": "list.minimum_not_lt_of_mem", "description": "", "p": "mathlib"}, {"name": "list.maximum_mem", "description": "", "p": "mathlib"}, {"name": "list.maximum_cons", "description": "", "p": "mathlib"}, {"name": "list.maximum_singleton", "description": "", "p": "mathlib"}, {"name": "list.argmin_eq_some_iff", "description": "", "p": "mathlib"}, {"name": "list.index_of_argmax", "description": "", "p": "mathlib"}, {"name": "list.argmax_eq_some_iff", "description": "", "p": "mathlib"}, {"name": "list.minimum_cons", "description": "", "p": "mathlib"}, {"name": "list.maximum_eq_none", "description": "", "p": "mathlib"}, {"name": "list.arg_aux_self", "description": "", "p": "mathlib"}, {"name": "list.maximum_concat", "description": "", "p": "mathlib"}, {"name": "list.maximum_eq_coe_iff", "description": "", "p": "mathlib"}, {"name": "list.argmax_singleton", "description": "", "p": "mathlib"}, {"name": "list.argmin", "description": " `argmin f l` returns `some a`, where `f a` is minimal among the elements of `l`, in the sense\nthat there is no `b \u2208 l` with `f b < f a`. If `a`, `b` are such that `f a = f b`, it returns\nwhichever of `a` or `b` comes first in the list. `argmin f []` = none`.", "p": "mathlib"}, {"name": "list.minimum_nil", "description": "", "p": "mathlib"}, {"name": "list.minimum_concat", "description": "", "p": "mathlib"}, {"name": "list.argmax_mem", "description": "", "p": "mathlib"}, {"name": "list.foldr_max_of_ne_nil", "description": "", "p": "mathlib"}, {"name": "list.foldr_min_of_ne_nil", "description": "", "p": "mathlib"}, {"name": "list.le_maximum_of_mem", "description": "", "p": "mathlib"}, {"name": "list.minimum_eq_none", "description": "", "p": "mathlib"}, {"name": "list.not_of_mem_foldl_arg_aux", "description": "", "p": "mathlib"}, {"name": "convex_halfspace_lt", "description": "", "p": "mathlib"}, {"name": "set.ord_connected.convex", "description": "", "p": "mathlib"}, {"name": "ite_eq_mem_std_simplex", "description": "", "p": "mathlib"}, {"name": "antitone_on.convex_lt", "description": "", "p": "mathlib"}, {"name": "convex_std_simplex", "description": "", "p": "mathlib"}, {"name": "directed_on.convex_sUnion", "description": "", "p": "mathlib"}, {"name": "antitone_on.convex_gt", "description": "", "p": "mathlib"}, {"name": "submodule.convex", "description": "", "p": "mathlib"}, {"name": "convex_pi", "description": "", "p": "mathlib"}, {"name": "affine_subspace.convex", "description": "Affine subspaces are convex.", "p": "mathlib"}, {"name": "antitone_on.convex_ge", "description": "", "p": "mathlib"}, {"name": "convex_iff_segment_subset", "description": "", "p": "mathlib"}, {"name"