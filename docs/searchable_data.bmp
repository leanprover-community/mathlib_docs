"description": "", "p": "mathlib"}, {"name": "finset.Ioo_eq_empty", "description": "", "p": "mathlib"}, {"name": "finset.image_add_right_Icc", "description": "", "p": "mathlib"}, {"name": "finset.map_add_right_Icc", "description": "", "p": "mathlib"}, {"name": "finset.Icc_subset_Ico_iff", "description": "", "p": "mathlib"}, {"name": "finset.Ioc_subset_Ioo_right", "description": "", "p": "mathlib"}, {"name": "finset.Ioc_subset_Ioc_left", "description": "", "p": "mathlib"}, {"name": "finset.uIcc_to_dual", "description": "", "p": "mathlib"}, {"name": "finset.Iio_insert", "description": "", "p": "mathlib"}, {"name": "finset.card_Ioo_eq_card_Ioc_sub_one", "description": "", "p": "mathlib"}, {"name": "finset.Ico_filter_le", "description": "", "p": "mathlib"}, {"name": "finset.disjoint_Ioi_Iio", "description": "", "p": "mathlib"}, {"name": "finset.Ico_subset_Ioo_left", "description": "", "p": "mathlib"}, {"name": "finset.nonempty_Ico", "description": "", "p": "mathlib"}, {"name": "finset.Icc_subset_uIcc'", "description": "", "p": "mathlib"}, {"name": "finset.Ioo_insert_left", "description": "", "p": "mathlib"}, {"name": "finset.left_mem_Ico", "description": "", "p": "mathlib"}, {"name": "finset.Iic_erase", "description": "", "p": "mathlib"}, {"name": "finset.nonempty_uIcc", "description": "", "p": "mathlib"}, {"name": "finset.Iio_filter_lt", "description": "", "p": "mathlib"}, {"name": "finset.Iic_eq_cons_Iio", "description": "`finset.cons` version of `finset.Iio_insert`.", "p": "mathlib"}, {"name": "finset.uIcc_of_not_ge", "description": "", "p": "mathlib"}, {"name": "finset.Ico_inter_Ico_consecutive", "description": "", "p": "mathlib"}, {"name": "set.infinite.exists_gt", "description": "", "p": "mathlib"}, {"name": "finset.card_Ioo_eq_card_Ico_sub_one", "description": "", "p": "mathlib"}, {"name": "finset.uIcc_subset_uIcc_left", "description": "", "p": "mathlib"}, {"name": "finset.mem_uIcc'", "description": "", "p": "mathlib"}, {"name": "finset.Ioc_subset_Icc_self", "description": "", "p": "mathlib"}, {"name": "finset.Ico_union_Ico'", "description": "", "p": "mathlib"}, {"name": "finset.nonempty_Ioc", "description": "", "p": "mathlib"}, {"name": "finset.Ioo_eq_empty_of_le", "description": "", "p": "mathlib"}, {"name": "finset.nonempty_Ioo", "description": "", "p": "mathlib"}, {"name": "finset.Ioo_subset_Ioo_right", "description": "", "p": "mathlib"}, {"name": "finset.Ioi_subset_Ici_self", "description": "", "p": "mathlib"}, {"name": "set.fintype_of_mem_bounds", "description": "A set with upper and lower bounds in a locally finite order is a fintype", "p": "mathlib"}, {"name": "finset.Icc_diff_both", "description": "", "p": "mathlib"}, {"name": "finset.Ico_filter_le_left", "description": "", "p": "mathlib"}, {"name": "finset.Ioo_insert_right", "description": "", "p": "mathlib"}, {"name": "finset.uIcc_comm", "description": "", "p": "mathlib"}, {"name": "finset.uIcc_subset_uIcc_union_uIcc", "description": "A sort of triangle inequality.", "p": "mathlib"}, {"name": "finset.Ioc_subset_Ioc", "description": "", "p": "mathlib"}, {"name": "finset.not_mem_uIcc_of_gt", "description": "", "p": "mathlib"}, {"name": "finset.Ioo_subset_Iic_self", "description": "", "p": "mathlib"}, {"name": "finset.filter_lt_eq_Ioi", "description": "", "p": "mathlib"}, {"name": "finset.Ico_inter_Ico", "description": "", "p": "mathlib"}, {"name": "finset.Ico_subset_Ico_left", "description": "", "p": "mathlib"}, {"name": "finset.eq_of_mem_uIcc_of_mem_uIcc", "description": "", "p": "mathlib"}, {"name": "finset.left_mem_Icc", "description": "", "p": "mathlib"}, {"name": "finset.map_add_left_Icc", "description": "", "p": "mathlib"}, {"name": "finset.Ico_subset_Iio_self", "description": "", "p": "mathlib"}, {"name": "finset.not_mem_Iio_self", "description": "", "p": "mathlib"}, {"name": "finset.filter_ge_eq_Iic", "description": "", "p": "mathlib"}, {"name": "finset.Icc_eq_singleton_iff", "description": "", "p": "mathlib"}, {"name": "finset.Icc_subset_Ioc_iff", "description": "", "p": "mathlib"}, {"name": "finset.Icc_subset_Ioo_iff", "description": "", "p": "mathlib"}, {"name": "finset.card_Ioi_eq_card_Ici_sub_one", "description": "", "p": "mathlib"}, {"name": "finset.Ioo_subset_Ico_self", "description": "", "p": "mathlib"}, {"name": "finset.Icc_eq_empty_of_lt", "description": "", "p": "mathlib"}, {"name": "finset.mem_uIcc_of_ge", "description": "", "p": "mathlib"}, {"name": "finset.Ico_subset_Icc_self", "description": "", "p": "mathlib"}, {"name": "finset.Ioc_filter_lt_of_lt_right", "description": "", "p": "mathlib"}, {"name": "finset.Ioi_insert", "description": "", "p": "mathlib"}, {"name": "finset.Icc_subset_Icc_iff", "description": "", "p": "mathlib"}, {"name": "finset.Icc_ssubset_Icc_right", "description": "", "p": "mathlib"}, {"name": "finset.uIcc_injective_right", "description": "", "p": "mathlib"}, {"name": "finset.Ico_eq_empty", "description": "**Alias** of the reverse direction of `finset.Ico_eq_empty_iff`.", "p": "mathlib"}, {"name": "homology_of_zero_right", "description": "The cokernel of the map `Im f \u27f6 Ker 0` is isomorphic to the cokernel of `f.`", "p": "mathlib"}, {"name": "image_to_kernel_arrow_apply", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_zero_right", "description": "", "p": "mathlib"}, {"name": "homology.comp_right_eq_comp_left", "description": "Auxiliary lemma for homology computations.", "p": "mathlib"}, {"name": "homology.map_iso", "description": "An isomorphism between two three-term complexes induces an isomorphism on homology.", "p": "mathlib"}, {"name": "homology.\u03c0_desc", "description": "", "p": "mathlib"}, {"name": "homology.\u03c0", "description": "The morphism from cycles to homology.", "p": "mathlib"}, {"name": "image_to_kernel_arrow_assoc", "description": "", "p": "mathlib"}, {"name": "image_subobject_iso_image_to_kernel'", "description": "", "p": "mathlib"}, {"name": "homology.\u03c0_map_apply", "description": "", "p": "mathlib"}, {"name": "homology.\u03c0_map_assoc", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_arrow", "description": "", "p": "mathlib"}, {"name": "homology.map_desc_apply", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_zero_left", "description": "", "p": "mathlib"}, {"name": "homology_iso_cokernel_lift", "description": "`homology f g w` can be computed as the cokernel of `kernel.lift g f w`.", "p": "mathlib"}, {"name": "homology_iso_cokernel_image_to_kernel'", "description": "`homology f g w` can be computed as the cokernel of `image_to_kernel' f g w`.", "p": "mathlib"}, {"name": "homology.map_desc_assoc", "description": "", "p": "mathlib"}, {"name": "homology.\u03c0_desc_assoc", "description": "", "p": "mathlib"}, {"name": "homology.map_comp_assoc", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_comp_right", "description": "", "p": "mathlib"}, {"name": "homology.\u03c0_map", "description": "", "p": "mathlib"}, {"name": "image_to_kernel.mono", "description": "", "p": "mathlib"}, {"name": "image_subobject_map_comp_image_to_kernel", "description": "Given compatible commutative squares between\na pair `f g` and a pair `f' g'` satisfying `f \u226b g = 0` and `f' \u226b g' = 0`,\nthe `image_to_kernel` morphisms intertwine the induced map on kernels and the induced map on images.", "p": "mathlib"}, {"name": "homology.desc", "description": "To construct a map out of homology, it suffices to construct a map out of the cycles\nwhich vanishes on boundaries.", "p": "mathlib"}, {"name": "image_le_kernel", "description": "", "p": "mathlib"}, {"name": "homology.ext", "description": "To check two morphisms out of `homology f g w` are equal, it suffices to check on cycles.", "p": "mathlib"}, {"name": "homology_zero_zero_inv", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_comp_left", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_epi_comp", "description": "", "p": "mathlib"}, {"name": "homology_of_zero_left", "description": "The kernel of the map `Im 0 \u27f6 Ker f` is isomorphic to the kernel of `f.`", "p": "mathlib"}, {"name": "homology.map_comp", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_comp_mono", "description": "", "p": "mathlib"}, {"name": "homology.congr_hom", "description": "", "p": "mathlib"}, {"name": "homology.map_desc", "description": "", "p": "mathlib"}, {"name": "homology_zero_zero", "description": "`homology 0 0 _` is just the middle object.", "p": "mathlib"}, {"name": "factor_thru_image_subobject_comp_image_to_kernel", "description": "", "p": "mathlib"}, {"name": "image_subobject_map_comp_image_to_kernel_assoc", "description": "", "p": "mathlib"}, {"name": "homology.\u03c0_desc_apply", "description": "", "p": "mathlib"}, {"name": "image_to_kernel", "description": "The canonical morphism `image_subobject f \u27f6 kernel_subobject g` when `f \u226b g = 0`.", "p": "mathlib"}, {"name": "homology.congr_inv", "description": "", "p": "mathlib"}, {"name": "image_to_kernel'", "description": "While `image_to_kernel f g w` provides a morphism\n`image_subobject f \u27f6 kernel_subobject g`\nin terms of the subobject API,\nthis variant provides a morphism\n`image f \u27f6 kernel g`,\nwhich is sometimes more convenient.", "p": "mathlib"}, {"name": "homology_zero_zero_hom", "description": "", "p": "mathlib"}, {"name": "homology.congr", "description": "`homology f g w \u2245 homology f' g' w'` if `f = f'` and `g = g'`.\n(Note the objects are not changing here.)", "p": "mathlib"}, {"name": "homology.map_id", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_epi_of_zero_of_mono", "description": "`image_to_kernel` for `A --0--> B --g--> C`, where `g` is a mono is itself an epi\n(i.e. the sequence is exact at `B`).", "p": "mathlib"}, {"name": "homology", "description": "The homology of a pair of morphisms `f : A \u27f6 B` and `g : B \u27f6 C` satisfying `f \u226b g = 0`\nis the cokernel of the `image_to_kernel` morphism for `f` and `g`.", "p": "mathlib"}, {"name": "image_to_kernel'_kernel_subobject_iso", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_epi_of_epi_of_zero", "description": "`image_to_kernel` for `A --f--> B --0--> C`, where `g` is an epi is itself an epi\n(i.e. the sequence is exact at `B`).", "p": "mathlib"}, {"name": "subobject_of_le_as_image_to_kernel", "description": "Prefer `image_to_kernel`.", "p": "mathlib"}, {"name": "homology.map", "description": "Given compatible commutative squares between\na pair `f g` and a pair `f' g'` satisfying `f \u226b g = 0` and `f' \u226b g' = 0`,\nwe get a morphism on homology.", "p": "mathlib"}, {"name": "homology.condition", "description": "", "p": "mathlib"}, {"name": "image_to_kernel_comp_hom_inv_comp", "description": "", "p": "mathlib"}, {"name": "order_iso.is_glb_preimage'", "description": "", "p": "mathlib"}, {"name": "order_iso.is_glb_image'", "description": "", "p": "mathlib"}, {"name": "order_iso.is_lub_image", "description": "", "p": "mathlib"}, {"name": "order_iso.is_glb_image", "description": "", "p": "mathlib"}, {"name": "order_iso.is_lub_image'", "description": "", "p": "mathlib"}, {"name": "order_iso.is_lub_preimage", "description": "", "p": "mathlib"}, {"name": "order_iso.upper_bounds_image", "description": "", "p": "mathlib"}, {"name": "order_iso.is_lub_preimage'", "description": "", "p": "mathlib"}, {"name": "order_iso.lower_bounds_image", "description": "", "p": "mathlib"}, {"name": "order_iso.is_glb_preimage", "description": "", "p": "mathlib"}, {"name": "polynomial.differentiable_on_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.fderiv_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.has_fderiv_within_at_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.has_deriv_at", "description": "The derivative (in the analysis sense) of a polynomial `p` is given by `p.derivative`.", "p": "mathlib"}, {"name": "polynomial.fderiv", "description": "", "p": "mathlib"}, {"name": "polynomial.differentiable", "description": "", "p": "mathlib"}, {"name": "polynomial.differentiable_within_at_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.has_fderiv_at_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.has_deriv_within_at_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.has_deriv_at_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.has_fderiv_at", "description": "", "p": "mathlib"}, {"name": "polynomial.differentiable_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.deriv_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.has_strict_deriv_at_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.fderiv_within_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.differentiable_within_at", "description": "", "p": "mathlib"}, {"name": "polynomial.differentiable_at", "description": "", "p": "mathlib"}, {"name": "polynomial.differentiable_at_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.has_fderiv_within_at", "description": "", "p": "mathlib"}, {"name": "polynomial.deriv", "description": "", "p": "mathlib"}, {"name": "polynomial.has_deriv_within_at", "description": "", "p": "mathlib"}, {"name": "polynomial.differentiable_on", "description": "", "p": "mathlib"}, {"name": "polynomial.fderiv_within", "description": "", "p": "mathlib"}, {"name": "polynomial.deriv_within_aeval", "description": "", "p": "mathlib"}, {"name": "polynomial.has_strict_deriv_at", "description": "The derivative (in the analysis sense) of a polynomial `p` is given by `p.derivative`.", "p": "mathlib"}, {"name": "polynomial.deriv_within", "description": "", "p": "mathlib"}, {"name": "lie_algebra.extend_scalars.tensor_product.has_bracket", "description": "", "p": "mathlib"}, {"name": "lie_algebra.restrict_scalars.lie_algebra", "description": "", "p": "mathlib"}, {"name": "lie_algebra.extend_scalars.lie_algebra", "description": "", "p": "mathlib"}, {"name": "lie_algebra.extend_scalars.bracket_tmul", "description": "", "p": "mathlib"}, {"name": "lie_algebra.extend_scalars.tensor_product.lie_ring", "description": "", "p": "mathlib"}, {"name": "lie_algebra.restrict_scalars.restrict_scalars.lie_ring", "description": "", "p": "mathlib"}, {"name": "to_additive.ignore_args_attr", "description": "An attribute that tells `@[to_additive]` that certain arguments of this definition are not\ninvolved when using `@[to_additive]`.\nThis helps the heuristic of `@[to_additive]` by also transforming definitions if `\u2115` or another\nfixed type occurs as one of these arguments.", "p": "mathlib"}, {"name": "tactic_doc.attribute.to_additive", "description": "The attribute `to_additive` can be used to automatically transport theorems\nand definitions (but not inductive types and structures) from a multiplicative\ntheory to an additive theory.\n\nTo use this attribute, just write:\n\n```lean\n@[to_additive]\ntheorem mul_comm' {\u03b1} [comm_semigroup \u03b1] (x y : \u03b1) : x * y = y * x := comm_semigroup.mul_comm\n```\n\nThis code will generate a theorem named `add_comm'`. It is also\npossible to manually specify the name of the new declaration:\n\n```lean\n@[to_additive add_foo]\ntheorem foo := sorry\n```\n\nAn existing documentation string will _not_ be automatically used, so if the theorem or definition\nhas a doc string, a doc string for the additive version should be passed explicitly to\n`to_additive`.\n\n```lean\n/-- Multiplication is commutative -/\n@[to_additive \"Addition is commutative\"]\ntheorem mul_comm' {\u03b1} [comm_semigroup \u03b1] (x y : \u03b1) : x * y = y * x := comm_semigroup.mul_comm\n```\n\nThe transport tries to do the right thing in most cases using several\nheuristics described below.  However, in some cases it fails, and\nrequires manual intervention.\n\nIf the declaration to be transported has attributes which need to be\ncopied to the additive version, then `to_additive` should come last:\n\n```lean\n@[simp, to_additive] lemma mul_one' {G : Type*} [group G] (x : G) : x * 1 = x := mul_one x\n```\n\nThe following attributes are supported and should be applied correctly by `to_additive` to\nthe new additivized declaration, if they were present on the original one:\n```lean\nreducible, _refl_lemma, simp, norm_cast, instance, refl, symm, trans, elab_as_eliminator, no_rsimp,\ncontinuity, ext, ematch, measurability, alias, _ext_core, _ext_lemma_core, nolint\n```\n\nThe exception to this rule is the `simps` attribute, which should come after `to_additive`:\n\n```lean\n@[to_additive, simps]\ninstance {M N} [has_mul M] [has_mul N] : has_mul (M \u00d7 N) := \u27e8\u03bb p q, \u27e8p.1 * q.1, p.2 * q.2\u27e9\u27e9\n```\n\nAdditionally the `mono` attribute is not handled by `to_additive` and should be applied afterwards\nto both the original and additivized lemma.\n\n## Implementation notes\n\nThe transport process generally works by taking all the names of\nidentifiers appearing in the name, type, and body of a declaration and\ncreating a new declaration by mapping those names to additive versions\nusing a simple string-based dictionary and also using all declarations\nthat have previously been labeled with `to_additive`.\n\nIn the `mul_comm'` example above, `to_additive` maps:\n* `mul_comm'` to `add_comm'`,\n* `comm_semigroup` to `add_comm_semigroup`,\n* `x * y` to `x + y` and `y * x` to `y + x`, and\n* `comm_semigroup.mul_comm'` to `add_comm_semigroup.add_comm'`.\n\n### Heuristics\n\n`to_additive` uses heuristics to determine whether a particular identifier has to be\nmapped to its additive version. The basic heuristic is\n\n* Only map an identifier to its additive version if its first argument doesn't\n  contain any unapplied identifiers.\n\nExamples:\n* `@has_mul.mul \u2115 n m` (i.e. `(n * m : \u2115)`) will not change to `+`, since its\n  first argument is `\u2115`, an identifier not applied to any arguments.\n* `@has_mul.mul (\u03b1 \u00d7 \u03b2) x y` will change to `+`. It's first argument contains only the identifier\n  `prod`, but this is applied to arguments, `\u03b1` and `\u03b2`.\n* `@has_mul.mul (\u03b1 \u00d7 \u2124) x y` will not change to `+`, since its first argument contains `\u2124`.\n\nThe reasoning behind the heuristic is that the first argument is the type which is \"additivized\",\nand this usually doesn't make sense if this is on a fixed type.\n\nThere are some exceptions to this heuristic:\n\n* Identifiers that have the `@[to_additive]` attribute are ignored.\n  For example, multiplication in `\u21a5Semigroup` is replaced by addition in `\u21a5AddSemigroup`.\n* If an identifier `d` has attribute `@[to_additive_relevant_arg n]` then the argument\n  in position `n` is checked for a fixed type, instead of checking the first argument.\n  `@[to_additive]` will automatically add the attribute `@[to_additive_relevant_arg n]` to a\n  declaration when the first argument has no multiplicative type-class, but argument `n` does.\n* If an identifier has attribute `@[to_additive_ignore_args n1 n2 ...]` then all the arguments in\n  positions `n1`, `n2`, ... will not be checked for unapplied identifiers (start counting from 1).\n  For example, `cont_mdiff_map` has attribute `@[to_additive_ignore_args 21]`, which means\n  that its 21st argument `(n : \u2115\u221e)` can contain `\u2115`\n  (usually in the form `has_top.top \u2115 ...`) and still be additivized.\n  So `@has_mul.mul (C^\u221e\u27eeI, N; I', G\u27ef) _ f g` will be additivized.\n\n### Troubleshooting\n\nIf `@[to_additive]` fails because the additive declaration raises a type mismatch, there are\nvarious things you can try.\nThe first thing to do is to figure out what `@[to_additive]` did wrong by looking at the type\nmismatch error.\n\n* Option 1: It additivized a declaration `d` that should remain multiplicative. Solution:\n  * Make sure the first argument of `d` is a type with a multiplicative structure. If not, can you\n    reorder the (implicit) arguments of `d` so that the first argument becomes a type with a\n    multiplicative structure (and not some indexing type)?\n    The reason is that `@[to_additive]` doesn't additivize declarations if their first argument\n    contains fixed types like `\u2115` or `\u211d`. See section Heuristics.\n    If the first argument is not the argument with a multiplicative type-class, `@[to_additive]`\n    should have automatically added the attribute `@[to_additive_relevant_arg]` to the declaration.\n    You can test this by running the following (where `d` is the full name of the declaration):\n    ```lean\n      run_cmd to_additive.relevant_arg_attr.get_param `d >>= tactic.trace\n    ```\n    The expected output is `n` where the `n`-th argument of `d` is a type (family) with a\n    multiplicative structure on it. If you get a different output (or a failure), you could add\n    the attribute `@[to_additive_relevant_arg n]` manually, where `n` is an argument with a\n    multiplicative structure.\n* Option 2: It didn't additivize a declaration that should be additivized.\n  This happened because the heuristic applied, and the first argument contains a fixed type,\n  like `\u2115` or `\u211d`. Solutions:\n  * If the fixed type has an additive counterpart (like `\u21a5Semigroup`), give it the `@[to_additive]`\n    attribute.\n  * If the fixed type occurs inside the `k`-th argument of a declaration `d`, and the\n    `k`-th argument is not connected to the multiplicative structure on `d`, consider adding\n    attribute `[to_additive_ignore_args k]` to `d`.\n  * If you want to disable the heuristic and replace all multiplicative\n    identifiers with their additive counterpart, use `@[to_additive!]`.\n* Option 3: Arguments / universe levels are incorrectly ordered in the additive version.\n  This likely only happens when the multiplicative declaration involves `pow`/`^`. Solutions:\n  * Ensure that the order of arguments of all relevant declarations are the same for the\n    multiplicative and additive version. This might mean that arguments have an \"unnatural\" order\n    (e.g. `monoid.npow n x` corresponds to `x ^ n`, but it is convenient that `monoid.npow` has this\n    argument order, since it matches `add_monoid.nsmul n x`.\n  * If this is not possible, add the `[to_additive_reorder k]` to the multiplicative declaration\n    to indicate that the `k`-th and `(k+1)`-st arguments are reordered in the additive version.\n\nIf neither of these solutions work, and `to_additive` is unable to automatically generate the\nadditive version of a declaration, manually write and prove the additive version.\nOften the proof of a lemma/theorem can just be the multiplicative version of the lemma applied to\n`multiplicative G`.\nAfterwards, apply the attribute manually:\n\n```lean\nattribute [to_additive foo_add_bar] foo_bar\n```\n\nThis will allow future uses of `to_additive` to recognize that\n`foo_bar` should be replaced with `foo_add_bar`.\n\n### Handling of hidden definitions\n\nBefore transporting the \u201cmain\u201d declaration `src`, `to_additive` first\nscans its type and value for names starting with `src`, and transports\nthem. This includes auxiliary definitions like `src._match_1`,\n`src._proof_1`.\n\nIn addition to transporting the \u201cmain\u201d declaration, `to_additive` transports\nits equational lemmas and tags them as equational lemmas for the new declaration,\nattributes present on the original equational lemmas are also transferred first (notably\n`_refl_lemma`).\n\n### Structure fields and constructors\n\nIf `src` is a structure, then `to_additive` automatically adds\nstructure fields to its mapping, and similarly for constructors of\ninductive types.\n\nFor new structures this means that `to_additive` automatically handles\ncoercions, and for old structures it does the same, if ancestry\ninformation is present in `@[ancestor]` attributes. The `ancestor`\nattribute must come before the `to_additive` attribute, and it is\nessential that the order of the base structures passed to `ancestor` matches\nbetween the multiplicative and additive versions of the structure.\n\n### Name generation\n\n* If `@[to_additive]` is called without a `name` argument, then the\n  new name is autogenerated.  First, it takes the longest prefix of\n  the source name that is already known to `to_additive`, and replaces\n  this prefix with its additive counterpart. Second, it takes the last\n  part of the name (i.e., after the last dot), and replaces common\n  name parts (\u201cmul\u201d, \u201cone\u201d, \u201cinv\u201d, \u201cprod\u201d) with their additive versions.\n\n* Namespaces can be transformed using `map_namespace`. For example:\n  ```lean\n  run_cmd to_additive.map_namespace `quotient_group `quotient_add_group\n  ```\n\n  Later uses of `to_additive` on declarations in the `quotient_group`\n  namespace will be created in the `quotient_add_group` namespaces.\n\n* If `@[to_additive]` is called with a `name` argument `new_name`\n  /without a dot/, then `to_additive` updates the prefix as described\n  above, then replaces the last part of the name with `new_name`.\n\n* If `@[to_additive]` is called with a `name` argument\n  `new_namespace.new_name` /with a dot/, then `to_additive` uses this\n  new name as is.\n\nAs a safety check, in the first case `to_additive` double checks\nthat the new name differs from the original one.", "p": "mathlib"}, {"name": "to_additive.target_name", "description": "Return the provided target name or autogenerate one if one was not provided.", "p": "mathlib"}, {"name": "to_additive.proceed_fields", "description": " Add the `aux_attr` attribute to the structure fields of `src`\nso that future uses of `to_additive` will map them to the corresponding `tgt` fields.", "p": "mathlib"}, {"name": "to_additive.guess_name", "description": "Autogenerate target name for `to_additive`.", "p": "mathlib"}, {"name": "to_additive.value_type", "description": " `value_type` is the type of the arguments that can be provided to `to_additive`.\n`to_additive.parser` parses the provided arguments:\n* `replace_all`: replace all multiplicative declarations, do not use the heuristic.\n* `trace`: output the generated additive declaration.\n* `tgt : name`: the name of the target (the additive declaration).\n* `doc`: an optional doc string.\n* if `allow_auto_name` is `ff` (default) then `@[to_additive]` will check whether the given name\n  can be auto-generated.", "p": "mathlib"}, {"name": "to_additive.value_type.replace_all", "description": " `value_type` is the type of the arguments that can be provided to `to_additive`.\n`to_additive.parser` parses the provided arguments:\n* `replace_all`: replace all multiplicative declarations, do not use the heuristic.\n* `trace`: output the generated additive declaration.\n* `tgt : name`: the name of the target (the additive declaration).\n* `doc`: an optional doc string.\n* if `allow_auto_name` is `ff` (default) then `@[to_additive]` will check whether the given name\n  can be auto-generated.", "p": "mathlib"}, {"name": "to_additive.value_type.trace", "description": " `value_type` is the type of the arguments that can be provided to `to_additive`.\n`to_additive.parser` parses the provided arguments:\n* `replace_all`: replace all multiplicative declarations, do not use the heuristic.\n* `trace`: output the generated additive declaration.\n* `tgt : name`: the name of the target (the additive declaration).\n* `doc`: an optional doc string.\n* if `allow_auto_name` is `ff` (default) then `@[to_additive]` will check whether the given name\n  can be auto-generated.", "p": "mathlib"}, {"name": "to_additive.value_type.tgt", "description": " `value_type` is the type of the arguments that can be provided to `to_additive`.\n`to_additive.parser` parses the provided arguments:\n* `replace_all`: replace all multiplicative declarations, do not use the heuristic.\n* `trace`: output the generated additive declaration.\n* `tgt : name`: the name of the target (the additive declaration).\n* `doc`: an optional doc string.\n* if `allow_auto_name` is `ff` (default) then `@[to_additive]` will check whether the given name\n  can be auto-generated.", "p": "mathlib"}, {"name": "to_additive.value_type.doc", "description": " `value_type` is the type of the arguments that can be provided to `to_additive`.\n`to_additive.parser` parses the provided arguments:\n* `replace_all`: replace all multiplicative declarations, do not use the heuristic.\n* `trace`: output the generated additive declaration.\n* `tgt : name`: the name of the target (the additive declaration).\n* `doc`: an optional doc string.\n* if `allow_auto_name` is `ff` (default) then `@[to_additive]` will check whether the given name\n  can be auto-generated.", "p": "mathlib"}, {"name": "to_additive.value_type.allow_auto_name", "description": " `value_type` is the type of the arguments that can be provided to `to_additive`.\n`to_additive.parser` parses the provided arguments:\n* `replace_all`: replace all multiplicative declarations, do not use the heuristic.\n* `trace`: output the generated additive declaration.\n* `tgt : name`: the name of the target (the additive declaration).\n* `doc`: an optional doc string.\n* if `allow_auto_name` is `ff` (default) then `@[to_additive]` will check whether the given name\n  can be auto-generated.", "p": "mathlib"}, {"name": "to_additive.parser", "description": "the parser for the arguments to `to_additive`.", "p": "mathlib"}, {"name": "linter.to_additive_doc", "description": " A linter that checks that multiplicative and additive lemmas have both doc strings if one of\nthem has one", "p": "mathlib"}, {"name": "to_additive.value_type.has_reflect", "description": "", "p": "mathlib"}, {"name": "to_additive.tr", "description": "Dictionary used by `to_additive.guess_name` to autogenerate names.", "p": "mathlib"}, {"name": "to_additive.map_namespace", "description": " A command that can be used to have future uses of `to_additive` change the `src` namespace\nto the `tgt` namespace.\n\nFor example:\n```lean\nrun_cmd to_additive.map_namespace `quotient_group `quotient_add_group\n```\n\nLater uses of `to_additive` on declarations in the `quotient_group` namespace will be created\nin the `quotient_add_group` namespaces.", "p": "mathlib"}, {"name": "to_additive.value_type.inhabited", "description": "", "p": "mathlib"}, {"name": "to_additive.reorder_attr", "description": "An attribute that stores all the declarations that needs their arguments reordered when\napplying `@[to_additive]`. Currently, we only support swapping consecutive arguments.\nThe list of the natural numbers contains the positions of the first of the two arguments\nto be swapped.\nIf the first two arguments are swapped, the first two universe variables are also swapped.\nExample: `@[to_additive_reorder 1 4]` swaps the first two arguments and the arguments in\npositions 4 and 5.", "p": "mathlib"}, {"name": "to_additive.aux_attr", "description": " An auxiliary attribute used to store the names of the additive versions of declarations\nthat have been processed by `to_additive`.", "p": "mathlib"}, {"name": "to_additive.first_multiplicative_arg", "description": "Find the first argument of `nm` that has a multiplicative type-class on it.\nReturns 1 if there are no types with a multiplicative class as arguments.\nE.g. `prod.group` returns 1, and `pi.has_one` returns 2.", "p": "mathlib"}, {"name": "to_additive.relevant_arg_attr", "description": "An attribute that is automatically added to declarations tagged with `@[to_additive]`, if needed.\n\nThis attribute tells which argument is the type where this declaration uses the multiplicative\nstructure. If there are multiple argument, we typically tag the first one.\nIf this argument contains a fixed type, this declaration will note be additivized.\nSee the Heuristics section of `to_additive.attr` for more details.\n\nIf a declaration is not tagged, it is presumed that the first argument is relevant.\n`@[to_additive]` uses the function `to_additive.first_multiplicative_arg` to automatically tag\ndeclarations. It is ok to update it manually if the automatic tagging made an error.\n\nImplementation note: we only allow exactly 1 relevant argument, even though some declarations\n(like `prod.group`) have multiple arguments with a multiplicative structure on it.\nThe reason is that whether we additivize a declaration is an all-or-nothing decision, and if\nwe will not be able to additivize declarations that (e.g.) talk about multiplication on `\u2115 \u00d7 \u03b1`\nanyway.\n\nWarning: adding `@[to_additive_reorder]` with an equal or smaller number than the number in this\nattribute is currently not supported.", "p": "mathlib"}, {"name": "to_additive.attr", "description": "The attribute `to_additive` can be used to automatically transport theorems\nand definitions (but not inductive types and structures) from a multiplicative\ntheory to an additive theory.\n\nTo use this attribute, just write:\n\n```lean\n@[to_additive]\ntheorem mul_comm' {\u03b1} [comm_semigroup \u03b1] (x y : \u03b1) : x * y = y * x := comm_semigroup.mul_comm\n```\n\nThis code will generate a theorem named `add_comm'`. It is also\npossible to manually specify the name of the new declaration:\n\n```lean\n@[to_additive add_foo]\ntheorem foo := sorry\n```\n\nAn existing documentation string will _not_ be automatically used, so if the theorem or definition\nhas a doc string, a doc string for the additive version should be passed explicitly to\n`to_additive`.\n\n```lean\n/-- Multiplication is commutative -/\n@[to_additive \"Addition is commutative\"]\ntheorem mul_comm' {\u03b1} [comm_semigroup \u03b1] (x y : \u03b1) : x * y = y * x := comm_semigroup.mul_comm\n```\n\nThe transport tries to do the right thing in most cases using several\nheuristics described below.  However, in some cases it fails, and\nrequires manual intervention.\n\nIf the declaration to be transported has attributes which need to be\ncopied to the additive version, then `to_additive` should come last:\n\n```lean\n@[simp, to_additive] lemma mul_one' {G : Type*} [group G] (x : G) : x * 1 = x := mul_one x\n```\n\nThe following attributes are supported and should be applied correctly by `to_additive` to\nthe new additivized declaration, if they were present on the original one:\n```lean\nreducible, _refl_lemma, simp, norm_cast, instance, refl, symm, trans, elab_as_eliminator, no_rsimp,\ncontinuity, ext, ematch, measurability, alias, _ext_core, _ext_lemma_core, nolint\n```\n\nThe exception to this rule is the `simps` attribute, which should come after `to_additive`:\n\n```lean\n@[to_additive, simps]\ninstance {M N} [has_mul M] [has_mul N] : has_mul (M \u00d7 N) := \u27e8\u03bb p q, \u27e8p.1 * q.1, p.2 * q.2\u27e9\u27e9\n```\n\nAdditionally the `mono` attribute is not handled by `to_additive` and should be applied afterwards\nto both the original and additivized lemma.\n\n## Implementation notes\n\nThe transport process generally works by taking all the names of\nidentifiers appearing in the name, type, and body of a declaration and\ncreating a new declaration by mapping those names to additive versions\nusing a simple string-based dictionary and also using all declarations\nthat have previously been labeled with `to_additive`.\n\nIn the `mul_comm'` example above, `to_additive` maps:\n* `mul_comm'` to `add_comm'`,\n* `comm_semigroup` to `add_comm_semigroup`,\n* `x * y` to `x + y` and `y * x` to `y + x`, and\n* `comm_semigroup.mul_comm'` to `add_comm_semigroup.add_comm'`.\n\n### Heuristics\n\n`to_additive` uses heuristics to determine whether a particular identifier has to be\nmapped to its additive version. The basic heuristic is\n\n* Only map an identifier to its additive version if its first argument doesn't\n  contain any unapplied identifiers.\n\nExamples:\n* `@has_mul.mul \u2115 n m` (i.e. `(n * m : \u2115)`) will not change to `+`, since its\n  first argument is `\u2115`, an identifier not applied to any arguments.\n* `@has_mul.mul (\u03b1 \u00d7 \u03b2) x y` will change to `+`. It's first argument contains only the identifier\n  `prod`, but this is applied to arguments, `\u03b1` and `\u03b2`.\n* `@has_mul.mul (\u03b1 \u00d7 \u2124) x y` will not change to `+`, since its first argument contains `\u2124`.\n\nThe reasoning behind the heuristic is that the first argument is the type which is \"additivized\",\nand this usually doesn't make sense if this is on a fixed type.\n\nThere are some exceptions to this heuristic:\n\n* Identifiers that have the `@[to_additive]` attribute are ignored.\n  For example, multiplication in `\u21a5Semigroup` is replaced by addition in `\u21a5AddSemigroup`.\n* If an identifier `d` has attribute `@[to_additive_relevant_arg n]` then the argument\n  in position `n` is checked for a fixed type, instead of checking the first argument.\n  `@[to_additive]` will automatically add the attribute `@[to_additive_relevant_arg n]` to a\n  declaration when the first argument has no multiplicative type-class, but argument `n` does.\n* If an identifier has attribute `@[to_additive_ignore_args n1 n2 ...]` then all the arguments in\n  positions `n1`, `n2`, ... will not be checked for unapplied identifiers (start counting from 1).\n  For example, `cont_mdiff_map` has attribute `@[to_additive_ignore_args 21]`, which means\n  that its 21st argument `(n : \u2115\u221e)` can contain `\u2115`\n  (usually in the form `has_top.top \u2115 ...`) and still be additivized.\n  So `@has_mul.mul (C^\u221e\u27eeI, N; I', G\u27ef) _ f g` will be additivized.\n\n### Troubleshooting\n\nIf `@[to_additive]` fails because the additive declaration raises a type mismatch, there are\nvarious things you can try.\nThe first thing to do is to figure out what `@[to_additive]` did wrong by looking at the type\nmismatch error.\n\n* Option 1: It additivized a declaration `d` that should remain multiplicative. Solution:\n  * Make sure the first argument of `d` is a type with a multiplicative structure. If not, can you\n    reorder the (implicit) arguments of `d` so that the first argument becomes a type with a\n    multiplicative structure (and not some indexing type)?\n    The reason is that `@[to_additive]` doesn't additivize declarations if their first argument\n    contains fixed types like `\u2115` or `\u211d`. See section Heuristics.\n    If the first argument is not the argument with a multiplicative type-class, `@[to_additive]`\n    should have automatically added the attribute `@[to_additive_relevant_arg]` to the declaration.\n    You can test this by running the following (where `d` is the full name of the declaration):\n    ```lean\n      run_cmd to_additive.relevant_arg_attr.get_param `d >>= tactic.trace\n    ```\n    The expected output is `n` where the `n`-th argument of `d` is a type (family) with a\n    multiplicative structure on it. If you get a different output (or a failure), you could add\n    the attribute `@[to_additive_relevant_arg n]` manually, where `n` is an argument with a\n    multiplicative structure.\n* Option 2: It didn't additivize a declaration that should be additivized.\n  This happened because the heuristic applied, and the first argument contains a fixed type,\n  like `\u2115` or `\u211d`. Solutions:\n  * If the fixed type has an additive counterpart (like `\u21a5Semigroup`), give it the `@[to_additive]`\n    attribute.\n  * If the fixed type occurs inside the `k`-th argument of a declaration `d`, and the\n    `k`-th argument is not connected to the multiplicative structure on `d`, consider adding\n    attribute `[to_additive_ignore_args k]` to `d`.\n  * If you want to disable the heuristic and replace all multiplicative\n    identifiers with their additive counterpart, use `@[to_additive!]`.\n* Option 3: Arguments / universe levels are incorrectly ordered in the additive version.\n  This likely only happens when the multiplicative declaration involves `pow`/`^`. Solutions:\n  * Ensure that the order of arguments of all relevant declarations are the same for the\n    multiplicative and additive version. This might mean that arguments have an \"unnatural\" order\n    (e.g. `monoid.npow n x` corresponds to `x ^ n`, but it is convenient that `monoid.npow` has this\n    argument order, since it matches `add_monoid.nsmul n x`.\n  * If this is not possible, add the `[to_additive_reorder k]` to the multiplicative declaration\n    to indicate that the `k`-th and `(k+1)`-st arguments are reordered in the additive version.\n\nIf neither of these solutions work, and `to_additive` is unable to automatically generate the\nadditive version of a declaration, manually write and prove the additive version.\nOften the proof of a lemma/theorem can just be the multiplicative version of the lemma applied to\n`multiplicative G`.\nAfterwards, apply the attribute manually:\n\n```lean\nattribute [to_additive foo_add_bar] foo_bar\n```\n\nThis will allow future uses of `to_additive` to recognize that\n`foo_bar` should be replaced with `foo_add_bar`.\n\n### Handling of hidden definitions\n\nBefore transporting the \u201cmain\u201d declaration `src`, `to_additive` first\nscans its type and value for names starting with `src`, and transports\nthem. This includes auxiliary definitions like `src._match_1`,\n`src._proof_1`.\n\nIn addition to transporting the \u201cmain\u201d declaration, `to_additive` transports\nits equational lemmas and tags them as equational lemmas for the new declaration,\nattributes present on the original equational lemmas are also transferred first (notably\n`_refl_lemma`).\n\n### Structure fields and constructors\n\nIf `src` is a structure, then `to_additive` automatically adds\nstructure fields to its mapping, and similarly for constructors of\ninductive types.\n\nFor new structures this means that `to_additive` automatically handles\ncoercions, and for old structures it does the same, if ancestry\ninformation is present in `@[ancestor]` attributes. The `ancestor`\nattribute must come before the `to_additive` attribute, and it is\nessential that the order of the base structures passed to `ancestor` matches\nbetween the multiplicative and additive versions of the structure.\n\n### Name generation\n\n* If `@[to_additive]` is called without a `name` argument, then the\n  new name is autogenerated.  First, it takes the longest prefix of\n  the source name that is already known to `to_additive`, and replaces\n  this prefix with its additive counterpart. Second, it takes the last\n  part of the name (i.e., after the last dot), and replaces common\n  name parts (\u201cmul\u201d, \u201cone\u201d, \u201cinv\u201d, \u201cprod\u201d) with their additive versions.\n\n* Namespaces can be transformed using `map_namespace`. For example:\n  ```lean\n  run_cmd to_additive.map_namespace `quotient_group `quotient_add_group\n  ```\n\n  Later uses of `to_additive` on declarations in the `quotient_group`\n  namespace will be created in the `quotient_add_group` namespaces.\n\n* If `@[to_additive]` is called with a `name` argument `new_name`\n  /without a dot/, then `to_additive` updates the prefix as described\n  above, then replaces the last part of the name with `new_name`.\n\n* If `@[to_additive]` is called with a `name` argument\n  `new_namespace.new_name` /with a dot/, then `to_additive` uses this\n  new name as is.\n\nAs a safety check, in the first case `to_additive` double checks\nthat the new name differs from the original one.", "p": "mathlib"}, {"name": "to_additive.add_comm_prefix", "description": "`add_comm_prefix x s` returns `\"comm_\" ++ s` if `x = tt` and `s` otherwise.", "p": "mathlib"}, {"name": "to_additive.hacky_name_reflect", "description": "Temporarily change the `has_reflect` instance for `name`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.squash_seq", "description": "Given a sequence of gcf.pairs `s = [(a\u2080, b\u2092), (a\u2081, b\u2081), ...]`, `squash_seq s n`\ncombines `\u27e8a\u2099, b\u2099\u27e9` and `\u27e8a\u2099\u208a\u2081, b\u2099\u208a\u2081\u27e9` at position `n` to `\u27e8a\u2099, b\u2099 + a\u2099\u208a\u2081 / b\u2099\u208a\u2081\u27e9`. For example,\n`squash_seq s 0 = [(a\u2080, b\u2092 + a\u2081 / b\u2081), (a\u2081, b\u2081),...]`.\nIf `s.terminated_at (n + 1)`, then `squash_seq s n = s`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.squash_seq_nth_of_lt", "description": "The values before the squashed position stay the same.", "p": "mathlib"}, {"name": "generalized_continued_fraction.squash_gcf", "description": "Given a gcf `g = [h; (a\u2080, b\u2092), (a\u2081, b\u2081), ...]`, we have\n- `squash_nth.gcf g 0 = [h + a\u2080 / b\u2080); (a\u2080, b\u2092), ...]`,\n- `squash_nth.gcf g (n + 1) = \u27e8g.h, squash_seq g.s n\u27e9`", "p": "mathlib"}, {"name": "generalized_continued_fraction.squash_seq_succ_n_tail_eq_squash_seq_tail_n", "description": " Squashing at position `n + 1` and taking the tail is the same as squashing the tail of the\nsequence at position `n`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.squash_gcf_eq_self_of_terminated", "description": "If the gcf already terminated at position `n`, nothing gets squashed.", "p": "mathlib"}, {"name": "generalized_continued_fraction.succ_succ_nth_convergent'_aux_eq_succ_nth_convergent'_aux_squash_seq", "description": " The auxiliary function `convergents'_aux` returns the same value for a sequence and the\ncorresponding squashed sequence at the squashed position.", "p": "mathlib"}, {"name": "generalized_continued_fraction.succ_nth_convergent_eq_squash_gcf_nth_convergent", "description": " The convergents coincide in the expected way at the squashed position if the partial denominator\nat the squashed position is not zero.", "p": "mathlib"}, {"name": "generalized_continued_fraction.squash_gcf_nth_of_lt", "description": "The values before the squashed position stay the same.", "p": "mathlib"}, {"name": "continued_fraction.convergents_eq_convergents'", "description": " Shows that the recurrence relation (`convergents`) and direct evaluation (`convergents'`) of a\n(regular) continued fraction coincide.", "p": "mathlib"}, {"name": "generalized_continued_fraction.continuants_aux_eq_continuants_aux_squash_gcf_of_le", "description": "The auxiliary continuants before the squashed position stay the same.", "p": "mathlib"}, {"name": "generalized_continued_fraction.squash_seq_eq_self_of_terminated", "description": "If the sequence already terminated at position `n + 1`, nothing gets squashed.", "p": "mathlib"}, {"name": "generalized_continued_fraction.squash_seq_nth_of_not_terminated", "description": " If the sequence has not terminated before position `n + 1`, the value at `n + 1` gets\nsquashed into position `n`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.succ_nth_convergent'_eq_squash_gcf_nth_convergent'", "description": " `convergents'` returns the same value for a gcf and the corresponding squashed gcf at the\nsquashed position.", "p": "mathlib"}, {"name": "generalized_continued_fraction.convergents_eq_convergents'", "description": " Shows that the recurrence relation (`convergents`) and direct evaluation (`convergents'`) of the\ngcf coincide at position `n` if the sequence of fractions contains strictly positive values only.\nRequiring positivity of all values is just one possible condition to obtain this result.\nFor example, the dual - sequences with strictly negative values only - would also work.\n\nIn practice, one most commonly deals with (regular) continued fractions, which satisfy the\npositivity criterion required here. The analogous result for them\n(see `continued_fractions.convergents_eq_convergents`) hence follows directly from this theorem.", "p": "mathlib"}, {"name": "category_theory.limits.map_\u03c0_preserves_coequalizer_inv_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_of_is_colimit_cofork_map", "description": "The property of reflecting coequalizers expressed in terms of coforks.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_coequalizer.iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_equalizer.iso", "description": "If `G` preserves the equalizer of `(f,g)`, then the equalizer comparison map for `G` at `(f,g)` is\nan isomorphism.", "p": "mathlib"}, {"name": "category_theory.limits.coequalizer_comparison.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.map_\u03c0_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_cofork_map_of_is_colimit", "description": "The property of preserving coequalizers expressed in terms of coforks.", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_map_cocone_cofork_equiv", "description": "The map of a cofork is a colimit iff the cofork consisting of the mapped morphisms is a colimit.\nThis essentially lets us commute `cofork.of_\u03c0` with `functor.map_cocone`.", "p": "mathlib"}, {"name": "category_theory.limits.map_\u03c0_preserves_coequalizer_inv_colim_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_map_cone_fork_equiv", "description": "The map of a fork is a limit iff the fork consisting of the mapped morphisms is a limit. This\nessentially lets us commute `fork.of_\u03b9` with `functor.map_cone`.", "p": "mathlib"}, {"name": "category_theory.limits.map_\u03c0_preserves_coequalizer_inv_colim_map_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_of_is_limit_fork_map", "description": "The property of reflecting equalizers expressed in terms of forks.", "p": "mathlib"}, {"name": "category_theory.limits.equalizer_comparison.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_equalizer.iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_coequalizer.iso", "description": "If `G` preserves the coequalizer of `(f,g)`, then the coequalizer comparison map for `G` at `(f,g)`\nis an isomorphism.", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_of_has_coequalizer_of_preserves_colimit", "description": "If `G` preserves coequalizers and `C` has them, then the cofork constructed of the mapped morphisms\nof a cofork is a colimit.", "p": "mathlib"}, {"name": "category_theory.limits.map_\u03c0_preserves_coequalizer_inv_colim_map_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.of_iso_comparison", "description": "If the coequalizer comparison map for `G` at `(f,g)` is an isomorphism, then `G` preserves the\ncoequalizer of `(f,g)`.", "p": "mathlib"}, {"name": "category_theory.limits.map_\u03c0_preserves_coequalizer_inv_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.map_\u03c0_preserves_coequalizer_inv_colim_map_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_of_has_equalizer_of_preserves_limit", "description": "If `G` preserves equalizers and `C` has them, then the fork constructed of the mapped morphisms of\na fork is a limit.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_equalizer.of_iso_comparison", "description": "If the equalizer comparison map for `G` at `(f,g)` is an isomorphism, then `G` preserves the\nequalizer of `(f,g)`.", "p": "mathlib"}, {"name": "category_theory.limits.map_\u03c0_preserves_coequalizer_inv_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_fork_map_of_is_limit", "description": "The property of preserving equalizers expressed in terms of forks.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_split_coequalizers", "description": "Any functor preserves coequalizers of split pairs.", "p": "mathlib"}, {"name": "category_theory.limits.map_\u03c0_preserves_coequalizer_inv", "description": "", "p": "mathlib"}, {"name": "linarith.pcomp", "description": "A `pcomp` stores a linear comparison `\u03a3 c\u1d62*x\u1d62 R 0`,\nalong with information about how this comparison was derived.\nThe original expressions fed into `linarith` are each assigned a unique natural number label.\nThe *historical set* `pcomp.history` stores the labels of expressions\nthat were used in deriving the current `pcomp`.\nVariables are also indexed by natural numbers. The sets `PComp.effective`, `PComp.implicit`,\nand `PComp.vars` contain variable indices.\n* `pcomp.vars` contains the variables that appear in any inequality in the historical set.\n* `pcomp.effective` contains the variables that have been effectively eliminated from `pcomp`.\n  A variable `n` is said to be *effectively eliminated* in `p : pcomp` if the elimination of `n`\n  produced at least one of the ancestors of `p` (or `p` itself).\n* `pcomp.implicit` contains the variables that have been implicitly eliminated from `pcomp`.\n  A variable `n` is said to be *implicitly eliminated* in `p` if it satisfies the following\n  properties:\n  - `n` appears in some inequality in the historical set (i.e. in `p.vars`).\n  - `n` does not appear in `p.c.vars` (i.e. it has been eliminated).\n  - `n` was not effectively eliminated.\n\nWe track these sets in order to compute whether the history of a `pcomp` is *minimal*.\nChecking this directly is expensive, but effective approximations can be defined in terms of these\nsets. During the variable elimination process, a `pcomp` with non-minimal history can be discarded.", "p": "mathlib"}, {"name": "linarith.pcomp.c", "description": "A `pcomp` stores a linear comparison `\u03a3 c\u1d62*x\u1d62 R 0`,\nalong with information about how this comparison was derived.\nThe original expressions fed into `linarith` are each assigned a unique natural number label.\nThe *historical set* `pcomp.history` stores the labels of expressions\nthat were used in deriving the current `pcomp`.\nVariables are also indexed by natural numbers. The sets `PComp.effective`, `PComp.implicit`,\nand `PComp.vars` contain variable indices.\n* `pcomp.vars` contains the variables that appear in any inequality in the historical set.\n* `pcomp.effective` contains the variables that have been effectively eliminated from `pcomp`.\n  A variable `n` is said to be *effectively eliminated* in `p : pcomp` if the elimination of `n`\n  produced at least one of the ancestors of `p` (or `p` itself).\n* `pcomp.implicit` contains the variables that have been implicitly eliminated from `pcomp`.\n  A variable `n` is said to be *implicitly eliminated* in `p` if it satisfies the following\n  properties:\n  - `n` appears in some inequality in the historical set (i.e. in `p.vars`).\n  - `n` does not appear in `p.c.vars` (i.e. it has been eliminated).\n  - `n` was not effectively eliminated.\n\nWe track these sets in order to compute whether the history of a `pcomp` is *minimal*.\nChecking this directly is expensive, but effective approximations can be defined in terms of these\nsets. During the variable elimination process, a `pcomp` with non-minimal history can be discarded.", "p": "mathlib"}, {"name": "linarith.pcomp.src", "description": "A `pcomp` stores a linear comparison `\u03a3 c\u1d62*x\u1d62 R 0`,\nalong with information about how this comparison was derived.\nThe original expressions fed into `linarith` are each assigned a unique natural number label.\nThe *historical set* `pcomp.history` stores the labels of expressions\nthat were used in deriving the current `pcomp`.\nVariables are also indexed by natural numbers. The sets `PComp.effective`, `PComp.implicit`,\nand `PComp.vars` contain variable indices.\n* `pcomp.vars` contains the variables that appear in any inequality in the historical set.\n* `pcomp.effective` contains the variables that have been effectively eliminated from `pcomp`.\n  A variable `n` is said to be *effectively eliminated* in `p : pcomp` if the elimination of `n`\n  produced at least one of the ancestors of `p` (or `p` itself).\n* `pcomp.implicit` contains the variables that have been implicitly eliminated from `pcomp`.\n  A variable `n` is said to be *implicitly eliminated* in `p` if it satisfies the following\n  properties:\n  - `n` appears in some inequality in the historical set (i.e. in `p.vars`).\n  - `n` does not appear in `p.c.vars` (i.e. it has been eliminated).\n  - `n` was not effectively eliminated.\n\nWe track these sets in order to compute whether the history of a `pcomp` is *minimal*.\nChecking this directly is expensive, but effective approximations can be defined in terms of these\nsets. During the variable elimination process, a `pcomp` with non-minimal history can be discarded.", "p": "mathlib"}, {"name": "linarith.pcomp.history", "description": "A `pcomp` stores a linear comparison `\u03a3 c\u1d62*x\u1d62 R 0`,\nalong with information about how this comparison was derived.\nThe original expressions fed into `linarith` are each assigned a unique natural number label.\nThe *historical set* `pcomp.history` stores the labels of expressions\nthat were used in deriving the current `pcomp`.\nVariables are also indexed by natural numbers. The sets `PComp.effective`, `PComp.implicit`,\nand `PComp.vars` contain variable indices.\n* `pcomp.vars` contains the variables that appear in any inequality in the historical set.\n* `pcomp.effective` contains the variables that have been effectively eliminated from `pcomp`.\n  A variable `n` is said to be *effectively eliminated* in `p : pcomp` if the elimination of `n`\n  produced at least one of the ancestors of `p` (or `p` itself).\n* `pcomp.implicit` contains the variables that have been implicitly eliminated from `pcomp`.\n  A variable `n` is said to be *implicitly eliminated* in `p` if it satisfies the following\n  properties:\n  - `n` appears in some inequality in the historical set (i.e. in `p.vars`).\n  - `n` does not appear in `p.c.vars` (i.e. it has been eliminated).\n  - `n` was not effectively eliminated.\n\nWe track these sets in order to compute whether the history of a `pcomp` is *minimal*.\nChecking this directly is expensive, but effective approximations can be defined in terms of these\nsets. During the variable elimination process, a `pcomp` with non-minimal history can be discarded.", "p": "mathlib"}, {"name": "linarith.pcomp.effective", "description": "A `pcomp` stores a linear comparison `\u03a3 c\u1d62*x\u1d62 R 0`,\nalong with information about how this comparison was derived.\nThe original expressions fed into `linarith` are each assigned a unique natural number label.\nThe *historical set* `pcomp.history` stores the labels of expressions\nthat were used in deriving the current `pcomp`.\nVariables are also indexed by natural numbers. The sets `PComp.effective`, `PComp.implicit`,\nand `PComp.vars` contain variable indices.\n* `pcomp.vars` contains the variables that appear in any inequality in the historical set.\n* `pcomp.effective` contains the variables that have been effectively eliminated from `pcomp`.\n  A variable `n` is said to be *effectively eliminated* in `p : pcomp` if the elimination of `n`\n  produced at least one of the ancestors of `p` (or `p` itself).\n* `pcomp.implicit` contains the variables that have been implicitly eliminated from `pcomp`.\n  A variable `n` is said to be *implicitly eliminated* in `p` if it satisfies the following\n  properties:\n  - `n` appears in some inequality in the historical set (i.e. in `p.vars`).\n  - `n` does not appear in `p.c.vars` (i.e. it has been eliminated).\n  - `n` was not effectively eliminated.\n\nWe track these sets in order to compute whether the history of a `pcomp` is *minimal*.\nChecking this directly is expensive, but effective approximations can be defined in terms of these\nsets. During the variable elimination process, a `pcomp` with non-minimal history can be discarded.", "p": "mathlib"}, {"name": "linarith.pcomp.implicit", "description": "A `pcomp` stores a linear comparison `\u03a3 c\u1d62*x\u1d62 R 0`,\nalong with information about how this comparison was derived.\nThe original expressions fed into `linarith` are each assigned a unique natural number label.\nThe *historical set* `pcomp.history` stores the labels of expressions\nthat were used in deriving the current `pcomp`.\nVariables are also indexed by natural numbers. The sets `PComp.effective`, `PComp.implicit`,\nand `PComp.vars` contain variable indices.\n* `pcomp.vars` contains the variables that appear in any inequality in the historical set.\n* `pcomp.effective` contains the variables that have been effectively eliminated from `pcomp`.\n  A variable `n` is said to be *effectively eliminated* in `p : pcomp` if the elimination of `n`\n  produced at least one of the ancestors of `p` (or `p` itself).\n* `pcomp.implicit` contains the variables that have been implicitly eliminated from `pcomp`.\n  A variable `n` is said to be *implicitly eliminated* in `p` if it satisfies the following\n  properties:\n  - `n` appears in some inequality in the historical set (i.e. in `p.vars`).\n  - `n` does not appear in `p.c.vars` (i.e. it has been eliminated).\n  - `n` was not effectively eliminated.\n\nWe track these sets in order to compute whether the history of a `pcomp` is *minimal*.\nChecking this directly is expensive, but effective approximations can be defined in terms of these\nsets. During the variable elimination process, a `pcomp` with non-minimal history can be discarded.", "p": "mathlib"}, {"name": "linarith.pcomp.vars", "description": "A `pcomp` stores a linear comparison `\u03a3 c\u1d62*x\u1d62 R 0`,\nalong with information about how this comparison was derived.\nThe original expressions fed into `linarith` are each assigned a unique natural number label.\nThe *historical set* `pcomp.history` stores the labels of expressions\nthat were used in deriving the current `pcomp`.\nVariables are also indexed by natural numbers. The sets `PComp.effective`, `PComp.implicit`,\nand `PComp.vars` contain variable indices.\n* `pcomp.vars` contains the variables that appear in any inequality in the historical set.\n* `pcomp.effective` contains the variables that have been effectively eliminated from `pcomp`.\n  A variable `n` is said to be *effectively eliminated* in `p : pcomp` if the elimination of `n`\n  produced at least one of the ancestors of `p` (or `p` itself).\n* `pcomp.implicit` contains the variables that have been implicitly eliminated from `pcomp`.\n  A variable `n` is said to be *implicitly eliminated* in `p` if it satisfies the following\n  properties:\n  - `n` appears in some inequality in the historical set (i.e. in `p.vars`).\n  - `n` does not appear in `p.c.vars` (i.e. it has been eliminated).\n  - `n` was not effectively eliminated.\n\nWe track these sets in order to compute whether the history of a `pcomp` is *minimal*.\nChecking this directly is expensive, but effective approximations can be defined in terms of these\nsets. During the variable elimination process, a `pcomp` with non-minimal history can be discarded.", "p": "mathlib"}, {"name": "linarith.comp_source", "description": "`comp_source` tracks the source of a comparison.\nThe atomic source of a comparison is an assumption, indexed by a natural number.\nTwo comparisons can be added to produce a new comparison,\nand one comparison can be scaled by a natural number to produce a new comparison.", "p": "mathlib"}, {"name": "linarith.comp_source.assump", "description": "`comp_source` tracks the source of a comparison.\nThe atomic source of a comparison is an assumption, indexed by a natural number.\nTwo comparisons can be added to produce a new comparison,\nand one comparison can be scaled by a natural number to produce a new comparison.", "p": "mathlib"}, {"name": "linarith.comp_source.add", "description": "`comp_source` tracks the source of a comparison.\nThe atomic source of a comparison is an assumption, indexed by a natural number.\nTwo comparisons can be added to produce a new comparison,\nand one comparison can be scaled by a natural number to produce a new comparison.", "p": "mathlib"}, {"name": "linarith.comp_source.scale", "description": "`comp_source` tracks the source of a comparison.\nThe atomic source of a comparison is an assumption, indexed by a natural number.\nTwo comparisons can be added to produce a new comparison,\nand one comparison can be scaled by a natural number to produce a new comparison.", "p": "mathlib"}, {"name": "linarith.pcomp.cmp", "description": "The `comp_source` field is ignored when comparing `pcomp`s. Two `pcomp`s proving the same\ncomparison, with different sources, are considered equivalent.", "p": "mathlib"}, {"name": "linarith.get_max_var", "description": "Returns the current max variable.", "p": "mathlib"}, {"name": "linarith.pcomp.scale", "description": "`pcomp.scale c n` scales the coefficients of `c` by `n` and notes this in the `comp_source`.", "p": "mathlib"}, {"name": "linarith.elim_all_vars", "description": "`elim_all_vars` eliminates all variables from the linarith state, leaving it with a set of\nground comparisons. If this succeeds without exception, the original `linarith` state is consistent.", "p": "mathlib"}, {"name": "linarith.pcomp.add", "description": "`pcomp.add c1 c2 elim_var` creates the result of summing the linear comparisons `c1` and `c2`,\nduring the process of eliminating the variable `elim_var`.\nThe computation assumes, but does not enforce, that `elim_var` appears in both `c1` and `c2`\nand does not appear in the sum.\nComputing the sum of the two comparisons is easy; the complicated details lie in tracking the\nadditional fields of `pcomp`.\n* The historical set `pcomp.history` of `c1 + c2` is the union of the two historical sets.\n* `vars` is the union of `c1.vars` and `c2.vars`.\n* The effectively eliminated variables of `c1 + c2` are the union of the two effective sets,\n  with `elim_var` inserted.\n* The implicitly eliminated variables of `c1 + c2` are those that appear in\n  `vars` but not `c.vars` or `effective`.\n(Note that the description of the implicitly eliminated variables of `c1 + c2` in the algorithm\ndescribed in Section 6 of https://doi.org/10.1016/B978-0-444-88771-9.50019-2 seems to be wrong:\nthat says it should be `(c1.implicit.union c2.implicit).sdiff explicit`.\nSince the implicitly eliminated sets start off empty for the assumption,\nthis formula would leave them always empty.)", "p": "mathlib"}, {"name": "linarith.comp_source.inhabited", "description": "", "p": "mathlib"}, {"name": "linarith.pelim_var", "description": "`pelim_var p1 p2` calls `elim_var` on the `comp` components of `p1` and `p2`.\nIf this returns `v1` and `v2`, it creates a new `pcomp` equal to `v1*p1 + v2*p2`,\nand tracks this in the `comp_source`.", "p": "mathlib"}, {"name": "linarith.elim_var", "description": " If `c1` and `c2` both contain variable `a` with opposite coefficients,\nproduces `v1` and `v2` such that `a` has been cancelled in `v1*c1 + v2*c2`.", "p": "mathlib"}, {"name": "linarith.linarith_monad.monad_except", "description": "", "p": "mathlib"}, {"name": "linarith.get_comps", "description": "Return the current comparison set.", "p": "mathlib"}, {"name": "linarith.fourier_motzkin.produce_certificate", "description": "`produce_certificate hyps vars` tries to derive a contradiction from the comparisons in `hyps`\nby eliminating all variables \u2264 `max_var`.\nIf successful, it returns a map `coeff : \u2115 \u2192 \u2115` as a certificate.\nThis map represents that we can find a contradiction by taking the sum  `\u2211 (coeff i) * hyps[i]`.", "p": "mathlib"}, {"name": "linarith.pcomp.to_format", "description": "", "p": "mathlib"}, {"name": "linarith.pcomp.maybe_minimal", "description": "Any comparison whose history is not minimal is redundant,\nand need not be included in the new set of comparisons.\n`elimed_ge : \u2115` is a natural number such that all variables with index \u2265 `elimed_ge` have been\nremoved from the system.\n\nThis test is an overapproximation to minimality. It gives necessary but not sufficient conditions.\nIf the history of `c` is minimal, then `c.maybe_minimal` is true,\nbut `c.maybe_minimal` may also be true for some `c` with minimal history.\nThus, if `c.maybe_minimal` is false, `c` is known not to be minimal and must be redundant.\nSee https://doi.org/10.1016/B978-0-444-88771-9.50019-2 (Theorem 13).\nThe condition described there considers only implicitly eliminated variables that have been\nofficially eliminated from the system. This is not the case for every implicitly eliminated\nvariable. Consider eliminating `z` from `{x + y + z < 0, x - y - z < 0}`. The result is the set\n`{2*x < 0}`; `y` is implicitly but not officially eliminated.\n\nThis implementation of Fourier-Motzkin elimination processes variables in decreasing order of\nindices. Immediately after a step that eliminates variable `k`, variable `k'` has been eliminated\niff `k' \u2265 k`. Thus we can compute the intersection of officially and implicitly eliminated variables\nby taking the set of implicitly eliminated variables with indices \u2265 `elimed_ge`.", "p": "mathlib"}, {"name": "linarith.pcomp.assump", "description": "`pcomp.assump c n` creates a `pcomp` whose comparison is `c` and whose source is\n`comp_source.assump n`, that is, `c` is derived from the `n`th hypothesis.\nThe history is the singleton set `{n}`.\nNo variables have been eliminated (effectively or implicitly).", "p": "mathlib"}, {"name": "linarith.pcomp.is_contr", "description": "A `pcomp` represents a contradiction if its `comp` field represents a contradiction.", "p": "mathlib"}, {"name": "linarith.linarith_monad", "description": "The linarith monad extends an exceptional monad with a `linarith_structure` state.\nAn exception produces a contradictory `pcomp`.", "p": "mathlib"}, {"name": "linarith.validate", "description": "Throws an exception if a contradictory `pcomp` is contained in the current state.", "p": "mathlib"}, {"name": "linarith.mk_linarith_structure", "description": "`mk_linarith_structure hyps vars` takes a list of hypotheses and the largest variable present in\nthose hypotheses. It produces an initial state for the elimination monad.", "p": "mathlib"}, {"name": "linarith.linarith_monad.monad", "description": "", "p": "mathlib"}, {"name": "linarith.elim_with_set", "description": "`elim_var_with_set a p comps` collects the result of calling `pelim_var p p' a`\nfor every `p' \u2208 comps`.", "p": "mathlib"}, {"name": "linarith.update", "description": "Updates the current state with a new max variable and comparisons,\nand calls `validate` to check for a contradiction.", "p": "mathlib"}, {"name": "linarith.linarith_structure", "description": "The state for the elimination monad.\n* `max_var`: the largest variable index that has not been eliminated.\n* `comps`: a set of comparisons\n\nThe elimination procedure proceeds by eliminating variable `v` from `comps` progressively\nin decreasing order.", "p": "mathlib"}, {"name": "linarith.linarith_structure.max_var", "description": "The state for the elimination monad.\n* `max_var`: the largest variable index that has not been eliminated.\n* `comps`: a set of comparisons\n\nThe elimination procedure proceeds by eliminating variable `v` from `comps` progressively\nin decreasing order.", "p": "mathlib"}, {"name": "linarith.linarith_structure.comps", "description": "The state for the elimination monad.\n* `max_var`: the largest variable index that has not been eliminated.\n* `comps`: a set of comparisons\n\nThe elimination procedure proceeds by eliminating variable `v` from `comps` progressively\nin decreasing order.", "p": "mathlib"}, {"name": "linarith.monad.elim_var", "description": "`monad.elim_var a` performs one round of Fourier-Motzkin elimination, eliminating the variable `a`\nfrom the `linarith` state.", "p": "mathlib"}, {"name": "linarith.comp_source.to_string", "description": "Formats a `comp_source` for printing.", "p": "mathlib"}, {"name": "linarith.comp_source.has_to_format", "description": "", "p": "mathlib"}, {"name": "linarith.mk_pcomp_set", "description": " Creates an empty set of `pcomp`s, sorted using `pcomp.cmp`. This should always be used instead\nof `mk_rb_map` for performance reasons.", "p": "mathlib"}, {"name": "linarith.comp_source.flatten", "description": "Given a `comp_source` `cs`, `cs.flatten` maps an assumption index\nto the number of copies of that assumption that appear in the history of `cs`.\n\nFor example, suppose `cs` is produced by scaling assumption 2 by 5,\nand adding to that the sum of assumptions 1 and 2.\n`cs.flatten` maps `1 \u21a6 1, 2 \u21a6 6`.", "p": "mathlib"}, {"name": "linarith.split_set_by_var_sign", "description": "`split_set_by_var_sign a comps` partitions the set `comps` into three parts.\n* `pos` contains the elements of `comps` in which `a` has a positive coefficient.\n* `neg` contains the elements of `comps` in which `a` has a negative coefficient.\n* `not_present` contains the elements of `comps` in which `a` has coefficient 0.\n\nReturns `(pos, neg, not_present)`.", "p": "mathlib"}, {"name": "div_le_div_right\u2080", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_left\u2080'_symm", "description": "", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.to_linear_ordered_comm_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "mul_inv_le_iff\u2080", "description": "", "p": "mathlib"}, {"name": "le_div_iff\u2080", "description": "", "p": "mathlib"}, {"name": "inv_le_inv\u2080", "description": "", "p": "mathlib"}, {"name": "lt_of_mul_lt_mul_of_le\u2080", "description": "", "p": "mathlib"}, {"name": "div_le_iff\u2080", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_left\u2080'_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_right\u2080'_apply", "description": "", "p": "mathlib"}, {"name": "additive.linear_ordered_add_comm_group_with_top", "description": "", "p": "mathlib"}, {"name": "mul_le_mul_right\u2080", "description": "", "p": "mathlib"}, {"name": "div_le_div_left\u2080", "description": "", "p": "mathlib"}, {"name": "le_mul_inv_of_mul_le", "description": "", "p": "mathlib"}, {"name": "mul_inv_lt_of_lt_mul\u2080", "description": "", "p": "mathlib"}, {"name": "le_mul_inv_iff\u2080", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_left\u2080'_to_equiv", "description": "", "p": "mathlib"}, {"name": "multiplicative.linear_ordered_comm_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "mul_le_one\u2080", "description": "Alias of `mul_le_one'` for unification.", "p": "mathlib"}, {"name": "mul_le_mul_left\u2080", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_right\u2080'", "description": " `equiv.mul_right\u2080` as an order_iso on a `linear_ordered_comm_group_with_zero.`.\n\nNote that `order_iso.mul_right\u2080` refers to the `linear_ordered_field` version.", "p": "mathlib"}, {"name": "one_le_mul\u2080", "description": "Alias of `one_le_mul'` for unification.", "p": "mathlib"}, {"name": "additive.linear_ordered_add_comm_monoid_with_top", "description": "", "p": "mathlib"}, {"name": "inv_lt_inv\u2080", "description": "", "p": "mathlib"}, {"name": "multiplicative.linear_ordered_comm_group_with_zero", "description": "", "p": "mathlib"}, {"name": "one_le_inv\u2080", "description": "", "p": "mathlib"}, {"name": "le_of_le_mul_right", "description": "", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.to_comm_group_with_zero", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_left\u2080'", "description": " `equiv.mul_left\u2080` as an order_iso on a `linear_ordered_comm_group_with_zero.`.\n\nNote that `order_iso.mul_left\u2080` refers to the `linear_ordered_field` version.", "p": "mathlib"}, {"name": "units.zero_lt", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_right\u2080'_symm", "description": "", "p": "mathlib"}, {"name": "ne_zero_of_lt", "description": "", "p": "mathlib"}, {"name": "mul_inv_le_of_le_mul", "description": "", "p": "mathlib"}, {"name": "zero_le'", "description": "", "p": "mathlib"}, {"name": "inv_le_one\u2080", "description": "", "p": "mathlib"}, {"name": "mul_lt_mul\u2080", "description": "", "p": "mathlib"}, {"name": "div_le_div\u2080", "description": "", "p": "mathlib"}, {"name": "mul_lt_right\u2080", "description": "", "p": "mathlib"}, {"name": "mul_lt_mul_of_lt_of_le\u2080", "description": "", "p": "mathlib"}, {"name": "function.injective.linear_ordered_comm_monoid_with_zero", "description": " Pullback a `linear_ordered_comm_monoid_with_zero` under an injective map.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "zero_lt_iff", "description": "", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.le", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.lt", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.le_refl", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.le_trans", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.lt_iff_le_not_le", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.le_antisymm", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.le_total", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.decidable_le", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.decidable_eq", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.decidable_lt", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.max", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.max_def", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.min", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.min_def", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.mul", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.mul_assoc", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.one", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.one_mul", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.mul_one", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.npow", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.npow_zero'", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.npow_succ'", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.mul_comm", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.mul_le_mul_left", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.zero", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.zero_mul", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.mul_zero", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.zero_le_one", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.inv", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.div", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.div_eq_mul_inv", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.zpow", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.zpow_zero'", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.zpow_succ'", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.zpow_neg'", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.exists_pair_ne", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.inv_zero", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_group_with_zero.mul_inv_cancel", "description": "A linearly ordered commutative group with a zero element.", "p": "mathlib"}, {"name": "not_lt_zero'", "description": "", "p": "mathlib"}, {"name": "le_zero_iff", "description": "", "p": "mathlib"}, {"name": "with_zero.linear_ordered_comm_group_with_zero", "description": "", "p": "mathlib"}, {"name": "with_zero.linear_ordered_comm_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_right\u2080'_to_equiv", "description": "", "p": "mathlib"}, {"name": "inv_mul_lt_of_lt_mul\u2080", "description": "", "p": "mathlib"}, {"name": "zsqrtd.bit1_im", "description": "", "p": "mathlib"}, {"name": "zsqrtd.nonnegg_pos_neg", "description": "", "p": "mathlib"}, {"name": "zsqrtd.nonneg_antisymm", "description": "", "p": "mathlib"}, {"name": "zsqrtd.norm_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "zsqrtd.norm_int_cast", "description": "", "p": "mathlib"}, {"name": "zsqrtd.coe_int_sub", "description": "", "p": "mathlib"}, {"name": "zsqrtd.bit1_re", "description": "", "p": "mathlib"}, {"name": "zsqrtd.has_zero", "description": "The zero of the ring", "p": "mathlib"}, {"name": "zsqrtd.of_int_re", "description": "", "p": "mathlib"}, {"name": "zsqrtd.norm_conj", "description": "", "p": "mathlib"}, {"name": "zsqrtd.le_arch", "description": "", "p": "mathlib"}, {"name": "zsqrtd.of_int", "description": "Convert an integer to a `\u2124\u221ad`", "p": "mathlib"}, {"name": "zsqrtd.star_im", "description": "", "p": "mathlib"}, {"name": "zsqrtd.nonneg_mul_lem", "description": "", "p": "mathlib"}, {"name": "zsqrtd.decompose", "description": "", "p": "m