mathlib"}, {"name": "lie_subalgebra.hom_of_le", "description": " Given two nested Lie subalgebras `K \u2286 K'`, the inclusion `K \u21aa K'` is a morphism of Lie\nalgebras.", "p": "mathlib"}, {"name": "lie_subalgebra.module", "description": "A Lie subalgebra inherits module structures from `L`.", "p": "mathlib"}, {"name": "lie_subalgebra.mem_coe", "description": "", "p": "mathlib"}, {"name": "lie_equiv.lie_subalgebra_map_apply", "description": "", "p": "mathlib"}, {"name": "submodule.exists_lie_subalgebra_coe_eq_iff", "description": "", "p": "mathlib"}, {"name": "lie_subalgebra.has_top", "description": "", "p": "mathlib"}, {"name": "lie_subalgebra.inf_coe", "description": "", "p": "mathlib"}, {"name": "lie_subalgebra.of_le", "description": " Given two nested Lie subalgebras `K \u2286 K'`, we can view `K` as a Lie subalgebra of `K'`,\nregarded as Lie algebra in its own right.", "p": "mathlib"}, {"name": "lie_hom.range_restrict_apply", "description": "", "p": "mathlib"}, {"name": "lie_subalgebra.lie_module", "description": " Given a Lie algebra `L` containing a Lie subalgebra `L' \u2286 L`, together with a Lie module `M` of\n`L`, we may regard `M` as a Lie module of `L'` by restriction.", "p": "mathlib"}, {"name": "lie_subalgebra.coe_to_submodule_eq_iff", "description": "", "p": "mathlib"}, {"name": "lie_subalgebra.bot_coe", "description": "", "p": "mathlib"}, {"name": "lie_subalgebra.Inf_coe_to_submodule", "description": "", "p": "mathlib"}, {"name": "lie_subalgebra", "description": " A Lie subalgebra of a Lie algebra is submodule that is closed under the Lie bracket.\nThis is a sufficient condition for the subset itself to form a Lie algebra.", "p": "mathlib"}, {"name": "lie_subalgebra.to_submodule", "description": " A Lie subalgebra of a Lie algebra is submodule that is closed under the Lie bracket.\nThis is a sufficient condition for the subset itself to form a Lie algebra.", "p": "mathlib"}, {"name": "lie_subalgebra.lie_mem'", "description": " A Lie subalgebra of