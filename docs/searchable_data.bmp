isfies `0 * x = x * 0 = 0` for any `x`, and\npicks the only sensible value elsewhere.", "p": "mathlib"}, {"name": "ereal.add_lt_add", "description": "", "p": "mathlib"}, {"name": "ereal.top_mul_coe_of_neg", "description": "", "p": "mathlib"}, {"name": "ereal.add_monoid", "description": "", "p": "mathlib"}, {"name": "ereal.top_add_top", "description": "", "p": "mathlib"}, {"name": "ereal.abs_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "ereal.le_neg_of_le_neg", "description": "`a \u2264 -b \u2192 b \u2264 -a` on ereal", "p": "mathlib"}, {"name": "ereal.coe_le_coe_iff", "description": "", "p": "mathlib"}, {"name": "ereal.neg_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "ereal.has_Inf", "description": "", "p": "mathlib"}, {"name": "ereal.mul_pos_reflect_lt", "description": "", "p": "mathlib"}, {"name": "ereal.to_real_add", "description": "", "p": "mathlib"}, {"name": "ereal.induction\u2082", "description": " Induct on two ereals by performing case splits on the sign of one whenever the other is\ninfinite.", "p": "mathlib"}, {"name": "ereal.bot_mul_of_pos", "description": "", "p": "mathlib"}, {"name": "ereal.coe_sub_bot", "description": "", "p": "mathlib"}, {"name": "ereal.coe_mul_top_of_pos", "description": "", "p": "mathlib"}, {"name": "ereal.has_one", "description": "", "p": "mathlib"}, {"name": "ereal.to_real_bot", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ne_one", "description": "", "p": "mathlib"}, {"name": "ereal.neg_eq_bot_iff", "description": "", "p": "mathlib"}, {"name": "real.to_ereal", "description": " The canonical inclusion froms reals to ereals. Do not use directly: as this is registered as\na coercion, use the coercion instead.", "p": "mathlib"}, {"name": "ereal.sign_coe", "description": "", "p": "mathlib"}, {"name": "ereal.coe_mul_bot_of_neg", "description": "", "p": "mathlib"}, {"name": "ereal.coe_eq_one", "description": "", "p": "mathlib"}, {"name": "ereal.add_bot", "description": "", "p": "mathlib"}, {"name": "ereal.bot_mul_of_neg", "description": "", "p": "mathlib"}, {"name": "ereal.coe_injective", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ennreal_nonneg", "description": "", "p": "mathlib"}, {"name": "ereal.coe_mul_top_of_neg", "description": "", "p": "mathlib"}, {"name": "ereal.eq_top_iff_forall_lt", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ne_zero", "description": "", "p": "mathlib"}, {"name": "ereal.rec", "description": " A recursor for `ereal` in terms of the coercion.\n\nA typical invocation looks like `induction x using ereal.rec`. Note that using `induction`\ndirectly will unfold `ereal` to `option` which is undesirable.\n\nWhen working in term mode, note that pattern matching can be used directly.", "p": "mathlib"}, {"name": "ereal.to_real", "description": "The map from extended reals to reals sending infinities to zero.", "p": "mathlib"}, {"name": "ereal.coe_zsmul", "description": "", "p": "mathlib"}, {"name": "ereal.coe_abs", "description": "", "p": "mathlib"}, {"name": "ereal.bot_add", "description": "", "p": "mathlib"}, {"name": "ereal.abs_def", "description": "", "p": "mathlib"}, {"name": "ereal.sign_eq_and_abs_eq_iff_eq", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ennreal_eq_zero", "description": "", "p": "mathlib"}, {"name": "ereal.top_sub_coe", "description": "", "p": "mathlib"}, {"name": "ereal.top_ne_coe", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ennreal_eq_coe_ennreal_iff", "description": "", "p": "mathlib"}, {"name": "ereal.to_real_mul", "description": "", "p": "mathlib"}, {"name": "ereal.inhabited", "description": "", "p": "mathlib"}, {"name": "ereal.add_eq_bot_iff", "description": "", "p": "mathlib"}, {"name": "ereal.coe_neg'", "description": "", "p": "mathlib"}, {"name": "ereal.to_real_top", "description": "", "p": "mathlib"}, {"name": "ereal.coe_zero", "description": "", "p": "mathlib"}, {"name": "ereal.has_top", "description": "", "p": "mathlib"}, {"name": "ereal.bot_sub", "description": "", "p": "mathlib"}, {"name": "ereal.mul_top_of_neg", "description": "", "p": "mathlib"}, {"name": "ereal.abs_coe_lt_top", "description": "", "p": "mathlib"}, {"name": "ereal.top_mul_of_pos", "description": "", "p": "mathlib"}, {"name": "ereal.coe_nsmul", "description": "", "p": "mathlib"}, {"name": "ereal.complete_linear_order", "description": "", "p": "mathlib"}, {"name": "ereal.coe_bit0", "description": "", "p": "mathlib"}, {"name": "ereal.bot_mul_coe_of_pos", "description": "", "p": "mathlib"}, {"name": "ereal.coe_to_real_le", "description": "", "p": "mathlib"}, {"name": "ereal.neg_top", "description": "", "p": "mathlib"}, {"name": "ereal.ne_top_bot_equiv_real", "description": "The set of numbers in `ereal` that are not equal to `\u00b1\u221e` is equivalent to `\u211d`.", "p": "mathlib"}, {"name": "ereal.top_sub_bot", "description": "", "p": "mathlib"}, {"name": "tactic.positivity_coe_ennreal_ereal", "description": "Extension for the `positivity` tactic: cast from `\u211d\u22650\u221e` to `ereal`.", "p": "mathlib"}, {"name": "ereal.neg_bot", "description": "", "p": "mathlib"}, {"name": "ereal.coe_mul_bot_of_pos", "description": "", "p": "mathlib"}, {"name": "ereal.coe_neg", "description": "", "p": "mathlib"}, {"name": "ereal.sub_neg_zero_monoid", "description": "", "p": "mathlib"}, {"name": "ereal.bot_lt_coe", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ne_coe_iff", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ennreal_ne_coe_ennreal_iff", "description": "", "p": "mathlib"}, {"name": "ereal", "description": "ereal : The type `[-\u221e, \u221e]`", "p": "mathlib"}, {"name": "ereal.top_mul_coe_of_pos", "description": "", "p": "mathlib"}, {"name": "ereal.mul_top_of_pos", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ne_top", "description": "", "p": "mathlib"}, {"name": "ereal.sign_top", "description": "", "p": "mathlib"}, {"name": "ereal.zero_lt_top", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ennreal_top", "description": "", "p": "mathlib"}, {"name": "ereal.coe_real_ereal_eq_coe_to_nnreal_sub_coe_to_nnreal", "description": "", "p": "mathlib"}, {"name": "ereal.abs", "description": " The absolute value from `ereal` to `\u211d\u22650\u221e`, mapping `\u22a5` and `\u22a4` to `\u22a4` and\na real `x` to `|x|`.", "p": "mathlib"}, {"name": "ereal.le_iff_sign", "description": "", "p": "mathlib"}, {"name": "ereal.neg_lt_iff_neg_lt", "description": "", "p": "mathlib"}, {"name": "ereal.pos_mul_reflect_lt", "description": "", "p": "mathlib"}, {"name": "ereal.has_bot", "description": "", "p": "mathlib"}, {"name": "ereal.eq_bot_iff_forall_lt", "description": "", "p": "mathlib"}, {"name": "ereal.coe_ennreal_eq_one", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.left_adjoint_of_equiv_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.adjunction_of_equiv_right_hom_equiv", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.of_nat_iso_right", "description": "Transport an adjunction along an natural isomorphism on the right.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_unit_counit.left_triangle", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.mk_of_unit_counit", "description": " Construct an adjunction between functors `F` and `G` given a unit and counit for the adjunction\nsatisfying the triangle identities.", "p": "mathlib"}, {"name": "category_theory.adjunction.mk_of_unit_counit_hom_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.equiv_homset_left_of_nat_iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.is_right_adjoint_to_is_equivalence_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.left_adjoint_of_is_equivalence", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.right_adjoint_of_equivalence", "description": "If `F` is an equivalence, it's a right adjoint.", "p": "mathlib"}, {"name": "category_theory.adjunction.adjunction_of_equiv_left_unit_app", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.mk_of_unit_counit_unit", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.adjunction_of_equiv_right_counit_app", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_naturality_right", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.equiv_homset_right_of_nat_iso_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.right_triangle_components", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_naturality_right_symm", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.core_hom_equiv", "description": "This is an auxiliary data structure useful for constructing adjunctions.\nSee `adjunction.mk_of_hom_equiv`.\nThis structure won't typically be used anywhere else.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_hom_equiv.hom_equiv", "description": "This is an auxiliary data structure useful for constructing adjunctions.\nSee `adjunction.mk_of_hom_equiv`.\nThis structure won't typically be used anywhere else.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_hom_equiv.hom_equiv_naturality_left_symm'", "description": "This is an auxiliary data structure useful for constructing adjunctions.\nSee `adjunction.mk_of_hom_equiv`.\nThis structure won't typically be used anywhere else.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_hom_equiv.hom_equiv_naturality_right'", "description": "This is an auxiliary data structure useful for constructing adjunctions.\nSee `adjunction.mk_of_hom_equiv`.\nThis structure won't typically be used anywhere else.", "p": "mathlib"}, {"name": "category_theory.adjunction.eq_hom_equiv_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.left_triangle", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.id", "description": "The adjunction between the identity functor on a category and itself.", "p": "mathlib"}, {"name": "category_theory.adjunction.equiv_homset_right_of_nat_iso", "description": "If G and H are naturally isomorphic functors, establish an equivalence of hom-sets.", "p": "mathlib"}, {"name": "category_theory.adjunction.equiv_homset_right_of_nat_iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.is_right_adjoint_to_is_equivalence_counit_iso_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.left_adjoint_of_nat_iso", "description": "Transport being a left adjoint along a natural isomorphism.", "p": "mathlib"}, {"name": "category_theory.adjunction.of_right_adjoint", "description": "The adjunction associated to a functor known to be a right adjoint.", "p": "mathlib"}, {"name": "category_theory.adjunction.left_adjoint_of_equiv_map", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.adjunction_of_equiv_left_counit_app", "description": "", "p": "mathlib"}, {"name": "category_theory.is_right_adjoint", "description": "A class giving a chosen left adjoint to the functor `right`.", "p": "mathlib"}, {"name": "category_theory.is_right_adjoint.left", "description": "A class giving a chosen left adjoint to the functor `right`.", "p": "mathlib"}, {"name": "category_theory.is_right_adjoint.adj", "description": "A class giving a chosen left adjoint to the functor `right`.", "p": "mathlib"}, {"name": "category_theory.adjunction.right_adjoint_of_comp", "description": "If `F` and `G` are right adjoints then `F \u22d9 G` is a right adjoint too.", "p": "mathlib"}, {"name": "category_theory.adjunction.unit_naturality_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.mk_of_hom_equiv_unit_app", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.right_triangle", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.counit_naturality_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.mk_of_unit_counit_counit", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_symm_id", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.core_hom_equiv.hom_equiv_naturality_right_symm", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.is_right_adjoint_to_is_equivalence_counit_iso_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_apply_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.equivalence.to_adjunction", "description": " The adjunction given by an equivalence of categories. (To obtain the opposite adjunction,\nsimply use `e.symm.to_adjunction`.", "p": "mathlib"}, {"name": "category_theory.adjunction.is_right_adjoint_to_is_equivalence", "description": "If the unit and counit for the adjunction corresponding to a right adjoint functor are (pointwise)\nisomorphisms, then the functor is an equivalence of categories.", "p": "mathlib"}, {"name": "category_theory.adjunction.counit_naturality", "description": "", "p": "mathlib"}, {"name": "category_theory.left_adjoint", "description": "Extract the left adjoint from the instance giving the chosen adjoint.", "p": "mathlib"}, {"name": "category_theory.adjunction.unit_naturality", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction", "description": "`F \u22a3 G` represents the data of an adjunction between two functors\n`F : C \u2964 D` and `G : D \u2964 C`. `F` is the left adjoint and `G` is the right adjoint.\n\nTo construct an `adjunction` between two functors, it's often easier to instead use the\nconstructors `mk_of_hom_equiv` or `mk_of_unit_counit`. To construct a left adjoint,\nthere are also constructors `left_adjoint_of_equiv` and `adjunction_of_equiv_left` (as\nwell as their duals) which can be simpler in practice.\n\nUniqueness of adjoints is shown in `category_theory.adjunction.opposites`.\n\nSee <https://stacks.math.columbia.edu/tag/0037>.", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv", "description": "`F \u22a3 G` represents the data of an adjunction between two functors\n`F : C \u2964 D` and `G : D \u2964 C`. `F` is the left adjoint and `G` is the right adjoint.\n\nTo construct an `adjunction` between two functors, it's often easier to instead use the\nconstructors `mk_of_hom_equiv` or `mk_of_unit_counit`. To construct a left adjoint,\nthere are also constructors `left_adjoint_of_equiv` and `adjunction_of_equiv_left` (as\nwell as their duals) which can be simpler in practice.\n\nUniqueness of adjoints is shown in `category_theory.adjunction.opposites`.\n\nSee <https://stacks.math.columbia.edu/tag/0037>.", "p": "mathlib"}, {"name": "category_theory.adjunction.unit", "description": "`F \u22a3 G` represents the data of an adjunction between two functors\n`F : C \u2964 D` and `G : D \u2964 C`. `F` is the left adjoint and `G` is the right adjoint.\n\nTo construct an `adjunction` between two functors, it's often easier to instead use the\nconstructors `mk_of_hom_equiv` or `mk_of_unit_counit`. To construct a left adjoint,\nthere are also constructors `left_adjoint_of_equiv` and `adjunction_of_equiv_left` (as\nwell as their duals) which can be simpler in practice.\n\nUniqueness of adjoints is shown in `category_theory.adjunction.opposites`.\n\nSee <https://stacks.math.columbia.edu/tag/0037>.", "p": "mathlib"}, {"name": "category_theory.adjunction.counit", "description": "`F \u22a3 G` represents the data of an adjunction between two functors\n`F : C \u2964 D` and `G : D \u2964 C`. `F` is the left adjoint and `G` is the right adjoint.\n\nTo construct an `adjunction` between two functors, it's often easier to instead use the\nconstructors `mk_of_hom_equiv` or `mk_of_unit_counit`. To construct a left adjoint,\nthere are also constructors `left_adjoint_of_equiv` and `adjunction_of_equiv_left` (as\nwell as their duals) which can be simpler in practice.\n\nUniqueness of adjoints is shown in `category_theory.adjunction.opposites`.\n\nSee <https://stacks.math.columbia.edu/tag/0037>.", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_unit'", "description": "`F \u22a3 G` represents the data of an adjunction between two functors\n`F : C \u2964 D` and `G : D \u2964 C`. `F` is the left adjoint and `G` is the right adjoint.\n\nTo construct an `adjunction` between two functors, it's often easier to instead use the\nconstructors `mk_of_hom_equiv` or `mk_of_unit_counit`. To construct a left adjoint,\nthere are also constructors `left_adjoint_of_equiv` and `adjunction_of_equiv_left` (as\nwell as their duals) which can be simpler in practice.\n\nUniqueness of adjoints is shown in `category_theory.adjunction.opposites`.\n\nSee <https://stacks.math.columbia.edu/tag/0037>.", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_counit'", "description": "`F \u22a3 G` represents the data of an adjunction between two functors\n`F : C \u2964 D` and `G : D \u2964 C`. `F` is the left adjoint and `G` is the right adjoint.\n\nTo construct an `adjunction` between two functors, it's often easier to instead use the\nconstructors `mk_of_hom_equiv` or `mk_of_unit_counit`. To construct a left adjoint,\nthere are also constructors `left_adjoint_of_equiv` and `adjunction_of_equiv_left` (as\nwell as their duals) which can be simpler in practice.\n\nUniqueness of adjoints is shown in `category_theory.adjunction.opposites`.\n\nSee <https://stacks.math.columbia.edu/tag/0037>.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_unit_counit.right_triangle", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.equiv_homset_left_of_nat_iso", "description": "If F and G are naturally isomorphic functors, establish an equivalence of hom-sets.", "p": "mathlib"}, {"name": "category_theory.adjunction.right_adjoint_of_nat_iso", "description": "Transport being a right adjoint along a natural isomorphism.", "p": "mathlib"}, {"name": "category_theory.adjunction.left_triangle_components", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_id", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.equiv_homset_left_of_nat_iso_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.to_equivalence_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.of_nat_iso_left", "description": "Transport an adjunction along an natural isomorphism on the left.", "p": "mathlib"}, {"name": "category_theory.adjunction.adjunction_of_equiv_right", "description": " Show that the functor given by `right_adjoint_of_equiv` is indeed right adjoint to `F`. Dual\nto `adjunction_of_equiv_left`.", "p": "mathlib"}, {"name": "category_theory.adjunction.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.adjunction", "description": "An equivalence `E` is left adjoint to its inverse.", "p": "mathlib"}, {"name": "category_theory.adjunction.to_equivalence_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.mk_of_hom_equiv", "description": " Construct an adjunction between `F` and `G` out of a natural bijection between each\n`F.obj X \u27f6 Y` and `X \u27f6 G.obj Y`.", "p": "mathlib"}, {"name": "category_theory.adjunction.left_adjoint_of_equiv", "description": " Construct a left adjoint functor to `G`, given the functor's value on objects `F_obj` and\na bijection `e` between `F_obj X \u27f6 Y` and `X \u27f6 G.obj Y` satisfying a naturality law\n`he : \u2200 X Y Y' g h, e X Y' (h \u226b g) = e X Y h \u226b G.map g`.\nDual to `right_adjoint_of_equiv`.", "p": "mathlib"}, {"name": "category_theory.adjunction.left_adjoint_of_comp", "description": "If `F` and `G` are left adjoints then `F \u22d9 G` is a left adjoint too.", "p": "mathlib"}, {"name": "category_theory.adjunction.left_triangle_components_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.equivalence.as_equivalence_to_adjunction_counit", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.to_equivalence_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.equivalence.as_equivalence_to_adjunction_unit", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.right_adjoint_of_equiv", "description": " Construct a right adjoint functor to `F`, given the functor's value on objects `G_obj` and\na bijection `e` between `F.obj X \u27f6 Y` and `X \u27f6 G_obj Y` satisfying a naturality law\n`he : \u2200 X Y Y' g h, e X' Y (F.map f \u226b g) = f \u226b e X Y g`.\nDual to `left_adjoint_of_equiv`.", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_naturality_left", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_naturality_left_symm", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.core_hom_equiv.hom_equiv_naturality_left", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.comp", "description": "Composition of adjunctions.\n\nSee <https://stacks.math.columbia.edu/tag/0DV0>.", "p": "mathlib"}, {"name": "category_theory.functor.left_adjoint_of_equivalence", "description": "If `F` is an equivalence, it's a left adjoint.", "p": "mathlib"}, {"name": "category_theory.adjunction.is_right_adjoint_to_is_equivalence_unit_iso_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.adjunction_of_equiv_left_hom_equiv", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.right_adjoint_of_is_equivalence", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.core_hom_equiv.hom_equiv_naturality_right", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.right_adjoint_of_equiv_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_unit", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.mk_of_hom_equiv_hom_equiv", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.to_equivalence_counit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.mk_of_hom_equiv_counit_app", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.hom_equiv_counit", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.to_equivalence", "description": "If the unit and counit of a given adjunction are (pointwise) isomorphisms, then we can upgrade the\nadjunction to an equivalence.", "p": "mathlib"}, {"name": "category_theory.adjunction.right_triangle_components_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.of_left_adjoint", "description": "The adjunction associated to a functor known to be a left adjoint.", "p": "mathlib"}, {"name": "category_theory.adjunction.adjunction_of_equiv_left", "description": " Show that the functor given by `left_adjoint_of_equiv` is indeed left adjoint to `G`. Dual\nto `adjunction_of_equiv_right`.", "p": "mathlib"}, {"name": "category_theory.adjunction.mk_of_unit_counit_hom_equiv_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.right_adjoint_of_equiv_map", "description": "", "p": "mathlib"}, {"name": "category_theory.right_adjoint", "description": "Extract the right adjoint from the instance giving the chosen adjoint.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_unit_counit", "description": "This is an auxiliary data structure useful for constructing adjunctions.\nSee `adjunction.mk_of_unit_counit`.\nThis structure won't typically be used anywhere else.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_unit_counit.unit", "description": "This is an auxiliary data structure useful for constructing adjunctions.\nSee `adjunction.mk_of_unit_counit`.\nThis structure won't typically be used anywhere else.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_unit_counit.counit", "description": "This is an auxiliary data structure useful for constructing adjunctions.\nSee `adjunction.mk_of_unit_counit`.\nThis structure won't typically be used anywhere else.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_unit_counit.left_triangle'", "description": "This is an auxiliary data structure useful for constructing adjunctions.\nSee `adjunction.mk_of_unit_counit`.\nThis structure won't typically be used anywhere else.", "p": "mathlib"}, {"name": "category_theory.adjunction.core_unit_counit.right_triangle'", "description": "This is an auxiliary data structure useful for constructing adjunctions.\nSee `adjunction.mk_of_unit_counit`.\nThis structure won't typically be used anywhere else.", "p": "mathlib"}, {"name": "category_theory.is_left_adjoint", "description": "A class giving a chosen right adjoint to the functor `left`.", "p": "mathlib"}, {"name": "category_theory.is_left_adjoint.right", "description": "A class giving a chosen right adjoint to the functor `left`.", "p": "mathlib"}, {"name": "category_theory.is_left_adjoint.adj", "description": "A class giving a chosen right adjoint to the functor `left`.", "p": "mathlib"}, {"name": "category_theory.adjunction.adjunction_of_equiv_right_unit_app", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.core_hom_equiv.hom_equiv_naturality_left_symm", "description": "", "p": "mathlib"}, {"name": "category_theory.adjunction.is_right_adjoint_to_is_equivalence_unit_iso_inv_app", "description": "", "p": "mathlib"}, {"name": "int.mem_zmultiples_iff", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_zmultiples", "description": "", "p": "mathlib"}, {"name": "add_subgroup.range_zmultiples_hom", "description": "", "p": "mathlib"}, {"name": "add_subgroup.exists_mem_zmultiples", "description": "", "p": "mathlib"}, {"name": "add_subgroup.int_cast_mul_mem_zmultiples", "description": "", "p": "mathlib"}, {"name": "of_add_image_zmultiples_eq_zpowers_of_add", "description": "", "p": "mathlib"}, {"name": "subgroup.zpowers", "description": "The subgroup generated by an element.", "p": "mathlib"}, {"name": "add_subgroup.coe_zmultiples", "description": "", "p": "mathlib"}, {"name": "subgroup.zpowers_is_commutative", "description": "", "p": "mathlib"}, {"name": "add_subgroup.forall_mem_zmultiples", "description": "", "p": "mathlib"}, {"name": "subgroup.zpowers.countable", "description": "", "p": "mathlib"}, {"name": "add_subgroup.int_cast_mem_zmultiples_one", "description": "", "p": "mathlib"}, {"name": "add_subgroup.forall_zmultiples", "description": "", "p": "mathlib"}, {"name": "add_subgroup.zmultiples_eq_bot", "description": "", "p": "mathlib"}, {"name": "monoid_hom.map_zpowers", "description": "", "p": "mathlib"}, {"name": "add_subgroup.zmultiples_eq_closure", "description": "", "p": "mathlib"}, {"name": "add_subgroup.center_eq_infi", "description": "", "p": "mathlib"}, {"name": "add_subgroup.nsmul_mem_zmultiples", "description": "", "p": "mathlib"}, {"name": "add_subgroup.zsmul_mem_zmultiples", "description": "", "p": "mathlib"}, {"name": "subgroup.zpowers_eq_closure", "description": "", "p": "mathlib"}, {"name": "subgroup.range_zpowers_hom", "description": "", "p": "mathlib"}, {"name": "subgroup.zpowers_le", "description": "", "p": "mathlib"}, {"name": "subgroup.zpowers_eq_bot", "description": "", "p": "mathlib"}, {"name": "subgroup.zpow_mem_zpowers", "description": "", "p": "mathlib"}, {"name": "add_subgroup.zmultiples", "description": "The subgroup generated by an element.", "p": "mathlib"}, {"name": "subgroup.centralizer_closure", "description": "", "p": "mathlib"}, {"name": "subgroup.zpowers_ne_bot", "description": "", "p": "mathlib"}, {"name": "subgroup.zpowers_one_eq_bot", "description": "", "p": "mathlib"}, {"name": "subgroup.forall_zpowers", "description": "", "p": "mathlib"}, {"name