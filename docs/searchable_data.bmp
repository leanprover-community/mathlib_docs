oid.to_cancel_add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "ordered_cancel_comm_monoid.lt_of_mul_lt_mul_left", "description": "", "p": "mathlib"}, {"name": "ordered_cancel_comm_monoid.to_ordered_comm_monoid", "description": "", "p": "mathlib"}, {"name": "subalgebra.restrict_scalars_top", "description": "", "p": "mathlib"}, {"name": "algebra.lmul_algebra_map", "description": "", "p": "mathlib"}, {"name": "subalgebra.restrict_scalars_injective", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.subalgebra", "description": "", "p": "mathlib"}, {"name": "subalgebra.coe_restrict_scalars", "description": "", "p": "mathlib"}, {"name": "subalgebra.restrict_scalars_to_submodule", "description": "", "p": "mathlib"}, {"name": "subalgebra.of_restrict_scalars", "description": " Produces an `R`-algebra map from `U.restrict_scalars R` given an `S`-algebra map from `U`.\n\nThis is a special case of `alg_hom.restrict_scalars` that can be helpful in elaboration.", "p": "mathlib"}, {"name": "subalgebra.restrict_scalars", "description": " Given a tower `A / \u21a5U / S / R` of algebras, where `U` is an `S`-subalgebra of `A`, reinterpret\n`U` as an `R`-subalgebra of `A`.", "p": "mathlib"}, {"name": "is_scalar_tower.subalgebra'", "description": "", "p": "mathlib"}, {"name": "subalgebra.mem_restrict_scalars", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.adjoin_range_to_alg_hom", "description": "", "p": "mathlib"}, {"name": "prod.has_exists_add_of_le", "description": "", "p": "mathlib"}, {"name": "prod.ordered_add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "prod.ordered_cancel_comm_monoid", "description": "", "p": "mathlib"}, {"name": "prod.canonically_ordered_add_monoid", "description": "", "p": "mathlib"}, {"name": "prod.ordered_cancel_add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "prod.ordered_comm_monoid", "description": "", "p": "mathlib"}, {"name": "prod.has_exists_mul_of_le", "description": "", "p": "mathlib"}, {"name": "prod.canonically_ordered_monoid", "description": "", "p": "mathlib"}, {"name": "mem_adjoin_of_dvd_coeff_of_dvd_aeval", "description": "", "p": "mathlib"}, {"name": "dvd_coeff_zero_of_aeval_eq_prime_smul_of_minpoly_is_eiseinstein_at", "description": " Let `K` be the field of fraction of an integrally closed domain `R` and let `L` be a separable\nextension of `K`, generated by an integral power basis `B` such that the minimal polynomial of\n`B.gen` is Eisenstein at `p`. Given `z : L` integral over `R`, if `Q : R[X]` is such that\n`aeval B.gen Q = p \u2022 z`, then `p \u2223 Q.coeff 0`.", "p": "mathlib"}, {"name": "mem_adjoin_of_smul_prime_smul_of_minpoly_is_eiseinstein_at", "description": " Let `K` be the field of fraction of an integrally closed domain `R` and let `L` be a separable\nextension of `K`, generated by an integral power basis `B` such that the minimal polynomial of\n`B.gen` is Eisenstein at `p`. Given `z : L` integral over `R`, if `p \u2022 z \u2208 adjoin R {B.gen}`, then\n`z \u2208 adjoin R {B.gen}`.", "p": "mathlib"}, {"name": "cyclotomic_prime_pow_comp_X_add_one_is_eisenstein_at", "description": "", "p": "mathlib"}, {"name": "cyclotomic_comp_X_add_one_is_eisenstein_at", "description": "", "p": "mathlib"}, {"name": "mem_adjoin_of_smul_prime_pow_smul_of_minpoly_is_eiseinstein_at", "description": " Let `K` be the field of fraction of an integrally closed domain `R` and let `L` be a separable\nextension of `K`, generated by an integral power basis `B` such that the minimal polynomial of\n`B.gen` is Eisenstein at `p`. Given `z : L` integral over `R`, if `p ^ n \u2022 z \u2208 adjoin R {B.gen}`,\nthen `z \u2208 adjoin R {B.gen}`. Together with `algebra.discr_mul_is_integral_mem_adjoin` this result\noften allows to compute the ring of integers of `L`.", "p": "mathlib"}, {"name": "measure_theory.snorm_one_condexp_le_snorm", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_bdd_condexp_of_ae_bdd", "description": " If the real valued function `f` is bounded almost everywhere by `R`, then so is its conditional\nexpectation.", "p": "mathlib"}, {"name": "measure_theory.condexp_strongly_measurable_mul", "description": "Pull-out property of the conditional expectation.", "p": "mathlib"}, {"name": "measure_theory.rn_deriv_ae_eq_condexp", "description": "", "p": "mathlib"}, {"name": "measure_theory.integrable.uniform_integrable_condexp", "description": " Given a integrable function `g`, the conditional expectations of `g` with respect to\na sequence of sub-\u03c3-algebras is uniformly integrable.", "p": "mathlib"}, {"name": "measure_theory.condexp_strongly_measurable_mul\u2080", "description": "Pull-out property of the conditional expectation.", "p": "mathlib"}, {"name": "measure_theory.condexp_strongly_measurable_simple_func_mul", "description": "Auxiliary lemma for `condexp_measurable_mul`.", "p": "mathlib"}, {"name": "measure_theory.set_integral_abs_condexp_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.condexp_strongly_measurable_mul_of_bound", "description": "", "p": "mathlib"}, {"name": "measure_theory.condexp_strongly_measurable_mul_of_bound\u2080", "description": "", "p": "mathlib"}, {"name": "measure_theory.integral_abs_condexp_le", "description": "", "p": "mathlib"}, {"name": "lattice.copy", "description": " A function to create a provable equal copy of a lattice\nwith possibly different definitional equalities.", "p": "mathlib"}, {"name": "complete_lattice.copy", "description": " A function to create a provable equal copy of a complete lattice\nwith possibly different definitional equalities.", "p": "mathlib"}, {"name": "coframe.copy", "description": " A function to create a provable equal copy of a coframe with possibly different definitional\nequalities.", "p": "mathlib"}, {"name": "frame.copy", "description": " A function to create a provable equal copy of a frame with possibly different definitional\nequalities.", "p": "mathlib"}, {"name": "bounded_order.copy", "description": " A function to create a provable equal copy of a bounded order\nwith possibly different definitional equalities.", "p": "mathlib"}, {"name": "distrib_lattice.copy", "description": " A function to create a provable equal copy of a distributive lattice\nwith possibly different definitional equalities.", "p": "mathlib"}, {"name": "conditionally_complete_lattice.copy", "description": " A function to create a provable equal copy of a conditionally complete lattice\nwith possibly different definitional equalities.", "p": "mathlib"}, {"name": "complete_distrib_lattice.copy", "description": " A function to create a provable equal copy of a complete distributive lattice\nwith possibly different definitional equalities.", "p": "mathlib"}, {"name": "lie_algebra.f\u2084", "description": "The exceptional split Lie algebra of type f\u2084.", "p": "mathlib"}, {"name": "cartan_matrix.G\u2082", "description": " The Cartan matrix of type g\u2082. See [bourbaki1968] plate IX, page 290.\n\nThe corresponding Dynkin diagram is:\n```lean\no \u2261>\u2261 o\n```\nActually we are using the transpose of Bourbaki's matrix. This is to make this matrix consistent\nwith `cartan_matrix.F\u2084`, in the sense that all non-zero values below the diagonal are -1.", "p": "mathlib"}, {"name": "cartan_matrix.relations.EF", "description": "The terms correpsonding to the `\u2045E, F\u2046`-relations.", "p": "mathlib"}, {"name": "lie_algebra.e\u2087", "description": "The exceptional split Lie algebra of type e\u2087.", "p": "mathlib"}, {"name": "lie_algebra.g\u2082", "description": "The exceptional split Lie algebra of type g\u2082.", "p": "mathlib"}, {"name": "cartan_matrix.relations.HH", "description": "The terms correpsonding to the `\u2045H, H\u2046`-relations.", "p": "mathlib"}, {"name": "cartan_matrix.relations.HF", "description": "The terms correpsonding to the `\u2045H, F\u2046`-relations.", "p": "mathlib"}, {"name": "cartan_matrix.F\u2084", "description": " The Cartan matrix of type f\u2084. See [bourbaki1968] plate VIII, page 288.\n\nThe corresponding Dynkin diagram is:\n```lean\no --- o =>= o --- o\n```", "p": "mathlib"}, {"name": "cartan_matrix.E\u2088", "description": " The Cartan matrix of type e\u2088. See [bourbaki1968] plate VII, page 285.\n\nThe corresponding Dynkin diagram is:\n```lean\n            o\n            |\no --- o --- o --- o --- o --- o --- o\n```", "p": "mathlib"}, {"name": "lie_algebra.e\u2088", "description": "The exceptional split Lie algebra of type e\u2088.", "p": "mathlib"}, {"name": "lie_algebra.e\u2086", "description": "The exceptional split Lie algebra of type e\u2086.", "p": "mathlib"}, {"name": "matrix.to_lie_algebra.lie_ring", "description": "", "p": "mathlib"}, {"name": "matrix.to_lie_algebra", "description": " The Lie algebra corresponding to a Cartan matrix.\n\nNote that it is defined for any matrix of integers. Its value for non-Cartan matrices should be\nregarded as junk.", "p": "mathlib"}, {"name": "cartan_matrix.relations.ad_E", "description": " The terms correpsonding to the `ad E`-relations.\n\nNote that we use `int.to_nat` so that we can take the power and that we do not bother\nrestricting to the case `i \u2260 j` since these relations are zero anyway. We also defensively\nensure this with `ad_E_of_eq_eq_zero`.", "p": "mathlib"}, {"name": "matrix.to_lie_algebra.inhabited", "description": "", "p": "mathlib"}, {"name": "cartan_matrix.E\u2087", "description": " The Cartan matrix of type e\u2087. See [bourbaki1968] plate VI, page 281.\n\nThe corresponding Dynkin diagram is:\n```lean\n            o\n            |\no --- o --- o --- o --- o --- o\n```", "p": "mathlib"}, {"name": "cartan_matrix.relations.HE", "description": "The terms correpsonding to the `\u2045H, E\u2046`-relations.", "p": "mathlib"}, {"name": "cartan_matrix.E\u2086", "description": " The Cartan matrix of type e\u2086. See [bourbaki1968] plate V, page 277.\n\nThe corresponding Dynkin diagram is:\n```lean\n            o\n            |\no --- o --- o --- o --- o\n```", "p": "mathlib"}, {"name": "matrix.to_lie_algebra.lie_algebra", "description": "", "p": "mathlib"}, {"name": "cartan_matrix.relations.ad_F", "description": " The terms correpsonding to the `ad F`-relations.\n\nSee also `ad_E` docstring.", "p": "mathlib"}, {"name": "cartan_matrix.generators.inhabited", "description": "", "p": "mathlib"}, {"name": "cartan_matrix.relations.to_ideal", "description": "The ideal of the free Lie algebra generated by the relations.", "p": "mathlib"}, {"name": "cartan_matrix.generators", "description": " The generators of the free Lie algebra from which we construct the Lie algebra of a Cartan\nmatrix as a quotient.", "p": "mathlib"}, {"name": "cartan_matrix.generators.H", "description": " The generators of the free Lie algebra from which we construct the Lie algebra of a Cartan\nmatrix as a quotient.", "p": "mathlib"}, {"name": "cartan_matrix.generators.E", "description": " The generators of the free Lie algebra from which we construct the Lie algebra of a Cartan\nmatrix as a quotient.", "p": "mathlib"}, {"name": "cartan_matrix.generators.F", "description": " The generators of the free Lie algebra from which we construct the Lie algebra of a Cartan\nmatrix as a quotient.", "p": "mathlib"}, {"name": "cartan_matrix.relations.to_set", "description": "The union of all the relations as a subset of the free Lie algebra.", "p": "mathlib"}, {"name": "add_monoid_algebra.mod_of_apply_self_add", "description": "", "p": "mathlib"}, {"name": "add_monoid_algebra.mul_of'_mod_of", "description": "", "p": "mathlib"}, {"name": "add_monoid_algebra.div_of_hom_apply_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_algebra.of'_mul_div_of", "description": "", "p": "mathlib"}, {"name": "add_monoid_algebra.mul_of'_div_of", "description": "", "p": "mathlib"}, {"name": "add_monoid_algebra.div_of_add", "description": "", "p": "mathlib"}, {"name": "add_monoid_algebra.mod_of_add_div_of", "description": "", "p": "mathlib"}, {"