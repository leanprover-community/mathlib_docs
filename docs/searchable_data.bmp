thlib"}, {"name": "fderiv_within_deriv_within", "description": "", "p": "mathlib"}, {"name": "deriv_within", "description": "Derivative of `f` at the point `x` within the set `s`, if it exists.  Zero otherwise.\n\nIf the derivative exists (i.e., `\u2203 f', has_deriv_within_at f f' s x`), then\n`f x' = f x + (x' - x) \u2022 deriv_within f s x + o(x' - x)` where `x'` converges to `x` inside `s`.", "p": "mathlib"}, {"name": "deriv_id''", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at_const", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_iff_tendsto", "description": "", "p": "mathlib"}, {"name": "deriv_within_of_open", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.union", "description": "", "p": "mathlib"}, {"name": "deriv_within_id", "description": "", "p": "mathlib"}, {"name": "differentiable_at_of_deriv_ne_zero", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_diff_singleton", "description": "", "p": "mathlib"}, {"name": "deriv_within_congr", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_deriv_within_iff", "description": "", "p": "mathlib"}, {"name": "has_fderiv_at.has_deriv_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter", "description": "`f` has the derivative `f'` at the point `x` as `x` goes along the filter `L`.\n\nThat is, `f x' = f x + (x' - x) \u2022 f' + o(x' - x)` where `x'` converges along the filter `L`.", "p": "mathlib"}, {"name": "deriv_const'", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.congr_set", "description": "**Alias** of the forward direction of `has_deriv_within_at_congr_set`.", "p": "mathlib"}, {"name": "has_deriv_within_at_Ioi_iff_Ici", "description": "", "p": "mathlib"}, {"name": "deriv_within_zero_of_not_differentiable_within_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.congr_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "fderiv_deriv", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter_iff_tendsto", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_const", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_inter'", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.differentiable_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter.is_O_sub", "description": "", "p": "mathlib"}, {"name": "has_deriv_at", "description": "`f` has the derivative `f'` at the point `x`.\n\nThat is, `f x' = f x + (x' - x) \u2022 f' + o(x' - x)` where `x'` converges to `x`.", "p": "mathlib"}, {"name": "has_deriv_within_at.has_fderiv_within_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter_const", "description": "", "p": "mathlib"}, {"name": "has_fderiv_at_iff_has_deriv_at", "description": "Expressing `has_fderiv_at f f' x` in terms of `has_deriv_at`", "p": "mathlib"}, {"name": "filter.eventually_eq.deriv_eq", "description": "", "p": "mathlib"}, {"name": "deriv_fderiv", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_iff_has_fderiv_at", "description": "Expressing `has_deriv_at f f' x` in terms of `has_fderiv_at`", "p": "mathlib"}, {"name": "differentiable_within_at_Ioi_iff_Ici", "description": "", "p": "mathlib"}, {"name": "deriv_eq", "description": "", "p": "mathlib"}, {"name": "deriv_zero_of_not_differentiable_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.deriv_eq_zero", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.has_deriv_at", "description": "", "p": "mathlib"}, {"name": "differentiable_on.has_deriv_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_inter", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at", "description": " `f` has the derivative `f'` at the point `x` in the sense of strict differentiability.\n\nThat is, `f y - f z = (y - z) \u2022 f' + o(y - z)` as `y, z \u2192 x`.", "p": "mathlib"}, {"name": "deriv_within_of_mem", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_const", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.congr_mono", "description": "", "p": "mathlib"}, {"name": "deriv", "description": "Derivative of `f` at the point `x`, if it exists.  Zero otherwise.\n\nIf the derivative exists (i.e., `\u2203 f', has_deriv_at f f' x`), then\n`f x' = f x + (x' - x) \u2022 deriv f x + o(x' - x)` where `x'` converges to `x`.", "p": "mathlib"}, {"name": "has_deriv_at_iff_is_o_nhds_zero", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_iff_is_o", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.continuous_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_id", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.has_deriv_at_filter", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.Ici_of_Ioi", "description": "**Alias** of the forward direction of `has_deriv_within_at_Ioi_iff_Ici`.", "p": "mathlib"}, {"name": "has_deriv_at_deriv_iff", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at.has_strict_fderiv_at", "description": "**Alias** of the forward direction of `has_strict_deriv_at_iff_has_strict_fderiv_at`.", "p": "mathlib"}, {"name": "has_deriv_within_at.nhds_within", "description": "", "p": "mathlib"}, {"name": "deriv_within_mem_iff", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter.mono", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.congr", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_congr_set'", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.Ioi_iff_Ioo", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_id'", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_iff_tendsto", "description": "", "p": "mathlib"}, {"name": "has_strict_fderiv_at.has_strict_deriv_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_Iio_iff_Iic", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_id", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter.is_O_sub_rev", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.differentiable_within_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_iff_has_fderiv_within_at", "description": "Expressing `has_deriv_within_at f f' s x` in terms of `has_fderiv_within_at`", "p": "mathlib"}, {"name": "has_strict_deriv_at_id", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at", "description": "`f` has the derivative `f'` at the point `x` within the subset `s`.\n\nThat is, `f x' = f x + (x' - x) \u2022 f' + o(x' - x)` where `x'` converges to `x` inside `s`.", "p": "mathlib"}, {"name": "filter.eventually_eq.deriv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.colimit_cocone", "description": "The colimit cocone over any functor into a complete lattice.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.finite_colimit_cocone", "description": "The colimit cocone over any functor from a finite diagram into a `semilattice_sup` with `order_bot`.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.has_colimits_of_complete_lattice", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.finite_limit_cone", "description": "The limit cone over any functor from a finite diagram into a `semilattice_inf` with `order_top`.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.coprod_eq_sup", "description": "The binary coproduct in the category of a `semilattice_sup` with `order_bot` is the same as the\nsupremum.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.has_limits_of_complete_lattice", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.finite_limit_eq_finset_univ_inf", "description": "The limit of a functor from a finite diagram into a `semilattice_inf` with `order_top` is the\ninfimum of the objects in the image.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.finite_product_eq_finset_inf", "description": "A finite product in the category of a `semilattice_inf` with `order_top` is the same as the infimum.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.finite_coproduct_eq_finset_sup", "description": "A finite coproduct in the category of a `semilattice_sup` with `order_bot` is the same as the\nsupremum.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.pushout_eq_sup", "description": "The pushout in the category of a `semilattice_sup` with `order_bot` is the same as the supremum\nover the objects.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.has_finite_colimits_of_semilattice_sup_order_bot", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.limit_eq_infi", "description": "The limit of a functor into a complete lattice is the infimum of the objects in the image.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.category_theory.limits.has_binary_products", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.prod_eq_inf", "description": "The binary product in the category of a `semilattice_inf` with `order_top` is the same as the\ninfimum.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.colimit_eq_supr", "description": "The colimit of a functor into a complete lattice is the supremum of the objects in the image.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.limit_cone", "description": "The limit cone over any functor into a complete lattice.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.pullback_eq_inf", "description": "The pullback in the category of a `semilattice_inf` with `order_top` is the same as the infimum\nover the objects.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.finite_colimit_eq_finset_univ_sup", "description": "The colimit of a functor from a finite diagram into a `semilattice_sup` with `order_bot`\nis the supremum of the objects in the image.", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.has_finite_limits_of_semilattice_inf_order_top", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.complete_lattice.category_theory.limits.has_binary_coproducts", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.W_path_dest_right_W_path_cases_on", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.Wp_mk", "description": "Constructor for `Wp`", "p": "mathlib"}, {"name": "mvpfunctor.W_cases", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.W_path.inhabited", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.Wp", "description": " Polynomial functor for the W-type of `P`. `A` is a data-less well-founded\ntree whereas, for a given `a : A`, `B a` is a valid path in tree `a` so\nthat `Wp.obj \u03b1` is made of a tree and a function from its valid paths to\nthe values it contains", "p": "mathlib"}, {"name": "mvpfunctor.W_path_dest_left_W_path_cases_on", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.comp_W_path_cases_on", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.W_dest'", "description": "Destructor for the W-type of `P`", "p": "mathlib"}, {"name": "mvpfunctor.W_mk'", "description": "Constructor for the W-type of `P`", "p": "mathlib"}, {"name": "mvpfunctor.W_dest'_W_mk", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.W_ind", "description": "Induction principle for `W`", "p": "mathlib"}, {"name": "mvpfunctor.W_rec_eq", "description": "Defining equation for the recursor of `W`", "p": "mathlib"}, {"name": "mvpfunctor.W_map", "description": "W-types are functorial", "p": "mathlib"}, {"name": "mvpfunctor.Wp_ind", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.W_path_cases_on", "description": "Specialized destructor on `W_path`", "p": "mathlib"}, {"name": "mvpfunctor.W_mk_eq", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.mvfunctor_W", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.W_mk", "description": "Constructor for `W`", "p": "mathlib"}, {"name": "mvpfunctor.Wp_rec", "description": "Recursor for `Wp`", "p": "mathlib"}, {"name": "mvpfunctor.W", "description": "W-type of `P`", "p": "mathlib"}, {"name": "mvpfunctor.W_path", "description": "A path from the root of a tree to one of its node", "p": "mathlib"}, {"name": "mvpfunctor.W_path.root", "description": "A path from the root of a tree to one of its node", "p": "mathlib"}, {"name": "mvpfunctor.W_path.child", "description": "A path from the root of a tree to one of its node", "p": "mathlib"}, {"name": "mvpfunctor.W_rec", "description": "Recursor for `W`", "p": "mathlib"}, {"name": "mvpfunctor.W_path_dest_right", "description": "Specialized destructor on `W_path`", "p": "mathlib"}, {"name": "mvpfunctor.W_map_W_mk", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.W_path_dest_left", "description": "Specialized destructor on `W_path`", "p": "mathlib"}, {"name": "mvpfunctor.W_path_cases_on_eta", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.Wp_rec_eq", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.W_dest'_W_mk'", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.map_obj_append1", "description": "", "p": "mathlib"}, {"name": "mvpfunctor.obj_append1", "description": " Constructor of a value of `P.obj (\u03b1 ::: \u03b2)` from components.\nUseful to avoid complicated type annotation", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.prod_to_prod_Top_map", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.pi_to_pi_Top_obj", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.pi_to_pi_Top_map", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.prod_to_prod_Top", "description": "The map taking the product of two fundamental groupoids to the fundamental groupoid of the product\nof the two topological spaces. This is in fact an isomorphism (see `prod_iso`).", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.proj_left_map", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.proj_right", "description": "The induced map of the right projection map X \u00d7 Y \u2192 Y", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.cone_discrete_comp", "description": "Equivalence between the categories of cones over the objects `\u03c0 X\u1d62` written in two ways", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.pi_Top_to_pi_cone.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.proj", "description": "The projection map \u03a0 i, X i \u2192 X i induces a map \u03c0(\u03a0 i, X i) \u27f6 \u03c0(X i).", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.cone_discrete_comp_obj_map_cone", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.prod_iso", "description": "Shows `prod_to_prod_Top` is an isomorphism, whose inverse is precisely the product\nof the induced left and right projections.", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.prod_iso_inv", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.proj_left", "description": "The induced map of the left projection map X \u00d7 Y \u2192 X", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.pi_to_pi_Top", "description": "The map taking the pi product of a family of fundamental groupoids to the fundamental\ngroupoid of the pi product. This is actually an isomorphism (see `pi_iso`)", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.pi_iso_hom", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.pi_Top_to_pi_cone", "description": "This is `pi_iso.inv` as a cone morphism (in fact, isomorphism)", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.proj_map", "description": "The projection map is precisely path.homotopic.proj interpreted as a functor", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.prod_iso_hom", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.preserves_product", "description": "The fundamental groupoid functor preserves products", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.proj_right_map", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.prod_to_prod_Top_obj", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.pi_iso_inv", "description": "", "p": "mathlib"}, {"name": "fundamental_groupoid_functor.pi_iso", "description": "Shows `pi_to_pi_Top` is an isomorphism, whose inverse is precisely the pi product\nof the induced projections. This shows that `fundamental_groupoid_functor` preserves products.", "p": "mathlib"}, {"name": "dvd_geom_sum\u2082_self", "description": "", "p": "mathlib"}, {"name": "int.two_pow_sub_pow", "description": "**Lifting the exponent lemma** for `p = 2`", "p": "mathlib"}, {"name": "dvd_geom_sum\u2082_iff_of_dvd_sub'", "description": "", "p": "mathlib"}, {"name": "multiplicity.nat.pow_sub_pow", "description": "", "p": "mathlib"}, {"name": "odd_sq_dvd_geom_sum\u2082_sub", "description": "", "p": "mathlib"}, {"name": "int.two_pow_sub_pow'", "description": "", "p": "mathlib"}, {"name": "multiplicity.int.pow_add_pow", "description": "", "p": "mathlib"}, {"name": "int.two_pow_two_pow_sub_pow_two_pow", "description": "", "p": "mathlib"}, {"name": "multiplicity.pow_sub_pow_of_prime", "description": "", "p": "mathlib"}, {"name": "sq_dvd_add_pow_sub_sub", "description": "", "p": "mathlib"}, {"name": "pow_two_pow_sub_pow_two_pow", "description": "", "p": "mathlib"}, {"name": "padic_val_nat.pow_sub_pow", "description": "", "p": "mathlib"}, {"name": "nat.two_pow_sub_pow", "description": "", "p": "mathlib"}, {"name": "not_dvd_geom_sum\u2082", "description": "", "p": "mathlib"}, {"name": "int.two_pow_two_pow_add_two_pow_two_pow", "description": "", "p": "mathlib"}, {"name": "dvd_geom_sum\u2082_iff_of_dvd_sub", "description": "", "p": "mathlib"}, {"name": "padic_val_nat.pow_add_pow", "description": "", "p": "mathlib"}, {"name": "padic_val_nat.pow_two_sub_pow", "description": "", "p": "mathlib"}, {"name": "multiplicity.nat.pow_add_pow", "description": "", "p": "mathlib"}, {"name": "multiplicity.geom_sum\u2082_eq_one", "description": "", "p": "mathlib"}, {"name": "multiplicity.int.pow_sub_pow", "description": "**Lifting the exponent lemma** for odd primes.", "p": "mathlib"}, {"name": "multiplicity.pow_prime_sub_pow_prime", "description": "", "p": "mathlib"}, {"name": "int.sq_mod_four_eq_one_of_odd", "description": "", "p": "mathlib"}, {"name": "multiplicity.pow_prime_pow_sub_pow_prime_pow", "description": "", "p": "mathlib"}, {"name": "expr.is_sort", "description": "Tests whether an expression is a sort.", "p": "mathlib"}, {"name": "expr.match_local_const", "description": "Match a local constant.", "p": "mathlib"}, {"name": "binder.decidable_eq", "description": "", "p": "mathlib"}, {"name": "environment.is_prefix_of_file", "description": "Checks whether `s` is a prefix of the file where `n` is declared.\n This is used to check whether `n` is declared in mathlib, where `s` is the mathlib directory.", "p": "mathlib"}, {"name": "declaration.is_theorem", "description": "Checks whether a declaration is a theorem", "p": "mathlib"}, {"name": "name.append_namespace", "description": " Like `++`, except that if the right argument starts with `_root_` the namespace will be\nignored.\n```lean\nappend_namespace `a.b `c.d = `a.b.c.d\nappend_namespace `a.b `_root_.c.d = `c.d\n```", "p": "mathlib"}, {"name": "expr.to_list", "description": "Turns an expression into a list, assuming it is only built up from `list.nil` and `list.cons`.", "p": "mathlib"}, {"name": "expr.match_var", "description": "Match a variable.", "p": "mathlib"}, {"name": "environment.mfold", "description": "Fold a monad over all declarations in the environment.", "p": "mathlib"}, {"name": "expr.clean", "description": "Clean an expression by removing `id`s listed in `clean_ids`.", "p": "mathlib"}, {"name": "expr.replace_subexprs", "description": " `replace_subexprs e mappings` takes an `e : expr` and interprets a `list (expr \u00d7 expr)` as\na collection of rules for variable replacements. A pair `(f, t)` encodes a rule which says \"whenever\n`f` is encountered in `e` verbatim, replace it with `t`\".", "p": "mathlib"}, {"name": "binder", "description": "The type of binders containing a name, the binding info and the binding type", "p": "mathlib"}, {"name": "binder.name", "description": "The type of binders containing a name, the binding info and the binding type", "p": "mathlib"}, {"name": "binder.info", "description": "The type of binders containing a name, the binding info and the binding type", "p": "mathlib"}, {"name": "binder.type", "description": "The type of binders containing a name, the binding info and the binding type", "p": "mathlib"}, {"name": "expr.to_nat", "description": "Turns an expression into a natural number, assuming it is only built up from\n`has_one.one`, `bit0`, `bit1`, `has_zero.zero`, `nat.zero`, and `nat.succ`.", "p": "mathlib"}, {"name": "expr.mk_or_lst", "description": "`mk_or_lst [x1, x2, ...]` is defined as `x1 \u2228 (x2 \u2228 ...)`, or `false` if the list is empty.", "p": "mathlib"}, {"name": "expr.binding_names", "description": "Get the names of the bound variables by a sequence of pis or lambdas.", "p": "mathlib"}, {"name": "expr.local_binding_info", "description": " `local_binding_info e` returns the binding info of `e` if `e` is a local constant.\nOtherwise returns `binder_info.default`.", "p": "mathlib"}, {"name": "library_note.likely generated binder names", "description": "In surface Lean, we can write anonymous \u03a0 binders (i.e. binders where the\nargument is not named) using the function arrow notation:\n\n```lean\ninductive test : Type\n| intro : unit \u2192 test\n```\n\nAfter elaboration, however, every binder must have a name, so Lean generates\none. In the example, the binder in the type of `intro` is anonymous, so Lean\ngives it the name `\u1fb0`:\n\n```lean\ntest.intro : \u2200 (\u1fb0 : unit), test\n```\n\nWhen there are multiple anonymous binders, they are named `\u1fb0_1`, `\u1fb0_2` etc.\n\nThus, when we want to know whether the user named a binder, we can check whether\nthe name follows this scheme. Note, however, that this is not reliable. When the\nuser writes (for whatever reason)\n\n```lean\ninductive test : Type\n| intro : \u2200 (\u1fb0 : unit), test\n```\n\nwe cannot tell that the binder was, in fact, named.\n\nThe function `name.is_likely_generated_binder_name` checks if\na name is of the form `\u1fb0`, `\u1fb0_1`, etc.", "p": "mathlib"}, {"name": "expr.replace_explicit_args", "description": "  `replace_explicit_args f parg` assumes that `f` is an expression corresponding to a function\napplication.  It replaces the explicit arguments of `f`, in succession, by the elements of `parg`.\nThe implicit arguments of `f` remain unchanged.", "p": "mathlib"}, {"name": "expr.match_elet", "description": "Match a let.", "p": "mathlib"}, {"name": "expr.reduce_lets", "description": "head-reduce all let expressions", "p": "mathlib"}, {"name": "name.update_last", "description": "Update the last component of a name.", "p": "mathlib"}, {"name": "expr.list_meta_vars'", "description": "Returns the set of all meta-variables in an expression.", "p": "mathlib"}, {"name": "expr.to_int", "description": "Turns an expression into a integer, assuming it is only built up from\n`has_one.one`, `bit0`, `bit1`, `has_zero.zero` and a optionally a single `has_neg.neg` as head.", "p": "mathlib"}, {"name": "expr.list_local_consts", "description": "Returns a list of all local constants in an expression (without duplicates).", "p": "mathlib"}, {"name": "expr.mk_op_lst", "description": "`mk_op_lst op empty [x1, x2, ...]` is defined as `op x1 (op x2 ...)`.\n Returns `empty` if the list is empty.", "p": "mathlib"}, {"name": "expr.is_default_local", "description": " `is_default_local e` tests whether `e` is a local constant with binder info\n`binder_info.default`", "p": "mathlib"}, {"name": "expr.match_lam", "description": "Match an abstraction.", "p": "mathlib"}, {"name": "expr.clean_ids", "description": "List of names removed by `clean`. All these names must resolve to functions defeq `id`.", "p": "mathlib"}, {"name": "binder_info.inhabited", "description": "", "p": "mathlib"}, {"name": "expr.is_implicitly_included_variable", "description": "`is_implicitly_included_variable e vs` accepts `e`, an `expr.local_const`, and a list `vs` of\n   other `expr.local_const`s. It determines whether `e` should be considered \"available in context\"\n   as a variable by virtue of the fact that the variables `vs` have been deemed such.\n\n   For example, given `variables (n : \u2115) [prime n] [ih : even n]`, a reference to `n` implies that\n   the typeclass instance `prime n` should be included, but `ih : even n` should not.\n\n   DANGER: It is possible that for `f : expr` another `expr.local_const`, we have\n   `is_implicitly_included_variable f vs = ff` but\n   `is_implicitly_included_variable f (e :: vs) = tt`. This means that one usually wants to\n   iteratively add a list of local constants (usually, the `variables` declared in the local scope)\n   which satisfy `is_implicitly_included_variable` to an initial `vs`, repeating if any variables\n   were added in a particular iteration. The function `all_implicitly_included_variables` below\n   implements this behaviour.\n\n   Note that if `e \u2208 vs` then `is_implicitly_included_variable e vs = tt`.", "p": "mathlib"}, {"name": "expr.substs", "description": "Repeatedly apply `expr.subst`.", "p": "mathlib"}, {"name": "int.mk_numeral", "description": "`int.mk_numeral z` embeds `z` as a numeral expression inside a type with 0, 1, +, and -.\n`type`: an expression representing the target type. This must live in Type 0.\n`has_zero`, `has_one`, `has_add`, `has_neg`: expressions of the type `has_zero %%type`, etc.", "p": "mathlib"}, {"name": "name.get_nth_prefix", "description": "`get_nth_prefix nm n` removes the last `n` components from `nm`", "p": "mathlib"}, {"name": "expr.get_app_fn_args_aux", "description": "Auxiliary defintion for `get_app_fn_args`.", "p": "mathlib"}, {"name": "binder_info.brackets", "description": "The brackets corresponding to a given binder_info.", "p": "mathlib"}, {"name": "expr.app_symbol_in", "description": "`app_symbol_in e l` returns true iff `e` is an application of a constant whose name is in `l`.", "p": "mathlib"}, {"name": "name.add_prime", "description": "Appends `'` to the end of a name.", "p": "mathlib"}, {"name": "nat.to_pexpr", "description": "`nat.to_pexpr n` creates a `pexpr` that will evaluate to `n`.\nThe `pexpr` does not hold any typing information:\n`to_expr ``((%%(nat.to_pexpr 5) : \u2124))` will create a native integer numeral `(5 : \u2124)`.", "p": "mathlib"}, {"name": "expr.is_eta_expansion_of", "description": "`is_eta_expansion_of args univs l` checks whether for all elements `(nm, pr)` in `l` we have\n `pr = nm.{univs} args`.\n Used in `is_eta_expansion`, where `l` consists of the projections and the fields of the value we\n want to eta-reduce.", "p": "mathlib"}, {"name": "expr.mreplace", "description": "Monadic analogue of `expr.replace`.\n\nThe `mreplace R e` visits each subexpression `s` of `e`, and is called with `R s n`, where\n`n` is the number of binders above `e`.\nIf `R s n` fails, the whole replacement fails.\nIf `R s n` returns `some t`, `s` is replaced with `t` (and `mreplace` does not visit\nits subexpressions).\nIf `R s n` return `none`, then `mreplace` continues visiting subexpressions of `s`.\n\nWARNING: This function performs exponentially worse on large terms than `expr.replace`,\nif a subexpression occurs more than once in an expression, `expr.replace` visits them only once,\nbut this function will visit every occurence of it. Do not use this on large expressions.", "p": "mathlib"}, {"name": "environment.decl_filter_map", "description": "For all declarations `d` where `f d = some x` this adds `x` to the returned list.", "p": "mathlib"}, {"name": "expr.get_app_fn_args", "description": "A combination of `get_app_fn` and `get_app_args`: lists both the\n function and its arguments of an application", "p": "mathlib"}, {"name": "expr.match_app", "description": "Match an application.", "p": "mathlib"}, {"name": "expr.list_local_const_unique_names", "description": "Returns the unique names of all local constants in an expression.", "p": "mathlib"}, {"name": "nat.mk_numeral", "description": "`nat.mk_numeral n` embeds `n` as a numeral expression inside a type with 0, 1, and +.\n`type`: an expression representing the target type. This must live in Type 0.\n`has_zero`, `has_one`, `has_add`: expressions of the type `has_zero %%type`, etc.", "p": "mathlib"}, {"name": "name.append_suffix", "description": "Append a string to the last component of a name.", "p": "mathlib"}, {"name": "name.is_likely_generated_binder_simple_name", "description": "Check whether a simple name was likely generated by Lean to name an anonymous\nbinder. Such names are either `\u1fb0` or `\u1fb0_n` for some natural `n`. See\nnote [likely generated binder names].", "p": "mathlib"}, {"name": "expr.contains_sorry", "description": "Returns true if `e` contains a `sorry`.\nSee also `name.contains_sorry`.", "p": "mathlib"}, {"name": "binder_info.has_reflect", "description": "", "p": "mathlib"}, {"name": "expr.is_mvar", "description": "Tests whether an expression is a meta-variable.", "p": "mathlib"}, {"name": "expr.head_eta_expand", "description": "`head_eta_expand n e t` eta-expands `e` `n` times, with the binders info and domains obtained\n by its type `t`.", "p": "mathlib"}, {"name": "declaration.in_current_file", "description": "Checks whether the declaration is declared in the current file.\n This is a simple wrapper around `environment.in_current_file`\n Use `environment.in_current_file` instead if performance matters.", "p": "mathlib"}, {"name": "name.length", "description": "Returns the number of characters used to print all the string components of a name,\n including periods between name segments. Ignores numerical parts of a name.", "p": "mathlib"}, {"name": "expr.reduce_let", "description": "head-reduce a single let expression", "p": "mathlib"}, {"name": "expr.all_implicitly_included_variables", "description": "`all_implicitly_included_variables es vs` accepts `es`, a list of `expr.local_const`, and `vs`,\n   another such list. It returns a list of all variables `e` in `es` or `vs` for which an inclusion\n   of the variables in `vs` into the local context implies that `e` should also be included. See\n   `is_implicitly_included_variable e vs` for the details.\n\n   In particular, those elements of `vs` are included automatically.", "p": "mathlib"}, {"name": "name.is_private", "description": "Tests whether the first component of a name is `\"_private\"`", "p": "mathlib"}, {"name": "expr.univ_levels", "description": "Get the universe levels of a `const` expression", "p": "mathlib"}, {"name": "expr.list_meta_vars", "description": "Returns a list of all meta-variables in an expression (without duplicates).", "p": "mathlib"}, {"name": "environment.structure_fields_full", "description": "Get the full names of all projections of the structure `n`. Returns `none` if `n` is not a\n structure.", "p": "mathlib"}, {"name": "name.from_components", "description": "Build a name from components. For example `from_components [\"foo\",\"bar\"]` becomes\n ``` `foo.bar```", "p": "mathlib"}, {"name": "name.deinternalize_field", "description": " If `nm` is a simple name (having only one string component) starting with `_`, then\n`deinternalize_field nm` removes the underscore. Otherwise, it does nothing.", "p": "mathlib"}, {"name": "binder.has_to_string", "description": "", "p": "mathlib"}, {"name": "expr.instantiate_pis", "description": "`instantiate_pis es e` instantiates the pis in `e` with the expressions from `es`.\n Does not check whether the result remains type-correct.", "p": "mathlib"}, {"name": "pexpr.decidable_eq", "description": "", "p": "mathlib"}, {"name": "declaration.is_axiom", "description": "Checks whether a declaration is a axiom", "p": "mathlib"}, {"name": "expr.list_local_consts'", "description": "Returns the set of all local constants in an expression.", "p": "mathlib"}, {"name": "environment.get_decl_names", "description": "Lists the name of all declarations in the environment", "p": "mathlib"}, {"name": "expr.replace_with", "description": "`replace_with e s s'` replaces ocurrences of `s` with `s'` in `e`.", "p": "mathlib"}, {"name": "thunk.has_reflect", "description": "", "p": "mathlib"}, {"name": "expr.instantiate_lambdas_or_apps", "description": " `instantiate_lambdas_or_apps es e` instantiates lambdas in `e` by expressions from `es`.\nIf the length of `es` is larger than the number of lambdas in `e`,\nthen the term is applied to the remaining terms.\nAlso reduces head let-expressions in `e`, including those after instantiating all lambdas.\n\nThis is very similar to `expr.substs`, but this also reduces head let-expressions.", "p": "mathlib"}, {"name": "int.to_pexpr", "description": "`int.to_pexpr n` creates a `pexpr` that will evaluate to `n`.\nThe `pexpr` does not hold any typing information:\n`to_expr ``((%%(int.to_pexpr (-5)) : \u211a))` will create a native `\u211a` numeral `(-5 : \u211a)`.", "p": "mathlib"}, {"name": "expr.is_eta_expansion_aux", "description": "`is_eta_expansion_aux val l` checks whether `val` can be eta-reduced to an expression `e`.\n Here `l` is intended to consists of the projections and the fields of `val`.\n This tactic calls `is_eta_expansion_test l`, but first removes all proofs from the list `l` and\n afterward checks whether the resulting expression `e` unifies with `val`.\n This last check is necessary, because `val` and `e` might have different types.", "p": "mathlib"}, {"name": "expr.list_constant'", "description": "Returns a `list name` containing the constant names of an `expr` in the same order\n that `expr.fold` traverses it.", "p": "mathlib"}, {"name": "expr.is_num_eq", "description": "`is_num_eq n1 n2` returns true if `n1` and `n2` are both numerals with the same numeral structure,\nignoring differences in type and type class arguments.", "p": "mathlib"}, {"name": "environment.filter", "description": "Filters all declarations in the environment.", "p": "mathlib"}, {"name": "environment.get_trusted_decls", "description": "Lists all trusted (non-meta) declarations in the environment", "p": "mathlib"}, {"name": "environment.is_ginductive'", "description": "Tests whether `nm` is a generalized inductive type that is not a normal inductive type.\n Note that `is_ginductive` returns `tt` even on regular inductive types.\n This returns `tt` if `nm` is (part of a) mutually defined inductive type or a nested inductive\n type.", "p": "mathlib"}, {"name": "declaration.is_constant", "description": "Checks whether a declaration is a constant", "p": "mathlib"}, {"name": "expr.match_pi", "description": "Match a \u03a0 type.", "p": "mathlib"}, {"name": "expr.mk_and_lst", "description": "`mk_and_lst [x1, x2, ...]` is defined as `x1 \u2227 (x2 \u2227 ...)`, or `true` if the list is empty.", "p": "mathlib"}, {"name": "binder.to_string", "description": "Turn a binder into a string. Uses expr.to_string for the type.", "p": "mathlib"}, {"name": "declaration.is_auto_or_internal", "description": "Returns true iff `d` is an automatically-generated or internal declaration.", "p": "mathlib"}, {"name": "expr.match_app_coe_fn", "description": "Match an application of `coe_fn`.", "p": "mathlib"}, {"name": "name.append_to_last", "description": "`append_to_last nm s is_prefix` adds `s` to the last component of `nm`,\n either as prefix or as suffix (specified by `is_prefix`), separated by `_`.\n Used by `simps_add_projections`.", "p": "mathlib"}, {"name": "name.has_prefix", "description": "Checks whether `nm` has a prefix (including itself) such that P is true", "p": "mathlib"}, {"name": "name.head", "description": "The first component of a name, turning a number to a string", "p": "mathlib"}, {"name": "expr.has_local_constant", "description": "`has_local_constant e l` checks whether local constant `l` occurs in expression `e`", "p": "mathlib"}, {"name": "environment.is_structure", "description": "Tests whether `n` is a structure.", "p": "mathlib"}, {"name": "expr.eta_expand", "description": " `e.eta_expand env dict` eta-expands all expressions that have as head a constant `n` in\n`dict`. They are expanded until they are applied to one more argument than the maximum in\n`dict.find n`.", "p": "mathlib"}, {"name": "expr.simp", "description": "Simplifies the expression `t` with the specified options.\n The result is `(new_e, pr)` with the new expression `new_e` and a proof\n `pr : e = new_e`.", "p": "mathlib"}, {"name": "pexpr.get_app_args", "description": "If `e : pexpr` is a sequence of applications `f e\u2081 e\u2082 ... e\u2099`,\n`e.get_app_args` returns `[e\u2081, ... e\u2099]`.\nSee also `expr.get_app_args`.", "p": "mathlib"}, {"name": "expr.dsimp", "description": "Definitionally simplifies the expression `t` with the specified options.\n The result is the simplified expression.", "p": "mathlib"}, {"name": "declaration.update_with_fun", "description": "`declaration.update_with_fun f test tgt decl`\nsets the name of the given `decl : declaration` to `tgt`, and applies both `expr.eta_expand` and\n`expr.apply_replacement_fun` to the value and type of `decl`.", "p": "mathlib"}, {"name": "expr.simple_infer_type", "description": " Infer the type of an application of the form `f x1 x2 ... xn`, where `f` is an identifier.\nThis also works if `x1, ... xn` contain free variables.", "p": "mathlib"}, {"name": "expr.replace_mvars", "description": "Replace any metavariables in the expression with underscores, in preparation for printing\n`refine ...` statements.", "p": "mathlib"}, {"name": "binder.inhabited", "description": "", "p": "mathlib"}, {"name": "name.last_string", "description": " `last_string n` returns the rightmost component of `n`, ignoring numeral components.\nFor example, ``last_string `a.b.c.33`` will return `` `c ``.", "p": "mathlib"}, {"name": "pexpr.get_app_fn", "description": "If `e : pexpr` is a sequence of applications `f e\u2081 e\u2082 ... e\u2099`,\n`e.get_app_fn` returns `f`.\nSee also `expr.get_app_fn`.", "p": "mathlib"}, {"name": "name.map_prefix", "description": " Find the largest prefix `n` of a `name` such that `f n \u2260 none`, then replace this prefix\nwith the value of `f n`.", "p": "mathlib"}, {"name": "declaration.is_auto_generated", "description": "Checks whether a declaration is automatically generated in the environment.\n There is no cheap way to check whether a declaration in the namespace of a generalized\n inductive type is automatically generated, so for now we say that all of them are automatically\n generated.", "p": "mathlib"}, {"name": "declaration.univ_levels", "description": "Returns the list of universe levels of a declaration.", "p": "mathlib"}, {"name": "congr_arg_kind.decidable_eq", "description": "", "p": "mathlib"}, {"name": "name.sanitize_name", "description": "`name`s can contain numeral pieces, which are not legal names\n when typed/passed directly to the parser. We turn an arbitrary\n name into a legal identifier name by turning the numbers to strings.", "p": "mathlib"}, {"name": "binder.has_to_tactic_format", "description": "", "p": "mathlib"}, {"name": "expr.get_simp_args", "description": "`get_simp_args e` returns the arguments of `e` that simp can reach via congruence lemmas.", "p": "mathlib"}, {"name": "binder.has_to_format", "description": "", "p": "mathlib"}, {"name": "name.from_string", "description": "Constructs a (non-simple) name from a string.\n\nExample: ``name.from_string \"foo.bar\" = `foo.bar``", "p": "mathlib"}, {"name": "expr.list_explicit_args", "description": "Get the list of explicit arguments of a function.", "p": "mathlib"}, {"name": "expr.to_binder", "description": "Turns a local constant into a binder", "p": "mathlib"}, {"name": "expr.match_mvar", "description": "Match a metavariable.", "p": "mathlib"}, {"name": "name.pop_nth_prefix", "description": "Pops the top `n` prefixes from the given name.", "p": "mathlib"}, {"name": "level.fold_mvar", "description": "`l.fold_mvar f` folds a function `f : name \u2192 \u03b1 \u2192 \u03b1`\nover each `n : name` appearing in a `level.mvar n` in `l`.", "p": "mathlib"}, {"name": "expr.is_eta_expansion", "description": "`is_eta_expansion val` checks whether there is an expression `e` such that `val` is the\n eta-expansion of `e`.\n With eta-expansion we here mean the eta-expansion of a structure, not of a function.\n For example, the eta-expansion of `x : \u03b1 \u00d7 \u03b2` is `\u27e8x.1, x.2\u27e9`.\n This assumes that `val` is a fully-applied application of the constructor of a structure.\n\n This is useful to reduce expressions generated by the notation\n   `{ field_1 := _, ..other_structure }`\n If `other_structure` is itself a field of the structure, then the elaborator will insert an\n eta-expanded version of `other_structure`.", "p": "mathlib"}, {"name": "expr.drop_pis", "description": "`drop_pis es e` instantiates the pis in `e` with the expressions from `es`.", "p": "mathlib"}, {"name": "expr.match_sort", "description": "Match a sort.", "p": "mathlib"}, {"name": "expr.to_implicit_local_const", "description": "If `e` is a local constant, `to_implicit_local_const e` changes the binder info of `e` to\n`implicit`. See also `to_implicit_binder`, which also changes lambdas and pis.", "p": "mathlib"}, {"name": "expr.local_const_set_type", "description": "`local_const_set_type e t` sets the type of `e` to `t`, if `e` is a `local_const`.", "p": "mathlib"}, {"name": "pexpr.get_app_fn_args", "description": "If `e : pexpr` is a sequence of applications `f e\u2081 e\u2082 ... e\u2099`,\n`e.get_app_fn_args` returns `(f, [e\u2081, ... e\u2099])`.\nSee also `expr.get_app_fn_args`.", "p": "mathlib"}, {"name": "environment.get_decls", "description": "Lists all declarations in the environment", "p": "mathlib"}, {"name": "expr.match_const", "description": "Match a constant.", "p": "mathlib"}, {"name": "expr.instantiate_lambdas", "description": "Instantiate lambdas in the second argument by expressions from the first.", "p": "mathlib"}, {"name": "environment.mfilter", "description": "Filters all declarations in the environment.", "p": "mathlib"}, {"name": "expr.is_eta_expansion_test", "description": "`is_eta_expansion_test l` checks whether there is a list of expresions `args` such that for all\n elements `(nm, pr)` in `l` we have `pr = nm args`. If so, returns the last element of `args`.\n Used in `is_eta_expansion`, where `l` consists of the projections and the fields of the value we\n want to eta-reduce.", "p": "mathlib"}, {"name": "expr.apply_replacement_fun", "description": "`e.apply_replacement_fun f test` applies `f` to each identifier\n(inductive type, defined function etc) in an expression, unless\n* The identifier occurs in an application with first argument `arg`; and\n* `test arg` is false.\nHowever, if `f` is in the dictionary `relevant`, then the argument `relevant.find f`\nis tested, instead of the first argument.\n\nReorder contains the information about what arguments to reorder:\ne.g. `g x\u2081 x\u2082 x\u2083 ... x\u2099` becomes `g x\u2082 x\u2081 x\u2083 ... x\u2099` if `reorder.find g = some [1]`.\nWe assume that all functions where we want to reorder arguments are fully applied.\nThis can be done by applying `expr.eta_expand` first.", "p": "mathlib"}, {"name": "expr.pi_codomain", "description": "Get the codomain/target of a pi-type.\n This definition doesn't instantiate bound variables, and therefore produces a term that is open.\n See note [open expressions].", "p": "mathlib"}, {"name": "expr.list_constant", "description": "Returns a `name_set` of all constants in an expression.", "p": "mathlib"}, {"name": "expr.head_eta_expand_aux", "description": "Auxilliary function for `head_eta_expand`.", "p": "mathlib"}, {"name": "library_note.open expressions", "description": "Some declarations work with open expressions, i.e. an expr that has free variables.\nTerms will free variables are not well-typed, and one should not use them in tactics like\n`infer_type` or `unify`. You can still do syntactic analysis/manipulation on them.\nThe reason for working with open types is for performance: instantiating variables requires\niterating through the expression. In one performance test `pi_binders` was more than 6x\nquicker than `mk_local_pis` (when applied to the type of all imported declarations 100x).", "p": "mathlib"}, {"name": "declaration.reducibility_hints", "description": "Returns the `reducibility_hints` field of a `defn`, and `reducibility_hints.opaque` otherwise", "p": "mathlib"}, {"name": "expr.list_names_with_prefix", "description": "Returns a `name_set` of all constants in an expression starting with a certain prefix.", "p": "mathlib"}, {"name": "expr.match_macro", "description": "Match a macro.", "p": "mathlib"}, {"name": "declaration.to_tactic_format", "description": "pretty-prints a `declaration` object.", "p": "mathlib"}, {"name": "level.params", "description": "`l.params` is the set of parameters occuring in `l`.\nFor example if `l = max 1 (max (u+1) (max v w))` then `l.params = {u, v, w}`.", "p": "mathlib"}, {"name": "expr.pi_binders", "description": "Get the binders and codomain of a pi-type.\n This definition doesn't instantiate bound variables, and therefore produces a term that is open.\n The.tactic `get_pi_binders` in `tactic.core` does the same, but also instantiates the\n free variables.\n See note [open expressions].", "p": "mathlib"}, {"name": "expr.mreplace_aux", "description": "Implementation of `expr.mreplace`.", "p": "mathlib"}, {"name": "pexpr.get_frozen_name", "description": "If `e` is an annotation of `frozen_name` to `expr.const n`,\n`e.get_frozen_name` returns `n`.\nOtherwise, returns `name.anonymous`.", "p": "mathlib"}, {"name": "expr.contains_expr_or_mvar", "description": "Test `t` contains the specified subexpression `e`, or a metavariable.\nThis represents the notion that `e` \"may occur\" in `t`,\npossibly after subsequent unification.", "p": "mathlib"}, {"name": "expr.lambda_body", "description": "Get the body/value of a lambda-expression.\n This definition doesn't instantiate bound variables, and therefore produces a term that is open.\n See note [open expressions].", "p": "mathlib"}, {"name": "congr_arg_kind.has_reflect", "description": "", "p": "mathlib"}, {"name": "expr.pi_binders_aux", "description": "Auxiliary defintion for `pi_binders`.\n See note [open expressions].", "p": "mathlib"}, {"name": "declaration.has_to_tactic_format", "description": "", "p": "mathlib"}, {"name": "expr.get_local_const_kind", "description": " Strip-away the context-dependent unique id for the given local const and return: its friendly\n`name`, its `binder_info`, and its `type : expr`.", "p": "mathlib"}, {"name": "environment.decl_map", "description": "Maps `f` to all declarations in the environment.", "p": "mathlib"}, {"name": "name.is_likely_generated_binder_name", "description": "Check whether a name was likely generated by Lean to name an anonymous binder.\nSuch names are either `\u1fb0` or `\u1fb0_n` for some natural `n`. See\nnote [likely generated binder names].", "p": "mathlib"}, {"name": "expr.unsafe_cast", "description": " `unsafe_cast e` freely changes the `elab : bool` parameter of the passed `expr`. Mainly used to\naccess core `expr` manipulation functions for `pexpr`-based use, but which are restricted to\n`expr tt` at the site of definition unnecessarily.\n\nDANGER: Unless you know exactly what you are doing, this is probably not the function you are\nlooking for. For `pexpr \u2192 expr` see `tactic.to_expr`. For `expr \u2192 pexpr` see `to_pexpr`.", "p": "mathlib"}, {"name": "level.nonzero", "description": "Tests whether a universe level is non-zero for all assignments of its variables", "p": "mathlib"}, {"name": "name.pop_prefix", "description": "Pop the prefix of a name", "p": "mathlib"}, {"name": "expr.list_univ_meta_vars", "description": "Returns a list of all universe meta-variables in an expression (without duplicates).", "p": "mathlib"}, {"name": "expr.contains_constant", "description": "Returns true if `e` contains a name `n` where `p n` is true.\n Returns `true` if `p name.anonymous` is true.", "p": "mathlib"}, {"name": "binder_info.decidable_eq", "description": "", "p": "mathlib"}, {"name": "expr.to_implicit_binder", "description": " If `e` is a local constant, lamda, or pi expression, `to_implicit_binder e` changes the binder\ninfo of `e` to `implicit`. See also `to_implicit_local_const`, which only changes local constants.", "p": "mathlib"}, {"name": "free_add_group.to_word_mk", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.sublist", "description": "If `w\u2081 w\u2082` are words such that `w\u2081` reduces to `w\u2082`,\nthen `w\u2082` is a sublist of `w\u2081`.", "p": "mathlib"}, {"name": "free_add_group.neg_bind", "description": "", "p": "mathlib"}, {"name": "free_group.free_group_congr_apply", "description": "", "p": "mathlib"}, {"name": "free_group.ext_hom", "description": " Two homomorphisms out of a free group are equal if they are equal on generators.\n\nSee note [partially-applied ext lemmas].", "p": "mathlib"}, {"name": "free_group.to_word_injective", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.cons_cons_iff", "description": "", "p": "mathlib"}, {"name": "free_group.free_group_congr_trans", "description": "", "p": "mathlib"}, {"name": "free_add_group.reduce.cons", "description": "", "p": "mathlib"}, {"name": "free_group.mul_mk", "description": "", "p": "mathlib"}, {"name": "free_group.to_word_inj", "description": "", "p": "mathlib"}, {"name": "free_add_group.free_add_group_congr_trans", "description": "", "p": "mathlib"}, {"name": "free_group.inv_rev_surjective", "description": "", "p": "mathlib"}, {"name": "free_group.inv_rev_length", "description": "", "p": "mathlib"}, {"name": "free_group.inv_rev_injective", "description": "", "p": "mathlib"}, {"name": "free_add_group.zero_eq_mk", "description": "", "p": "mathlib"}, {"name": "free_add_group.free_add_group_congr_refl", "description": "", "p": "mathlib"}, {"name": "free_group.red.step.length", "description": " Predicate asserting that the word `w\u2081` can be reduced to `w\u2082` in one step, i.e. there are words\n`w\u2083 w\u2084` and letter `x` such that `w\u2081 = w\u2083xx\u207b\u00b9w\u2084` and `w\u2082 = w\u2083w\u2084`", "p": "mathlib"}, {"name": "free_add_group.quot_map_mk", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.diamond_aux", "description": "", "p": "mathlib"}, {"name": "free_add_group.reduce.not", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.red_iff_irreducible", "description": "", "p": "mathlib"}, {"name": "free_group.map.comp", "description": "", "p": "mathlib"}, {"name": "free_group.red.step.cons", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step_neg_rev_iff", "description": "", "p": "mathlib"}, {"name": "free_add_group.lift.mk", "description": "", "p": "mathlib"}, {"name": "free_group.red.step.diamond_aux", "description": "", "p": "mathlib"}, {"name": "free_add_group.free_add_group_empty_equiv_add_unit", "description": "The bijection between the additive free group on the empty type, and a type with one element.", "p": "mathlib"}, {"name": "free_add_group.add_mk", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.neg_rev", "description": "", "p": "mathlib"}, {"name": "free_add_group.reduce.exact", "description": "If two words have a common maximal reduction,\nthen they correspond to the same element in the additive free group.", "p": "mathlib"}, {"name": "free_group.reduce.rev", "description": " If words `w\u2081 w\u2082` are such that `w\u2081` reduces to `w\u2082`,\nthen `w\u2082` reduces to the maximal reduction of `w\u2081`.", "p": "mathlib"}, {"name": "free_group.has_one", "description": "", "p": "mathlib"}, {"name": "free_group.mul_bind", "description": "", "p": "mathlib"}, {"name": "free_group.reduce_inv_rev", "description": "", "p": "mathlib"}, {"name": "free_add_group.map_add", "description": "", "p": "mathlib"}, {"name": "free_add_group.to_word", "description": "The function that sends an element of the additive free\ngroup to its maximal reduction.", "p": "mathlib"}, {"name": "free_group.red.step.append_left", "description": "", "p": "mathlib"}, {"name": "free_add_group.map.of", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.length_le", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.append_left_iff", "description": "", "p": "mathlib"}, {"name": "free_group.reduce.sound", "description": " If two words correspond to the same element in\nthe free group, then they have a common maximal\nreduction. This is the proof that the function that\nsends an element of the free group to its maximal\nreduction is well-defined.", "p": "mathlib"}, {"name": "free_group.lift.of", "description": "", "p": "mathlib"}, {"name": "free_group.equivalence_join_red", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.append_right", "description": "", "p": "mathlib"}, {"name": "free_add_group.map_zero", "description": "", "p": "mathlib"}, {"name": "free_add_group.norm_eq_zero", "description": "", "p": "mathlib"}, {"name": "free_group.sum.map_mul", "description": "", "p": "mathlib"}, {"name": "free_group.prod_mk", "description": "", "p": "mathlib"}, {"name": "free_group.map_mul", "description": "", "p": "mathlib"}, {"name": "free_add_group.to_word_eq_nil_iff", "description": "", "p": "mathlib"}, {"name": "free_group.norm_one", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.length", "description": "Predicate asserting that the word `w\u2081` can be reduced to `w\u2082` in one step, i.e. there are words\n`w\u2083 w\u2084` and letter `x` such that `w\u2081 = w\u2083 + x + (-x) + w\u2084` and `w\u2082 = w\u2083w\u2084`", "p": "mathlib"}, {"name": "free_add_group.to_word_zero", "description": "", "p": "mathlib"}, {"name": "free_group.red.enum.sound", "description": "", "p": "mathlib"}, {"name": "free_add_group.to_word_inj", "description": "", "p": "mathlib"}, {"name": "free_group.is_lawful_monad", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.cons_cons", "description": "", "p": "mathlib"}, {"name": "free_add_group.neg_rev_bijective", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.sublist", "description": "", "p": "mathlib"}, {"name": "free_group.join_red_of_step", "description": "", "p": "mathlib"}, {"name": "free_add_group.neg_rev_neg_rev", "description": "", "p": "mathlib"}, {"name": "free_group.quot_map_mk", "description": "", "p": "mathlib"}, {"name": "free_group.inv_rev", "description": "Transform a word representing a free group element into a word representing its inverse.", "p": "mathlib"}, {"name": "free_group.red_inv_rev_iff", "description": "", "p": "mathlib"}, {"name": "free_add_group.neg_rev_injective", "description": "", "p": "mathlib"}, {"name": "free_group.red.inv_rev", "description": "", "p": "mathlib"}, {"name": "free_group.quot_lift_on_mk", "description": "", "p": "mathlib"}, {"name": "free_group.inv_rev_inv_rev", "description": "", "p": "mathlib"}, {"name": "free_add_group.sum_mk", "description": "", "p": "mathlib"}, {"name": "free_group.to_word_mk", "description": "", "p": "mathlib"}, {"name": "free_group.lift.of_eq", "description": "", "p": "mathlib"}, {"name": "free_add_group.lift.aux", "description": "Given `f : \u03b1 \u2192 \u03b2` with `\u03b2` an additive group, the canonical map\n`list (\u03b1 \u00d7 bool) \u2192 \u03b2`", "p": "mathlib"}, {"name": "free_add_group.red.refl", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.cons_bnot", "description": "", "p": "mathlib"}, {"name": "free_group.red.sizeof_of_step", "description": "", "p": "mathlib"}, {"name": "free_group.reduce.self", "description": " A word and its maximal reduction correspond to\nthe same element of the free group.", "p": "mathlib"}, {"name": "free_group.inv_bind", "description": "", "p": "mathlib"}, {"name": "free_add_group.free_add_group_congr_apply", "description": "", "p": "mathlib"}, {"name": "free_add_group.reduce.sound", "description": "If two words correspond to the same element in\nthe additive free group, then they have a common maximal\nreduction. This is the proof that the function that\nsends an element of the free group to its maximal\nreduction is well-defined.", "p": "mathlib"}, {"name": "free_group.map", "description": " Any function from `\u03b1` to `\u03b2` extends uniquely\nto a group homomorphism from the free group\nover `\u03b1` to the free group over `\u03b2`.", "p": "mathlib"}, {"name": "free_add_group.red.step.append_left", "description": "", "p": "mathlib"}, {"name": "free_add_group.neg_rev_length", "description": "", "p": "mathlib"}, {"name": "free_group.red.step.inv_rev", "description": "", "p": "mathlib"}, {"name": "free_add_group.norm_zero", "description": "", "p": "mathlib"}, {"name": "free_group.norm_eq_zero", "description": "", "p": "mathlib"}, {"name": "free_group.quot_lift_mk", "description": "", "p": "mathlib"}, {"name": "free_group.map.unique", "description": "", "p": "mathlib"}, {"name": "free_group.reduce.red", "description": " The first theorem that characterises the function\n`reduce`: a word reduces to its maximal reduction.", "p": "mathlib"}, {"name": "free_add_group.reduce.self", "description": "A word and its maximal reduction correspond to\nthe same element of the additive free group.", "p": "mathlib"}, {"name": "free_group.mk", "description": "The canonical map from `list (\u03b1 \u00d7 bool)` to the free group on `\u03b1`.", "p": "mathlib"}, {"name": "free_group.red.step.cons_left_iff", "description": "", "p": "mathlib"}, {"name": "free_group.reduce_to_word", "description": "", "p": "mathlib"}, {"name": "free_group.group", "description": "", "p": "mathlib"}, {"name": "free_add_group.has_neg", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.lift", "description": "", "p": "mathlib"}, {"name": "free_group.red.enum.complete", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.sizeof_of_step", "description": "", "p": "mathlib"}, {"name": "free_add_group.mk", "description": "The canonical map from `list (\u03b1 \u00d7 bool)` to the free additive group on `\u03b1`.", "p": "mathlib"}, {"name": "free_add_group.red.step.cons_bnot_rev", "description": "", "p": "mathlib"}, {"name": "free_group.red.church_rosser", "description": " **Church-Rosser theorem** for word reduction: If `w1 w2 w3` are words such that `w1` reduces\nto `w2` and `w3` respectively, then there is a word `w4` such that `w2` and `w3` reduce to `w4`\nrespectively. This is also known as Newman's diamond lemma.", "p": "mathlib"}, {"name": "free_add_group.monad", "description": "", "p": "mathlib"}, {"name": "free_add_group.reduce.step.eq", "description": "", "p": "mathlib"}, {"name": "free_group.map_one", "description": "", "p": "mathlib"}, {"name": "free_group.reduce.idem", "description": " `reduce` is idempotent, i.e. the maximal reduction\nof the maximal reduction of a word is the maximal\nreduction of the word.", "p": "mathlib"}, {"name": "free_add_group.map.unique", "description": "", "p": "mathlib"}, {"name": "free_add_group.norm", "description": "The length of reduced words provides a norm on an additive free group.", "p": "mathlib"}, {"name": "free_group.prod.unique", "description": "", "p": "mathlib"}, {"name": "free_add_group.sum.of", "description": "", "p": "mathlib"}, {"name": "free_group.red.append_append", "description": "", "p": "mathlib"}, {"name": "free_add_group.quot_lift_on_mk", "description": "", "p": "mathlib"}, {"name": "free_add_group.lift_eq_sum_map", "description": "", "p": "mathlib"}, {"name": "free_group.of", "description": " `of` is the canonical injection from the type to the free group over that type by sending each\nelement to the equivalence class of the letter that is the element.", "p": "mathlib"}, {"name": "free_add_group.red.church_rosser", "description": "**Church-Rosser theorem** for word reduction: If `w1 w2 w3` are words such that `w1` reduces\nto `w2` and `w3` respectively, then there is a word `w4` such that `w2` and `w3` reduce to `w4`\nrespectively. This is also known as Newman's diamond lemma.", "p": "mathlib"}, {"name": "free_group.red.length_le", "description": "", "p": "mathlib"}, {"name": "free_group.reduce", "description": " The maximal reduction of a word. It is computable\niff `\u03b1` has decidable equality.", "p": "mathlib"}, {"name": "free_group.free_group_congr", "description": " Equivalent types give rise to multiplicatively equivalent free groups.\n\nThe converse can be found in `group_theory.free_abelian_group_finsupp`,\nas `equiv.of_free_group_equiv`", "p": "mathlib"}, {"name": "free_group.red.trans", "description": "", "p": "mathlib"}, {"name": "free_add_group.red_neg_rev_iff", "description": "", "p": "mathlib"}, {"name": "free_add_group.inhabited", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step", "description": "Reduction step for the additive free group relation: `w + x + (-x) + v ~> w + v`", "p": "mathlib"}, {"name": "free_add_group.red.step.bnot", "description": "Reduction step for the additive free group relation: `w + x + (-x) + v ~> w + v`", "p": "mathlib"}, {"name": "free_group.to_word_one", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.exact", "description": "", "p": "mathlib"}, {"name": "free_add_group.reduce.min", "description": "The second theorem that characterises the\nfunction `reduce`: the maximal reduction of a word\nonly reduces to itself.", "p": "mathlib"}, {"name": "free_add_group.join_red_of_step", "description": "", "p": "mathlib"}, {"name": "free_add_group.to_word_neg", "description": "", "p": "mathlib"}, {"name": "free_group.one_eq_mk", "description": "", "p": "mathlib"}, {"name": "free_group.red.step.cons_bnot_rev", "description": "", "p": "mathlib"}, {"name": "free_group.map.of", "description": "", "p": "mathlib"}, {"name": "free_add_group.lift.of", "description": "", "p": "mathlib"}, {"name": "free_add_group.sum.unique", "description": "", "p": "mathlib"}, {"name": "free_add_group.reduce_to_word", "description": "", "p": "mathlib"}, {"name": "free_group.free_group_empty_equiv_unit", "description": "The bijection between the free group on the empty type, and a type with one element.", "p": "mathlib"}, {"name": "free_group.one_bind", "description": "", "p": "mathlib"}, {"name": "free_add_group.reduce_neg_rev", "description": "", "p": "mathlib"}, {"name": "free_add_group.lift.range_eq_closure", "description": "", "p": "mathlib"}, {"name": "free_group.red.not_step_nil", "description": "", "p": "mathlib"}, {"name": "free_group.red.step.append_left_iff", "description": "", "p": "mathlib"}, {"name": "free_add_group.red.step.bnot_rev", "description": "", "p": "mathlib"}, {"name": "free_group.mk_to_word", "description": "", "p": "mathlib"}, {"name": "free_group.induction_on", "description": "", "p": "mathlib"}, {"name": "free_group.inv_rev_empty", "description": "", "p": "mathlib"}, {"name": "free_group.red.step.lift", "description": "", "p": "mathlib"}, {"name": "free_group.map.mk", "description": "", "p": "mathlib"}, {"name": "free_group", "description": " The free group over a type, i.e. the words formed by the elements of the type and 