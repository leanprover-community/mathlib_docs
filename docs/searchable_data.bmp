name": "finset.induction_on_min", "description": " Induction principle for `finset`s in a linearly ordered type: a predicate is true on all\n`s : finset \u03b1` provided that:\n\n* it is true on the empty `finset`,\n* for every `s : finset \u03b1` and an element `a` strictly less than all elements of `s`, `p s`\n  implies `p (insert a s)`.", "p": "mathlib"}, {"name": "finset.inf'_sup_distrib_right", "description": "", "p": "mathlib"}, {"name": "finset.inf_map", "description": "", "p": "mathlib"}, {"name": "finset.not_mem_of_lt_min", "description": "", "p": "mathlib"}, {"name": "finset.inf_sdiff_left", "description": "", "p": "mathlib"}, {"name": "finset.min", "description": " Let `s` be a finset in a linear order. Then `s.min` is the minimum of `s` if `s` is not empty,\nand `\u22a4` otherwise. It belongs to `with_top \u03b1`. If you want to get an element of `\u03b1`, see\n`s.min'`.", "p": "mathlib"}, {"name": "finset.inf'_le", "description": "", "p": "mathlib"}, {"name": "finset.infi_union", "description": "", "p": "mathlib"}, {"name": "finset.sup_himp_right", "description": "", "p": "mathlib"}, {"name": "finset.sup_mem", "description": "", "p": "mathlib"}, {"name": "finset.max'_insert", "description": "", "p": "mathlib"}, {"name": "set.Inter_eq_Inter_finset'", "description": " Intersection of an indexed family of sets `s : \u03b9 \u2192 set \u03b1` is equal to the intersection of the\nintersections of finite subfamilies. This version works for `\u03b9 : Sort*`. See also\n`Inter_eq_Inter_finset` for a version that assumes `\u03b9 : Type*` but avoids `plift`s in the right\nhand side.", "p": "mathlib"}, {"name": "finset.max_insert", "description": "", "p": "mathlib"}, {"name": "finset.min'_lt_of_mem_erase_min'", "description": "", "p": "mathlib"}, {"name": "finset.le_max_of_eq", "description": "", "p": "mathlib"}, {"name": "finset.infi_finset_image", "description": "", "p": "mathlib"}, {"name": "finset.inf_erase_top", "description": "", "p": "mathlib"}, {"name": "finset.sup_map", "description": "", "p": "mathlib"}, {"name": "finset.sup_singleton'", "description": "", "p": "mathlib"}, {"name": "finset.max'_singleton", "description": "`{a}.max' _` is `a`.", "p": "mathlib"}, {"name": "finset.sup'_image", "description": "", "p": "mathlib"}, {"name": "finset.sup'_lt_iff", "description": "", "p": "mathlib"}, {"name": "finset.comp_inf'_eq_inf'_comp", "description": "", "p": "mathlib"}, {"name": "finset.max'_subset", "description": "", "p": "mathlib"}, {"name": "finset.inf_eq_top_iff", "description": "", "p": "mathlib"}, {"name": "finset.inf'_bUnion", "description": "", "p": "mathlib"}, {"name": "finset.inf_sdiff_right", "description": "", "p": "mathlib"}, {"name": "finset.min_erase_ne_self", "description": "", "p": "mathlib"}, {"name": "finset.sup_product_left", "description": "See also `finset.product_bUnion`.", "p": "mathlib"}, {"name": "set.Union_eq_Union_finset", "description": " Union of an indexed family of sets `s : \u03b9 \u2192 set \u03b1` is equal to the union of the unions\nof finite subfamilies. This version assumes `\u03b9 : Type*`. See also `Union_eq_Union_finset'` for\na version that works for `\u03b9 : Sort*`.", "p": "mathlib"}, {"name": "map_finset_sup'", "description": "", "p": "mathlib"}, {"name": "finset.le_min'_iff", "description": "", "p": "mathlib"}, {"name": "finset.sup'_inf_distrib_left", "description": "", "p": "mathlib"}, {"name": "finset.le_max", "description": "", "p": "mathlib"}, {"name": "finset.sup_id_eq_Sup", "description": "", "p": "mathlib"}, {"name": "finset.min_eq_inf_with_top", "description": "", "p": "mathlib"}, {"name": "finset.le_sup_iff", "description": "", "p": "mathlib"}, {"name": "finset.exists_mem_eq_inf", "description": "", "p": "mathlib"}, {"name": "set.Inter_eq_Inter_finset", "description": " Intersection of an indexed family of sets `s : \u03b9 \u2192 set \u03b1` is equal to the intersection of the\nintersections of finite subfamilies. This version assumes `\u03b9 : Type*`. See also\n`Inter_eq_Inter_finset'` for a version that works for `\u03b9 : Sort*`.", "p": "mathlib"}, {"name": "finset.min'_image", "description": "", "p": "mathlib"}, {"name": "set.Union_eq_Union_finset'", "description": " Union of an indexed family of sets `s : \u03b9 \u2192 set \u03b1` is equal to the union of the unions\nof finite subfamilies. This version works for `\u03b9 : Sort*`. See also `Union_eq_Union_finset` for\na version that assumes `\u03b9 : Type*` but avoids `plift`s in the right hand side.", "p": "mathlib"}, {"name": "finset.inf_sup_distrib_left", "description": "", "p": "mathlib"}, {"name": "finset.set_bInter_bUnion", "description": "", "p": "mathlib"}, {"name": "finset.to_dual_inf", "description": "", "p": "mathlib"}, {"name": "finset.inf_sup", "description": "", "p": "mathlib"}, {"name": "finset.sup'_le_iff", "description": "", "p": "mathlib"}, {"name": "finset.sup'_apply", "description": "", "p": "mathlib"}, {"name": "finset.inf_insert", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.preserves_epimorphisms.iso_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.preserves_epimorphisms", "description": "A functor preserves epimorphisms if it maps epimorphisms to epimorphisms.", "p": "mathlib"}, {"name": "category_theory.functor.preserves_epimorphisms.preserves", "description": "A functor preserves epimorphisms if it maps epimorphisms to epimorphisms.", "p": "mathlib"}, {"name": "category_theory.functor.reflects_epimorphisms_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.preserves_epimorphisms.of_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.preserves_epimorphisms_of_preserves_of_reflects", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.reflects_epimorphisms", "description": "A functor reflects epimorphisms if morphisms that are mapped to epimorphisms are themselves\n   epimorphisms.", "p": "mathlib"}, {"name": "category_theory.fun