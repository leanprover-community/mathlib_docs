lib"}, {"name": "polynomial.is_noetherian_ring", "description": "Hilbert basis theorem: a polynomial ring over a noetherian ring is a noetherian ring.", "p": "mathlib"}, {"name": "polynomial.support_restriction", "description": "", "p": "mathlib"}, {"name": "polynomial.eval\u2082_restriction", "description": "", "p": "mathlib"}, {"name": "polynomial.geom_sum_X_comp_X_add_one_eq_sum", "description": "", "p": "mathlib"}, {"name": "polynomial.sup_aeval_range_eq_top_of_coprime", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.ker_map", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_id_homotopy", "description": "The descent of the identity morphism is homotopic to the identity cochain map.", "p": "mathlib"}, {"name": "category_theory.injective_resolutions", "description": "Taking injective resolutions is functorial,\nif considered with target the homotopy category\n(`\u2115`-indexed cochain complexes and chain maps up to homotopy).", "p": "mathlib"}, {"name": "category_theory.injective_resolution.\u03b9", "description": " The cochain map from cochain complex consisting of `Z` supported in degree `0`\nback to the arbitrarily chosen injective resolution `injective_resolution Z`.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.homotopy_equiv_hom_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.homotopy_equiv", "description": "Any two injective resolutions are homotopy equivalent.", "p": "mathlib"}, {"name": "homological_complex.hom.homological_complex.hom.from_single\u2080_InjectiveResolution", "description": " If `X` is a cochain complex of injective objects and we have a quasi-isomorphism\n`f : Y[0] \u27f6 X`, then `X` is an injective resolution of `Y.`", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_homotopy_zero_succ", "description": "An auxiliary definition for `desc_homotopy_zero`.", "p": "mathlib"}, {"name": "category_theory.exact_f_d", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_homotopy_zero_zero", "description": "An auxiliary definition for `desc_homotopy_zero`.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_homotopy_zero", "description": "Any descent of the zero morphism is homotopic to zero.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_homotopy", "description": "Two descents of the same morphism are homotopic.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_homotopy_zero_one", "description": "An auxiliary definition for `desc_homotopy_zero`.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.category_theory.has_injective_resolution", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc", "description": "A morphism in `C` descends to a chain map between injective resolutions.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_commutes", "description": "The resolution maps intertwine the descent of a morphism and that morphism.", "p": "mathlib"}, {"name": "category_theory.injective_resolution.desc", "description": "The descent of a morphism to a cochain map between the arbitrarily chosen injective resolutions.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.of_cocomplex", "description": "Auxiliary definition for `InjectiveResolution.of`.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.homotopy_equiv_inv_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_f_one", "description": "Auxiliary construction for `desc`.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_f_zero", "description": "Auxiliary construction for `desc`.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.of_cocomplex_d", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.homotopy_equiv_inv_\u03b9_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_comp_homotopy", "description": "The descent of a composition is homotopic to the composition of the descents.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.of_cocomplex_X", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_commutes_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.injective_resolution", "description": "An arbitrarily chosen injective resolution of an object.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.homotopy_equiv_hom_\u03b9_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_f_succ", "description": "Auxiliary construction for `desc`.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.of", "description": "In any abelian category with enough injectives,\n`InjectiveResolution.of Z` constructs an injective resolution of the object `Z`.", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.desc_f_one_zero_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.InjectiveResolution.category_theory.has_injective_resolutions", "description": "", "p": "mathlib"}, {"name": "set.countable_iff_exists_inj_on", "description": " A set `s : set \u03b1` is countable if and only if there exists a function `\u03b1 \u2192 \u2115` injective\non `s`.", "p": "mathlib"}, {"name": "set.countable.exists_eq_range", "description": " If `s : set \u03b1` is a nonempty countable set, then there exists a map\n`f : \u2115 \u2192 \u03b1` such that `s = range f`.", "p": "mathlib"}, {"name": "set.enumerate_countable", "description": " Noncomputably enumerate elements in a set. The `default` value is used to extend the domain to\nall of `\u2115`.", "p": "mathlib"}, {"name": "set.countable.prod", "description": "", "p": "mathlib"}, {"name": "finset.countable_to_set", "description": "", "p": "mathlib"}, {"name": "set.countable_iff_e