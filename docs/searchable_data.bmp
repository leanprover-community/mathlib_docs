omial.card_pow_degree_is_euclidean", "description": "", "p": "mathlib"}, {"name": "prefunctor.comp_id", "description": "", "p": "mathlib"}, {"name": "prefunctor.id", "description": "The identity morphism between quivers.", "p": "mathlib"}, {"name": "quiver.opposite", "description": "`V\u1d52\u1d56` reverses the direction of all arrows of `V`.", "p": "mathlib"}, {"name": "quiver.hom.unop", "description": "Given an arrow in `V\u1d52\u1d56`, we can take the \"unopposite\" back in `V`.", "p": "mathlib"}, {"name": "prefunctor.comp", "description": "Composition of morphisms between quivers.", "p": "mathlib"}, {"name": "prefunctor.id_comp", "description": "", "p": "mathlib"}, {"name": "quiver.empty", "description": "A type synonym for a quiver with no arrows.", "p": "mathlib"}, {"name": "quiver.empty_quiver", "description": "", "p": "mathlib"}, {"name": "prefunctor", "description": "A morphism of quivers. As we will later have categorical functors extend this structure,\nwe call it a `prefunctor`.", "p": "mathlib"}, {"name": "prefunctor.obj", "description": "A morphism of quivers. As we will later have categorical functors extend this structure,\nwe call it a `prefunctor`.", "p": "mathlib"}, {"name": "prefunctor.map", "description": "A morphism of quivers. As we will later have categorical functors extend this structure,\nwe call it a `prefunctor`.", "p": "mathlib"}, {"name": "quiver.empty_arrow", "description": "", "p": "mathlib"}, {"name": "prefunctor.id_map", "description": "", "p": "mathlib"}, {"name": "prefunctor.ext", "description": "", "p": "mathlib"}, {"name": "quiver.hom.op", "description": "The opposite of an arrow in `V`.", "p": "mathlib"}, {"name": "prefunctor.comp_obj", "description": "", "p": "mathlib"}, {"name": "prefunctor.comp_assoc", "description": "", "p": "mathlib"}, {"name": "quiver", "description": "A quiver `G` on a type `V` of vertices assigns to every pair `a b : V` of vertices\na type `a \u27f6 b` of arrows from `a` to `b`.\n\nFor graphs with no repeated edges, one can use `quiver.{0} V`, which ensures\n`a \u27f6 b : Prop`. For multigraphs, one can use `quiver.{v+1} V`, which ensures\n`a \u27f6 b : Type v`.\n\nBecause `category` will later extend this class, we call the field `hom`.\nExcept when constructing instances, you should rarely see this, and use the `\u27f6` notation instead.", "p": "mathlib"}, {"name": "quiver.hom", "description": "A quiver `G` on a type `V` of vertices assigns to every pair `a b : V` of vertices\na type `a \u27f6 b` of arrows from `a` to `b`.\n\nFor graphs with no repeated edges, one can use `quiver.{0} V`, which ensures\n`a \u27f6 b : Prop`. For multigraphs, one can use `quiver.{v+1} V`, which ensures\n`a \u27f6 b : Type v`.\n\nBecause `category` will later extend this class, we call the field `hom`.\nExcept when constructing instances, you should rarely see this, and use the `\u27f6` notation instead.", "p": "mathlib"}, {"name": "prefunctor.inhabited", "description": "", "p": "mathlib"}, {"name": "quiver.is_thin", "description": "A quiver is thin if it has no parallel arrows.", "p": "mathlib"}, {"name": "prefunctor.id_obj", "description": "", "p": "mathlib"}, {"name": "prefunctor.comp_map", "description": "", "p": "mathlib"}, {"name": "alg_hom.field_range", "description": "The range of an algebra homomorphism, as an intermediate field.", "p": "mathlib"}, {"name": "intermediate_field.copy", "description": " Copy of an intermediate field with a new `carrier` equal to the old one. Useful to fix\ndefinitional equalities.", "p": "mathlib"}, {"name": "intermediate_field.field_range_le", "description": "", "p": "mathlib"}, {"name": "intermediate_field.to_algebra", "description": "", "p": "mathlib"}, {"name": "intermediate_field.ext", "description": "Two intermediate fields are equal if they have the same elements.", "p": "mathlib"}, {"name": "intermediate_field.eq_of_le_of_finrank_le", "description": "", "p": "mathlib"}, {"name": "intermediate_field.val_mk", "description": "", "p": "ma