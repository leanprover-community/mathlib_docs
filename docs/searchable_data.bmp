", "description": "", "p": "mathlib"}, {"name": "real.le_rpow_iff_log_le", "description": "", "p": "mathlib"}, {"name": "real.rpow_def", "description": "", "p": "mathlib"}, {"name": "real.abs_log_mul_self_rpow_lt", "description": "Bound for `|log x * x ^ t|` in the interval `(0, 1]`, for positive real `t`.", "p": "mathlib"}, {"name": "real.rpow_le_rpow_left_iff", "description": "", "p": "mathlib"}, {"name": "complex.abs_cpow_inv_nat", "description": "", "p": "mathlib"}, {"name": "real.rpow_lt_rpow_iff", "description": "", "p": "mathlib"}, {"name": "real.rpow_nat_cast", "description": "", "p": "mathlib"}, {"name": "real.le_rpow_of_log_le", "description": "", "p": "mathlib"}, {"name": "real.zero_rpow_eq_iff", "description": "", "p": "mathlib"}, {"name": "real.one_lt_rpow_of_pos_of_lt_one_of_neg", "description": "", "p": "mathlib"}, {"name": "real.rpow_inv_le_iff_of_neg", "description": "", "p": "mathlib"}, {"name": "real.one_le_rpow_of_pos_of_le_one_of_nonpos", "description": "", "p": "mathlib"}, {"name": "real.inv_rpow", "description": "", "p": "mathlib"}, {"name": "complex.of_real_cpow", "description": "", "p": "mathlib"}, {"name": "norm_num.rpow_neg", "description": "", "p": "mathlib"}, {"name": "real.rpow_nonneg_of_nonneg", "description": "", "p": "mathlib"}, {"name": "real.exp_one_rpow", "description": "", "p": "mathlib"}, {"name": "real.abs_rpow_of_nonneg", "description": "", "p": "mathlib"}, {"name": "norm_num.eval_rpow", "description": " Evaluates expressions of the form `rpow a b` and `a ^ b` in the special case where\n`b` is an integer and `a` is a positive rational (so it's really just a rational power).", "p": "mathlib"}, {"name": "real.zero_rpow_nonneg", "description": "", "p": "mathlib"}, {"name": "real.rpow_add_of_nonneg", "description": "", "p": "mathlib"}, {"name": "real.rpow_one", "description": "", "p": "mathlib"}, {"name": "real.lt_rpow_of_log_lt", "description": "", "p": "mathlib"}, {"name": "real.rpow_le_rpow_of_exponent_ge", "description": "", "p": "mathlib"}, {"name": "real.rpow_int_cast", "description": "", "p": "mathlib"}, {"name": "real.le_rpow_add", "description": " For `0 \u2264 x`, the only problematic case in the equality `x ^ y * x ^ z = x ^ (y + z)` is for\n`x = 0` and `y + z = 0`, where the right hand side is `1` while the left hand side can vanish.\nThe inequality is always true, though, and given in this lemma.", "p": "mathlib"}, {"name": "real.rpow_add_int", "description": "", "p": "mathlib"}, {"name": "complex.abs_cpow_of_imp", "description": "", "p": "mathlib"}, {"name": "tactic.positivity.prove_rpow", "description": "Auxiliary definition for the `positivity` tactic to handle real powers of reals.", "p": "mathlib"}, {"name": "real.one_lt_rpow", "description": "", "p": "mathlib"}, {"name": "real.rpow_lt_rpow", "description": "", "p": "mathlib"}, {"name": "real.lt_rpow_inv_iff_of_neg", "description": "", "p": "mathlib"}, {"name": "complex.abs_cpow_real", "description": "", "p": "mathlib"}, {"name": "real.rpow_sub_nat", "description": "", "p": "mathlib"}, {"name": "real.rpow_le_one_iff_of_pos", "description": "", "p": "mathlib"}, {"name": "real.rpow_le_rpow_left_iff_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.rpow_def_of_pos", "description": "", "p": "mathlib"}, {"name": "real.div_rpow", "description": "", "p": "mathlib"}, {"name": "real.rpow_two", "description": "", "p": "mathlib"}, {"name": "real.rpow_eq_zero_iff_of_nonneg", "description": "", "p": "mathlib"}, {"name": "real.rpow_eq_pow", "description": "", "p": "mathlib"}, {"name": "real.one_le_rpow", "description": "", "p": "mathlib"}, {"name": "real.rpow_sub_one", "description": "", "p": "mathlib"}, {"name": "real.rpow_lt_rpow_of_exponent_lt", "description": "", "p": "mathlib"}, {"name": "real.rpow_zero", "description": "", "p": "mathlib"}, {"name": "real.rpow_pos_of_pos", "description": "", "p": "mathlib"}, {"name": "real.rpow_lt_one", "description": "", "p": "mathlib"}, {"name": "tactic.positivity_rpow", "descrip