ool", "description": "", "p": "mathlib"}, {"name": "list.count_bnot_add_count", "description": "", "p": "mathlib"}, {"name": "list.count_tt_add_count_ff", "description": "", "p": "mathlib"}, {"name": "list.count_add_count_bnot", "description": "", "p": "mathlib"}, {"name": "list.chain'.count_ff_eq_count_tt", "description": "", "p": "mathlib"}, {"name": "list.chain'.length_sub_one_le_two_mul_count_bool", "description": "", "p": "mathlib"}, {"name": "list.chain.count_bnot", "description": "", "p": "mathlib"}, {"name": "list.chain'.two_mul_count_bool_le_length_add_one", "description": "", "p": "mathlib"}, {"name": "list.chain'.two_mul_count_bool_of_even", "description": "", "p": "mathlib"}, {"name": "list.chain'.count_bnot_le_count_add_one", "description": "", "p": "mathlib"}, {"name": "list.chain'.count_tt_le_count_ff_add_one", "description": "", "p": "mathlib"}, {"name": "list.count_ff_add_count_tt", "description": "", "p": "mathlib"}, {"name": "real_topological_vector_space.contractible_space", "description": "", "p": "mathlib"}, {"name": "convex.contractible_space", "description": "A non-empty convex set is a contractible space.", "p": "mathlib"}, {"name": "star_convex.contractible_space", "description": "A non-empty star convex set is a contractible space.", "p": "mathlib"}, {"name": "mv_polynomial.eval\u2097_apply", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.R.add_comm_group", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.R.inhabited", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.ker_eval\u2097", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees_indicator", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.R", "description": " The submodule of multivariate polynomials whose degree of each variable is strictly less\nthan the cardinality of K.", "p": "mathlib"}, {"name": "mv_polynomial.indicator_mem_restrict_degree", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.range_eval\u1d62", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.eval\u1d62", "description": "Evaluation in the `mv_polynomial.R` subtype.", "p": "mathlib"}, {"name": "mv_polynomial.indicator", "description": "Over a field, this is the indicator function as an `mv_polynomial`.", "p": "mathlib"}, {"name": "mv_polynomial.frobenius_zmod", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.rank_R", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.map_restrict_dom_eval\u2097", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.decidable_restrict_degree", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.R.finite_dimensional", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.finrank_R", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.R.module", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.eval_indicator_apply_eq_zero", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.expand_zmod", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.C_dvd_iff_zmod", "description": " A polynomial over the integers is divisible by `n : \u2115`\nif and only if it is zero over `zmod n`.", "p": "mathlib"}, {"name": "mv_polynomial.eq_zero_of_eval_eq_zero", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.eval\u2097", "description": "`mv_polynomial.eval` as a `K`-linear map.", "p": "mathlib"}, {"name": "mv_polynomial.eval_indicator_apply_eq_one", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.case_tag.repr", "description": "", "p": "core"}, {"name": "tactic.interactive.case_tag.match_result.combine", "description": "The 'minimum' of two match results:\n\n- If any of the arguments is `no_match`, the result is `no_match`.\n- Otherwise, if any of the arguments is `fuzzy_match`, the result is `fuzzy_match`.\n- Otherwise (iff both arguments are `exact_match`), the result is `exact_match`.", "p": "core"}, {"name": "tactic.interactive.case_tag.has_to_format", "description": "", "p": "core"}, {"name": "tactic.interactive.case_tag.has_repr", "description": "", "p": "core"}, {"name": "tactic.interactive.case_tag.to_string", "description": "", "p": "core"}, {"name": "tactic.interactive.case_tag.match_result", "description": "Indicates the result of matching a list of names against the names of a case\ntag. See `match_tag`.", "p": "core"}, {"name": "tactic.interactive.case_tag.match_result.exact_match", "description": "Indicates the result of matching a list of names against the names of a case\ntag. See `match_tag`.", "p": "core"}, {"name": "tactic.interactive.case_tag.match_result.fuzzy_match", "description": "Indicates the result of matching a list of names against the names of a case\ntag. See `match_tag`.", "p": "core"}, {"name": "tactic.interactive.case_tag.match_result.no_match", "description": "Indicates the result of matching a list of names against the names of a case\ntag. See `match_tag`.", "p": "core"}, {"name": "tactic.interactive.case_tag.to_format", "description": "", "p": "core"}, {"name": "tactic.interactive.case_tag.case_names", "description": "The constructor names associated with a case tag.", "p": "core"}, {"name": "tactic.interactive.case_tag.parse", "description": "Parses a case tag from the list of names produced by `render`.", "p": "core"}, {"name": "tactic.interactive.case_tag", "description": "A case tag carries the following information:\n\n1. A list of names identifying the case ('case names'). This is usually a list\n   of constructor names, one for each case split that was performed. For\n   example, the sequence of tactics `cases n; cases xs`, where `n` is a natural\n   number and `xs` is a list, will generate four cases tagged as follows:\n\n   ```lean\n   nat.zero, list.nil\n   nat.zero, list.cons\n   nat.succ, list.nil\n   nat.succ, list.cons\n   ```\n\n   Note: In the case tag, the case names are stored in reverse order. Thus, the\n   case names of the first case tag would be `list.nil, nat.zero`. This is\n   because when printing a goal tag (as part of a goal state), Lean prints all\n   non-internal names in reverse order.\n\n2. Information about the arguments introduced by the cases-like tactic.\n   Different tactics work slightly different in this regard:\n\n   1. The `with_cases` tactic generates goals where the target quantifies over\n      any added hypotheses. For example, `with_cases { cases xs }`, where `xs`\n      is a `list \u03b1`, will generate a target of the form `\u03b1 \u2192 list \u03b1 \u2192 ...` in\n      the `cons` case, where the two arguments correspond to the two arguments\n      of the `cons` constructor. Goals of this form are tagged with a `pi` case\n      tag (since the target is a pi type). In addition to the case names, it\n      contains a natural number, `num_arguments`, which specifies how many of\n      the arguments that the target quantifies over were introduced by\n      `with_cases`.\n\n      For example, given `n : \u2115` and `xs : list \u03b1`, the fourth goal generated by\n      `with_cases { cases n; induction xs }` has this form:\n\n      ```lean\n      ...\n      \u22a2 \u2115 \u2192 \u03b1 \u2192 \u2200 (xs' : list \u03b1), P xs' \u2192 ...\n      ```\n\n      The corresponding case tag is\n\n      ```lean\n      pi [`list.cons, `nat.succ] 4\n      ```\n\n      since the first four arguments of the target were introduced by\n      `with_cases {...}`.\n\n   2. The `cases` and `induction` tactics do not add arguments to the target,\n      but rather introduce them as hypotheses in the local context. Goals of\n      this form are tagged with a `hyps` case tag. In addition to the case\n      names, it contains a list of *unique* names of the hypotheses that were\n      introduced.\n\n      For example, given `xs : list \u03b1`, the second goal generated by\n      `induction xs` has this form:\n\n      ```lean\n      ...\n      x : \u03b1\n      xs' : list \u03b1\n      ih_xs' : P xs'\n      \u22a2 ...\n      ```\n\n      The corresponding goal tag is\n\n      ```lean\n      hyps [`list.cons] [`<x>, `<xs'>, `<ih_xs'>]\n      ```\n\n      where ````<h>``` denotes the unique name of a hypothesis `h`.\n\n      Note: Many tactics do not preserve the unique names of hypotheses\n      (particularly those tactics that use `revert`). Therefore, a `hyps` case\n      tag is only guaranteed to be valid directly after it was generated.", "p": "core"}, {"name": "tactic.interactive.case_tag.pi", "description": "A case tag carries the following information:\n\n1. A list of names identifying the case ('case names'). This is usually a list\n   of constructor names, one for each case split that was performed. For\n   example, the sequence of tactics `cases n; cases xs`, where `n` is a natural\n   number and `xs` is a list, will generate four cases tagged as follows:\n\n   ```lean\n   nat.zero, list.nil\n   nat.zero, list.cons\n   nat.succ, list.nil\n   nat.succ, list.cons\n   ```\n\n   Note: In the case tag, the case names are stored in reverse order. Thus, the\n   case names of the first case tag would be `list.nil, nat.zero`. This is\n   because when printing a goal tag (as part of a goal state), Lean prints all\n   non-internal names in reverse order.\n\n2. Information about the arguments introduced by the cases-like tactic.\n   Different tactics work slightly different in this regard:\n\n   1. The `with_cases` tactic generates goals where the target quantifies over\n      any added hypotheses. For example, `with_cases { cases xs }`, where `xs`\n      is a `list \u03b1`, will generate a target of the form `\u03b1 \u2192 list \u03b1 \u2192 ...` in\n      the `cons` case, where the two arguments correspond to the two arguments\n      of the `cons` constructor. Goals of this form are tagged with a `pi` case\n      tag (since the target is a pi type). In addition to the case names, it\n      contains a natural number, `num_arguments`, which specifies how many of\n      the arguments that the target quantifies over were introduced by\n      `with_cases`.\n\n      For example, given `n : \u2115` and `xs : list \u03b1`, the fourth goal generated by\n      `with_cases { cases n; induction xs }` has this form:\n\n      ```lean\n      ...\n      \u22a2 \u2115 \u2192 \u03b1 \u2192 \u2200 (xs' : list \u03b1), P xs' \u2192 ...\n      ```\n\n      The corresponding case tag is\n\n      ```lean\n      pi [`list.cons, `nat.succ] 4\n      ```\n\n      since the first four arguments of the target were introduced by\n      `with_cases {...}`.\n\n   2. The `cases` and `induction` tactics do not add arguments to the target,\n      but rather introduce them as hypotheses in the local context. Goals of\n      this form are tagged with a `hyps` case tag. In addition to the case\n      names, it contains a list of *unique* names of the hypotheses that were\n      introduced.\n\n      For example, given `xs : list \u03b1`, the second goal generated by\n      `induction xs` has this form:\n\n      ```lean\n      ...\n      x : \u03b1\n      xs' : list \u03b1\n      ih_xs' : P xs'\n      \u22a2 ...\n      ```\n\n      The corresponding goal tag is\n\n      ```lean\n      hyps [`list.cons] [`<x>, `<xs'>, `<ih_xs'>]\n      ```\n\n      where ````<h>``` denotes the unique name of a hypothesis `h`.\n\n      Note: Many tactics do not preserve the unique names of hypotheses\n      (particularly those tactics that use `revert`). Therefore, a `hyps` case\n      tag is only guaranteed to be valid directly after it was generated.", "p": "core"}, {"name": "tactic.interactive.case_tag.hyps", "description": "A case tag carries the following information:\n\n1. A list of names identifying the case ('case names'). This is usually a list\n   of constructor names, one for each case split that was performed. For\n   example, the sequence of tactics `cases n; cases xs`, where `n` is a natural\n   number and `xs` is a list, will generate four cases tagged as follows:\n\n   ```lean\n   nat.zero, list.nil\n   nat.zero, list.cons\n   nat.succ, list.nil\n   nat.succ, list.cons\n   ```\n\n   Note: In the case tag, the case names are stored in reverse order. Thus, the\n   case names of the first case tag would be `list.nil, nat.zero`. This is\n   because when printing a goal tag (as part of a goal state), Lean prints all\n   non-internal names in reverse order.\n\n2. Information about the arguments introduced by the cases-like tactic.\n   Different tactics work slightly different in this regard:\n\n   1. The `with_cases` tactic generates goals where the target quantifies over\n      any added hypotheses. For example, `with_cases { cases xs }`, where `xs`\n      is a `list \u03b1`, will generate a target of the form `\u03b1 \u2192 list \u03b1 \u2192 ...` in\n      the `cons` case, where the two arguments correspond to the two arguments\n      of the `cons` constructor. Goals of this form are tagged with a `pi` case\n      tag (since the target is a pi type). In addition to the case names, it\n      contains a natural number, `num_arguments`, which specifies how many of\n      the arguments that the target quantifies over were introduced by\n      `with_cases`.\n\n      For example, given `n : \u2115` and `xs : list \u03b1`, the fourth goal generated by\n      `with_cases { cases n; induction xs }` has this form:\n\n      ```lean\n      ...\n      \u22a2 \u2115 \u2192 \u03b1 \u2192 \u2200 (xs' : list \u03b1), P xs' \u2192 ...\n      ```\n\n      The corresponding case tag is\n\n      ```lean\n      pi [`list.cons, `nat.succ] 4\n      ```\n\n      since the first four arguments of the target were introduced by\n      `with_cases {...}`.\n\n   2. The `cases` and `induction` tactics do not add arguments to the target,\n      but rather introduce them as hypotheses in the local context. Goals of\n      this form are tagged with a `hyps` case tag. In addition to the case\n      names, it contains a list of *unique* names of the hypotheses that were\n      introduced.\n\n      For example, given `xs : list \u03b1`, the second goal generated by\n      `induction xs` has this form:\n\n      ```lean\n      ...\n      x : \u03b1\n      xs' : list \u03b1\n      ih_xs' : P xs'\n      \u22a2 ...\n      ```\n\n      The corresponding goal tag is\n\n      ```lean\n      hyps [`list.cons] [`<x>, `<xs'>, `<ih_xs'>]\n      ```\n\n      where ````<h>``` denotes the unique name of a hypothesis `h`.\n\n      Note: Many tactics do not preserve the unique names of hypotheses\n      (particularly those tactics that use `revert`). Therefore, a `hyps` case\n      tag is only guaranteed to be valid directly after it was generated.", "p": "core"}, {"name": "tactic.interactive.case_tag.from_tag_hyps", "description": "Creates a `hyps` case tag from an input tag `in_tag`. The `names` of the\nresulting tag are the non-internal names in `in_tag` (in the order in which they\nappear in `in_tag`). `arguments` is the list of unique hypothesis names of the\nresulting tag.", "p": "core"}, {"name": "tactic.interactive.case_tag.match_tag", "description": "Match the `names` of a case tag against a user-supplied list of names `ns`. For\nthis purpose, we consider the `names` in reverse order, i.e. in the order in\nwhich they are displayed to the user. The matching then uses the following\nrules:\n\n- If `ns` is exactly the same sequence of names as `names`, this is an exact\n  match.\n- If `ns` is a *suffix* of `names`, this is a fuzzy match. Additionally, each of\n  the names in `ns` may be a suffix of the corresponding name in `names`.\n- Otherwise, we have no match.\n\nThus, the tag\n```lean\nnat.zero, list.nil\n```\nis matched by any of these tags:\n```lean\nnat.zero, list.nil (exact match)\nnat.zero, nil      (fuzzy match)\nzero, nil          (fuzzy match)\nnil                (fuzzy match)\n```", "p": "core"}, {"name": "tactic.interactive.case_tag.from_tag_pi", "description": "Creates a `pi` case tag from an input tag `in_tag`. The `names` of the resulting\ntag are the non-internal names in `in_tag` (in the order in which they appear in\n`in_tag`). `num_arguments` is the number of arguments of the resulting tag.", "p": "core"}, {"name": "tactic.interactive.case_tag.render", "description": "Renders a case tag to a goal tag (i.e. a list of names), according to the\nfollowing schema:\n\n- A `pi` tag with names `N\u2080 ... N\u2099` and number of arguments `a` is rendered as\n  ```lean\n  [`_case.pi.a, N\u2080, ..., N\u2099]\n  ```\n- A `hyps` tag with names `N\u2080 ... N\u2099` and argument names `A\u2080 ... A\u2098` is rendered\n  as\n  ```lean\n  [`_case.hyps, A\u2080._arg, ..., A\u2098._arg, N\u2080, ..., N\u2099]\n  ```", "p": "core"}, {"name": "tactic.interactive.case_tag.has_to_string", "description": "", "p": "core"}, {"name": "is_dedekind_domain.height_one_spectrum.valuation_of_ne_zero", "description": "The multiplicative `v`-adic valuation on `K\u02e3`.", "p": "mathlib"}, {"name": "is_dedekind_domain.selmer_group.valuation_ker_eq", "description": "", "p": "mathlib"}, {"name": "is_dedekind_domain.selmer_group.valuation", "description": "The multiplicative `v`-adic valuations on `K\u27eeS, n\u27ef` for all `v \u2208 S`.", "p": "mathlib"}, {"name": "is_dedekind_domain.height_one_spectrum.valuation_of_ne_zero_mod", "description": "The multiplicative `v`-adic valuation on `K\u02e3` modulo `n`-th powers.", "p": "mathlib"}, {"name": "is_dedekind_domain.height_one_spectrum.valuation_of_ne_zero_to_fun", "description": "The multiplicative `v`-adic valuation on `K\u02e3`.", "p": "mathlib"}, {"name": "is_dedekind_domain.height_one_spectrum.valuation_of_unit_eq", "description": "", "p": "mathlib"}, {"name": "is_dedekind_domain.height_one_spectrum.valuation_of_ne_zero_eq", "description": "", "p": "mathlib"}, {"name": "is_dedekind_domain.selmer_group", "description": "The Selmer group `K\u27eeS, n\u27ef`.", "p": "mathlib"}, {"name": "is_dedekind_domain.selmer_group.from_unit_lift_injective", "description": "", "p": "mathlib"}, {"name": "is_dedekind_domain.selmer_group.from_unit_ker", "description": "", "p": "mathlib"}, {"name": "is_dedekind_domain.selmer_group.monotone", "description": "", "p": "mathlib"}, {"name": "is_dedekind_domain.selmer_group.from_unit_lift", "description": "The injection induced by the natural homomorphism from `R\u02e3` to `K\u27ee\u2205, n\u27ef`.", "p": "mathlib"}, {"name": "is_dedekind_domain.height_one_spectrum.valuation_of_unit_mod_eq", "description": "", "p": "mathlib"}, {"name": "is_dedekind_domain.height_one_spectrum.valuation_of_ne_zero_to_fun_eq", "description": "", "p": "mathlib"}, {"name": "is_dedekind_domain.selmer_group.from_unit", "description": "The natural homomorphism from `R\u02e3` to `K\u27ee\u2205, n\u27ef`.", "p": "mathlib"}, {"name": "prod.decidable_eq", "description": "", "p": "core"}, {"name": "prod.mk.eta", "description": "", "p": "core"}, {"name": "prod.inhabited", "description": "", "p": "core"}, {"name": "prod.map", "description": "", "p": "core"}, {"name": "pnat.gcd_dvd_right", "description": "", "p": "mathlib"}, {"name": "pnat.gcd", "description": "The greatest common divisor (gcd) of two positive natural numbers,\n viewed as positive natural number.", "p": "mathlib"}, {"name": "pnat.coprime.gcd_mul_right_cancel", "description": "", "p": "mathlib"}, {"name": "nat.primes.coe_pnat_nat", "description": "", "p": "mathlib"}, {"name": "pnat.coprime", "description": "Two pnats are coprime if their gcd is 1.", "p": "mathlib"}, {"name": "pnat.prime", "description": "Primality predicate for `\u2115+`, defined in terms of `nat.prime`.", "p": "mathlib"}, {"name": "pnat.gcd_comm", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.factor_eq_gcd_right", "description": "", "p": "mathlib"}, {"name": "pnat.lcm_coe", "description": "", "p": "mathlib"}, {"name": "pnat.dvd_gcd", "description": "", "p": "mathlib"}, {"name": "pnat.gcd_coe", "description": "", "p": "mathlib"}, {"name": "pnat.eq_one_of_lt_two", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.gcd_mul_right_cancel_right", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.coprime_dvd_left", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.symm", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.gcd_mul_left_cancel_right", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.factor_eq_gcd_right_right", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.pow", "description": "", "p": "mathlib"}, {"name": "nat.primes.coe_pnat_injective", "description": "", "p": "mathlib"}, {"name": "pnat.coprime_coe", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.factor_eq_gcd_left", "description": "", "p": "mathlib"}, {"name": "pnat.exists_prime_and_dvd", "description": "", "p": "mathlib"}, {"name": "pnat.gcd_eq_right_iff_dvd", "description": "", "p": "mathlib"}, {"name": "pnat.prime_two", "description": "", "p": "mathlib"}, {"name": "pnat.one_coprime", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.gcd_mul", "description": "", "p": "mathlib"}, {"name": "pnat.one_gcd", "description": "", "p": "mathlib"}, {"name": "pnat.gcd_mul_lcm", "description": "", "p": "mathlib"}, {"name": "pnat.dvd_lcm_right", "description": "", "p": "mathlib"}, {"name": "nat.primes.coe_pnat_inj", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.gcd_mul_left_cancel", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.factor_eq_gcd_left_right", "description": "", "p": "mathlib"}, {"name": "pnat.lcm", "description": "The least common multiple (lcm) of two positive natural numbers,\n viewed as positive natural number.", "p": "mathlib"}, {"name": "nat.primes.coe_pnat", "description": "", "p": "mathlib"}, {"name": "pnat.gcd_one", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.mul_right", "description": "", "p": "mathlib"}, {"name": "pnat.prime.ne_one", "description": "", "p": "mathlib"}, {"name": "pnat.prime.not_dvd_one", "description": "", "p": "mathlib"}, {"name": "pnat.dvd_prime", "description": "", "p": "mathlib"}, {"name": "pnat.not_prime_one", "description": "", "p": "mathlib"}, {"name": "pnat.coprime_one", "description": "", "p": "mathlib"}, {"name": "pnat.dvd_lcm_left", "description": "", "p": "mathlib"}, {"name": "pnat.lcm_dvd", "description": "", "p": "mathlib"}, {"name": "pnat.coprime.mul", "description": "", "p": "mathlib"}, {"name": "pnat.gcd_dvd_left", "description": "", "p": "mathlib"}, {"name": "pnat.prime.one_lt", "description": "", "p": "mathlib"}, {"name": "pnat.gcd_eq_left", "description": "", "p": "mathlib"}, {"name": "pnat.gcd_eq_left_iff_dvd", "description": "", "p": "mathlib"}, {"name": "tactic.unify_equations.unify_cyclic", "description": "Given `equ : t = u` with `t, u : I` and `I.sizeof t \u2260 I.sizeof u`, we solve the\ngoal by contradiction.", "p": "mathlib"}, {"name": "tactic.unify_equations.add_add_one_ne", "description": "", "p": "mathlib"}, {"name": "tactic.unify_equations.orelse_step", "description": "`orelse_step s t` first runs the unification step `s`. If this was successful\n(i.e. `s` simplified or solved the goal), it returns the result of `s`.\nOtherwise, it runs `t` and returns its result.", "p": "mathlib"}, {"name": "tactic.unify_equations.get_sizeof", "description": "For `type = I x\u2081 ... x\u2099`, where `I` is an inductive type, `get_sizeof type`\nreturns the constant `I.sizeof`. Fails if `type` is not of this form or if no\nsuch constant exists.", "p": "mathlib"}, {"name": "tactic.unify_equations.match_n_plus_m", "description": "`match_n_plus_m n e` matches `e` of the form `nat.succ (... (nat.succ e')...)`.\nIt returns `n` plus the number of `succ` constructors and `e'`. The matching is\nperformed up to normalisation with transparency `md`.", "p": "mathlib"}, {"name": "tactic.unify_equations.contradict_n_eq_n_plus_m", "description": "Given `equ : n + m = n` or `equ : n = n + m` with `n` and `m` natural numbers\nand `m` a nonzero literal, this tactic produces a proof of `false`. More\nprecisely, the two sides of the equation must be of the form\n`nat.succ (... (nat.succ e)...)` with different numbers of `nat.succ`\nconstructors. Matching is performed with transparency `md`.", "p": "mathlib"}, {"name": "tactic.unify_equations.unification_step", "description": "A unification step is a tactic that attempts to simplify a given equation and\nreturns a `unification_step_result`. The inputs are:\n\n- `equ`, the equation being processed. Must be a local constant.\n- `lhs_type` and `rhs_type`, the types of equ's LHS and RHS. For homogeneous\n  equations, these are defeq.\n- `lhs` and `rhs`, `equ`'s LHS and RHS.\n- `lhs_whnf` and `rhs_whnf`, `equ`'s LHS and RHS in WHNF.\n- `u`, `equ`'s level.\n\nSo `equ : @eq.{u} lhs_type lhs rhs` or `equ : @heq.{u} lhs_type lhs rhs_type rhs`.", "p": "mathlib"}, {"name": "tactic.unify_equations.unify_defeq", "description": "For `equ : t = u`, if `t` and `u` are defeq, we delete `equ`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.unify_equations", "description": "`unify_equations eq\u2081 ... eq\u2099` performs a form of first-order unification on the\nhypotheses `eq\u1d62`. The `eq\u1d62` must be homogeneous or heterogeneous equations.\nUnification means that the equations are simplified using various facts about\nconstructors. For instance, consider this goal:\n\n```lean\nP : \u2200 n, fin n \u2192 Prop\nn m : \u2115\nf : fin n\ng : fin m\nh\u2081 : n + 1 = m + 1\nh\u2082 : f == g\nh\u2083 : P n f\n\u22a2 P m g\n```\n\nAfter `unify_equations h\u2081 h\u2082`, we get\n\n```lean\nP : \u2200 n, fin n \u2192 Prop\nn : \u2115\nf : fin n\nh\u2083 : P n f\n\u22a2 P n f\n```\n\nIn the example, `unify_equations` uses the fact that every constructor is\ninjective to conclude `n = m` from `h\u2081`. Then it replaces every `m` with `n` and\nmoves on to `h\u2082`. The types of `f` and `g` are now equal, so the heterogeneous\nequation turns into a homogeneous one and `g` is replaced by `f`. Note that the\nequations are processed from left to right, so `unify_equations h\u2082 h\u2081` would not\nsimplify as much.\n\nIn general, `unify_equations` uses the following steps on each equation until\nnone of them applies any more:\n\n- Constructor injectivity: if `nat.succ n = nat.succ m` then `n = m`.\n- Substitution: if `x = e` for some hypothesis `x`, then `x` is replaced by `e`\n  everywhere.\n- No-confusion: `nat.succ n = nat.zero` is a contradiction. If we have such an\n  equation, the goal is solved immediately.\n- Cycle elimination: `n = nat.succ n` is a contradiction.\n- Redundancy: if `t = u` but `t` and `u` are already definitionally equal, then\n  this equation is removed.\n- Downgrading of heterogeneous equations: if `t == u` but `t` and `u` have the\n  same type (up to definitional equality), then the equation is replaced by\n  `t = u`.", "p": "mathlib"}, {"name": "tactic.unify_equation_once", "description": "If `equ` is the display name of a local constant with type `t = u` or `t == u`,\nthen `unify_equation_once equ` simplifies it once using\n`unify_equations.unify_homogeneous` or `unify_equations.unify_heterogeneous`.\n\nOtherwise it fails.", "p": "mathlib"}, {"name": "tactic.unify_equations.unify_homogeneous", "description": "For `equ : t = u`, try the following methods in order: `unify_defeq`,\n`unify_var`, `unify_constructor_headed`, `unify_cyclic`. If any of them is\nsuccessful, stop and return its result. If none is successful, fail.", "p": "mathlib"}, {"name": "tactic.unify_equations.unification_step_result", "description": "The result of a unification step:\n\n- `simplified hs` means that the step succeeded and produced some new (simpler)\n  equations `hs`. `hs` can be empty.\n- `goal_solved` means that the step succeeded and solved the goal (by deriving a\n  contradiction from the given equation).\n- `not_simplified` means that the step failed to simplify the equation.", "p": "mathlib"}, {"name": "tactic.unify_equations.unification_step_result.simplified", "description": "The result of a unification step:\n\n- `simplified hs` means that the step succeeded and produced some new (simpler)\n  equations `hs`. `hs` can be empty.\n- `goal_solved` means that the step succeeded and solved the goal (by deriving a\n  contradiction from the given equation).\n- `not_simplified` means that the step failed to simplify the equation.", "p": "mathlib"}, {"name": "tactic.unify_equations.unification_step_result.not_simplified", "description": "The result of a unification step:\n\n- `simplified hs` means that the step succeeded and produced some new (simpler)\n  equations `hs`. `hs` can be empty.\n- `goal_solved` means that the step succeeded and solved the goal (by deriving a\n  contradiction from the given equation).\n- `not_simplified` means that the step failed to simplify the equation.", "p": "mathlib"}, {"name": "tactic.unify_equations.unification_step_result.goal_solved", "description": "The result of a unification step:\n\n- `simplified hs` means that the step succeeded and produced some new (simpler)\n  equations `hs`. `hs` can be empty.\n- `goal_solved` means that the step succeeded and solved the goal (by deriving a\n  contradiction from the given equation).\n- `not_simplified` means that the step failed to simplify the equation.", "p": "mathlib"}, {"name": "tactic.unify_equations.unify_heterogeneous", "description": "For `equ : t == u` with `t : T` and `u : U`, if `T` and `U` are defeq,\nwe replace `equ` with `equ : t = u`.", "p": "mathlib"}, {"name": "tactic.unify_equations.unify_var", "description": "For `equ : x = t` or `equ : t = x`, where `x` is a local constant, we\nsubstitute `x` with `t` in the goal.", "p": "mathlib"}, {"name": "tactic.unify_equations.unify_constructor_headed", "description": "Given `equ : C x\u2081 ... x\u2099 = D y\u2081 ... y\u2098` with `C` and `D` constructors of the\nsame datatype `I`:\n\n- If `C \u2260 D`, we solve the goal by contradiction using the no-confusion rule.\n- If `C = D`, we clear `equ` and add equations `x\u2081 = y\u2081`, ..., `x\u2099 = y\u2099`.", "p": "mathlib"}, {"name": "tactic.interactive.unify_equations", "description": "`unify_equations eq\u2081 ... eq\u2099` performs a form of first-order unification on the\nhypotheses `eq\u1d62`. The `eq\u1d62` must be homogeneous or heterogeneous equations.\nUnification means that the equations are simplified using various facts about\nconstructors. For instance, consider this goal:\n\n```lean\nP : \u2200 n, fin n \u2192 Prop\nn m : \u2115\nf : fin n\ng : fin m\nh\u2081 : n + 1 = m + 1\nh\u2082 : f == g\nh\u2083 : P n f\n\u22a2 P m g\n```\n\nAfter `unify_equations h\u2081 h\u2082`, we get\n\n```lean\nP : \u2200 n, fin n \u2192 Prop\nn : \u2115\nf : fin n\nh\u2083 : P n f\n\u22a2 P n f\n```\n\nIn the example, `unify_equations` uses the fact that every constructor is\ninjective to conclude `n = m` from `h\u2081`. Then it replaces every `m` with `n` and\nmoves on to `h\u2082`. The types of `f` and `g` are now equal, so the heterogeneous\nequation turns into a homogeneous one and `g` is replaced by `f`. Note that the\nequations are processed from left to right, so `unify_equations h\u2082 h\u2081` would not\nsimplify as much.\n\nIn general, `unify_equations` uses the following steps on each equation until\nnone of them applies any more:\n\n- Constructor injectivity: if `nat.succ n = nat.succ m` then `n = m`.\n- Substitution: if `x = e` for some hypothesis `x`, then `x` is replaced by `e`\n  everywhere.\n- No-confusion: `nat.succ n = nat.zero` is a contradiction. If we have such an\n  equation, the goal is solved immediately.\n- Cycle elimination: `n = nat.succ n` is a contradiction.\n- Redundancy: if `t = u` but `t` and `u` are already definitionally equal, then\n  this equation is removed.\n- Downgrading of heterogeneous equations: if `t == u` but `t` and `u` have the\n  same type (up to definitional equality), then the equation is replaced by\n  `t = u`.", "p": "mathlib"}, {"name": "tactic.unify_equations", "description": "Given a list of display names of local hypotheses that are (homogeneous or\nheterogeneous) equations, `unify_equations` performs first-order unification on\neach hypothesis in order. See `tactic.interactive.unify_equations` for an\nexample and an explanation of what unification does.\n\nReturns true iff the goal has been solved during the unification process.\n\nNote: you must make sure that the input names are unique in the context.", "p": "mathlib"}, {"name": "finpartition.energy_nonneg", "description": "", "p": "mathlib"}, {"name": "finpartition.energy_le_one", "description": "", "p": "mathlib"}, {"name": "finpartition.energy", "description": " The energy of a partition, also known as index. Auxiliary quantity for Szemer\u00e9di's regularity\nlemma.", "p": "mathlib"}, {"name": "finpartition.coe_energy", "description": "", "p": "mathlib"}, {"name": "is_invariant_subring.coe_subtype_hom", "description": "", "p": "mathlib"}, {"name": "is_invariant_subring.to_mul_semiring_action", "description": "", "p": "mathlib"}, {"name": "is_invariant_subring", "description": "A typeclass for subrings invariant under a `mul_semiring_action`.", "p": "mathlib"}, {"name": "is_invariant_subring.smul_mem", "description": "A typeclass for subrings invariant under a `mul_semiring_action`.", "p": "mathlib"}, {"name": "is_invariant_subring.subtype_hom", "description": "The canonical inclusion from an invariant subring.", "p": "mathlib"}, {"name": "is_invariant_subring.coe_subtype_hom'", "description": "", "p": "mathlib"}, {"name": "tactic.equiv_rw_type", "description": "`equiv_rw_type e t` rewrites the type `t` using the equivalence `e : \u03b1 \u2243 \u03b2`,\nreturning a new equivalence `t \u2243 t'`.", "p": "mathlib"}, {"name": "tactic.equiv_rw_cfg", "description": "Configuration structure for `equiv_rw`.\n\n* `max_depth` bounds the search depth for equivalences to rewrite along.\n  The default value is 10.\n  (e.g., if you're rewriting along `e : \u03b1 \u2243 \u03b2`, and `max_depth := 2`,\n  you can rewrite `option (option \u03b1))` but not `option (option (option \u03b1))`.", "p": "mathlib"}, {"name": "tactic.equiv_rw_cfg.max_depth", "description": "Configuration structure for `equiv_rw`.\n\n* `max_depth` bounds the search depth for equivalences to rewrite along.\n  The default value is 10.\n  (e.g., if you're rewriting along `e : \u03b1 \u2243 \u03b2`, and `max_depth := 2`,\n  you can rewrite `option (option \u03b1))` but not `option (option (option \u03b1))`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.equiv_rw", "description": "`equiv_rw e at h\u2081 h\u2082 \u22ef`, where each `h\u1d62 : \u03b1` is a hypothesis, and `e : \u03b1 \u2243 \u03b2`,\nwill attempt to transport each `h\u1d62` along `e`, producing a new hypothesis `h\u1d62 : \u03b2`,\nwith all occurrences of `h\u1d62` in other hypotheses and the goal replaced with `e.symm h\u1d62`.\n\n`equiv_rw e` will attempt to transport the goal along an equivalence `e : \u03b1 \u2243 \u03b2`.\nIn its minimal form it replaces the goal `\u22a2 \u03b1` with `\u22a2 \u03b2` by calling `apply e.inv_fun`.\n\n`equiv_rw [e\u2081, e\u2082, \u22ef] at h\u2081 h\u2082 \u22ef` is equivalent to\n`{ equiv_rw [e\u2081, e\u2082, \u22ef] at h\u2081, equiv_rw [e\u2081, e\u2082, \u22ef] at h\u2082, \u22ef }`.\n\n`equiv_rw [e\u2081, e\u2082, \u22ef] at *` will attempt to apply `equiv_rw [e\u2081, e\u2082, \u22ef]` on the goal\nand on each expression available in the local context (except on the `e\u1d62`s themselves),\nfailing silently when it can't. Failing on a rewrite for a certain `e\u1d62` at a certain\nhypothesis `h` doesn't stop `equiv_rw` from trying the other equivalences on the list\nat `h`. This only happens for the wildcard location.\n\n`equiv_rw` will also try rewriting under (equiv_)functors, so it can turn\na hypothesis `h : list \u03b1` into `h : list \u03b2` or\na goal `\u22a2 unique \u03b1` into `\u22a2 unique \u03b2`.\n\nThe maximum search depth for rewriting in subexpressions is controlled by\n`equiv_rw e {max_depth := n}`.", "p": "mathlib"}, {"name": "tactic.interactive.equiv_rw_target_aux", "description": "Auxiliary function to call `equiv_rw_target` on a `list pexpr` recursively.", "p": "mathlib"}, {"name": "tactic.equiv_rw_type_core", "description": "Implementation of `equiv_rw_type`, using `solve_by_elim`.\nExpects a goal of the form `t \u2243 _`,\nand tries to solve it using `eq : \u03b1 \u2243 \u03b2` and congruence lemmas.", "p": "mathlib"}, {"name": "tactic.interactive.equiv_rw_hyp_aux", "description": "Auxiliary function to call `equiv_rw_hyp` on a `list pexpr` recursively.", "p": "mathlib"}, {"name": "tactic.equiv_congr_lemmas", "description": "A list of lemmas used for constructing congruence equivalences.", "p": "mathlib"}, {"name": "tactic.interactive.equiv_rw_type", "description": "Solve a goal of the form `t \u2243 _`,\nby constructing an equivalence from `e : \u03b1 \u2243 \u03b2`.\nThis is the same equivalence that `equiv_rw` would use to rewrite a term of type `t`.\n\nA typical usage might be:\n```lean\nhave e' : option \u03b1 \u2243 option \u03b2 := by equiv_rw_type e\n```", "p": "mathlib"}, {"name": "tactic_doc.tactic.equiv_rw_type", "description": "Solve a goal of the form `t \u2243 _`,\nby constructing an equivalence from `e : \u03b1 \u2243 \u03b2`.\nThis is the same equivalence that `equiv_rw` would use to rewrite a term of type `t`.\n\nA typical usage might be:\n```lean\nhave e' : option \u03b1 \u2243 option \u03b2 := by equiv_rw_type e\n```", "p": "mathlib"}, {"name": "tactic.equiv_rw_hyp", "description": "Attempt to replace the hypothesis with name `x`\nby transporting it along the equivalence in `e : \u03b1 \u2243 \u03b2`.", "p": "mathlib"}, {"name": "tactic.equiv_rw_target", "description": "Rewrite the goal using an equiv `e`.", "p": "mathlib"}, {"name": "tactic.interactive.equiv_rw", "description": "`equiv_rw e at h\u2081 h\u2082 \u22ef`, where each `h\u1d62 : \u03b1` is a hypothesis, and `e : \u03b1 \u2243 \u03b2`,\nwill attempt to transport each `h\u1d62` along `e`, producing a new hypothesis `h\u1d62 : \u03b2`,\nwith all occurrences of `h\u1d62` in other hypotheses and the goal replaced with `e.symm h\u1d62`.\n\n`equiv_rw e` will attempt to transport the goal along an equivalence `e : \u03b1 \u2243 \u03b2`.\nIn its minimal form it replaces the goal `\u22a2 \u03b1` with `\u22a2 \u03b2` by calling `apply e.inv_fun`.\n\n`equiv_rw [e\u2081, e\u2082, \u22ef] at h\u2081 h\u2082 \u22ef` is equivalent to\n`{ equiv_rw [e\u2081, e\u2082, \u22ef] at h\u2081, equiv_rw [e\u2081, e\u2082, \u22ef] at h\u2082, \u22ef }`.\n\n`equiv_rw [e\u2081, e\u2082, \u22ef] at *` will attempt to apply `equiv_rw [e\u2081, e\u2082, \u22ef]` on the goal\nand on each expression available in the local context (except on the `e\u1d62`s themselves),\nfailing silently when it can't. Failing on a rewrite for a certain `e\u1d62` at a certain\nhypothesis `h` doesn't stop `equiv_rw` from trying the other equivalences on the list\nat `h`. This only happens for the wildcard location.\n\n`equiv_rw` will also try rewriting under (equiv_)functors, so it can turn\na hypothesis `h : list \u03b1` into `h : list \u03b2` or\na goal `\u22a2 unique \u03b1` into `\u22a2 unique \u03b2`.\n\nThe maximum search depth for rewriting in subexpressions is controlled by\n`equiv_rw e {max_depth := n}`.", "p": "mathlib"}, {"name": "tactic.mllist.m_of_list", "description": "Convert a `list` of values inside the monad into an `mllist`.", "p": "mathlib"}, {"name": "tactic.mllist.empty", "description": "Compute, inside the monad, whether an `mllist` is empty.", "p": "mathlib"}, {"name": "tactic.mllist.head", "description": "Return the head of a monadic lazy list, as a value in the monad.", "p": "mathlib"}, {"name": "tactic.mllist.force", "description": "Extract a list inside the monad from an `mllist`.", "p": "mathlib"}, {"name": "tactic.mllist.enum_from", "description": "Enumerate the elements of a monadic lazy list, starting at a specified offset.", "p": "mathlib"}, {"name": "tactic.mllist.map", "description": "Apply a function to every element of an `mllist`.", "p": "mathlib"}, {"name": "tactic.mllist.enum", "description": "Enumerate the elements of a monadic lazy list.", "p": "mathlib"}, {"name": "tactic.mllist.filter", "description": "Filter a `mllist`.", "p": "mathlib"}, {"name": "tactic.mllist.fix", "description": "Construct an `mllist` recursively.", "p": "mathlib"}, {"name": "tactic.mllist.squash", "description": "Lift a monadic lazy list inside the monad to a monadic lazy list.", "p": "mathlib"}, {"name": "tactic.mllist.range", "description": "The infinite monadic lazy list of natural numbers.", "p": "mathlib"}, {"name": "tactic.mllist.concat", "description": "Add one element to the end of a monadic lazy list.", "p": "mathlib"}, {"name": "tactic.mllist.of_list", "description": "Convert a `list` to an `mllist`.", "p": "mathlib"}, {"name": "tactic.mllist.fixl_with", "description": " Repeatedly apply a function `f : \u03b1 \u2192 m (\u03b1 \u00d7 list \u03b2)` to an initial `a : \u03b1`,\naccumulating the elements of the resulting `list \u03b2` as a single monadic lazy list.\n\n(This variant allows starting with a specified `list \u03b2` of elements, as well. )", "p": "mathlib"}, {"name": "tactic.mllist.bind_", "description": " Apply a function returning a monadic lazy list to each element of a monadic lazy list,\njoining the results.", "p": "mathlib"}, {"name": "tactic.mllist", "description": "A monadic lazy list, controlled by an arbitrary monad.", "p": "mathlib"}, {"name": "tactic.mllist.nil", "description": "A monadic lazy list, controlled by an arbitrary monad.", "p": "mathlib"}, {"name": "tactic.mllist.cons", "description": "A monadic lazy list, controlled by an arbitrary monad.", "p": "mathlib"}, {"name": "tactic.mllist.uncons", "description": " Deconstruct an `mllist`, returning inside the monad an optional pair `\u03b1 \u00d7 mllist m \u03b1`\nrepresenting the head and tail of the list.", "p": "mathlib"}, {"name": "tactic.mllist.mmap", "description": "Apply a function which returns values in the monad to every element of an `mllist`.", "p": "mathlib"}, {"name": "tactic.mllist.filter_map", "description": "Filter and transform a `mllist` using an `option` valued function.", "p": "mathlib"}, {"name": "tactic.mllist.monad_lift", "description": "Convert any value in the monad to the singleton monadic lazy list.", "p": "mathlib"}, {"name": "tactic.mllist.join", "description": "Join a monadic lazy list of monadic lazy lists into a single monadic lazy list.", "p": "mathlib"}, {"name": "tactic.mllist.mfirst", "description": " Apply a function returning values inside the monad to a monadic lazy list,\nreturning only the first successful result.", "p": "mathlib"}, {"name": "tactic.mllist.take", "description": "Take the first `n` elements, as a list inside the monad.", "p": "mathlib"}, {"name": "tactic.mllist.mfilter", "description": " Filter a `mllist` using a function which returns values in the (alternative) monad.\nWhenever the function \"succeeds\", we accept the element, and reject otherwise.", "p": "mathlib"}, {"name": "tactic.mllist.append", "description": "Concatenate two monadic lazty lists.", "p": "mathlib"}, {"name": "tactic.mllist.mfilter_map", "description": " Filter and transform a `mllist` using a function that returns values inside the monad.\nWe discard elements where the function fails.", "p": "mathlib"}, {"name": "tactic.mllist.fixl", "description": " Repeatedly apply a function `f : \u03b1 \u2192 m (\u03b1 \u00d7 list \u03b2)` to an initial `a : \u03b1`,\naccumulating the elements of the resulting `list \u03b2` as a single monadic lazy list.", "p": "mathlib"}, {"name": "auto_param_eq", "description": "", "p": "core"}, {"name": "name.has_append", "description": "", "p": "core"}, {"name": "name.has_lt", "description": "", "p": "core"}, {"name": "name.inhabited", "description": "", "p": "core"}, {"name": "mk_simple_name", "description": "", "p": "core"}, {"name": "name.is_suffix_of", "description": "", "p": "core"}, {"name": "name.append", "description": "", "p": "core"}, {"name": "name.components", "description": "", "p": "core"}, {"name": "string_to_name", "description": "", "p": "core"}, {"name": "name.replace_prefix", "description": "", "p": "core"}, {"name": "name", "description": "Reflect a C++ name object. The VM replaces it with the C++ implementation.", "p": "core"}, {"name": "name.anonymous", "description": "Reflect a C++ name object. The VM replaces it with the C++ implementation.", "p": "core"}, {"name": "name.mk_string", "description": "Reflect a C++ name object. The VM replaces it with the C++ implementation.", "p": "core"}, {"name": "name.mk_numeral", "description": "Reflect a C++ name object. The VM replaces it with the C++ implementation.", "p": "core"}, {"name": "name.lex_cmp", "description": "", "p": "core"}, {"name": "name.to_string", "description": "", "p": "core"}, {"name": "name.is_internal", "description": "", "p": "core"}, {"name": "name.has_decidable_eq", "description": "", "p": "core"}, {"name": "name.repr", "description": "", "p": "core"}, {"name": "name.lt.decidable_rel", "description": "", "p": "core"}, {"name": "name.has_repr", "description": "", "p": "core"}, {"name": "name.append_after", "description": "`name.append_after n i` return a name of the form n_i", "p": "core"}, {"name": "name.has_to_string", "description": "", "p": "core"}, {"name": "name.is_prefix_of", "description": "", "p": "core"}, {"name": "name.lt", "description": "", "p": "core"}, {"name": "name.get_prefix", "description": "", "p": "core"}, {"name": "name.to_string_with_sep", "description": "", "p": "core"}, {"name": "name.update_prefix", "description": "", "p": "core"}, {"name": "mk_num_name", "description": "", "p": "core"}, {"name": "auto_param", "description": "Gadget for automatic parameter support. This is similar to the opt_param gadget, but it uses\n   the tactic declaration names tac_name to synthesize the argument.\n   Like opt_param, this gadget only affects elaboration.\n   For example, the tactic will *not* be invoked during type class resolution.", "p": "core"}, {"name": "name.cmp", "description": "", "p": "core"}, {"name": "mk_str_name", "description": "", "p": "core"}, {"name": "tactic.interactive.move_add", "description": "Calling `move_add [a, \u2190 b, c]`, recursively looks inside the goal for expressions involving a sum.\nWhenever it finds one, it moves the summands that unify to `a, b, c`, removing all parentheses.\nRepetitions are allowed, and are processed following the user-specified ordering.\nThe terms preceded by a `\u2190` get placed to the left, the ones without the arrow get placed to the\nright.  Unnamed terms stay in place.  Due to re-parenthesizing, doing `move_add` with no argument\nmay change the goal. Also, the *order* in which the terms are provided matters: the tactic reads\nthem from left to right.  This is especially important if there are multiple matches for the typed\nterms in the given expressions.\n\nA single call of `move_add` moves terms across different sums in the same expression.\nHere is an example.\n\n```lean\nimport tactic.move_add\n\nexample {a b c d : \u2115} (h : c = d) : c + b + a = b + a + d :=\nbegin\n  move_add [\u2190 a, b],  -- Goal: `a + c + b = a + d + b`  -- both sides changed\n  congr,\n  exact h\nend\n\nexample {a b c d : \u2115} (h : c = d) : c + b * c + a * c = a * d + d + b * d :=\nbegin\n  move_add [_ * c, \u2190 _ * c], -- Goal: `a * c + c + b * c = a * d + d + b * d`\n  -- the first `_ * c` unifies with `b * c` and moves to the right\n  -- the second `_ * c` unifies with `a * c` and moves to the left\n  congr;\n  assumption\nend\n```\n\nThe list of expressions that `move_add` takes is optional and a single expression can be passed\nwithout brackets.  Thus `move_add \u2190 f` and `move_add [\u2190 f]` mean the same.\n\nFinally, `move_add` can also target one or more hypotheses.  If `hp\u2081, hp\u2082` are in the\nlocal context, then `move_add [f, \u2190 g] at hp\u2081 hp\u2082` performs the rearranging at `hp\u2081` and `hp\u2082`.\nAs usual, passing `\u22a2` refers to acting on the goal.\n\n##  Reporting sub-optimal usage\n\nThe tactic could fail to prove the reordering.  One potential cause is when there are multiple\nmatches for the rearrangements and an earlier rewrite makes a subsequent one fail.  Another\npossibility is that the rearranged expression changes the *Type* of some expression and the\ntactic gets stumped.  Please, report bugs and failures in the Zulip chat!\n\nThere are three kinds of unwanted use for `move_add` that result in errors, where the tactic fails\nand flags the unwanted use.\n1. `move_add [vars]? at *` reports globally unused variables and whether *all* goals\n   are unchanged, not *each unchanged goal*.\n2. If a target of `move_add [vars]? at targets` is left unchanged by the tactic, then this will be\n   flagged (unless we are using `at *`).\n3. If a user-provided expression never unifies, then the variable is flagged.\n\nIn these cases, the tactic produces an error, reporting unused inputs and unchanged targets as\nappropriate.\n\nFor instance, `move_add \u2190 _` always fails reporting an unchanged goal, but never an unused variable.\n\n##  Comparison with existing tactics\n\n* `tactic.interactive.abel`\n  performs a \"reduction to normal form\" that allows it to close goals involving sums with higher\n  success rate than `move_add`.  If the goal is an equality of two sums that are simply obtained by\n  reparenthesizing and permuting summands, then `move_add [appropriate terms]` can close the goal.\n  Compared to `abel`, `move_add` has the advantage of allowing the user to specify the beginning and\n  the end of the final sum, so that from there the user can continue with the proof.\n\n* `tactic.interactive.ac_change`\n  supports a wide variety of operations.  At the moment, `move_add` works with addition, `move_mul`\n  works with multiplication.  There is the possibility of supporting other operations, using the\n  non-interactive tactic `tactic.move_op`.\n  Still, on several experiments, `move_add` had a much quicker performance than `ac_change`.\n  Also, for `move_add` the user need only specify a few terms: the tactic itself takes care of\n  producing the full rearrangement and proving it \"behind the scenes\".\n\n###  Remark:\nIt is still possible that the same output of `move_add [exprs]` can be achieved by a proper sublist\nof `[exprs]`, even if the tactic does not flag anything.  For instance, giving the full re-ordering\nof the expressions in the target that we want to achieve will not complain that there are unused\nvariables, since all the user-provided variables have been matched.  Of course, specifying the order\nof all-but-the-last variable suffices to determine the permutation.  E.g., with a goal of\n`a + b = 0`, applying either one of `move_add [b,a]`, or `move_add a`, or `move_add \u2190 b` has the\nsame effect and changes the goal to `b + a = 0`.  These are all valid uses of `move_add`.", "p": "mathlib"}, {"name": "tactic.move_op.move_op_arg", "description": " `move_op_arg` is a single elementary argument that `move_op` takes for the\nvariables to be moved.  It is either a `pexpr`, or a `pexpr` preceded by a `\u2190`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.move_add", "description": "Calling `move_add [a, \u2190 b, c]`, recursively looks inside the goal for expressions involving a sum.\nWhenever it finds one, it moves the summands that unify to `a, b, c`, removing all parentheses.\nRepetitions are allowed, and are processed following the user-specified ordering.\nThe terms preceded by a `\u2190` get placed to the left, the ones without the arrow get placed to the\nright.  Unnamed terms stay in place.  Due to re-parenthesizing, doing `move_add` with no argument\nmay change the goal. Also, the *order* in which the terms are provided matters: the tactic reads\nthem from left to right.  This is especially important if there are multiple matches for the typed\nterms in the given expressions.\n\nA single call of `move_add` moves terms across different sums in the same expression.\nHere is an example.\n\n```lean\nimport tactic.move_add\n\nexample {a b c d : \u2115} (h : c = d) : c + b + a = b + a + d :=\nbegin\n  move_add [\u2190 a, b],  -- Goal: `a + c + b = a + d + b`  -- both sides changed\n  congr,\n  exact h\nend\n\nexample {a b c d : \u2115} (h : c = d) : c + b * c + a * c = a * d + d + b * d :=\nbegin\n  move_add [_ * c, \u2190 _ * c], -- Goal: `a * c + c + b * c = a * d + d + b * d`\n  -- the first `_ * c` unifies with `b * c` and moves to the right\n  -- the second `_ * c` unifies with `a * c` and moves to the left\n  congr;\n  assumption\nend\n```\n\nThe list of expressions that `move_add` takes is optional and a single expression can be passed\nwithout brackets.  Thus `move_add \u2190 f` and `move_add [\u2190 f]` mean the same.\n\nFinally, `move_add` can also target one or more hypotheses.  If `hp\u2081, hp\u2082` are in the\nlocal context, then `move_add [f, \u2190 g] at hp\u2081 hp\u2082` performs the rearranging at `hp\u2081` and `hp\u2082`.\nAs usual, passing `\u22a2` refers to acting on the goal.\n\n##  Reporting sub-optimal usage\n\nThe tactic could fail to prove the reordering.  One potential cause is when there are multiple\nmatches for the rearrangements and an earlier rewrite makes a subsequent one fail.  Another\npossibility is that the rearranged expression changes the *Type* of some expression and the\ntactic gets stumped.  Please, report bugs and failures in the Zulip chat!\n\nThere are three kinds of unwanted use for `move_add` that result in errors, where the tactic fails\nand flags the unwanted use.\n1. `move_add [vars]? at *` reports globally unused variables and whether *all* goals\n   are unchanged, not *each unchanged goal*.\n2. If a target of `move_add [vars]? at targets` is left unchanged by the tactic, then this will be\n   flagged (unless we are using `at *`).\n3. If a user-provided expression never unifies, then the variable is flagged.\n\nIn these cases, the tactic produces an error, reporting unused inputs and unchanged targets as\nappropriate.\n\nFor instance, `move_add \u2190 _` always fails reporting an unchanged goal, but never an unused variable.\n\n##  Comparison with existing tactics\n\n* `tactic.interactive.abel`\n  performs a \"reduction to normal form\" that allows it to close goals involving sums with higher\n  success rate than `move_add`.  If the goal is an equality of two sums that are simply obtained by\n  reparenthesizing and permuting summands, then `move_add [appropriate terms]` can close the goal.\n  Compared to `abel`, `move_add` has the advantage of allowing the user to specify the beginning and\n  the end of the final sum, so that from there the user can continue with the proof.\n\n* `tactic.interactive.ac_change`\n  supports a wide variety of operations.  At the moment, `move_add` works with addition, `move_mul`\n  works with multiplication.  There is the possibility of supporting other operations, using the\n  non-interactive tactic `tactic.move_op`.\n  Still, on several experiments, `move_add` had a much quicker performance than `ac_change`.\n  Also, for `move_add` the user need only specify a few terms: the tactic itself takes care of\n  producing the full rearrangement and proving it \"behind the scenes\".\n\n###  Remark:\nIt is still possible that the same output of `move_add [exprs]` can be achieved by a proper sublist\nof `[exprs]`, even if the tactic does not flag anything.  For instance, giving the full re-ordering\nof the expressions in the target that we want to achieve will not complain that there are unused\nvariables, since all the user-provided variables have been matched.  Of course, specifying the order\nof all-but-the-last variable suffices to determine the permutation.  E.g., with a goal of\n`a + b = 0`, applying either one of `move_add [b,a]`, or `move_add a`, or `move_add \u2190 b` has the\nsame effect and changes the goal to `b + a = 0`.  These are all valid uses of `move_add`.", "p": "mathlib"}, {"name": "tactic.move_op.move_pexpr_list_or_texpr", "description": " `move_pexpr_list_or_texpr` is either a list of `move_op_arg`, possibly empty, or a single\n`move_op_arg`.", "p": "mathlib"}, {"name": "tactic.move_op.reorder_oper", "description": " `(e, unused) \u2190 reorder_oper op lp e` converts an expression `e` to a similar looking one.\nThe tactic scans the expression `e` looking for subexpressions that begin with the given binary\noperation `op`.  As soon as `reorder_oper` finds one such subexpression,\n* it extracts the \"`op`-summands\" in the subexpression,\n* it rearranges them according to the rules determined by `lp`,\n* it recurses into each `op`-summand.\n\nThe `unused` output is a list of booleans.  It is keeping track of which of the inputs provided\nby `lp` is actually used to perform the rearrangements.  It is useful to report unused inputs.\n\nHere are two examples:\n```lean\n#eval trace $ reorder_oper ``((=)) [(ff,``(2)), (tt,``(7))] `(\u2200 x y : \u2115, 2 = 0)\n--  (\u2115 \u2192 \u2115 \u2192 0 = 2, [ff, tt])\n-- the input `[(ff,``(2)), (tt,``(7))]` instructs Lean to move `2` to the right and `7`\n-- to the left.  Lean reports that `2` is not unused and `7` is unused as `[ff, tt]`.\n\n#eval trace $ reorder_oper ``((+)) [(ff,``(2)), (tt,``(5))]\n  `(\u03bb (e : \u2115), \u2200 (x : \u2115), \u2203 (y : \u2115),\n      2 + x * (y + (e + 5)) + y = x + 2 + e \u2192 2 + x = x + 5 + (2 + y))\n/-  `2` moves to the right, `5` moves to the left.  Lean reports that `2, 5` are not unused\n    as `[ff,ff]`\n   (\u03bb (e : \u2115), \u2200 (x : \u2115), \u2203 (y : \u2115),\n      x * (5 + y + e) + y + 2   = x + e + 2 \u2192 x + 2 = 5 + x + y + 2, [ff, ff]) -/\n```\n\nTODO: use `ext_simplify_core` instead of traversing the expression manually", "p": "mathlib"}, {"name": "tactic.interactive.move_oper", "description": "  `move_oper` behaves like `move_add` except that it also takes an associative, commutative,\nbinary operation as input.  The operation must be passed as a list consisting of a single element.\nFor instance\n```lean\nexample (a b : \u2115) : max a b = max b a :=\nby move_oper [max] [\u2190 a, b] at *\n```\nsolves the goal.  For more details, see the `move_add` doc-string, replacing `add` with your\nintended operation.", "p": "mathlib"}, {"name": "tactic.move_op.as_given_op", "description": " `as_given_op op e` unifies the head term of `e`, which is a \u22652-argument function application,\nwith the binary operation `op`, failing if it cannot.", "p": "mathlib"}, {"name": "tactic.move_op.reorder_hyp", "description": " Passes the user input `na` to `reorder_oper` at a single location, that could either be\n`none` (referring to the goal) or `some name` (referring to hypothesis `name`).  Replaces the\ngiven hypothesis/goal with the rearranged one that `reorder_hyp` receives from `reorder_oper`.\nReturns a pair consisting of a boolean and a further list of booleans.\nThe single boolean is `tt` iff the tactic did *not* change the goal on which it was acting.\nThe list of booleans records which variable in `ll` has been unified in the application:\n`tt` means that the corresponding variable has *not* been unified.\n\nThis definition is useful to streamline error catching.", "p": "mathlib"}, {"name": "tactic.interactive.move_mul", "description": "  See the doc-string for `tactic.interactive.move_add` and mentally\nreplace addition with multiplication throughout. ;-)", "p": "mathlib"}, {"name": "tactic.move_op.return_unused", "description": "  Given a list `un` of `\u03b1`s and a list `bo` of `bool`s, return the sublist of `un`\nconsisting of the entries of `un` whose corresponding entry in `bo` is `tt`.\n\nUsed for error management: `un` is the list of user inputs, `bo` is the list encoding which input\nis unused (`tt`) and which input is used (`ff`).\n`return_unused` returns the unused user inputs.\n\nIf `bo` is shorter than `un`, `return_unused` will include the remainder of `un`.", "p": "mathlib"}, {"name": "tactic.move_op", "description": "  `move_op args locat op` is the non-interactive version of the main tactics `move_add` and\n`move_mul` of this file.  Given as input `args` (a list of terms of a sequence of operands),\n`locat` (hypotheses or goal where the tactic should act) and `op` (the operation to use),\n`move_op` attempts to perform the rearrangement of the terms determined by `args`.\n\nCurrently, the tactic uses only `add/mul_comm, add/mul_assoc, add/mul_left_comm`, so other\noperations will not actually work.", "p": "mathlib"}, {"name": "tactic.move_op.move_left_or_right", "description": "  Given a list `lp` of `bool \u00d7 pexpr` and a list `l_un` of `expr`, scan the elements of `lp` one\nat a time and produce 3 sublists of `l_un`.\n\nIf `(tf,pe)` is the first element of `lp`, we look for the first element of `l_un` that unifies with\n`pe.to_expr`.  If no such element exists, then we discard `(tf,pe)` and move along.\nIf `eu \u2208 l_un` is the first element of `l_un` that unifies with `pe.to_expr`, then we add `eu` as\nthe next element of either the first or the second list, depending on the boolean `tf` and we remove\n`eu` from the list `l_un`.  In this case, we continue our scanning with the next element of `lp`,\nreplacing `l_un` by `l_un.erase eu`.\n\nOnce we exhaust the elements of `lp`, we return the four lists:\n* `l_tt`: the list of elements of `l_un` that came from an element of `lp` whose boolean was `tt`,\n* `l_ff`: the list of elements of `l_un` that came from an element of `lp` whose boolean was `ff`,\n* `l_un`: the un-unified elements of `l_un`,\n* `l_m`: a \"mask\" list of booleans corresponding to the elements of `lp` that were placed in `l_un`.\n\nThe ununified elements of `l_un` get used for error management: they keep track of which user inputs\nare superfluous.", "p": "mathlib"}, {"name": "tactic_doc.tactic.move_mul", "description": "  See the doc-string for `tactic.interactive.move_add` and mentally\nreplace addition with multiplication throughout. ;-)", "p": "mathlib"}, {"name": "tactic.move_op.final_sort", "description": "  We adapt `move_left_or_right` to our goal:\n1. we convert a list of pairs `bool \u00d7 pexpr` to a list of pairs `bool \u00d7 expr`,\n2. we use the extra input `sl : list expr` to perform the unification and sorting step\n   `move_left_or_right`,\n3. we jam the third factor inside the first two.", "p": "mathlib"}, {"name": "nat.not_mem_of_lt_Inf", "description": "", "p": "mathlib"}, {"name": "nat.nonempty_of_Inf_eq_succ", "description": "", "p": "mathlib"}, {"name": "nat.Sup_mem", "description": "", "p": "mathlib"}, {"name": "nat.Inf_def", "description": "", "p": "mathlib"}, {"name": "nat.infi_of_empty", "description": "", "p": "mathlib"}, {"name": "nat.Inf_upward_closed_eq_succ_iff", "description": "", "p": "mathlib"}, {"name": "nat.Inf_mem", "description": "", "p": "mathlib"}, {"name": "nat.has_Inf", "description": "", "p": "mathlib"}, {"name": "set.bInter_lt_succ", "description": "", "p": "mathlib"}, {"name": "nat.nonempty_of_pos_Inf", "description": "", "p": "mathlib"}, {"name": "set.infinite.nat.Sup_eq_zero", "description": "", "p": "mathlib"}, {"name": "nat.Inf_empty", "description": "", "p": "mathlib"}, {"name": "nat.supr_lt_succ", "description": "", "p": "mathlib"}, {"name": "nat.eq_Ici_of_nonempty_of_upward_closed", "description": "", "p": "mathlib"}, {"name": "nat.Inf_eq_zero", "description": "", "p": "mathlib"}, {"name": "nat.conditionally_complete_linear_order_bot", "description": "", "p": "mathlib"}, {"name": "set.bInter_lt_succ'", "description": "", "p": "mathlib"}, {"name": "nat.infi_lt_succ", "description": "", "p": "mathlib"}, {"name": "nat.lattice", "description": " This instance is necessary, otherwise the lattice operations would be derived via\nconditionally_complete_linear_order_bot and marked as noncomputable.", "p": "mathlib"}, {"name": "nat.Inf_add'", "description": "", "p": "mathlib"}, {"name": "nat.has_Sup", "description": "", "p": "mathlib"}, {"name": "nat.infi_lt_succ'", "description": "", "p": "mathlib"}, {"name": "set.bUnion_lt_succ", "description": "", "p": "mathlib"}, {"name": "nat.supr_lt_succ'", "description": "", "p": "mathlib"}, {"name": "set.bUnion_lt_succ'", "description": "", "p": "mathlib"}, {"name": "nat.Sup_def", "description": "", "p": "mathlib"}, {"name": "nat.Inf_add", "description": "", "p": "mathlib"}, {"name": "nat.Inf_le", "description": "", "p": "mathlib"}, {"name": "infer_type_cmd", "description": "", "p": "core"}, {"name": "hole_command", "description": "The front-end (e.g., Emacs, VS Code) can invoke commands for holes `{! ... !}` in\na declaration. A command is a tactic that takes zero or more pre-terms in the\nhole, and returns a list of pair (s, descr) where 's' is a substitution and 'descr' is\na short explanation for the substitution.\nEach string 's' represents a different way to fill the hole.\nThe front-end is responsible for replacing the hole with the string/alternative selected by the user.\n\nThis infra-structure can be use to implement auto-fill and/or refine commands.\n\nAn action may return an empty list. This is useful for actions that just return\ninformation such as: the type of an expression, its normal form, etc.", "p": "core"}, {"name": "hole_command.name", "description": "The front-end (e.g., Emacs, VS Code) can invoke commands for holes `{! ... !}` in\na declaration. A command is a tactic that takes zero or more pre-terms in the\nhole, and returns a list of pair (s, descr) where 's' is a substitution and 'descr' is\na short explanation for the substitution.\nEach string 's' represents a different way to fill the hole.\nThe front-end is responsible for replacing the hole with the string/alternative selected by the user.\n\nThis infra-structure can be use to implement auto-fill and/or refine commands.\n\nAn action may return an empty list. This is useful for actions that just return\ninformation such as: the type of an expression, its normal form, etc.", "p": "core"}, {"name": "hole_command.descr", "description": "The front-end (e.g., Emacs, VS Code) can invoke commands for holes `{! ... !}` in\na declaration. A command is a tactic that takes zero or more pre-terms in the\nhole, and returns a list of pair (s, descr) where 's' is a substitution and 'descr' is\na short explanation for the substitution.\nEach string 's' represents a different way to fill the hole.\nThe front-end is responsible for replacing the hole with the string/alternative selected by the user.\n\nThis infra-structure can be use to implement auto-fill and/or refine commands.\n\nAn action may return an empty list. This is useful for actions that just return\ninformation such as: the type of an expression, its normal form, etc.", "p": "core"}, {"name": "hole_command.action", "description": "The front-end (e.g., Emacs, VS Code) can invoke commands for holes `{! ... !}` in\na declaration. A command is a tactic that takes zero or more pre-terms in the\nhole, and returns a list of pair (s, descr) where 's' is a substitution and 'descr' is\na short explanation for the substitution.\nEach string 's' represents a different way to fill the hole.\nThe front-end is responsible for replacing the hole with the string/alternative selected by the user.\n\nThis infra-structure can be use to implement auto-fill and/or refine commands.\n\nAn action may return an empty list. This is useful for actions that just return\ninformation such as: the type of an expression, its normal form, etc.", "p": "core"}, {"name": "use_cmd", "description": "", "p": "core"}, {"name": "show_goal_cmd", "description": "", "p": "core"}, {"name": "list.Ico.filter_lt", "description": "", "p": "mathlib"}, {"name": "list.Ico.map_add", "description": "", "p": "mathlib"}, {"name": "list.Ico.eq_nil_of_le", "description": "", "p": "mathlib"}, {"name": "list.Ico.pairwise_lt", "description": "", "p": "mathlib"}, {"name": "list.Ico.filter_le_of_top_le", "description": "", "p": "mathlib"}, {"name": "list.Ico.map_sub", "description": "", "p": "mathlib"}, {"name": "list.Ico.filter_lt_of_succ_bot", "description": "", "p": "mathlib"}, {"name": "list.Ico.append_consecutive", "description": "", "p": "mathlib"}, {"name": "list.Ico.filter_le", "description": "", "p": "mathlib"}, {"name": "list.Ico.eq_empty_iff", "description": "", "p": "mathlib"}, {"name": "list.Ico", "description": "`Ico n m` is the list of natural numbers `n \u2264 x < m`.\n(Ico stands for \"interval, closed-open\".)\n\nSee also `data/set/intervals.lean` for `set.Ico`, modelling intervals in general preorders, and\n`multiset.Ico` and `finset.Ico` for `n \u2264 x < m` as a multiset or as a finset.", "p": "mathlib"}, {"name": "list.Ico.length", "description": "", "p": "mathlib"}, {"name": "list.Ico.not_mem_top", "description": "", "p": "mathlib"}, {"name": "list.Ico.inter_consecutive", "description": "", "p": "mathlib"}, {"name": "list.Ico.chain'_succ", "description": "", "p": "mathlib"}, {"name": "list.Ico.zero_bot", "description": "", "p": "mathlib"}, {"name": "list.Ico.pred_singleton", "description": "", "p": "mathlib"}, {"name": "list.Ico.filter_lt_of_top_le", "description": "", "p": "mathlib"}, {"name": "list.Ico.succ_singleton", "description": "", "p": "mathlib"}, {"name": "list.Ico.filter_lt_of_le_bot", "description": "", "p": "mathlib"}, {"name": "list.Ico.filter_lt_of_ge", "description": "", "p": "mathlib"}, {"name": "list.Ico.bag_inter_consecutive", "description": "", "p": "mathlib"}, {"name": "list.Ico.eq_cons", "description": "", "p": "mathlib"}, {"name": "list.Ico.filter_le_of_le", "description": "", "p": "mathlib"}, {"name": "list.Ico.self_empty", "description": "", "p": "mathlib"}, {"name": "list.Ico.trichotomy", "description": "For any natural numbers n, a, and b, one of the following holds:\n1. n < a\n2. n \u2265 b\n3. n \u2208 Ico a b", "p": "mathlib"}, {"name": "list.Ico.filter_le_of_le_bot", "description": "", "p": "mathlib"}, {"name": "list.Ico.mem", "description": "", "p": "mathlib"}, {"name": "list.Ico.succ_top", "description": "", "p": "mathlib"}, {"name": "list.Ico.filter_le_of_bot", "description": "", "p": "mathlib"}, {"name": "list.Ico.nodup", "description": "", "p": "mathlib"}, {"name": "integrable_on_exp_Iic", "description": "", "p": "mathlib"}, {"name": "integral_Ioi_rpow_of_lt", "description": "", "p": "mathlib"}, {"name": "integral_exp_Iic_zero", "description": "", "p": "mathlib"}, {"name": "integral_Ioi_cpow_of_lt", "description": "", "p": "mathlib"}, {"name": "integral_exp_neg_Ioi_zero", "description": "", "p": "mathlib"}, {"name": "integrable_on_Ioi_cpow_of_lt", "description": "", "p": "mathlib"}, {"name": "integral_exp_Iic", "description": "", "p": "mathlib"}, {"name": "integrable_on_Ioi_rpow_of_lt", "description": "If `0 < c`, then `(\u03bb t : \u211d, t ^ a)` is integrable on `(c, \u221e)` for all `a < -1`.", "p": "mathlib"}, {"name": "integral_exp_neg_Ioi", "description": "", "p": "mathlib"}, {"name": "function.maps_to_fixed_pts_comp", "description": "Any map `f` sends fixed points of `g \u2218 f` to fixed points of `f \u2218 g`.", "p": "mathlib"}, {"name": "function.fixed_points_id", "description": "", "p": "mathlib"}, {"name": "function.commute.left_bij_on_fixed_pts_comp", "description": " If self-maps `f` and `g` commute, then `f` is bijective on the set of fixed points of `f \u2218 g`.\nThis is a particular case of `function.bij_on_fixed_pts_comp`.", "p": "mathlib"}, {"name": "function.is_fixed_pt.eq", "description": "If `x` is a fixed point of `f`, then `f x = x`. This is useful, e.g., for `rw` or `simp`.", "p": "mathlib"}, {"name": "function.mem_fixed_points", "description": "", "p": "mathlib"}, {"name": "function.is_fixed_pt", "description": "A point `x` is a fixed point of `f : \u03b1 \u2192 \u03b1` if `f x = x`.", "p": "mathlib"}, {"name": "function.is_fixed_pt.perm_inv", "description": "", "p": "mathlib"}, {"name": "function.commute.inv_on_fixed_pts_comp", "description": " If self-maps `f` and `g` commute, then they are inverse of each other on the set of fixed points\nof `f \u2218 g`. This is a particular case of `function.inv_on_fixed_pts_comp`.", "p": "mathlib"}, {"name": "function.fixed_points_subset_range", "description": "", "p": "mathlib"}, {"name": "function.mem_fixed_points_iff", "description": "", "p": "mathlib"}, {"name": "function.inv_on_fixed_pts_comp", "description": " Any two maps `f : \u03b1 \u2192 \u03b2` and `g : \u03b2 \u2192 \u03b1` are inverse of each other on the sets of fixed points\nof `f \u2218 g` and `g \u2218 f`, respectively.", "p": "mathlib"}, {"name": "function.is_fixed_pt.perm_pow", "description": "", "p": "mathlib"}, {"name": "function.is_fixed_pt.perm_zpow", "description": "", "p": "mathlib"}, {"name": "function.is_fixed_pt.equiv_symm", "description": "", "p": "mathlib"}, {"name": "function.is_fixed_pt_id", "description": "Every point is a fixed point of `id`.", "p": "mathlib"}, {"name": "function.injective.is_fixed_pt_apply_iff", "description": "", "p": "mathlib"}, {"name": "function.fixed_points", "description": "The set of fixed points of a map `f : \u03b1 \u2192 \u03b1`.", "p": "mathlib"}, {"name": "function.is_fixed_pt.decidable", "description": "", "p": "mathlib"}, {"name": "function.is_fixed_pt.comp", "description": "If `x` is a fixed point of `f` and `g`, then it is a fixed point of `f \u2218 g`.", "p": "mathlib"}, {"name": "function.is_fixed_pt.to_left_inverse", "description": " If `x` is a fixed point of `f` and `g` is a left inverse of `f`, then `x` is a fixed\npoint of `g`.", "p": "mathlib"}, {"name": "function.is_fixed_pt.iterate", "description": "If `x` is a fixed point of `f`, then it is a fixed point of `f^[n]`.", "p": "mathlib"}, {"name": "function.is_fixed_pt.apply", "description": "", "p": "mathlib"}, {"name": "function.fixed_points.decidable", "description": "", "p": "mathlib"}, {"name": "function.is_fixed_pt.left_of_comp", "description": "If `x` is a fixed point of `f \u2218 g` and `g`, then it is a fixed point of `f`.", "p": "mathlib"}, {"name": "function.bij_on_fixed_pts_comp", "description": " Given two maps `f : \u03b1 \u2192 \u03b2` and `g : \u03b2 \u2192 \u03b1`, `g` is a bijective map between the fixed points\nof `f \u2218 g` and the fixed points of `g \u2218 f`. The inverse map is `f`, see `inv_on_fixed_pts_comp`.", "p": "mathlib"}, {"name": "function.semiconj.maps_to_fixed_pts", "description": " If `g` semiconjugates `fa` to `fb`, then it sends fixed points of `fa` to fixed points\nof `fb`.", "p": "mathlib"}, {"name": "function.is_fixed_pt.map", "description": " If `g` (semi)conjugates `fa` to `fb`, then it sends fixed points of `fa` to fixed points\nof `fb`.", "p": "mathlib"}, {"name": "function.commute.right_bij_on_fixed_pts_comp", "description": " If self-maps `f` and `g` commute, then `g` is bijective on the set of fixed points of `f \u2218 g`.\nThis is a particular case of `function.bij_on_fixed_pts_comp`.", "p": "mathlib"}, {"name": "function.is_fixed_pt.preimage_iterate", "description": "", "p": "mathlib"}, {"name": "matrix.mul\u1d63", "description": "`matrix.mul` with better defeq for `fin`", "p": "mathlib"}, {"name": "matrix.transpose\u1d63", "description": "`matrix.tranpose` with better defeq for `fin`", "p": "mathlib"}, {"name": "matrix.mul_vec\u1d63_eq", "description": " This can be used to prove\n```lean\nexample [non_unital_non_assoc_semiring \u03b1] (a\u2081\u2081 a\u2081\u2082 a\u2082\u2081 a\u2082\u2082 b\u2081 b\u2082 : \u03b1) :\n  !![a\u2081\u2081, a\u2081\u2082;\n     a\u2082\u2081, a\u2082\u2082].mul_vec ![b\u2081, b\u2082] = ![a\u2081\u2081*b\u2081 + a\u2081\u2082*b\u2082, a\u2082\u2081*b\u2081 + a\u2082\u2082*b\u2082] :=\n(mul_vec\u1d63_eq _ _).symm\n```", "p": "mathlib"}, {"name": "matrix.exists", "description": "`\u2203` with better defeq for `\u2203 x : matrix (fin m) (fin n) \u03b1, P x`.", "p": "mathlib"}, {"name": "matrix.dot_product\u1d63_eq", "description": " This can be used to prove\n```lean\nexample (a b c d : \u03b1) [has_mul \u03b1] [add_comm_monoid \u03b1] :\n  dot_product ![a, b] ![c, d] = a * c + b * d :=\n(dot_product\u1d63_eq _ _).symm\n```", "p": "mathlib"}, {"name": "matrix.mul\u1d63_eq", "description": " This can be used to prove\n```lean\nexample [add_comm_monoid \u03b1] [has_mul \u03b1] (a\u2081\u2081 a\u2081\u2082 a\u2082\u2081 a\u2082\u2082 b\u2081\u2081 b\u2081\u2082 b\u2082\u2081 b\u2082\u2082 : \u03b1) :\n  !![a\u2081\u2081, a\u2081\u2082;\n     a\u2082\u2081, a\u2082\u2082] \u2b1d !![b\u2081\u2081, b\u2081\u2082;\n                    b\u2082\u2081, b\u2082\u2082] =\n  !![a\u2081\u2081*b\u2081\u2081 + a\u2081\u2082*b\u2082\u2081, a\u2081\u2081*b\u2081\u2082 + a\u2081\u2082*b\u2082\u2082;\n     a\u2082\u2081*b\u2081\u2081 + a\u2082\u2082*b\u2082\u2081, a\u2082\u2081*b\u2081\u2082 + a\u2082\u2082*b\u2082\u2082] :=\n(mul\u1d63_eq _ _).symm\n```", "p": "mathlib"}, {"name": "matrix.dot_product\u1d63", "description": "`matrix.dot_product` with better defeq for `fin`", "p": "mathlib"}, {"name": "matrix.forall", "description": "`\u2200` with better defeq for `\u2200 x : matrix (fin m) (fin n) \u03b1, P x`.", "p": "mathlib"}, {"name": "matrix.transpose\u1d63_eq", "description": " This can be used to prove\n```lean\nexample (a b c d : \u03b1) : transpose !![a, b; c, d] = !![a, c; b, d] := (transpose\u1d63_eq _).symm\n```", "p": "mathlib"}, {"name": "matrix.eta_expand", "description": "Expand `A` to `!![A 0 0, ...; ..., A m n]`", "p": "mathlib"}, {"name": "matrix.mul_vec\u1d63", "description": "`matrix.mul_vec` with better defeq for `fin`", "p": "mathlib"}, {"name": "matrix.eta_expand_eq", "description": " This can be used to prove\n```lean\nexample (A : matrix (fin 2) (fin 2) \u03b1) :\n  A = !![A 0 0, A 0 1;\n         A 1 0, A 1 1] :=\n(eta_expand_eq _).symm\n```", "p": "mathlib"}, {"name": "matrix.forall_iff", "description": "This can be use to prove\n```lean\nexample (P : matrix (fin 2) (fin 3) \u03b1 \u2192 Prop) :\n  (\u2200 x, P x) \u2194 \u2200 a b c d e f, P !![a, b, c; d, e, f] :=\n(forall_iff _).symm\n```", "p": "mathlib"}, {"name": "matrix.exists_iff", "description": "This can be use to prove\n```lean\nexample (P : matrix (fin 2) (fin 3) \u03b1 \u2192 Prop) :\n  (\u2203 x, P x) \u2194 \u2203 a b c d e f, P !![a, b, c; d, e, f] :=\n(exists_iff _).symm\n```", "p": "mathlib"}, {"name": "matrix.vec_mul\u1d63_eq", "description": " This can be used to prove\n```lean\nexample [non_unital_non_assoc_semiring \u03b1] (a\u2081\u2081 a\u2081\u2082 a\u2082\u2081 a\u2082\u2082 b\u2081 b\u2082 : \u03b1) :\n  vec_mul ![b\u2081, b\u2082] !![a\u2081\u2081, a\u2081\u2082;\n                       a\u2082\u2081, a\u2082\u2082] = ![b\u2081*a\u2081\u2081 + b\u2082*a\u2082\u2081, b\u2081*a\u2081\u2082 + b\u2082*a\u2082\u2082] :=\n(vec_mul\u1d63_eq _ _).symm\n```", "p": "mathlib"}, {"name": "matrix.vec_mul\u1d63", "description": "`matrix.vec_mul` with better defeq for `fin`", "p": "mathlib"}, {"name": "finsupp.zip_with_ne_locus_eq_left", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_zero_right", "description": "", "p": "mathlib"}, {"name": "finsupp.mem_ne_locus", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus", "description": "  Given two finitely supported functions `f g : \u03b1 \u2192\u2080 N`, `finsupp.ne_locus f g` is the `finset`\nwhere `f` and `g` differ. This generalizes `(f - g).support` to situations without subtraction.", "p": "mathlib"}, {"name": "finsupp.ne_locus_self_sub_left", "description": "", "p": "mathlib"}, {"name": "finsupp.subset_map_range_ne_locus", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_neg_neg", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_self_sub_right", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_sub_left", "description": "", "p": "mathlib"}, {"name": "finsupp.coe_ne_locus", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_eq_support_sub", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_add_right", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_eq_empty", "description": "", "p": "mathlib"}, {"name": "finsupp.nonempty_ne_locus_iff", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_sub_right", "description": "", "p": "mathlib"}, {"name": "finsupp.not_mem_ne_locus", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_add_left", "description": "", "p": "mathlib"}, {"name": "finsupp.zip_with_ne_locus_eq_right", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_comm", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_self_add_left", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_ne_locus_eq", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_zero_left", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_neg", "description": "", "p": "mathlib"}, {"name": "finsupp.ne_locus_self_add_right", "description": "", "p": "mathlib"}, {"name": "add_units.coe_map_neg", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_self", "description": "", "p": "mathlib"}, {"name": "group.is_unit", "description": "", "p": "mathlib"}, {"name": "is_unit.eq_inv_mul_iff_mul_eq", "description": "", "p": "mathlib"}, {"name": "add_units.lift_right_neg_add", "description": "", "p": "mathlib"}, {"name": "is_unit.div_left_inj", "description": "", "p": "mathlib"}, {"name": "add_group.is_add_unit", "description": "", "p": "mathlib"}, {"name": "is_add_unit.neg_add_eq_zero", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_div_mul_right", "description": "", "p": "mathlib"}, {"name": "is_unit.div_eq_of_eq_mul", "description": "", "p": "mathlib"}, {"name": "is_unit.inv", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_inv_eq_iff_eq_mul", "description": "", "p": "mathlib"}, {"name": "is_unit.div_div_cancel", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_div_cancel_left", "description": "", "p": "mathlib"}, {"name": "is_add_unit.neg_add_cancel_left", "description": "", "p": "mathlib"}, {"name": "is_unit.one_div_mul_cancel", "description": "", "p": "mathlib"}, {"name": "units.lift_right", "description": " If a map `g : M \u2192 N\u02e3` agrees with a homomorphism `f : M \u2192* N`, then\nthis map is a monoid homomorphism too.", "p": "mathlib"}, {"name": "is_add_unit.neg_add_eq_iff_eq_add", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_div_cancel", "description": "", "p": "mathlib"}, {"name": "units.coe_map", "description": "", "p": "mathlib"}, {"name": "is_unit.div_eq_one_iff_eq", "description": "", "p": "mathlib"}, {"name": "eq_on_neg", "description": "If two homomorphism from an additive group to an additive monoid are equal at `x`,\nthen they are equal at `-x`.", "p": "mathlib"}, {"name": "add_monoid_hom.to_hom_add_units", "description": "If `f` is a homomorphism from an additive group `G` to an additive monoid `M`,\nthen its image lies in the `add_units` of `M`,\nand `f.to_hom_units` is the corresponding homomorphism from `G` to `add_units M`.", "p": "mathlib"}, {"name": "is_unit.div_mul_cancel", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub", "description": "", "p": "mathlib"}, {"name": "is_add_unit.zero_sub_add_cancel", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_lift_right_inv", "description": "", "p": "mathlib"}, {"name": "is_unit.coe_inv_unit'", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_one_div_cancel", "description": "", "p": "mathlib"}, {"name": "is_unit.lift_right_inv_mul", "description": "", "p": "mathlib"}, {"name": "units.map_id", "description": "", "p": "mathlib"}, {"name": "is_add_unit.lift_right_neg_add", "description": "", "p": "mathlib"}, {"name": "units.lift_right_inv_mul", "description": "", "p": "mathlib"}, {"name": "units.coe_hom_apply", "description": "", "p": "mathlib"}, {"name": "is_unit.div", "description": "", "p": "mathlib"}, {"name": "is_unit.lift_right", "description": " If a homomorphism `f : M \u2192* N` sends each element to an `is_unit`, then it can be lifted\nto `f : M \u2192* N\u02e3`. See also `units.lift_right` for a computable version.", "p": "mathlib"}, {"name": "is_add_unit.lift_right", "description": "If a homomorphism `f : M \u2192+ N` sends each element to an `is_add_unit`, then it can be\nlifted to `f : M \u2192+ add_units N`. See also `add_units.lift_right` for a computable version.", "p": "mathlib"}, {"name": "is_add_unit.eq_sub_iff", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_add_cancel", "description": "", "p": "mathlib"}, {"name": "is_unit_map_of_left_inverse", "description": "", "p": "mathlib"}, {"name": "is_unit.inv_mul_eq_iff_eq_mul", "description": "", "p": "mathlib"}, {"name": "add_units.coe_hom_apply", "description": "", "p": "mathlib"}, {"name": "is_unit.div_eq_div_iff", "description": "", "p": "mathlib"}, {"name": "is_unit.eq_mul_inv_iff_mul_eq", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_eq_zero_iff_eq_neg", "description": "", "p": "mathlib"}, {"name": "add_units.map_id", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_sub_cancel_left", "description": "", "p": "mathlib"}, {"name": "is_add_unit_map_of_left_inverse", "description": "", "p": "mathlib"}, {"name": "eq_on_inv", "description": "If two homomorphism from a group to a monoid are equal at `x`, then they are equal at `x\u207b\u00b9`.", "p": "mathlib"}, {"name": "divp_eq_div", "description": "", "p": "mathlib"}, {"name": "units.coe_zpow", "description": "", "p": "mathlib"}, {"name": "map_add_units_neg", "description": "", "p": "mathlib"}, {"name": "add_units.coe_lift_right", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_eq_zero_iff_eq", "description": "", "p": "mathlib"}, {"name": "add_units.coe_sub", "description": "", "p": "mathlib"}, {"name": "is_unit.div_mul_left", "description": "The `group` version of this lemma is `div_mul_cancel'''`", "p": "mathlib"}, {"name": "is_unit.div_div_cancel_left", "description": "", "p": "mathlib"}, {"name": "is_unit.coe_lift_right", "description": "", "p": "mathlib"}, {"name": "add_units.add_lift_right_neg", "description": "", "p": "mathlib"}, {"name": "add_units.coe_zsmul", "description": "", "p": "mathlib"}, {"name": "is_add_unit.neg", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_neg_eq_iff_eq_add", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_sub_add_right", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_neg_cancel_left", "description": "", "p": "mathlib"}, {"name": "units.coe_hom", "description": "Coercion `M\u02e3 \u2192 M` as a monoid homomorphism.", "p": "mathlib"}, {"name": "units.map", "description": "The group homomorphism on units induced by a `monoid_hom`.", "p": "mathlib"}, {"name": "is_unit.eq_on_inv", "description": " If two homomorphisms from a division monoid to a monoid are equal at a unit `x`, then they are\nequal at `x\u207b\u00b9`.", "p": "mathlib"}, {"name": "is_add_unit.add_sub_cancel", "description": "", "p": "mathlib"}, {"name": "is_unit.eq_div_of_mul_eq", "description": "", "p": "mathlib"}, {"name": "is_unit.coe_unit'", "description": "", "p": "mathlib"}, {"name": "units.coe_map_inv", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_eq_add_of_sub_eq_sub", "description": "", "p": "mathlib"}, {"name": "map_units_inv", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_sub_cancel'", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_eq_one_iff_eq_inv", "description": "", "p": "mathlib"}, {"name": "is_add_unit.eq_neg_add_iff_add_eq", "description": "", "p": "mathlib"}, {"name": "is_unit.eq_div_iff", "description": "", "p": "mathlib"}, {"name": "add_units.coe_map", "description": "", "p": "mathlib"}, {"name": "is_unit.inv_mul_cancel_right", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_inv_eq_one", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_inv_cancel_right", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_div_mul_left", "description": "", "p": "mathlib"}, {"name": "is_unit.map", "description": "", "p": "mathlib"}, {"name": "is_add_unit.coe_neg_add_unit'", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_add_sub", "description": "", "p": "mathlib"}, {"name": "is_add_unit.neg_add_cancel_right", "description": "", "p": "mathlib"}, {"name": "is_add_unit.coe_lift_right", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_eq_iff", "description": "", "p": "mathlib"}, {"name": "is_add_unit.eq_on_neg", "description": "If two homomorphisms from a subtraction monoid to an additive monoid are equal at an\nadditive unit `x`, then they are equal at `-x`.", "p": "mathlib"}, {"name": "add_monoid_hom.coe_to_hom_add_units", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_neg_cancel_right", "description": "", "p": "mathlib"}, {"name": "monoid_hom.coe_to_hom_units", "description": "", "p": "mathlib"}, {"name": "is_add_unit.eq_sub_of_add_eq", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_sub_cancel_left", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_unit'", "description": "The element of the additive group of additive units, corresponding to an element of\nan additive monoid which is an additive unit. As opposed to `is_add_unit.add_unit`, the negation is\ncomputable and comes from the negation on `\u03b1`. This is useful to transfer properties of negation in\n`add_units \u03b1` to `\u03b1`. See also `to_add_units`.", "p": "mathlib"}, {"name": "add_units.map_comp", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_add_left", "description": "The `add_group` version of this lemma is `sub_add_cancel''`", "p": "mathlib"}, {"name": "is_unit.div_eq_iff", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_neg_eq_zero", "description": "", "p": "mathlib"}, {"name": "units.mul_lift_right_inv", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_eq_sub_iff", "description": "", "p": "mathlib"}, {"name": "add_units.coe_nsmul", "description": "", "p": "mathlib"}, {"name": "units.map_comp", "description": "", "p": "mathlib"}, {"name": "units.coe_div", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_inv_cancel_left", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_lift_right_neg", "description": "", "p": "mathlib"}, {"name": "monoid_hom.to_hom_units", "description": " If `f` is a homomorphism from a group `G` to a monoid `M`,\nthen its image lies in the units of `M`,\nand `f.to_hom_units` is the corresponding monoid homomorphism from `G` to `M\u02e3`.", "p": "mathlib"}, {"name": "units.coe_lift_right", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_left_inj", "description": "", "p": "mathlib"}, {"name": "add_units.lift_right", "description": "If a map `g : M \u2192 add_units N` agrees with a homomorphism `f : M \u2192+ N`, then this map\nis an add_monoid homomorphism too.", "p": "mathlib"}, {"name": "is_unit.mul_div_cancel'", "description": "", "p": "mathlib"}, {"name": "is_unit.inv_mul_cancel_left", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_zero_sub_cancel", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_eq_one_iff_inv_eq", "description": "", "p": "mathlib"}, {"name": "is_add_unit.map", "description": "", "p": "mathlib"}, {"name": "add_units.map", "description": "The `add_group` homomorphism on `add_unit`s induced by an `add_monoid_hom`.", "p": "mathlib"}, {"name": "is_unit.div_mul_right", "description": "", "p": "mathlib"}, {"name": "is_unit.div_self", "description": "", "p": "mathlib"}, {"name": "is_unit.unit'", "description": " The element of the group of units, corresponding to an element of a monoid which is a unit. As\nopposed to `is_unit.unit`, the inverse is computable and comes from the inversion on `\u03b1`. This is\nuseful to transfer properties of inversion in `units \u03b1` to `\u03b1`. See also `to_units`.", "p": "mathlib"}, {"name": "is_add_unit.add_sub_add_left", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_add_right", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_eq_mul_of_div_eq_div", "description": "", "p": "mathlib"}, {"name": "is_add_unit.of_left_inverse", "description": "", "p": "mathlib"}, {"name": "units.coe_pow", "description": "", "p": "mathlib"}, {"name": "is_add_unit.coe_add_unit'", "description": "", "p": "mathlib"}, {"name": "is_add_unit.eq_add_neg_iff_add_eq", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_sub_cancel", "description": "", "p": "mathlib"}, {"name": "is_add_unit.sub_eq_of_eq_add", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_eq_zero_iff_neg_eq", "description": "", "p": "mathlib"}, {"name": "is_unit.inv_mul_eq_one", "description": "", "p": "mathlib"}, {"name": "is_unit.of_left_inverse", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_mul_div", "description": "", "p": "mathlib"}, {"name": "add_units.coe_hom", "description": "Coercion `add_units M \u2192 M` as an add_monoid homomorphism.", "p": "mathlib"}, {"name": "summable_mul_prod_iff_summable_mul_sigma_antidiagonal", "description": "", "p": "mathlib"}, {"name": "has_sum.div_const", "description": "", "p": "mathlib"}, {"name": "summable.mul_right", "description": "", "p": "mathlib"}, {"name": "summable.div_const", "description": "", "p": "mathlib"}, {"name": "summable.mul_left", "description": "", "p": "mathlib"}, {"name": "summable.tsum_mul_left", "description": "", "p": "mathlib"}, {"name": "summable_mul_right_iff", "description": "", "p": "mathlib"}, {"name": "tsum_mul_left", "description": "", "p": "mathlib"}, {"name": "commute.tsum_right", "description": "", "p": "mathlib"}, {"name": "tsum_div_const", "description": "", "p": "mathlib"}, {"name": "tsum_mul_tsum_eq_tsum_sum_range", "description": " The **Cauchy product formula** for the product of two infinites sums indexed by `\u2115`, expressed\nby summing on `finset.range`.\n\nSee also `tsum_mul_tsum_eq_tsum_sum_range_of_summable_norm` if `f` and `g` are absolutely summable.", "p": "mathlib"}, {"name": "commute.tsum_left", "description": "", "p": "mathlib"}, {"name": "summable.tsum_mul_right", "description": "", "p": "mathlib"}, {"name": "has_sum.mul_right", "description": "", "p": "mathlib"}, {"name": "summable_sum_mul_antidiagonal_of_summable_mul", "description": "", "p": "mathlib"}, {"name": "summable_sum_mul_range_of_summable_mul", "description": "", "p": "mathlib"}, {"name": "has_sum_mul_left_iff", "description": "", "p": "mathlib"}, {"name": "tsum_mul_tsum_eq_tsum_sum_antidiagonal", "description": " The **Cauchy product formula** for the product of two infinites sums indexed by `\u2115`, expressed\nby summing on `finset.nat.antidiagonal`.\n\nSee also `tsum_mul_tsum_eq_tsum_sum_antidiagonal_of_summable_norm` if `f` and `g` are absolutely\nsummable.", "p": "mathlib"}, {"name": "tsum_mul_right", "description": "", "p": "mathlib"}, {"name": "has_sum_div_const_iff", "description": "", "p": "mathlib"}, {"name": "has_sum_mul_right_iff", "description": "", "p": "mathlib"}, {"name": "summable_div_const_iff", "description": "", "p": "mathlib"}, {"name": "has_sum.mul", "description": "", "p": "mathlib"}, {"name": "tsum_mul_tsum", "description": "Product of two infinites sums indexed by arbitrary types.\n   See also `tsum_mul_tsum_of_summable_norm` if `f` and `g` are abolutely summable.", "p": "mathlib"}, {"name": "has_sum.mul_eq", "description": "", "p": "mathlib"}, {"name": "summable_mul_left_iff", "description": "", "p": "mathlib"}, {"name": "has_sum.mul_left", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.uniform_continuous_map", "description": "", "p": "mathlib"}, {"name": "eq_of_uniformity_basis", "description": "", "p": "mathlib"}, {"name": "is_closed_range_of_spaced_out", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.lift", "description": "Factoring functions to a separated space through the separation quotient.", "p": "mathlib"}, {"name": "separation_rel_iff_inseparable", "description": "", "p": "mathlib"}, {"name": "uniform_space.separated.prod", "description": "", "p": "mathlib"}, {"name": "separation_rel_comap", "description": "", "p": "mathlib"}, {"name": "separated_def'", "description": "", "p": "mathlib"}, {"name": "separation_rel_eq_inter_closure", "description": "", "p": "mathlib"}, {"name": "id_rel_sub_separation_relation", "description": "", "p": "mathlib"}, {"name": "uniform_space.eq_of_separated_of_uniform_continuous", "description": "", "p": "mathlib"}, {"name": "eq_of_uniformity", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.separated_space", "description": "", "p": "mathlib"}, {"name": "uniform_space.comap_quotient_eq_uniformity", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.mk_eq_mk", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.inhabited", "description": "", "p": "mathlib"}, {"name": "uniform_space.separated_separation", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_setoid", "description": "The separation relation of a uniform space seen as a setoid.", "p": "mathlib"}, {"name": "uniform_space.separation_setoid.uniform_space", "description": "", "p": "mathlib"}, {"name": "separated_space", "description": " A uniform space is separated if its separation relation is trivial (each point\nis related only to itself).", "p": "mathlib"}, {"name": "separated_space.out", "description": " A uniform space is separated if its separation relation is trivial (each point\nis related only to itself).", "p": "mathlib"}, {"name": "filter.has_basis.mem_separation_rel", "description": "", "p": "mathlib"}, {"name": "uniform_space.uniform_continuous_quotient_lift", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.map_mk", "description": "", "p": "mathlib"}, {"name": "subtype.separated_space", "description": "", "p": "mathlib"}, {"name": "separation_rel_iff_specializes", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_prod", "description": "", "p": "mathlib"}, {"name": "separated_def", "description": "", "p": "mathlib"}, {"name": "uniform_space.comap_quotient_le_uniformity", "description": "", "p": "mathlib"}, {"name": "separation_rel", "description": "The separation relation is the intersection of all entourages.\n Two points which are related by the separation relation are \"indistinguishable\"\n according to the uniform structure.", "p": "mathlib"}, {"name": "is_closed_of_spaced_out", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.uniform_continuous_lift", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.map_unique", "description": "", "p": "mathlib"}, {"name": "uniform_space.uniform_continuous_quotient", "description": "", "p": "mathlib"}, {"name": "separated_equiv", "description": "", "p": "mathlib"}, {"name": "is_closed_separation_rel", "description": "", "p": "mathlib"}, {"name": "eq_of_forall_symmetric", "description": "", "p": "mathlib"}, {"name": "uniform_space.uniform_continuous_quotient_mk", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient", "description": "The maximal separated quotient of a uniform space `\u03b1`.", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.uniform_space", "description": "", "p": "mathlib"}, {"name": "separated_space_iff", "description": "", "p": "mathlib"}, {"name": "uniform_space.separated_of_uniform_continuous", "description": "", "p": "mathlib"}, {"name": "uniform_space.to_regular_space", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.map_comp", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.map", "description": "The separation quotient functor acting on functions.", "p": "mathlib"}, {"name": "eq_of_cluster_pt_uniformity", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.lift_mk", "description": "", "p": "mathlib"}, {"name": "separated_t3", "description": "", "p": "mathlib"}, {"name": "uniform_space.separation_quotient.map_id", "description": "", "p": "mathlib"}, {"name": "separated_iff_t2", "description": "", "p": "mathlib"}, {"name": "uniform_space.uniform_continuous_quotient_lift\u2082", "description": "", "p": "mathlib"}, {"name": "uniform_space.uniformity_quotient", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.separation_rel", "description": "", "p": "mathlib"}, {"name": "sigma.smul_def", "description": "", "p": "mathlib"}, {"name": "sigma.is_central_vadd", "description": "", "p": "mathlib"}, {"name": "sigma.has_smul", "description": "", "p": "mathlib"}, {"name": "sigma.smul_comm_class", "description": "", "p": "mathlib"}, {"name": "sigma.is_central_scalar", "description": "", "p": "mathlib"}, {"name": "sigma.has_faithful_smul", "description": "", "p": "mathlib"}, {"name": "sigma.vadd_assoc_class", "description": "", "p": "mathlib"}, {"name": "sigma.vadd_mk", "description": "", "p": "mathlib"}, {"name": "sigma.has_vadd", "description": "", "p": "mathlib"}, {"name": "sigma.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "sigma.add_action", "description": "", "p": "mathlib"}, {"name": "sigma.has_faithful_vadd", "description": "", "p": "mathlib"}, {"name": "sigma.has_faithful_vadd'", "description": "This is not an instance because `i` becomes a metavariable.", "p": "mathlib"}, {"name": "sigma.mul_action", "description": "", "p": "mathlib"}, {"name": "sigma.vadd_def", "description": "", "p": "mathlib"}, {"name": "sigma.vadd_comm_class", "description": "", "p": "mathlib"}, {"name": "sigma.has_faithful_smul'", "description": "This is not an instance because `i` becomes a metavariable.", "p": "mathlib"}, {"name": "sigma.smul_mk", "description": "", "p": "mathlib"}, {"name": "matrix.rank_mul_le_right", "description": "", "p": "mathlib"}, {"name": "matrix.rank_unit", "description": "", "p": "mathlib"}, {"name": "matrix.rank_eq_finrank_range_to_lin", "description": "", "p": "mathlib"}, {"name": "matrix.rank_transpose", "description": "TODO: prove this in greater generality.", "p": "mathlib"}, {"name": "matrix.ker_mul_vec_lin_transpose_mul_self", "description": "", "p": "mathlib"}, {"name": "matrix.rank_conj_transpose", "description": "TODO: prove this in greater generality.", "p": "mathlib"}, {"name": "matrix.rank_le_card_width", "description": "", "p": "mathlib"}, {"name": "matrix.rank_zero", "description": "", "p": "mathlib"}, {"name": "matrix.rank_self_mul_transpose", "description": "", "p": "mathlib"}, {"name": "matrix.rank_reindex", "description": "", "p": "mathlib"}, {"name": "matrix.rank_eq_finrank_span_cols", "description": "The rank of a matrix is the rank of the space spanned by its columns.", "p": "mathlib"}, {"name": "matrix.rank_one", "description": "", "p": "mathlib"}, {"name": "matrix.rank", "description": "The rank of a matrix is the rank of its image.", "p": "mathlib"}, {"name": "matrix.rank_eq_finrank_span_row", "description": " The rank of a matrix is the rank of the space spanned by its rows.\n\nTODO: prove this in a generality that works for `\u2102` too, not just `\u211a` and `\u211d`.", "p": "mathlib"}, {"name": "matrix.rank_submatrix_le", "description": "Taking a subset of the rows and permuting the columns reduces the rank.", "p": "mathlib"}, {"name": "matrix.rank_submatrix", "description": "", "p": "mathlib"}, {"name": "matrix.rank_le_card_height", "description": "", "p": "mathlib"}, {"name": "matrix.rank_transpose_mul_self", "description": "", "p": "mathlib"}, {"name": "matrix.rank_conj_transpose_mul_self", "description": "", "p": "mathlib"}, {"name": "matrix.rank_le_width", "description": "", "p": "mathlib"}, {"name": "matrix.rank_mul_le_left", "description": "", "p": "mathlib"}, {"name": "matrix.rank_self_mul_conj_transpose", "description": "", "p": "mathlib"}, {"name": "matrix.ker_mul_vec_lin_conj_transpose_mul_self", "description": "", "p": "mathlib"}, {"name": "matrix.rank_le_height", "description": "", "p": "mathlib"}, {"name": "matrix.rank_mul_le", "description": "", "p": "mathlib"}, {"name": "matrix.rank_of_is_unit", "description": "", "p": "mathlib"}, {"name": "doset.eq_of_not_disjoint", "description": "", "p": "mathlib"}, {"name": "doset", "description": "The double_coset as an element of `set \u03b1` corresponding to `s a t`", "p": "mathlib"}, {"name": "doset.quotient", "description": "Quotient of `G` by the double coset relation, i.e. `H \\ G / K`", "p": "mathlib"}, {"name": "doset.disjoint_out'", "description": "", "p": "mathlib"}, {"name": "doset.doset_eq_of_mem", "description": "", "p": "mathlib"}, {"name": "doset.out_eq'", "description": "", "p": "mathlib"}, {"name": "doset.bot_rel_eq_left_rel", "description": "", "p": "mathlib"}, {"name": "doset.mk_eq_of_doset_eq", "description": "", "p": "mathlib"}, {"name": "doset.setoid", "description": "The setoid defined by the double_coset relation", "p": "mathlib"}, {"name": "doset.mem_doset", "description": "", "p": "mathlib"}, {"name": "doset.doset_union_left_coset", "description": "", "p": "mathlib"}, {"name": "doset.doset_union_right_coset", "description": "", "p": "mathlib"}, {"name": "doset.quotient.inhabited", "description": "", "p": "mathlib"}, {"name": "doset.right_bot_eq_right_quot", "description": "", "p": "mathlib"}, {"name": "doset.mem_doset_of_not_disjoint", "description": "", "p": "mathlib"}, {"name": "doset.left_bot_eq_left_quot", "description": "", "p": "mathlib"}, {"name": "doset.mem_doset_self", "description": "", "p": "mathlib"}, {"name": "doset.rel_iff", "description": "", "p": "mathlib"}, {"name": "doset.quot_to_doset", "description": "Create a doset out of an element of `H \\ G / K`", "p": "mathlib"}, {"name": "doset.mk_out'_eq_mul", "description": "", "p": "mathlib"}, {"name": "doset.union_quot_to_doset", "description": "", "p": "mathlib"}, {"name": "doset.eq", "description": "", "p": "mathlib"}, {"name": "doset.mk", "description": "Map from `G` to `H \\ G / K`", "p": "mathlib"}, {"name": "doset.rel_bot_eq_right_group_rel", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm_add_transpose_self", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.smul", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.sub", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm_zero", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.transpose", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.map", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.add", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm_transpose_add_self", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.ext", "description": "A version of `matrix.ext` that unfolds the `matrix.transpose`.", "p": "mathlib"}, {"name": "matrix.is_symm.neg", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm", "description": "A matrix `A : matrix n n \u03b1` is \"symmetric\" if `A\u1d40 = A`.", "p": "mathlib"}, {"name": "matrix.is_symm_diagonal", "description": "The diagonal matrix `diagonal v` is symmetric.", "p": "mathlib"}, {"name": "matrix.is_symm.apply", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm_from_blocks_iff", "description": "This is the `iff` version of `matrix.is_symm.from_blocks`.", "p": "mathlib"}, {"name": "matrix.is_symm_mul_transpose_self", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.from_blocks", "description": "A block matrix `A.from_blocks B C D` is symmetric,\n   if `A` and `D` are symmetric and `B\u1d40 = C`.", "p": "mathlib"}, {"name": "matrix.is_symm.conj_transpose", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm_one", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.ext_iff", "description": "A version of `matrix.ext_iff` that unfolds the `matrix.transpose`.", "p": "mathlib"}, {"name": "matrix.is_symm_transpose_mul_self", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.submatrix", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.eq", "description": "", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_of_image_mem_nhds", "description": " If a function `f` with a densely ordered codomain is strictly monotone on a neighborhood of `a`\nand the image of this set under `f` is a neighborhood of `f a`, then `f` is continuous at `a`.", "p": "mathlib"}, {"name": "continuous_at_right_of_monotone_on_of_image_mem_nhds_within", "description": " If a function `f` with a densely ordered codomain is monotone on a right neighborhood of `a` and\nthe image of this neighborhood under `f` is a right neighborhood of `f a`, then `f` is continuous at\n`a` from the right.", "p": "mathlib"}, {"name": "monotone.continuous_of_surjective", "description": "A monotone surjective function with a densely ordered codomain is continuous.", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_of_exists_between", "description": " If a function `f` is strictly monotone on a neighborhood of `a` and the image of this\nneighborhood under `f` meets every interval `[b, f a)`, `b < f a`, and every interval\n`(f a, b]`, `b > f a`, then `f` is continuous at `a`.", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_right_of_image_mem_nhds_within", "description": " If a function `f` with a densely ordered codomain is strictly monotone on a right neighborhood\nof `a` and the image of this neighborhood under `f` is a right neighborhood of `f a`, then `f` is\ncontinuous at `a` from the right.", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_right_of_exists_between", "description": " If `f` is a function strictly monotone on a right neighborhood of `a` and the\nimage of this neighborhood under `f` meets every interval `(f a, b]`, `b > f a`, then `f` is\ncontinuous at `a` from the right.\n\nThe assumption `hfs : \u2200 b > f a, \u2203 c \u2208 s, f c \u2208 Ioc (f a) b` is required because otherwise the\nfunction `f : \u211d \u2192 \u211d` given by `f x = if x \u2264 0 then x else x + 1` would be a counter-example at\n`a = 0`.", "p": "mathlib"}, {"name": "order_iso.coe_to_homeomorph_symm", "description": "", "p": "mathlib"}, {"name": "order_iso.continuous", "description": "", "p": "mathlib"}, {"name": "continuous_at_left_of_monotone_on_of_exists_between", "description": " If `f` is a monotone function on a left neighborhood of `a` and the image of this neighborhood\nunder `f` meets every interval `(b, f a)`, `b < f a`, then `f` is continuous at `a` from the left.\n\nThe assumption `hfs : \u2200 b < f a, \u2203 c \u2208 s, f c \u2208 Ioo b (f a)` cannot be replaced by the weaker\nassumption `hfs : \u2200 b < f a, \u2203 c \u2208 s, f c \u2208 Ico b (f a)` we use for strictly monotone functions\nbecause otherwise the function `floor : \u211d \u2192 \u2124` would be a counter-example at `a = 0`.", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_left_of_surj_on", "description": " If a function `f` is strictly monotone on a left neighborhood of `a` and the image of this\nneighborhood under `f` includes `Iio (f a)`, then `f` is continuous at `a` from the left.", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_left_of_exists_between", "description": " If `f` is a strictly monotone function on a left neighborhood of `a` and the image of this\nneighborhood under `f` meets every interval `[b, f a)`, `b < f a`, then `f` is continuous at `a`\nfrom the left.\n\nThe assumption `hfs : \u2200 b < f a, \u2203 c \u2208 s, f c \u2208 Ico b (f a)` is required because otherwise the\nfunction `f : \u211d \u2192 \u211d` given by `f x = if x < 0 then x else x + 1` would be a counter-example at\n`a = 0`.", "p": "mathlib"}, {"name": "continuous_at_of_monotone_on_of_image_mem_nhds", "description": " If a function `f` with a densely ordered codomain is monotone on a neighborhood of `a` and the\nimage of this neighborhood under `f` is a neighborhood of `f a`, then `f` is continuous at `a`.", "p": "mathlib"}, {"name": "continuous_at_right_of_monotone_on_of_closure_image_mem_nhds_within", "description": " If a function `f` with a densely ordered codomain is monotone on a right neighborhood of `a` and\nthe closure of the image of this neighborhood under `f` is a right neighborhood of `f a`, then `f`\nis continuous at `a` from the right.", "p": "mathlib"}, {"name": "continuous_at_left_of_monotone_on_of_closure_image_mem_nhds_within", "description": " If a function `f` with a densely ordered codomain is monotone on a left neighborhood of `a` and\nthe closure of the image of this neighborhood under `f` is a left neighborhood of `f a`, then `f` is\ncontinuous at `a` from the left", "p": "mathlib"}, {"name": "continuous_at_of_monotone_on_of_exists_between", "description": " If `f` is a monotone function on a neighborhood of `a` and the image of this neighborhood under\n`f` meets every interval `(b, f a)`, `b < f a`, and every interval `(f a, b)`, `b > f a`, then `f`\nis continuous at `a`.", "p": "mathlib"}, {"name": "continuous_at_left_of_monotone_on_of_image_mem_nhds_within", "description": " If a function `f` with a densely ordered codomain is monotone on a left neighborhood of `a` and\nthe image of this neighborhood under `f` is a left neighborhood of `f a`, then `f` is continuous at\n`a` from the left.", "p": "mathlib"}, {"name": "continuous_at_of_monotone_on_of_closure_image_mem_nhds", "description": " If a function `f` with a densely ordered codomain is monotone on a neighborhood of `a` and the\nclosure of the image of this neighborhood under `f` is a neighborhood of `f a`, then `f` is\ncontinuous at `a`.", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_left_of_closure_image_mem_nhds_within", "description": " If a function `f` with a densely ordered codomain is strictly monotone on a left neighborhood of\n`a` and the closure of the image of this neighborhood under `f` is a left neighborhood of `f a`,\nthen `f` is continuous at `a` from the left.", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_right_of_closure_image_mem_nhds_within", "description": " If a function `f` with a densely ordered codomain is strictly monotone on a right neighborhood\nof `a` and the closure of the image of this neighborhood under `f` is a right neighborhood of `f a`,\nthen `f` is continuous at `a` from the right.", "p": "mathlib"}, {"name": "monotone.continuous_of_dense_range", "description": "A monotone function with densely ordered codomain and a dense range is continuous.", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_right_of_surj_on", "description": " If a function `f` is strictly monotone on a right neighborhood of `a` and the image of this\nneighborhood under `f` includes `Ioi (f a)`, then `f` is continuous at `a` from the right.", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_of_closure_image_mem_nhds", "description": " If a function `f` with a densely ordered codomain is strictly monotone on a neighborhood of `a`\nand the closure of the image of this neighborhood under `f` is a neighborhood of `f a`, then `f` is\ncontinuous at `a`.", "p": "mathlib"}, {"name": "continuous_at_right_of_monotone_on_of_exists_between", "description": " If `f` is a monotone function on a right neighborhood of `a` and the image of this neighborhood\nunder `f` meets every interval `(f a, b)`, `b > f a`, then `f` is continuous at `a` from the right.\n\nThe assumption `hfs : \u2200 b > f a, \u2203 c \u2208 s, f c \u2208 Ioo (f a) b` cannot be replaced by the weaker\nassumption `hfs : \u2200 b > f a, \u2203 c \u2208 s, f c \u2208 Ioc (f a) b` we use for strictly monotone functions\nbecause otherwise the function `ceil : \u211d \u2192 \u2124` would be a counter-example at `a = 0`.", "p": "mathlib"}, {"name": "order_iso.to_homeomorph", "description": "An order isomorphism between two linear order `order_topology` spaces is a homeomorphism.", "p": "mathlib"}, {"name": "order_iso.coe_to_homeomorph", "description": "", "p": "mathlib"}, {"name": "strict_mono_on.continuous_at_left_of_image_mem_nhds_within", "description": " If a function `f` with a densely ordered codomain is strictly monotone on a left neighborhood of\n`a` and the image of this neighborhood under `f` is a left neighborhood of `f a`, then `f` is\ncontinuous at `a` from the left.", "p": "mathlib"}, {"name": "nonneg.canonically_linear_ordered_semifield", "description": "", "p": "mathlib"}, {"name": "nonneg.has_div", "description": "", "p": "mathlib"}, {"name": "nonneg.coe_zpow", "description": "", "p": "mathlib"}, {"name": "nonneg.linear_ordered_semifield", "description": "", "p": "mathlib"}, {"name": "nonneg.mk_zpow", "description": "", "p": "mathlib"}, {"name": "nonneg.mk_div_mk", "description": "", "p": "mathlib"}, {"name": "nonneg.linear_ordered_comm_group_with_zero", "description": "", "p": "mathlib"}, {"name": "nonneg.coe_inv", "description": "", "p": "mathlib"}, {"name": "nonneg.coe_div", "description": "", "p": "mathlib"}, {"name": "nonneg.has_zpow", "description": "", "p": "mathlib"}, {"name": "nonneg.has_inv", "description": "", "p": "mathlib"}, {"name": "nonneg.inv_mk", "description": "", "p": "mathlib"}, {"name": "lower_closure_interior_subset'", "description": "", "p": "mathlib"}, {"name": "bdd_below.bounded_inter", "description": "", "p": "mathlib"}, {"name": "is_lower_set.thickening'", "description": "", "p": "mathlib"}, {"name": "dist_anti_right", "description": "", "p": "mathlib"}, {"name": "closure_upper_closure_comm", "description": "", "p": "mathlib"}, {"name": "metric.bounded.bdd_above", "description": "", "p": "mathlib"}, {"name": "is_lower_set.cthickening", "description": "", "p": "mathlib"}, {"name": "is_upper_set.mem_interior_of_forall_lt", "description": "", "p": "mathlib"}, {"name": "dist_inf_sup", "description": "", "p": "mathlib"}, {"name": "is_closed.upper_closure", "description": "", "p": "mathlib"}, {"name": "lower_closure_interior_subset", "description": "", "p": "mathlib"}, {"name": "bounded_iff_bdd_below_bdd_above", "description": "", "p": "mathlib"}, {"name": "dist_le_dist_of_le", "description": "", "p": "mathlib"}, {"name": "is_clopen.upper_closure", "description": "", "p": "mathlib"}, {"name": "dist_anti_left", "description": "", "p": "mathlib"}, {"name": "is_upper_set.thickening'", "description": "", "p": "mathlib"}, {"name": "closure_lower_closure_comm", "description": "", "p": "mathlib"}, {"name": "is_closed.lower_closure", "description": "", "p": "mathlib"}, {"name": "bdd_above.bounded", "description": "", "p": "mathlib"}, {"name": "is_upper_set.cthickening", "description": "", "p": "mathlib"}, {"name": "is_lower_set.mem_interior_of_forall_lt", "description": "", "p": "mathlib"}, {"name": "is_lower_set.exists_subset_ball", "description": "", "p": "mathlib"}, {"name": "is_lower_set.cthickening'", "description": "", "p": "mathlib"}, {"name": "is_lower_set.thickening", "description": "", "p": "mathlib"}, {"name": "is_clopen.lower_closure", "description": "", "p": "mathlib"}, {"name": "is_upper_set.cthickening'", "description": "", "p": "mathlib"}, {"name": "is_antichain.interior_eq_empty", "description": "", "p": "mathlib"}, {"name": "is_upper_set.thickening", "description": "", "p": "mathlib"}, {"name": "is_upper_set.exists_subset_ball", "description": "", "p": "mathlib"}, {"name": "bdd_above.bounded_inter", "description": "", "p": "mathlib"}, {"name": "upper_closure_interior_subset", "description": "", "p": "mathlib"}, {"name": "metric.bounded.bdd_below", "description": "", "p": "mathlib"}, {"name": "dist_mono_right", "description": "", "p": "mathlib"}, {"name": "upper_closure_interior_subset'", "description": "", "p": "mathlib"}, {"name": "bdd_below.bounded", "description": "", "p": "mathlib"}, {"name": "dist_mono_left", "description": "", "p": "mathlib"}, {"name": "valuation.integer", "description": "The ring of integers under a given valuation is the subring of elements with valuation \u2264 1.", "p": "mathlib"}, {"name": "valuation.integers.le_iff_dvd", "description": "", "p": "mathlib"}, {"name": "valuation.integers.is_unit_of_one", "description": "", "p": "mathlib"}, {"name": "valuation.integers.one_of_is_unit", "description": "", "p": "mathlib"}, {"name": "valuation.integers.dvd_of_le", "description": "", "p": "mathlib"}, {"name": "valuation.integers", "description": " Given a valuation v : R \u2192 \u0393\u2080 and a ring homomorphism O \u2192+* R, we say that O is the integers of v\nif f is injective, and its range is exactly `v.integer`.", "p": "mathlib"}, {"name": "valuation.integers.hom_inj", "description": " Given a valuation v : R \u2192 \u0393\u2080 and a ring homomorphism O \u2192+* R, we say that O is the integers of v\nif f is injective, and its range is exactly `v.integer`.", "p": "mathlib"}, {"name": "valuation.integers.map_le_one", "description": " Given a valuation v : R \u2192 \u0393\u2080 and a ring homomorphism O \u2192+* R, we say that O is the integers of v\nif f is injective, and its range is exactly `v.integer`.", "p": "mathlib"}, {"name": "valuation.integers.exists_of_le_one", "description": " Given a valuation v : R \u2192 \u0393\u2080 and a ring homomorphism O \u2192+* R, we say that O is the integers of v\nif f is injective, and its range is exactly `v.integer`.", "p": "mathlib"}, {"name": "valuation.algebra", "description": "", "p": "mathlib"}, {"name": "valuation.integers.dvd_iff_le", "description": "", "p": "mathlib"}, {"name": "valuation.integer.integers", "description": "", "p": "mathlib"}, {"name": "valuation.integers.le_of_dvd", "description": "", "p": "mathlib"}, {"name": "euclidean_geometry.reflection_mem_of_le_of_mem", "description": " The reflection of a point in a subspace is contained in any larger\nsubspace containing both the point and the subspace reflected in.", "p": "mathlib"}, {"name": "euclidean_geometry.inner_vsub_vsub_of_dist_eq_of_dist_eq", "description": " Suppose that `c\u2081` is equidistant from `p\u2081` and `p\u2082`, and the same\napplies to `c\u2082`.  Then the vector between `c\u2081` and `c\u2082` is orthogonal\nto that between `p\u2081` and `p\u2082`.  (In two dimensions, this says that the\ndiagonals of a kite are orthogonal.)", "p": "mathlib"}, {"name": "euclidean_geometry.reflection_apply", "description": "The result of reflecting.", "p": "mathlib"}, {"name": "euclidean_geometry.vsub_orthogonal_projection_mem_direction", "description": " Subtracting the `orthogonal_projection` from a point in the given\nsubspace produces a result in the direction of the given subspace.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_smul_vadd_sq", "description": " The squared distance between points on a line (expressed as a\nmultiple of a fixed vector added to a point) and another point,\nexpressed as a quadratic.", "p": "mathlib"}, {"name": "euclidean_geometry.reflection_orthogonal_vadd", "description": " Reflecting an orthogonal vector plus a point in the subspace\nproduces the negation of that vector plus the point.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_mem_orthogonal", "description": "The `orthogonal_projection` lies in the orthogonal subspace.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_vadd_smul_vsub_orthogonal_projection", "description": " Adding a vector to a point in the given subspace, then taking the\northogonal projection, produces the original point if the vector is a\nmultiple of the result of subtracting a point's orthogonal projection\nfrom that point.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_sq_eq_dist_orthogonal_projection_sq_add_dist_orthogonal_projection_sq", "description": " The square of the distance from a point in `s` to `p2` equals the\nsum of the squares of the distances of the two points to the\n`orthogonal_projection`.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_orthogonal_projection", "description": "Orthogonal projection is idempotent.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_vsub_mem_direction_orthogonal", "description": " Subtracting `p` from its `orthogonal_projection` produces a result\nin the orthogonal direction.", "p": "mathlib"}, {"name": "euclidean_geometry.eq_orthogonal_projection_of_eq_subspace", "description": "", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_vadd_eq_self", "description": " Adding a vector to a point in the given subspace, then taking the\northogonal projection, produces the original point if the vector was\nin the orthogonal direction.", "p": "mathlib"}, {"name": "euclidean_geometry.vsub_orthogonal_projection_mem_direction_orthogonal", "description": " Subtracting the `orthogonal_projection` from `p` produces a result\nin the orthogonal direction.", "p": "mathlib"}, {"name": "euclidean_geometry.inter_eq_singleton_orthogonal_projection_fn", "description": " The intersection of the subspace and the orthogonal subspace\nthrough the given point is the `orthogonal_projection_fn` of that\npoint onto the subspace.  This lemma is only intended for use in\nsetting up the bundled version and should not be used once that is\ndefined.", "p": "mathlib"}, {"name": "euclidean_geometry.reflection_symm", "description": "Reflection is its own inverse.", "p": "mathlib"}, {"name": "euclidean_geometry.eq_of_dist_eq_of_dist_eq_of_finrank_eq_two", "description": " Distances `r\u2081` `r\u2082` of `p` from two different points `c\u2081` `c\u2082` determine at\nmost two points `p\u2081` `p\u2082` in two-dimensional space (two circles intersect in at\nmost two points).", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_eq_self_iff", "description": " A point equals its orthogonal projection if and only if it lies in\nthe subspace.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_vsub_orthogonal_projection", "description": " Subtracting the `orthogonal_projection` from `p` produces a result in the kernel of the linear\npart of the orthogonal projection.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_left_midpoint_eq_dist_right_midpoint", "description": "The midpoint of the segment AB is the same distance from A as it is from B.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_fn_vsub_mem_direction_orthogonal", "description": " Subtracting `p` from its `orthogonal_projection_fn` produces a\nresult in the orthogonal direction.  This lemma is only intended for\nuse in setting up the bundled version and should not be used once that\nis defined.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_orthogonal_projection_ne_zero_of_not_mem", "description": " The distance between a point and its orthogonal projection is\nnonzero if it does not lie in the subspace.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection", "description": " The orthogonal projection of a point onto a nonempty affine\nsubspace, whose direction is complete. The corresponding linear map\n(mapping a vector to the difference between the projections of two\npoints whose difference is that vector) is the `orthogonal_projection`\nfor real inner product spaces, onto the direction of the affine\nsubspace being projected onto.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_orthogonal_projection_eq_zero_iff", "description": "The distance to a point's orthogonal projection is 0 iff it lies in the subspace.", "p": "mathlib"}, {"name": "euclidean_geometry.inner_weighted_vsub", "description": " The inner product of two vectors given with `weighted_vsub`, in\nterms of the pairwise distances.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_reflection_eq_of_mem", "description": " A point in the subspace is equidistant from another point and its\nreflection.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_smul_vadd_eq_dist", "description": " The condition for two points on a line to be equidistant from\nanother point.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_fn_mem_orthogonal", "description": " The `orthogonal_projection_fn` lies in the orthogonal\nsubspace.  This lemma is only intended for use in setting up the\nbundled version and should not be used once that is defined.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_vsub_mem_direction", "description": " Subtracting a point in the given subspace from the\n`orthogonal_projection` produces a result in the direction of the\ngiven subspace.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_reflection", "description": " The distance between `p\u2081` and the reflection of `p\u2082` equals that\nbetween the reflection of `p\u2081` and `p\u2082`.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_mem_subspace_eq_self", "description": "", "p": "mathlib"}, {"name": "euclidean_geometry.inter_eq_singleton_orthogonal_projection", "description": " The intersection of the subspace and the orthogonal subspace\nthrough the given point is the `orthogonal_projection` of that point\nonto the subspace.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_fn", "description": " The orthogonal projection of a point onto a nonempty affine\nsubspace, whose direction is complete, as an unbundled function.  This\ndefinition is only intended for use in setting up the bundled version\n`orthogonal_projection` and should not be used once that is\ndefined.", "p": "mathlib"}, {"name": "euclidean_geometry.reflection_reflection", "description": "Reflecting twice in the same subspace.", "p": "mathlib"}, {"name": "euclidean_geometry.reflection_eq_iff_orthogonal_projection_eq", "description": " Reflecting a point in two subspaces produces the same result if\nand only if the point has the same orthogonal projection in each of\nthose subspaces.", "p": "mathlib"}, {"name": "euclidean_geometry.eq_of_dist_eq_of_dist_eq_of_mem_of_finrank_eq_two", "description": " Distances `r\u2081` `r\u2082` of `p` from two different points `c\u2081` `c\u2082` determine at\nmost two points `p\u2081` `p\u2082` in a two-dimensional subspace containing those points\n(two circles intersect in at most two points).", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_linear", "description": "The linear map corresponding to `orthogonal_projection`.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_fn_mem", "description": " The `orthogonal_projection_fn` lies in the given subspace.  This\nlemma is only intended for use in setting up the bundled version and\nshould not be used once that is defined.", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_mem", "description": "The `orthogonal_projection` lies in the given subspace.", "p": "mathlib"}, {"name": "euclidean_geometry.eq_reflection_of_eq_subspace", "description": "", "p": "mathlib"}, {"name": "euclidean_geometry.orthogonal_projection_fn_eq", "description": "", "p": "mathlib"}, {"name": "euclidean_geometry.reflection_eq_self_iff", "description": " A point is its own reflection if and only if it is in the\nsubspace.", "p": "mathlib"}, {"name": "euclidean_geometry.reflection", "description": " Reflection in an affine subspace, which is expected to be nonempty\nand complete.  The word \"reflection\" is sometimes understood to mean\nspecifically reflection in a codimension-one subspace, and sometimes\nmore generally to cover operations such as reflection in a point.  The\ndefinition here, of reflection in an affine subspace, is a more\ngeneral sense of the word that includes both those common cases.", "p": "mathlib"}, {"name": "euclidean_geometry.reflection_involutive", "description": "Reflection is involutive.", "p": "mathlib"}, {"name": "euclidean_geometry.reflection_vadd_smul_vsub_orthogonal_projection", "description": " Reflecting a vector plus a point in the subspace produces the\nnegation of that vector plus the point if the vector is a multiple of\nthe result of subtracting a point's orthogonal projection from that\npoint.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_affine_combination", "description": " The distance between two points given with `affine_combination`,\nin terms of the pairwise distances between the points in that\ncombination.", "p": "mathlib"}, {"name": "euclidean_geometry.dist_sq_smul_orthogonal_vadd_smul_orthogonal_vadd", "description": " The square of the distance between two points constructed by\nadding multiples of the same orthogonal vector to points in the same\nsubspace.", "p": "mathlib"}, {"name": "complex.cos_surjective", "description": "", "p": "mathlib"}, {"name": "complex.range_sin", "description": "", "p": "mathlib"}, {"name": "complex.continuous_on_tan", "description": "", "p": "mathlib"}, {"name": "complex.cos_eq_cos_iff", "description": "", "p": "mathlib"}, {"name": "complex.cos_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "complex.sin_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "real.le_sin_mul", "description": "", "p": "mathlib"}, {"name": "real.cos_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "complex.range_cos", "description": "", "p": "mathlib"}, {"name": "complex.tan_eq", "description": "", "p": "mathlib"}, {"name": "real.mul_lt_sin", "description": "", "p": "mathlib"}, {"name": "complex.cos_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "real.lt_sin_mul", "description": "", "p": "mathlib"}, {"name": "complex.tan_add'", "description": "", "p": "mathlib"}, {"name": "real.mul_le_sin", "description": " In the range `[0, \u03c0 / 2]`, we have a linear lower bound on `sin`. This inequality forms one half\nof Jordan's inequality, the other half is `real.sin_lt`", "p": "mathlib"}, {"name": "real.sin_eq_sin_iff", "description": "", "p": "mathlib"}, {"name": "complex.sin_eq_sin_iff", "description": "", "p": "mathlib"}, {"name": "complex.sin_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "complex.tan_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "complex.continuous_tan", "description": "", "p": "mathlib"}, {"name": "complex.tan_add_mul_I", "description": "", "p": "mathlib"}, {"name": "complex.tan_int_mul_pi_div_two", "description": "", "p": "mathlib"}, {"name": "complex.tan_add", "description": "", "p": "mathlib"}, {"name": "complex.sin_surjective", "description": "", "p": "mathlib"}, {"name": "complex.tan_two_mul", "description": "", "p": "mathlib"}, {"name": "real.cos_eq_cos_iff", "description": "", "p": "mathlib"}, {"name": "real.cos_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "complex.cos_eq_iff_quadratic", "description": "", "p": "mathlib"}, {"name": "complex.tan_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "euclidean_half_space", "description": "The half-space in `\u211d^n`, used to model manifolds with boundary. We only define it when\n`1 \u2264 n`, as the definition only makes sense in this case.", "p": "mathlib"}, {"name": "euclidean_half_space.inhabited", "description": "", "p": "mathlib"}, {"name": "euclidean_half_space.topological_space", "description": "", "p": "mathlib"}, {"name": "Icc_smooth_manifold", "description": "The manifold structure on `[x, y]` is smooth.", "p": "mathlib"}, {"name": "Icc_manifold", "description": "Charted space structure on `[x, y]`, using only two charts taking values in\n`euclidean_half_space 1`.", "p": "mathlib"}, {"name": "set.Icc.smooth_manifold_with_corners", "description": "", "p": "mathlib"}, {"name": "Icc_right_chart", "description": "The right chart for the topological space `[x, y]`, defined on `(x,y]` and sending `y` to `0` in\n`euclidean_half_space 1`.", "p": "mathlib"}, {"name": "set.Icc.charted_space", "description": "", "p": "mathlib"}, {"name": "euclidean_quadrant", "description": "The quadrant in `\u211d^n`, used to model manifolds with corners, made of all vectors with nonnegative\ncoordinates.", "p": "mathlib"}, {"name": "euclidean_quadrant.inhabited", "description": "", "p": "mathlib"}, {"name": "euclidean_quadrant.topological_space", "description": "", "p": "mathlib"}, {"name": "range_quadrant", "description": "", "p": "mathlib"}, {"name": "model_with_corners_euclidean_half_space", "description": "Definition of the model with corners `(euclidean_space \u211d (fin n), euclidean_half_space n)`, used as\na model for manifolds with boundary. In the locale `manifold`, use the shortcut `\ud835\udce1\u2202 n`.", "p": "mathlib"}, {"name": "model_with_corners_euclidean_quadrant", "description": "Definition of the model with corners `(euclidean_space \u211d (fin n), euclidean_quadrant n)`, used as a\nmodel for manifolds with corners", "p": "mathlib"}, {"name": "range_half_space", "description": "", "p": "mathlib"}, {"name": "Icc_left_chart", "description": "The left chart for the topological space `[x, y]`, defined on `[x,y)` and sending `x` to `0` in\n`euclidean_half_space 1`.", "p": "mathlib"}, {"name": "rat.ceil_cast", "description": "", "p": "mathlib"}, {"name": "rat.fract_inv_num_lt_num_of_pos", "description": "", "p": "mathlib"}, {"name": "rat.floor_cast", "description": "", "p": "mathlib"}, {"name": "rat.floor_def", "description": "", "p": "mathlib"}, {"name": "rat.num_lt_succ_floor_mul_denom", "description": "", "p": "mathlib"}, {"name": "nat.coprime_sub_mul_floor_rat_div_of_coprime", "description": "", "p": "mathlib"}, {"name": "rat.floor_ring", "description": "", "p": "mathlib"}, {"name": "rat.floor_int_div_nat_eq_div", "description": "", "p": "mathlib"}, {"name": "rat.le_floor", "description": "", "p": "mathlib"}, {"name": "rat.floor", "description": "`floor q` is the largest integer `z` such that `z \u2264 q`", "p": "mathlib"}, {"name": "int.mod_nat_eq_sub_mul_floor_rat_div", "description": "", "p": "mathlib"}, {"name": "rat.cast_fract", "description": "", "p": "mathlib"}, {"name": "rat.round_cast", "description": "", "p": "mathlib"}, {"name": "ordinal.CNF_fst_le_log", "description": "Every exponent in the Cantor normal form `CNF b o` is less or equal to `log b o`.", "p": "mathlib"}, {"name": "ordinal.one_CNF", "description": "", "p": "mathlib"}, {"name": "ordinal.CNF_snd_lt", "description": "Every coefficient in the Cantor normal form `CNF b o` is less than `b`.", "p": "mathlib"}, {"name": "ordinal.CNF_foldr", "description": "Evaluating the Cantor normal form of an ordinal returns the ordinal.", "p": "mathlib"}, {"name": "ordinal.zero_CNF", "description": "", "p": "mathlib"}, {"name": "ordinal.CNF_zero", "description": "", "p": "mathlib"}, {"name": "ordinal.CNF_sorted", "description": "The exponents of the Cantor normal form are decreasing.", "p": "mathlib"}, {"name": "ordinal.CNF_of_lt", "description": "", "p": "mathlib"}, {"name": "ordinal.CNF_lt_snd", "description": "Every coefficient in a Cantor normal form is positive.", "p": "mathlib"}, {"name": "ordinal.CNF_fst_le", "description": "Every exponent in the Cantor normal form `CNF b o` is less or equal to `o`.", "p": "mathlib"}, {"name": "ordinal.CNF_ne_zero", "description": "Recursive definition for the Cantor normal form.", "p": "mathlib"}, {"name": "ordinal.CNF_rec_zero", "description": "", "p": "mathlib"}, {"name": "ordinal.CNF_of_le_one", "description": "", "p": "mathlib"}, {"name": "ordinal.CNF", "description": " The Cantor normal form of an ordinal `o` is the list of coefficients and exponents in the\nbase-`b` expansion of `o`.\n\nWe special-case `CNF 0 o = CNF 1 o = [(0, o)]` for `o \u2260 0`.\n\n`CNF b (b ^ u\u2081 * v\u2081 + b ^ u\u2082 * v\u2082) = [(u\u2081, v\u2081), (u\u2082, v\u2082)]`", "p": "mathlib"}, {"name": "ordinal.CNF_rec_pos", "description": "", "p": "mathlib"}, {"name": "ordinal.CNF_rec", "description": "Inducts on the base `b` expansion of an ordinal.", "p": "mathlib"}, {"name": "valued.topological_ring", "description": "", "p": "mathlib"}, {"name": "valued.to_uniform_space_eq", "description": "", "p": "mathlib"}, {"name": "valued.mem_nhds", "description": "", "p": "mathlib"}, {"name": "valued.has_basis_nhds_zero", "description": "", "p": "mathlib"}, {"name": "valued.cauchy_iff", "description": "", "p": "mathlib"}, {"name": "valued", "description": " A valued ring is a ring that comes equipped with a distinguished valuation. The class `valued`\nis designed for the situation that there is a canonical valuation on the ring.\n\nTODO: show that there always exists an equivalent valuation taking values in a type belonging to\nthe same universe as the ring.\n\nSee Note [forgetful inheritance] for why we extend `uniform_space`, `uniform_add_group`.", "p": "mathlib"}, {"name": "valued.to_uniform_space", "description": " A valued ring is a ring that comes equipped with a distinguished valuation. The class `valued`\nis designed for the situation that there is a canonical valuation on the ring.\n\nTODO: show that there always exists an equivalent valuation taking values in a type belonging to\nthe same universe as the ring.\n\nSee Note [forgetful inheritance] for why we extend `uniform_space`, `uniform_add_group`.", "p": "mathlib"}, {"name": "valued.to_uniform_add_group", "description": " A valued ring is a ring that comes equipped with a distinguished valuation. The class `valued`\nis designed for the situation that there is a canonical valuation on the ring.\n\nTODO: show that there always exists an equivalent valuation taking values in a type belonging to\nthe same universe as the ring.\n\nSee Note [forgetful inheritance] for why we extend `uniform_space`, `uniform_add_group`.", "p": "mathlib"}, {"name": "valued.v", "description": " A valued ring is a ring that comes equipped with a distinguished valuation. The class `valued`\nis designed for the situation that there is a canonical valuation on the ring.\n\nTODO: show that there always exists an equivalent valuation taking values in a type belonging to\nthe same universe as the ring.\n\nSee Note [forgetful inheritance] for why we extend `uniform_space`, `uniform_add_group`.", "p": "mathlib"}, {"name": "valued.is_topological_valuation", "description": " A valued ring is a ring that comes equipped with a distinguished valuation. The class `valued`\nis designed for the situation that there is a canonical valuation on the ring.\n\nTODO: show that there always exists an equivalent valuation taking values in a type belonging to\nthe same universe as the ring.\n\nSee Note [forgetful inheritance] for why we extend `uniform_space`, `uniform_add_group`.", "p": "mathlib"}, {"name": "valued.mk'", "description": " Alternative `valued` constructor for use when there is no preferred `uniform_space`\nstructure.", "p": "mathlib"}, {"name": "valuation.subgroups_basis", "description": "The basis of open subgroups for the topology on a ring determined by a valuation.", "p": "mathlib"}, {"name": "valued.loc_const", "description": "", "p": "mathlib"}, {"name": "valued.has_basis_uniformity", "description": "", "p": "mathlib"}, {"name": "valued.mem_nhds_zero", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.init_ring", "description": "`init_ring` is an auxiliary tactic that discharges goals factoring `init` over ring operations.", "p": "mathlib"}, {"name": "witt_vector.coeff_select", "description": "", "p": "mathlib"}, {"name": "witt_vector.tail", "description": " `witt_vector.tail n x` is the Witt vector of which the first `n` coefficients are `0`\nand all other coefficients are those from `x`.\nSee `witt_vector.init` for the complementary part.", "p": "mathlib"}, {"name": "witt_vector.init_pow", "description": "", "p": "mathlib"}, {"name": "witt_vector.select_poly", "description": " The polynomial that witnesses that `witt_vector.select` is a polynomial function.\n`select_poly n` is `X n` if `P n` holds, and `0` otherwise.", "p": "mathlib"}, {"name": "witt_vector.init_is_poly", "description": "`witt_vector.init n x` is polynomial in the coefficients of `x`.", "p": "mathlib"}, {"name": "witt_vector.select_is_poly.comp_i", "description": "", "p": "mathlib"}, {"name": "witt_vector.init_init", "description": "", "p": "mathlib"}, {"name": "witt_vector.init", "description": " `witt_vector.init n x` is the Witt vector of which the first `n` coefficients are those from `x`\nand all other coefficients are `0`.\nSee `witt_vector.tail` for the complementary part.", "p": "mathlib"}, {"name": "witt_vector.init_zsmul", "description": "", "p": "mathlib"}, {"name": "witt_vector.select_is_poly.comp\u2082_i", "description": "", "p": "mathlib"}, {"name": "witt_vector.init_add", "description": "", "p": "mathlib"}, {"name": "witt_vector.select_is_poly", "description": "", "p": "mathlib"}, {"name": "witt_vector.coeff_add_of_disjoint", "description": "", "p": "mathlib"}, {"name": "witt_vector.init_mul", "description": "", "p": "mathlib"}, {"name": "witt_vector.select", "description": " `witt_vector.select P x`, for a predicate `P : \u2115 \u2192 Prop` is the Witt vector\nwhose `n`-th coefficient is `x.coeff n` if `P n` is true, and `0` otherwise.", "p": "mathlib"}, {"name": "witt_vector.init_sub", "description": "", "p": "mathlib"}, {"name": "witt_vector.init_add_tail", "description": "", "p": "mathlib"}, {"name": "witt_vector.init_neg", "description": "", "p": "mathlib"}, {"name": "witt_vector.select_add_select_not", "description": "", "p": "mathlib"}, {"name": "witt_vector.init_nsmul", "description": "", "p": "mathlib"}, {"name": "slim_check.format_failure", "description": "Format the counter-examples found in a test failure.", "p": "mathlib"}, {"name": "slim_check.testable.check'", "description": "Run a test suite for `p` in `io`.", "p": "mathlib"}, {"name": "slim_check.test_forall_in_list", "description": "testable instance for a property iterating over the element of a list", "p": "mathlib"}, {"name": "slim_check.combine_testable", "description": " Test proposition `p` by randomly selecting one of the provided\ntestable instances.", "p": "mathlib"}, {"name": "slim_check.retry", "description": " Execute `cmd` and repeat every time the result is `gave_up` (at most\n`n` times).", "p": "mathlib"}, {"name": "slim_check.unused_var_testable", "description": "", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.inhabited", "description": "", "p": "mathlib"}, {"name": "slim_check.minimize_aux", "description": " Shrink a counter-example `x` by using `shrink x`, picking the first\ncandidate that falsifies a property and recursively shrinking that one.\n\nThe process is guaranteed to terminate because `shrink x` produces\na proof that all the values it produces are smaller (according to `sizeof`)\nthan `x`.", "p": "mathlib"}, {"name": "slim_check.not.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.perm.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.testable.run_suite", "description": "Try to find a counter-example of `p`.", "p": "mathlib"}, {"name": "slim_check.convert_counter_example'", "description": "Test `q` by testing `p` and proving the equivalence between the two.", "p": "mathlib"}, {"name": "slim_check.prop_var_testable", "description": "Test a universal property about propositions", "p": "mathlib"}, {"name": "slim_check.use_has_to_string", "description": "Type tag that replaces a type's `has_repr` instance with its `has_to_string` instance.", "p": "mathlib"}, {"name": "slim_check.combine", "description": "applicative combinator proof carrying test results", "p": "mathlib"}, {"name": "slim_check.is_failure", "description": "Is the given test result a failure?", "p": "mathlib"}, {"name": "slim_check.and_counter_example", "description": "Combine the test result for properties `p` and `q` to create a test for their conjunction.", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg", "description": "configuration for testing a property", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.num_inst", "description": "configuration for testing a property", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.max_size", "description": "configuration for testing a property", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.trace_discarded", "description": "configuration for testing a property", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.trace_success", "description": "configuration for testing a property", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.trace_shrink", "description": "configuration for testing a property", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.trace_shrink_candidates", "description": "configuration for testing a property", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.random_seed", "description": "configuration for testing a property", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.quiet", "description": "configuration for testing a property", "p": "mathlib"}, {"name": "slim_check.subtype_var_testable", "description": "", "p": "mathlib"}, {"name": "slim_check.or_counter_example", "description": "Combine the test result for properties `p` and `q` to create a test for their disjunction", "p": "mathlib"}, {"name": "slim_check.tactic.mk_decorations", "description": " In a goal of the shape `\u22a2 tactic.decorations_of p`, `mk_decoration` examines\nthe syntax of `p` and add `named_binder` around universal quantifications and\nexistential quantifications to improve error messages.\n\nThis tool can be used in the declaration of a function as follows:\n\n```lean\ndef foo (p : Prop) (p' : tactic.decorations_of p . mk_decorations) [testable p'] : ...\n```\n\n`p` is the parameter given by the user, `p'` is an equivalent proposition where\nthe quantifiers are annotated with `named_binder`.", "p": "mathlib"}, {"name": "slim_check.le.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.imp.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.var_testable", "description": " Test a universal property by creating a sample of the right type and instantiating the\nbound variable with it", "p": "mathlib"}, {"name": "slim_check.eq.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.testable.check", "description": "Run a test suite for `p` and return true or false: should we believe that `p` holds?", "p": "mathlib"}, {"name": "slim_check.format_failure'", "description": "Format the counter-examples found in a test failure.", "p": "mathlib"}, {"name": "slim_check.tactic.add_decorations", "description": " Traverse the syntax of a proposition to find universal quantifiers\nand existential quantifiers and add `named_binder` annotations next to\nthem.", "p": "mathlib"}, {"name": "slim_check.bool.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.tactic.add_existential_decorations", "description": " `add_existential_decorations p` adds `a `named_binder` annotation at the\nroot of `p` if `p` is an existential quantification.", "p": "mathlib"}, {"name": "slim_check.testable.run_suite_aux", "description": "Try `n` times to find a counter-example for `p`.", "p": "mathlib"}, {"name": "slim_check.convert_counter_example", "description": " If `q \u2192 p`, then `\u00ac p \u2192 \u00ac q` which means that testing `p` can allow us\nto find counter-examples to `q`.", "p": "mathlib"}, {"name": "slim_check.default_printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.printable_prop", "description": "`printable_prop p` allows one to print a proposition so that\n`slim_check` can indicate how values relate to each other.", "p": "mathlib"}, {"name": "slim_check.printable_prop.print_prop", "description": "`printable_prop p` allows one to print a proposition so that\n`slim_check` can indicate how values relate to each other.", "p": "mathlib"}, {"name": "slim_check.test_result", "description": " Result of trying to disprove `p`\n\nThe constructors are:\n  *  `success : (psum unit p) \u2192 test_result`\n     succeed when we find another example satisfying `p`\n     In `success h`, `h` is an optional proof of the proposition.\n     Without the proof, all we know is that we found one example\n     where `p` holds. With a proof, the one test was sufficient to\n     prove that `p` holds and we do not need to keep finding examples.\n   * `gave_up {} : \u2115 \u2192 test_result`\n     give up when a well-formed example cannot be generated.\n     `gave_up n` tells us that `n` invalid examples were tried.\n     Above 100, we give up on the proposition and report that we\n     did not find a way to properly test it.\n   * `failure : \u00ac p \u2192 (list string) \u2192 \u2115 \u2192 test_result`\n     a counter-example to `p`; the strings specify values for the relevant variables.\n     `failure h vs n` also carries a proof that `p` does not hold. This way, we can\n     guarantee that there will be no false positive. The last component, `n`,\n     is the number of times that the counter-example was shrunk.", "p": "mathlib"}, {"name": "slim_check.test_result.success", "description": " Result of trying to disprove `p`\n\nThe constructors are:\n  *  `success : (psum unit p) \u2192 test_result`\n     succeed when we find another example satisfying `p`\n     In `success h`, `h` is an optional proof of the proposition.\n     Without the proof, all we know is that we found one example\n     where `p` holds. With a proof, the one test was sufficient to\n     prove that `p` holds and we do not need to keep finding examples.\n   * `gave_up {} : \u2115 \u2192 test_result`\n     give up when a well-formed example cannot be generated.\n     `gave_up n` tells us that `n` invalid examples were tried.\n     Above 100, we give up on the proposition and report that we\n     did not find a way to properly test it.\n   * `failure : \u00ac p \u2192 (list string) \u2192 \u2115 \u2192 test_result`\n     a counter-example to `p`; the strings specify values for the relevant variables.\n     `failure h vs n` also carries a proof that `p` does not hold. This way, we can\n     guarantee that there will be no false positive. The last component, `n`,\n     is the number of times that the counter-example was shrunk.", "p": "mathlib"}, {"name": "slim_check.test_result.gave_up", "description": " Result of trying to disprove `p`\n\nThe constructors are:\n  *  `success : (psum unit p) \u2192 test_result`\n     succeed when we find another example satisfying `p`\n     In `success h`, `h` is an optional proof of the proposition.\n     Without the proof, all we know is that we found one example\n     where `p` holds. With a proof, the one test was sufficient to\n     prove that `p` holds and we do not need to keep finding examples.\n   * `gave_up {} : \u2115 \u2192 test_result`\n     give up when a well-formed example cannot be generated.\n     `gave_up n` tells us that `n` invalid examples were tried.\n     Above 100, we give up on the proposition and report that we\n     did not find a way to properly test it.\n   * `failure : \u00ac p \u2192 (list string) \u2192 \u2115 \u2192 test_result`\n     a counter-example to `p`; the strings specify values for the relevant variables.\n     `failure h vs n` also carries a proof that `p` does not hold. This way, we can\n     guarantee that there will be no false positive. The last component, `n`,\n     is the number of times that the counter-example was shrunk.", "p": "mathlib"}, {"name": "slim_check.test_result.failure", "description": " Result of trying to disprove `p`\n\nThe constructors are:\n  *  `success : (psum unit p) \u2192 test_result`\n     succeed when we find another example satisfying `p`\n     In `success h`, `h` is an optional proof of the proposition.\n     Without the proof, all we know is that we found one example\n     where `p` holds. With a proof, the one test was sufficient to\n     prove that `p` holds and we do not need to keep finding examples.\n   * `gave_up {} : \u2115 \u2192 test_result`\n     give up when a well-formed example cannot be generated.\n     `gave_up n` tells us that `n` invalid examples were tried.\n     Above 100, we give up on the proposition and report that we\n     did not find a way to properly test it.\n   * `failure : \u00ac p \u2192 (list string) \u2192 \u2115 \u2192 test_result`\n     a counter-example to `p`; the strings specify values for the relevant variables.\n     `failure h vs n` also carries a proof that `p` does not hold. This way, we can\n     guarantee that there will be no false positive. The last component, `n`,\n     is the number of times that the counter-example was shrunk.", "p": "mathlib"}, {"name": "slim_check.false.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.minimize", "description": " Once a property fails to hold on an example, look for smaller counter-examples\nto show the user.", "p": "mathlib"}, {"name": "slim_check.or.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.use_has_to_string.mk", "description": "Add the type tag `use_has_to_string` to an expression's type.", "p": "mathlib"}, {"name": "slim_check.use_has_to_string.has_repr", "description": "", "p": "mathlib"}, {"name": "slim_check.use_has_to_string.inhabited", "description": "", "p": "mathlib"}, {"name": "slim_check.add_var_to_counter_example", "description": "Add some formatting to the information recorded by `add_to_counter_example`.", "p": "mathlib"}, {"name": "slim_check.true.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.decidable_testable", "description": "", "p": "mathlib"}, {"name": "slim_check.named_binder", "description": " Gadget used to introspect the name of bound variables.\n\nIt is used with the `testable` typeclass so that\n`testable (named_binder \"x\" (\u2200 x, p x))` can use the variable name\nof `x` in error messages displayed to the user. If we find that instantiating\nthe above quantifier with 3 falsifies it, we can print:\n\n```lean\n==============\nProblem found!\n==============\nx := 3\n```", "p": "mathlib"}, {"name": "slim_check.tactic.decorations_of", "description": " `decorations_of p` is used as a hint to `mk_decorations` to specify\nthat the goal should be satisfied with a proposition equivalent to `p`\nwith added annotations.", "p": "mathlib"}, {"name": "slim_check.ne.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.test_result.inhabited", "description": "", "p": "mathlib"}, {"name": "slim_check.testable", "description": "`testable p` uses random examples to try to disprove `p`.", "p": "mathlib"}, {"name": "slim_check.testable.run", "description": "`testable p` uses random examples to try to disprove `p`.", "p": "mathlib"}, {"name": "slim_check.slim_check_cfg.has_reflect", "description": "", "p": "mathlib"}, {"name": "slim_check.or_testable", "description": "", "p": "mathlib"}, {"name": "slim_check.exists_testable", "description": "", "p": "mathlib"}, {"name": "slim_check.add_to_counter_example", "description": " When we assign a value to a universally quantified variable,\nwe record that value using this function so that our counter-examples\ncan be informative.", "p": "mathlib"}, {"name": "slim_check.iff_testable", "description": "", "p": "mathlib"}, {"name": "slim_check.all_types_testable", "description": "", "p": "mathlib"}, {"name": "slim_check.test_result.has_to_string", "description": "", "p": "mathlib"}, {"name": "slim_check.lt.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.dec_guard_testable", "description": "", "p": "mathlib"}, {"name": "slim_check.and.printable_prop", "description": "", "p": "mathlib"}, {"name": "slim_check.add_shrinks", "description": "Increase the number of shrinking steps in a test result.", "p": "mathlib"}, {"name": "slim_check.test_result.to_string", "description": "format a `test_result` as a string.", "p": "mathlib"}, {"name": "slim_check.trace_if_giveup", "description": "Trace the value of sampled variables if the sample is discarded.", "p": "mathlib"}, {"name": "slim_check.and_testable", "description": "", "p": "mathlib"}, {"name": "slim_check.give_up", "description": "Count the number of times the test procedure gave up.", "p": "mathlib"}, {"name": "slim_check.iff.printable_prop", "description": "", "p": "mathlib"}, {"name": "equiv.perm.fin_rotate_bit1_mem_alternating_group", "description": "", "p": "mathlib"}, {"name": "alternating_group.fintype", "description": "", "p": "mathlib"}, {"name": "alternating_group.unique", "description": "", "p": "mathlib"}, {"name": "alternating_group.is_conj_swap_mul_swap_of_cycle_type_two", "description": "Shows that any non-identity element of $A_5$ whose cycle decomposition consists only of swaps\n is conjugate to $(04)(13)$. This is used to show that the normal closure of such a permutation\n in $A_5$ is $A_5$.", "p": "mathlib"}, {"name": "equiv.perm.prod_list_swap_mem_alternating_group_iff_even_length", "description": "", "p": "mathlib"}, {"name": "alternating_group.normal_closure_fin_rotate_five", "description": "The normal closure of the 5-cycle `fin_rotate 5` within $A_5$ is the whole group. This will be\n used to show that the normal closure of any 5-cycle within $A_5$ is the whole group.", "p": "mathlib"}, {"name": "equiv.perm.is_three_cycle_sq_of_three_mem_cycle_type_five", "description": "Part of proving $A_5$ is simple. Shows that the square of any element of $A_5$ with a 3-cycle in\n its cycle decomposition is a 3-cycle, so the normal closure of the original element must be\n $A_5$.", "p": "mathlib"}, {"name": "equiv.perm.closure_three_cycles_eq_alternating", "description": "", "p": "mathlib"}, {"name": "alternating_group", "description": "The alternating group on a finite type, realized as a subgroup of `equiv.perm`.\n For $A_n$, use `alternating_group (fin n)`.", "p": "mathlib"}, {"name": "alternating_group_eq_sign_ker", "description": "", "p": "mathlib"}, {"name": "alternating_group.nontrivial", "description": "", "p": "mathlib"}, {"name": "two_mul_card_alternating_group", "description": "", "p": "mathlib"}, {"name": "alternating_group.is_three_cycle_is_conj", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_three_cycle.mem_alternating_group", "description": "", "p": "mathlib"}, {"name": "alternating_group.is_simple_group_five", "description": "Shows that $A_5$ is simple by taking an arbitrary non-identity element and showing by casework\n on its cycle type that its normal closure is all of $A_5$.", "p": "mathlib"}, {"name": "alternating_group.normal_closure_swap_mul_swap_five", "description": "The normal closure of $(04)(13)$ within $A_5$ is the whole group. This will be\n used to show that the normal closure of any permutation of cycle type $(2,2)$ is the whole group.", "p": "mathlib"}, {"name": "alternating_group.normal", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_three_cycle.alternating_normal_closure", "description": "A key lemma to prove $A_5$ is simple. Shows that any normal subgroup of an alternating group on\n at least 5 elements is the entire alternating group if it contains a 3-cycle.", "p": "mathlib"}, {"name": "alternating_group.is_conj_of", "description": "", "p": "mathlib"}, {"name": "alternating_group.nontrivial_of_three_le_card", "description": "", "p": "mathlib"}, {"name": "equiv.perm.mem_alternating_group", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite_presentation", "description": " An algebra morphism `A \u2192\u2090[R] B` is of `finite_presentation` if it is of finite presentation as\nring morphism. In other words, if `B` is finitely presented as `A`-algebra.", "p": "mathlib"}, {"name": "algebra.finite_presentation.iff", "description": "", "p": "mathlib"}, {"name": "algebra.finite_presentation.of_restrict_scalars_finite_presentation", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite_presentation.of_comp_finite_type", "description": "", "p": "mathlib"}, {"name": "ring_hom.finite_presentation.of_surjective", "description": "", "p": "mathlib"}, {"name": "algebra.finite_presentation.ker_fg_of_mv_polynomial", "description": "This is used to prove the strictly stronger `ker_fg_of_surjective`. Use it instead.", "p": "mathlib"}, {"name": "algebra.finite_presentation.ker_fg_of_surjective", "description": " If `f : A \u2192\u2090[R] B` is a sujection between finitely-presented `R`-algebras, then the kernel of\n`f` is finitely generated.", "p": "mathlib"}, {"name": "algebra.finite_presentation.trans", "description": "If `A` is an `R`-algebra and `S` is an `A`-algebra, both finitely presented, then `S` is\n finitely presented as `R`-algebra.", "p": "mathlib"}, {"name": "algebra.finite_presentation.of_surjective", "description": " If `f : A \u2192\u2090[R] B` is surjective with finitely generated kernel and `A` is finitely presented,\nthen so is `B`.", "p": "mathlib"}, {"name": "algebra.finite_presentation.of_finite_type", "description": " An algebra over a Noetherian ring is finitely generated if and only if it is finitely\npresented.", "p": "mathlib"}, {"name": "alg_hom.finite_presentation.of_finite_type", "description": "", "p": "mathlib"}, {"name": "ring_hom.finite_presentation", "description": " A ring morphism `A \u2192+* B` is of `finite_presentation` if `B` is finitely presented as\n`A`-algebra.", "p": "mathlib"}, {"name": "algebra.finite_type.of_finite_presentation", "description": "A finitely presented algebra is of finite type.", "p": "mathlib"}, {"name": "ring_hom.finite_presentation.of_comp_finite_type", "description": "", "p": "mathlib"}, {"name": "algebra.finite_presentation", "description": " An algebra over a commutative semiring is `finite_presentation` if it is the quotient of a\npolynomial ring in `n` variables by a finitely generated ideal.", "p": "mathlib"}, {"name": "alg_hom.finite_presentation.comp_surjective", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite_presentation.id", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite_presentation.of_surjective", "description": "", "p": "mathlib"}, {"name": "algebra.finite_presentation.iff_quotient_mv_polynomial'", "description": " An algebra is finitely presented if and only if it is a quotient of a polynomial ring whose\nvariables are indexed by a fintype by a finitely generated ideal.", "p": "mathlib"}, {"name": "algebra.finite_presentation.mv_polynomial", "description": "The ring of polynomials in finitely many variables is finitely presented.", "p": "mathlib"}, {"name": "algebra.finite_presentation.equiv", "description": "If `e : A \u2243\u2090[R] B` and `A` is finitely presented, then so is `B`.", "p": "mathlib"}, {"name": "alg_hom.finite_type.of_finite_presentation", "description": "", "p": "mathlib"}, {"name": "algebra.finite_presentation.polynomial", "description": "`R[X]` is finitely presented as `R`-algebra.", "p": "mathlib"}, {"name": "ring_hom.finite_presentation.id", "description": "", "p": "mathlib"}, {"name": "ring_hom.finite_presentation.of_finite_type", "description": "", "p": "mathlib"}, {"name": "algebra.finite_presentation.quotient", "description": " The quotient of a finitely presented algebra by a finitely generated ideal is finitely\npresented.", "p": "mathlib"}, {"name": "algebra.finite_presentation.self", "description": "`R` is finitely presented as `R`-algebra.", "p": "mathlib"}, {"name": "ring_hom.finite_type.of_finite_presentation", "description": "", "p": "mathlib"}, {"name": "alg_hom.finite_presentation.comp", "description": "", "p": "mathlib"}, {"name": "ring_hom.finite_presentation.comp_surjective", "description": "", "p": "mathlib"}, {"name": "algebra.finite_presentation.mv_polynomial_of_finite_presentation", "description": " If `A` is a finitely presented `R`-algebra, then `mv_polynomial (fin n) A` is finitely presented\nas `R`-algebra.", "p": "mathlib"}, {"name": "ring_hom.finite_presentation.comp", "description": "", "p": "mathlib"}, {"name": "is_covering_map_on.continuous_at", "description": "", "p": "mathlib"}, {"name": "is_covering_map_iff_is_covering_map_on_univ", "description": "", "p": "mathlib"}, {"name": "is_evenly_covered.to_trivialization_apply", "description": "", "p": "mathlib"}, {"name": "is_covering_map_on.is_locally_homeomorph_on", "description": "", "p": "mathlib"}, {"name": "is_covering_map_on.mk", "description": "", "p": "mathlib"}, {"name": "is_fiber_bundle.is_covering_map", "description": "", "p": "mathlib"}, {"name": "is_evenly_covered", "description": "A point `x : X` is evenly covered by `f : E \u2192 X` if `x` has an evenly covered neighborhood.", "p": "mathlib"}, {"name": "is_covering_map.quotient_map", "description": "", "p": "mathlib"}, {"name": "is_covering_map_on", "description": "A covering map is a continuous function `f : E \u2192 X` with discrete fibers such that each point\n of `X` has an evenly covered neighborhood.", "p": "mathlib"}, {"name": "is_covering_map_on.continuous_on", "description": "", "p": "mathlib"}, {"name": "is_covering_map.is_locally_homeomorph", "description": "", "p": "mathlib"}, {"name": "is_evenly_covered.mem_to_trivialization_base_set", "description": "", "p": "mathlib"}, {"name": "is_evenly_covered.to_is_evenly_covered_preimage", "description": "", "p": "mathlib"}, {"name": "is_covering_map.is_open_map", "description": "", "p": "mathlib"}, {"name": "is_evenly_covered.to_trivialization", "description": "If `x` is evenly covered by `f`, then we can construct a trivialization of `f` at `x`.", "p": "mathlib"}, {"name": "is_evenly_covered.continuous_at", "description": "", "p": "mathlib"}, {"name": "is_covering_map.mk", "description": "", "p": "mathlib"}, {"name": "is_covering_map.continuous", "description": "", "p": "mathlib"}, {"name": "is_covering_map.is_covering_map_on", "description": "", "p": "mathlib"}, {"name": "is_covering_map", "description": "A covering map is a continuous function `f : E \u2192 X` with discrete fibers such that each point\n of `X` has an evenly covered neighborhood.", "p": "mathlib"}, {"name": "fiber_bundle.is_covering_map", "description": "", "p": "mathlib"}, {"name": "algebra.trace_comp_trace_of_basis", "description": "", "p": "mathlib"}, {"name": "algebra.trace_matrix_eq_embeddings_matrix_reindex_mul_trans", "description": "", "p": "mathlib"}, {"name": "algebra.embeddings_matrix_reindex_eq_vandermonde", "description": "", "p": "mathlib"}, {"name": "intermediate_field.adjoin_simple.trace_gen_eq_zero", "description": "", "p": "mathlib"}, {"name": "trace_form_nondegenerate", "description": "", "p": "mathlib"}, {"name": "trace_eq_sum_embeddings", "description": "", "p": "mathlib"}, {"name": "trace_eq_sum_embeddings_gen", "description": "", "p": "mathlib"}, {"name": "algebra.trace_matrix_eq_embeddings_matrix_mul_trans", "description": "", "p": "mathlib"}, {"name": "sum_embeddings_eq_finrank_mul", "description": "", "p": "mathlib"}, {"name": "algebra.trace_matrix_apply", "description": "", "p": "mathlib"}, {"name": "algebra.embeddings_matrix", "description": "`embeddings_matrix A C b : matrix \u03ba (B \u2192\u2090[A] C) C` is the matrix whose `(i, \u03c3)` coefficient is\n `\u03c3 (b i)`. It is mostly useful for fields when `fintype.card \u03ba = finrank A B` and `C` is\n algebraically closed.", "p": "mathlib"}, {"name": "algebra.trace_matrix_reindex", "description": "", "p": "mathlib"}, {"name": "algebra.trace_form_to_matrix_power_basis", "description": "", "p": "mathlib"}, {"name": "trace_eq_sum_roots", "description": "", "p": "mathlib"}, {"name": "algebra.trace_apply", "description": "", "p": "mathlib"}, {"name": "algebra.trace_prod_apply", "description": "", "p": "mathlib"}, {"name": "algebra.trace_comp_trace", "description": "", "p": "mathlib"}, {"name": "algebra.embeddings_matrix_apply", "description": "", "p": "mathlib"}, {"name": "algebra.trace_matrix_of_matrix_vec_mul", "description": "", "p": "mathlib"}, {"name": "algebra.trace_form_apply", "description": "", "p": "mathlib"}, {"name": "algebra.is_integral_trace", "description": "", "p": "mathlib"}, {"name": "algebra.trace_trace", "description": "", "p": "mathlib"}, {"name": "trace_eq_sum_automorphisms", "description": "", "p": "mathlib"}, {"name": "algebra.trace_matrix_of_basis", "description": "", "p": "mathlib"}, {"name": "algebra.trace_algebra_map", "description": " If `x` is in the base field `K`, then the trace is `[L : K] * x`.\n\n(If `L` is not finite-dimensional over `K`, then `trace` and `finrank` return `0`.)", "p": "mathlib"}, {"name": "algebra.trace_form_to_matrix", "description": "", "p": "mathlib"}, {"name": "algebra.trace_prod", "description": "", "p": "mathlib"}, {"name": "det_trace_form_ne_zero", "description": "", "p": "mathlib"}, {"name": "algebra.trace", "description": " The trace of an element `s` of an `R`-algebra is the trace of `(*) s`,\nas an `R`-linear map.", "p": "mathlib"}, {"name": "algebra.trace_algebra_map_of_basis", "description": "If `x` is in the base field `K`, then the trace is `[L : K] * x`.", "p": "mathlib"}, {"name": "algebra.trace_trace_of_basis", "description": "", "p": "mathlib"}, {"name": "algebra.trace_matrix", "description": " Given an `A`-algebra `B` and `b`, an `\u03ba`-indexed family of elements of `B`, we define\n`trace_matrix A b` as the matrix whose `(i j)`-th element is the trace of `b i * b j`.", "p": "mathlib"}, {"name": "power_basis.trace_gen_eq_next_coeff_minpoly", "description": "Given `pb : power_basis K S`, the trace of `pb.gen` is `-(minpoly K pb.gen).next_coeff`.", "p": "mathlib"}, {"name": "algebra.trace_form_is_symm", "description": "", "p": "mathlib"}, {"name": "trace_eq_trace_adjoin", "description": "", "p": "mathlib"}, {"name": "algebra.trace_matrix_of_matrix_mul_vec", "description": "", "p": "mathlib"}, {"name": "power_basis.trace_gen_eq_sum_roots", "description": " Given `pb : power_basis K S`, then the trace of `pb.gen` is\n`((minpoly K pb.gen).map (algebra_map K F)).roots.sum`.", "p": "mathlib"}, {"name": "intermediate_field.adjoin_simple.trace_gen_eq_sum_roots", "description": "", "p": "mathlib"}, {"name": "algebra.trace_eq_matrix_trace", "description": "", "p": "mathlib"}, {"name": "algebra.embeddings_matrix_reindex", "description": "`embeddings_matrix_reindex A C b e : matrix \u03ba \u03ba C` is the matrix whose `(i, j)` coefficient\n is `\u03c3\u2c7c (b i)`, where `\u03c3\u2c7c : B \u2192\u2090[A] C` is the embedding corresponding to `j : \u03ba` given by a\n bijection `e : \u03ba \u2243 (B \u2192\u2090[A] C)`. It is mostly useful for fields and `C` is algebraically closed.\n In this case, in presence of `h : fintype.card \u03ba = finrank A B`, one can take\n `e := equiv_of_card_eq ((alg_hom.card A B C).trans h.symm)`.", "p": "mathlib"}, {"name": "algebra.trace_matrix_of_basis_mul_vec", "description": "", "p": "mathlib"}, {"name": "det_trace_matrix_ne_zero'", "description": "", "p": "mathlib"}, {"name": "algebra.trace_form", "description": " The `trace_form` maps `x y : S` to the trace of `x * y`.\nIt is a symmetric bilinear form and is nondegenerate if the extension is separable.", "p": "mathlib"}, {"name": "algebra.trace_eq_zero_of_not_exists_basis", "description": "", "p": "mathlib"}, {"name": "map_eq_bind_pure_comp", "description": "", "p": "mathlib"}, {"name": "state_t.equiv", "description": " reduce the equivalence between two state monads to the equivalence between\ntheir respective function spaces", "p": "mathlib"}, {"name": "reader_t.equiv", "description": " reduce the equivalence between two reader monads to the equivalence between\ntheir respective function spaces", "p": "mathlib"}, {"name": "state_t.eval", "description": "run a `state_t` program and discard the final state", "p": "mathlib"}, {"name": "function.injective.ordered_comm_monoid", "description": " Pullback an `ordered_comm_monoid` under an injective map.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "order_embedding.add_left_apply", "description": "", "p": "mathlib"}, {"name": "function.injective.ordered_add_comm_monoid", "description": "Pullback an `ordered_add_comm_monoid` under an injective map.", "p": "mathlib"}, {"name": "order_embedding.mul_right_apply", "description": "", "p": "mathlib"}, {"name": "function.injective.linear_ordered_comm_monoid", "description": " Pullback a `linear_ordered_comm_monoid` under an injective map.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "order_embedding.mul_left", "description": " The order embedding sending `b` to `a * b`, for some fixed `a`.\nSee also `order_iso.mul_left` when working in an ordered group.", "p": "mathlib"}, {"name": "order_embedding.mul_right", "description": " The order embedding sending `b` to `b * a`, for some fixed `a`.\nSee also `order_iso.mul_right` when working in an ordered group.", "p": "mathlib"}, {"name": "order_embedding.add_right_apply", "description": "", "p": "mathlib"}, {"name": "order_embedding.add_left", "description": "The order embedding sending `b` to `a + b`, for some fixed `a`.\n  See also `order_iso.add_left` when working in an additive ordered group.", "p": "mathlib"}, {"name": "order_embedding.add_right", "description": "The order embedding sending `b` to `b + a`, for some fixed `a`.\n  See also `order_iso.add_right` when working in an additive ordered group.", "p": "mathlib"}, {"name": "function.injective.linear_ordered_add_comm_monoid", "description": "Pullback an `ordered_add_comm_monoid` under an injective map.", "p": "mathlib"}, {"name": "order_embedding.mul_left_apply", "description": "", "p": "mathlib"}, {"name": "lie_algebra.exists_engelian_lie_subalgebra_of_lt_normalizer", "description": "", "p": "mathlib"}, {"name": "lie_submodule.exists_smul_add_of_span_sup_eq_top", "description": "", "p": "mathlib"}, {"name": "lie_algebra.is_engelian", "description": " A Lie algebra `L` is said to be Engelian if a sufficient condition for any `L`-Lie module `M` to\nbe nilpotent is that the image of the map `L \u2192 End(M)` consists of nilpotent elements.\n\nEngel's theorem `lie_algebra.is_engelian_of_is_noetherian` states that any Noetherian Lie algebra is\nEngelian.", "p": "mathlib"}, {"name": "lie_algebra.is_engelian_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "function.surjective.is_engelian", "description": "", "p": "mathlib"}, {"name": "lie_submodule.lie_top_eq_of_span_sup_eq_top", "description": "", "p": "mathlib"}, {"name": "lie_algebra.is_engelian_of_is_noetherian", "description": " *Engel's theorem*.\n\nNote that this implies all traditional forms of Engel's theorem via\n`lie_module.nontrivial_max_triv_of_is_nilpotent`, `lie_module.is_nilpotent_iff_forall`,\n`lie_algebra.is_nilpotent_iff_forall`.", "p": "mathlib"}, {"name": "lie_submodule.lcs_le_lcs_of_is_nilpotent_span_sup_eq_top", "description": "", "p": "mathlib"}, {"name": "lie_submodule.is_nilpotent_of_is_nilpotent_span_sup_eq_top", "description": "", "p": "mathlib"}, {"name": "lie_equiv.is_engelian_iff", "description": "", "p": "mathlib"}, {"name": "lie_module.is_nilpotent_iff_forall", "description": "Engel's theorem.", "p": "mathlib"}, {"name": "lie_algebra.is_nilpotent_iff_forall", "description": "Engel's theorem.", "p": "mathlib"}, {"name": "num.ldiff", "description": "Bitwise `\u03bb a b, a && !b` for `num`. For example, `ldiff 5 9 = 4`:\n\n    101\n   1001\n   ----\n    100", "p": "mathlib"}, {"name": "snum.has_one", "description": "", "p": "mathlib"}, {"name": "pos_num.lxor", "description": "Bitwise \"xor\" for `pos_num`.", "p": "mathlib"}, {"name": "pos_num.test_bit", "description": "`a.test_bit n` is `tt` iff the `n`-th bit (starting from the LSB) in the binary representation\n     of `a` is active. If the size of `a` is less than `n`, this evaluates to `ff`.", "p": "mathlib"}, {"name": "snum.bit_zero", "description": "", "p": "mathlib"}, {"name": "snum.add", "description": "Add two `snum`s.", "p": "mathlib"}, {"name": "snum.has_add", "description": "", "p": "mathlib"}, {"name": "snum.decidable_eq", "description": "", "p": "mathlib"}, {"name": "snum.not", "description": "Bitwise `not` for `snum`.", "p": "mathlib"}, {"name": "nzsnum.tail", "description": "The `tail` of a `nzsnum` is the `snum` obtained by removing the LSB.\n     Edge cases: `tail 1 = 0` and `tail (-2) = -1`.", "p": "mathlib"}, {"name": "pos_num.land", "description": "Bitwise \"and\" for `pos_num`.", "p": "mathlib"}, {"name": "snum.bit0", "description": "Add an inactive bit at the end of a `snum`. This mimics `znum.bit0`.", "p": "mathlib"}, {"name": "snum.bit", "description": "Add a bit at the end of a `snum`. This mimics `nzsnum.bit`.", "p": "mathlib"}, {"name": "snum.pred", "description": "The predecessor of a `snum` (i.e. the operation of removing one).", "p": "mathlib"}, {"name": "snum.has_mul", "description": "", "p": "mathlib"}, {"name": "num.land", "description": "Bitwise \"and\" for `num`.", "p": "mathlib"}, {"name": "num.lxor", "description": "Bitwise \"xor\" for `num`.", "p": "mathlib"}, {"name": "snum.has_sub", "description": "", "p": "mathlib"}, {"name": "nzsnum.head", "description": "The `head` of a `nzsnum` is the boolean value of its LSB.", "p": "mathlib"}, {"name": "snum.drec'", "description": "A dependent induction principle for `snum` which avoids relying on `nzsnum`.", "p": "mathlib"}, {"name": "snum.czadd", "description": "`snum.czadd a b n` is `n + a - b` (where `a` and `b` should be read as either 0 or 1).\n     This is useful to implement the carry system in `cadd`.", "p": "mathlib"}, {"name": "snum.succ", "description": "The successor of a `snum` (i.e. the operation adding one).", "p": "mathlib"}, {"name": "snum.test_bit", "description": "`snum.test_bit n a` is `tt` iff the `n`-th bit (starting from the LSB) of `a` is active.\n     If the size of `a` is less than `n`, this evaluates to `ff`.", "p": "mathlib"}, {"name": "nzsnum.has_reflect", "description": "", "p": "mathlib"}, {"name": "nzsnum.decidable_eq", "description": "", "p": "mathlib"}, {"name": "snum.sub", "description": "subtract two `snum`s.", "p": "mathlib"}, {"name": "snum.bits", "description": "`a.bits n` is the vector of the `n` first bits of `a` (starting from the LSB).", "p": "mathlib"}, {"name": "snum.has_neg", "description": "", "p": "mathlib"}, {"name": "snum.neg", "description": "The opposite of a `snum`.", "p": "mathlib"}, {"name": "nzsnum.bit0", "description": "Add an inactive bit at the end of a `nzsnum`. This mimics `pos_num.bit0`.", "p": "mathlib"}, {"name": "nzsnum.sign", "description": "Sign of a `nzsnum`.", "p": "mathlib"}, {"name": "nzsnum", "description": "This is a nonzero (and \"non minus one\") version of `snum`.\n   See the documentation of `snum` for more details.", "p": "mathlib"}, {"name": "nzsnum.msb", "description": "This is a nonzero (and \"non minus one\") version of `snum`.\n   See the documentation of `snum` for more details.", "p": "mathlib"}, {"name": "nzsnum.bit", "description": "This is a nonzero (and \"non minus one\") version of `snum`.\n   See the documentation of `snum` for more details.", "p": "mathlib"}, {"name": "nzsnum.has_one", "description": "", "p": "mathlib"}, {"name": "pos_num.shiftl", "description": "Left-shift the binary representation of a `pos_num`.", "p": "mathlib"}, {"name": "num.lor", "description": "Bitwise \"or\" for `num`.", "p": "mathlib"}, {"name": "pos_num.lor", "description": "Bitwise \"or\" for `pos_num`.", "p": "mathlib"}, {"name": "nzsnum.not", "description": "Bitwise `not` for `nzsnum`.", "p": "mathlib"}, {"name": "pos_num.shiftr", "description": "Right-shift the binary representation of a `pos_num`.", "p": "mathlib"}, {"name": "pos_num.ldiff", "description": "Bitwise `\u03bb a b, a && !b` for `pos_num`. For example, `ldiff 5 9 = 4`:\n\n    101\n   1001\n   ----\n    100", "p": "mathlib"}, {"name": "snum.has_reflect", "description": "", "p": "mathlib"}, {"name": "snum.has_zero", "description": "", "p": "mathlib"}, {"name": "snum.has_coe", "description": "", "p": "mathlib"}, {"name": "snum.rec'", "description": "An induction principle for `snum` which avoids relying on `nzsnum`.", "p": "mathlib"}, {"name": "num.one_bits", "description": "`n.one_bits` is the list of indices of active bits in the binary representation of `n`.", "p": "mathlib"}, {"name": "nzsnum.inhabited", "description": "", "p": "mathlib"}, {"name": "snum.sign", "description": "Sign of a `snum`.", "p": "mathlib"}, {"name": "nzsnum.bit1", "description": "Add an active bit at the end of a `nzsnum`. This mimics `pos_num.bit1`.", "p": "mathlib"}, {"name": "num.shiftl", "description": "Left-shift the binary representation of a `num`.", "p": "mathlib"}, {"name": "snum.inhabited", "description": "", "p": "mathlib"}, {"name": "snum.cadd", "description": "", "p": "mathlib"}, {"name": "nzsnum.drec'", "description": "A dependent induction principle for `nzsnum`, with base cases\n     `0 : snum` and `(-1) : snum`.", "p": "mathlib"}, {"name": "snum.bit1", "description": "Add an active bit at the end of a `snum`. This mimics `znum.bit1`.", "p": "mathlib"}, {"name": "snum.head", "description": "The `head` of a `snum` is the boolean value of its LSB.", "p": "mathlib"}, {"name": "num.shiftr", "description": "Right-shift the binary representation of a `pos_num`.", "p": "mathlib"}, {"name": "num.test_bit", "description": "`a.test_bit n` is `tt` iff the `n`-th bit (starting from the LSB) in the binary representation\n     of `a` is active. If the size of `a` is less than `n`, this evaluates to `ff`.", "p": "mathlib"}, {"name": "snum.bit_one", "description": "", "p": "mathlib"}, {"name": "snum.tail", "description": "The `tail` of a `snum` is obtained by removing the LSB.\n     Edge cases: `tail 1 = 0`, `tail (-2) = -1`, `tail 0 = 0` and `tail (-1) = -1`.", "p": "mathlib"}, {"name": "snum.mul", "description": "Multiply two `snum`s.", "p": "mathlib"}, {"name": "snum", "description": "Alternative representation of integers using a sign bit at the end.\n The convention on sign here is to have the argument to `msb` denote\n the sign of the MSB itself, with all higher bits set to the negation\n of this sign. The result is interpreted in two's complement.\n\n    13  = ..0001101(base 2) = nz (bit1 (bit0 (bit1 (msb tt))))\n    -13 = ..1110011(base 2) = nz (bit1 (bit1 (bit0 (msb ff))))\n\n As with `num`, a special case must be added for zero, which has no msb,\n but by two's complement symmetry there is a second special case for -1.\n Here the `bool` field indicates the sign of the number.\n\n    0  = ..0000000(base 2) = zero ff\n    -1 = ..1111111(base 2) = zero tt", "p": "mathlib"}, {"name": "snum.zero", "description": "Alternative representation of integers using a sign bit at the end.\n The convention on sign here is to have the argument to `msb` denote\n the sign of the MSB itself, with all higher bits set to the negation\n of this sign. The result is interpreted in two's complement.\n\n    13  = ..0001101(base 2) = nz (bit1 (bit0 (bit1 (msb tt))))\n    -13 = ..1110011(base 2) = nz (bit1 (bit1 (bit0 (msb ff))))\n\n As with `num`, a special case must be added for zero, which has no msb,\n but by two's complement symmetry there is a second special case for -1.\n Here the `bool` field indicates the sign of the number.\n\n    0  = ..0000000(base 2) = zero ff\n    -1 = ..1111111(base 2) = zero tt", "p": "mathlib"}, {"name": "snum.nz", "description": "Alternative representation of integers using a sign bit at the end.\n The convention on sign here is to have the argument to `msb` denote\n the sign of the MSB itself, with all higher bits set to the negation\n of this sign. The result is interpreted in two's complement.\n\n    13  = ..0001101(base 2) = nz (bit1 (bit0 (bit1 (msb tt))))\n    -13 = ..1110011(base 2) = nz (bit1 (bit1 (bit0 (msb ff))))\n\n As with `num`, a special case must be added for zero, which has no msb,\n but by two's complement symmetry there is a second special case for -1.\n Here the `bool` field indicates the sign of the number.\n\n    0  = ..0000000(base 2) = zero ff\n    -1 = ..1111111(base 2) = zero tt", "p": "mathlib"}, {"name": "pos_num.one_bits", "description": "`n.one_bits 0` is the list of indices of active bits in the binary representation of `n`.", "p": "mathlib"}, {"name": "asymptotics.is_Theta_sup", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta.of_const_smul_left", "description": "**Alias** of the forward direction of `asymptotics.is_Theta_const_smul_left`.", "p": "mathlib"}, {"name": "asymptotics.is_O.antisymm", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta_const_const_iff", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta_norm_left", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta_zero_right", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta.const_mul_right", "description": "**Alias** of the reverse direction of `asymptotics.is_Theta_const_mul_right`.", "p": "mathlib"}, {"name": "asymptotics.is_Theta.pow", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta_of_norm_eventually_eq'", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta.of_norm_left", "description": "**Alias** of the forward direction of `asymptotics.is_Theta_norm_left`.", "p": "mathlib"}, {"name": "asymptotics.is_Theta.of_norm_right", "description": "**Alias** of the forward direction of `asymptotics.is_Theta_norm_right`.", "p": "mathlib"}, {"name": "asymptotics.is_Theta_const_const", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_o.trans_is_Theta", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta.const_smul_right", "description": "**Alias** of the reverse direction of `asymptotics.is_Theta_const_smul_right`.", "p": "mathlib"}, {"name": "asymptotics.is_Theta.smul", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta.const_smul_left", "description": "**Alias** of the reverse direction of `asymptotics.is_Theta_const_smul_left`.", "p": "mathlib"}, {"name": "filter.eventually_eq.trans_is_Theta", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta.trans_is_o", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta_of_norm_eventually_eq", "description": "", "p": "mathlib"}, {"name": "asymptotics.is_Theta_zero_left", "d