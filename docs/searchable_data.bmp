rs_monomial_single", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degree_of_mul_le", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.eval\u2082_hom_eq_constant_coeff_of_vars", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees_rename_of_injective", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.total_degree_multiset_prod", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.total_degree_list_prod", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.total_degree_rename_le", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees_monomial", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees_zero", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degree_of", "description": "`degree_of n p` gives the highest power of X_n that appears in `p`", "p": "mathlib"}, {"name": "mv_polynomial.vars_eq_support_bUnion_support", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.vars_rename", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.total_degree_add_eq_right_of_total_degree_lt", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.vars_mul", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.total_degree_finset_sum", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees_one", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.total_degree_one", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees_prod", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.mem_vars", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.vars_prod", "description": "The variables of the product of a family of polynomials\nare a subset of the union of the sets of variables of each polynomial.", "p": "mathlib"}, {"name": "mv_polynomial.total_degree_monomial", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees_def", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degree_of_zero", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.total_degree_add_eq_left_of_total_degree_lt", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees", "description": "The maximal degrees of each variable in a multi-variable polynomial, expressed as a multiset.\n\n(For example, `degrees (x^2 * y + y^3)` would be `{x, x, y, y, y}`.)", "p": "mathlib"}, {"name": "mv_polynomial.hom_congr_vars", "description": "If `f\u2081` and `f\u2082` are ring homs out of the polynomial ring and `p\u2081` and `p\u2082` are polynomials,\n then `f\u2081 p\u2081 = f\u2082 p\u2082` if `p\u2081 = p\u2082` and `f\u2081` and `f\u2082` are equal on `R` and on the variables\n of `p\u2081`.", "p": "mathlib"}, {"name": "mv_polynomial.degrees_add_of_disjoint", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.vars_add_subset", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.vars_C", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees_add", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.vars_0", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.vars_add_of_disjoint", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.eval\u2082_hom_congr'", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.vars_one", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degree_of_add_le", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.degrees_C", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.vars_monomial", "description": "", "p": "mathlib"}, {"name": "Module.filtered_colimits.colimit", "description": "The bundled `R`-module giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "Module.filtered_colimits.M.mk_eq", "description": "", "p": "mathlib"}, {"name": "Module.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `Module R`.", "p": "mathlib"}, {"name": "Module.filtered_colimits.M", "description": "The colimit of `F \u22d9 forget\u2082 (Module R) AddCommGroup` in the category `AddCommGroup`.\nIn the following, we will show that this has the structure of an `R`-module.", "p": "mathlib"}, {"name": "Module.filtered_colimits.colimit_smul_aux_eq_of_rel", "description": "", "p": "mathlib"}, {"name": "Module.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "Module.filtered_colimits.colimit_smul_aux", "description": "The \"unlifted\" version of scalar multiplication in the colimit.", "p": "mathlib"}, {"name": "Module.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit module.", "p": "mathlib"}, {"name": "Module.filtered_colimits.colimit_desc", "description": "Given a cocone `t` of `F`, the induced monoid linear map from the colimit to the cocone point.\nWe already know that this is a morphism between additive groups. The only thing left to see is that\nit is a linear map, i.e. preserves scalar multiplication.", "p": "mathlib"}, {"name": "Module.filtered_colimits.colimit_smul_mk_eq", "description": "", "p": "mathlib"}, {"name": "Module.filtered_colimits.forget\u2082_AddCommGroup_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "Module.filtered_colimits.colimit_has_smul", "description": "Scalar multiplication in the colimit. See also `colimit_smul_aux`.", "p": "mathlib"}, {"name": "Module.filtered_colimits.M.mk", "description": "The canonical projection into the colimit, as a quotient type.", "p": "mathlib"}, {"name": "Module.filtered_colimits.cocone_morphism", "description": "The linear map from a given `R`-module in the diagram to the colimit module.", "p": "mathlib"}, {"name": "Module.filtered_colimits.colimit_module", "description": "", "p": "mathlib"}, {"name": "dlist.to_list_empty", "description": "", "p": "core"}, {"name": "dlist.to_list_concat", "description": "", "p": "core"}, {"name": "dlist.to_list_cons", "description": "", "p": "core"}, {"name": "dlist.of_list_to_list", "description": "", "p": "core"}, {"name": "dlist.concat", "description": "`O(1)` Append a single element to a dlist", "p": "core"}, {"name": "dlist.lazy_of_list", "description": "Convert a lazily-evaluated list to a dlist", "p": "core"}, {"name": "dlist.to_list_append", "description": "", "p": "core"}, {"name": "dlist.cons", "description": "`O(1)` Prepend a single element to a dlist", "p": "core"}, {"name": "dlist.empty", "description": "Create a dlist containing no elements", "p": "core"}, {"name": "dlist.singleton", "description": "Create dlist with a single element", "p": "core"}, {"name": "dlist.to_list", "description": "Convert a dlist to a list", "p": "core"}, {"name": "dlist.has_append", "description": "", "p": "core"}, {"name": "dlist.to_list_of_list", "description": "", "p": "core"}, {"name": "dlist.append", "description": "`O(1)` Append dlists", "p": "core"}, {"name": "dlist.of_list", "description": "Convert a list to a dlist", "p": "core"}, {"name": "dlist", "description": "A difference list is a function that, given a list, returns the original\ncontents of the difference list prepended to the given list.\n\nThis structure supports `O(1)` `append` and `concat` operations on lists, making it\nuseful for append-heavy uses such as logging and pretty printing.", "p": "core"}, {"name": "dlist.apply", "description": "A difference list is a function that, given a list, returns the original\ncontents of the difference list prepended to the given list.\n\nThis structure supports `O(1)` `append` and `concat` operations on lists, making it\nuseful for append-heavy uses such as logging and pretty printing.", "p": "core"}, {"name": "dlist.invariant", "description": "A difference list is a function that, given a list, returns the original\ncontents of the difference list prepended to the given list.\n\nThis structure supports `O(1)` `append` and `concat` operations on lists, making it\nuseful for append-heavy uses such as logging and pretty printing.", "p": "core"}, {"name": "dlist.to_list_singleton", "description": "", "p": "core"}, {"name": "lists.mem.decidable", "description": "", "p": "mathlib"}, {"name": "lists.to_list", "description": "Converts a ZFA list to a `list` of ZFA lists. Atoms are sent to `[]`.", "p": "mathlib"}, {"name": "lists'.has_subset", "description": "", "p": "mathlib"}, {"name": "lists'.cons_subset", "description": "", "p": "mathlib"}, {"name": "lists.mem", "description": " Membership of ZFA list. A ZFA list belongs to a proper ZFA list if it belongs to the latter as a\nproper ZFA prelist. An atom has no members.", "p": "mathlib"}, {"name": "lists'.to_list", "description": "Converts a ZFA prelist to a `list` of ZFA lists. Atoms are sent to `[]`.", "p": "mathlib"}, {"name": "lists.lt_sizeof_cons'", "description": "", "p": "mathlib"}, {"name": "lists'.mem_def", "description": "", "p": "mathlib"}, {"name": "lists.to_of_list", "description": "", "p": "mathlib"}, {"name": "lists", "description": " Hereditarily finite list, aka ZFA list. A ZFA list is either an \"atom\" (`b = ff`), corresponding\nto an element of `\u03b1`, or a \"proper\" ZFA list, inductively defined from the empty ZFA list and from\nappending a ZFA list to a proper ZFA list.", "p": "mathlib"}, {"name": "lists'.inhabited", "description": "", "p": "mathlib"}, {"name": "lists.of'", "description": "Converts a proper ZFA prelist to a ZFA list.", "p": "mathlib"}, {"name": "lists.inhabited", "description": "", "p": "mathlib"}, {"name": "lists'.mem_of_subset'", "description": "", "p": "mathlib"}, {"name": "lists.setoid", "description": "", "p": "mathlib"}, {"name": "lists.equiv_atom", "description": "", "p": "mathlib"}, {"name": "lists'.subset_def", "description": "", "p": "mathlib"}, {"name": "finsets", "description": "", "p": "mathlib"}, {"name": "lists'.mem_cons", "description": "", "p": "mathlib"}, {"name": "lists.decidable_eq", "description": "", "p": "mathlib"}, {"name": "lists'.to_list_cons", "description": "", "p": "mathlib"}, {"name": "lists'.mem_of_subset", "description": "", "p": "mathlib"}, {"name": "lists'.cons", "description": "Appending a ZFA list to a proper ZFA prelist.", "p": "mathlib"}, {"name": "lists.atom", "description": "Sends `a : \u03b1` to the corresponding atom in `lists \u03b1`.", "p": "mathlib"}, {"name": "lists.is_list", "description": "Predicate stating that a ZFA list is proper.", "p": "mathlib"}, {"name": "lists.induction_mut", "description": "A recursion principle for pairs of ZFA lists and proper ZFA prelists.", "p": "mathlib"}, {"name": "lists.subset.decidable", "description": "", "p": "mathlib"}, {"name": "lists'.of_list_subset", "description": "", "p": "mathlib"}, {"name": "lists'.decidable_eq", "description": "", "p": "mathlib"}, {"name": "lists.has_mem", "description": "", "p": "mathlib"}, {"name": "lists'.to_of_list", "description": "", "p": "mathlib"}, {"name": "lists'.has_mem", "description": " ZFA prelist membership. A ZFA list is in a ZFA prelist if some element of this ZFA prelist is\nequivalent as a ZFA list to this ZFA list.", "p": "mathlib"}, {"name": "finsets.decidable_eq", "description": "", "p": "mathlib"}, {"name": "finsets.inhabited", "description": "", "p": "mathlib"}, {"name": "lists.of_list", "description": "Converts a `list` of ZFA lists to a ZFA list.", "p": "mathlib"}, {"name": "lists.sizeof_pos", "description": "", "p": "mathlib"}, {"name": "finsets.has_emptyc", "description": "", "p": "mathlib"}, {"name": "lists'.of_to_list", "description": "", "p": "mathlib"}, {"name": "lists.is_list_to_list", "description": "", "p": "mathlib"}, {"name": "lists.of_to_list", "description": "", "p": "mathlib"}, {"name": "lists'.subset_nil", "description": "", "p": "mathlib"}, {"name": "lists'.mem_equiv_left", "description": "", "p": "mathlib"}, {"name": "lists'.of_list", "description": "Converts a `list` of ZFA lists to a proper ZFA prelist.", "p": "mathlib"}, {"name": "lists'", "description": " Prelists, helper type to define `lists`. `lists' \u03b1 ff` are the \"atoms\", a copy of `\u03b1`.\n`lists' \u03b1 tt` are the \"proper\" ZFA prelists, inductively defined from the empty ZFA prelist and from\nappending a ZFA prelist to a proper ZFA prelist. It is made so that you can't append anything to an\natom while having only one appending function for appending both atoms and proper ZFC prelists to a\nproper ZFA prelist.", "p": "mathlib"}, {"name": "lists'.atom", "description": " Prelists, helper type to define `lists`. `lists' \u03b1 ff` are the \"atoms\", a copy of `\u03b1`.\n`lists' \u03b1 tt` are the \"proper\" ZFA prelists, inductively defined from the empty ZFA prelist and from\nappending a ZFA prelist to a proper ZFA prelist. It is made so that you can't append anything to an\natom while having only one appending function for appending both atoms and proper ZFC prelists to a\nproper ZFA prelist.", "p": "mathlib"}, {"name": "lists'.nil", "description": " Prelists, helper type to define `lists`. `lists' \u03b1 ff` are the \"atoms\", a copy of `\u03b1`.\n`lists' \u03b1 tt` are the \"proper\" ZFA prelists, inductively defined from the empty ZFA prelist and from\nappending a ZFA prelist to a proper ZFA prelist. It is made so that you can't append anything to an\natom while having only one appending function for appending both atoms and proper ZFC prelists to a\nproper ZFA prelist.", "p": "mathlib"}, {"name": "lists'.cons'", "description": " Prelists, helper type to define `lists`. `lists' \u03b1 ff` are the \"atoms\", a copy of `\u03b1`.\n`lists' \u03b1 tt` are the \"proper\" ZFA prelists, inductively defined from the empty ZFA prelist and from\nappending a ZFA prelist to a proper ZFA prelist. It is made so that you can't append anything to an\natom while having only one appending function for appending both atoms and proper ZFC prelists to a\nproper ZFA prelist.", "p": "mathlib"}, {"name": "lists.has_sizeof", "description": "", "p": "mathlib"}, {"name": "lists.is_list_of_mem", "description": "", "p": "mathlib"}, {"name": "bernoulli'_eq_bernoulli", "description": "", "p": "mathlib"}, {"name": "bernoulli", "description": "The Bernoulli numbers are defined to be `bernoulli'` with a parity sign.", "p": "mathlib"}, {"name": "bernoulli_one", "description": "", "p": "mathlib"}, {"name": "bernoulli_power_series", "description": "The exponential generating function for the Bernoulli numbers `bernoulli n`.", "p": "mathlib"}, {"name": "bernoulli_spec'", "description": "", "p": "mathlib"}, {"name": "sum_bernoulli", "description": "", "p": "mathlib"}, {"name": "bernoulli'_one", "description": "", "p": "mathlib"}, {"name": "bernoulli'_spec", "description": "", "p": "mathlib"}, {"name": "bernoulli'_zero", "description": "", "p": "mathlib"}, {"name": "sum_Ico_pow", "description": " Alternate form of **Faulhaber's theorem**, relating the sum of p-th powers to the Bernoulli\nnumbers: $$\\sum_{k=1}^{n} k^p = \\sum_{i=0}^p (-1)^iB_i\\binom{p+1}{i}\\frac{n^{p+1-i}}{p+1}.$$\nDeduced from `sum_range_pow`.", "p": "mathlib"}, {"name": "bernoulli_eq_bernoulli'_of_ne_one", "description": "", "p": "mathlib"}, {"name": "sum_bernoulli'", "description": "", "p": "mathlib"}, {"name": "bernoulli'_def", "description": "", "p": "mathlib"}, {"name": "bernoulli'_power_series", "description": "The exponential generating function for the Bernoulli numbers `bernoulli' n`.", "p": "mathlib"}, {"name": "bernoulli_zero", "description": "", "p": "mathlib"}, {"name": "bernoulli'_four", "description": "", "p": "mathlib"}, {"name": "bernoulli'", "description": " The Bernoulli numbers:\nthe $n$-th Bernoulli number $B_n$ is defined recursively via\n$$B_n = 1 - \\sum_{k < n} \\binom{n}{k}\\frac{B_k}{n+1-k}$$", "p": "mathlib"}, {"name": "bernoulli'_spec'", "description": "", "p": "mathlib"}, {"name": "bernoulli'_def'", "description": "", "p": "mathlib"}, {"name": "bernoulli'_odd_eq_zero", "description": "Odd Bernoulli numbers (greater than 1) are zero.", "p": "mathlib"}, {"name": "sum_range_pow", "description": " **Faulhaber's theorem** relating the **sum of of p-th powers** to the Bernoulli numbers:\n$$\\sum_{k=0}^{n-1} k^p = \\sum_{i=0}^p B_i\\binom{p+1}{i}\\frac{n^{p+1-i}}{p+1}.$$\nSee https://proofwiki.org/wiki/Faulhaber%27s_Formula and [orosi2018faulhaber] for\nthe proof provided here.", "p": "mathlib"}, {"name": "bernoulli_power_series_mul_exp_sub_one", "description": "", "p": "mathlib"}, {"name": "bernoulli'_power_series_mul_exp_sub_one", "description": "", "p": "mathlib"}, {"name": "bernoulli'_three", "description": "", "p": "mathlib"}, {"name": "bernoulli'_two", "description": "", "p": "mathlib"}, {"name": "polynomial.cyclotomic_irreducible_of_irreducible_pow", "description": "If `irreducible (cyclotomic (p ^ n) R)` then `irreducible (cyclotomic p R).`", "p": "mathlib"}, {"name": "polynomial.cyclotomic_expand_eq_cyclotomic_mul", "description": " If `p` is a prime such that `\u00ac p \u2223 n`, then\n`expand R p (cyclotomic n R) = (cyclotomic (n * p) R) * (cyclotomic n R)`.", "p": "mathlib"}, {"name": "polynomial.cyclotomic_expand_eq_cyclotomic", "description": " If `p` is a prime such that `p \u2223 n`, then\n`expand R p (cyclotomic n R) = cyclotomic (p * n) R`.", "p": "mathlib"}, {"name": "polynomial.cyclotomic_mul_prime_pow_eq", "description": " If `R` is of characteristic `p` and `\u00acp \u2223 m`, then\n`cyclotomic (p ^ k * m) R = (cyclotomic m R) ^ (p ^ k - p ^ (k - 1))`.", "p": "mathlib"}, {"name": "polynomial.is_root_cyclotomic_prime_pow_mul_iff_of_char_p", "description": "If `R` is of characteristic `p` and `\u00acp \u2223 m`, then `\u03b6` is a root of `cyclotomic (p ^ k * m) R`\nif and only if it is a primitive `m`-th root of unity.", "p": "mathlib"}, {"name": "polynomial.cyclotomic_mul_prime_eq_pow_of_not_dvd", "description": " If `R` is of characteristic `p` and `\u00acp \u2223 n`, then\n`cyclotomic (n * p) R = (cyclotomic n R) ^ (p - 1)`.", "p": "mathlib"}, {"name": "polynomial.cyclotomic_mul_prime_dvd_eq_pow", "description": " If `R` is of characteristic `p` and `p \u2223 n`, then\n`cyclotomic (n * p) R = (cyclotomic n R) ^ p`.", "p": "mathlib"}, {"name": "polynomial.cyclotomic_irreducible_pow_of_irreducible_pow", "description": "If the `p ^ n`th cyclotomic polynomial is irreducible, so is the `p ^ m`th, for `m \u2264 n`.", "p": "mathlib"}, {"name": "complex.Gamma_seq_mul", "description": "", "p": "mathlib"}, {"name": "complex.beta_integral", "description": "The Beta function `\u0392 (u, v)`, defined as `\u222b x:\u211d in 0..1, x ^ (u - 1) * (1 - x) ^ (v - 1)`.", "p": "mathlib"}, {"name": "complex.beta_integral_convergent_left", "description": "Auxiliary lemma for `beta_integral_convergent`, showing convergence at the left endpoint.", "p": "mathlib"}, {"name": "real.Gamma_mul_Gamma_add_half", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_ne_zero", "description": " The Gamma function does not vanish on `\u2102` (except at non-positive integers, where the function\nis mathematically undefined and we set it to `0` by convention).", "p": "mathlib"}, {"name": "complex.differentiable_one_div_Gamma", "description": " The reciprocal of the Gamma function is differentiable everywhere (including the points where\nGamma itself is not).", "p": "mathlib"}, {"name": "complex.Gamma_seq_tendsto_Gamma", "description": "Euler's limit formula for the complex Gamma function.", "p": "mathlib"}, {"name": "complex.Gamma_seq_eq_approx_Gamma_integral", "description": "", "p": "mathlib"}, {"name": "complex.beta_integral_convergent", "description": "The Beta integral is convergent for all `u, v` of positive real part.", "p": "mathlib"}, {"name": "complex.approx_Gamma_integral_tendsto_Gamma_integral", "description": " The main techical lemma for `Gamma_seq_tendsto_Gamma`, expressing the integral defining the\nGamma function for `0 < re s` as the limit of a sequence of integrals over finite intervals.", "p": "mathlib"}, {"name": "complex.beta_integral_eval_one_right", "description": "", "p": "mathlib"}, {"name": "complex.beta_integral_recurrence", "description": "Recurrence formula for the Beta function.", "p": "mathlib"}, {"name": "complex.Gamma_seq_eq_beta_integral_of_re_pos", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_mul_Gamma_one_sub", "description": "Euler's reflection formula for the complex Gamma function.", "p": "mathlib"}, {"name": "real.Gamma_seq_tendsto_Gamma", "description": "Euler's limit formula for the real Gamma function.", "p": "mathlib"}, {"name": "complex.Gamma_mul_Gamma_add_half", "description": "", "p": "mathlib"}, {"name": "complex.beta_integral_symm", "description": "", "p": "mathlib"}, {"name": "complex.beta_integral_eval_nat_add_one_right", "description": "Explicit formula for the Beta function when second argument is a positive integer.", "p": "mathlib"}, {"name": "complex.Gamma_mul_Gamma_eq_beta_integral", "description": "Relation between Beta integral and Gamma function.", "p": "mathlib"}, {"name": "real.Gamma_mul_Gamma_one_sub", "description": "Euler's reflection formula for the real Gamma function.", "p": "mathlib"}, {"name": "real.Gamma_seq", "description": " The sequence with `n`-th term `n ^ s * n! / (s * (s + 1) * ... * (s + n))`, for real `s`. We\nwill show that this tends to `\u0393(s)` as `n \u2192 \u221e`.", "p": "mathlib"}, {"name": "complex.beta_integral_scaled", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_seq_add_one_left", "description": "", "p": "mathlib"}, {"name": "complex.one_div_Gamma_eq_self_mul_one_div_Gamma_add_one", "description": "A reformulation of the Gamma recurrence relation which is true for `s = 0` as well.", "p": "mathlib"}, {"name": "complex.Gamma_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_seq", "description": " The sequence with `n`-th term `n ^ s * n! / (s * (s + 1) * ... * (s + n))`, for complex `s`.\nWe will show that this tends to `\u0393(s)` as `n \u2192 \u221e`.", "p": "mathlib"}, {"name": "complex.Gamma_ne_zero_of_re_pos", "description": "A weaker, but easier-to-apply, version of `complex.Gamma_ne_zero`.", "p": "mathlib"}, {"name": "localization.subalgebra.is_localization_subalgebra", "description": "", "p": "mathlib"}, {"name": "localization.is_fraction_ring_range_map_to_fraction_ring", "description": "", "p": "mathlib"}, {"name": "localization.subalgebra", "description": "Given a commutative ring `A` with fraction ring `K`, and a submonoid `S` of `A` which\ncontains no zero divisor, this is the localization of `A` at `S`, considered as\na subalgebra of `K` over `A`.\n\nThe carrier of this subalgebra is defined as the set of all `x : K` of the form\n`is_localization.mk' K a \u27e8s, _\u27e9`, where `s \u2208 S`.", "p": "mathlib"}, {"name": "localization.subalgebra.is_fraction_ring_of_field", "description": "", "p": "mathlib"}, {"name": "localization.subalgebra.of_field", "description": "Given a domain `A` with fraction field `K`, and a submonoid `S` of `A` which\ncontains no zero divisor, this is the localization of `A` at `S`, considered as\na subalgebra of `K` over `A`.\n\nThe carrier of this subalgebra is defined as the set of all `x : K` of the form\n`algebra_map A K a * (algebra_map A K s)\u207b\u00b9` where `a s : A` and `s \u2208 S`.", "p": "mathlib"}, {"name": "localization.is_localization_range_map_to_fraction_ring", "description": "", "p": "mathlib"}, {"name": "localization.subalgebra.mem_range_map_to_fraction_ring_iff_of_field", "description": "", "p": "mathlib"}, {"name": "localization.subalgebra.is_localization_of_field", "description": "", "p": "mathlib"}, {"name": "localization.map_to_fraction_ring", "description": "The canonical map from a localization of `A` at `S` to the fraction ring\n of `A`, given that `S \u2264 A\u2070`.", "p": "mathlib"}, {"name": "localization.map_to_fraction_ring_apply", "description": "", "p": "mathlib"}, {"name": "localization.subalgebra.is_fraction_ring", "description": "", "p": "mathlib"}, {"name": "localization.map_is_unit_of_le", "description": "", "p": "mathlib"}, {"name": "localization.mem_range_map_to_fraction_ring_iff", "description": "", "p": "mathlib"}, {"name": "zmod.eq_zero_iff_even", "description": "", "p": "mathlib"}, {"name": "zmod.ne_zero_iff_odd", "description": "", "p": "mathlib"}, {"name": "zmod.eq_one_iff_odd", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ico_zsmul", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioc_mul_zpow", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioc_add_int_cast", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioo_add_int_cast", "description": "", "p": "mathlib"}, {"name": "set.inv_mem_Ioo_iff", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioc_zpow", "description": "", "p": "mathlib"}, {"name": "set.add_mem_Ioo_iff_left", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioo_add_zsmul", "description": "", "p": "mathlib"}, {"name": "set.neg_mem_Ico_iff", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ico_mul_zpow", "description": "", "p": "mathlib"}, {"name": "set.add_mem_Ioc_iff_left", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioo_zpow", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioo_zsmul", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ico_zpow", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioo_mul_zpow", "description": "", "p": "mathlib"}, {"name": "set.sub_mem_Icc_iff_left", "description": "", "p": "mathlib"}, {"name": "set.neg_mem_Ioo_iff", "description": "", "p": "mathlib"}, {"name": "set.neg_mem_Icc_iff", "description": "", "p": "mathlib"}, {"name": "set.mem_Icc_iff_abs_le", "description": "", "p": "mathlib"}, {"name": "set.sub_mem_Ioc_iff_right", "description": "", "p": "mathlib"}, {"name": "set.sub_mem_Ioc_iff_left", "description": "", "p": "mathlib"}, {"name": "set.inv_mem_Icc_iff", "description": "", "p": "mathlib"}, {"name": "set.inv_mem_Ico_iff", "description": "", "p": "mathlib"}, {"name": "set.sub_mem_Ico_iff_left", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ico_int_cast", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioc_add_zsmul", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioc_zsmul", "description": "", "p": "mathlib"}, {"name": "set.nonempty_Ico_sdiff", "description": "If we remove a smaller interval from a larger, the result is nonempty", "p": "mathlib"}, {"name": "set.inv_mem_Ioc_iff", "description": "", "p": "mathlib"}, {"name": "set.add_mem_Icc_iff_left", "description": "", "p": "mathlib"}, {"name": "set.neg_mem_Ioc_iff", "description": "", "p": "mathlib"}, {"name": "set.add_mem_Ico_iff_left", "description": "", "p": "mathlib"}, {"name": "set.sub_mem_Ioo_iff_right", "description": "", "p": "mathlib"}, {"name": "set.add_mem_Icc_iff_right", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioo_int_cast", "description": "", "p": "mathlib"}, {"name": "set.sub_mem_Ioo_iff_left", "description": "", "p": "mathlib"}, {"name": "set.add_mem_Ico_iff_right", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ioc_int_cast", "description": "", "p": "mathlib"}, {"name": "set.sub_mem_Icc_iff_right", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ico_add_int_cast", "description": "", "p": "mathlib"}, {"name": "set.sub_mem_Ico_iff_right", "description": "", "p": "mathlib"}, {"name": "set.add_mem_Ioc_iff_right", "description": "", "p": "mathlib"}, {"name": "set.pairwise_disjoint_Ico_add_zsmul", "description": "", "p": "mathlib"}, {"name": "set.add_mem_Ioo_iff_right", "description": "", "p": "mathlib"}, {"name": "add_left_embedding", "description": "The embedding of a left cancellative additive semigroup into itself\n   by left translation by a fixed element.", "p": "mathlib"}, {"name": "add_right_embedding_apply", "description": "", "p": "mathlib"}, {"name": "mul_right_embedding", "description": "The embedding of a right cancellative semigroup into itself\nby right multiplication by a fixed element.", "p": "mathlib"}, {"name": "mul_left_embedding", "description": "The embedding of a left cancellative semigroup into itself\nby left multiplication by a fixed element.", "p": "mathlib"}, {"name": "add_right_embedding", "description": "The embedding of a right cancellative additive semigroup into itself\n   by right translation by a fixed element.", "p": "mathlib"}, {"name": "mul_right_embedding_apply", "description": "", "p": "mathlib"}, {"name": "mul_left_embedding_eq_mul_right_embedding", "description": "", "p": "mathlib"}, {"name": "add_left_embedding_apply", "description": "", "p": "mathlib"}, {"name": "add_left_embedding_eq_add_right_embedding", "description": "", "p": "mathlib"}, {"name": "mul_left_embedding_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.is_preconnected", "description": "A possibly empty category for which every functor to a discrete category is constant.", "p": "mathlib"}, {"name": "category_theory.is_preconnected.iso_constant", "description": "A possibly empty category for which every functor to a discrete category is constant.", "p": "mathlib"}, {"name": "category_theory.zag", "description": "j\u2081 and j\u2082 are related by `zag` if there is a morphism between them.", "p": "mathlib"}, {"name": "category_theory.zag_symmetric", "description": "", "p": "mathlib"}, {"name": "category_theory.nat_trans_from_is_connected", "description": "For objects `X Y : C`, any natural transformation `\u03b1 : const X \u27f6 const Y` from a connected\ncategory must be constant.\nThis is the key property of connected categories which we use to establish properties about limits.", "p": "mathlib"}, {"name": "category_theory.any_functor_const_on_obj", "description": "If J is connected, any functor to a discrete category is constant on objects.\nThe converse is given in `is_connected.of_any_functor_const_on_obj`.", "p": "mathlib"}, {"name": "category_theory.is_connected", "description": "We define a connected category as a _nonempty_ category for which every\nfunctor to a discrete category is constant.\n\nNB. Some authors include the empty category as connected, we do not.\nWe instead are interested in categories with exactly one 'connected\ncomponent'.\n\nThis allows us to show that the functor X \u2a2f - preserves connected limits.\n\nSee <https://stacks.math.columbia.edu/tag/002S>", "p": "mathlib"}, {"name": "category_theory.is_connected.to_is_preconnected", "description": "We define a connected category as a _nonempty_ category for which every\nfunctor to a discrete category is constant.\n\nNB. Some authors include the empty category as connected, we do not.\nWe instead are interested in categories with exactly one 'connected\ncomponent'.\n\nThis allows us to show that the functor X \u2a2f - preserves connected limits.\n\nSee <https://stacks.math.columbia.edu/tag/002S>", "p": "mathlib"}, {"name": "category_theory.is_connected.is_nonempty", "description": "We define a connected category as a _nonempty_ category for which every\nfunctor to a discrete category is constant.\n\nNB. Some authors include the empty category as connected, we do not.\nWe instead are interested in categories with exactly one 'connected\ncomponent'.\n\nThis allows us to show that the functor X \u2a2f - preserves connected limits.\n\nSee <https://stacks.math.columbia.edu/tag/002S>", "p": "mathlib"}, {"name": "category_theory.zigzag.setoid", "description": "The setoid given by the equivalence relation `zigzag`. A quotient for this\nsetoid is a connected component of the category.", "p": "mathlib"}, {"name": "category_theory.zigzag_is_connected", "description": "If any two objects in an nonempty category are related by `zigzag`, the category is connected.", "p": "mathlib"}, {"name": "category_theory.is_preconnected_op", "description": "If `J` is preconnected, then `J\u1d52\u1d56` is preconnected as well.", "p": "mathlib"}, {"name": "category_theory.iso_constant", "description": "If `J` is connected, any functor `F : J \u2964 discrete \u03b1` is isomorphic to\nthe constant functor with value `F.obj j` (for any choice of `j`).", "p": "mathlib"}, {"name": "category_theory.functor.const.full", "description": "", "p": "mathlib"}, {"name": "category_theory.is_connected.of_constant_of_preserves_morphisms", "description": "`J` is connected if: given any function `F : J \u2192 \u03b1` which is constant for any\n`j\u2081, j\u2082` for which there is a morphism `j\u2081 \u27f6 j\u2082`, then `F` is constant.\nThis can be thought of as a local-to-global property.\n\nThe converse of `constant_of_preserves_morphisms`.", "p": "mathlib"}, {"name": "category_theory.equiv_relation", "description": "Any equivalence relation containing (\u27f6) holds for all pairs of a connected category.", "p": "mathlib"}, {"name": "category_theory.ulift_hom.is_connected", "description": "Lifting the universe level of morphisms and objects preserves connectedness.", "p": "mathlib"}, {"name": "category_theory.is_preconnected_of_equivalent", "description": "If `J` and `K` are equivalent, then if `J` is preconnected then `K` is as well.", "p": "mathlib"}, {"name": "category_theory.discrete_is_connected_equiv_punit", "description": "If `discrete \u03b1` is connected, then `\u03b1` is (type-)equivalent to `punit`.", "p": "mathlib"}, {"name": "category_theory.is_connected_of_equivalent", "description": "If `J` and `K` are equivalent, then if `J` is connected then `K` is as well.", "p": "mathlib"}, {"name": "category_theory.zigzag_symmetric", "description": "", "p": "mathlib"}, {"name": "category_theory.is_preconnected_of_is_preconnected_op", "description": "", "p": "mathlib"}, {"name": "category_theory.is_connected_op", "description": "If `J` is connected, then `J\u1d52\u1d56` is connected as well.", "p": "mathlib"}, {"name": "category_theory.exists_zigzag'", "description": "", "p": "mathlib"}, {"name": "category_theory.is_connected.of_induct", "description": "If any maximal connected component containing some element j\u2080 of J is all of J, then J is connected.\n\nThe converse of `induct_on_objects`.", "p": "mathlib"}, {"name": "category_theory.constant_of_preserves_morphisms", "description": "If `J` is connected, then given any function `F` such that the presence of a\nmorphism `j\u2081 \u27f6 j\u2082` implies `F j\u2081 = F j\u2082`, we have that `F` is constant.\nThis can be thought of as a local-to-global property.\n\nThe converse is shown in `is_connected.of_constant_of_preserves_morphisms`", "p": "mathlib"}, {"name": "category_theory.zigzag_obj_of_zigzag", "description": "If there is a zigzag from `j\u2081` to `j\u2082`, then there is a zigzag from `F j\u2081` to\n`F j\u2082` as long as `F` is a functor.", "p": "mathlib"}, {"name": "category_theory.zag_of_zag_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.is_connected_zigzag", "description": "In a connected category, any two objects are related by `zigzag`.", "p": "mathlib"}, {"name": "category_theory.is_connected_of_is_connected_op", "description": "", "p": "mathlib"}, {"name": "category_theory.is_connected_of_zigzag", "description": "If any two objects in an nonempty category are linked by a sequence of (potentially reversed)\nmorphisms, then J is connected.\n\nThe converse of `exists_zigzag'`.", "p": "mathlib"}, {"name": "category_theory.is_preconnected_induction", "description": "Another induction principle for `is_preconnected J`:\ngiven a type family `Z : J \u2192 Sort*` and\na rule for transporting in *both* directions along a morphism in `J`,\nwe can transport an `x : Z j\u2080` to a point in `Z j` for any `j`.", "p": "mathlib"}, {"name": "category_theory.is_connected.of_any_functor_const_on_obj", "description": "If any functor to a discrete category is constant on objects, J is connected.\nThe converse of `any_functor_const_on_obj`.", "p": "mathlib"}, {"name": "category_theory.induct_on_objects", "description": "An inductive-like property for the objects of a connected category.\nIf the set `p` is nonempty, and `p` is closed under morphisms of `J`,\nthen `p` contains all of `J`.\n\nThe converse is given in `is_connected.of_induct`.", "p": "mathlib"}, {"name": "category_theory.zigzag_equivalence", "description": "", "p": "mathlib"}, {"name": "category_theory.zigzag", "description": "`j\u2081` and `j\u2082` are related by `zigzag` if there is a chain of\nmorphisms from `j\u2081` to `j\u2082`, with backward morphisms allowed.", "p": "mathlib"}, {"name": "category_theory.nonempty_hom_of_connected_groupoid", "description": "", "p": "mathlib"}, {"name": "tactic.extract_category", "description": "From an expression `f = g`,\nwhere `f g : X \u27f6 Y` for some objects `X Y : V` with `[S : category V]`,\nextract the expression for `S`.", "p": "mathlib"}, {"name": "tactic.elementwise_lemma", "description": " (implementation for `@[elementwise]`)\nGiven a declaration named `n` of the form `\u2200 ..., f = g`, proves a new lemma named `n'`\nof the form `\u2200 ... [concrete_category V] (x : X), f x = g x`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.category_theory.elementwise_of", "description": "With `w : \u2200 ..., f \u226b g = h` (with universal quantifiers tolerated),\n`elementwise_of w : \u2200 ... (x : X), g (f x) = h x`.\n\nAlthough `elementwise_of` is not a tactic or a meta program, its type is generated\nthrough meta-programming to make it usable inside normal expressions.", "p": "mathlib"}, {"name": "tactic.prove_elementwise", "description": " (internals for `@[elementwise]`)\nGiven a lemma of the form `f = g`, where `f g : X \u27f6 Y` and `X Y : V`,\nproves a new lemma of the form\n`\u2200 (x : X), f x = g x`\nif we are already in a concrete category, or\n`\u2200 [concrete_category.{w} V] (x : X), f x = g x`\notherwise.\n\nReturns the type and proof of this lemma,\nand the universe parameter `w` for the `concrete_category` instance, if it was not synthesized.", "p": "mathlib"}, {"name": "tactic_doc.attribute.elementwise", "description": "The `elementwise` attribute can be applied to a lemma\n\n```lean\n@[elementwise]\nlemma some_lemma {C : Type*} [category C]\n  {X Y Z : C} (f : X \u27f6 Y) (g : Y \u27f6 Z) (h : X \u27f6 Z) (w : ...) : f \u226b g = h := ...\n```\n\nand will produce\n\n```lean\nlemma some_lemma_apply {C : Type*} [category C] [concrete_category C]\n  {X Y Z : C} (f : X \u27f6 Y) (g : Y \u27f6 Z) (h : X \u27f6 Z) (w : ...) (x : X) : g (f x) = h x := ...\n```\n\nHere `X` is being coerced to a type via `concrete_category.has_coe_to_sort` and\n`f`, `g`, and `h` are being coerced to functions via `concrete_category.has_coe_to_fun`.\nFurther, we simplify the type using `concrete_category.coe_id : ((\ud835\udfd9 X) : X \u2192 X) x = x` and\n`concrete_category.coe_comp : (f \u226b g) x = g (f x)`,\nreplacing morphism composition with function composition.\n\nThe `[concrete_category C]` argument will be omitted if it is possible to synthesize an instance.\n\nThe name of the produced lemma can be specified with `@[elementwise other_lemma_name]`.\nIf `simp` is added first, the generated lemma will also have the `simp` attribute.", "p": "mathlib"}, {"name": "tactic.interactive.elementwise", "description": "`elementwise h`, for assumption `w : \u2200 ..., f \u226b g = h`, creates a new assumption\n`w : \u2200 ... (x : X), g (f x) = h x`.\n\n`elementwise! h`, does the same but deletes the initial `h` assumption.\n(You can also add the attribute `@[elementwise]` to lemmas to generate new declarations generalized\nin this way.)", "p": "mathlib"}, {"name": "tactic.derive_elementwise_proof", "description": "Auxiliary definition for `category_theory.elementwise_of`.", "p": "mathlib"}, {"name": "category_theory.elementwise_of", "description": "With `w : \u2200 ..., f \u226b g = h` (with universal quantifiers tolerated),\n`elementwise_of w : \u2200 ... (x : X), g (f x) = h x`.\n\nThe type and proof of `elementwise_of h` is generated by `tactic.derive_elementwise_proof`\nwhich makes `elementwise_of` meta-programming adjacent. It is not called as a tactic but as\nan expression. The goal is to avoid creating assumptions that are dismissed after one use:\n\n```lean\nexample (M N K : Mon.{u}) (f : M \u27f6 N) (g : N \u27f6 K) (h : M \u27f6 K) (w : f \u226b g = h) (m : M) :\n  g (f m) = h m :=\nbegin\n  rw elementwise_of w,\nend\n```", "p": "mathlib"}, {"name": "tactic.elementwise_attr", "description": "The `elementwise` attribute can be applied to a lemma\n\n```lean\n@[elementwise]\nlemma some_lemma {C : Type*} [category C]\n  {X Y Z : C} (f : X \u27f6 Y) (g : Y \u27f6 Z) (h : X \u27f6 Z) (w : ...) : f \u226b g = h := ...\n```\n\nand will produce\n\n```lean\nlemma some_lemma_apply {C : Type*} [category C] [concrete_category C]\n  {X Y Z : C} (f : X \u27f6 Y) (g : Y \u27f6 Z) (h : X \u27f6 Z) (w : ...) (x : X) : g (f x) = h x := ...\n```\n\nHere `X` is being coerced to a type via `concrete_category.has_coe_to_sort` and\n`f`, `g`, and `h` are being coerced to functions via `concrete_category.has_coe_to_fun`.\nFurther, we simplify the type using `concrete_category.coe_id : ((\ud835\udfd9 X) : X \u2192 X) x = x` and\n`concrete_category.coe_comp : (f \u226b g) x = g (f x)`,\nreplacing morphism composition with function composition.\n\nThe `[concrete_category C]` argument will be omitted if it is possible to synthesize an instance.\n\nThe name of the produced lemma can be specified with `@[elementwise other_lemma_name]`.\nIf `simp` is added first, the generated lemma will also have the `simp` attribute.", "p": "mathlib"}, {"name": "set.well_founded_on.acc_iff_well_founded_on", "description": "`a` is accessible under the relation `r` iff `r` is well-founded on the downward transitive\n closure of `a` under `r` (including `a` or not).", "p": "mathlib"}, {"name": "set.is_pwo_union", "description": "", "p": "mathlib"}, {"name": "pi.is_pwo", "description": " A version of **Dickson's lemma** any subset of functions `\u03a0 s : \u03c3, \u03b1 s` is partially well\nordered, when `\u03c3` is a `fintype` and each `\u03b1 s` is a linear well order.\nThis includes the classical case of Dickson's lemma that `\u2115 ^ n` is a well partial order.\nSome generalizations would be possible based on this proof, to include cases where the target is\npartially well ordered, and also to consider the case of `set.partially_well_ordered_on` instead of\n`set.is_pwo`.", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.prod", "description": "", "p": "mathlib"}, {"name": "set.finite.well_founded_on", "description": "", "p": "mathlib"}, {"name": "set.is_wf.min_union", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on_union", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on_insert", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on_iff_finite_antichains", "description": "", "p": "mathlib"}, {"name": "set.is_wf.min_le", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.union", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.image_of_monotone_on", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.insert", "description": "", "p": "mathlib"}, {"name": "well_founded.prod_lex_of_well_founded_on_fiber", "description": " Stronger version of `prod.lex_wf`. Instead of requiring `r\u03b2 on g` to be well-founded, we only\nrequire it to be well-founded on fibers of `f`.", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.iff_forall_not_is_bad_seq", "description": "", "p": "mathlib"}, {"name": "set.is_pwo_singleton", "description": "", "p": "mathlib"}, {"name": "finset.is_pwo", "description": "", "p": "mathlib"}, {"name": "set.is_pwo_empty", "description": "", "p": "mathlib"}, {"name": "set.is_pwo.prod", "description": "", "p": "mathlib"}, {"name": "is_antichain.finite_of_partially_well_ordered_on", "description": "", "p": "mathlib"}, {"name": "is_antichain.partially_well_ordered_on_iff", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on.mono'", "description": "", "p": "mathlib"}, {"name": "set.is_pwo.union", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.exists_monotone_subseq", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on.prod_lex_of_well_founded_on_fiber", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on.sigma_lex_of_well_founded_on_fiber", "description": "", "p": "mathlib"}, {"name": "set.is_pwo_of_finite", "description": "", "p": "mathlib"}, {"name": "set.is_wf.le_min_iff", "description": "", "p": "mathlib"}, {"name": "well_founded.sigma_lex_of_well_founded_on_fiber", "description": " Stronger version of `psigma.lex_wf`. Instead of requiring `r\u03c0 on g` to be well-founded, we only\nrequire it to be well-founded on fibers of `f`.", "p": "mathlib"}, {"name": "set.is_pwo.mono", "description": "", "p": "mathlib"}, {"name": "finset.is_pwo_bUnion", "description": "", "p": "mathlib"}, {"name": "set.is_wf_iff_is_pwo", "description": "In a linear order, the predicates `set.is_wf` and `set.is_pwo` are equivalent.", "p": "mathlib"}, {"name": "set.is_strict_order.subset", "description": "", "p": "mathlib"}, {"name": "set.finite.partially_well_ordered_on", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on_iff_exists_monotone_subseq", "description": "", "p": "mathlib"}, {"name": "finset.well_founded_on_sup", "description": "", "p": "mathlib"}, {"name": "set.is_wf.insert", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on.mono", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.mono", "description": "", "p": "mathlib"}, {"name": "set.is_wf", "description": "`s.is_wf` indicates that `<` is well-founded when restricted to `s`.", "p": "mathlib"}, {"name": "set.is_wf_singleton", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on_insert", "description": "", "p": "mathlib"}, {"name": "finset.is_wf", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on_iff", "description": "", "p": "mathlib"}, {"name": "finset.well_founded_on", "description": "", "p": "mathlib"}, {"name": "set.finite.is_pwo", "description": "", "p": "mathlib"}, {"name": "set.finite.is_wf", "description": "", "p": "mathlib"}, {"name": "set.is_pwo.insert", "description": "", "p": "mathlib"}, {"name": "set.is_pwo.exists_monotone_subseq", "description": "", "p": "mathlib"}, {"name": "set.is_wf_empty", "description": "", "p": "mathlib"}, {"name": "finset.is_pwo_sup", "description": "", "p": "mathlib"}, {"name": "set.is_wf.min_le_min_of_subset", "description": "", "p": "mathlib"}, {"name": "finset.is_wf_sup", "description": "", "p": "mathlib"}, {"name": "set.is_pwo_iff_exists_monotone_subseq", "description": "", "p": "mathlib"}, {"name": "set.is_pwo.image_of_monotone_on", "description": "", "p": "mathlib"}, {"name": "set.is_wf_iff_no_descending_seq", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on.insert", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.well_founded_on", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on.subset", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on_empty", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on", "description": "A subset is partially well-ordered by a relation `r` when any infinite sequence contains\n two elements where the first is related to the second by `r`.", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.is_bad_seq", "description": "In the context of partial well-orderings, a bad sequence is a nonincreasing sequence\n whose range is contained in a particular set `s`. One exists if and only if `s` is not\n partially well-ordered.", "p": "mathlib"}, {"name": "set.is_pwo.image_of_monotone", "description": "", "p": "mathlib"}, {"name": "finset.is_wf_bUnion", "description": "", "p": "mathlib"}, {"name": "well_founded.is_wf", "description": "", "p": "mathlib"}, {"name": "set.is_wf.min", "description": "`is_wf.min` returns a minimal element of a nonempty well-founded set.", "p": "mathlib"}, {"name": "set.is_wf.not_lt_min", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on_range", "description": "", "p": "mathlib"}, {"name": "set.subsingleton.is_pwo", "description": "", "p": "mathlib"}, {"name": "set.is_wf.is_pwo", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on_iff_no_descending_seq", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on.union", "description": "", "p": "mathlib"}, {"name": "finset.partially_well_ordered_on_sup", "description": "", "p": "mathlib"}, {"name": "set.subsingleton.is_wf", "description": "", "p": "mathlib"}, {"name": "finset.well_founded_on_bUnion", "description": "", "p": "mathlib"}, {"name": "set.is_wf_min_singleton", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.exists_min_bad_of_exists_bad", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on", "description": "`s.well_founded_on r` indicates that the relation `r` is well-founded when restricted to `s`.", "p": "mathlib"}, {"name": "set.is_wf_univ_iff", "description": "", "p": "mathlib"}, {"name": "set.is_pwo", "description": "A subset of a preorder is partially well-ordered when any infinite sequence contains\n a monotone subsequence of length 2 (or equivalently, an infinite monotone subsequence).", "p": "mathlib"}, {"name": "set.subsingleton.well_founded_on", "description": "", "p": "mathlib"}, {"name": "finset.partially_well_ordered_on", "description": "", "p": "mathlib"}, {"name": "set.is_wf_insert", "description": "", "p": "mathlib"}, {"name": "well_founded.well_founded_on", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on_singleton", "description": "", "p": "mathlib"}, {"name": "finset.partially_well_ordered_on_bUnion", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on_univ", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.min_bad_seq_of_bad_seq", "description": "Given a bad sequence `f`, this constructs a bad sequence that agrees with `f` on the first `n`\n terms and is minimal at `n`.", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.partially_well_ordered_on_sublist_forall\u2082", "description": "Higman's Lemma, which states that for any reflexive, transitive relation `r` which is\n partially well-ordered on a set `s`, the relation `list.sublist_forall\u2082 r` is partially\n well-ordered on the set of lists of elements of `s`. That relation is defined so that\n `list.sublist_forall\u2082 r l\u2081 l\u2082` whenever `l\u2081` related pointwise by `r` to a sublist of `l\u2082`.", "p": "mathlib"}, {"name": "set.is_wf_union", "description": "", "p": "mathlib"}, {"name": "set.is_wf.mono", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.is_min_bad_seq", "description": "This indicates that every bad sequence `g` that agrees with `f` on the first `n`\n terms has `rk (f n) \u2264 rk (g n)`.", "p": "mathlib"}, {"name": "set.well_founded_on_image", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on_empty", "description": "", "p": "mathlib"}, {"name": "set.is_pwo_insert", "description": "", "p": "mathlib"}, {"name": "set.is_pwo.is_wf", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on.induction", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on_singleton", "description": "", "p": "mathlib"}, {"name": "set.is_wf.min_mem", "description": "", "p": "mathlib"}, {"name": "set.partially_well_ordered_on.iff_not_exists_is_min_bad_seq", "description": "", "p": "mathlib"}, {"name": "set.is_wf.union", "description": "", "p": "mathlib"}, {"name": "set.well_founded_on_union", "description": "", "p": "mathlib"}, {"name": "add_comm_group.of_subgroup_on_ring", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_mul_of_apply", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_ring_hom_of", "description": "The canonical ring isomorphism between `\u2a01 i, A i` and `R`", "p": "mathlib"}, {"name": "submodule.set_like.coe_galgebra_to_fun", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_alg_hom_of", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_mul_apply_eq_dfinsupp_sum", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_of_mul_apply_of_not_le", "description": "", "p": "mathlib"}, {"name": "set_like.is_homogeneous.smul", "description": "", "p": "mathlib"}, {"name": "set_like.gnon_unital_non_assoc_semiring", "description": "Build a `gnon_unital_non_assoc_semiring` instance for a collection of additive submonoids.", "p": "mathlib"}, {"name": "set_like.gcomm_ring", "description": "Build a `gcomm_semiring` instance for a collection of additive submonoids.", "p": "mathlib"}, {"name": "direct_sum.coe_of_mul_apply", "description": "", "p": "mathlib"}, {"name": "set_like.algebra_map_mem_graded", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_ring_hom", "description": "The canonical ring isomorphism between `\u2a01 i, A i` and `R`", "p": "mathlib"}, {"name": "set_like.gsemiring", "description": "Build a `gsemiring` instance for a collection of additive submonoids.", "p": "mathlib"}, {"name": "set_like.gring", "description": "Build a `gring` instance for a collection of additive subgroups.", "p": "mathlib"}, {"name": "submodule.nat_power_graded_monoid", "description": "A direct sum of powers of a submodule of an algebra has a multiplicative structure.", "p": "mathlib"}, {"name": "direct_sum.coe_mul_of_apply_aux", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_alg_hom", "description": "The canonical algebra isomorphism between `\u2a01 i, A i` and `R`.", "p": "mathlib"}, {"name": "direct_sum.coe_mul_of_apply_add", "description": "", "p": "mathlib"}, {"name": "add_comm_monoid.of_submonoid_on_semiring", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_of_mul_apply_of_le", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_of_mul_apply_aux", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_of_mul_apply_add", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_mul_apply", "description": "", "p": "mathlib"}, {"name": "set_like.int_cast_mem_graded", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_mul_of_apply_of_not_le", "description": "", "p": "mathlib"}, {"name": "submodule.galgebra", "description": "Build a `galgebra` instance for a collection of `submodule`s.", "p": "mathlib"}, {"name": "set_like.nat_cast_mem_graded", "description": "", "p": "mathlib"}, {"name": "submodule.supr_eq_to_submodule_range", "description": " The supremum of submodules that form a graded monoid is a subalgebra, and equal to the range of\n`direct_sum.coe_alg_hom`.", "p": "mathlib"}, {"name": "set_like.is_homogeneous_zero_submodule", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_mul_of_apply_of_le", "description": "", "p": "mathlib"}, {"name": "set_like.gcomm_semiring", "description": "Build a `gcomm_semiring` instance for a collection of additive submonoids.", "p": "mathlib"}, {"name": "is_compact_operator.is_compact_closure_image_of_vonN_bounded", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.is_compact_closure_image_ball", "description": "", "p": "mathlib"}, {"name": "compact_operator_topological_closure", "description": "", "p": "mathlib"}, {"name": "is_compact_operator_iff_image_ball_subset_compact", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.comp_clm", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.image_subset_compact_of_vonN_bounded", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.restrict", "description": " If a compact operator preserves a closed submodule, its restriction to that submodule is\ncompact.\n\nNote that, following mathlib's convention in linear algebra, `restrict` designates the restriction\nof an endomorphism `f : E \u2192\u2097 E` to an endomorphism `f' : \u21a5V \u2192\u2097 \u21a5V`. To prove that the restriction\n`f' : \u21a5U \u2192\u209b\u2097 \u21a5V` of a compact operator `f : E \u2192\u209b\u2097 F` is compact, apply\n`is_compact_operator.cod_restrict` to `f \u2218 U.subtypeL`, which is compact by\n`is_compact_operator.comp_clm`.", "p": "mathlib"}, {"name": "continuous_linear_map.mk_of_is_compact_operator_to_linear_map", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.continuous_comp", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.image_closed_ball_subset_compact", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.image_subset_compact_of_bounded", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.smul", "description": "", "p": "mathlib"}, {"name": "is_compact_operator_of_tendsto", "description": "", "p": "mathlib"}, {"name": "compact_operator", "description": "The submodule of compact continuous linear maps.", "p": "mathlib"}, {"name": "is_compact_operator.is_compact_closure_image_closed_ball", "description": "", "p": "mathlib"}, {"name": "is_closed_set_of_is_compact_operator", "description": " The set of compact operators from a normed space to a complete topological vector space is\nclosed.", "p": "mathlib"}, {"name": "is_compact_operator.is_compact_closure_image_of_bounded", "description": "", "p": "mathlib"}, {"name": "is_compact_operator", "description": " A compact operator between two topological vector spaces. This definition is usually\ngiven as \"there exists a neighborhood of zero whose image is contained in a compact set\",\nbut we choose a definition which involves fewer existential quantifiers and replaces images\nwith preimages.\n\nWe prove the equivalence in `is_compact_operator_iff_exists_mem_nhds_image_subset_compact`.", "p": "mathlib"}, {"name": "is_compact_operator_iff_image_closed_ball_subset_compact", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.mk_of_is_compact_operator", "description": "Upgrade a compact `linear_map` to a `continuous_linear_map`.", "p": "mathlib"}, {"name": "is_compact_operator_iff_is_compact_closure_image_ball", "description": "", "p": "mathlib"}, {"name": "is_compact_operator_iff_is_compact_closure_image_closed_ball", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.mk_of_is_compact_operator_mem_compact_operator", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.cod_restrict", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.sub", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.image_ball_subset_compact", "description": "", "p": "mathlib"}, {"name": "is_compact_operator_iff_exists_mem_nhds_image_subset_compact", "description": "", "p": "mathlib"}, {"name": "is_compact_operator_zero", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.neg", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.add", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.coe_mk_of_is_compact_operator", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.continuous", "description": "", "p": "mathlib"}, {"name": "is_compact_operator.restrict'", "description": " If a compact operator preserves a complete submodule, its restriction to that submodule is\ncompact.\n\nNote that, following mathlib's convention in linear algebra, `restrict` designates the restriction\nof an endomorphism `f : E \u2192\u2097 E` to an endomorphism `f' : \u21a5V \u2192\u2097 \u21a5V`. To prove that the restriction\n`f' : \u21a5U \u2192\u209b\u2097 \u21a5V` of a compact operator `f : E \u2192\u209b\u2097 F` is compact, apply\n`is_compact_operator.cod_restrict` to `f \u2218 U.subtypeL`, which is compact by\n`is_compact_operator.comp_clm`.", "p": "mathlib"}, {"name": "is_compact_operator.clm_comp", "description": "", "p": "mathlib"}, {"name": "is_compact_operator_iff_exists_mem_nhds_is_compact_closure_image", "description": "", "p": "mathlib"}, {"name": "matrix.det_le", "description": "", "p": "mathlib"}, {"name": "matrix.det_sum_smul_le", "description": "", "p": "mathlib"}, {"name": "matrix.det_sum_le", "description": "", "p": "mathlib"}, {"name": "finsupp.to_alist_lookup_finsupp", "description": "", "p": "mathlib"}, {"name": "finsupp.to_alist", "description": "Produce an association list for the finsupp over its support using choice.", "p": "mathlib"}, {"name": "alist.lookup_finsupp_apply", "description": "", "p": "mathlib"}, {"name": "alist.lookup_finsupp_eq_iff_of_ne_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.mem_to_alist", "description": "", "p": "mathlib"}, {"name": "alist.insert_lookup_finsupp", "description": "", "p": "mathlib"}, {"name": "alist.empty_lookup_finsupp", "description": "", "p": "mathlib"}, {"name": "alist.lookup_finsupp_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "alist.lookup_finsupp", "description": " Converts an association list into a finitely supported function via `alist.lookup`, sending\nabsent keys to zero.", "p": "mathlib"}, {"name": "alist.singleton_lookup_finsupp", "description": "", "p": "mathlib"}, {"name": "finsupp.to_alist_entries", "description": "", "p": "mathlib"}, {"name": "alist.lookup_finsupp_surjective", "description": "", "p": "mathlib"}, {"name": "finsupp.to_alist_keys_to_finset", "description": "", "p": "mathlib"}, {"name": "alist.lookup_finsupp_support", "description": "", "p": "mathlib"}, {"name": "order_iso.sub_left_symm_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.add_right_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_left_to_equiv", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_right_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.div_left_symm_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.sub_left_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.neg_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_left_symm", "description": "", "p": "mathlib"}, {"name": "le_neg_of_le_neg", "description": "**Alias** of the forward direction of `le_inv'`.", "p": "mathlib"}, {"name": "order_iso.div_left", "description": "`x \u21a6 a / x` as an order-reversing equivalence.", "p": "mathlib"}, {"name": "order_iso.neg_symm_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.add_left_to_equiv", "description": "", "p": "mathlib"}, {"name": "order_iso.div_right_symm_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.sub_right_symm_apply", "description": "", "p": "mathlib"}, {"name": "le_inv_of_le_inv", "description": "**Alias** of the forward direction of `le_inv'`.", "p": "mathlib"}, {"name": "order_iso.add_left_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.div_left_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.add_right_symm", "description": "", "p": "mathlib"}, {"name": "order_iso.add_left_symm", "description": "", "p": "mathlib"}, {"name": "order_iso.add_left", "description": "`equiv.add_left` as an `order_iso`. See also `order_embedding.add_left`.", "p": "mathlib"}, {"name": "order_iso.mul_right_to_equiv", "description": "", "p": "mathlib"}, {"name": "order_iso.div_right", "description": "`x \u21a6 x / a` as an order isomorphism.", "p": "mathlib"}, {"name": "order_iso.inv", "description": "`x \u21a6 x\u207b\u00b9` as an order-reversing equivalence.", "p": "mathlib"}, {"name": "order_iso.inv_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.sub_left", "description": "`x \u21a6 a - x` as an order-reversing equivalence.", "p": "mathlib"}, {"name": "order_iso.mul_left_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.sub_right_apply", "description": "", "p": "mathlib"}, {"name": "neg_le", "description": "", "p": "mathlib"}, {"name": "order_iso.div_right_apply", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_left", "description": "`equiv.mul_left` as an `order_iso`. See also `order_embedding.mul_left`.", "p": "mathlib"}, {"name": "le_neg", "description": "", "p": "mathlib"}, {"name": "le_inv'", "description": "", "p": "mathlib"}, {"name": "order_iso.add_right", "description": "`equiv.add_right` as an `order_iso`. See also `order_embedding.add_right`.", "p": "mathlib"}, {"name": "order_iso.mul_right_symm", "description": "", "p": "mathlib"}, {"name": "inv_le'", "description": "", "p": "mathlib"}, {"name": "order_iso.sub_right", "description": "`x \u21a6 x - a` as an order isomorphism.", "p": "mathlib"}, {"name": "order_iso.mul_right", "description": "`equiv.mul_right` as an `order_iso`. See also `order_embedding.mul_right`.", "p": "mathlib"}, {"name": "inv_le_of_inv_le'", "description": "**Alias** of the forward direction of `inv_le'`.", "p": "mathlib"}, {"name": "order_iso.add_right_to_equiv", "description": "", "p": "mathlib"}, {"name": "order_iso.neg", "description": "`x \u21a6 -x` as an order-reversing equivalence.", "p": "mathlib"}, {"name": "order_iso.inv_symm_apply", "description": "", "p": "mathlib"}, {"name": "neg_le_of_neg_le", "description": "**Alias** of the forward direction of `inv_le'`.", "p": "mathlib"}, {"name": "is_localization.localization_localization_is_localization", "description": "Given submodules `M \u2286 R` and `N \u2286 S = M\u207b\u00b9R`, with `f : R \u2192+* S` the localization map, we have\n`N \u207b\u00b9 S = T = (f\u207b\u00b9 (N \u2022 f(M))) \u207b\u00b9 R`. I.e., the localization of a localization is a localization.", "p": "mathlib"}, {"name": "is_localization.is_localization_of_is_exists_mul_mem", "description": " If `M \u2264 N` are submonoids of `R` such that `\u2200 x : N, \u2203 m : R, m * x \u2208 M`, then the\nlocalization at `N` is equal to the localizaton of `M`.", "p": "mathlib"}, {"name": "is_localization.localization.at_prime.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "is_localization.localization_localization_surj", "description": "", "p": "mathlib"}, {"name": "is_localization.localization_localization_is_localization_of_has_all_units", "description": "Given submodules `M \u2286 R` and `N \u2286 S = M\u207b\u00b9R`, with `f : R \u2192+* S` the localization map, if\n`N` contains all the units of `S`, then `N \u207b\u00b9 S = T = (f\u207b\u00b9 N) \u207b\u00b9 R`. I.e., the localization of a\nlocalization is a localization.", "p": "mathlib"}, {"name": "is_localization.localization.at_prime.algebra", "description": "", "p": "mathlib"}, {"name": "is_localization.mem_localization_localization_submodule", "description": "", "p": "mathlib"}, {"name": "is_localization.localization_algebra_of_submonoid_le", "description": " Given submonoids `M \u2264 N` of `R`, this is the canonical algebra structure\nof `M\u207b\u00b9S` acting on `N\u207b\u00b9S`.", "p": "mathlib"}, {"name": "is_localization.localization_localization_eq_iff_exists", "description": "", "p": "mathlib"}, {"name": "is_localization.localization_localization_submodule", "description": "Localizing wrt `M \u2286 R` and then wrt `N \u2286 S = M\u207b\u00b9R` is equal to the localization of `R` wrt this\nmodule. See `localization_localization_is_localization`.", "p": "mathlib"}, {"name": "is_localization.localization_localization_at_prime_iso_localization", "description": "Given a submodule `M \u2286 R` and a prime ideal `p` of `M\u207b\u00b9R`, with `f : R \u2192+* S` the localization\nmap, then `(M\u207b\u00b9R)\u209a` is isomorphic (as an `R`-algebra) to the localization of `R` at `f\u207b\u00b9(p)`.", "p": "mathlib"}, {"name": "is_localization.localization_localization_map_units", "description": "", "p": "mathlib"}, {"name": "is_fraction_ring.is_fraction_ring_of_is_domain_of_is_localization", "description": "", "p": "mathlib"}, {"name": "is_fraction_ring.is_fraction_ring_of_is_localization", "description": "", "p": "mathlib"}, {"name": "is_localization.is_localization_of_submonoid_le", "description": "If `M \u2264 N` are submonoids of `R`, then `N\u207b\u00b9S` is also the localization of `M\u207b\u00b9S` at `N`.", "p": "mathlib"}, {"name": "is_localization.localization_is_scalar_tower_of_submonoid_le", "description": " If `M \u2264 N` are submonoids of `R`, then the natural map `M\u207b\u00b9S \u2192+* N\u207b\u00b9S` commutes with the\nlocalization maps", "p": "mathlib"}, {"name": "is_localization.localization.algebra", "description": "", "p": "mathlib"}, {"name": "is_localization.localization_localization_at_prime_is_localization", "description": "", "p": "mathlib"}, {"name": "is_localization.is_localization_is_localization_at_prime_is_localization", "description": "Given a submodule `M \u2286 R` and a prime ideal `p` of `S = M\u207b\u00b9R`, with `f : R \u2192+* S` the localization\nmap, then `T = S\u209a` is the localization of `R` at `f\u207b\u00b9(p)`.", "p": "mathlib"}, {"name": "ideal.order_iso_of_maximal", "description": " If `R` is a Jacobson ring, then maximal ideals in the localization at `y`\ncorrespond to maximal ideals in the original ring `R` that don't contain `y`", "p": "mathlib"}, {"name": "ideal.is_jacobson_localization", "description": " If `S` is the localization of the Jacobson ring `R` at the submonoid generated by `y : R`, then\n`S` is Jacobson.", "p": "mathlib"}, {"name": "ideal.polynomial.quotient_mk_comp_C_is_integral_of_jacobson", "description": "If `R` is a Jacobson ring, and `P` is a maximal ideal of `R[X]`,\n then `R \u2192 R[X]/P` is an integral map.", "p": "mathlib"}, {"name": "ideal.polynomial.jacobson_bot_of_integral_localization", "description": "If `f : R \u2192 S` descends to an integral map in the localization at `x`,\n and `R` is a Jacobson ring, then the intersection of all maximal ideals in `S` is trivial", "p": "mathlib"}, {"name": "ideal.polynomial.is_maximal_comap_C_of_is_maximal", "description": "", "p": "mathlib"}, {"name": "ideal.mv_polynomial.is_jacobson", "description": "General form of the nullstellensatz for Jacobson rings, since in a Jacobson ring we have\n `Inf {P maximal | P \u2265 I} = Inf {P prime | P \u2265 I} = I.radical`. Fields are always Jacobson,\n and in that special case this is (most of) the classical Nullstellensatz,\n since `I(V(I))` is the intersection of maximal ideals containing `I`, which is then `I.radical`", "p": "mathlib"}, {"name": "ideal.polynomial.polynomial.ideal.is_jacobson", "description": "", "p": "mathlib"}, {"name": "ideal.disjoint_powers_iff_not_mem", "description": "", "p": "mathlib"}, {"name": "ideal.is_jacobson.out", "description": "", "p": "mathlib"}, {"name": "ideal.polynomial.comp_C_integral_of_surjective_of_jacobson", "description": "", "p": "mathlib"}, {"name": "ideal.mv_polynomial.is_jacobson_mv_polynomial_fin", "description": "", "p": "mathlib"}, {"name": "ideal.is_jacobson_of_surjective", "description": "", "p": "mathlib"}, {"name": "ideal.is_jacobson_iff_prime_eq", "description": " A ring is a Jacobson ring if and only if for all prime ideals `P`,\nthe Jacobson radical of `P` is equal to `P`.", "p": "mathlib"}, {"name": "ideal.is_jacobson", "description": "A ring is a Jacobson ring if for every radical ideal `I`,\nthe Jacobson radical of `I` is equal to `I`.\nSee `is_jacobson_iff_prime_eq` and `is_jacobson_iff_Inf_maximal` for equivalent definitions.", "p": "mathlib"}, {"name": "ideal.is_jacobson.out'", "description": "A ring is a Jacobson ring if for every radical ideal `I`,\nthe Jacobson radical of `I` is equal to `I`.\nSee `is_jacobson_iff_prime_eq` and `is_jacobson_iff_Inf_maximal` for equivalent definitions.", "p": "mathlib"}, {"name": "ideal.is_jacobson_iso", "description": "", "p": "mathlib"}, {"name": "ideal.mv_polynomial.quotient_mk_comp_C_is_integral_of_jacobson", "description": "", "p": "mathlib"}, {"name": "ideal.polynomial.is_maximal_comap_C_of_is_jacobson", "description": "", "p": "mathlib"}, {"name": "ideal.is_jacobson_iff_Inf_maximal", "description": "A ring `R` is Jacobson if and only if for every prime ideal `I`,\n`I` can be written as the infimum of some collection of maximal ideals.\nAllowing \u22a4 in the set `M` of maximal ideals is equivalent, but makes some proofs cleaner.", "p": "mathlib"}, {"name": "ideal.polynomial.is_jacobson_polynomial_iff_is_jacobson", "description": "", "p": "mathlib"}, {"name": "ideal.is_jacobson_of_is_integral'", "description": "", "p": "mathlib"}, {"name": "ideal.radical_eq_jacobson", "description": "", "p": "mathlib"}, {"name": "ideal.mv_polynomial.comp_C_integral_of_surjective_of_jacobson", "description": "", "p": "mathlib"}, {"name": "ideal.is_jacobson_iff", "description": "", "p": "mathlib"}, {"name": "ideal.is_jacobson_field", "description": "Fields have only two ideals, and the condition holds for both of them.", "p": "mathlib"}, {"name": "ideal.polynomial.is_integral_is_localization_polynomial_quotient", "description": "If `I` is a prime ideal of `R[X]` and `pX \u2208 I` is a non-constant polynomial,\n then the map `R \u2192+* R[x]/I` descends to an integral map when localizing at `pX.leading_coeff`.\n In particular `X` is integral because it satisfies `pX`, and constants are trivially integral,\n so integrality of the entire extension follows by closure under addition and multiplication.", "p": "mathlib"}, {"name": "ideal.is_jacobson_of_is_integral", "description": "", "p": "mathlib"}, {"name": "ideal.polynomial.is_jacobson_polynomial_of_is_jacobson", "description": "", "p": "mathlib"}, {"name": "ideal.is_maximal_of_is_maximal_disjoint", "description": " If `R` is a Jacobson ring, then maximal ideals in the localization at `y`\ncorrespond to maximal ideals in the original ring `R` that don't contain `y`.\nThis lemma gives the correspondence in the particular case of an ideal and its map.\nSee `le_rel_iso_of_maximal` for the more general statement, and the reverse of this implication", "p": "mathlib"}, {"name": "ideal.is_maximal_iff_is_maximal_disjoint", "description": " If `R` is a Jacobson ring, then maximal ideals in the localization at `y`\ncorrespond to maximal ideals in the original ring `R` that don't contain `y`.\nThis lemma gives the correspondence in the particular case of an ideal and its comap.\nSee `le_rel_iso_of_maximal` for the more general relation isomorphism", "p": "mathlib"}, {"name": "ideal.is_jacobson_quotient", "description": "", "p": "mathlib"}, {"name": "ideal.is_jacobson_iff_Inf_maximal'", "description": "", "p": "mathlib"}, {"name": "real.sign_of_neg", "description": "", "p": "mathlib"}, {"name": "real.sign_inv", "description": "", "p": "mathlib"}, {"name": "real.sign_mul_pos_of_ne_zero", "description": "", "p": "mathlib"}, {"name": "real.sign_apply_eq", "description": "", "p": "mathlib"}, {"name": "real.sign_int_cast", "description": "", "p": "mathlib"}, {"name": "real.sign_mul_nonneg", "description": "", "p": "mathlib"}, {"name": "real.sign_one", "description": "", "p": "mathlib"}, {"name": "real.inv_sign", "description": "", "p": "mathlib"}, {"name": "real.sign_apply_eq_of_ne_zero", "description": "This lemma is useful for working with `\u211d\u02e3`", "p": "mathlib"}, {"name": "real.sign_of_pos", "description": "", "p": "mathlib"}, {"name": "real.sign", "description": " The sign function that maps negative real numbers to -1, positive numbers to 1, and 0\notherwise.", "p": "mathlib"}, {"name": "real.sign_zero", "description": "", "p": "mathlib"}, {"name": "real.sign_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "real.sign_neg", "description": "", "p": "mathlib"}, {"name": "category_theory.Type_to_Cat_map", "description": "", "p": "mathlib"}, {"name": "category_theory.Cat.bicategory", "description": "Bicategory structure on `Cat`", "p": "mathlib"}, {"name": "category_theory.Cat.category", "description": "Category structure on `Cat`", "p": "mathlib"}, {"name": "category_theory.Cat.str", "description": "", "p": "mathlib"}, {"name": "category_theory.Cat", "description": "Category of categories.", "p": "mathlib"}, {"name": "category_theory.Type_to_Cat", "description": "Embedding `Type` into `Cat` as discrete categories.\n\nThis ought to be modelled as a 2-functor!", "p": "mathlib"}, {"name": "category_theory.Type_to_Cat.full", "description": "", "p": "mathlib"}, {"name": "category_theory.Cat.objects", "description": " Functor that gets the set of objects of a category. It is not\ncalled `forget`, because it is not a faithful functor.", "p": "mathlib"}, {"name": "category_theory.Cat.bicategory.strict", "description": "`Cat` is a strict bicategory.", "p": "mathlib"}, {"name": "category_theory.Cat.comp_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.Cat.id_map", "description": "", "p": "mathlib"}, {"name": "category_theory.Type_to_Cat_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.Cat.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "category_theory.Type_to_Cat.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.Cat.comp_map", "description": "", "p": "mathlib"}, {"name": "category_theory.Cat.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.Cat.of", "description": "Construct a bundled `Cat` from the underlying type and the typeclass.", "p": "mathlib"}, {"name": "category_theory.Cat.equiv_of_iso", "description": "Any isomorphism in `Cat` induces an equivalence of the underlying categories.", "p": "mathlib"}, {"name": "add_roth_number_lt_of_forall_not_add_salem_spencer", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer_mul_left_iff\u2080", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.roth_number_eq", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer.roth_number_eq", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer", "description": "A Salem-Spencer, aka non averaging, set `s` in an additive monoid\nis a set such that the average of any two distinct elements is not in the set.", "p": "mathlib"}, {"name": "add_salem_spencer.le_add_roth_number", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer_insert", "description": "", "p": "mathlib"}, {"name": "roth_number_nat_def", "description": "", "p": "mathlib"}, {"name": "roth_number_nat_is_O_with_id", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_iff_eq_right", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer.add_right", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_add_right_iff", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer.prod", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_add_left_iff", "description": "", "p": "mathlib"}, {"name": "add_roth_number_map_add_left", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_empty", "description": "", "p": "mathlib"}, {"name": "mul_roth_number_le", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_pi", "description": "", "p": "mathlib"}, {"name": "mul_roth_number_singleton", "description": "", "p": "mathlib"}, {"name": "add_roth_number_map_add_right", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer.decidable", "description": "Whether a given finset is Salem-Spencer is decidable.", "p": "mathlib"}, {"name": "mul_salem_spencer.mul_right", "description": "", "p": "mathlib"}, {"name": "mul_roth_number_spec", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.prod", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_insert_of_lt", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.of_image", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer.le_roth_number_nat", "description": " A verbose specialization of `add_salem_spencer.le_add_roth_number`, sometimes convenient in\npractice.", "p": "mathlib"}, {"name": "add_salem_spencer.of_image", "description": "", "p": "mathlib"}, {"name": "set.subsingleton.add_salem_spencer", "description": "", "p": "mathlib"}, {"name": "roth_number_nat_zero", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_pair", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer_mul_right_iff", "description": "", "p": "mathlib"}, {"name": "add_roth_number_spec", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer_insert_of_lt", "description": "", "p": "mathlib"}, {"name": "add_roth_number_Ico", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer.mono", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer_pair", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_insert", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer_singleton", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.image", "description": "", "p": "mathlib"}, {"name": "roth_number_nat_is_O_id", "description": "The Roth number has the trivial bound `roth_number_nat N = O(N)`.", "p": "mathlib"}, {"name": "roth_number_nat_add_le", "description": " The Roth number is a subadditive function. Note that by Fekete's lemma this shows that\nthe limit `roth_number_nat N / N` exists, but Roth's theorem gives the stronger result that this\nlimit is actually `0`.", "p": "mathlib"}, {"name": "set.subsingleton.mul_salem_spencer", "description": "", "p": "mathlib"}, {"name": "le_mul_roth_number_product", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer_mul_right_iff\u2080", "description": "", "p": "mathlib"}, {"name": "add_roth_number", "description": "The additive Roth number of a finset is the cardinality of its biggest additive\nSalem-Spencer subset. The usual Roth number corresponds to `add_roth_number (finset.range n)`, see\n`roth_number_nat`.", "p": "mathlib"}, {"name": "add_salem_spencer_singleton", "description": "", "p": "mathlib"}, {"name": "mul_roth_number_map_mul_left", "description": "", "p": "mathlib"}, {"name": "mul_roth_number_union_le", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.mul_left", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.mul_left\u2080", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.mul_right\u2080", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.mono", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer_empty", "description": "", "p": "mathlib"}, {"name": "roth_number_nat_spec", "description": "", "p": "mathlib"}, {"name": "add_roth_number_empty", "description": "", "p": "mathlib"}, {"name": "roth_number_nat", "description": " The Roth number of a natural `N` is the largest integer `m` for which there is a subset of\n`range N` of size `m` with no arithmetic progression of length 3.\nTrivially, `roth_number_nat N \u2264 N`, but Roth's theorem (proved in 1953) shows that\n`roth_number_nat N = o(N)` and the construction by Behrend gives a lower bound of the form\n`N * exp(-C sqrt(log(N))) \u2264 roth_number_nat N`.\nA significant refinement of Roth's theorem by Bloom and Sisask announced in 2020 gives\n`roth_number_nat N = O(N / (log N)^(1+c))` for an absolute constant `c`.", "p": "mathlib"}, {"name": "mul_salem_spencer_pi", "description": "", "p": "mathlib"}, {"name": "mul_roth_number_map_mul_right", "description": "", "p": "mathlib"}, {"name": "mul_roth_number_empty", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer.add_left", "description": "", "p": "mathlib"}, {"name": "roth_number_nat_le", "description": "", "p": "mathlib"}, {"name": "le_add_roth_number_product", "description": "", "p": "mathlib"}, {"name": "mul_roth_number", "description": " The multiplicative Roth number of a finset is the cardinality of its biggest multiplicative\nSalem-Spencer subset.", "p": "mathlib"}, {"name": "add_roth_number_singleton", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.le_mul_roth_number", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer", "description": " A multiplicative Salem-Spencer, aka non averaging, set `s` in a monoid is a set such that the\nmultiplicative average of any two distinct elements is not in the set.", "p": "mathlib"}, {"name": "add_roth_number_union_le", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_frontier", "description": " The frontier of a closed strictly convex set only contains trivial arithmetic progressions.\nThe idea is that an arithmetic progression is contained on a line and the frontier of a strictly\nconvex set does not contain lines.", "p": "mathlib"}, {"name": "mul_roth_number_lt_of_forall_not_mul_salem_spencer", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer_mul_left_iff", "description": "", "p": "mathlib"}, {"name": "add_salem_spencer_sphere", "description": "", "p": "mathlib"}, {"name": "add_roth_number_le", "description": "", "p": "mathlib"}, {"name": "mul_salem_spencer.decidable", "description": "Whether a given finset is Salem-Spencer is decidable.", "p": "mathlib"}, {"name": "add_salem_spencer.image", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_\u03b1", "description": "", "p": "mathlib"}, {"name": "BoolRing.iso.mk", "description": "Constructs an isomorphism of Boolean rings from a ring isomorphism between them.", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_add", "description": "", "p": "mathlib"}, {"name": "BoolRing.boolean_ring", "description": "", "p": "mathlib"}, {"name": "BoolRing.of", "description": "Construct a bundled `BoolRing` from a `boolean_ring`.", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_BoolAlg", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_zero", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_nsmul", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_sub", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_map", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_mul", "description": "", "p": "mathlib"}, {"name": "BoolRing.coe_of", "description": "", "p": "mathlib"}, {"name": "BoolRing.iso.mk_inv", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_neg", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_npow", "description": "", "p": "mathlib"}, {"name": "BoolAlg.has_forget_to_BoolRing", "description": "", "p": "mathlib"}, {"name": "BoolRing", "description": "The category of Boolean rings.", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_int_cast", "description": "", "p": "mathlib"}, {"name": "BoolAlg.has_forget_to_BoolRing_forget\u2082_map", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "BoolRing_equiv_BoolAlg_functor", "description": "", "p": "mathlib"}, {"name": "BoolRing.boolean_ring.to_comm_ring.category_theory.bundled_hom.parent_projection", "description": "", "p": "mathlib"}, {"name": "BoolRing.large_category", "description": "", "p": "mathlib"}, {"name": "BoolAlg.has_forget_to_BoolRing_forget\u2082_obj", "description": "", "p": "mathlib"}, {"name": "BoolRing.inhabited", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_zsmul", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_nat_cast", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_BoolAlg_forget\u2082_map", "description": "", "p": "mathlib"}, {"name": "BoolRing.iso.mk_hom", "description": "", "p": "mathlib"}, {"name": "BoolRing.concrete_category", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_BoolAlg_forget\u2082_obj", "description": "", "p": "mathlib"}, {"name": "BoolRing.has_forget_to_CommRing_forget\u2082_obj_str_one", "description": "", "p": "mathlib"}, {"name": "BoolRing_equiv_BoolAlg", "description": "The equivalence between Boolean rings and Boolean algebras. This is actually an isomorphism.", "p": "mathlib"}, {"name": "BoolRing_equiv_BoolAlg_inverse", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.map_csupr", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.to_order_embedding", "description": "Convert an injective left order continuous function to an order embedding.", "p": "mathlib"}, {"name": "left_ord_continuous.map_supr", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.lt_iff", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous", "description": " A function `f` between preorders is left order continuous if it preserves all suprema.  We\ndefine it using `is_lub` instead of `Sup` so that the proof works both for complete lattices and\nconditionally complete lattices.", "p": "mathlib"}, {"name": "left_ord_continuous.id", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.map_Inf", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.le_iff", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.id", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.coe_to_order_embedding", "description": "", "p": "mathlib"}, {"name": "order_iso.left_ord_continuous", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.map_Inf'", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.map_is_greatest", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.le_iff", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.mono", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.map_infi", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.comp", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.order_dual", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.comp", "description": "", "p": "mathlib"}, {"name": "order_iso.right_ord_continuous", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.iterate", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous", "description": " A function `f` between preorders is right order continuous if it preserves all infima.  We\ndefine it using `is_glb` instead of `Inf` so that the proof works both for complete lattices and\nconditionally complete lattices.", "p": "mathlib"}, {"name": "right_ord_continuous.map_inf", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.mono", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.order_dual", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.iterate", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.map_Sup'", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.map_Sup", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.map_cinfi", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.map_sup", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.map_is_least", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.lt_iff", "description": "", "p": "mathlib"}, {"name": "left_ord_continuous.map_cSup", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.to_order_embedding", "description": "Convert an injective left order continuous function to a `order_embedding`.", "p": "mathlib"}, {"name": "right_ord_continuous.coe_to_order_embedding", "description": "", "p": "mathlib"}, {"name": "right_ord_continuous.map_cInf", "description": "", "p": "mathlib"}, {"name": "subgroup.left_transversals.diff_self", "description": "", "p": "mathlib"}, {"name": "subgroup.left_transversals.diff_inv", "description": "", "p": "mathlib"}, {"name": "subgroup.left_transversals.diff", "description": "The difference of two left transversals", "p": "mathlib"}, {"name": "subgroup.left_transversals.smul_diff_smul", "description": "", "p": "mathlib"}, {"name": "add_subgroup.left_transversals.diff_self", "description": "", "p": "mathlib"}, {"name": "monoid_hom.transfer_def", "description": "", "p": "mathlib"}, {"name": "monoid_hom.transfer_center_eq_pow", "description": "", "p": "mathlib"}, {"name": "monoid_hom.transfer_center_pow_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.transfer_sylow_restrict_eq_pow", "description": "", "p": "mathlib"}, {"name": "monoid_hom.transfer", "description": " Given `\u03d5 : H \u2192* A` from `H : subgroup G` to a commutative group `A`,\nthe transfer homomorphism is `transfer \u03d5 : G \u2192* A`.", "p": "mathlib"}, {"name": "monoid_hom.ker_transfer_sylow_is_complement'", "description": "Burnside's normal p-complement theorem: If `N(P) \u2264 C(P)`, then `P` has a normal complement.", "p": "mathlib"}, {"name": "add_subgroup.left_transversals.diff_add_diff", "description": "", "p": "mathlib"}, {"name": "monoid_hom.ker_transfer_sylow_disjoint", "description": "", "p": "mathlib"}, {"name": "monoid_hom.transfer_eq_pow", "description": "", "p": "mathlib"}, {"name": "add_subgroup.left_transversals.diff_neg", "description": "", "p": "mathlib"}, {"name": "monoid_hom.transfer_eq_pow_aux", "description": "Auxillary lemma in order to state `transfer_eq_pow`.", "p": "mathlib"}, {"name": "monoid_hom.transfer_eq_prod_quotient_orbit_rel_zpowers_quot", "description": "Explicit computation of the transfer homomorphism.", "p": "mathlib"}, {"name": "monoid_hom.transfer_sylow", "description": "The homomorphism `G \u2192* P` in Burnside's transfer theorem.", "p": "mathlib"}, {"name": "monoid_hom.transfer_center_pow", "description": "The transfer homomorphism `G \u2192* center G`.", "p": "mathlib"}, {"name": "monoid_hom.not_dvd_card_ker_transfer_sylow", "description": "", "p": "mathlib"}, {"name": "subgroup.left_transversals.diff_mul_diff", "description": "", "p": "mathlib"}, {"name": "monoid_hom.transfer_sylow_eq_pow", "description": "", "p": "mathlib"}, {"name": "add_subgroup.left_transversals.vadd_diff_vadd", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.transfer", "description": "Given `\u03d5 : H \u2192+ A` from `H : add_subgroup G` to an additive commutative group `A`,\nthe transfer homomorphism is `transfer \u03d5 : G \u2192+ A`.", "p": "mathlib"}, {"name": "add_monoid_hom.transfer_def", "description": "", "p": "mathlib"}, {"name": "monoid_hom.transfer_sylow_eq_pow_aux", "description": "Auxillary lemma in order to state `transfer_sylow_eq_pow`.", "p": "mathlib"}, {"name": "add_subgroup.left_transversals.diff", "description": "The difference of two left transversals", "p": "mathlib"}, {"name": "add_char.zmod_char_apply", "description": "The additive character on `zmod n` defined using `\u03b6` sends `a` to `\u03b6^a`.", "p": "mathlib"}, {"name": "add_char.primitive_add_char", "description": " Definition for a primitive additive character on a finite ring `R` into a cyclotomic extension\nof a field `R'`. It records which cyclotomic extension it is, the character, and the\nfact that the character is primitive.", "p": "mathlib"}, {"name": "add_char.inhabited", "description": "", "p": "mathlib"}, {"name": "add_char.is_primitive.zmod_char_eq_one_iff", "description": "A primitive additive character on `zmod n` takes the value `1` only at `0`.", "p": "mathlib"}, {"name": "add_char.zmod_char", "description": "We can define an additive character on `zmod n` when we have an `n`th root of unity `\u03b6 : C`.", "p": "mathlib"}, {"name": "add_char.to_mul_shift_inj_of_is_primitive", "description": " The map associating to `a : R` the multiplicative shift of `\u03c8` by `a`\nis injective when `\u03c8` is primitive.", "p": "mathlib"}, {"name": "add_char.inv_apply", "description": "", "p": "mathlib"}, {"name": "add_char.has_inv", "description": " An additive character on a commutative additive group has an inverse.\n\nNote that this is a different inverse to the one provided by `monoid_hom.has_inv`,\nas it acts on the domain instead of the codomain.", "p": "mathlib"}, {"name": "add_char.monoid_hom_class", "description": "", "p": "mathlib"}, {"name": "add_char.to_monoid_hom", "description": "Interpret an additive character as a monoid homomorphism.", "p": "mathlib"}, {"name": "add_char.comm_group", "description": "The additive characters on a commutative additive group form a commutative group.", "p": "mathlib"}, {"name": "add_char.sum_mul_shift", "description": " The sum over the values of `mul_shift \u03c8 b` for `\u03c8` primitive is zero when `b \u2260 0`\nand `#R` otherwise.", "p": "mathlib"}, {"name": "add_char.comm_monoid", "description": "", "p": "mathlib"}, {"name": "add_char.zmod_char_is_nontrivial_iff", "description": "An additive character on `zmod n` is nontrivial iff it takes a value `\u2260 1` on `1`.", "p": "mathlib"}, {"name": "add_char.is_primitive", "description": " An additive character is *primitive* iff all its multiplicative shifts by nonzero\nelements are nontrivial.", "p": "mathlib"}, {"name": "add_char.map_add_mul", "description": "An additive character maps sums to products.", "p": "mathlib"}, {"name": "add_char.zmod_char_primitive_of_primitive_root", "description": " The additive character on `zmod n` associated to a primitive `n`th root of unity\nis primitive", "p": "mathlib"}, {"name": "add_char.sum_eq_zero_of_is_nontrivial", "description": " The sum over the values of a nontrivial additive character vanishes if the target ring\nis a domain.", "p": "mathlib"}, {"name": "add_char.mul_shift_mul", "description": "The product of `mul_shift \u03c8 a` and `mul_shift \u03c8 b` is `mul_shift \u03c8 (a + b)`.", "p": "mathlib"}, {"name": "add_char.primitive_zmod_char", "description": " There is a primitive additive character on `zmod n` if the characteristic of the target\ndoes not divide `n`", "p": "mathlib"}, {"name": "add_char.is_nontrivial", "description": "An additive character is *nontrivial* if it takes a value `\u2260 1`.", "p": "mathlib"}, {"name": "add_char.mul_shift", "description": " Define the multiplicative shift of an additive character.\nThis satisfies `mul_shift \u03c8 a x = \u03c8 (a * x)`.", "p": "mathlib"}, {"name": "add_char.zmod_char_primitive_of_eq_one_only_at_zero", "description": " The converse: if the additive character takes the value `1` only at `0`,\nthen it is primitive.", "p": "mathlib"}, {"name": "add_char.mul_shift_zero", "description": "`mul_shift \u03c8 0` is the trivial character.", "p": "mathlib"}, {"name": "add_char.inv_mul_shift", "description": "`\u03c8\u207b\u00b9 = mul_shift \u03c8 (-1))`.", "p": "mathlib"}, {"name": "add_char.map_zero_one", "description": "An additive character maps `0` to `1`.", "p": "mathlib"}, {"name": "add_char.primitive_add_char.n", "description": "The first projection from `primitive_add_char`, giving the cyclotomic field.", "p": "mathlib"}, {"name": "add_char.primitive_char_finite_field", "description": " There is a primitive additive character on the finite field `F` if the characteristic\nof the target is different from that of `F`.\nWe obtain it as the composition of the trace from `F` to `zmod p` with a primitive\nadditive character on `zmod p`, where `p` is the characteristic of `F`.", "p": "mathlib"}, {"name": "add_char.mul_shift_spec'", "description": "If `n` is a natural number, then `mul_shift \u03c8 n x = (\u03c8 x) ^ n`.", "p": "mathlib"}, {"name": "add_char.primitive_add_char.char", "description": "The second projection from `primitive_add_char`, giving the character.", "p": "mathlib"}, {"name": "add_char.map_zsmul_zpow", "description": "An additive character maps multiples by integers to powers.", "p": "mathlib"}, {"name": "add_char.is_nontrivial.is_primitive", "description": "When `R` is a field `F`, then a nontrivial additive character is primitive", "p": "mathlib"}, {"name": "add_char", "description": " Define `add_char R R'` as `(multiplicative R) \u2192* R'`.\nThe definition works for an additive monoid `R` and a monoid `R'`,\nbut we will restrict to the case that both are commutative rings below.\nWe assume right away that `R'` is commutative, so that `add_char R R'` carries\na structure of commutative monoid.\nThe trivial additive character (sending everything to `1`) is `(1 : add_char R R').`", "p": "mathlib"}, {"name": "add_char.coe_to_fun_apply", "description": "", "p": "mathlib"}, {"name": "add_char.is_nontrivial_iff_ne_trivial", "description": "An additive character is nontrivial iff it is not the trivial character.", "p": "mathlib"}, {"name": "add_char.primitive_add_char.prim", "description": "The third projection from `primitive_add_char`, showing that `\u03c7.2` is primitive.", "p": "mathlib"}, {"name": "add_char.sum_eq_card_of_is_trivial", "description": "The sum over the values of the trivial additive character is the cardinality of the source.", "p": "mathlib"}, {"name": "add_char.mul_shift_apply", "description": "", "p": "mathlib"}, {"name": "add_char.pow_mul_shift", "description": "If `n` is a natural number, then `\u03c8 ^ n = mul_shift \u03c8 n`.", "p": "mathlib"}, {"name": "add_char.zmod_char_apply'", "description": "", "p": "mathlib"}, {"name": "add_char.has_coe_to_fun", "description": " Define coercion to a function so that it includes the move from `R` to `multiplicative R`.\nAfter we have proved the API lemmas below, we don't need to worry about writing `of_add a`\nwhen we want to apply an additive character.", "p": "mathlib"}, {"name": "add_char.map_nsmul_pow", "description": "An additive character maps multiples by natural numbers to powers.", "p": "mathlib"}, {"name": "semiquot.pure_is_pure", "description": "", "p": "mathlib"}, {"name": "semiquot.is_pure.min", "description": "", "p": "mathlib"}, {"name": "semiquot.univ_unique", "description": "", "p": "mathlib"}, {"name": "semiquot.mem_pure", "description": "", "p": "mathlib"}, {"name": "semiquot", "description": "A member of `semiquot \u03b1` is classically a nonempty `set \u03b1`,\n and in the VM is represented by an element of `\u03b1`; the relation\n between these is that the VM element is required to be a member\n of the set `s`. The specific element of `s` that the VM computes\n is hidden by a quotient construction, allowing for the representation\n of nondeterministic functions.", "p": "mathlib"}, {"name": "semiquot.s", "description": "A member of `semiquot \u03b1` is classically a nonempty `set \u03b1`,\n and in the VM is represented by an element of `\u03b1`; the relation\n between these is that the VM element is required to be a member\n of the set `s`. The specific element of `s` that the VM computes\n is hidden by a quotient construction, allowing for the representation\n of nondeterministic functions.", "p": "mathlib"}, {"name": "semiquot.val", "description": "A member of `semiquot \u03b1` is classically a nonempty `set \u03b1`,\n and in the VM is represented by an element of `\u03b1`; the relation\n between these is that the VM element is required to be a member\n of the set `s`. The specific element of `s` that the VM computes\n is hidden by a quotient construction, allowing for the representation\n of nondeterministic functions.", "p": "mathlib"}, {"name": "semiquot.get", "description": "Extract the value from a `is_pure` semiquotient.", "p": "mathlib"}, {"name": "semiquot.mem_pure'", "description": "", "p": "mathlib"}, {"name": "semiquot.bind", "description": "Apply a function returning a `semiquot` to a `semiquot`.", "p": "mathlib"}, {"name": "semiquot.eq_pure", "description": "", "p": "mathlib"}, {"name": "semiquot.order_top", "description": "", "p": "mathlib"}, {"name": "semiquot.semilattice_sup", "description": "", "p": "mathlib"}, {"name": "semiquot.ext_s", "description": "", "p": "mathlib"}, {"name": "semiquot.map", "description": "Apply a function to the unknown value stored in a `semiquot \u03b1`.", "p": "mathlib"}, {"name": "semiquot.nonempty", "description": "", "p": "mathlib"}, {"name": "semiquot.to_trunc", "description": "Convert a `semiquot \u03b1` to a `trunc \u03b1`.", "p": "mathlib"}, {"name": "semiquot.lift_on", "description": " If `f` is a constant on `q.s`, then `q.lift_on f` is the value of `f`\nat any point of `q`.", "p": "mathlib"}, {"name": "semiquot.mem_map", "description": "", "p": "mathlib"}, {"name": "semiquot.is_pure", "description": "Assert that a `semiquot` contains only one possible value.", "p": "mathlib"}, {"name": "semiquot.mem_bind", "description": "", "p": "mathlib"}, {"name": "semiquot.pure", "description": "`pure a` is `a` reinterpreted as an unspecified element of `{a}`.", "p": "mathlib"}, {"name": "semiquot.is_lawful_monad", "description": "", "p": "mathlib"}, {"name": "semiquot.has_mem", "description": "", "p": "mathlib"}, {"name": "semiquot.is_pure_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "semiquot.ext", "description": "", "p": "mathlib"}, {"name": "semiquot.eq_mk_of_mem", "description": "", "p": "mathlib"}, {"name": "semiquot.inhabited", "description": "", "p": "mathlib"}, {"name": "semiquot.mem_blur'", "description": "", "p": "mathlib"}, {"name": "semiquot.mem_univ", "description": "", "p": "mathlib"}, {"name": "semiquot.of_trunc", "description": "Convert a `trunc \u03b1` to a `semiquot \u03b1`.", "p": "mathlib"}, {"name": "semiquot.pure_le", "description": "", "p": "mathlib"}, {"name": "semiquot.monad", "description": "", "p": "mathlib"}, {"name": "semiquot.has_le", "description": "", "p": "mathlib"}, {"name": "semiquot.exists_mem", "description": "", "p": "mathlib"}, {"name": "semiquot.bind_def", "description": "", "p": "mathlib"}, {"name": "semiquot.get_mem", "description": "", "p": "mathlib"}, {"name": "semiquot.mem_pure_self", "description": "", "p": "mathlib"}, {"name": "semiquot.blur", "description": "Replace `s` in a `q : semiquot \u03b1` with a union `s \u222a q.s`", "p": "mathlib"}, {"name": "semiquot.pure_inj", "description": "", "p": "mathlib"}, {"name": "semiquot.partial_order", "description": "", "p": "mathlib"}, {"name": "semiquot.blur'", "description": "Replace `s` in a `semiquot` with a superset.", "p": "mathlib"}, {"name": "semiquot.map_def", "description": "", "p": "mathlib"}, {"name": "semiquot.univ", "description": "`univ : semiquot \u03b1` represents an unspecified element of `univ : set \u03b1`.", "p": "mathlib"}, {"name": "semiquot.is_pure_univ", "description": "", "p": "mathlib"}, {"name": "semiquot.lift_on_of_mem", "description": "", "p": "mathlib"}, {"name": "semiquot.mk", "description": "Construct a `semiquot \u03b1` from `h : a \u2208 s` where `s : set \u03b1`.", "p": "mathlib"}, {"name": "semiquot.blur_eq_blur'", "description": "", "p": "mathlib"}, {"name": "semiquot.is_pure_iff", "description": "", "p": "mathlib"}, {"name": "semiquot.is_pure.mono", "description": "", "p": "mathlib"}, {"name": "omega.rhs_correct_aux", "description": "", "p": "mathlib"}, {"name": "omega.ee.has_repr", "description": "", "p": "mathlib"}, {"name": "omega.ee.inhabited", "description": "", "p": "mathlib"}, {"name": "omega.ee.has_reflect", "description": "", "p": "mathlib"}, {"name": "omega.subst_correct", "description": "", "p": "mathlib"}, {"name": "omega.sym_sym", "description": "", "p": "mathlib"}, {"name": "omega.sat_eq_elim", "description": "", "p": "mathlib"}, {"name": "omega.mul_symdiv_eq", "description": "", "p": "mathlib"}, {"name": "omega.symdiv", "description": "", "p": "mathlib"}, {"name": "omega.cancel", "description": "", "p": "mathlib"}, {"name": "omega.symmod_add_one_self", "description": "", "p": "mathlib"}, {"name": "omega.coeffs_reduce", "description": "", "p": "mathlib"}, {"name": "omega.sgm", "description": " (sgm v b as n) is the new value assigned to the nth variable\nafter a single step of equality elimination using valuation v,\nterm \u27e8b, as\u27e9, and variable index n. If v satisfies the initial\nconstraint set, then (v \u27e8n \u21a6 sgm v b as n\u27e9) satisfies the new\nconstraint set after equality elimination.", "p": "mathlib"}, {"name": "omega.rhs", "description": "", "p": "mathlib"}, {"name": "omega.coeffs_reduce_correct", "description": "", "p": "mathlib"}, {"name": "omega.unsat_of_unsat_eq_elim", "description": "If the result of equality elimination is unsatisfiable, the original clause is unsatisfiable.", "p": "mathlib"}, {"name": "omega.eq_elim", "description": "Apply a given sequence of equality elimination steps to a clause.", "p": "mathlib"}, {"name": "omega.symmod_eq", "description": "", "p": "mathlib"}, {"name": "omega.subst", "description": "", "p": "mathlib"}, {"name": "omega.sat_empty", "description": "", "p": "mathlib"}, {"name": "omega.ee.repr", "description": "", "p": "mathlib"}, {"name": "omega.symmod", "description": "", "p": "mathlib"}, {"name": "omega.ee", "description": "The type of equality elimination rules.", "p": "mathlib"}, {"name": "omega.ee.drop", "description": "The type of equality elimination rules.", "p": "mathlib"}, {"name": "omega.ee.nondiv", "description": "The type of equality elimination rules.", "p": "mathlib"}, {"name": "omega.ee.factor", "description": "The type of equality elimination rules.", "p": "mathlib"}, {"name": "omega.ee.neg", "description": "The type of equality elimination rules.", "p": "mathlib"}, {"name": "omega.ee.reduce", "description": "The type of equality elimination rules.", "p": "mathlib"}, {"name": "omega.ee.cancel", "description": "The type of equality elimination rules.", "p": "mathlib"}, {"name": "omega.rhs_correct", "description": "", "p": "mathlib"}, {"name": "omega.ee.has_to_format", "description": "", "p": "mathlib"}, {"name": "string.quote", "description": "", "p": "core"}, {"name": "string.quote_aux", "description": "", "p": "core"}, {"name": "repr", "description": " `repr` is similar to `to_string` except that we should have the property `eval (repr x) = x` for most sensible datatypes.\nHence, `repr \"hello\"` has the value `\"\\\"hello\\\"\"` not `\"hello\"`.", "p": "core"}, {"name": "list.repr_aux", "description": "", "p": "core"}, {"name": "char.repr", "description": "", "p": "core"}, {"name": "nat.to_digits", "description": "", "p": "core"}, {"name": "nat.repr", "description": "", "p": "core"}, {"name": "list.repr", "description": "", "p": "core"}, {"name": "unsigned.has_repr", "description": "", "p": "core"}, {"name": "nat.digit_char", "description": "", "p": "core"}, {"name": "has_repr", "description": "Implement `has_repr` if the output string is valid lean code that evaluates back to the original object.\nIf you just want to view the object as a string for a trace message, use `has_to_string`.\n\n### Example:\n\n```lean\n#eval to_string \"hello world\"\n-- [Lean] \"hello world\"\n#eval repr \"hello world\"\n-- [Lean] \"\\\"hello world\\\"\"\n```\n\nReference: https://github.com/leanprover/lean/issues/1664", "p": "core"}, {"name": "has_repr.repr", "description": "Implement `has_repr` if the output string is valid lean code that evaluates back to the original object.\nIf you just want to view the object as a string for a trace message, use `has_to_string`.\n\n### Example:\n\n```lean\n#eval to_string \"hello world\"\n-- [Lean] \"hello world\"\n#eval repr \"hello world\"\n-- [Lean] \"\\\"hello world\\\"\"\n```\n\nReference: https://github.com/leanprover/lean/issues/1664", "p": "core"}, {"name": "fin.has_repr", "description": "", "p": "core"}, {"name": "hex_digit_repr", "description": "", "p": "core"}, {"name": "list.has_repr", "description": "", "p": "core"}, {"name": "option.has_repr", "description": "", "p": "core"}, {"name": "subtype.has_repr", "description": "", "p": "core"}, {"name": "sum.has_repr", "description": "", "p": "core"}, {"name": "char_to_hex", "description": "", "p": "core"}, {"name": "prod.has_repr", "description": "", "p": "core"}, {"name": "string.has_repr", "description": "", "p": "core"}, {"name": "char.quote_core", "description": "", "p": "core"}, {"name": "decidable.has_repr", "description": "", "p": "core"}, {"name": "unit.has_repr", "description": "", "p": "core"}, {"name": "bool.has_repr", "description": "", "p": "core"}, {"name": "nat.digit_succ", "description": "", "p": "core"}, {"name": "nat.has_repr", "description": "", "p": "core"}, {"name": "char.has_repr", "description": "", "p": "core"}, {"name": "sigma.has_repr", "description": "", "p": "core"}, {"name": "div_neg", "description": "", "p": "mathlib"}, {"name": "div_add_one", "description": "", "p": "mathlib"}, {"name": "lex.division_semiring", "description": "", "p": "mathlib"}, {"name": "div_sub_div", "description": "", "p": "mathlib"}, {"name": "commute.inv_add_inv", "description": "", "p": "mathlib"}, {"name": "function.injective.division_semiring", "description": "Pullback a `division_semiring` along an injective function.", "p": "mathlib"}, {"name": "division_ring_of_is_unit_or_eq_zero", "description": "Constructs a `division_ring` structure on a `ring` consisting only of units and 0.", "p": "mathlib"}, {"name": "field_of_is_unit_or_eq_zero", "description": " Constructs a `field` structure on a `comm_ring` consisting only of units and 0.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "commute.div_sub_div", "description": "", "p": "mathlib"}, {"name": "of_lex_rat_cast", "description": "", "p": "mathlib"}, {"name": "lex.field", "description": "", "p": "mathlib"}, {"name": "one_add_div", "description": "", "p": "mathlib"}, {"name": "add_div", "description": "", "p": "mathlib"}, {"name": "inv_neg", "description": "", "p": "mathlib"}, {"name": "order_dual.has_rat_cast", "description": "", "p": "mathlib"}, {"name": "function.injective.semifield", "description": "Pullback a `field` along an injective function.", "p": "mathlib"}, {"name": "order_dual.field", "description": "", "p": "mathlib"}, {"name": "lex.semifield", "description": "", "p": "mathlib"}, {"name": "lex.division_ring", "description": "", "p": "mathlib"}, {"name": "sub_div", "description": "", "p": "mathlib"}, {"name": "add_div_eq_mul_add_div", "description": "", "p": "mathlib"},