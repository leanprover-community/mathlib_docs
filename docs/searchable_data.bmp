ription": "Permuting a vector on the right of a dot product can be transferred to the left.", "p": "mathlib"}, {"name": "matrix.submatrix_id_id", "description": "", "p": "mathlib"}, {"name": "matrix.conj_transpose_sum", "description": "", "p": "mathlib"}, {"name": "ring_hom.map_matrix_comp", "description": "", "p": "mathlib"}, {"name": "matrix.transpose_add_equiv_symm", "description": "", "p": "mathlib"}, {"name": "matrix.has_one", "description": "", "p": "mathlib"}, {"name": "add_equiv.map_matrix_symm", "description": "", "p": "mathlib"}, {"name": "matrix.dot_product_comm", "description": "", "p": "mathlib"}, {"name": "matrix.bit0_apply", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_mul", "description": "", "p": "mathlib"}, {"name": "matrix.transpose_list_sum", "description": "", "p": "mathlib"}, {"name": "matrix.single_vec_mul_diagonal", "description": "", "p": "mathlib"}, {"name": "matrix.star_mul_vec", "description": "", "p": "mathlib"}, {"name": "matrix.submatrix_apply", "description": "", "p": "mathlib"}, {"name": "matrix.row_add", "description": "", "p": "mathlib"}, {"name": "matrix.map_id", "description": "", "p": "mathlib"}, {"name": "matrix.sub_left", "description": "The left `n \u00d7 l` part of a `n \u00d7 (l+r)` matrix.", "p": "mathlib"}, {"name": "matrix.mul_vec_diagonal", "description": "", "p": "mathlib"}, {"name": "matrix.col", "description": "`matrix.col u` is the column matrix whose entries are given by `u`.", "p": "mathlib"}, {"name": "matrix.vec_mul_one", "description": "", "p": "mathlib"}, {"name": "matrix.dot_product_smul", "description": "", "p": "mathlib"}, {"name": "matrix.add_mul", "description": "", "p": "mathlib"}, {"name": "matrix.bit1_apply_eq", "description": "", "p": "mathlib"}, {"name": "matrix.map_add", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "matrix.update_column_reindex", "description": "", "p": "mathlib"}, {"name": "matrix.