group.nat_card_dvd_of_le", "description": "", "p": "mathlib"}, {"name": "add_subgroup.finite_index_ker", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_mul_relindex", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index_eq_one", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_infi_ne_zero", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_eq_zero_of_le_left", "description": "", "p": "mathlib"}, {"name": "add_subgroup.has_top.top.finite_index", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_inf_ne_zero", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_comap", "description": "", "p": "mathlib"}, {"name": "subgroup.index_infi_ne_zero", "description": "", "p": "mathlib"}, {"name": "subgroup.index_dvd_card", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index_map", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_ker", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_bot_left_eq_card", "description": "", "p": "mathlib"}, {"name": "subgroup.mul_self_mem_of_index_two", "description": "", "p": "mathlib"}, {"name": "subgroup.index_eq_zero_of_relindex_eq_zero", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_bot_left", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_inf_le", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_sup_left", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index_inf_ne_zero", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_infi_ne_zero", "description": "", "p": "mathlib"}, {"name": "subgroup.inf_relindex_left", "description": "", "p": "mathlib"}, {"name": "add_subgroup.card_dvd_of_surjective", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index_map_eq", "description": "", "p": "mathlib"}, {"name": "subgroup.finite_index_of_finite", "description": "", "p": "mathlib"}, {"name": "subgroup.index_dvd_of_le", "description": "", "p": "mathlib"}, {"name": "subgroup.nat_card_dvd_of_injective", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index_dvd_card", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_le_of_le_right", "description": "", "p": "mathlib"}, {"name": "subgroup.nat_card_dvd_of_surjective", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index_dvd_of_le", "description": "", "p": "mathlib"}, {"name": "subgroup.inf_relindex_right", "description": "", "p": "mathlib"}, {"name": "add_subgroup.nat_card_dvd_of_injective", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index_infi_ne_zero", "description": "", "p": "mathlib"}, {"name": "subgroup.finite_index_normal_core", "description": "", "p": "mathlib"}, {"name": "add_subgroup.fintype_quotient_of_finite_index", "description": "A finite index subgroup has finite quotient", "p": "mathlib"}, {"name": "subgroup.relindex_top_left", "description": "", "p": "mathlib"}, {"name": "subgroup.finite_index_of_finite_quotient", "description": "", "p": "mathlib"}, {"name": "add_subgroup.has_inf.inf.finite_index", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index_eq_card", "description": "", "p": "mathlib"}, {"name": "subgroup.index_eq_one", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_ne_zero_trans", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_self", "description": "", "p": "mathlib"}, {"name": "subgroup.card_dvd_of_surjective", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index", "description": "The index of a subgroup as a natural number,\nand returns 0 if the index is infinite.", "p": "mathlib"}, {"name": "add_subgroup.index_comap_of_surjective", "description": "", "p": "mathlib"}, {"name": "subgroup.index_eq_two_iff", "description": " A subgroup has index two if and only if there exists `a` such that for all `b`, exactly one\nof `b * a` and `b` belong to `H`.", "p": "mathlib"}, {"name": "add_subgroup.relindex_eq_zero_of_le_right", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_top_right", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_bot_right", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_sup_right", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_subgroup_of", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_dvd_of_le_left", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_mul_index", "description": "", "p": "mathlib"}, {"name": "subgroup.index_infi_le", "description": "", "p": "mathlib"}, {"name": "add_subgroup.inf_relindex_left", "description": "", "p": "mathlib"}, {"name": "subgroup.index_ker", "description": "", "p": "mathlib"}, {"name": "subgroup.relindex_sup_right", "description": "", "p": "mathlib"}, {"name": "subgroup.index_map_eq", "description": "", "p": "mathlib"}, {"name": "add_subgroup.index_mul_card", "description": "", "p": "mathlib"}, {"name": "subgroup.index_map", "description": "", "p": "mathlib"}, {"name": "subgroup.finite_quotient_of_finite_index", "description": "", "p": "mathlib"}, {"name": "add_subgroup.fintype_of_index_ne_zero", "description": "Finite index implies finite quotient.", "p": "mathlib"}, {"name": "subgroup.relindex_ne_zero_trans", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_eq_one", "description": "", "p": "mathlib"}, {"name": "add_subgroup.relindex_mul_index", "description": "", "p": "mathlib"}, {"name": "subgroup.index_bot_eq_card", "description": "", "p": "mathlib"}, {"name": "add_subgroup.nat_card_dvd_of_surjective", "description": "", "p": "mathlib"}, {"name": "subgroup.has_inf.inf.finite_index", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.of", "description": "Creates the integer and fractional part of a value `v`, i.e. `\u27e8\u230av\u230b, v - \u230av\u230b\u27e9`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.coe_to_int_fract_pair", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair", "description": "We collect an integer part `b = \u230av\u230b` and fractional part `fr = v - \u230av\u230b` of a value `v` in a pair\n`\u27e8b, fr\u27e9`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.b", "description": "We collect an integer part `b = \u230av\u230b` and fractional part `fr = v - \u230av\u230b` of a value `v` in a pair\n`\u27e8b, fr\u27e9`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.fr", "description": "We collect an integer part `b = \u230av\u230b` and fractional part `fr = v - \u230av\u230b` of a value `v` in a pair\n`\u27e8b, fr\u27e9`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.stream_is_seq", "description": "Shows that `int_fract_pair.stream` has the sequence property, that is once we return `none` at\nposition `n`, we also return `none` at `n + 1`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.has_coe_to_int_fract_pair", "description": "Coerce a pair by coercing the fractional component.", "p": "mathlib"}, {"name": "generalized_continued_fraction.of", "description": "Returns the `generalized_continued_fraction` of a value. In fact, the returned gcf is also\na `continued_fraction` that terminates if and only if `v` is rational (those proofs will be\nadded in a future commit).\n\nThe continued fraction representation of `v` is given by `[\u230av\u230b; b\u2080, b\u2081, b\u2082,...]`, where\n`[b\u2080; b\u2081, b\u2082,...]` recursively is the continued fraction representation of `1 / (v - \u230av\u230b)`. This\nprocess stops when the fractional part `v - \u230av\u230b` hits 0 at some step.\n\nThe implementation uses `int_fract_pair.stream` to obtain the partial denominators of the continued\nfraction. Refer to said function for more details about the computation process.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.seq1", "description": "Uses `int_fract_pair.stream` to create a sequence with head (i.e. `seq1`) of integer and fractional\nparts of a value `v`. The first value of `int_fract_pair.stream` is never `none`, so we can safely\nextract it and put the tail of the stream in the sequence part.\n\nThis is just an intermediate representation and users should not (need to) directly interact with\nit. The setup of rewriting/simplification lemmas that make the definitions easy to use is done in\n`algebra.continued_fractions.computation.translations`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.has_repr", "description": "Make an `int_fract_pair` printable.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.stream", "description": "Creates the stream of integer and fractional parts of a value `v` needed to obtain the continued\nfraction representation of `v` in `generalized_continued_fraction.of`. More precisely, given a value\n`v : K`, it recursively computes a stream of option `\u2124 \u00d7 K` pairs as follows:\n- `stream v 0 = some \u27e8\u230av\u230b, v - \u230av\u230b\u27e9`\n- `stream v (n + 1) = some \u27e8\u230afr\u2099\u207b\u00b9\u230b, fr\u2099\u207b\u00b9 - \u230afr\u2099\u207b\u00b9\u230b\u27e9`,\n    if `stream v n = some \u27e8_, fr\u2099\u27e9` and `fr\u2099 \u2260 0`\n- `stream v (n + 1) = none`, otherwise\n\nFor example, let `(v : \u211a) := 3.4`. The process goes as follows:\n- `stream v 0 = some \u27e8\u230av\u230b, v - \u230av\u230b\u27e9 = some \u27e83, 0.4\u27e9`\n- `stream v 1 = some \u27e8\u230a0.4\u207b\u00b9\u230b, 0.4\u207b\u00b9 - \u230a0.4\u207b\u00b9\u230b\u27e9 = some \u27e8\u230a2.5\u230b, 2.5 - \u230a2.5\u230b\u27e9 = some \u27e82, 0.5\u27e9`\n- `stream v 2 = some \u27e8\u230a0.5\u207b\u00b9\u230b, 0.5\u207b\u00b9 - \u230a0.5\u207b\u00b9\u230b\u27e9 = some \u27e8\u230a2\u230b, 2 - \u230a2\u230b\u27e9 = some \u27e82, 0\u27e9`\n- `stream v n = none`, for `n \u2265 3`", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.mapFr", "description": "Maps a function `f` on the fractional components of a given pair.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.inhabited", "description": "", "p": "mathlib"}, {"name": "dmatrix.unique", "description": "", "p": "mathlib"}, {"name": "dmatrix.has_neg", "description": "", "p": "mathlib"}, {"name": "dmatrix.subsingleton", "description": "", "p": "mathlib"}, {"name": "dmatrix.add_monoid", "description": "", "p": "mathlib"}, {"name": "dmatrix.neg_apply", "description": "", "p": "mathlib"}, {"name": "dmatrix.has_add", "description": "", "p": "mathlib"}, {"name": "dmatrix.subsingleton_of_empty_left", "description": "", "p": "mathlib"}, {"name": "dmatrix.zero_apply", "description": "", "p": "mathlib"}, {"name": "dmatrix.col", "description": "`dmatrix.col u` is the column matrix whose entries are given by `u`.", "p": "mathlib"}, {"name": "dmatrix.add_semigroup", "description": "", "p": "mathlib"}, {"name": "dmatrix.map_add", "description": "", "p": "mathlib"}, {"name": "dmatrix.has_sub", "description": "", "p": "mathlib"}, {"name": "dmatrix.row", "description": "`dmatrix.row u` is the row matrix whose entries are given by `u`.", "p": "mathlib"}, {"name": "dmatrix.subsingleton_of_empty_right", "description": "", "p": "mathlib"}, {"name": "dmatrix.add_comm_group", "description": "", "p": "mathlib"}, {"name": "dmatrix.has_zero", "description": "", "p": "mathlib"}, {"name": "dmatrix.map_sub", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_dmatrix_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_dmatrix", "description": " The `add_monoid_hom` between spaces of dependently typed matrices\ninduced by an `add_monoid_hom` between their coefficients.", "p": "mathlib"}, {"name": "dmatrix.ext_iff", "description": "", "p": "mathlib"}, {"name": "dmatrix", "description": " `dmatrix m n` is the type of dependently typed matrices\nwhose rows are indexed by the fintype `m` and\nwhose columns are indexed by the fintype `n`.", "p": "mathlib"}, {"name": "dmatrix.inhabited", "description": "", "p": "mathlib"}, {"name": "dmatrix.add_comm_semigroup", "description": "", "p": "mathlib"}, {"name": "dmatrix.map_map", "description": "", "p": "mathlib"}, {"name": "dmatrix.map_zero", "description": "", "p": "mathlib"}, {"name": "dmatrix.sub_apply", "description": "", "p": "mathlib"}, {"name": "dmatrix.add_group", "description": "", "p": "mathlib"}, {"name": "dmatrix.add_apply", "description": "", "p": "mathlib"}, {"name": "dmatrix.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "dmatrix.ext", "description": "", "p": "mathlib"}, {"name": "dmatrix.map_apply", "description": "", "p": "mathlib"}, {"name": "dmatrix.transpose", "description": "The transpose of a dmatrix.", "p": "mathlib"}, {"name": "dmatrix.map", "description": "`M.map f` is the dmatrix obtained by applying `f` to each entry of the matrix `M`.", "p": "mathlib"}, {"name": "traversable.to_list_eq_self", "description": "", "p": "mathlib"}, {"name": "traversable.mfoldr.of_free_monoid_comp_of", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldr.mk", "description": "", "p": "mathlib"}, {"name": "traversable.mfoldl_to_list", "description": "", "p": "mathlib"}, {"name": "monoid.foldr.get", "description": "", "p": "mathlib"}, {"name": "traversable.mfoldr_to_list", "description": "", "p": "mathlib"}, {"name": "traversable.mfoldl.of_free_monoid_comp_of", "description": "", "p": "mathlib"}, {"name": "traversable.map_fold", "description": "", "p": "mathlib"}, {"name": "traversable.to_list_spec", "description": "", "p": "mathlib"}, {"name": "traversable.mfoldl", "description": "", "p": "mathlib"}, {"name": "traversable.fold_map", "description": "", "p": "mathlib"}, {"name": "monoid.foldl.of_free_monoid_apply", "description": "", "p": "mathlib"}, {"name": "traversable.mfoldl_map", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldl.of_free_monoid", "description": "", "p": "mathlib"}, {"name": "monoid.foldl", "description": "For a list, foldl f x [y\u2080,y\u2081] reduces as follows:\n\n```lean\ncalc  foldl f x [y\u2080,y\u2081]\n    = foldl f (f x y\u2080) [y\u2081]      : rfl\n... = foldl f (f (f x y\u2080) y\u2081) [] : rfl\n... = f (f x y\u2080) y\u2081              : rfl\n```\nwith\n```lean\nf : \u03b1 \u2192 \u03b2 \u2192 \u03b1\nx : \u03b1\n[y\u2080,y\u2081] : list \u03b2\n```\n\nWe can view the above as a composition of functions:\n```lean\n... = f (f x y\u2080) y\u2081              : rfl\n... = flip f y\u2081 (flip f y\u2080 x)    : rfl\n... = (flip f y\u2081 \u2218 flip f y\u2080) x  : rfl\n```\n\nWe can use traverse and const to construct this composition:\n```lean\ncalc   const.run (traverse (\u03bb y, const.mk' (flip f y)) [y\u2080,y\u2081]) x\n     = const.run ((::) <$> const.mk' (flip f y\u2080) <*> traverse (\u03bb y, const.mk' (flip f y)) [y\u2081]) x\n...  = const.run ((::) <$> const.mk' (flip f y\u2080) <*>\n         ( (::) <$> const.mk' (flip f y\u2081) <*> traverse (\u03bb y, const.mk' (flip f y)) [] )) x\n...  = const.run ((::) <$> const.mk' (flip f y\u2080) <*>\n         ( (::) <$> const.mk' (flip f y\u2081) <*> pure [] )) x\n...  = const.run ( ((::) <$> const.mk' (flip f y\u2081) <*> pure []) \u2218\n         ((::) <$> const.mk' (flip f y\u2080)) ) x\n...  = const.run ( const.mk' (flip f y\u2081) \u2218 const.mk' (flip f y\u2080) ) x\n...  = const.run ( flip f y\u2081 \u2218 flip f y\u2080 ) x\n...  = f (f x y\u2080) y\u2081\n```\n\nAnd this is how `const` turns a monoid into an applicative functor and\nhow the monoid of endofunctions define `foldl`.", "p": "mathlib"}, {"name": "traversable.fold_map_map", "description": "", "p": "mathlib"}, {"name": "monoid.foldl.get", "description": "", "p": "mathlib"}, {"name": "traversable.free.map_eq_map", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldl.mk", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldr.of_free_monoid_apply", "description": "", "p": "mathlib"}, {"name": "traversable.length_to_list", "description": "", "p": "mathlib"}, {"name": "monoid.foldr.of_free_monoid", "description": "", "p": "mathlib"}, {"name": "traversable.length", "description": "", "p": "mathlib"}, {"name": "traversable.to_list", "description": "Conceptually, `to_list` collects all the elements of a collection\nin a list. This idea is formalized by\n\n  `lemma to_list_spec (x : t \u03b1) : to_list x = fold_map free_monoid.mk x`.\n\nThe definition of `to_list` is based on `foldl` and `list.cons` for\nspeed. It is faster than using `fold_map free_monoid.mk` because, by\nusing `foldl` and `list.cons`, each insertion is done in constant\ntime. As a consequence, `to_list` performs in linear.\n\nOn the other hand, `fold_map free_monoid.mk` creates a singleton list\naround each element and concatenates all the resulting lists. In\n`xs ++ ys`, concatenation takes a time proportional to `length xs`. Since\nthe order in which concatenation is evaluated is unspecified, nothing\nprevents each element of the traversable to be appended at the end\n`xs ++ [x]` which would yield a `O(n\u00b2)` run time.", "p": "mathlib"}, {"name": "traversable.mfoldr", "description": "", "p": "mathlib"}, {"name": "traversable.foldr_to_list", "description": "", "p": "mathlib"}, {"name": "traversable.foldl", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldl.get", "description": "", "p": "mathlib"}, {"name": "traversable.foldr_map", "description": "", "p": "mathlib"}, {"name": "traversable.foldl.of_free_monoid_comp_of", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldl", "description": "", "p": "mathlib"}, {"name": "traversable.foldl_map", "description": "", "p": "mathlib"}, {"name": "traversable.foldl_to_list", "description": "", "p": "mathlib"}, {"name": "traversable.foldr.of_free_monoid_comp_of", "description": "", "p": "mathlib"}, {"name": "traversable.fold_map_hom_free", "description": "", "p": "mathlib"}, {"name": "monoid.foldr.mk", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldr", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldr.get", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldl.of_free_monoid_apply", "description": "", "p": "mathlib"}, {"name": "monoid.foldl.mk", "description": "", "p": "mathlib"}, {"name": "monoid.foldr", "description": "", "p": "mathlib"}, {"name": "monoid.mfoldr.of_free_monoid", "description": "", "p": "mathlib"}, {"name": "traversable.to_list_map", "description": "", "p": "mathlib"}, {"name": "monoid.foldr.of_free_monoid_apply", "description": "", "p": "mathlib"}, {"name": "traversable.fold_map_hom", "description": "", "p": "mathlib"}, {"name": "traversable.foldr", "description": "", "p": "mathlib"}, {"name": "traversable.mfoldr_map", "description": "", "p": "mathlib"}, {"name": "monoid.foldl.of_free_monoid", "description": "", "p": "mathlib"}, {"name": "traversable.foldl.unop_of_free_monoid", "description": "", "p": "mathlib"}, {"name": "skew_adjoint_partL_apply_coe", "description": "", "p": "mathlib"}, {"name": "starL_apply", "description": "", "p": "mathlib"}, {"name": "starL'_apply", "description": "", "p": "mathlib"}, {"name": "starL'_symm_apply", "description": "", "p": "mathlib"}, {"name": "self_adjoint_partL_apply_coe", "description": "", "p": "mathlib"}, {"name": "skew_adjoint_partL_coe", "description": "", "p": "mathlib"}, {"name": "starL_to_linear_equiv", "description": "", "p": "mathlib"}, {"name": "star_module.decompose_prod_adjointL_to_linear_equiv", "description": "", "p": "mathlib"}, {"name": "continuous_skew_adjoint_part", "description": "", "p": "mathlib"}, {"name": "skew_adjoint_partL", "description": "The skew-adjoint part of an element of a star module, as a continuous linear map.", "p": "mathlib"}, {"name": "self_adjoint_partL", "description": "The self-adjoint part of an element of a star module, as a continuous linear map.", "p": "mathlib"}, {"name": "continuous_decompose_prod_adjoint", "description": "", "p": "mathlib"}, {"name": "continuous_decompose_prod_adjoint_symm", "description": "", "p": "mathlib"}, {"name": "starL", "description": " If `A` is a topological module over a commutative `R` with compatible actions,\nthen `star` is a continuous semilinear equivalence.", "p": "mathlib"}, {"name": "star_module.decompose_prod_adjointL", "description": " The decomposition of elements of a star module into their self- and skew-adjoint parts,\nas a continuous linear equivalence.", "p": "mathlib"}, {"name": "star_module.decompose_prod_adjointL_apply", "description": "", "p": "mathlib"}, {"name": "self_adjoint_partL_coe", "description": "", "p": "mathlib"}, {"name": "starL_symm_apply", "description": "", "p": "mathlib"}, {"name": "star_module.decompose_prod_adjointL_symm_apply", "description": "", "p": "mathlib"}, {"name": "starL'_to_linear_equiv", "description": "", "p": "mathlib"}, {"name": "starL'", "description": " If `A` is a topological module over a commutative `R` with trivial star and compatible actions,\nthen `star` is a continuous linear equivalence.", "p": "mathlib"}, {"name": "continuous_self_adjoint_part", "description": "", "p": "mathlib"}, {"name": "dvd_add_self_left", "description": "An element a divides the sum a + b if and only if a divides b.", "p": "mathlib"}, {"name": "dvd_sub_right", "description": " If an element `a` divides another element `b` in a ring, `a` divides the difference of `b` and\nanother element `c` iff `a` divides `c`.", "p": "mathlib"}, {"name": "dvd_sub_self_right", "description": "An element `a` divides the difference `b - a` if and only if `a` divides `b`.", "p": "mathlib"}, {"name": "dvd_add_right", "description": " If an element `a` divides another element `b` in a ring, `a` divides the sum of `b` and another\nelement `c` iff `a` divides `c`.", "p": "mathlib"}, {"name": "has_dvd.dvd.sub", "description": "**Alias** of `dvd_sub`.", "p": "mathlib"}, {"name": "dvd_iff_dvd_of_dvd_sub", "description": "", "p": "mathlib"}, {"name": "dvd_sub_comm", "description": "", "p": "mathlib"}, {"name": "dvd_add_left", "description": " If an element `a` divides another element `c` in a ring, `a` divides the sum of another element\n`b` with `c` iff `a` divides `b`.", "p": "mathlib"}, {"name": "has_dvd.dvd.neg_right", "description": "**Alias** of the reverse direction of `dvd_neg`.", "p": "mathlib"}, {"name": "dvd_sub_left", "description": " If an element `a` divides another element `c` in a ring, `a` divides the difference of another\nelement `b` with `c` iff `a` divides `b`.", "p": "mathlib"}, {"name": "has_dvd.dvd.add", "description": "**Alias** of `dvd_add`.", "p": "mathlib"}, {"name": "dvd_neg", "description": " An element `a` of a semigroup with a distributive negation divides the negation of an element\n`b` iff `a` divides `b`.", "p": "mathlib"}, {"name": "has_dvd.dvd.linear_comb", "description": "", "p": "mathlib"}, {"name": "two_dvd_bit1", "description": "", "p": "mathlib"}, {"name": "dvd_add", "description": "", "p": "mathlib"}, {"name": "dvd_sub", "description": "", "p": "mathlib"}, {"name": "has_dvd.dvd.neg_left", "description": "**Alias** of the reverse direction of `neg_dvd`.", "p": "mathlib"}, {"name": "neg_dvd", "description": " The negation of an element `a` of a semigroup with a distributive negation divides another\nelement `b` iff `a` divides `b`.", "p": "mathlib"}, {"name": "dvd_add_self_right", "description": "An element a divides the sum b + a if and only if a divides b.", "p": "mathlib"}, {"name": "dvd_mul_sub_mul", "description": "", "p": "mathlib"}, {"name": "dvd_sub_self_left", "description": "An element `a` divides the difference `a - b` if and only if `a` divides `b`.", "p": "mathlib"}, {"name": "two_dvd_bit0", "description": "", "p": "mathlib"}, {"name": "has_dvd.dvd.of_neg_left", "description": "**Alias** of the forward direction of `neg_dvd`.", "p": "mathlib"}, {"name": "has_dvd.dvd.of_neg_right", "description": "**Alias** of the forward direction of `dvd_neg`.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.to_prelax_functor_map", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_whisker_right_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.comp_map", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.mk_of_oplax_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.id_map_id", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.id", "description": "The identity pseudofunctor.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.id_map", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082_associator", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.mk_of_oplax'_map\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map_comp_naturality_left_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.comp_map_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.to_prelax_eq_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_associator", "description": "", "p": "mathlib"}, {"name": "category_theory.prelax_functor.id_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.prelax_functor.to_prefunctor_eq_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.mk_of_oplax'_map_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.to_prelax_functor_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.prelax_functor", "description": "A prelax functor between bicategories consists of functions between objects,\n1-morphisms, and 2-morphisms. This structure will be extended to define `oplax_functor`.", "p": "mathlib"}, {"name": "category_theory.prelax_functor.obj", "description": "A prelax functor between bicategories consists of functions between objects,\n1-morphisms, and 2-morphisms. This structure will be extended to define `oplax_functor`.", "p": "mathlib"}, {"name": "category_theory.prelax_functor.map", "description": "A prelax functor between bicategories consists of functions between objects,\n1-morphisms, and 2-morphisms. This structure will be extended to define `oplax_functor`.", "p": "mathlib"}, {"name": "category_theory.prelax_functor.map\u2082", "description": "A prelax functor between bicategories consists of functions between objects,\n1-morphisms, and 2-morphisms. This structure will be extended to define `oplax_functor`.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_associator_aux", "description": "This auxiliary definition states that pseudofunctors preserve the associators\nmodulo some adjustments of domains and codomains of 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.mk_of_oplax'_map", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.to_prelax_functor_eq_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.comp", "description": "Composition of pseudofunctors.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.obj", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map_id", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map_comp", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_id'", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_comp'", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_whisker_left'", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_whisker_right'", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_associator'", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_left_unitor'", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_right_unitor'", "description": "A pseudofunctor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the compositions,\nand do not need to strictly preserve the identity. Instead, there are specified 2-isomorphisms\n`F.map (\ud835\udfd9 a) \u2245 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u2245 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082_right_unitor_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.prelax_functor.comp_map\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.to_oplax_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.prelax_functor.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_whisker_right", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.to_prelax_functor", "description": "The prelax functor between the underlying quivers.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.comp_map_id", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082_comp_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_left_unitor_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.prelax_functor.has_coe_to_prefunctor", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_comp_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map_functor_map", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.obj", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map_id", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map_comp", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map_comp_naturality_left'", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map_comp_naturality_right'", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082_id'", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082_comp'", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082_associator'", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082_left_unitor'", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082_right_unitor'", "description": "An oplax functor `F` between bicategories `B` and `C` consists of a function between objects\n`F.obj`, a function between 1-morphisms `F.map`, and a function between 2-morphisms `F.map\u2082`.\n\nUnlike functors between categories, `F.map` do not need to strictly commute with the composition,\nand do not need to strictly preserve the identity. Instead, there are specified 2-morphisms\n`F.map (\ud835\udfd9 a) \u27f6 \ud835\udfd9 (F.obj a)` and `F.map (f \u226b g) \u27f6 F.map f \u226b F.map g`.\n\n`F.map\u2082` strictly commute with compositions and preserve the identity. They also preserve the\nassociator, the left unitor, and the right unitor modulo some adjustments of domains and codomains\nof 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.pseudo_core", "description": "A structure on an oplax functor that promotes an oplax functor to a pseudofunctor.\nSee `pseudofunctor.mk_of_oplax`.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.pseudo_core.map_id_iso", "description": "A structure on an oplax functor that promotes an oplax functor to a pseudofunctor.\nSee `pseudofunctor.mk_of_oplax`.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.pseudo_core.map_comp_iso", "description": "A structure on an oplax functor that promotes an oplax functor to a pseudofunctor.\nSee `pseudofunctor.mk_of_oplax`.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.pseudo_core.map_id_iso_hom'", "description": "A structure on an oplax functor that promotes an oplax functor to a pseudofunctor.\nSee `pseudofunctor.mk_of_oplax`.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.pseudo_core.map_comp_iso_hom'", "description": "A structure on an oplax functor that promotes an oplax functor to a pseudofunctor.\nSee `pseudofunctor.mk_of_oplax`.", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.to_oplax", "description": "The oplax functor associated with a pseudofunctor.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.pseudo_core.map_id_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map_functor_map", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_associator_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.id_map\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.to_oplax_map\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map\u2082_associator_aux", "description": "This auxiliary definition states that oplax functors preserve the associators\nmodulo some adjustments of domains and codomains of 2-morphisms.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.map_comp_naturality_left", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.mk_of_oplax_map\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map_functor_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.map\u2082_whisker_left_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.pseudofunctor.mk_of_oplax_map", "description": "", "p": "math