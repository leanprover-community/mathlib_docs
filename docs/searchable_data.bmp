ctional_ideal.coe_le_coe", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.is_fractional_of_le_one", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mem_span_singleton_self", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_eq", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.val_eq_coe", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.canonical_equiv_flip", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.le_zero_iff", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.le_div_iff_mul_le", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.map_one", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.canonical_equiv_coe_ideal", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.map_coe_ideal", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_inf", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mem_canonical_equiv_apply", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mem_span_mul_finite_of_mem_mul", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_ne_one", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mem_zero_iff", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_copy", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.one_le", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mem_singleton_mul", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_mk", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_injective'", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.map_one_div", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_eq_zero'", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.add_comm_group", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.mem_span_singleton", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.ne_zero_of_mul_eq_one", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.map_add", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.span_singleton_le_iff_mem", "description": "", "p": "mathlib"}, {"name": "is_fractional", "description": "A submodule `I` is a fractional ideal if `a I \u2286 R` for some `a \u2260 0`.", "p": "mathlib"}, {"name": "fractional_ideal.coe_mem_one", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.map_equiv_symm", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_nsmul", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.div_span_singleton", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.span_finset_ne_zero", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.map", "description": "`I.map g` is the pushforward of the fractional ideal `I` along the algebra morphism `g`", "p": "mathlib"}, {"name": "fractional_ideal.canonical_equiv_span_singleton", "description": "", "p": "mathlib"}, {"name": "fractional_ideal.coe_ideal_bot", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.zero_le_of_denom", "description": "Shows that all denominators are nonnegative.", "p": "mathlib"}, {"name": "generalized_continued_fraction.le_of_succ_nth_denom", "description": " Shows that `b\u2099 * B\u2099 \u2264 B\u2099\u208a\u2081`, where `b\u2099` is the `n`th partial denominator and `B\u2099\u208a\u2081` and `B\u2099` are\nthe `n + 1`th and `n`th denominator of the continued fraction.", "p": "mathlib"}, {"name": "generalized_continued_fraction.of_part_num_eq_one", "description": "Shows that the partial numerators `a\u1d62` are equal to one.", "p": "mathlib"}, {"name": "generalized_continued_fraction.le_of_succ_succ_nth_continuants_aux_b", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.nth_stream_fr_lt_one", "description": "Shows that the fractional parts of the stream are smaller than one.", "p": "mathlib"}, {"name": "generalized_continued_fraction.abs_sub_convergents_le'", "description": "Shows that `|v - A\u2099 / B\u2099| \u2264 1 / (b\u2099 * B\u2099 * B\u2099)`. This bound is worse than the one shown in\n`gcf.abs_sub_convergents_le`, but sometimes it is easier to apply and sufficient for one's use case.", "p": "mathlib"}, {"name": "generalized_continued_fraction.fib_le_of_continuants_aux_b", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.abs_sub_convergents_le", "description": "Shows that `|v - A\u2099 / B\u2099| \u2264 1 / (B\u2099 * B\u2099\u208a\u2081)`", "p": "mathlib"}, {"name": "generalized_continued_fraction.exists_int_eq_of_part_denom", "description": "Shows that the partial denominators `b\u1d62` correspond to an integer.", "p": "mathlib"}, {"name": "generalized_continued_fraction.of_one_le_nth_part_denom", "description": "Shows that the integer parts of the continued fraction are at least one.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.succ_nth_stream_b_le_nth_stream_fr_inv", "description": "Shows that the `n + 1`th integer part `b\u2099\u208a\u2081` of the stream is smaller or equal than the inverse of\nthe `n`th fractional part `fr\u2099` of the stream.\nThis result is straight-forward as `b\u2099\u208a\u2081` is defined as the floor of `1 / fr\u2099`", "p": "mathlib"}, {"name": "generalized_continued_fraction.sub_convergents_eq", "description": " This lemma follows from the finite correctness proof, the determinant equality, and\nby simplifying the difference.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.one_le_succ_nth_stream_b", "description": "Shows that the integer parts of the stream are at least one.", "p": "mathlib"}, {"name": "generalized_continued_fraction.determinant_aux", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.of_denom_mono", "description": "Shows that the sequence of denominators is monotone, that is `B\u2099 \u2264 B\u2099\u208a\u2081`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.nth_stream_fr_nonneg", "description": "Shows that the fractional parts of the stream are nonnegative.", "p": "mathlib"}, {"name": "generalized_continued_fraction.zero_le_of_continuants_aux_b", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.determinant", "description": "The determinant formula `A\u2099 * B\u2099\u208a\u2081 - B\u2099 * A\u2099\u208a\u2081 = (-1)^(n + 1)`", "p": "mathlib"}, {"name": "generalized_continued_fraction.of_part_num_eq_one_and_exists_int_part_denom_eq", "description": "Shows that the partial numerators `a\u1d62` of the continued fraction are equal to one and the partial\ndenominators `b\u1d62` correspond to integers.", "p": "mathlib"}, {"name": "generalized_continued_fraction.int_fract_pair.nth_stream_fr_nonneg_lt_one", "description": "Shows that the fractional parts of the stream are in `[0,1)`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.succ_nth_fib_le_of_nth_denom", "description": " Shows that the `n`th denominator is greater than or equal to the `n + 1`th fibonacci number,\nthat is `nat.fib (n + 1) \u2264 B\u2099`.", "p": "mathlib"}, {"name": "is_localization.exist_integer_multiples_of_finite", "description": "We can clear the denominators of a finite indexed family of fractions.", "p": "mathlib"}, {"name": "is_localization.is_integer_smul", "description": "", "p": "mathlib"}, {"name": "is_localization.is_integer_add", "description": "", "p": "mathlib"}, {"name": "is_localization.is_integer", "description": " Given `a : S`, `S` a localization of `R`, `is_integer R a` iff `a` is in the image of\nthe localization map from `R` to `S`.", "p": "mathlib"}, {"name": "is_localization.exists_integer_multiple", "description": " Each element `a : S` has an `M`-multiple which is an integer.\n\nThis version multiplies `a` on the left, matching the argument order in the `has_smul` instance.", "p": "mathlib"}, {"name": "is_localization.common_denom", "description": "A choice of a common multiple of the denominators of a `finset`-indexed family of fractions.", "p": "mathlib"}, {"name": "is_localization.exist_integer_multiples_of_finset", "description": "We can clear the denominators of a finite set of fractions.", "p": "mathlib"}, {"name": "is_localization.common_denom_of_finset", "description": "A choice of a common multiple of the denominators of a finite set of fractions.", "p": "mathlib"}, {"name": "is_localization.finset_integer_multiple_image", "description": "", "p": "mathlib"}, {"name": "is_localization.map_integer_multiple", "description": "", "p": "mathlib"}, {"name": "is_localization.is_integer_mul", "description": "", "p": "mathlib"}, {"name": "is_localization.finset_integer_multiple", "description": "The finset of numerators after clearing the denominators of a finite set of fractions.", "p": "mathlib"}, {"name": "is_localization.integer_multiple", "description": " The numerator of a fraction after clearing the denominators\nof a `finset`-indexed family of fractions.", "p": "mathlib"}, {"name": "is_localization.is_integer_zero", "description": "", "p": "mathlib"}, {"name": "is_localization.exist_integer_multiples", "description": "We can clear the denominators of a `finset`-indexed family of fractions.", "p": "mathlib"}, {"name": "is_localization.is_integer_one", "description": "", "p": "mathlib"}, {"name": "is_localization.exists_integer_multiple'", "description": " Each element `a : S` has an `M`-multiple which is an integer.\n\nThis version multiplies `a` on the right, matching the argument order in `localization_map.surj`.", "p": "mathlib"}, {"name": "Action.\u03c1_Aut", "description": "When a group acts, we can lift the action to the group of automorphisms.", "p": "mathlib"}, {"name": "Action.forget_braided_to_monoidal_functor", "description": "", "p": "mathlib"}, {"name": "Action.left_regular", "description": "The `G`-set `G`, acting on itself by left multiplication.", "p": "mathlib"}, {"name": "Action.res_id_hom_app_hom", "description": "", "p": "mathlib"}, {"name": "Action.iso.conj_\u03c1", "description": "", "p": "mathlib"}, {"name": "Action.tensor_unit_iso", "description": " Given an object `X` isomorphic to the tensor unit of `V`, `X` equipped with the trivial action\nis isomorphic to the tensor unit of `Action V G`.", "p": "mathlib"}, {"name": "Action.category_theory.category", "description": "", "p": "mathlib"}, {"name": "Action.hom.comm", "description": "", "p": "mathlib"}, {"name": "Action.forget.category_theory.faithful", "description": "", "p": "mathlib"}, {"name": "Action.hom", "description": "A homomorphism of `Action V G`s is a morphism between the underlying objects,\ncommuting with the action of `G`.", "p": "mathlib"}, {"name": "Action.hom.hom", "description": "A homomorphism of `Action V G`s is a morphism between the underlying objects,\ncommuting with the action of `G`.", "p": "mathlib"}, {"name": "Action.hom.comm'", "description": "A homomorphism of `Action V G`s is a morphism between the underlying objects,\ncommuting with the action of `G`.", "p": "mathlib"}, {"name": "category_theory.functor.map_Action_map_hom", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.functor.category_theory.left_rigid_category", "description": "", "p": "mathlib"}, {"name": "Action.hom.comp", "description": "The composition of two `Action V G` homomorphisms is the composition of the underlying maps.", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.functor_obj_obj", "description": "", "p": "mathlib"}, {"name": "Action.res", "description": "The \"restriction\" functor along a monoid homomorphism `f : G \u27f6 H`,\ntaking actions of `H` to actions of `G`.\n\n(This makes sense for any homomorphism, but the name is natural when `f` is a monomorphism.)", "p": "mathlib"}, {"name": "Action.forget", "description": " (implementation) The forgetful functor from bundled actions to the underlying objects.\n\nUse the `category_theory.forget` API provided by the `concrete_category` instance below,\nrather than using this directly.", "p": "mathlib"}, {"name": "Action.left_dual_\u03c1", "description": "", "p": "mathlib"}, {"name": "Action.left_dual_V", "description": "", "p": "mathlib"}, {"name": "Action.inhabited'", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal_functor.map_Action_to_lax_monoidal_functor_\u03bc_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal_functor.map_Action", "description": " A monoidal functor induces a monoidal functor between\nthe categories of `G`-actions within those categories.", "p": "mathlib"}, {"name": "Action.add_hom", "description": "", "p": "mathlib"}, {"name": "Action.\u03c1_Aut_apply_inv", "description": "", "p": "mathlib"}, {"name": "Action.id_hom", "description": "", "p": "mathlib"}, {"name": "Action.forget\u2082_preserves_zero_morphisms", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_equivalence_comp_evaluation", "description": " The forgetful functor is intertwined by `functor_category_equivalence` with\nevaluation at `punit.star`.", "p": "mathlib"}, {"name": "Action.functor_category_equivalence_counit_iso", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.monoidal_preadditive", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.abelian", "description": "", "p": "mathlib"}, {"name": "Action.tensor_hom", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_equivalence_inverse", "description": "", "p": "mathlib"}, {"name": "Action", "description": "An `Action V G` represents a bundled action of\nthe monoid `G` on an object of some category `V`.\n\nAs an example, when `V = Module R`, this is an `R`-linear representation of `G`,\nwhile when `V = Type` this is a `G`-action.", "p": "mathlib"}, {"name": "Action.V", "description": "An `Action V G` represents a bundled action of\nthe monoid `G` on an object of some category `V`.\n\nAs an example, when `V = Module R`, this is an `R`-linear representation of `G`,\nwhile when `V = Type` this is a `G`-action.", "p": "mathlib"}, {"name": "Action.\u03c1", "description": "An `Action V G` represents a bundled action of\nthe monoid `G` on an object of some category `V`.\n\nAs an example, when `V = Module R`, this is an `R`-linear representation of `G`,\nwhile when `V = Type` this is a `G`-action.", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.inverse_obj_\u03c1_apply", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.unit_iso", "description": "Auxilliary definition for `functor_category_equivalence`.", "p": "mathlib"}, {"name": "Action.right_dual_\u03c1", "description": "", "p": "mathlib"}, {"name": "Action.diagonal_succ_inv_hom", "description": "", "p": "mathlib"}, {"name": "Action.has_forget_to_V", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_monoidal_equivalence.unit_app_hom", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.counit_iso_hom_app_app", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.monoidal_linear", "description": "", "p": "mathlib"}, {"name": "Action.hom.ext", "description": "", "p": "mathlib"}, {"name": "Action.smul_hom", "description": "", "p": "mathlib"}, {"name": "Action.forget_additive", "description": "", "p": "mathlib"}, {"name": "Action.tensor_rho", "description": "", "p": "mathlib"}, {"name": "Action.mk_iso_inv_hom", "description": "", "p": "mathlib"}, {"name": "Action.comp_hom", "description": "", "p": "mathlib"}, {"name": "Action.diagonal", "description": "The `G`-set `G\u207f`, acting on itself by left multiplication.", "p": "mathlib"}, {"name": "Action.forget\u2082_linear", "description": "", "p": "mathlib"}, {"name": "Action.hom.inhabited", "description": "", "p": "mathlib"}, {"name": "Action.mk_iso_hom_hom", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.preadditive", "description": "", "p": "mathlib"}, {"name": "Action.Action_punit_equivalence", "description": "Actions/representations of the trivial group are just objects in the ambient category.", "p": "mathlib"}, {"name": "Action.res_linear", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.left_rigid_category", "description": "If `V` is left rigid, so is `Action V G`.", "p": "mathlib"}, {"name": "Action.zero_hom", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.limits.has_finite_limits", "description": "", "p": "mathlib"}, {"name": "Action.tensor_unit_V", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal_functor.map_Action_to_lax_monoidal_functor_to_functor", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.limits.has_limits", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_monoidal_equivalence.inverse_map", "description": "", "p": "mathlib"}, {"name": "Action.is_iso_of_hom_is_iso", "description": "", "p": "mathlib"}, {"name": "Action.left_regular_tensor_iso_inv_hom", "description": "", "p": "mathlib"}, {"name": "Action.abelian_aux", "description": "Auxilliary construction for the `abelian (Action V G)` instance.", "p": "mathlib"}, {"name": "Action.functor_category_equivalence_unit_iso", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.functor.category_theory.right_rigid_category", "description": "", "p": "mathlib"}, {"name": "Action.res_comp_inv_app_hom", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.functor_def", "description": "", "p": "mathlib"}, {"name": "Action.forget_preserves_zero_morphisms", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Action", "description": " A functor between categories induces a functor between\nthe categories of `G`-actions within those categories.", "p": "mathlib"}, {"name": "Action.\u03c1_Aut_apply_hom", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.limits.has_zero_morphisms", "description": "", "p": "mathlib"}, {"name": "Action.forget_braided_faithful", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.linear", "description": "", "p": "mathlib"}, {"name": "Action.forget_monoidal", "description": "When `V` is monoidal the forgetful functor `Action V G` to `V` is monoidal.", "p": "mathlib"}, {"name": "Action.res_additive", "description": "", "p": "mathlib"}, {"name": "Action.diagonal_succ_hom_hom", "description": "", "p": "mathlib"}, {"name": "Action.right_unitor_hom_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal_functor.map_Action_\u03bc_inv_hom", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.concrete_category", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.counit_iso_inv_app_app", "description": "", "p": "mathlib"}, {"name": "Action.res_obj_V", "description": "", "p": "mathlib"}, {"name": "Action.sum_hom", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.counit_iso", "description": "Auxilliary definition for `functor_category_equivalence`.", "p": "mathlib"}, {"name": "Action.category_theory.braided_category", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Action_linear", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.limits.has_colimits", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_monoidal_equivalence.\u03b5_app", "description": "", "p": "mathlib"}, {"name": "Action.res_obj_\u03c1", "description": "", "p": "mathlib"}, {"name": "Action.res_id", "description": "The natural isomorphism from restriction along the identity homomorphism to\nthe identity functor on `Action V G`.", "p": "mathlib"}, {"name": "Action.forget\u2082_additive", "description": "", "p": "mathlib"}, {"name": "Action.left_regular_\u03c1_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Action_obj_V", "description": "", "p": "mathlib"}, {"name": "Action.forget_map", "description": "", "p": "mathlib"}, {"name": "Action.hom.comp_hom", "description": "", "p": "mathlib"}, {"name": "Action.right_dual_V", "description": "", "p": "mathlib"}, {"name": "Action.inhabited", "description": "", "p": "mathlib"}, {"name": "Action.hom.id", "description": "The identity morphism on a `Action V G`.", "p": "mathlib"}, {"name": "Action.left_regular_tensor_iso", "description": " Given `X : Action (Type u) (Mon.of G)` for `G` a group, then `G \u00d7 X` (with `G` acting as left\nmultiplication on the first factor and by `X.\u03c1` on the second) is isomorphic as a `G`-set to\n`G \u00d7 X` (with `G` acting as left multiplication on the first factor and trivially on the second).\nThe isomorphism is given by `(g, x) \u21a6 (g, g\u207b\u00b9 \u2022 x)`.", "p": "mathlib"}, {"name": "Action.of_mul_action_apply", "description": "", "p": "mathlib"}, {"name": "Action.neg_hom", "description": "", "p": "mathlib"}, {"name": "Action.forget_monoidal_faithful", "description": "", "p": "mathlib"}, {"name": "Action.forget_monoidal_to_lax_monoidal_functor_\u03b5", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Action_obj_\u03c1_apply", "description": "", "p": "mathlib"}, {"name": "Action.to_functor.category_theory.is_equivalence", "description": "", "p": "mathlib"}, {"name": "Action.forget_monoidal_to_lax_monoidal_functor_to_functor", "description": "", "p": "mathlib"}, {"name": "Action.of_mul_action", "description": "Bundles a type `H` with a multiplicative action of `G` as an `Action`.", "p": "mathlib"}, {"name": "Action.functor_category_monoidal_equivalence.functor_map", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.functor_obj_map", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.unit_iso_inv_app_hom", "description": "", "p": "mathlib"}, {"name": "Action.diagonal_\u03c1_apply", "description": "", "p": "mathlib"}, {"name": "Action.left_unitor_hom_hom", "description": "", "p": "mathlib"}, {"name": "Action.is_iso_hom_mk", "description": "", "p": "mathlib"}, {"name": "Action.mk_iso", "description": " Construct an isomorphism of `G` actions/representations\nfrom an isomorphism of the the underlying objects,\nwhere the forward direction commutes with the group action.", "p": "mathlib"}, {"name": "Action.trivial", "description": "The trivial representation of a group.", "p": "mathlib"}, {"name": "Action.category_theory.rigid_category", "description": "If `V` is rigid, so is `Action V G`.", "p": "mathlib"}, {"name": "Action.res_comp_hom_app_hom", "description": "", "p": "mathlib"}, {"name": "Action.left_unitor_inv_hom", "description": "", "p": "mathlib"}, {"name": "Action.forget.category_theory.limits.preserves_limits", "description": "", "p": "mathlib"}, {"name": "Action.category_theory.right_rigid_category", "description": "If `V` is right rigid, so is `Action V G`.", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.inverse", "description": "Auxilliary definition for `functor_category_equivalence`.", "p": "mathlib"}, {"name": "Action.functor_category_equivalence.functor_map_app", "description": "", "p": "mathlib"}, {"name": "Action.diagonal_one_iso_left_regular", "description": "We have `fin 1 \u2192 G \u2245 G` as `G`-sets, with `G` acting by left multiplication.", "p": "mathlib"}, {"name": "Action.category_theory.monoidal_category", "description": "", "p": "mathlib"}, {"name": "Action.forget_braided", "description": "When `V` is braided the forgetful functor `Action V G` to `V` is braided.", "p": "mathlib"}, {"name": "Action.tensor_unit_rho", "description": "", "p": "mathlib"}, {"name": "Action.functor_category_monoidal_equivalence.inv_unit_app_app", "description": "", "p": "mathlib"}, {"name": "Action.res_id_inv_app_hom", "description": "", "p": "mathlib"}, {