ame": "pfun.fix_stop", "description": "If advancing one step from `a` leads to `b : \u03b2`, then `f.fix a = b`", "p": "mathlib"}, {"name": "pfun.preimage_inter", "description": "", "p": "mathlib"}, {"name": "pfun.pure_defined", "description": "", "p": "mathlib"}, {"name": "pfun.mem_dom", "description": "", "p": "mathlib"}, {"name": "pfun.fn", "description": "Evaluate a partial function", "p": "mathlib"}, {"name": "pfun.dom_of_mem_fix", "description": "", "p": "mathlib"}, {"name": "pfun.preimage_as_subtype", "description": "", "p": "mathlib"}, {"name": "pfun.is_lawful_monad", "description": "", "p": "mathlib"}, {"name": "pfun.as_subtype_eq_of_mem", "description": "", "p": "mathlib"}, {"name": "pfun.mem_core_res", "description": "", "p": "mathlib"}, {"name": "pfun.inhabited", "description": "", "p": "mathlib"}, {"name": "pfun.get_prod_map", "description": "", "p": "mathlib"}, {"name": "pfun.dom", "description": "The domain of a partial function", "p": "mathlib"}, {"name": "pfun.eval_opt", "description": "Evaluate a partial function to return an `option`", "p": "mathlib"}, {"name": "pfun.graph", "description": " Graph of a partial function `f` as the set of pairs `(x, f x)` where `x` is in the domain of\n`f`.", "p": "mathlib"}, {"name": "pfun.coe_injective", "description": "", "p": "mathlib"}, {"name": "pfun.fix_induction_spec", "description": "", "p": "mathlib"}, {"name": "pfun.mem_res", "description": "", "p": "mathlib"}, {"name": "pfun.preimage_comp", "description": "", "p": "mathlib"}, {"name": "pfun.mem_prod_map", "description": "", "p": "mathlib"}, {"name": "pfun.id_comp", "description": "", "p": "mathlib"}, {"name": "pfun.comp_assoc", "description": "", "p": "mathlib"}, {"name": "pfun.dom_mk", "description": "", "p": "mathlib"}, {"name": "pfun.lift_eq_coe", "description": "", "p": "mathlib"}, {"name": "pfun.fix_fwd", "description": "", "p": "mathlib"}, {"name": "pfun.as_subtype", "description": "Turns a partial function into a function out of its domain.", "p": "mathlib"}, {"name": "pfun.mem_to_subtype_iff", "description": "", "p": "mathlib"}, {"name": "pfun.dom_to_subtype", "description": "", "p": "mathlib"}, {"name": "pfun.bind_apply", "description": "", "p": "mathlib"}, {"name": "pfun.prod_map_apply", "description": "", "p": "mathlib"}, {"name": "pfun.fix", "description": " First return map. Transforms a partial function `f : \u03b1 \u2192. \u03b2 \u2295 \u03b1` into the partial function\n`\u03b1 \u2192. \u03b2` which sends `a : \u03b1` to the first value in `\u03b2` it hits by iterating `f`, if such a value\nexists. By abusing notation to illustrate, either `f a` is in the `\u03b2` part of `\u03b2 \u2295 \u03b1` (in which\ncase `f.fix a` returns `f a`), or it is undefined (in which case `f.fix a` is undefined as well), or\nit is in the `\u03b1` part of `\u03b2 \u2295 \u03b1` (in which case we repeat the procedure, so `f.fix a` will return\n`f.fix (f a)`).", "p": "mathlib"}, {"name": "pfun.mem_preimage", "description": "", "p": "mathlib"}, {"name": "pfun.lift_graph", "description": "", "p": "mathlib"}, {"name": "pfun.equiv_subtype", "description": " The type of partial functions `\u03b1 \u2192. \u03b2` is equivalent to\nthe type of pairs `(p : \u03b1 \u2192 Prop, f : subtype p \u2192 \u03b2)`.", "p": "mathlib"}, {"name": "pfun", "description": "`pfun \u03b1 \u03b2`, or `\u03b1 \u2192. \u03b2`, is the type of partial functions from\n `\u03b1` to `\u03b2`. It is defined as `\u03b1 \u2192 part \u03b2`.", "p": "mathlib"}, {"name": "pfun.fix_induction'_fwd", "description": "", "p": "mathlib"}, {"name": "pfun.preimage_eq", "description": "", "p": "mathlib"}, {"name": "pfun.id", "description": "The identity as a partial function", "p": "mathlib"}, {"name": "pfun.comp_id", "description": "", "p": "mathlib"}, {"name": "pfun.core_eq", "description": "", "p": "mathlib"}, {"name": "pfun.preimage", "description": "Preimage of a set under a partial function.", "p": "mathlib"}, {"name": "pfun.fix_fwd_eq", "description": "If advancing one step from `a` on `f` leads to `a' : \u03b1`, then `f.fix a = f.fix a'`", "p": "mathlib"}, {"name": "pfun.to_subtype_apply", "description": "", "p": "mathlib"}, {"name": "pfun.dom_eq", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.add_left_symm", "description": "", "p": "mathlib"}, {"name": "metric.preimage_add_right_closed_ball", "description": "", "p": "mathlib"}, {"name": "metric.smul_closed_ball", "description": "", "p": "mathlib"}, {"name": "has_isometric_vadd.to_has_continuous_const_vadd", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.sub_left_apply", "description": "", "p": "mathlib"}, {"name": "edist_inv", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.add_right_symm", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.div_right", "description": "Division `y \u21a6 y / x` as an `isometry_equiv`.", "p": "mathlib"}, {"name": "pi.has_isometric_smul''", "description": "", "p": "mathlib"}, {"name": "has_isometric_smul.opposite_of_comm", "description": "", "p": "mathlib"}, {"name": "metric.smul_sphere", "description": "", "p": "mathlib"}, {"name": "dist_add_right", "description": "", "p": "mathlib"}, {"name": "isometry_add_right", "description": "", "p": "mathlib"}, {"name": "dist_div_right", "description": "", "p": "mathlib"}, {"name": "nndist_add_right", "description": "", "p": "mathlib"}, {"name": "dist_div_left", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.add_left", "description": "Addition `y \u21a6 x + y` as an `isometry_equiv`.", "p": "mathlib"}, {"name": "isometry_equiv.sub_left_to_equiv", "description": "", "p": "mathlib"}, {"name": "dist_neg_neg", "description": "", "p": "mathlib"}, {"name": "nndist_sub_right", "description": "", "p": "mathlib"}, {"name": "metric.vadd_sphere", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.sub_right_to_equiv", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.mul_right_to_equiv", "description": "", "p": "mathlib"}, {"name