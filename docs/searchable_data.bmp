ib"}, {"name": "finset.disj_Union", "description": " `disj_Union s f h` is the set such that `a \u2208 disj_Union s f` iff `a \u2208 f i` for some `i \u2208 s`.\nIt is the same as `s.bUnion f`, but it does not require decidable equality on the type. The\nhypothesis ensures that the sets are disjoint.", "p": "mathlib"}, {"name": "finset.erase_inj", "description": "", "p": "mathlib"}, {"name": "multiset.to_finset_inter", "description": "", "p": "mathlib"}, {"name": "finset.to_list_eq_singleton_iff", "description": "", "p": "mathlib"}, {"name": "finset.mem_of_mem_inter_left", "description": "", "p": "mathlib"}, {"name": "multiset.to_finset_nsmul", "description": "", "p": "mathlib"}, {"name": "finset.nontrivial", "description": "A finset is nontrivial if it has at least two elements.", "p": "mathlib"}, {"name": "finset.erase_eq_empty_iff", "description": "", "p": "mathlib"}, {"name": "finset.erase_union_of_mem", "description": "", "p": "mathlib"}, {"name": "finset.to_list_insert", "description": "", "p": "mathlib"}, {"name": "finset.filter_ne'", "description": "", "p": "mathlib"}, {"name": "finset.disjoint_of_erase_right", "description": "", "p": "mathlib"}, {"name": "multiset.to_finset_add", "description": "", "p": "mathlib"}, {"name": "finset.inter_subset_union", "description": "", "p": "mathlib"}, {"name": "finset.insert_union", "description": "", "p": "mathlib"}, {"name": "finset.mem_of_subset", "description": "", "p": "mathlib"}, {"name": "finset.filter_union", "description": "", "p": "mathlib"}, {"name": "finset.filter_cons_of_pos", "description": "", "p": "mathlib"}, {"name": "finset.piecewise_eq_of_mem", "description": "", "p": "mathlib"}, {"name": "finset.range_zero", "description": "", "p": "mathlib"}, {"name": "finset.to_list", "description": "Produce a list of the elements in the finite set using choice.", "p": "mathlib"}, {"name": "finset.insert_sdiff_insert", "description": "", "p": "mathlib"}, {"name": "finset.nonempty.forall_const", "description": "", "p