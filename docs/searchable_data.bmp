mathlib"}, {"name": "disjoint.sup_right", "description": "", "p": "mathlib"}, {"name": "disjoint_iff", "description": "", "p": "mathlib"}, {"name": "disjoint.of_disjoint_inf_of_le'", "description": "", "p": "mathlib"}, {"name": "disjoint_right_comm", "description": "", "p": "mathlib"}, {"name": "codisjoint.mono_right", "description": "", "p": "mathlib"}, {"name": "complementeds.coe_inj", "description": "", "p": "mathlib"}, {"name": "disjoint.le_bot", "description": "", "p": "mathlib"}, {"name": "disjoint.eq_bot", "description": "", "p": "mathlib"}, {"name": "symmetric_disjoint", "description": "", "p": "mathlib"}, {"name": "is_complemented_top", "description": "", "p": "mathlib"}, {"name": "codisjoint_inf_left", "description": "", "p": "mathlib"}, {"name": "codisjoint.eq_top", "description": "", "p": "mathlib"}, {"name": "codisjoint.mono_left", "description": "", "p": "mathlib"}, {"name": "codisjoint_of_dual_iff", "description": "", "p": "mathlib"}, {"name": "is_compl.inf_sup", "description": "", "p": "mathlib"}, {"name": "complementeds.coe_sup", "description": "", "p": "mathlib"}, {"name": "disjoint.mono", "description": "", "p": "mathlib"}, {"name": "codisjoint_assoc", "description": "", "p": "mathlib"}, {"name": "prod.disjoint_iff", "description": "", "p": "mathlib"}, {"name": "is_compl_bot_top", "description": "", "p": "mathlib"}, {"name": "codisjoint_self", "description": "", "p": "mathlib"}, {"name": "disjoint.left_le_of_le_sup_left", "description": "", "p": "mathlib"}, {"name": "is_compl.of_eq", "description": "", "p": "mathlib"}, {"name": "codisjoint_top_right", "description": "", "p": "mathlib"}, {"name": "complementeds.coe_inf", "description": "", "p": "mathlib"}, {"name": "disjoint.mono_left", "description": "", "p": "mathlib"}, {"name": "disjoint.inf_left", "description": "", "p": "mathlib"}, {"name": "disjoint.comm", "description": "", "p": "mathlib"}, {"name": "complementeds.is_compl_coe", "description": "", "p": "mathlib"}, {"name": "complementeds.coe_top", "description": "", "p": "mathlib"}, {"name": "codisjoint.left_le_of_le_inf_right", "description": "", "p": "mathlib"}, {"name": "complementeds.has_sup", "description": "", "p": "mathlib"}, {"name": "codisjoint.inf_right", "description": "", "p": "mathlib"}, {"name": "codisjoint.ne", "description": "", "p": "mathlib"}, {"name": "complementeds.has_inf", "description": "", "p": "mathlib"}, {"name": "symmetric_codisjoint", "description": "", "p": "mathlib"}, {"name": "codisjoint_to_dual_iff", "description": "", "p": "mathlib"}, {"name": "disjoint_of_dual_iff", "description": "", "p": "mathlib"}, {"name": "is_compl_of_dual_iff", "description": "", "p": "mathlib"}, {"name": "codisjoint", "description": " Two elements of a lattice are codisjoint if their sup is the top element.\n\nNote that we define this without reference to `\u2294`, as this allows us to talk about orders where\nthe supremum is not unique, or where implement `has_sup` would require additional `decidable`\narguments.", "p": "mathlib"}, {"name": "complementeds.distrib_lattice", "description": "", "p": "mathlib"}, {"name": "disjoint.inf_right", "description": "", "p": "mathlib"}, {"name": "codisjoint_right_comm", "description": "", "p": "mathlib"}, {"name": "disjoint.le_of_codisjoint", "description": "", "p": "mathlib"}, {"name": "codisjoint.eq_top_of_ge", "description": "", "p": "mathlib"}, {"name": "disjoint.left_le_of_le_sup_right", "description": "", "p": "mathlib"}, {"name": "codisjoint_bot", "description": "", "p": "mathlib"}, {"name": "codisjoint.eq_top_of_self", "description": "**Alias** of the forward direction of `codisjoint_self`.", "p": "mathlib"}, {"name": "complementeds.mk_inf_mk", "description": "", "p": "mathlib"}, {"name": "is_compl_to_dual_iff", "description": "", "p": "mathlib"}, {"name": "complemented_lattice.order_dual.complemented_lattice", "description": "", "p": "mathlib"}, {"name": "is_compl", "description": "Two elements `x` and `y` are complements of each other if `x \u2294