n_principal_eq_Sup", "description": "", "p": "mathlib"}, {"name": "filter.map_eq_comap_of_inverse", "description": "", "p": "mathlib"}, {"name": "function.commute.filter_comap", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.union", "description": "", "p": "mathlib"}, {"name": "filter.eventually_le.le_sup_of_le_left", "description": "", "p": "mathlib"}, {"name": "filter.mem_of_eq_bot", "description": "", "p": "mathlib"}, {"name": "filter.univ_mem'", "description": "", "p": "mathlib"}, {"name": "filter.filter_eq", "description": "", "p": "mathlib"}, {"name": "filter.comap_eval_ne_bot", "description": "", "p": "mathlib"}, {"name": "pairwise.exists_mem_filter_of_disjoint", "description": "", "p": "mathlib"}, {"name": "filter.eventually_le_bind", "description": "", "p": "mathlib"}, {"name": "filter.comap_principal", "description": "", "p": "mathlib"}, {"name": "filter.frequently.filter_mono", "description": "", "p": "mathlib"}, {"name": "filter.set_eventually_le_iff_inf_principal_le", "description": "", "p": "mathlib"}, {"name": "filter.map_compose", "description": "", "p": "mathlib"}, {"name": "filter.tendsto_principal_principal", "description": "", "p": "mathlib"}, {"name": "filter.bind_le", "description": "", "p": "mathlib"}, {"name": "tactic_doc.tactic.filter_upwards", "description": "`filter_upwards [h\u2081, \u22ef, h\u2099]` replaces a goal of the form `s \u2208 f` and terms\n`h\u2081 : t\u2081 \u2208 f, \u22ef, h\u2099 : t\u2099 \u2208 f` with `\u2200 x, x \u2208 t\u2081 \u2192 \u22ef \u2192 x \u2208 t\u2099 \u2192 x \u2208 s`.\nThe list is an optional parameter, `[]` being its default value.\n\n`filter_upwards [h\u2081, \u22ef, h\u2099] with a\u2081 a\u2082 \u22ef a\u2096` is a short form for\n`{ filter_upwards [h\u2081, \u22ef, h\u2099], intros a\u2081 a\u2082 \u22ef a\u2096 }`.\n\n`filter_upwards [h\u2081, \u22ef, h\u2099] using e` is a short form for\n`{ filter_upwards [h1, \u22ef, hn], exact e }`.\n\nCombining both shortcuts is done by writing `filter_upwards [h\u2081, \u22ef, h\u2099] with a\u2081 a\u2082 \u22ef a\u2096 using e`.\nNote that in this case, the `a\u1d62` terms can be used in `e`.", "p": "mathlib"}, {"name": "filter.tendsto_pure_left", "description": "", "p": "mathlib"}, {"name": "filter.le_pure_iff", "description": "", "p": "mathlib"}, {"name": "filter.eventually_imp_distrib_right", "description": "", "p": "mathlib"}, {"name": "filter.infi_principal_finset", "description": "", "p": "mathlib"}, {"name": "filter.principal_bind", "description": "", "p": "mathlib"}, {"name": "filter.mem_inf_of_right", "description": "", "p": "mathlib"}, {"name": "filter.eventually_const", "description": "", "p": "mathlib"}, {"name": "filter.has_top", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot.comap_of_range_mem", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.const_vadd", "description": "", "p": "mathlib"}, {"name": "filter.generate_empty", "description": "", "p": "mathlib"}, {"name": "filter.tendsto_inf", "description": "", "p": "mathlib"}, {"name": "filter.set_eventually_le_iff_mem_inf_principal", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.filter_upwards", "description": "`filter_upwards [h\u2081, \u22ef, h\u2099]` replaces a goal of the form `s \u2208 f` and terms\n`h\u2081 : t\u2081 \u2208 f, \u22ef, h\u2099 : t\u2099 \u2208 f` with `\u2200 x, x \u2208 t\u2081 \u2192 \u22ef \u2192 x \u2208 t\u2099 \u2192 x \u2208 s`.\nThe list is an optional parameter, `[]` being its default value.\n\n`filter_upwards [h\u2081, \u22ef, h\u2099] with a\u2081 a\u2082 \u22ef a\u2096` is a short form for\n`{ filter_upwards [h\u2081, \u22ef, h\u2099], intros a\u2081 a\u2082 \u22ef a\u2096 }`.\n\n`filter_upwards [h\u2081, \u22ef, h\u2099] using e` is a short form for\n`{ filter_upwards [h1, \u22ef, hn], exact e }`.\n\nCombining both shortcuts is done by writing `filter_upwards [h\u2081, \u22ef, h\u2099] with a\u2081 a\u2082 \u22ef a\u2096 using e`.\nNote that in this case, the `a\u1d62` terms can be used in `e`.", "p": "mathlib"}, {"name": "filter.ne_bot_of_le", "description": "", "p": "mathlib"}, {"name": "filter.seq_assoc", "description": "", "p": "mathlib"}, {"name": "filter.tendsto_map", "description": "", "p": "mathlib"}, {"name": "filter.monotone_principal", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot.map", "description": "", "p": "mathlib"}, {"name": "filter.comap_infi", "description": "", "p": "mathlib"}, {"name": "filter.diff_mem_inf_principal_compl", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.if", "description": "", "p": "mathlib"}, {"name": "filter.comap_ne_bot_iff_frequently", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot", "description": " A filter is `ne_bot` if it is not equal to `\u22a5`, or equivalently the empty set\ndoes not belong to the filter. Bourbaki include this assumption in the definition\nof a filter but we prefer to have a `complete_lattice` structure on filter, so\nwe use a typeclass argument in lemmas instead.", "p": "mathlib"}, {"name": "filter.ne_bot.ne'", "description": " A filter is `ne_bot` if it is not equal to `\u22a5`, or equivalently the empty set\ndoes not belong to the filter. Bourbaki include this assumption in the definition\nof a filter but we prefer to have a `complete_lattice` structure on filter, so\nwe use a typeclass argument in lemmas instead.", "p": "mathlib"}, {"name": "filter.frequently_or_distrib", "description": "", "p": "mathlib"}, {"name": "filter.eventually_le.sup", "description": "", "p": "mathlib"}, {"name": "filter.mp_mem", "description": "", "p": "mathlib"}, {"name": "filter.map_comap", "description": "", "p": "mathlib"}, {"name": "filter.le_map_iff", "description": "", "p": "mathlib"}, {"name": "filter.le_comap_map", "description": "", "p": "mathlib"}, {"name": "set.finite.eventually_all", "description": "**Alias** of `filter.eventually_all_finite`.", "p": "mathlib"}, {"name": "filter.mem_traverse_iff", "description"