e": "sum.map", "description": "Map `\u03b1 \u2295 \u03b2` to `\u03b1' \u2295 \u03b2'` sending `\u03b1` to `\u03b1'` and `\u03b2` to `\u03b2'`.", "p": "mathlib"}, {"name": "sum.elim_inl", "description": "", "p": "mathlib"}, {"name": "sum.inl.inj_iff", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel_inr_inr", "description": "", "p": "mathlib"}, {"name": "sum.get_right_eq_none_iff", "description": "", "p": "mathlib"}, {"name": "sum.is_left_swap", "description": "", "p": "mathlib"}, {"name": "sum.map_bijective", "description": "", "p": "mathlib"}, {"name": "sum.lex.mono", "description": "", "p": "mathlib"}, {"name": "sum.lex_wf", "description": "", "p": "mathlib"}, {"name": "sum.elim_comp_inl", "description": "", "p": "mathlib"}, {"name": "sum.get_right_swap", "description": "", "p": "mathlib"}, {"name": "sum.update_inl_comp_inl", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel.swap", "description": "", "p": "mathlib"}, {"name": "sum3.in\u2080", "description": "The map from the first summand into a ternary sum.", "p": "mathlib"}, {"name": "sum.update_inl_apply_inr", "description": "", "p": "mathlib"}, {"name": "sum.not_is_left", "description": "", "p": "mathlib"}, {"name": "sum.is_left", "description": "Check if a sum is `inl`.", "p": "mathlib"}, {"name": "sum.lex_inl_inl", "description": "", "p": "mathlib"}, {"name": "sum.elim_comp_inr", "description": "", "p": "mathlib"}, {"name": "sum.elim_map", "description": "", "p": "mathlib"}, {"name": "sum.get_left_eq_some_iff", "description": "", "p": "mathlib"}, {"name": "sum.lex.decidable_rel", "description": "", "p": "mathlib"}, {"name": "sum.inl_injective", "description": "", "p": "mathlib"}, {"name": "sum.update_inr_apply_inr", "description": "", "p": "mathlib"}, {"name": "sum.lex_acc_inl", "description": "", "p": "mathlib"}, {"name": "sum.is_left_map", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel_inl_inl", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel_subrelation_lex", "description": "", "p": "mathlib"}, {"name": "sum.update_inl_comp_inr", "description": "", "p": "mathlib"}, {"name": "sum.update_elim_inl", "description": "", "p": "mathlib"}, {"name": "sum.map_map", "description": "", "p": "mathlib"}, {"name": "sum.lex", "description": " Lexicographic order for sum. Sort all the `inl a` before the `inr b`, otherwise use the\nrespective order on `\u03b1` or `\u03b2`.", "p": "mathlib"}, {"name": "sum.lex.inl", "description": " Lexicographic order for sum. Sort all the `inl a` before the `inr b`, otherwise use the\nrespective order on `\u03b1` or `\u03b2`.", "p": "mathlib"}, {"name": "sum.lex.inr", "description": " Lexicographic order for sum. Sort all the `inl a` before the `inr b`, otherwise use the\nrespective order on `\u03b1` or `\u03b2`.", "p": "mathlib"}, {"name": "sum.lex.sep", "description": " Lexicographic order for sum. Sort all the `inl a` before the `inr b`, otherwise use the\nrespective order on `\u03b1` or `\u03b2`.", "p": "mathlib"}, {"name": "sum.inl_ne_inr", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel.lex", "description": "", "p": "mathlib"}, {"name": "sum.lex_inr_inr", "description": "", "p": "mathlib"}, {"name": "sum.is_right_map", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel.mono_left", "description": "", "p": "mathlib"}, {"name": "sum.lex.mono_left", "description": "", "p": "mathlib"}, {"name": "sum.elim_inr", "description": "", "p": "mathlib"}, {"name": "sum.lex.mono_right", "description": "", "p": "mathlib"}, {"name": "sum.exists", "description": "", "p": "mathlib"}, {"name": "sum.swap_swap_eq", "description": "", "p": "mathlib"}, {"name": "sum.swap_swap", "description": "", "p": "mathlib"}, {"name": "sum.swap_left_inverse", "description": "", "p": "mathlib"}, {"name": "sum.lex_inr_inl", "description": "", "p": "mathlib"}, {"name": "sum.forall", "description": "", "p": "mathlib"}, {"name": "sum.map_injective", "description": "", "p": "mathlib"}, {"name": "function.injective.sum_map", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel", "description": " Lifts pointwise two relations between `\u03b1` and `\u03b3` and between `\u03b2` and `\u03b4` to a relation between\n`\u03b1 \u2295 \u03b2` and `\u03b3 \u2295 \u03b4`.", "p": "mathlib"}, {"name": "sum.lift_rel.inl", "description": " Lifts pointwise two relations between `\u03b1` and `\u03b3` and between `\u03b2` and `\u03b4` to a relation between\n`\u03b1 \u2295 \u03b2` and `\u03b3 \u2295 \u03b4`.", "p": "mathlib"}, {"name": "sum.lift_rel.inr", "description": " Lifts pointwise two relations between `\u03b1` and `\u03b3` and between `\u03b2` and `\u03b4` to a relation between\n`\u03b1 \u2295 \u03b2` and `\u03b3 \u2295 \u03b4`.", "p": "mathlib"}, {"name": "sum.is_right_iff", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel.mono_right", "description": "", "p": "mathlib"}, {"name": "sum.get_left_swap", "description": "", "p": "mathlib"}, {"name": "sum.get_right_eq_some_iff", "description": "", "p": "mathlib"}, {"name": "sum.update_inl_apply_inl", "description": "", "p": "mathlib"}, {"name": "sum.get_right_map", "description": "", "p": "mathlib"}, {"name": "sum.inr_ne_inl", "description": "", "p": "mathlib"}, {"name": "sum3.in\u2081", "description": "The map from the second summand into a ternary sum.", "p": "mathlib"}, {"name": "sum.decidable_eq", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel_swap_iff", "description": "", "p": "mathlib"}, {"name": "sum.elim_const_const", "description": "", "p": "mathlib"}, {"name": "sum.elim_inl_inr", "description": "", "p": "mathlib"}, {"name": "sum.map_surjective", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel.mono", "description": "", "p": "mathlib"}, {"name": "sum.lift_rel.decidable", "description": "", "p": "mathlib"}, {"name": "sum.bnot_is_left", "description": "", "p": "mathlib"}, {"name": "sum.map_comp_map", "description": "", "p": "mathlib"}, {"name": "sum.inr.inj_iff", "description": "", "p": "mathlib"}, {"name": "sum3.in\u2082", "description": "The map from the third summand into a ternary sum.", "p": "mathlib"}, {"name": "sum.not_lift_rel_inr_inl", "description": "", "p": "mathlib"}, {"name": "sum.update_inr_comp_inr", "description": "", "p": "mathlib"}, {"name": "sum.is_left_iff", "description": "", "p": "mathlib"}, {"name": "order.ideal.prime_pair", "description": "A pair of an `ideal` and a `pfilter` which form a partition of `P`.", "p": "mathlib"}, {"name": "order.ideal.prime_pair.I", "description": "A pair of an `ideal` and a `pfilter` which form a partition of `P`.", "p": "mathlib"}, {"name": "order.ideal.prime_pair.F", "description": "A pair of an `ideal` and a `pfilter` which form a partition of `P`.", "p": "mathlib"}, {"name": "order.ideal.prime_pair.is_compl_I_F", "description": "A pair of an `ideal` and a `pfilter` which form a partition of `P`.", "p": "mathlib"}, {"name": "order.ideal.is_prime.of_mem_or_mem", "description": "", "p": "mathlib"}, {"name": "order.ideal.prime_pair.I_union_F", "description": "", "p": "mathlib"}, {"name": "order.pfilter.is_prime", "description": "A filter `F` is prime if its complement is an ideal.", "p": "mathlib"}, {"name": "order.pfilter.is_prime.compl_ideal", "description": "A filter `F` is prime if its complement is an ideal.", "p": "mathlib"}, {"name": "order.ideal.prime_pair.disjoint", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_prime.to_prime_pair", "description": " Create an element of type `order.ideal.prime_pair` from an ideal satisfying the predicate\n`order.ideal.is_prime`.", "p": "mathlib"}, {"name": "order.ideal.is_prime_of_mem_or_compl_mem", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_maximal.is_prime", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_prime_iff_mem_or_mem", "description": "", "p": "mathlib"}, {"name": "order.ideal.prime_pair.compl_I_eq_F", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_prime.mem_or_compl_mem", "description": "", "p": "mathlib"}, {"name": "order.ideal.prime_pair.compl_F_eq_I", "description": "", "p": "mathlib"}, {"name": "order.ideal.prime_pair.F_union_I", "description": "", "p": "mathlib"}, {"name": "order.pfilter.is_prime.to_prime_pair", "description": " Create an element of type `order.ideal.prime_pair` from a filter satisfying the predicate\n`order.pfilter.is_prime`.", "p": "mathlib"}, {"name": "order.ideal.is_prime.mem_or_mem", "description": "", "p": "mathlib"}, {"name": "order.ideal.prime_pair.F_is_prime", "description": "", "p": "mathlib"}, {"name": "order.ideal.prime_pair.I_is_proper", "description": "", "p": "mathlib"}, {"name": "order.ideal.prime_pair.I_is_prime", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_prime.mem_compl_of_not_mem", "description": "", "p": "mathlib"}, {"name": "order.pfilter.is_prime_iff", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_prime_iff_mem_or_compl_mem", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_prime_iff", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_prime.is_maximal", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_prime", "description": "An ideal `I` is prime if its complement is a filter.", "p": "mathlib"}, {"name": "order.ideal.is_prime.to_is_proper", "description": "An ideal `I` is prime if its complement is a filter.", "p": "mathlib"}, {"name": "order.ideal.is_prime.compl_filter", "description": "An ideal `I` is prime if its complement is a filter.", "p": "mathlib"}, {"name": "norm_num.le_bit1_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.le_one_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.lt_bit1_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.rat_cast_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.inv_one_div", "description": "", "p": "mathlib"}, {"name": "norm_num.int_mod_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.eval_pow", "description": "Evaluates expressions of the form `a ^ b`, `monoid.npow a b` or `nat.pow a b`.", "p": "mathlib"}, {"name": "norm_num.int_div", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_succ'", "description": "Given `a` natural numeral, returns `(b, \u22a2 a + 1 = b)`.", "p": "mathlib"}, {"name": "norm_num.nat_succ_eq", "description": "", "p": "mathlib"}, {"name": "norm_num.inv_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.zero_lt_one", "description": "", "p": "mathlib"}, {"name": "norm_num.neg_succ_of_nat", "description": "", "p": "mathlib"}, {"name": "norm_num.rat_cast_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.lt_one_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.rat_cast_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.subst_into_mul", "description": "", "p": "mathlib"}, {"name": "norm_num.int_cast_one", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_inv", "description": "Given `a` a rational numeral, returns `(b, \u22a2 a\u207b\u00b9 = b)`.", "p": "mathlib"}, {"name": "norm_num.sle_bit0_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_div", "description": "Given `a`,`b` rational numerals, returns `(c, \u22a2 a / b = c)`.", "p": "mathlib"}, {"name": "norm_num.sub_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_clear_denom", "description": " Given `a` nonnegative rational and `d` a natural number, returns `(b, \u22a2 a * d = b)`.\n(`d` should be a multiple of the denominator of `a`, so that `b` is a natural number.)", "p": "mathlib"}, {"name": "norm_num.div_eq", "description": "", "p": "mathlib"}, {"name": "norm_num.eval_ineq", "description": "Evaluates the inequality operations `=`,`<`,`>`,`\u2264`,`\u2265`,`\u2260` on numerals.", "p": "mathlib"}, {"name": "tactic_doc.attribute.norm_num", "description": " An attribute for adding additional extensions to `norm_num`. To use this attribute, put\n`@[norm_num]` on a tactic of type `expr \u2192 tactic (expr \u00d7 expr)`; the tactic will be called on\nsubterms by `norm_num`, and it is responsible for identifying that the expression is a numerical\nfunction applied to numerals, for example `nat.fib 17`, and should return the reduced numerical\nexpression (which must be in `norm_num`-normal form: a natural or rational numeral, i.e. `37`,\n`12 / 7` or `-(2 / 3)`, although this can be an expression in any type), and the proof that the\noriginal expression is equal to the rewritten expression.\n\nFailure is used to indicate that this tactic does not apply to the term. For performance reasons,\nit is best to detect non-applicability as soon as possible so that the next tactic can have a go,\nso generally it will start with a pattern match and then checking that the arguments to the term\nare numerals or of the appropriate form, followed by proof construction, which should not fail.\n\nPropositions are treated like any other term. The normal form for propositions is `true` or\n`false`, so it should produce a proof of the form `p = true` or `p = false`. `eq_true_intro` can be\nused to help here.", "p": "mathlib"}, {"name": "norm_num.prove_rat_uncast_nat", "description": " Given `a' : \u03b1` a natural numeral, returns `(a : \u211a, \u22a2 \u2191a = a')`.\n(Note that the returned value is on the left of the equality.)", "p": "mathlib"}, {"name": "norm_num.sub_nat_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.clear_denom_le", "description": "", "p": "mathlib"}, {"name": "norm_num.zpow_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.nat_mod", "description": "", "p": "mathlib"}, {"name": "norm_num.match_numeral_result", "description": " The result type of `match_numeral`, either `0`, `1`, or a top level\ndecomposition of `bit0 e` or `bit1 e`. The `other` case means it is not a numeral.", "p": "mathlib"}, {"name": "norm_num.match_numeral_result.zero", "description": " The result type of `match_numeral`, either `0`, `1`, or a top level\ndecomposition of `bit0 e` or `bit1 e`. The `other` case means it is not a numeral.", "p": "mathlib"}, {"name": "norm_num.match_numeral_result.one", "description": " The result type of `match_numeral`, either `0`, `1`, or a top level\ndecomposition of `bit0 e` or `bit1 e`. The `other` case means it is not a numeral.", "p": "mathlib"}, {"name": "norm_num.match_numeral_result.bit0", "description": " The result type of `match_numeral`, either `0`, `1`, or a top level\ndecomposition of `bit0 e` or `bit1 e`. The `other` case means it is not a numeral.", "p": "mathlib"}, {"name": "norm_num.match_numeral_result.bit1", "description": " The result type of `match_numeral`, either `0`, `1`, or a top level\ndecomposition of `bit0 e` or `bit1 e`. The `other` case means it is not a numeral.", "p": "mathlib"}, {"name": "norm_num.match_numeral_result.other", "description": " The result type of `match_numeral`, either `0`, `1`, or a top level\ndecomposition of `bit0 e` or `bit1 e`. The `other` case means it is not a numeral.", "p": "mathlib"}, {"name": "norm_num.adc_bit1_bit0", "description": "", "p": "mathlib"}, {"name": "tactic.instance_cache.mk_bit1", "description": "Faster version of `mk_app ``bit1 [e]`.", "p": "mathlib"}, {"name": "norm_num.mul_neg_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_sle_nat", "description": "Given `a`,`b` natural numerals, proves `\u22a2 a + 1 \u2264 b`.", "p": "mathlib"}, {"name": "norm_num.nat_cast_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.zero_succ", "description": "", "p": "mathlib"}, {"name": "norm_num.lt_bit1_bit1", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.norm_num", "description": " Normalize numerical expressions. Supports the operations\n`+` `-` `*` `/` `^` and `%` over numerical types such as\n`\u2115`, `\u2124`, `\u211a`, `\u211d`, `\u2102` and some general algebraic types,\nand can prove goals of the form `A = B`, `A \u2260 B`, `A < B` and `A \u2264 B`,\nwhere `A` and `B` are numerical expressions.\nIt also has a relatively simple primality prover.", "p": "mathlib"}, {"name": "norm_num.clear_denom_mul", "description": "", "p": "mathlib"}, {"name": "norm_num.eval_field", "description": " Evaluates the basic field operations `+`,`neg`,`-`,`*`,`inv`,`/` on numerals.\nAlso handles nat subtraction. Does not do recursive simplification; that is,\n`1 + 1 + 1` will not simplify but `2 + 1` will. This is handled by the top level\n`simp` call in `norm_num.derive`.", "p": "mathlib"}, {"name": "norm_num.rat_cast_div", "description": "", "p": "mathlib"}, {"name": "norm_num.clear_denom_lt", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_sub", "description": "Given `a`,`b` rational numerals, returns `(c, \u22a2 a - b = c)`.", "p": "mathlib"}, {"name": "norm_num.true_intro", "description": "Given `\u22a2 p`, returns `(true, \u22a2 p = true)`.", "p": "mathlib"}, {"name": "norm_num.ne_zero_of_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_pos", "description": "Given `a` a rational numeral, returns `\u22a2 0 < a`.", "p": "mathlib"}, {"name": "norm_num.prove_nat_succ", "description": " Evaluates the expression `nat.succ ... (nat.succ n)` where `n` is a natural numeral.\n(We could also just handle `nat.succ n` here and rely on `simp` to work bottom up, but we figure\nthat towers of successors coming from e.g. `induction` are a common case.)", "p": "mathlib"}, {"name": "norm_num.sle_one_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.adc_bit0_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.add_neg_pos_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.sub_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.zpow_neg", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num", "description": " Normalize numerical expressions. It uses the provided `step` tactic to simplify the expression;\nuse `get_step` to get the default `norm_num` set and `derive.step` for the basic builtin set of\nsimplifications.", "p": "mathlib"}, {"name": "norm_num.derive'", "description": "Simplify an expression bottom-up using `step` to simplify the subexpressions.", "p": "mathlib"}, {"name": "norm_num.nat_cast_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.adc_bit1_one", "description": "", "p": "mathlib"}, {"name": "norm_num.int_cast_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.sle_bit1_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_add_rat'", "description": "Given `a`,`b` rational numerals, returns `(c, \u22a2 a + b = c)`.", "p": "mathlib"}, {"name": "norm_num.lt_one_bit1", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.norm_num1", "description": "Basic version of `norm_num` that does not call `simp`.", "p": "mathlib"}, {"name": "norm_num.prove_mul_nat", "description": "Given `a`,`b` natural numerals, returns `(r, \u22a2 a * b = r)`.", "p": "mathlib"}, {"name": "norm_num.not_refl_false_intro", "description": "", "p": "mathlib"}, {"name": "norm_num.nonneg_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_le_rat", "description": "Given `a`,`b` rational numerals, proves `\u22a2 a \u2264 b`.", "p": "mathlib"}, {"name": "norm_num.lt_neg_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.subst_into_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.match_numeral", "description": "Unfold the top level constructor of the numeral expression.", "p": "mathlib"}, {"name": "norm_num.sle_bit0_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.ne_zero_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_clear_denom_simple", "description": " Given `a` a nonnegative rational numeral, returns `(b, c, \u22a2 a * b = c)`\nwhere `b` and `c` are natural numerals. (`b` will be the denominator of `a`.)", "p": "mathlib"}, {"name": "conv.interactive.norm_num", "description": " Normalize numerical expressions. Supports the operations\n`+` `-` `*` `/` `^` and `%` over numerical types such as\n`\u2115`, `\u2124`, `\u211a`, `\u211d`, `\u2102` and some general algebraic types,\nand can prove goals of the form `A = B`, `A \u2260 B`, `A < B` and `A \u2264 B`,\nwhere `A` and `B` are numerical expressions.\nIt also has a relatively simple primality prover.", "p": "mathlib"}, {"name": "tactic.norm_num1", "description": " Basic version of `norm_num` that does not call `simp`. It uses the provided `step` tactic\nto simplify the expression; use `get_step` to get the default `norm_num` set and `derive.step` for\nthe basic builtin set of simplifications.", "p": "mathlib"}, {"name": "norm_num.prove_lt_rat", "description": "Given `a`,`b` rational numerals, proves `\u22a2 a < b`.", "p": "mathlib"}, {"name": "norm_num.one_succ", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_lt_nonneg_rat", "description": "Given `a`,`b` nonnegative rational numerals, proves `\u22a2 a < b`.", "p": "mathlib"}, {"name": "norm_num.get_step", "description": " Look up the `norm_num` extensions in the cache and return a tactic extending `derive.step` with\nadditional reduction procedures.", "p": "mathlib"}, {"name": "norm_num.prove_int_uncast_nat", "description": " Given `a' : \u03b1` a natural numeral, returns `(a : \u2124, \u22a2 \u2191a = a')`.\n(Note that the returned value is on the left of the equality.)", "p": "mathlib"}, {"name": "tactic.instance_cache.mk_bit0", "description": "Faster version of `mk_app ``bit0 [e]`.", "p": "mathlib"}, {"name": "norm_num.prove_add_nat'", "description": "Given `a`,`b` natural numerals, returns `(r, \u22a2 a + b = r)`.", "p": "mathlib"}, {"name": "norm_num.mul_bit1_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.nat_abs_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.pow_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.add_bit1_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.bit0_succ", "description": "", "p": "mathlib"}, {"name": "norm_num.derive.step", "description": "This version of `derive` does not fail when the input is already a numeral", "p": "mathlib"}, {"name": "norm_num.mul_bit0_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_nat_uncast", "description": " Given `a' : \u03b1` a natural numeral, returns `(a : \u2115, \u22a2 \u2191a = a')`.\n(Note that the returned value is on the left of the equality.)", "p": "mathlib"}, {"name": "norm_num.inv_div_one", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_ne_zero", "description": "Given `a` a rational numeral, returns `\u22a2 a \u2260 0`.", "p": "mathlib"}, {"name": "norm_num.adc_bit1_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.int_cast_ne", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_int_uncast", "description": " Given `a' : \u03b1` an integer numeral, returns `(a : \u2124, \u22a2 \u2191a = a')`.\n(Note that the returned value is on the left of the equality.)", "p": "mathlib"}, {"name": "norm_num.add_neg_pos_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.le_neg_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_clear_denom'", "description": " Given `a` nonnegative rational and `d` a natural number, returns `(b, \u22a2 a * d = b)`.\n(`d` should be a multiple of the denominator of `a`, so that `b` is a natural number.)", "p": "mathlib"}, {"name": "tactic.norm_num_cmd", "description": "The basic usage is `#norm_num e`, where `e` is an expression,\nwhich will print the `norm_num` form of `e`.\n\nSyntax: `#norm_num` (`only`)? (`[` simp lemma list `]`)? (`with` simp sets)? `:`? expression\n\nThis accepts the same options as the `#simp` command.\nYou can specify additional simp lemmas as usual, for example using\n`#norm_num [f, g] : e`, or `#norm_num with attr : e`.\n(The colon is optional but helpful for the parser.)\nThe `only` restricts `norm_num` to using only the provided lemmas, and so\n`#norm_num only : e` behaves similarly to `norm_num1`.\n\nUnlike `norm_num`, this command does not fail when no simplifications are made.\n\n`#norm_num` understands local variables, so you can use them to\nintroduce parameters.", "p": "mathlib"}, {"name": "norm_num.prove_div_mod", "description": "Given `a`,`b` numerals in `nat` or `int`,\n * `prove_div_mod ic a b ff` returns `(c, \u22a2 a / b = c)`\n * `prove_div_mod ic a b tt` returns `(c, \u22a2 a % b = c)`", "p": "mathlib"}, {"name": "norm_num.prove_zpow", "description": "Given `a` a rational numeral and `b : \u2124`, returns `(c, \u22a2 a ^ b = c)`.", "p": "mathlib"}, {"name": "norm_num.nat_div", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.apply_normed", "description": "Normalizes a numerical expression and tries to close the goal with the result.", "p": "mathlib"}, {"name": "norm_num.nat_cast_ne", "description": "", "p": "mathlib"}, {"name": "norm_num.sle_one_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_ne_rat", "description": " Given `a`,`b` rational numerals, proves `\u22a2 a \u2260 b`. This version tries to prove\n`\u22a2 a < b` or `\u22a2 b < a`, and so is not appropriate for types without an order relation.", "p": "mathlib"}, {"name": "norm_num.sub_nat_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.derive", "description": " Simplify an expression bottom-up using the default `norm_num` set to simplify the\nsubexpressions.", "p": "mathlib"}, {"name": "norm_num.zero_adc", "description": "", "p": "mathlib"}, {"name": "norm_num.le_bit0_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.sle_bit1_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.clear_denom_simple_div", "description": "", "p": "mathlib"}, {"name": "norm_num.adc_one_one", "description": "", "p": "mathlib"}, {"name": "norm_num.dvd_eq_nat", "description": "", "p": "mathlib"}, {"name": "norm_num.bit0_mul", "description": "", "p": "mathlib"}, {"name": "norm_num.subst_into_add", "description": "", "p": "mathlib"}, {"name": "norm_num.le_bit1_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.nat_cast_one", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_ne_zero'", "description": "Given `a` a rational numeral, returns `\u22a2 a \u2260 0`.", "p": "mathlib"}, {"name": "norm_num.pow_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.lt_bit0_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.inv_div", "description": "", "p": "mathlib"}, {"name": "norm_num.int_to_nat_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.eval_nat_int_ext", "description": " Evaluates some extra numeric operations on `nat` and `int`, specifically\n`/` and `%`, and `\u2223` (divisibility).", "p": "mathlib"}, {"name": "norm_num.prove_pos_nat", "description": "Given `a` a positive natural numeral, returns `\u22a2 0 < a`.", "p": "mathlib"}, {"name": "norm_num.adc_bit0_one", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_rat_uncast", "description": " Given `a' : \u03b1` a rational numeral, returns `(a : \u211a, \u22a2 \u2191a = a')`.\n(Note that the returned value is on the left of the equality.)", "p": "mathlib"}, {"name": "norm_num.prove_pow", "description": "Given `a` a rational numeral and `b : nat`, returns `(c, \u22a2 a ^ b = c)`.", "p": "mathlib"}, {"name": "norm_num.add_bit0_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.int_to_nat_cast", "description": "", "p": "mathlib"}, {"name": "norm_num.mul_bit0'", "description": "", "p": "mathlib"}, {"name": "norm_num.le_bit0_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_ne", "description": " Given `a`,`b` rational numerals, proves `\u22a2 a \u2260 b`. Currently it tries two methods:\n\n  * Prove `\u22a2 a < b` or `\u22a2 b < a`, if the base type has an order\n  * Embed `\u2191(a':\u211a) = a` and `\u2191(b':\u211a) = b`, and then prove `a' \u2260 b'`.\n    This requires that the base type be `char_zero`, and also that it be a `division_ring`\n    so that the coercion from `\u211a` is well defined.\n\nWe may also add coercions to `\u2124` and `\u2115` as well in order to support `char_zero`\nrings and semirings.", "p": "mathlib"}, {"name": "norm_num.one_add", "description": "", "p": "mathlib"}, {"name": "norm_num.adc_one_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.ge_intro", "description": "", "p": "mathlib"}, {"name": "norm_num.adc_bit0_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_nonneg", "description": "Given `a` a rational numeral, returns `\u22a2 0 \u2264 a`.", "p": "mathlib"}, {"name": "norm_num.mul_neg_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_mul_rat", "description": "Given `a`,`b` rational numerals, returns `(c, \u22a2 a * b = c)`.", "p": "mathlib"}, {"name": "norm_num.add_pos_neg_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.int_mod", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_mul_nonneg_rat", "description": "Given `a`,`b` nonnegative rational numerals, returns `(c, \u22a2 a * b = c)`.", "p": "mathlib"}, {"name": "expr.norm_num", "description": " Carry out similar operations as `tactic.norm_num` but on an `expr` rather than a location.\nGiven an expression `e`, returns `(e', \u22a2 e = e')`.\nThe `no_dflt`, `hs`, and `attr_names` are passed on to `simp`.\nUnlike `norm_num`, this tactic does not fail.", "p": "mathlib"}, {"name": "norm_num.nat_abs_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_add_nat", "description": "Given `a`,`b`,`r` natural numerals, proves `\u22a2 a + b = r`.", "p": "mathlib"}, {"name": "norm_num.match_sign", "description": "`match_sign (- e) = inl e`, `match_sign 0 = inr ff`, otherwise `inr tt`", "p": "mathlib"}, {"name": "norm_num.prove_neg", "description": "Given `a` a rational numeral, returns `(b, \u22a2 -a = b)`.", "p": "mathlib"}, {"name": "norm_num.prove_add_rat", "description": "Given `a`,`b`,`c` rational numerals, returns `\u22a2 a + b = c`.", "p": "mathlib"}, {"name": "norm_num.add_pos_neg_neg", "description": "", "p": "mathlib"}, {"name": "tactic_doc.tactic.norm_num", "description": "Normalises numerical expressions. It supports the operations `+` `-` `*` `/` `^` and `%` over\nnumerical types such as `\u2115`, `\u2124`, `\u211a`, `\u211d`, `\u2102`, and can prove goals of the form `A = B`, `A \u2260 B`,\n`A < B` and `A \u2264 B`, where `A` and `B` are numerical expressions.\n\nAdd-on tactics marked as `@[norm_num]` can extend the behavior of `norm_num` to include other\nfunctions. This is used to support several other functions on `nat` like `prime`, `min_fac` and\n`factors`.\n```lean\nimport data.real.basic\n\nexample : (2 : \u211d) + 2 = 4 := by norm_num\nexample : (12345.2 : \u211d) \u2260 12345.3 := by norm_num\nexample : (73 : \u211d) < 789/2 := by norm_num\nexample : 123456789 + 987654321 = 1111111110 := by norm_num\nexample (R : Type*) [ring R] : (2 : R) + 2 = 4 := by norm_num\nexample (F : Type*) [linear_ordered_field F] : (2 : F) + 2 < 5 := by norm_num\nexample : nat.prime (2^13 - 1) := by norm_num\nexample : \u00ac nat.prime (2^11 - 1) := by norm_num\nexample (x : \u211d) (h : x = 123 + 456) : x = 579 := by norm_num at h; assumption\n```\n\nThe variant `norm_num1` does not call `simp`.\n\nBoth `norm_num` and `norm_num1` can be called inside the `conv` tactic.\n\nThe tactic `apply_normed` normalises a numerical expression and tries to close the goal with\nthe result. Compare:\n```lean\ndef a : \u2115 := 2^100\n#print a -- 2 ^ 100\n\ndef normed_a : \u2115 := by apply_normed 2^100\n#print normed_a -- 1267650600228229401496703205376\n```", "p": "mathlib"}, {"name": "norm_num.prove_one_le_nat", "description": "Given `a` a rational numeral, returns `\u22a2 1 \u2264 a`.", "p": "mathlib"}, {"name": "norm_num.prove_lt_nat", "description": "Given `a`,`b` natural numerals, proves `\u22a2 a < b`.", "p": "mathlib"}, {"name": "norm_num.gt_intro", "description": "", "p": "mathlib"}, {"name": "norm_num.add_neg_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.lt_bit0_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_succ", "description": " Given `a`, `b` natural numerals, proves `\u22a2 a + 1 = b`, assuming that this is provable.\n(It may prove garbage instead of failing if `a + 1 = b` is false.)", "p": "mathlib"}, {"name": "norm_num.rat_cast_ne", "description": "", "p": "mathlib"}, {"name": "norm_num.int_cast_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.match_neg", "description": "`match_neg (- e) = some e`, otherwise `none`", "p": "mathlib"}, {"name": "norm_num.clear_denom_div", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_le_nonneg_rat", "description": "Given `a`,`b` nonnegative rational numerals, proves `\u22a2 a \u2264 b`.", "p": "mathlib"}, {"name": "norm_num.bit1_succ", "description": "", "p": "mathlib"}, {"name": "norm_num.attr", "description": " An attribute for adding additional extensions to `norm_num`. To use this attribute, put\n`@[norm_num]` on a tactic of type `expr \u2192 tactic (expr \u00d7 expr)`; the tactic will be called on\nsubterms by `norm_num`, and it is responsible for identifying that the expression is a numerical\nfunction applied to numerals, for example `nat.fib 17`, and should return the reduced numerical\nexpression (which must be in `norm_num`-normal form: a natural or rational numeral, i.e. `37`,\n`12 / 7` or `-(2 / 3)`, although this can be an expression in any type), and the proof that the\noriginal expression is equal to the rewritten expression.\n\nFailure is used to indicate that this tactic does not apply to the term. For performance reasons,\nit is best to detect non-applicability as soon as possible so that the next tactic can have a go,\nso generally it will start with a pattern match and then checking that the arguments to the term\nare numerals or of the appropriate form, followed by proof construction, which should not fail.\n\nPropositions are treated like any other term. The normal form for propositions is `true` or\n`false`, so it should produce a proof of the form `p = true` or `p = false`. `eq_true_intro` can be\nused to help here.", "p": "mathlib"}, {"name": "norm_num.mul_pos_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.int_cast_zero", "description": "", "p": "mathlib"}, {"name": "norm_num.add_bit1_bit0", "description": "", "p": "mathlib"}, {"name": "norm_num.int_cast_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.clear_denom_simple_nat", "description": "", "p": "mathlib"}, {"name": "conv.interactive.norm_num1", "description": "Basic version of `norm_num` that does not call `simp`.", "p": "mathlib"}, {"name": "norm_num.int_to_nat_pos", "description": "", "p": "mathlib"}, {"name": "norm_num.inv_one", "description": "", "p": "mathlib"}, {"name": "norm_num.int_div_neg", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_sub_nat", "description": "Given `a : nat`,`b : nat` natural numerals, returns `(c, \u22a2 a - b = c)`.", "p": "mathlib"}, {"name": "norm_num.eval_cast", "description": "Evaluates the `\u2191n` cast operation from `\u2115`, `\u2124`, `\u211a` to an arbitrary type `\u03b1`.", "p": "mathlib"}, {"name": "norm_num.prove_le_nat", "description": "Given `a`,`b` natural numerals, proves `\u22a2 a \u2264 b`.", "p": "mathlib"}, {"name": "norm_num.false_intro", "description": "Given `\u22a2 \u00ac p`, returns `(false, \u22a2 p = false)`.", "p": "mathlib"}, {"name": "norm_num.prove_adc_nat", "description": "Given `a`,`b`,`r` natural numerals, proves `\u22a2 a + b + 1 = r`.", "p": "mathlib"}, {"name": "norm_num.adc_one_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.adc_zero", "description": "", "p": "mathlib"}, {"name": "norm_num.add_bit0_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_rat_uncast_nonneg", "description": " Given `a' : \u03b1` a nonnegative rational numeral, returns `(a : \u211a, \u22a2 \u2191a = a')`.\n(Note that the returned value is on the left of the equality.)", "p": "mathlib"}, {"name": "norm_num.nat_cast_zero", "description": "", "p": "mathlib"}, {"name": "norm_num.prove_add_nonneg_rat", "description": "Given `a`,`b`,`c` nonnegative rational numerals, returns `\u22a2 a + b = c`.", "p": "mathlib"}, {"name": "norm_num.le_one_bit1", "description": "", "p": "mathlib"}, {"name": "norm_num.eval_nat_int", "description": "Evaluates `nat.succ`, `int.to_nat`, `int.nat_abs`, `int.neg_succ_of_nat`.", "p": "mathlib"}, {"name": "norm_num.dvd_eq_int", "description": "", "p": "mathlib"}, {"name": "tactic_doc.command.#norm_num", "description": "The basic usage is `#norm_num e`, where `e` is an expression,\nwhich will print the `norm_num` form of `e`.\n\nSyntax: `#norm_num` (`only`)? (`[` simp lemma list `]`)? (`with` simp sets)? `:`? expression\n\nThis accepts the same options as the `#simp` command.\nYou can specify additional simp lemmas as usual, for example using\n`#norm_num [f, g] : e`, or `#norm_num with attr : e`.\n(The colon is optional but helpful for the parser.)\nThe `only` restricts `norm_num` to using only the provided lemmas, and so\n`#norm_num only : e` behaves similarly to `norm_num1`.\n\nUnlike `norm_num`, this command does not fail when no simplifications are made.\n\n`#norm_num` understands local variables, so you can use them to\nintroduce parameters.", "p": "mathlib"}, {"name": "norm_num.clear_denom_add", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.associator_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.associator_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.whisker_right", "description": "Right whiskering of an oplax natural transformation and a modification.", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.left_unitor_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.bicategory_right_unitor", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.bicategory_hom_category", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.bicategory_associator", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.bicategory_whisker_left", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.whisker_right_app", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.bicategory_left_unitor", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.right_unitor_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.whisker_left", "description": "Left whiskering of an oplax natural transformation and a modification.", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.left_unitor_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_functor.bicategory_whisker_right", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.associator", "description": "Associator for the vertical composition of oplax natural transformations.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.bicategory", "description": "A bicategory structure on the oplax functors between bicategories.", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.right_unitor_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.whisker_left_app", "description": "", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.left_unitor", "description": "Left unitor for the vertical composition of oplax natural transformations.", "p": "mathlib"}, {"name": "category_theory.oplax_nat_trans.right_unitor", "description": "Right unitor for the vertical composition of oplax natural transformations.", "p": "mathlib"}, {"name": "category_theory.oplax_functor.bicategory_to_category_struct", "description": "", "p": "mathlib"}, {"name": "bundle.cont_mdiff_proj", "description": "", "p": "mathlib"}, {"name": "fiber_bundle.charted_space", "description": " A fiber bundle `E` over a base `B` with model fiber `F` is naturally a charted space modelled on\n`B \u00d7 F`.", "p": "mathlib"}, {"name": "vector_prebundle.smooth_coord_change", "description": "A randomly chosen coordinate change on a `smooth_vector_prebundle`, given by\n the field `exists_coord_change`. Note that `a.smooth_coord_change` need not be the same as\n `a.coord_change`.", "p": "mathlib"}, {"name": "vector_prebundle.mk_smooth_coord_change", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.smooth_vector_bundle", "description": "Make a `smooth_vector_bundle` from a `smooth_vector_prebundle`.", "p": "mathlib"}, {"name": "fiber_bundle.charted_space_chart_at", "description": "", "p": "mathlib"}, {"name": "fiber_bundle.charted_space'", "description": " Let `B` be a charted space modelled on `HB`.  Then a fiber bundle `E` over a base `B` with model\nfiber `F` is naturally a charted space modelled on `HB.prod F`.", "p": "mathlib"}, {"name": "bundle.smooth_within_at_proj", "description": "", "p": "mathlib"}, {"name": "bundle.cont_mdiff_at_section", "description": "Characterization of C^n sections of a smooth vector bundle.", "p": "mathlib"}, {"name": "bundle.cont_mdiff_within_at_proj", "description": "", "p": "mathlib"}, {"name": "bundle.smooth_on_proj", "description": "", "p": "mathlib"}, {"name": "smooth_fiberwise_linear.has_groupoid", "description": " For a smooth vector bundle `E` over `B` with fiber modelled on `F`, the change-of-co-ordinates\nbetween two trivializations `e`, `e'` for `E`, considered as charts to `B \u00d7 F`, is smooth and\nfiberwise linear.", "p": "mathlib"}, {"name": "bundle.trivial.smooth_vector_bundle", "description": "A trivial vector bundle over a smooth manifold is a smooth vector bundle.", "p": "mathlib"}, {"name": "vector_prebundle.is_smooth", "description": "Mixin for a `vector_prebundle` stating smoothness of coordinate changes.", "p": "mathlib"}, {"name": "vector_prebundle.is_smooth.exists_smooth_coord_change", "description": "Mixin for a `vector_prebundle` stating smoothness of coordinate changes.", "p": "mathlib"}, {"name": "bundle.cont_mdiff_on_proj", "description": "", "p": "mathlib"}, {"name": "bundle.cont_mdiff_within_at_total_space", "description": "Characterization of C^n functions into a smooth vector bundle.", "p": "mathlib"}, {"name": "bundle.prod.smooth_vector_bundle", "description": "The direct sum of two smooth vector bundles over the same base is a smooth vector bundle.", "p": "mathlib"}, {"name": "bundle.smooth_zero_section", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.smooth_on_smooth_coord_change", "description": "", "p": "mathlib"}, {"name": "fiber_bundle.ext_chart_at", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.smooth_vector_bundle", "description": " If a `vector_bundle_core` has the `is_smooth` mixin, then the vector bundle constructed from it\nis a smooth vector bundle.", "p": "mathlib"}, {"name": "smooth_vector_bundle", "description": " When `B` is a smooth manifold with corners with respect to a model `IB` and `E` is a\ntopological vector bundle over `B` with fibers isomorphic to `F`, then `smooth_vector_bundle F E IB`\nregisters that the bundle is smooth, in the sense of having smooth transition functions.\nThis is a mixin, not carrying any new data`.", "p": "mathlib"}, {"name": "smooth_vector_bundle.smooth_on_coord_change", "description": " When `B` is a smooth manifold with corners with respect to a model `IB` and `E` is a\ntopological vector bundle over `B` with fibers isomorphic to `F`, then `smooth_vector_bundle F E IB`\nregisters that the bundle is smooth, in the sense of having smooth transition functions.\nThis is a mixin, not carrying any new data`.", "p": "mathlib"}, {"name": "bundle.cont_mdiff_at_proj", "description": "", "p": "mathlib"}, {"name": "bundle.cont_mdiff_at_total_space", "description": "Characterization of C^n functions into a smooth vector bundle.", "p": "mathlib"}, {"name": "vector_bundle_core.is_smooth", "description": "Mixin for a `vector_bundle_core` stating smoothness (of transition functions).", "p": "mathlib"}, {"name": "vector_bundle_core.is_smooth.smooth_on_coord_change", "description": "Mixin for a `vector_bundle_core` stating smoothness (of transition functions).", "p": "mathlib"}, {"name": "fiber_bundle.charted_space_chart_at_symm_fst", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.smooth_coord_change_apply", "description": "", "p": "mathlib"}, {"name": "bundle.total_space.smooth_manifold_with_corners", "description": "A smooth vector bundle `E` is naturally a smooth manifold.", "p": "mathlib"}, {"name": "bundle.smooth_at_proj", "description": "", "p": "mathlib"}, {"name": "bundle.smooth_proj", "description": "", "p": "mathlib"}, {"name": "cubic.degree_of_d_eq_zero'", "description": "", "p": "mathlib"}, {"name": "cubic.nat_degree_of_b_eq_zero", "description": "", "p": "mathlib"}, {"name": "cubic.equiv_symm_apply_c", "description": "", "p": "mathlib"}, {"name": "cubic.degree_of_b_eq_zero", "description": "", "p": "mathlib"}, {"name": "cubic.has_zero", "description": "", "p": "mathlib"}, {"name": "cubic.map", "description": "Map a cubic polynomial across a semiring homomorphism.", "p": "mathlib"}, {"name": "cubic.nat_degree_of_a_ne_zero'", "description": "", "p": "mathlib"}, {"name": "cubic.leading_coeff_of_a_ne_zero", "description": "", "p": "mathlib"}, {"name": "cubic.b_of_eq", "description": "", "p": "mathlib"}, {"name": "cubic.degree_of_a_eq_zero'", "description": "", "p": "mathlib"}, {"name": "cubic.splits_iff_roots_eq_three", "description": "", "p": "mathlib"}, {"name": "cubic.a_of_eq", "description": "", "p": "mathlib"}, {"name": "cubic", "description": "The structure representing a cubic polynomial.", "p": "mathlib"}, {"name": "cubic.a", "description": "The structure representing a cubic polynomial.", "p": "mathlib"}, {"name": "cubic.b", "description": "The structure representing a cubic polynomial.", "p": "mathlib"}, {"name": "cubic.c", "description": "Th