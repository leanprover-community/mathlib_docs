nits_affine_map_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.point_reflection", "description": "Point reflection in `x` as a permutation.", "p": "mathlib"}, {"name": "affine_equiv.point_reflection_fixed_iff_of_module", "description": "", "p": "mathlib"}, {"name": "affine_equiv.to_equiv_point_reflection", "description": "", "p": "mathlib"}, {"name": "affine_equiv.linear_mk'", "description": "", "p": "mathlib"}, {"name": "affine_equiv.const_vadd_symm", "description": "", "p": "mathlib"}, {"name": "affine_map.vadd_line_map", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_mk", "description": "", "p": "mathlib"}, {"name": "affine_equiv.trans_assoc", "description": "", "p": "mathlib"}, {"name": "affine_equiv.const_vadd_hom_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.const_vadd_nsmul", "description": "", "p": "mathlib"}, {"name": "affine_equiv.refl_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.const_vadd_hom", "description": "A more bundled version of `affine_equiv.const_vadd`.", "p": "mathlib"}, {"name": "affine_equiv.trans", "description": "Composition of two `affine_equiv`alences, applied left to right.", "p": "mathlib"}, {"name": "affine_equiv.apply_eq_iff_eq", "description": "", "p": "mathlib"}, {"name": "affine_equiv.refl_trans", "description": "", "p": "mathlib"}, {"name": "affine_equiv.self_trans_symm", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_mk'", "description": "", "p": "mathlib"}, {"name": "affine_equiv.one_def", "description": "", "p": "mathlib"}, {"name": "affine_equiv.equiv_units_affine_map", "description": " The group of `affine_equiv`s are equivalent to the group of units of `affine_map`.\n\nThis is the affine version of `linear_map.general_linear_group.general_linear_equiv`.", "p": "mathlib"}, {"name": "affine_equiv.coe_to_affine_map", "description": "", "p": "mathlib"}, {"name": "linear_equiv.coe_to_affine_equiv", "description": "", "p": "mathlib"}, {"name": "affine_equiv.of_bijective_symm_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.map_vadd", "description": "", "p": "mathlib"}, {"name": "affine_equiv.vadd_const", "description": " The map `v \u21a6 v +\u1d65 b` as an affine equivalence between a module `V` and an affine space `P` with\ntangent space `V`.", "p": "mathlib"}, {"name": "affine_equiv.equiv_units_affine_map_symm_apply_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_fn_injective", "description": "", "p": "mathlib"}, {"name": "affine_equiv.linear_equiv_units_affine_map_symm_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_const_vsub", "description": "", "p": "mathlib"}, {"name": "affine_equiv.affine_map.has_coe", "description": "", "p": "mathlib"}, {"name": "affine_equiv.const_vsub", "description": "`p' \u21a6 p -\u1d65 p'` as an equivalence.", "p": "mathlib"}, {"name": "affine_map.line_map_vsub", "description": "", "p": "mathlib"}, {"name": "affine_equiv.image_symm", "description": "", "p": "mathlib"}, {"name": "affine_equiv.of_bijective_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.linear_hom", "description": "`affine_equiv.linear` on automorphisms is a `monoid_hom`.", "p": "mathlib"}, {"name": "affine_equiv.point_reflection_fixed_iff_of_injective_bit0", "description": " `x` is the only fixed point of `point_reflection x`. This lemma requires\n`x + x = y + y \u2194 x = y`. There is no typeclass to use here, so we add it as an explicit argument.", "p": "mathlib"}, {"name": "affine_equiv.trans_refl", "description": "", "p": "mathlib"}, {"name": "affine_equiv.vadd_const_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_refl_to_affine_map", "description": "", "p": "mathlib"}, {"name": "affine_equiv.group", "description": "", "p": "mathlib"}, {"name": "affine_equiv.homothety_units_mul_hom", "description": " Fixing a point in affine space, homothety about this point gives a group homomorphism from (the\ncentre of) the units of the scalars into the group of affine equivalences.", "p": "mathlib"}, {"name": "affine_equiv.to_affine_map_inj", "description": "", "p": "mathlib"}, {"name": "affine_equiv.to_equiv_injective", "description": "", "p": "mathlib"}, {"name": "affine_equiv.apply_line_map", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_linear", "description": "", "p": "mathlib"}, {"name": "affine_equiv.to_affine_map_mk", "description": "", "p": "mathlib"}, {"name": "affine_equiv.of_bijective", "description": "Bijective affine maps are affine isomorphisms.", "p": "mathlib"}, {"name": "affine_equiv.const_vadd_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_trans", "description": "", "p": "mathlib"}, {"name": "affine_equiv.point_reflection_involutive", "description": "", "p": "mathlib"}, {"name": "affine_equiv.surjective", "description": "", "p": "mathlib"}, {"name": "affine_equiv.const_vadd_add", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_coe", "description": "", "p": "mathlib"}, {"name": "affine_equiv.point_reflection_self", "description": "", "p": "mathlib"}, {"name": "affine_equiv.point_reflection_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.linear_of_bijective", "description": "", "p": "mathlib"}, {"name": "affine_equiv.equiv.has_coe", "description": "", "p": "mathlib"}, {"name": "affine_equiv.const_vadd", "description": " The map `p \u21a6 v +\u1d65 p` as an affine automorphism of an affine space.\n\nNote that there is no need for an `affine_map.const_vadd` as it is always an equivalence.\nThis is roughly to `distrib_mul_action.to_linear_equiv` as `+\u1d65` is to `\u2022`.", "p": "mathlib"}, {"name": "affine_equiv.coe_inv_equiv_units_affine_map_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_one", "description": "", "p": "mathlib"}, {"name": "affine_equiv.to_equiv_inj", "description": "", "p": "mathlib"}, {"name": "affine_equiv.apply_symm_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.linear_refl", "description": "", "p": "mathlib"}, {"name": "affine_equiv.inv_def", "description": "", "p": "mathlib"}, {"name": "affine_equiv.mul_def", "description": "", "p": "mathlib"}, {"name": "linear_equiv.to_affine_equiv", "description": "Interpret a linear equivalence between modules as an affine equivalence.", "p": "mathlib"}, {"name": "affine_map.homothety_neg_one_apply", "description": "", "p": "mathlib"}, {"name": "affine_map.vsub_line_map", "description": "", "p": "mathlib"}, {"name": "affine_equiv.linear_vadd_const", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_trans_to_affine_map", "description": "", "p": "mathlib"}, {"name": "affine_equiv.injective_point_reflection_left_of_injective_bit0", "description": "", "p": "mathlib"}, {"name": "affine_equiv.const_vadd_zsmul", "description": "", "p": "mathlib"}, {"name": "affine_equiv.to_affine_map_injective", "description": "", "p": "mathlib"}, {"name": "affine_equiv.preimage_symm", "description": "", "p": "mathlib"}, {"name": "affine_equiv.symm_apply_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.of_bijective.symm_eq", "description": "", "p": "mathlib"}, {"name": "affine_equiv.symm_to_equiv", "description": "", "p": "mathlib"}, {"name": "affine_equiv.trans_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.ext", "description": "", "p": "mathlib"}, {"name": "affine_equiv.mk'", "description": " Construct an affine equivalence by verifying the relation between the map and its linear part at\none base point. Namely, this function takes a map `e : P\u2081 \u2192 P\u2082`, a linear equivalence\n`e' : V\u2081 \u2243\u2097[k] V\u2082`, and a point `p` such that for any other point `p'` we have\n`e p' = e' (p' -\u1d65 p) +\u1d65 e p`.", "p": "mathlib"}, {"name": "affine_equiv.injective_point_reflection_left_of_module", "description": "", "p": "mathlib"}, {"name": "affine_equiv.equiv_units_affine_map_symm_apply_symm_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.point_reflection_symm", "description": "", "p": "mathlib"}, {"name": "affine_map.line_map_vadd", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_homothety_units_mul_hom_eq_homothety_hom_coe", "description": "", "p": "mathlib"}, {"name": "affine_equiv.symm_trans_self", "description": "", "p": "mathlib"}, {"name": "affine_equiv.linear_hom_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.to_affine_map", "description": "Reinterpret an `affine_equiv` as an `affine_map`.", "p": "mathlib"}, {"name": "affine_equiv.linear_to_affine_map", "description": "", "p": "mathlib"}, {"name": "affine_equiv.bijective", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_fn_inj", "description": "", "p": "mathlib"}, {"name": "affine_equiv.linear_const_vadd", "description": "", "p": "mathlib"}, {"name": "affine_equiv.symm", "description": "Inverse of an affine equivalence as an affine equivalence.", "p": "mathlib"}, {"name": "affine_equiv.range_eq", "description": "", "p": "mathlib"}, {"name": "affine_equiv.coe_homothety_units_mul_hom_apply", "description": "", "p": "mathlib"}, {"name": "affine_equiv.symm_linear", "description": "", "p": "mathlib"}, {"name": "affine_equiv.equiv_like", "description": "", "p": "mathlib"}, {"name": "affine_equiv", "description": " An affine equivalence is an equivalence between affine spaces such that both forward\nand inverse maps are affine.\n\nWe define it using an `equiv` for the map and a `linear_equiv` for the linear part in order\nto allow affine equivalences with good definitional equalities.", "p": "mathlib"}, {"name": "affine_equiv.to_equiv", "description": " An affine equivalence is an equivalence between affine spaces such that both forward\nand inverse maps are affine.\n\nWe define it using an `equiv` for the map and a `linear_equiv` for the linear part in order\nto allow affine equivalences with good definitional equalities.", "p": "mathlib"}, {"name": "affine_equiv.linear", "description": " An affine equivalence is an equivalence between affine spaces such that both forward\nand inverse maps are affine.\n\nWe define it using an `equiv` for the map and a `linear_equiv` for the linear part in order\nto allow affine equivalences with good definitional equalities.", "p": "mathlib"}, {"name": "affine_equiv.map_vadd'", "description": " An affine equivalence is an equivalence between affine spaces such that both forward\nand inverse maps are affine.\n\nWe define it using an `equiv` for the map and a `linear_equiv` for the linear part in order\nto allow affine equivalences with good definitional equalities.", "p": "mathlib"}, {"name": "affine_equiv.coe_refl", "description": "", "p": "mathlib"}, {"name": "affine_equiv.simps.apply", "description": "See Note [custom simps projection]", "p": "mathlib"}, {"name": "affine_equiv.simps.symm_apply", "description": "See Note [custom simps projection]", "p": "mathlib"}, {"name": "affine_equiv.symm_refl", "description": "", "p": "mathlib"}, {"name": "affine_equiv.injective", "description": "", "p": "mathlib"}, {"name": "finrank_eq_zero_of_basis_imp_not_finite", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finrank_eq_card_finset_basis", "description": " If a vector space (or module) has a finite basis, then its dimension (or rank) is equal to the\ncardinality of the basis. This lemma uses a `finset` instead of indexed types.", "p": "mathlib"}, {"name": "span_lt_top_of_card_lt_finrank", "description": "", "p": "mathlib"}, {"name": "linear_independent_iff_card_le_finrank_span", "description": "", "p": "mathlib"}, {"name": "submodule.lt_top_of_finrank_lt_finrank", "description": "", "p": "mathlib"}, {"name": "finrank_eq_zero_of_not_exists_basis_finset", "description": "", "p": "mathlib"}, {"name": "linear_equiv.finrank_eq", "description": "The dimension of a finite dimensional space is preserved under linear equivalence.", "p": "mathlib"}, {"name": "finrank_range_le_card", "description": "", "p": "mathlib"}, {"name": "subalgebra.rank_top", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.nontrivial_of_finrank_eq_succ", "description": " A finite dimensional space is nontrivial if it has `finrank` equal to the successor of a\nnatural number.", "p": "mathlib"}, {"name": "finrank_top", "description": "", "p": "mathlib"}, {"name": "set_basis_of_top_le_span_of_card_eq_finrank_repr_apply", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finrank_eq_card_basis", "description": " If a vector space (or module) has a finite basis, then its dimension (or rank) is equal to the\ncardinality of the basis.", "p": "mathlib"}, {"name": "finite_dimensional.finrank_zero_of_subsingleton", "description": "A (finite dimensional) space that is a subsingleton has zero `finrank`.", "p": "mathlib"}, {"name": "finite_dimensional.rank_lt_of_finrank_lt", "description": "", "p": "mathlib"}, {"name": "subalgebra_top_finrank_eq_submodule_top_finrank", "description": "", "p": "mathlib"}, {"name": "linear_map.finrank_range_of_inj", "description": "The dimensions of the domain and range of an injective linear map are equal.", "p": "mathlib"}, {"name": "linear_equiv.finrank_map_eq", "description": "Pushforwards of finite-dimensional submodules along a `linear_equiv` have the same finrank.", "p": "mathlib"}, {"name": "finite_dimensional.finrank_lt_of_rank_lt", "description": "", "p": "mathlib"}, {"name": "subalgebra.rank_bot", "description": "", "p": "mathlib"}, {"name": "subalgebra_top_rank_eq_submodule_top_rank", "description": "", "p": "mathlib"}, {"name": "finrank_eq_zero_of_not_exists_basis", "description": "", "p": "mathlib"}, {"name": "finrank_span_finset_eq_card", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finrank_le_of_rank_le", "description": "", "p": "mathlib"}, {"name": "finrank_bot", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finrank_le_finrank_of_rank_le_rank", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finrank_eq_of_rank_eq", "description": "", "p": "mathlib"}, {"name": "set_basis_of_top_le_span_of_card_eq_finrank", "description": "A set of `finrank K V` vectors forms a basis if they span the whole space.", "p": "mathlib"}, {"name": "finrank_eq_zero_of_not_exists_basis_finite", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finrank_self", "description": " A ring satisfying `strong_rank_condition` (such as a `division_ring`) is one-dimensional as a\nmodule over itself.", "p": "mathlib"}, {"name": "finrank_le_one", "description": "If every vector is a multiple of some `v : V`, then `V` has dimension at most one.", "p": "mathlib"}, {"name": "finrank_eq_zero_of_basis_imp_false", "description": "", "p": "mathlib"}, {"name": "set.finrank", "description": "The rank of a set of vectors as a natural number.", "p": "mathlib"}, {"name": "submodule.lt_of_le_of_finrank_lt_finrank", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finrank_fintype_fun_eq_card", "description": "The vector space of functions on a fintype \u03b9 has finrank equal to the cardinality of \u03b9.", "p": "mathlib"}, {"name": "finrank_span_set_eq_card", "description": "", "p": "mathlib"}, {"name": "finrank_span_eq_card", "description": "", "p": "mathlib"}, {"name": "subalgebra.finrank_bot", "description": "", "p": "mathlib"}, {"name": "finset_basis_of_top_le_span_of_card_eq_finrank", "description": "A finset of `finrank K V` vectors forms a basis if they span the whole space.", "p": "mathlib"}, {"name": "finite_dimensional.basis.subset_extend", "description": "", "p": "mathlib"}, {"name": "finrank_eq_one", "description": " If there is a nonzero vector and every other vector is a multiple of it,\nthen the module has dimension one.", "p": "mathlib"}, {"name": "finset_basis_of_top_le_span_of_card_eq_finrank_repr_apply", "description": "", "p": "mathlib"}, {"name": "linear_independent_iff_card_eq_finrank_span