ption": "A group homomorphism is a monoid homomorphism.", "p": "mathlib"}, {"name": "is_add_group_hom.injective_iff", "description": "An additive group homomorphism is injective if its kernel is trivial.", "p": "mathlib"}, {"name": "neg.is_add_group_hom", "description": "Negation is an `add_group` homomorphism if the `add_group` is commutative.", "p": "mathlib"}, {"name": "is_add_hom.neg", "description": "The negation of a map which preserves addition, preserves addition when\nthe target is commutative.", "p": "mathlib"}, {"name": "mem_nhds_set_iff_exists", "description": "", "p": "mathlib"}, {"name": "nhds_set_eq_principal_iff", "description": "", "p": "mathlib"}, {"name": "mem_nhds_set_empty", "description": "", "p": "mathlib"}, {"name": "nhds_set", "description": "The filter of neighborhoods of a set in a topological space.", "p": "mathlib"}, {"name": "is_open.mem_nhds_set", "description": "", "p": "mathlib"}, {"name": "monotone_nhds_set", "description": "", "p": "mathlib"}, {"name": "mem_nhds_set_interior", "description": "", "p": "mathlib"}, {"name": "mem_nhds_set_iff_forall", "description": "", "p": "mathlib"}, {"name": "continuous.tendsto_nhds_set", "description": " Preimage of a set neighborhood of `t` under a continuous map `f` is a set neighborhood of `s`\nprovided that `f` maps `s` to `t`.", "p": "mathlib"}, {"name": "nhds_set_interior", "description": "", "p": "mathlib"}, {"name": "nhds_le_nhds_set", "description": "", "p": "mathlib"}, {"name": "union_mem_nhds_set", "description": "", "p": "mathlib"}, {"name": "has_basis_nhds_set", "description": "", "p": "mathlib"}, {"name": "principal_le_nhds_set", "description": "", "p": "mathlib"}, {"name": "is_open.nhds_set_eq", "description": "**Alias** of the reverse direction of `nhds_set_eq_principal_iff`.", "p": "mathlib"}, {"name": "subset_interior_iff_mem_nhds_set", "description": "", "p": "mathlib"}, {"name": "nhds_set_univ", "description": "", "p": "mathlib"}, {"name": "nhds_set_empty", "description": "", "