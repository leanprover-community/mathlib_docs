: "erased.has_to_format", "description": "", "p": "mathlib"}, {"name": "erased.map", "description": "`(<$>)` operation on `erased`.\n\nThis is a separate definition because `\u03b1` and `\u03b2` can live in different\nuniverses (the universe is fixed in `functor`).", "p": "mathlib"}, {"name": "erased.bind_eq_out", "description": "", "p": "mathlib"}, {"name": "erased.has_repr", "description": "", "p": "mathlib"}, {"name": "erased.mk", "description": "Erase a value.", "p": "mathlib"}, {"name": "erased.map_def", "description": "", "p": "mathlib"}, {"name": "ae_measurable", "description": " A function is almost everywhere measurable if it coincides almost everywhere with a measurable\nfunction.", "p": "mathlib"}, {"name": "measure_theory.measure_Union_null_iff'", "description": " A version of `measure_Union_null_iff` for unions indexed by Props\nTODO: in the long run it would be better to combine this with `measure_Union_null_iff` by\ngeneralising to `Sort`.", "p": "mathlib"}, {"name": "measure_theory.measure_bUnion_finset_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_ball_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.ae.countable_Inter_filter", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_ae_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_symm", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.measure_eq", "description": "**Alias** of `measure_theory.measure_congr`.", "p": "mathlib"}, {"name": "measure_theory.measure_union_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_empty", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_eq_infi", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_set_compl", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_union_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_Union_null_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_all_iff", "description": "", "p": "mathlib"}, {"name": "measurable.comp_ae_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.ext", "description": "", "p": "mathlib"}, {"name": "measure_theory.inter_ae_eq_right_of_ae_eq_univ", "description": "", "p": "mathlib"}, {"name": "measure_theory.frequently_ae_mem_iff", "description": "", "p": "mathlib"}, {"name": "ae_measurable.mk", "description": " Given an almost everywhere measurable function `f`, associate to it a measurable function\nthat coincides with it almost everywhere. `f` is explicit in the definition to make sure that\nit shows in pretty-printing.", "p": "mathlib"}, {"name": "ae_measurable_id", "description": "", "p": "mathlib"}, {"name": "measure_theory.measurable_set_to_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_le_set_inter", "description": "", "p": "mathlib"}, {"name": "measure_theory.union_ae_eq_left_of_ae_eq_empty", "description": "", "p": "mathlib"}, {"name": "set.mul_indicator_ae_eq_one", "description": "", "p": "mathlib"}, {"name": "measure_theory.to_outer_measure_eq_induced_outer_measure", "description": "", "p": "mathlib"}, {"name": "ae_measurable_const", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_measurable_superset", "description": "For every set there exists a measurable superset of the same measure.", "p": "mathlib"}, {"name": "ae_measurable.ae_eq_mk", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_set_inter", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_mono_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.diff_null_ae_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_bUnion_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_mono_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.subset_to_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_eq_extend", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_univ", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_mono_ae", "description": "If `s \u2286 t` modulo a set of measure `0`, then `\u03bc s \u2264 \u03bc t`.", "p": "mathlib"}, {"name": "measure_theory.measure_bUnion_null_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_to_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_congr", "description": "If two sets are equal modulo a set of measure zero, then `\u03bc s = \u03bc t`.", "p": "mathlib"}, {"name": "measure_theory.measure_symm_diff_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_eq_infi'", "description": "A variant of `measure_eq_infi` which has a single `infi`. This is useful when applying a\n lemma next that only works for non-empty infima, in which case you can use\n `nonempty_measurable_superset`.", "p": "mathlib"}, {"name": "measure_theory.union_ae_eq_univ_of_ae_eq_univ_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_Union_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.union_ae_eq_right_of_ae_eq_empty", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_inter_null_of_null_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_union_ne_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_measure_pos_of_not_measure_Union_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_measurable_superset_of_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure", "description": " A measure is defined to be an outer measure that is countably additive on\nmeasurable sets, with the additional assumption that the outer measure is the canonical\nextension of the restricted measure.", "p": "mathlib"}, {"name": "measure_theory.measure.to_outer_measure", "description": " A measure is defined to be an outer measure that is countably additive on\nmeasurable sets, with the additional assumption that the outer measure is the canonical\nextension of the restricted measure.", "p": "mathlib"}, {"name": "measure_theory.measure.m_Union", "description": " A measure is defined to be an outer measure that is countably additive on\nmeasurable sets, with the additional assumption that the outer measure is the canonical\nextension of the restricted measure.", "p": "mathlib"}, {"name": "measure_theory.measure.trimmed", "description": " A measure is defined to be an outer measure that is countably additive on\nmeasurable sets, with the additional assumption that the outer measure is the canonical\nextension of the restricted measure.", "p": "mathlib"}, {"name": "measure_theory.measure.to_outer_measure_injective", "description": "", "p": "mathlib"}, {"name": "ae_measurable.measurable_mk", "description": "", "p": "mathlib"}, {"name": "measure_theory.frequently_ae_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_union_lt_top_iff", "description": "", "p": "mathlib"}, {"name": "ae_measurable_id'", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_zero_iff_ae_nmem", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_measurable_superset_iff_measure_eq_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.inter_ae_eq_empty_of_ae_eq_empty_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.union_ae_eq_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_measurable_superset_forall_eq", "description": " For every set `s` and a countable collection of measures `\u03bc i` there exists a measurable\nsuperset `t \u2287 s` such that each measure `\u03bc i` takes the same value on `s` and `t`.", "p": "mathlib"}, {"name": "measure_theory.ae_eq_set", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_refl", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_inter_lt_top_of_right_ne_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_union_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_inter_null_of_null_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.volume_tac", "description": "The tactic `exact volume`, to be used in optional (`auto_param`) arguments.", "p": "mathlib"}, {"name": "measure_theory.union_ae_eq_univ_of_ae_eq_univ_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_le_to_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.diff_ae_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_union_null_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_Union_fintype_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.of_measurable", "description": "Obtain a measure by giving a countably additive function that sends `\u2205` to `0`.", "p": "mathlib"}, {"name": "measure_theory.ae_iff", "description": "", "p": "mathlib"}, {"name": "ae_measurable_congr", "description": "", "p": "mathlib"}, {"name": "ae_measurable.congr", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.ae", "description": "The \u201calmost everywhere\u201d filter of co-null sets.", "p": "mathlib"}, {"name": "measure_theory.ae_eq_set_compl_compl", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_le_of_ae_lt", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_le_set", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_mono_null_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_trans", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_bUnion_le", "description": "", "p": "mathlib"}, {"name": "set.indicator_ae_eq_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.inter_ae_eq_left_of_ae_eq_univ", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_measurable_superset\u2082", "description": "", "p": "mathlib"}, {"name": "measurable.ae_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_set_union", "description": "", "p": "mathlib"}, {"name": "measure_theory.to_measurable", "description": " A measurable set `t \u2287 s` such that `\u03bc t = \u03bc s`. It even satisfies `\u03bc (t \u2229 u) = \u03bc (s \u2229 u)` for\nany measurable set `u` if `\u03bc s \u2260 \u221e`, see `measure_to_measurable_inter`.\n(This property holds without the assumption `\u03bc s \u2260 \u221e` when the space is sigma-finite,\nsee `measure_to_measurable_inter_of_sigma_finite`).\nIf `s` is a null measurable set, then\nwe also have `t =\u1d50[\u03bc] s`, see `null_measurable_set.to_measurable_ae_eq`.\nThis notion is sometimes called a \"measurable hull\" in the literature.", "p": "mathlib"}, {"name": "measure_theory.ae_le_set_union", "description": "", "p": "mathlib"}, {"name": "measure_theory.coe_to_outer_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.inter_ae_eq_empty_of_ae_eq_empty_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_eq_trim", "description": "", "p": "mathlib"}, {"name": "measure_theory.to_outer_measure_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.compl_mem_ae_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.of_measurable_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_union_eq_top_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_eq_induced_outer_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_sUnion_null_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_space", "description": "A measure space is a measurable space equipped with a\n measure, referred to as `volume`.", "p": "mathlib"}, {"name": "measure_theory.measure_space.to_measurable_space", "description": "A measure space is a measurable space equipped with a\n measure, referred to as `volume`.", "p": "mathlib"}, {"name": "measure_theory.measure_space.volume", "description": "A measure space is a measurable space equipped with a\n measure, referred to as `volume`.", "p": "mathlib"}, {"name": "measure_theory.nonempty_of_measure_ne_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.has_coe_to_fun", "description": " Measure projections for a measure space.\n\nFor measurable sets this returns the measure assigned by the `measure_of` field in `measure`.\nBut we can extend this to _all_ sets, but using the outer measure. This gives us monotonicity and\nsubadditivity for all sets.", "p": "mathlib"}, {"name": "measure_theory.ae_of_all", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_empty", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.ext_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_Union_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_inter_lt_top_of_left_ne_top", "description": "", "p": "mathlib"}, {"name": "filter.eventually_le.measure_le", "description": "**Alias** of `measure_theory.measure_mono_ae`.", "p": "mathlib"}, {"name": "fp.emax", "description": "", "p": "mathlib"}, {"name": "fp.float.div", "description": "", "p": "mathlib"}, {"name": "fp.float.is_finite", "description": "", "p": "mathlib"}, {"name": "fp.float.neg", "description": "", "p": "mathlib"}, {"name": "fp.float.add", "description": "", "p": "mathlib"}, {"name": "fp.of_rat_up", "description": "", "p": "mathlib"}, {"name": "fp.float.zero.valid", "description": "", "p": "mathlib"}, {"name": "fp.float.has_neg", "description": "", "p": "mathlib"}, {"name": "fp.next_dn_pos", "description": "", "p": "mathlib"}, {"name": "fp.rmode.inhabited", "description": "", "p": "mathlib"}, {"name": "fp.float.has_sub", "description": "", "p": "mathlib"}, {"name": "fp.float.has_add", "description": "", "p": "mathlib"}, {"name": "fp.float.is_zero", "description": "", "p": "mathlib"}, {"name": "int.shift2", "description": "", "p": "mathlib"}, {"name": "fp.next_up", "description": "", "p": "mathlib"}, {"name": "fp.to_rat", "description": "", "p": "mathlib"}, {"name": "fp.div_nat_lt_two_pow", "description": "", "p": "mathlib"}, {"name": "fp.valid_finite", "description": "", "p": "mathlib"}, {"name": "fp.of_pos_rat_dn", "description": "", "p": "mathlib"}, {"name": "fp.float_cfg", "description": "", "p": "mathlib"}, {"name": "fp.float_cfg.prec", "description": "", "p": "mathlib"}, {"name": "fp.float_cfg.emax", "description": "", "p": "mathlib"}, {"name": "fp.float_cfg.prec_pos", "description": "", "p": "mathlib"}, {"name": "fp.float_cfg.prec_max", "description": "", "p": "mathlib"}, {"name": "fp.float.sign'", "description": "", "p": "mathlib"}, {"name": "fp.float.sub", "description": "", "p": "mathlib"}, {"name": "fp.float.inhabited", "description": "", "p": "mathlib"}, {"name": "fp.rmode", "description": "", "p": "mathlib"}, {"name": "fp.prec", "description": "", "p": "mathlib"}, {"name": "fp.of_rat_dn", "description": "", "p": "mathlib"}, {"name": "fp.next_dn", "description": "", "p": "mathlib"}, {"name": "fp.emin", "description": "", "p": "mathlib"}, {"name": "fp.of_rat", "description": "", "p": "mathlib"}, {"name": "fp.float.sign", "description": "", "p": "mathlib"}, {"name": "fp.float.zero", "description": "", "p": "mathlib"}, {"name": "fp.next_up_pos", "description": "", "p": "mathlib"}, {"name": "fp.float.mul", "description": "", "p": "mathlib"}, {"name": "fp.float", "description": "", "p": "mathlib"}, {"name": "fp.float.inf", "description": "", "p": "mathlib"}, {"name": "fp.float.nan", "description": "", "p": "mathlib"}, {"name": "fp.float.finite", "description": "", "p": "mathlib"}, {"name": "fp.dec_valid_finite", "description": "", "p": "mathlib"}, {"name": "surreal.pow_half", "description": "Powers of the surreal number `half`.", "p": "mathlib"}, {"name": "pgame.pow_half_succ_right_moves", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_succ_move_right", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_zero", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_left_moves", "description": "", "p": "mathlib"}, {"name": "surreal.nsmul_pow_two_pow_half", "description": "", "p": "mathlib"}, {"name": "pgame.birthday_half", "description": "", "p": "mathlib"}, {"name": "pgame.unique_pow_half_left_moves", "description": "", "p": "mathlib"}, {"name": "surreal.dyadic_map_apply", "description": "", "p": "mathlib"}, {"name": "surreal.zsmul_pow_two_pow_half", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half", "description": " For a natural number `n`, the pre-game `pow_half (n + 1)` is recursively defined as\n`{0 | pow_half n}`. These are the explicit expressions of powers of `1 / 2`. By definition, we have\n`pow_half 0 = 1` and `pow_half 1 \u2248 1 / 2` and we prove later on that\n`pow_half (n + 1) + pow_half (n + 1) \u2248 pow_half n`.", "p": "mathlib"}, {"name": "pgame.numeric_pow_half", "description": "For all natural numbers `n`, the pre-games `pow_half n` are numeric.", "p": "mathlib"}, {"name": "surreal.nsmul_pow_two_pow_half'", "description": "", "p": "mathlib"}, {"name": "surreal.dyadic", "description": "We define dyadic surreals as the range of the map `dyadic_map`.", "p": "mathlib"}, {"name": "surreal.double_pow_half_succ_eq_pow_half", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_succ_lt_one", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_succ_le_pow_half", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_zero_right_moves", "description": "", "p": "mathlib"}, {"name": "surreal.dyadic_aux", "description": "", "p": "mathlib"}, {"name": "surreal.dyadic_map_apply_pow", "description": "", "p": "mathlib"}, {"name": "pgame.zero_le_pow_half", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_succ_lt_pow_half", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_pos", "description": "", "p": "mathlib"}, {"name": "pgame.is_empty_pow_half_zero_right_moves", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_move_left", "description": "", "p": "mathlib"}, {"name": "pgame.half_add_half_equiv_one", "description": "", "p": "mathlib"}, {"name": "surreal.dyadic_map", "description": "The additive monoid morphism `dyadic_map` sends \u27e6\u27e8m, 2^n\u27e9\u27e7 to m \u2022 half ^ n.", "p": "mathlib"}, {"name": "pgame.add_pow_half_succ_self_eq_pow_half", "description": "", "p": "mathlib"}, {"name": "pgame.pow_half_le_one", "description": "", "p": "mathlib"}, {"name": "pgame.unique_pow_half_succ_right_moves", "description": "", "p": "mathlib"}, {"name": "surreal.pow_half_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.zero_eq_zero'", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.over_to_sort", "description": "A coercion from an arrow with codomain `P` to its associated pseudoelement.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_zero_iff", "description": "The pseudoelement induced by an arrow is zero precisely when that arrow is zero", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.zero_apply", "description": "The zero morphism maps every pseudoelement to 0.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudo_equal_refl", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_pullback", "description": "If `f : P \u27f6 R` and `g : Q \u27f6 R` are morphisms and `p : P` and `q : Q` are pseudoelements such\n   that `f p = g q`, then there is some `s : pullback f g` such that `fst s = p` and `snd s = q`.\n\n   Remark: Borceux claims that `s` is unique, but this is false. See\n   `counterexamples/pseudoelement` for details.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.comp_comp", "description": "Composition of functions on pseudoelements is composition of morphisms.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.comp_apply", "description": "Applying a pseudoelement to a composition of morphisms is the same as composing\n   with each morphism. Sadly, this is not a definitional equality, but at least it is\n   true.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.hom_to_fun", "description": "A coercion from morphisms to functions on pseudoelements", "p": "mathlib"}, {"name": "category_theory.abelian.pseudo_equal", "description": "Two arrows `f : X \u27f6 P` and `g : Y \u27f6 P` are called pseudo-equal if there is some object\n   `R` and epimorphisms `p : R \u27f6 X` and `q : R \u27f6 Y` such that `p \u226b f = q \u226b g`.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_apply_aux", "description": "If two elements are pseudo-equal, then their composition with a morphism is, too.", "p": "mathlib"}, {"name": "category_theory.abelian.app", "description": "This is just composition of morphisms in `C`. Another way to express this would be\n   `(over.map f).obj a`, but our definition has nicer definitional properties.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.apply_eq_zero_of_comp_eq_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_zero_aux", "description": "The arrows pseudo-equal to a zero morphism are precisely the zero morphisms", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_exact_of_exact", "description": "Two morphisms in an exact sequence are exact on pseudoelements.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.zero_eq_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.epi_of_pseudo_surjective", "description": "A morphism that is surjective on pseudoelements is an epimorphism.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.exact_of_pseudo_exact", "description": "If two morphisms are exact on pseudoelements, they are exact.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.zero_of_map_zero", "description": "A morphism that is injective on pseudoelements only maps the zero element to zero.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.has_zero", "description": "We can not use `pseudo_zero` as a global `has_zero` instance,\nas it would trigger on any type class search for `has_zero` applied to a `coe_sort`.\nThis would be too expensive.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.zero_morphism_ext'", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.setoid", "description": "The arrows with codomain `P` equipped with the equivalence relation of being pseudo-equal.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.sub_of_eq_image", "description": "If two pseudoelements `x` and `y` have the same image under some morphism `f`, then we can form\n   their \"difference\" `z`. This pseudoelement has the properties that `f z = 0` and for all\n   morphisms `g`, if `g y = 0` then `g z = g x`.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.object_to_sort", "description": "A coercion from an object of an abelian category to its pseudoelements.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_apply", "description": "A morphism `f` induces a function `pseudo_apply f` on pseudoelements.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.zero_morphism_ext", "description": "An extensionality lemma for being the zero arrow.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.over_coe_def", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_injective_of_mono", "description": "A monomorphism is injective on pseudoelements.", "p": "mathlib"}, {"name": "category_theory.abelian.app_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudo_equal_symm", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement", "description": "A `pseudoelement` of `P` is just an equivalence class of arrows ending in `P` by being\n   pseudo-equal.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.apply_zero", "description": "Morphisms map the zero pseudoelement to the zero pseudoelement", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_zero", "description": "The zero pseudoelement is the class of a zero morphism", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_zero_def", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.Module.eq_range_of_pseudoequal", "description": " In the category `Module R`, if `x` and `y` are pseudoequal, then the range of the associated\nmorphisms is the same.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_surjective_of_epi", "description": "An epimorphism is surjective on pseudoelements.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.mono_of_zero_of_map_zero", "description": "A morphism that only maps the zero pseudoelement to zero is a monomorphism.", "p": "mathlib"}, {"name": "category_theory.abelian.pseudoelement.pseudo_apply_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.pseudo_equal_trans", "description": "Pseudoequality is transitive: Just take the pullback. The pullback morphisms will\n   be epimorphisms since in an abelian category, pullbacks of epimorphisms are epimorphisms.", "p": "mathlib"}, {"name": "perfection.map_apply_coe", "description": "", "p": "mathlib"}, {"name": "mod_p.pre_val_mk", "description": "", "p": "mathlib"}, {"name": "mod_p.mul_ne_zero_of_pow_p_ne_zero", "description": "", "p": "mathlib"}, {"name": "perfection_map.lift_apply", "description": "", "p": "mathlib"}, {"name": "perfection_map.comp_symm_equiv", "description": "", "p": "mathlib"}, {"name": "pre_tilt.val_aux_one", "description": "", "p": "mathlib"}, {"name": "perfection.coeff_add_ne_zero", "description": "", "p": "mathlib"}, {"name": "perfection_map.lift", "description": " Given rings `R` and `S` of characteristic `p`, with `R` being perfect,\nany homomorphism `R \u2192+* S` can be lifted to a homomorphism `R \u2192+* P`,\nwhere `P` is any perfection of `S`.", "p": "mathlib"}, {"name": "mod_p.char_p", "description": "", "p": "mathlib"}, {"name": "perfection.perfect_ring", "description": "", "p": "mathlib"}, {"name": "tilt.field", "description": "", "p": "mathlib"}, {"name": "perfection.coeff_pth_root", "description": "", "p": "mathlib"}, {"name": "pre_tilt.val_aux_eq", "description": "", "p": "mathlib"}, {"name": "perfection_map.comp_symm_equiv'", "description": "", "p": "mathlib"}, {"name": "tilt", "description": " The tilt of a field, as defined in Perfectoid Spaces by Peter Scholze, as in\n[scholze2011perfectoid]. Given a field `K` with valuation `K \u2192 \u211d\u22650` and ring of integers `O`,\nthis is implemented as the fraction field of the perfection of `O/(p)`.", "p": "mathlib"}, {"name": "perfection.coeff_map", "description": "", "p": "mathlib"}, {"name": "mod_p.v_p_lt_val", "description": "", "p": "mathlib"}, {"name": "perfection_map.of", "description": "The canonical perfection map from the perfection of a ring.", "p": "mathlib"}, {"name": "pre_tilt", "description": "Perfection of `O/(p)` where `O` is the ring of integers of `K`.", "p": "mathlib"}, {"name": "perfection_map.equiv_apply", "description": "", "p": "mathlib"}, {"name": "pre_tilt.coeff_nat_find_add_ne_zero", "description": "", "p": "mathlib"}, {"name": "perfection.coeff", "description": "The `n`-th coefficient of an element of the perfection.", "p": "mathlib"}, {"name": "perfection_map.equiv", "description": "A perfection map induces an isomorphism to the prefection.", "p": "mathlib"}, {"name": "pre_tilt.comm_ring", "description": "", "p": "mathlib"}, {"name": "perfection.comm_ring", "description": "", "p": "mathlib"}, {"name": "perfection.coeff_iterate_frobenius", "description": "", "p": "mathlib"}, {"name": "pre_tilt.val", "description": " The valuation `Perfection(O/(p)) \u2192 \u211d\u22650`.\nGiven `f \u2208 Perfection(O/(p))`, if `f = 0` then output `0`;\notherwise output `pre_val(f(n))^(p^n)` for any `n` such that `f(n) \u2260 0`.", "p": "mathlib"}, {"name": "mod_p.pre_val_mul", "description": "", "p": "mathlib"}, {"name": "perfection_map.map_eq_map", "description": "", "p": "mathlib"}, {"name": "mod_p", "description": "`O/(p)` for `O`, ring of integers of `K`.", "p": "mathlib"}, {"name": "perfection.ring.perfection.inhabited", "description": "", "p": "mathlib"}, {"name": "perfection_map", "description": " A perfection map to a ring of characteristic `p` is a map that is isomorphic\nto its perfection.", "p": "mathlib"}, {"name": "perfection_map.injective", "description": " A perfection map to a ring of characteristic `p` is a map that is isomorphic\nto its perfection.", "p": "mathlib"}, {"name": "perfection_map.surjective", "description": " A perfection map to a ring of characteristic `p` is a map that is isomorphic\nto its perfection.", "p": "mathlib"}, {"name": "perfection.pth_root", "description": "The `p`-th root of an element of the perfection.", "p": "mathlib"}, {"name": "mod_p.v_p_lt_pre_val", "description": "", "p": "mathlib"}, {"name": "perfection.map", "description": "A ring homomorphism `R \u2192+* S` induces `perfection R p \u2192+* perfection S p`", "p": "mathlib"}, {"name": "perfection_map.mk'", "description": "Create a `perfection_map` from an isomorphism to the perfection.", "p": "mathlib"}, {"name": "pre_tilt.val_aux_zero", "description": "", "p": "mathlib"}, {"name": "perfection.ring", "description": "", "p": "mathlib"}, {"name": "pre_tilt.val_aux", "description": " The valuation `Perfection(O/(p)) \u2192 \u211d\u22650` as a function.\nGiven `f \u2208 Perfection(O/(p))`, if `f = 0` then output `0`;\notherwise output `pre_val(f(n))^(p^n)` for any `n` such that `f(n) \u2260 0`.", "p": "mathlib"}, {"name": "perfection.lift_apply_apply_coe", "description": "", "p": "mathlib"}, {"name": "perfection.ring.perfection.comm_semiring", "description": "", "p": "mathlib"}, {"name": "perfection.coeff_frobenius", "description": "", "p": "mathlib"}, {"name": "perfection.coeff_pow_p", "description": "", "p": "mathlib"}, {"name": "perfection_map.map", "description": "A ring homomorphism `R \u2192+* S` induces `P \u2192+* Q`, a map of the respective perfections.", "p": "mathlib"}, {"name": "mod_p.nontrivial", "description": "", "p": "mathlib"}, {"name": "perfection.frobenius_pth_root", "description": "", "p": "mathlib"}, {"name": "perfection.ext", "description": "", "p": "mathlib"}, {"name": "mod_p.pre_val_add", "description": "", "p": "mathlib"}, {"name": "ring.perfection_subring", "description": " The perfection of a ring `R` with characteristic `p`, as a subring,\ndefined to be the projective limit of `R` using the Frobenius maps `R \u2192 R`\nindexed by the natural numbers, implemented as `{ f : \u2115 \u2192 R | \u2200 n, f (n + 1) ^ p = f n }`.", "p": "mathlib"}, {"name": "perfection.coeff_iterate_frobenius'", "description": "", "p": "mathlib"}, {"name": "pre_tilt.map_eq_zero", "description": "", "p": "mathlib"}, {"name": "perfection_map.map_map", "description": "", "p": "mathlib"}, {"name": "pre_tilt.char_p", "description": "", "p": "mathlib"}, {"name": "perfection.lift", "description": " Given rings `R` and `S` of characteristic `p`, with `R` being perfect,\nany homomorphism `R \u2192+* S` can be lifted to a homomorphism `R \u2192+* perfection S p`.", "p": "mathlib"}, {"name": "perfection_map.comp_equiv", "description": "", "p": "mathlib"}, {"name": "perfection.char_p", "description": "", "p": "mathlib"}, {"name": "mod_p.comm_ring", "description": "", "p": "mathlib"}, {"name": "perfection_map.comp_equiv'", "description": "", "p": "mathlib"}, {"name": "pre_tilt.is_domain", "description": "", "p": "mathlib"}, {"name": "pre_tilt.val_aux_add", "description": "", "p": "mathlib"}, {"name": "mod_p.pre_val_eq_zero", "description": "", "p": "mathlib"}, {"name": "mod_p.pre_val_zero", "description": "", "p": "mathlib"}, {"name": "perfection_map.hom_ext", "description": "", "p": "mathlib"}, {"name": "pre_tilt.val_aux_mul", "description": "", "p": "mathlib"}, {"name": "ring.perfection", "description": " The perfection of a ring `R` with characteristic `p`,\ndefined to be the projective limit of `R` using the Frobenius maps `R \u2192 R`\nindexed by the natural numbers, implemented as `{f : \u2115 \u2192 R // \u2200 n, f (n + 1) ^ p = f n}`.", "p": "mathlib"}, {"name": "perfection.coeff_pow_p'", "description": "", "p": "mathlib"}, {"name": "ring.perfection_subsemiring", "description": " The perfection of a ring `R` with characteristic `p`, as a subsemiring,\ndefined to be the projective limit of `R` using the Frobenius maps `R \u2192 R`\nindexed by the natural numbers, implemented as `{ f : \u2115 \u2192 R | \u2200 n, f (n + 1) ^ p = f n }`.", "p": "mathlib"}, {"name": "perfection.coeff_mk", "description": "", "p": "mathlib"}, {"name": "monoid.perfection", "description": " The perfection of a monoid `M`, defined to be the projective limit of `M`\nusing the `p`-th power maps `M \u2192 M` indexed by the natural numbers, implemented as\n`{ f : \u2115 \u2192 M | \u2200 n, f (n + 1) ^ p = f n }`.", "p": "mathlib"}, {"name": "perfection_map.id", "description": "For a perfect ring, it itself is the perfection.", "p": "mathlib"}, {"name": "perfection.lift_symm_apply", "description": "", "p": "mathlib"}, {"name": "perfection_map.comp_map", "description": "", "p": "mathlib"}, {"name": "perfection.coeff_ne_zero_of_le", "description": "", "p": "mathlib"}, {"name": "perfection.pth_root_frobenius", "description": "", "p": "mathlib"}, {"name": "perfection.hom_ext", "description": "", "p": "mathlib"}, {"name": "mod_p.pre_val", "description": " For a field `K` with valuation `v : K \u2192 \u211d\u22650` and ring of integers `O`,\na function `O/(p) \u2192 \u211d\u22650` that sends `0` to `0` and `x + (p)` to `v(x)` as long as `x \u2209 (p)`.", "p": "mathlib"}, {"name": "perfection_map.lift_symm_apply", "description": "", "p": "mathlib"}, {"name": "simple_graph.transpose_adj_matrix", "description": "", "p": "mathlib"}, {"name": "simple_graph.adj_matrix_mul_vec_apply", "description": "", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.apply_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "simple_graph.dot_product_adj_matrix", "description": "", "p": "mathlib"}, {"name": "simple_graph.to_graph_adj_matrix_eq", "description": "The graph induced by the adjacency matrix of `G` is `G` itself.", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.to_graph_adj", "description": "", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.adj.decidable_rel", "description": "", "p": "mathlib"}, {"name": "simple_graph.adj_matrix_mul_vec_const_apply_of_regular", "description": "", "p": "mathlib"}, {"name": "simple_graph.adj_matrix_pow_apply_eq_card_walk", "description": "", "p": "mathlib"}, {"name": "simple_graph.adj_matrix_mul_apply", "description": "", "p": "mathlib"}, {"name": "simple_graph.adj_matrix_dot_product", "description": "", "p": "mathlib"}, {"name": "simple_graph.mul_adj_matrix_apply", "description": "", "p": "mathlib"}, {"name": "simple_graph.adj_matrix", "description": "`adj_matrix G \u03b1` is the matrix `A` such that `A i j = (1 : \u03b1)` if `i` and `j` are\n adjacent in the simple graph `G`, and otherwise `A i j = 0`.", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.compl", "description": "", "p": "mathlib"}, {"name": "matrix.is_adj_matrix_compl", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm_compl", "description": "", "p": "mathlib"}, {"name": "simple_graph.adj_matrix_mul_self_apply_self", "description": "", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.adj_matrix_to_graph_eq", "description": "If `A` is qualified as an adjacency matrix,\n   then the adjacency matrix of the graph induced by `A` is itself.", "p": "mathlib"}, {"name": "matrix.is_adj_matrix", "description": "`A : matrix V V \u03b1` is qualified as an \"adjacency matrix\" if\n   (1) every entry of `A` is `0` or `1`,\n   (2) `A` is symmetric,\n   (3) every diagonal entry of `A` is `0`.", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.zero_or_one", "description": "`A : matrix V V \u03b1` is qualified as an \"adjacency matrix\" if\n   (1) every entry of `A` is `0` or `1`,\n   (2) `A` is symmetric,\n   (3) every diagonal entry of `A` is `0`.", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.symm", "description": "`A : matrix V V \u03b1` is qualified as an \"adjacency matrix\" if\n   (1) every entry of `A` is `0` or `1`,\n   (2) `A` is symmetric,\n   (3) every diagonal entry of `A` is `0`.", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.apply_diag", "description": "`A : matrix V V \u03b1` is qualified as an \"adjacency matrix\" if\n   (1) every entry of `A` is `0` or `1`,\n   (2) `A` is symmetric,\n   (3) every diagonal entry of `A` is `0`.", "p": "mathlib"}, {"name": "simple_graph.is_symm_adj_matrix", "description": "", "p": "mathlib"}, {"name": "simple_graph.adj_matrix_apply", "description": "", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.to_graph_compl_eq", "description": "", "p": "mathlib"}, {"name": "matrix.compl_apply_diag", "description": "", "p": "mathlib"}, {"name": "matrix.compl_apply", "description": "", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.apply_diag_ne", "description": "", "p": "mathlib"}, {"name": "simple_graph.adj_matrix_vec_mul_apply", "description": "", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.apply_ne_one_iff", "description": "", "p": "mathlib"}, {"name": "matrix.is_adj_matrix.to_graph", "description": "For `A : matrix V V \u03b1` and `h : is_adj_matrix A`,\n   `h.to_graph` is the simple graph whose adjacency matrix is `A`.", "p": "mathlib"}, {"name": "matrix.compl", "description": "For `A : matrix V V \u03b1`, `A.compl` is supposed to be the adjacency matrix of\n   the complement graph of the graph induced by `A.adj_matrix`.", "p": "mathlib"}, {"name": "simple_graph.adj_matrix_mul_vec_const_apply", "description": "", "p": "mathlib"}, {"name": "simple_graph.trace_adj_matrix", "description": "", "p": "mathlib"}, {"name": "simple_graph.is_adj_matrix_adj_matrix", "description": "The adjacency matrix of `G` is an adjacency matrix.", "p": "mathlib"}, {"name": "algebraic_geometry.is_compact_open_iff_eq_finset_affine_union", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_eq_affine_property", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_iff_spectral", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.category_theory.limits.pullback.fst.quasi_compact", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.affine_open_cover_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_iff_forall_affine", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.is_compact_open_iff_eq_basic_open_union", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_stable_under_composition", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.compact_space_iff_quasi_compact", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.category_theory.limits.pullback.snd.quasi_compact", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_over_affine_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.affine_property_is_local", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.affine_open_cover_tfae", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.is_compact_basic_open", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_comp", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.compact_open_induction_on", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.affine_property", "description": " The `affine_target_morphism_property` corresponding to `quasi_compact`, asserting that the\ndomain is a quasi-compact scheme.", "p": "mathlib"}, {"name": "algebraic_geometry.exists_pow_mul_eq_zero_of_res_basic_open_eq_zero_of_is_affine_open", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_of_is_iso", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact", "description": "A morphism is `quasi-compact` if the underlying map of topological spaces is, i.e. if the preimages\nof quasi-compact open sets are quasi-compact.", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.is_compact_preimage", "description": "A morphism is `quasi-compact` if the underlying map of topological spaces is, i.e. if the preimages\nof quasi-compact open sets are quasi-compact.", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.affine_property_stable_under_base_change", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_iff_affine_property", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.exists_pow_mul_eq_zero_of_res_basic_open_eq_zero_of_is_compact", "description": " If `x : \u0393(X, U)` is zero on `D(f)` for some `f : \u0393(X, U)`, and `U` is quasi-compact, then\n`f ^ n * x = 0` for some `n`.", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_stable_under_base_change", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.is_local_at_target", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.open_cover_tfae", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.open_cover_iff", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact_respects_iso", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.quasi_compact.affine_property_to_property", "description": "", "p": "mathlib"}, {"name": "category_theory.functor_prod_functor_equiv_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.prod.sectr_map", "description": "", "p": "mathlib"}, {"name": "category_theory.prod.braiding_unit_iso_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.prod_map", "description": "", "p": "mathlib"}, {"name": "category_theory.functor_prod_functor_equiv_unit_iso_2", "description": "", "p": "mathlib"}, {"name": "category_theory.functor_prod_functor_equiv_unit_iso", "description": "The unit isomorphism for `functor_prod_functor_equiv`", "p": "mathlib"}, {"name": "category_theory.evaluation_uncurried_map", "description": "", "p": "mathlib"}, {"name": "category_theory.prod_functor_to_functor_prod_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.functor_prod_functor_equiv_counit_iso_hom_app_app", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.prod'_comp_snd_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.prod.braiding_functor_map", "description": "", "p": "mathlib"}, {"name": "category_theory.nat_trans.prod", "description": "The cartesian product of two natural transformations.", "p": "mathlib"}, {"name": "category_theory.is_iso_prod_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.prod", "description": "Construct an isomorphism in `C \u00d7 D` out of two isomorphisms in `C` and `D`.",