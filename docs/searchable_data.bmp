iption": " A field which is both linearly ordered and conditionally complete with respect to the order.\nThis axiomatizes the reals.", "p": "mathlib"}, {"name": "conditionally_complete_linear_ordered_field.nat_cast_succ", "description": " A field which is both linearly ordered and conditionally complete with respect to the order.\nThis axiomatizes the reals.", "p": "mathlib"}, {"name": "conditionally_complete_linear_ordered_field.int_cast_of_nat", "description": " A field which is both linearly ordered and conditionally complete with respect to the order.\nThis axiomatizes the reals.", "p": "mathlib"}, {"name": "conditionally_complete_linear_ordered_field.int_cast_neg_succ_of_nat", "description": " A field which is both linearly ordered and conditionally complete with respect to the order.\nThis axiomatizes the reals.", "p": "mathlib"}, {"name": "conditionally_complete_linear_ordered_field.mul", "description": " A field which is both linearly ordered and conditionally complete with respect to the order.\nThis axiomatizes the reals.", "p": "mathlib"}, {"name": "conditionally_complete_linear_ordered_field.mul_assoc", "description": " A field which is both linearly ordered and conditionally complete with respect to the order.\nThis axiomatizes the reals.", "p": "mathlib"}, {"name": "conditionally_complete_linear_ordered_field.one_mul", "description": " A field which is both linearly ordered and conditionally complete with respect to the order.\nThis axiomatizes the reals.", "p": "mathlib"}, {"name": "conditionally_complete_linear_ordered_field.mul_one", "description": " A field which is both linearly ordered and conditionally complete with respect to the order.\nThis axiomatizes the reals.", "p": "mathlib"}, {"name": "conditionally_complete_linear_ordered_field.npow", "description": " A field which is both linearly ordered and conditionally complete with respect to the order.\nThis axiomatizes the reals.", "p": "mathlib"}, {"name": "conditionally_complete_linear_ordere