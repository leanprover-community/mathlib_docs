ltiset.cons_le_cons_iff", "description": "", "p": "mathlib"}, {"name": "multiset.exists_cons_of_mem", "description": "", "p": "mathlib"}, {"name": "multiset.countp_cons", "description": "", "p": "mathlib"}, {"name": "submodule.span_algebra_map_image", "description": "A variant of `submodule.span_image` for `algebra_map`.", "p": "mathlib"}, {"name": "is_scalar_tower.algebra.ext", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.subsemiring", "description": "", "p": "mathlib"}, {"name": "alg_hom.restrict_scalars_injective", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.of_ring_hom", "description": "", "p": "mathlib"}, {"name": "alg_hom.restrict_scalars", "description": "R \u27f6 S induces S-Alg \u2964 R-Alg", "p": "mathlib"}, {"name": "is_scalar_tower.of_algebra_map_eq", "description": "", "p": "mathlib"}, {"name": "submodule.smul_mem_span_smul", "description": "", "p": "mathlib"}, {"name": "submodule.map_mem_span_algebra_map_image", "description": "", "p": "mathlib"}, {"name": "alg_hom.coe_restrict_scalars", "description": "", "p": "mathlib"}, {"name": "alg_equiv.coe_restrict_scalars'", "description": "", "p": "mathlib"}, {"name": "submodule.smul_mem_span_smul'", "description": "", "p": "mathlib"}, {"name": "alg_hom.map_algebra_map", "description": "", "p": "mathlib"}, {"name": "submodule.span_smul_of_span_eq_top", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.to_alg_hom", "description": " In a tower, the canonical map from the middle element to the top element is an\nalgebra homomorphism over the bottom element.", "p": "mathlib"}, {"name": "alg_equiv.coe_restrict_scalars", "description": "", "p": "mathlib"}, {"name": "alg_equiv.restrict_scalars", "description": "R \u27f6 S induces S-Alg \u2964 R-Alg", "p": "mathlib"}, {"name": "algebra.lsmul_injective", "description": "", "p": "mathlib"}, {"name": "algebra.lsmul", "description": " The `R`-algebra morphism `A \u2192 End (M)` corresponding to the representation of the algebra `A`\non the `R`-module `M`.\n\nThis is a stronger version of `distrib_mul_action.to_linear_map`, and could also have been\ncalled `algebra.to_module_End`.", "p": "mathlib"}, {"name": "alg_hom.comp_algebra_map_of_tower", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.algebra_map_smul", "description": "", "p": "mathlib"}, {"name": "alg_hom.restrict_scalars_apply", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.coe_to_alg_hom", "description": "", "p": "mathlib"}, {"name": "submodule.smul_mem_span_smul_of_mem", "description": "", "p": "mathlib"}, {"name": "submodule.span_algebra_map_image_of_tower", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.coe_to_alg_hom'", "description": "", "p": "mathlib"}, {"name": "submodule.restrict_scalars_span", "description": " If `A` is an `R`-algebra such that the induced morphism `R \u2192+* A` is surjective, then the\n`R`-module generated by a set `X` equals the `A`-module generated by `X`.", "p": "mathlib"}, {"name": "algebra.lsmul_coe", "description": "", "p": "mathlib"}, {"name": "alg_hom.coe_restrict_scalars'", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.algebra_map_apply", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.algebra_map_eq", "description": "", "p": "mathlib"}, {"name": "submodule.coe_span_eq_span_of_surjective", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.of_algebra_map_eq'", "description": "See note [partially-applied ext lemmas].", "p": "mathlib"}, {"name": "is_scalar_tower.to_alg_hom_apply", "description": "", "p": "mathlib"}, {"name": "alg_equiv.restrict_scalars_injective", "description": "", "p": "mathlib"}, {"name": "alg_equiv.restrict_scalars_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.coev_app_comp_pre_app", "description": "", "p": "mathlib"}, {"name": "category_theory.exponentiable", "description": "An object `X` is *exponentiable* if `(X \u00d7 -)` is a left adjoint.\nWe define this as being `closed` in the cartesian monoidal structure.", "p": "mathlib"}, {"name": "category_theory.pre", "description": "Pre-compose an internal hom with an external hom.", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry_uncurry", "description": "", "p": "mathlib"}, {"name": "category_theory.prod_coprod_distrib", "description": "In a CCC with binary coproducts, the distribution morphism is an isomorphism.", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry_eq_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.uncurry_injective", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed", "description": "A category `C` is cartesian closed if it has finite products and every object is exponentiable.\nWe define this as `monoidal_closed` with respect to the cartesian monoidal structure.", "p": "mathlib"}, {"name": "category_theory.pow_zero", "description": "If an initial object `0` exists in a CCC then `0^B \u2245 1` for any `B`.", "p": "mathlib"}, {"name": "category_theory.binary_product_exponentiable", "description": "If `X` and `Y` are exponentiable then `X \u2a2f Y` is.\nThis isn't an instance because it's not usually how we want to construct exponentials, we'll usually\nprove all objects are exponential uniformly.", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry_natural_right", "description": "", "p": "mathlib"}, {"name": "category_theory.exp.ev", "description": "The evaluation natural transformation.", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.eq_curry_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.exp_terminal_iso_self", "description": "Show that the exponential of the terminal object is isomorphic to itself, i.e. `X^1 \u2245 X`.\n\nThe typeclass argument is explicit: any instance can be used.", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.uncurry_natural_left", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.uncurry_natural_right", "description": "", "p": "mathlib"}, {"name": "category_theory.internal_hom", "description": "The internal hom functor given by the cartesian closed structure.", "p": "mathlib"}, {"name": "category_theory.exp.adjunction", "description": "The adjunction between A \u2a2f - and (-)^A.", "p": "mathlib"}, {"name": "category_theory.zero_mul", "description": "If an initial object `I` exists in a CCC, then `A \u2a2f I \u2245 I`.", "p": "mathlib"}, {"name": "category_theory.exp.coev_ev", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.hom_equiv_symm_apply_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.uncurry_id_eq_ev", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.uncurry_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.internalize_hom", "description": "The internal element which points at the given morphism.", "p": "mathlib"}, {"name": "category_theory.zero_mul_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry_natural_right_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.strict_initial", "description": "If an initial object `I` exists in a CCC then it is a strict initial object,\ni.e. any morphism to `I` is an iso.\nThis actually shows a slightly stronger version: any morphism to an initial object from an\nexponentiable object is an isomorphism.", "p": "mathlib"}, {"name": "category_theory.exp.ev_coev", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.uncurry", "description": "Uncurrying in a cartesian closed category.", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.uncurry_curry", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry_natural_left", "description": "", "p": "mathlib"}, {"name": "category_theory.pre_id", "description": "", "p": "mathlib"}, {"name": "category_theory.obj.limits.preserves_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.to_initial_is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry_id_eq_coev", "description": "", "p": "mathlib"}, {"name": "category_theory.prod_map_pre_app_comp_ev", "description": "", "p": "mathlib"}, {"name": "category_theory.initial_mono", "description": "If an initial object `0` exists in a CCC then every morphism from it is monic.", "p": "mathlib"}, {"name": "category_theory.pre_map", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry_natural_left_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.hom_equiv_apply_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.uncurry_natural_left_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.exp.ev_coev_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.mul_zero", "description": "If an initial object `0` exists in a CCC, then `0 \u2a2f A \u2245 0`.", "p": "mathlib"}, {"name": "category_theory.terminal_exponentiable", "description": "The terminal object is always exponentiable.\nThis isn't an instance because most of the time we'll prove cartesian closed for all objects\nat once, rather than just for this one.", "p": "mathlib"}, {"name": "category_theory.initial.mono_to", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed_of_equiv", "description": "Transport the property of being cartesian closed across an equivalence of categories.\n\nNote we didn't require any coherence between the choice of finite products here, since we transport\nalong the `prod_comparison` isomorphism.", "p": "mathlib"}, {"name": "category_theory.zero_mul_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.exp.coev", "description": "The coevaluation natural transformation.", "p": "mathlib"}, {"name": "category_theory.uncurry_pre", "description": "", "p": "mathlib"}, {"name": "category_theory.exp", "description": "This is (-)^A.", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.uncurry_natural_right_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.exp.coev_ev_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry_injective", "description": "", "p": "mathlib"}, {"name": "category_theory.cartesian_closed.curry", "description": "Currying in a cartesian closed category.", "p": "mathlib"}, {"name": "multiset.fold_eq_foldr", "description": "", "p": "mathlib"}, {"name": "multiset.fold_eq_foldl", "description": "", "p": "mathlib"}, {"name": "multiset.fold_cons'_left", "description": "", "p": "mathlib"}, {"name": "multiset.fold", "description": "`fold op b s` folds a commutative associative operation `op` over\n the multiset `s`.", "p": "mathlib"}, {"name": "multiset.fold_cons_right", "description": "", "p": "mathlib"}, {"name": "multiset.fold_distrib", "description": "", "p": "mathlib"}, {"name": "multiset.fold_cons'_right", "description": "", "p": "mathlib"}, {"name": "multiset.fold_dedup_idem", "description": "", "p": "mathlib"}, {"name": "multiset.fold_cons_left", "description": "", "p": "mathlib"}, {"name": "multiset.fold_add", "description": "", "p": "mathlib"}, {"name": "multiset.fold_singleton", "description": "", "p": "mathlib"}, {"name": "multiset.max_le_of_forall_le", "description": "", "p": "mathlib"}, {"name": "multiset.fold_union_inter", "description": "", "p": "mathlib"}, {"name": "multiset.coe_fold_r", "description": "", "p": "mathlib"}, {"name": "multiset.coe_fold_l", "description": "", "p": "mathlib"}, {"name": "multiset.fold_hom", "description": "", "p": "mathlib"}, {"name": "multiset.le_smul_dedup", "description": "", "p": "mathlib"}, {"name": "multiset.fold_zero", "description": "", "p": "mathlib"}, {"name": "multiset.fold_bind", "description": "", "p": "mathlib"}, {"name": "multiset.max_nat_le_of_forall_le", "description": "", "p": "mathlib"}, {"name": "list.sublist_iff_exists_order_embedding_nth_eq", "description": "A `l : list \u03b1` is `sublist l l'` for `l' : list \u03b1` iff\nthere is `f`, an order-preserving embedding of `\u2115` into `\u2115` such that\nany element of `l` found at index `ix` can be found at index `f ix` in `l'`.", "p": "mathlib"}, {"name": "list.nodup.nth_le_equiv_apply_coe", "description": "", "p": "mathlib"}, {"name": "list.sorted.nth_le_mono", "description": "", "p": "mathlib"}, {"name": "list.sublist_of_order_embedding_nth_eq", "description": "If there is `f`, an order-preserving embedding of `\u2115` into `\u2115` such that\nany element of `l` found at index `ix` can be found at index `f ix` in `l'`,\nthen `sublist l l'`.", "p": "mathlib"}, {"name": "list.sorted.nth_le_iso", "description": " If `l` is a list sorted w.r.t. `(<)`, then `list.nth_le` defines an order isomorphism between\n`fin (length l)` and the set of elements of `l`.", "p": "mathlib"}, {"name": "list.sorted.nth_le_strict_mono", "description": "", "p": "mathlib"}, {"name": "list.nodup.nth_le_bijection_of_forall_mem_list_coe", "description": "", "p": "mathlib"}, {"name": "list.nodup.nth_le_equiv_of_forall_mem_list_apply", "description": "", "p": "mathlib"}, {"name": "list.nodup.nth_le_equiv_of_forall_mem_list_symm_apply_val", "description": "", "p": "mathlib"}, {"name": "list.sorted.coe_nth_le_iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "list.nodup.nth_le_equiv_of_forall_mem_list", "description": " If `l` lists all the elements of `\u03b1` without duplicates, then `list.nth_le` defines\nan equivalence between `fin l.length` and `\u03b1`.\n\nSee `list.nodup.nth_le_bijection_of_forall_mem_list` for a version without\ndecidable equality.", "p": "mathlib"}, {"name": "list.nodup.nth_le_equiv", "description": " If `l` has no duplicates, then `list.nth_le` defines an equivalence between `fin (length l)` and\nthe set of elements of `l`.", "p": "mathlib"}, {"name": "list.nodup.nth_le_equiv_symm_apply_val", "description": "", "p": "mathlib"}, {"name": "list.sublist_iff_exists_fin_order_embedding_nth_le_eq", "description": "A `l : list \u03b1` is `sublist l l'` for `l' : list \u03b1` iff\nthere is `f`, an order-preserving embedding of `fin l.length` into `fin l'.length` such that\nany element of `l` found at index `ix` can be found at index `f ix` in `l'`.", "p": "mathlib"}, {"name": "list.nodup.nth_le_bijection_of_forall_mem_list", "description": " If `l` lists all the elements of `\u03b1` without duplicates, then `list.nth_le` defines\na bijection `fin l.length \u2192 \u03b1`.  See `list.nodup.nth_le_equiv_of_forall_mem_list`\nfor a version giving an equivalence when there is decidable equality.", "p": "mathlib"}, {"name": "list.sorted.coe_nth_le_iso_apply", "description": "", "p": "mathlib"}, {"name": "list.duplicate_iff_exists_distinct_nth_le", "description": "An element `x : \u03b1` of `l : list \u03b1` is a duplicate iff it can be found\nat two distinct indices `n m : \u2115` inside the list `l`.", "p": "mathlib"}, {"name": "measure_theory.add_haar_image_eq_zero_of_det_fderiv_within_eq_zero", "description": " A version of Sard lemma in fixed dimension: given a differentiable function from `E` to `E` and\na set where the differential is not invertible, then the image of this set has zero measure.", "p": "mathlib"}, {"name": "measure_theory.ae_measurable_to_nnreal_abs_det_fderiv_within", "description": "", "p": "mathlib"}, {"name": "measure_theory.integrable_on_image_iff_integrable_on_abs_deriv_smul", "description": " Integrability in the change of variable formula for differentiable functions (one-variable\nversion): if a function `f` is injective and differentiable on a measurable set ``s \u2286 \u211d`, then a\nfunction `g : \u211d \u2192 F` is integrable on `f '' s` if and only if `|(f' x)| \u2022 g \u2218 f` is integrable on\n`s`.", "p": "mathlib"}, {"name": "measure_theory.mul_le_add_haar_image_of_lt_det", "description": " Let `f` be a function which is sufficiently close (in the Lipschitz sense) to a given linear\nmap `A`. Then it expands the volume of any set by at least `m` for any `m < det A`.", "p": "mathlib"}, {"name": "approximates_linear_on.norm_fderiv_sub_le", "description": " If a differentiable function `f` is approximated by a linear map `A` on a set `s`, up to `\u03b4`,\nthen at almost every `x` in `s` one has `\u2016f' x - A\u2016 \u2264 \u03b4`.", "p": "mathlib"}, {"name": "measure_theory.integral_image_eq_integral_abs_det_fderiv_smul", "description": " Change of variable formula for differentiable functions: if a function `f` is\ninjective and differentiable on a measurable set `s`, then the Bochner integral of a function\n`g : E \u2192 F` on `f '' s` coincides with the integral of `|(f' x).det| \u2022 g \u2218 f` on `s`.", "p": "mathlib"}, {"name": "measure_theory.add_haar_image_le_lintegral_abs_det_fderiv", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_abs_det_fderiv_le_add_haar_image", "description": "", "p": "mathlib"}, {"name": "measure_theory.restrict_map_with_density_abs_det_fderiv_eq_add_haar", "description": " Change of variable formula for differentiable functions, set version: if a function `f` is\ninjective and differentiable on a measurable set `s`, then the pushforward of the measure with\ndensity `|(f' x).det|` on `s` is the Lebesgue measure on the image set. This version is expressed\nin terms of the restricted function `s.restrict f`.\nFor a version for the original function, but with a measurability assumption,\nsee `map_with_density_abs_det_fderiv_eq_add_haar`.", "p": "mathlib"}, {"name": "measure_theory.ae_measurable_fderiv_within", "description": " The derivative of a function on a measurable set is almost everywhere measurable on this set\nwith respect to Lebesgue measure. Note that, in general, it is not genuinely measurable there,\nas `f'` is not unique (but only on a set of measure `0`, as the argument shows).", "p": "mathlib"}, {"name": "measure_theory.integral_image_eq_integral_abs_deriv_smul", "description": " Change of variable formula for differentiable functions (one-variable version): if a function\n`f` is injective and differentiable on a measurable set `s \u2286 \u211d`, then the Bochner integral of a\nfunction `g : \u211d \u2192 F` on `f '' s` coincides with the integral of `|(f' x)| \u2022 g \u2218 f` on `s`.", "p": "mathlib"}, {"name": "measure_theory.lintegral_abs_det_fderiv_le_add_haar_image_aux1", "description": "", "p": "mathlib"}, {"name": "measure_theory.integral_target_eq_integral_abs_det_fderiv_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.add_haar_image_le_lintegral_abs_det_fderiv_aux2", "description": "", "p": "mathlib"}, {"name": "measure_theory.add_haar_image_le_lintegral_abs_det_fderiv_aux1", "description": "", "p": "mathlib"}, {"name": "exists_partition_approximates_linear_on_of_has_fderiv_within_at", "description": " Assume that a function `f` has a derivative at every point of a set `s`. Then one may\npartition `s` into countably many disjoint relatively measurable sets (i.e., intersections\nof `s` with measurable sets `t n`) on which `f` is well approximated by linear maps `A n`.", "p": "mathlib"}, {"name": "measure_theory.add_haar_image_eq_zero_of_det_fderiv_within_eq_zero_aux", "description": " A version of Sard lemma in fixed dimension: given a differentiable function from `E` to `E` and\na set where the differential is not invertible, then the image of this set has zero measure.\nHere, we give an auxiliary statement towards this result.", "p": "mathlib"}, {"name": "measure_theory.add_haar_image_eq_zero_of_differentiable_on_of_add_haar_eq_zero", "description": "A differentiable function maps sets of measure zero to sets of measure zero.", "p": "mathlib"}, {"name": "measure_theory.lintegral_abs_det_fderiv_eq_add_haar_image", "description": " Change of variable formula for differentiable functions, set version: if a function `f` is\ninjective and differentiable on a measurable set `s`, then the measure of `f '' s` is given by the\nintegral of `|(f' x).det|` on `s`.\nNote that the measurability of `f '' s` is given by `measurable_image_of_fderiv_within`.", "p": "mathlib"}, {"name": "measure_theory.lintegral_abs_det_fderiv_le_add_haar_image_aux2", "description": "", "p": "mathlib"}, {"name": "measure_theory.integrable_on_image_iff_integrable_on_abs_det_fderiv_smul", "description": " Integrability in the change of variable formula for differentiable functions: if a\nfunction `f` is injective and differentiable on a measurable set `s`, then a function\n`g : E \u2192 F` is integrable on `f '' s` if and only if `|(f' x).det| \u2022 g \u2218 f` is\nintegrable on `s`.", "p": "mathlib"}, {"name": "measure_theory.ae_measurable_of_real_abs_det_fderiv_within", "description": "", "p": "mathlib"}, {"name": "exists_closed_cover_approximates_linear_on_of_has_fderiv_within_at", "description": " Assume that a function `f` has a derivative at every point of a set `s`. Then one may cover `s`\nwith countably many closed sets `t n` on which `f` is well approximated by linear maps `A n`.", "p": "mathlib"}, {"name": "measure_theory.measurable_image_of_fderiv_within", "description": " If a function is differentiable and injective on a measurable set,\nthen the image is measurable.", "p": "mathlib"}, {"name": "measure_theory.map_with_density_abs_det_fderiv_eq_add_haar", "description": " Change of variable formula for differentiable functions, set version: if a function `f` is\ninjective and differentiable on a measurable set `s`, then the pushforward of the measure with\ndensity `|(f' x).det|` on `s` is the Lebesgue measure on the image set. This version requires\nthat `f` is measurable, as otherwise `measure.map f` is zero per our definitions.\nFor a version without measurability assumption but dealing with the restricted\nfunction `s.restrict f`, see `restrict_map_with_density_abs_det_fderiv_eq_add_haar`.", "p": "mathlib"}, {"name": "measure_theory.add_haar_image_le_mul_of_det_lt", "description": " Let `f` be a function which is sufficiently close (in the Lipschitz sense) to a given linear\nmap `A`. Then it expands the volume of any set by at most `m` for any `m > det A`.", "p": "mathlib"}, {"name": "measure_theory.measurable_embedding_of_fderiv_within", "description": " If a function is differentiable and injective on a measurable set `s`, then its restriction\nto `s` is a measurable embedding.", "p": "mathlib"}, {"name": "measure_theory.lintegral_image_eq_lintegral_abs_det_fderiv_mul", "description": "", "p": "mathlib"}, {"name": "measure_theory.det_one_smul_right", "description": "", "p": "mathlib"}, {"name": "omega.int.preform.sat_or", "description": "", "p": "mathlib"}, {"name": "omega.int.preform.induce", "description": "Tactic for setting up proof by induction over preforms.", "p": "mathlib"}, {"name": "omega.int.preform.sat", "description": "There exists some valuation that satisfies argument", "p": "mathlib"}, {"name": "omega.int.univ_close_of_valid", "description": "", "p": "mathlib"}, {"name": "omega.int.preform.holds", "description": "Evaluate a preform into prop using the valuation v.", "p": "mathlib"}, {"name": "omega.int.preform.implies", "description": "implies p q := under any valuation, q holds if p holds", "p": "mathlib"}, {"name": "omega.int.preform.has_to_format", "description": "", "p": "mathlib"}, {"name": "omega.int.preform.unsat", "description": "There does not exist any valuation that satisfies argument", "p": "mathlib"}, {"name": "omega.int.preform.sat_of_implies_of_sat", "description": "", "p": "mathlib"}, {"name": "omega.int.univ_close", "description": "univ_close p n := p closed by prepending n universal quantifiers", "p": "mathlib"}, {"name": "omega.int.exprform", "description": "Intermediate shadow syntax for LNA formulas that includes unreified exprs", "p": "mathlib"}, {"name": "omega.int.exprform.eq", "description": "Intermediate shadow syntax for LNA formulas that includes unreified exprs", "p": "mathlib"}, {"name": "omega.int.exprform.le", "description": "Intermediate shadow syntax for LNA formulas that includes unreified exprs", "p": "mathlib"}, {"name": "omega.int.exprform.not", "description": "Intermediate shadow syntax for LNA formulas that includes unreified exprs", "p": "mathlib"}, {"name": "omega.int.exprform.or", "description": "Intermediate shadow syntax for LNA formulas that includes unreified exprs", "p": "mathlib"}, {"name": "omega.int.exprform.and", "description": "Intermediate shadow syntax for LNA formulas that includes unreified exprs", "p": "mathlib"}, {"name": "omega.int.valid_of_unsat_not", "description": "", "p": "mathlib"}, {"name": "omega.int.preform.has_reflect", "description": "", "p": "mathlib"}, {"name": "omega.int.preform.inhabited", "description": "", "p": "mathlib"}, {"name": "omega.int.preform.equiv", "description": "equiv p q := under any valuation, p holds iff q holds", "p": "mathlib"}, {"name": "omega.int.preform", "description": "Intermediate shadow syntax for LIA formulas that includes non-canonical terms", "p": "mathlib"}, {"name": "omega.int.preform.eq", "description": "Intermediate shadow syntax for LIA formulas that includes non-canonical terms", "p": "mathlib"}, {"name": "omega.int.preform.le", "description": "Intermediate shadow syntax for LIA formulas that includes non-canonical terms", "p": "mathlib"}, {"name": "omega.int.preform.not", "description": "Intermediate shadow syntax for LIA formulas that includes non-canonical terms", "p": "mathlib"}, {"name": "omega.int.preform.or", "description": "Intermediate shadow syntax for LIA formulas that includes non-canonical terms", "p": "mathlib"}, {"name": "omega.int.preform.and", "description": "Intermediate shadow syntax for LIA formulas that includes non-canonical terms", "p": "mathlib"}, {"name": "omega.int.preform.has_repr", "description": "", "p": "mathlib"}, {"name": "omega.int.preform.valid", "description": "All valuations satisfy argument", "p": "mathlib"}, {"name": "omega.int.preform.repr", "description": "", "p": "mathlib"}, {"name": "omega.int.preform.fresh_index", "description": "Fresh de Brujin index not used by any variable in argument", "p": "mathlib"}, {"name": "tactic.unfreezing_hyp", "description": "Unfreeze local instances while executing `tac`,\nif the passed expression is amongst the frozen instances.", "p": "core"}, {"name": "tactic.interactive.letI", "description": " Used to add typeclasses to the context so that they can\nbe used in typeclass inference. The syntax is the same as `let`.", "p": "core"}, {"name": "tactic.interactive.casesI", "description": "Like `cases`, but can also be used with instance arguments.", "p": "core"}, {"name": "tactic.interactive.unfreezingI", "description": "`unfreezingI { tac }` executes tac while temporarily unfreezing the instance cache.", "p": "core"}, {"name": "tactic.interactive.exactI", "description": " Like `exact`, but uses all variables in the context\nfor typeclass inference.", "p": "core"}, {"name": "tactic.interactive.haveI", "description": " Used to add typeclasses to the context so that they can\nbe used in typeclass inference. The syntax is the same as `have`.", "p": "core"}, {"name": "tactic.unfreezing", "description": "Unfreeze the local instances while executing `tac` on the main goal.", "p": "core"}, {"name": "tactic.interactive.resetI", "description": " Reset the instance cache. This allows any new instances\nadded to the context to be used in typeclass inference.", "p": "core"}, {"name": "tactic.interactive.substI", "description": "Like `subst`, but can also substitute in instance arguments.", "p": "core"}, {"name": "tactic.reset_instance_cache", "description": "Reset the instance cache for the main goal.", "p": "core"}, {"name": "tactic.interactive.revertI", "description": "Like `revert`, but can also revert instance arguments.", "p": "core"}, {"name": "tactic.interactive.introI", "description": " Like `intro`, but uses the introduced variable\nin typeclass inference.", "p": "core"}, {"name": "tactic.interactive.introsI", "description": " Like `intros`, but uses the introduced variable(s)\nin typeclass inference.", "p": "core"}, {"name": "ideal.self_basis_def", "description": " If `S` a finite-dimensional ring extension of a PID `R` which is free as an `R`-module,\nthen any nonzero `S`-ideal `I` is free as an `R`-submodule of `S`, and we can\nfind a basis for `S` and `I` such that the inclusion map is a square diagonal\nmatrix.", "p": "mathlib"}, {"name": "ideal.smith_coeffs_ne_zero", "description": "", "p": "mathlib"}, {"name": "module.free_of_finite_type_torsion_free", "description": "", "p": "mathlib"}, {"name": "ideal.self_basis", "description": " If `S` a finite-dimensional ring extension of a PID `R` which is free as an `R`-module,\nthen any nonzero `S`-ideal `I` is free as an `R`-submodule of `S`, and we can\nfind a basis for `S` and `I` such that the inclusion map is a square diagonal\nmatrix; this is the basis for `I`.\nSee `ideal.ring_basis` for the basis on `S`,\nsee `ideal.smith_coeffs` for the entries of the diagonal matrix\nand `ideal.self_basis_def` for the proof that the inclusion map forms a square diagonal matrix.", "p": "mathlib"}, {"name": "basis.smith_normal_form", "description": " A Smith normal form basis for a submodule `N` of a module `M` consists of\nbases for `M` and `N` such that the inclusion map `N \u2192 M` can be written as a\n(rectangular) matrix with `a` along the diagonal: in Smith normal form.", "p": "mathlib"}, {"name": "basis.smith_normal_form.bM", "description": " A Smith normal form basis for a submodule `N` of a module `M` consists of\nbases for `M` and `N` such that the inclusion map `N \u2192 M` can be written as a\n(rectangular) matrix with `a` along the diagonal: in Smith normal form.", "p": "mathlib"}, {"name": "basis.smith_normal_form.bN", "description": " A Smith normal form basis for a submodule `N` of a module `M` consists of\nbases for `M` and `N` such that the inclusion map `N \u2192 M` can be written as a\n(rectangular) matrix with `a` along the diagonal: in Smith normal form.", "p": "mathlib"}, {"name": "basis.smith_normal_form.f", "description": " A Smith normal form basis for a submodule `N` of a module `M` consists of\nbases for `M` and `N` such that the inclusion map `N \u2192 M` can be written as a\n(rectangular) matrix with `a` along the diagonal: in Smith normal form.", "p": "mathlib"}, {"name": "basis.smith_normal_form.a", "description": " A Smith normal form basis for a submodule `N` of a module `M` consists of\nbases for `M` and `N` such that the inclusion map `N \u2192 M` can be written as a\n(rectangular) matrix with `a` along the diagonal: in Smith normal form.", "p": "mathlib"}, {"name": "basis.smith_normal_form.snf", "description": " A Smith normal form basis for a submodule `N` of a module `M` consists of\nbases for `M` and `N` such that the inclusion map `N \u2192 M` can be written as a\n(rectangular) matrix with `a` along the diagonal: in Smith normal form.", "p": "mathlib"}, {"name": "submodule.basis_of_pid_aux", "description": " The induction hypothesis of `submodule.basis_of_pid` and `submodule.smith_normal_form`.\n\nBasically, it says: let `N \u2264 M` be a pair of submodules, then we can find a pair of\nsubmodules `N' \u2264 M'` of strictly smaller rank, whose basis we can extend to get a basis\nof `N` and `M`. Moreover, if the basis for `M'` is up to scalars a basis for `N'`,\nthen the basis we find for `M` is up to scalars a basis for `N`.\n\nFor `basis_of_pid` we only need the first half and can fix `M = \u22a4`,\nfor `smith_normal_form` we need the full statement,\nbut must also feed in a basis for `M` using `basis_of_pid` to keep the induction going.", "p": "mathlib"}, {"name": "ideal.smith_normal_form", "description": " If `S` a finite-dimensional ring extension of a PID `R` which is free as an `R`-module,\nthen any nonzero `S`-ideal `I` is free as an `R`-submodule of `S`, and we can\nfind a basis for `S` and `I` such that the inclusion map is a square diagonal\nmatrix.\n\nSee `ideal.exists_smith_normal_form` for a version of this theorem that doesn't\nneed to map `I` into a submodule of `R`.\n\nThis is a strengthening of `submodule.basis_of_pid`.", "p": "mathlib"}, {"name": "submodule.nonempty_basis_of_pid", "description": " A submodule of a free `R`-module of finite rank is also a free `R`-module of finite rank,\nif `R` is a principal ideal domain.\n\nThis is a `lemma` to make the induction a bit easier. To actually access the basis,\nsee `submodule.basis_of_pid`.\n\nSee also the stronger version `submodule.smith_normal_form`.", "p": "mathlib"}, {"name": "submodule.exists_smith_normal_form_of_le", "description": " If `M` is finite free over a PID `R`, then any submodule `N` is free\nand we can find a basis for `M` and `N` such that the inclusion map is a diagonal matrix\nin Smith normal form.\n\nSee `submodule.smith_normal_form_of_le` for a version of this theorem that returns\na `basis.smith_normal_form`.\n\nThis is a strengthening of `submodule.basis_of_pid_of_le`.", "p": "mathlib"}, {"name": "submodule.smith_normal_form", "description": " If `M` is finite free over a PID `R`, then any submodule `N` is free\nand we can find a basis for `M` and `N` such that the inclusion map is a diagonal matrix\nin Smith normal form.\n\nThis is a strengthening of `submodule.basis_of_pid`.\n\nSee also `ideal.smith_normal_form`, which moreover proves that the dimension of\nan ideal is the same as the dimension of the whole ring.", "p": "mathlib"}, {"name": "dvd_generator_iff", "description": "", "p": "mathlib"}, {"name": "module.basis_of_finite_type_torsion_free'", "description": "A finite type torsion free module over a PID admits a basis.", "p": "mathlib"}, {"name": "generator_maximal_submodule_image_dvd", "description": "", "p": "mathlib"}, {"name": "ideal.exists_smith_normal_form", "description": " If `S` a finite-dimensional ring extension of a PID `R` which is free as an `R`-module,\nthen any nonzero `S`-ideal `I` is free as an `R`-submodule of `S`, and we can\nfind a basis for `S` and `I` such that the inclusion map is a square diagonal\nmatrix.\n\nSee also `ideal.smith_normal_form` for a version of this theorem that returns\na `basis.smith_normal_form`.\n\nThe definitions `ideal.ring_basis`, `ideal.self_basis`, `ideal.smith_coeffs` are (noncomputable)\nchoices of values for this existential quantifier.", "p": "mathlib"}, {"name": "submodule.smith_normal_form_of_le", "description": " If `M` is finite free over a PID `R`, then any submodule `N` is free\nand we can find a basis for `M` and `N` such that the inclusion map is a diagonal matrix\nin Smith normal form.\n\nSee `submodule.exists_smith_normal_form_of_le` for a version of this theorem that doesn't\nneed to map `N` into a submodule of `O`.\n\nThis is a strengthening of `submodule.basis_of_pid_of_le`.", "p": "mathlib"}, {"name": "eq_bot_of_generator_maximal_map_eq_zero", "description": "", "p": "mathlib"}, {"name": "submodule.basis_of_pid_of_le_span", "description": " A submodule inside the span of a linear independent family is a free `R`-module of finite rank,\nif `R` is a principal ideal domain.", "p": "mathlib"}, {"name": "eq_bot_of_generator_maximal_submodule_image_eq_zero", "description": "", "p": "mathlib"}, {"name": "submodule.basis_of_pid_bot", "description": "", "p": "mathlib"}, {"name": "module.free_of_finite_type_torsion_free'", "description": "", "p": "mathlib"}, {"name": "submodule.basis_of_pid_of_le", "description": " A submodule inside a free `R`-submodule of finite rank is also a free `R`-module of finite rank,\nif `R` is a principal ideal domain.\n\nSee also the stronger version `submodule.smith_normal_form_of_le`.", "p": "mathlib"}, {"name": "submodule.basis_of_pid", "description": " A submodule of a free `R`-module of finite rank is also a free `R`-module of finite rank,\nif `R` is a principal ideal domain.\n\nSee also the stronger version `submodule.smith_normal_form`.", "p": "mathlib"}, {"name": "ideal.ring_basis", "description": " If `S` a finite-dimensional ring extension of a PID `R` which is free as an `R`-module,\nthen any nonzero `S`-ideal `I` is free as an `R`-submodule of `S`, and we can\nfind a basis for `S` and `I` such that the inclusion map is a square diagonal\nmatrix; this is the basis for `S`.\nSee `ideal.self_basis` for the basis on `I`,\nsee `ideal.smith_coeffs` for the entries of the diagonal matrix\nand `ideal.self_basis_def` for the proof that the inclusion map forms a square diagonal matrix.", "p": "mathlib"}, {"name": "ideal.smith_coeffs", "description": " If `S` a finite-dimensional ring extension of a PID `R` which is free as an `R`-module,\nthen any nonzero `S`-ideal `I` is free as an `R`-submodule of `S`, and we can\nfind a basis for `S` and `I` such that the inclusion map is a square diagonal\nmatrix; these are the entries of the diagonal matrix.\nSee `ideal.ring_basis` for the basis on `S`,\nsee `ideal.self_basis` for the basis on `I`,\nand `ideal.self_basis_def` for the proof that the inclusion map forms a square diagonal matrix.", "p": "mathlib"}, {"name": "has_quotient.quotient.module", "description": "", "p": "mathlib"}, {"name": "module.basis_of_finite_type_torsion_free", "description": "A finite type torsion free module over a PID admits a basis.", "p": "mathlib"}, {"name": "linear_independent.restrict_scalars_algebras", "description": " A set of linearly independent vectors in a module `M` over a semiring `S` is also linearly\nindependent over a subring `R` of `K`.", "p": "mathlib"}, {"name": "fin.is_three_cycle_cycle_range_two", "description": "", "p": "mathlib"}, {"name": "equiv.perm.decompose_fin", "description": " Permutations of `fin (n + 1)` are equivalent to fixing a single\n`fin (n + 1)` and permuting the remaining with a `perm (fin n)`.\nThe fixed `fin (n + 1)` is swapped with `0`.", "p": "mathlib"}, {"name": "fin.cycle_range_succ_above", "description": "", "p": "mathlib"}, {"name": "equiv.perm.decompose_fin_symm_of_refl", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_last", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_zero", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_of_eq", "description": "", "p": "mathlib"}, {"name": "support_fin_rotate", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_symm_succ", "description": "", "p": "mathlib"}, {"name": "is_cycle_fin_rotate_of_le", "description": "", "p": "mathlib"}, {"name": "equiv.perm.decompose_fin_symm_apply_zero", "description": "", "p": "mathlib"}, {"name": "is_cycle_fin_rotate", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_zero'", "description": "", "p": "mathlib"}, {"name": "equiv.perm.decompose_fin_symm_apply_one", "description": "", "p": "mathlib"}, {"name": "fin.coe_cycle_range_of_lt", "description": "", "p": "mathlib"}, {"name": "cycle_type_fin_rotate_of_le", "description": "", "p": "mathlib"}, {"name": "equiv.perm.decompose_fin.symm_sign", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_of_le", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_of_lt", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_apply", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range", "description": "`fin.cycle_range i` is the cycle `(0 1 2 ... i)` leaving `(i+1 ... (n-1))` unchanged.", "p": "mathlib"}, {"name": "cycle_type_fin_rotate", "description": "", "p": "mathlib"}, {"name": "equiv.perm.decompose_fin_symm_of_one", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_self", "description": "", "p": "mathlib"}, {"name": "sign_fin_rotate", "description": "", "p": "mathlib"}, {"name": "fin.cycle_type_cycle_range", "description": "", "p": "mathlib"}, {"name": "support_fin_rotate_of_le", "description": "", "p": "mathlib"}, {"name": "fin_rotate_succ", "description": "", "p": "mathlib"}, {"name": "equiv.perm.decompose_fin_symm_apply_succ", "description": "", "p": "mathlib"}, {"name": "fin.sign_cycle_range", "description": "", "p": "mathlib"}, {"name": "fin.is_cycle_cycle_range", "description": "", "p": "mathlib"}, {"name": "finset.univ_perm_fin_succ", "description": " The set of all permutations of `fin (n + 1)` can be constructed by augmenting the set of\npermutations of `fin n` by each element of `fin (n + 1)` in turn.", "p": "mathlib"}, {"name": "fin.cycle_range_of_gt", "description": "", "p": "mathlib"}, {"name": "fin.succ_above_cycle_range", "description": "", "p": "mathlib"}, {"name": "fin.coe_cycle_range_of_le", "description": "", "p": "mathlib"}, {"name": "fin.cycle_range_symm_zero", "description": "", "p": "mathlib"}, {"name": "convex_halfspace_re_lt", "description": "", "p": "mathlib"}, {"name": "convex_halfspace_im_gt", "description": "", "p": "mathlib"}, {"name": "convex_halfspace_re_gt", "description": "", "p": "mathlib"}, {"name": "convex_halfspace_re_ge", "description": "", "p": "mathlib"}, {"name": "convex_halfspace_im_lt", "description": "", "p": "mathlib"}, {"name": "convex_halfspace_im_ge", "description": "", "p": "mathlib"}, {"name": "convex_halfspace_re_le", "description": "", "p": "mathlib"}, {"name": "convex_halfspace_im_le", "description": "", "p": "mathlib"}, {"name": "linear_pmap.eq_of_eq_graph", "description": "", "p": "mathlib"}, {"name": "submodule.to_linear_pmap_graph_eq", "description": "", "p": "mathlib"}, {"name": "linear_pmap.coe_smul", "description": "", "p": "mathlib"}, {"name": "linear_pmap.comp", "description": "Compose two `linear_pmap`s", "p": "mathlib"}, {"name": "linear_pmap.graph", "description": "The graph of a `linear_pmap` viewed as a submodule on `E \u00d7 F`.", "p": "mathlib"}, {"name": "linear_pmap.map_smul", "description": "", "p": "mathlib"}, {"name": "linear_pmap.ext'", "description": "", "p": "mathlib"}, {"name": "linear_pmap.map_sub", "description": "", "p": "mathlib"}, {"name": "linear_pmap.mul_action", "description": "", "p": "mathlib"}, {"name": "linear_pmap.has_vadd", "description": "", "p": "mathlib"}, {"name": "linear_pmap.right_le_sup", "description": "", "p": "mathlib"}, {"name": "linear_pmap.eq_locus", "description": " Given two partial linear maps `f`, `g`, the set of points `x` such that\nboth `f` and `g` are defined at `x` and `f x = g x` form a submodule.", "p": "mathlib"}, {"name": "linear_pmap.domain_mono", "description": "", "p": "mathlib"}, {"name": "linear_pmap.neg_apply", "description": "", "p": "mathlib"}, {"name": "linear_pmap.Sup_apply", "description": "", "p": "mathlib"}, {"name": "linear_pmap.domain_mk_span_singleton", "description": "", "p": "mathlib"}, {"name": "linear_pmap.add_action", "description": "", "p": "mathlib"}, {"name": "linear_pmap.smul_comm_class", "description": "", "p": "mathlib"}, {"name": "linear_pmap.dom_restrict_le", "description": "", "p": "mathlib"}, {"name": "submodule.to_linear_pmap", "description": "Define a `linear_pmap` from its graph.", "p": "mathlib"}, {"name": "linear_pmap", "description": "A `linear_pmap R E F` or `E \u2192\u2097.[R] F` is a linear map from a submodule of `E` to `F`.", "p": "mathlib"}, {"name": "linear_pmap.domain", "description": "A `linear_pmap R E F` or `E \u2192\u2097.[R] F` is a linear map from a submodule of `E` to `F`.", "p": "mathlib"}, {"name": "linear_pmap.to_fun", "description": "A `linear_pmap R E F` or `E \u2192\u2097.[R] F` is a linear map from a submodule of `E` to `F`.", "p": "mathlib"}, {"name": "linear_pmap.mk_span_singleton", "description": " The unique `linear_pmap` on `span R {x}` that sends a non-zero vector `x` to `y`.\nThis version works for modules over division rings.", "p": "mathlib"}, {"name": "linear_pmap.inhabited", "description": "", "p": "mathlib"}, {"name": "linear_pmap.has_bot", "description": "", "p": "mathlib"}, {"name": "linear_pmap.eq_of_le_of_domain_eq", "description": "", "p": "mathlib"}, {"name": "linear_pmap.le_graph_iff", "description": "", "p": "mathlib"}, {"name": "linear_pmap.apply_comp_of_le", "description": "", "p": "mathlib"}, {"name": "linear_pmap.smul_apply", "description": "", "p": "mathlib"}, {"name": "linear_pmap.mk_span_singleton'", "description": " The unique `linear_pmap` on `R \u2219 x` that sends `x` to `y`. This version works for modules\nover rings, and requires a proof of `\u2200 c, c \u2022 x = 0 \u2192 c \u2022 y = 0`.", "p": "mathlib"}, {"name": "linear_pmap.coprod_apply", "description": "", "p": "mathlib"}, {"name": "linear_pmap.mem_graph_iff'", "description": "", "p": "mathlib"}, {"name": "submodule.val_from_graph_mem", "description": "", "p": "mathlib"}, {"name": "linear_pmap.mem_domain_iff_of_eq_graph", "description": "", "p": "mathlib"}, {"name": "linear_pmap.snd", "description": "Projection to the second coordinate as a `linear_pmap`", "p": "mathlib"}, {"name": "linear_pmap.mk_span_singleton'_apply", "description": "", "p": "mathlib"}, {"name": "linear_pmap.smul_domain", "description": "", "p": "mathlib"}, {"name": "linear_pmap.to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "linear_pmap.le_Sup", "description": "", "p": "mathlib"}, {"name": "linear_pmap.sup_span_singleton_apply_mk", "description": "", "p": "mathlib"}, {"name": "linear_pmap.Sup", "description": " Glue a collection of partially defined linear maps to a linear map defined on `Sup`\nof these submodules.", "p": "mathlib"}, {"name": "linear_pmap.snd_apply", "description": "", "p": "mathlib"}, {"name": "linear_pmap.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "linear_pmap.left_le_sup", "description": "", "p": "mathlib"}, {"name": "linear_pmap.mem_domain_iff", "description": "", "p": "mathlib"}, {"name": "linear_pmap.dom_restrict_apply", "description": "", "p": "mathlib"}, {"name": "linear_pmap.sup", "description": " Given two partial linear maps that agree on the intersection of their domains,\n`f.sup g