ption": "", "p": "mathlib"}, {"name": "box_integral.prepartition.single", "description": "The singleton prepartition `{J}`, `J \u2264 I`.", "p": "mathlib"}, {"name": "box_integral.prepartition.disj_union", "description": "Union of two disjoint prepartitions.", "p": "mathlib"}, {"name": "box_integral.prepartition.bUnion_assoc", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.filter", "description": "The prepartition with boxes `{J \u2208 \u03c0 | p J}`.", "p": "mathlib"}, {"name": "box_integral.prepartition.bUnion_index", "description": " Given a box `J \u2208 \u03c0.bUnion \u03c0i`, returns the box `J' \u2208 \u03c0` such that `J \u2208 \u03c0i J'`.\nFor `J \u2209 \u03c0.bUnion \u03c0i`, returns `I`.", "p": "mathlib"}, {"name": "box_integral.prepartition.bUnion_index_le", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.mem_restrict", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.mem_restrict'", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.Union_filter_not", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.disjoint_boxes_of_disjoint_Union", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.upper_le_upper", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.le_of_mem", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.distortion_le_of_mem", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition", "description": " A prepartition of `I : box_integral.box \u03b9` is a finite set of pairwise disjoint subboxes of\n`I`.", "p": "mathlib"}, {"name": "box_integral.prepartition.boxes", "description": " A prepartition of `I : box_integral.box \u03b9` is a finite set of pairwise disjoint subboxes of\n`I`.", "p": "mathlib"}, {"name": "box_integral.prepartition.le_of_mem'", "description": " A prepartition of `I : box_integral.box \u03b9` is a finite set of pairwise disjoint subboxes of\n`I`.", "p": "mathlib"}, {"name": "box_integral.prepartition.pairwise_disjoint", "description": " A prepartition of `I : box_integral.box \u03b9` is a finite set of pairwise disjoint subboxes of\n`I`.", "p": "mathlib"}, {"name": "box_integral.prepartition.bUnion_le", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.Union_bUnion_partition", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.card_filter_mem_Icc_le", "description": " The set of boxes of a prepartition that contain `x` in their closures has cardinality\nat most `2 ^ fintype.card \u03b9`.", "p": "mathlib"}, {"name": "box_integral.prepartition.bUnion_top", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.mem_of_with_bot", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.Union_def'", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.bUnion_le_iff", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.is_partition_iff_Union_eq", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.Union_disj_union", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.sum_of_with_bot", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.is_partition.bUnion", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.bUnion", "description": " Given a prepartition `\u03c0` of a box `I` and a collection of prepartitions `\u03c0i J` of all boxes\n`J \u2208 \u03c0`, returns the prepartition of `I` into the union of the boxes of all `\u03c0i J`.\n\nThough we only use the values of `\u03c0i` on the boxes of `\u03c0`, we require `\u03c0i` to be a globally defined\nfunction.", "p": "mathlib"}, {"name": "box_integral.prepartition.Union_inf", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.restrict_bUnion", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.lower_le_lower", "descriptio