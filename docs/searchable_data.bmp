d if they compose to the same morphism.", "p": "mathlib"}, {"name": "category_theory.paths.category_paths", "description": "", "p": "mathlib"}, {"name": "category_theory.compose_path_to_path", "description": "", "p": "mathlib"}, {"name": "category_theory.paths.lift_spec", "description": "", "p": "mathlib"}, {"name": "category_theory.to_quotient_paths_obj_as", "description": "", "p": "mathlib"}, {"name": "category_theory.paths.of_map", "description": "", "p": "mathlib"}, {"name": "category_theory.quotient_paths_to", "description": " The functor from the canonical quotient of a path category of a category\nto the original category.", "p": "mathlib"}, {"name": "category_theory.paths.lift_nil", "description": "", "p": "mathlib"}, {"name": "category_theory.compose_path_id", "description": "", "p": "mathlib"}, {"name": "category_theory.quotient_paths_to_map", "description": "", "p": "mathlib"}, {"name": "category_theory.paths.lift_to_path", "description": "", "p": "mathlib"}, {"name": "category_theory.compose_path_comp'", "description": "", "p": "mathlib"}, {"name": "category_theory.paths.lift_cons", "description": "", "p": "mathlib"}, {"name": "category_theory.paths.of_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.quotient_paths_to_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.paths.ext_functor", "description": "Two functors out of a path category are equal when they agree on singleton paths.", "p": "mathlib"}, {"name": "category_theory.compose_path_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.prefunctor.map_path_comp'", "description": "", "p": "mathlib"}, {"name": "category_theory.path_composition_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.paths", "description": "A type synonym for the category of paths in a quiver.", "p": "mathlib"}, {"name": "category_theory.paths.of", "description": "The inclusion of a quiver `V` into its path category, as a prefunctor.", "p": "mathlib"}, {"n