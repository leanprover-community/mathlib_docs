athlib"}, {"name": "comp_assoc_right", "description": "Composing two associative operations of `f : \u03b1 \u2192 \u03b1 \u2192 \u03b1` on the right\nis equal to an associative operation on the right.", "p": "mathlib"}, {"name": "add_zero_sub", "description": "", "p": "mathlib"}, {"name": "add_sub_cancel'", "description": "", "p": "mathlib"}, {"name": "div_mul_div_comm", "description": "", "p": "mathlib"}, {"name": "mul_eq_one_iff_inv_eq", "description": "", "p": "mathlib"}, {"name": "mul_eq_of_eq_div", "description": "", "p": "mathlib"}, {"name": "sub_eq_neg_self", "description": "", "p": "mathlib"}, {"name": "comp_add_right", "description": "Composing two additions on the right by `y` and `x`\nis equal to a addition on the right by `y + x`.", "p": "mathlib"}, {"name": "add_right_surjective", "description": "", "p": "mathlib"}, {"name": "add_rotate'", "description": "", "p": "mathlib"}, {"name": "multiplicative_of_is_total", "description": "If a binary function from a type equipped with a total relation `r` to a monoid is\n anti-symmetric (i.e. satisfies `f a b * f b a = 1`), in order to show it is multiplicative\n (i.e. satisfies `f a c = f a b * f b c`), we may assume `r a b` and `r b c` are satisfied.\n We allow restricting to a subset specified by a predicate `p`.", "p": "mathlib"}, {"name": "div_eq_of_eq_mul'", "description": "", "p": "mathlib"}, {"name": "add_sub_sub_cancel", "description": "", "p": "mathlib"}, {"name": "div_mul", "description": "", "p": "mathlib"}, {"name": "sub_eq_zero_of_eq", "description": "**Alias** of the reverse direction of `sub_eq_zero`.", "p": "mathlib"}, {"name": "self_ne_add_left", "description": "", "p": "mathlib"}, {"name": "sub_add_cancel''", "description": "", "p": "mathlib"}, {"name": "sub_add_sub_comm", "description": "", "p": "mathlib"}, {"name": "self_eq_add_left", "description": "", "p": "mathlib"}, {"name": "ite_zero_add", "description": "", "p": "mathlib"}, {"name": "div_mul_eq_mul_div", "description": "", "p": "mathlib