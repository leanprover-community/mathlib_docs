ption": "", "p": "mathlib"}, {"name": "prod.add_monoid", "description": "", "p": "mathlib"}, {"name": "prod.right_cancel_add_monoid", "description": "", "p": "mathlib"}, {"name": "add_units.embed_product", "description": "Canonical homomorphism of additive monoids from `add_units \u03b1` into `\u03b1 \u00d7 \u03b1\u1d43\u1d52\u1d56`.\nUsed mainly to define the natural topology of `add_units \u03b1`.", "p": "mathlib"}, {"name": "prod.has_one", "description": "", "p": "mathlib"}, {"name": "monoid_hom.inl", "description": "Given monoids `M`, `N`, the natural inclusion homomorphism from `M` to `M \u00d7 N`.", "p": "mathlib"}, {"name": "prod.left_cancel_monoid", "description": "", "p": "mathlib"}, {"name": "prod.inv_mk", "description": "", "p": "mathlib"}, {"name": "add_equiv.prod_prod_prod_comm_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.coe_prod_comm_symm", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.snd_comp_inr", "description": "", "p": "mathlib"}, {"name": "prod.add_group", "description": "", "p": "mathlib"}, {"name": "prod.division_monoid", "description": "", "p": "mathlib"}, {"name": "sub_add_monoid_hom", "description": "Subtraction as an additive monoid homomorphism.", "p": "mathlib"}, {"name": "add_monoid_hom.fst_comp_prod", "description": "", "p": "mathlib"}, {"name": "prod.cancel_add_monoid", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coe_snd", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.prod_map", "description": "`prod.map` as an `add_monoid_hom`", "p": "mathlib"}, {"name": "add_hom.prod_map_def", "description": "", "p": "mathlib"}, {"name": "add_hom.prod_comp_prod_map", "description": "", "p": "mathlib"}, {"name": "add_hom.snd", "description": "Given additive magmas `A`, `B`, the natural projection homomorphism\nfrom `A \u00d7 B` to `B`", "p": "mathlib"}, {"name": "add_monoid_hom.fst_comp_inl", "description": "", "p": "mathlib"}, {"name": "monoid_hom.coe_prod_map", "description": "", "p": "mathlib"}, {"name": "prod.has_involutive_inv", "description": "", "p": "mathlib"}, {"name": "monoid_hom.snd", "description": "Given monoids `M`, `N`, the natural projection homomorphism from `M \u00d7 N` to `N`.", "p": "mathlib"}, {"name": "prod.fst_mul_snd", "description": "", "p": "mathlib"}, {"name": "prod.fst_neg", "description": "", "p": "mathlib"}, {"name": "add_hom.prod_map", "description": "`prod.map` as an `add_monoid_hom`", "p": "mathlib"}, {"name": "add_monoid_hom.prod_map_def", "description": "", "p": "mathlib"}, {"name": "mul_hom.coprod", "description": " Coproduct of two `mul_hom`s with the same codomain:\n`f.coprod g (p : M \u00d7 N) = f p.1 * g p.2`.", "p": "mathlib"}, {"name": "add_units.embed_product_injective", "description": "", "p": "mathlib"}, {"name": "mul_hom.prod_map", "description": "`prod.map` as a `monoid_hom`.", "p": "mathlib"}, {"name": "prod.left_cancel_add_semigroup", "description": "", "p": "mathlib"}, {"name": "prod.add_semigroup", "description": "", "p": "mathlib"}, {"name": "add_equiv.prod_congr", "description": "Product of additive isomorphisms; the maps come from `equiv.prod_congr`.", "p": "mathlib"}, {"name": "mul_equiv.prod_prod_prod_comm_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.coe_snd", "description": "", "p": "mathlib"}, {"name": "prod.neg_mk", "description": "", "p": "mathlib"}, {"name": "prod.subtraction_comm_monoid", "description": "", "p": "mathlib"}, {"name": "prod.has_zero", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.prod_comp_prod_map", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.inl", "description": "Given additive monoids `A`, `B`, the natural inclusion homomorphism\nfrom `A` to `A \u00d7 B`.", "p": "mathlib"}, {"name": "prod.monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coprod_comp_inl", "description": "", "p": "mathlib"}, {"name": "prod.swap_div", "description": "", "p": "mathlib"}, {"name": "add_hom.prod_unique", "description": "", "p": "mathlib"}, {"name": "monoid_hom.coprod", "description": " Coproduct of two `monoid_hom`s with the same codomain:\n`f.coprod g (p : M \u00d7 N) = f p.1 * g p.2`.", "p": "mathlib"}, {"name": "prod.sub_neg_monoid", "description": "", "p": "mathlib"}, {"name": "prod.mk_eq_zero", "description": "", "p": "mathlib"}, {"name": "prod.right_cancel_semigroup", "description": "", "p": "mathlib"}, {"name": "prod.comm_group", "description": "", "p": "mathlib"}, {"name": "prod.fst_zero", "description": "", "p": "mathlib"}, {"name": "prod.swap_neg", "description": "", "p": "mathlib"}, {"name": "sub_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "prod.snd_one", "description": "", "p": "mathlib"}, {"name": "prod.subtraction_monoid", "description": "", "p": "mathlib"}, {"name": "prod.snd_zero", "description": "", "p": "mathlib"}, {"name": "add_hom.coprod_apply", "description": "", "p": "mathlib"}, {"name": "mul_hom.coprod_apply", "description": "", "p": "mathlib"}, {"name": "prod.has_involutive_neg", "description": "", "p": "mathlib"}, {"name": "prod.swap_sub", "description": "", "p": "mathlib"}, {"name": "add_equiv.prod_unique", "description": "Multiplying by the trivial monoid doesn't change the structure.", "p": "mathlib"}, {"name": "mul_hom.prod_map_def", "description": "", "p": "mathlib"}, {"name": "mul_mul_hom_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coprod_inl_inr", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coprod", "description": "Coproduct of two `add_monoid_hom`s with the same codomain:\n`f.coprod g (p : M \u00d7 N) = f p.1 + g p.2`.", "p": "mathlib"}, {"name": "mul_equiv.coe_prod_comm", "description": "", "p": "mathlib"}, {"name": "prod.comm_monoid", "description": "", "p": "mathlib"}, {"name": "mul_hom.prod_unique", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coe_prod_map", "description": "", "p": "mathlib"}, {"name": "monoid_hom.inl_apply", "description": "", "p": "mathlib"}, {"name": "prod.swap_zero", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.comp_coprod", "description": "", "p": "mathlib"}, {"name": "prod.add_comm_semigroup", "description": "", "p": "mathlib"}, {"name": "prod.swap_one", "description": "", "p": "mathlib"}, {"name": "monoid_hom.snd_comp_inl", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.inr", "description": "Given additive monoids `A`, `B`, the natural inclusion homomorphism\nfrom `B` to `A \u00d7 B`.", "p": "mathlib"}, {"name": "mul_equiv.prod_prod_prod_comm", "description": "Four-way commutativity of `prod`. The name matches `mul_mul_mul_comm`.", "p": "mathlib"}, {"name": "prod.snd_sub", "description": "", "p": "mathlib"}, {"name": "prod.fst_add", "description": "", "p": "mathlib"}, {"name": "add_hom.prod", "description": "Combine two `add_monoid_hom`s `f : add_hom M N`, `g : add_hom M P` into\n`f.prod g : add_hom M (N \u00d7 P)` given by `(f.prod g) x = (f x, g x)`", "p": "mathlib"}, {"name": "prod.mk_zero_add_mk_zero", "description": "", "p": "mathlib"}, {"name": "mul_equiv.prod_comm", "description": " The equivalence between `M \u00d7 N` and `N \u00d7 M` given by swapping the components\nis multiplicative.", "p": "mathlib"}, {"name": "prod.cancel_monoid", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.fst", "description": "Given additive monoids `A`, `B`, the natural projection homomorphism\nfrom `A \u00d7 B` to `A`", "p": "mathlib"}, {"name": "prod.mk_eq_one", "description": "", "p": "mathlib"}, {"name": "monoid_hom.prod_map", "description": "`prod.map` as a `monoid_hom`.", "p": "mathlib"}, {"name": "monoid_hom.snd_comp_inr", "description": "", "p": "mathlib"}, {"name": "div_monoid_hom", "description": "Division as a monoid homomorphism.", "p": "mathlib"}, {"name": "monoid_hom.coprod_inl_inr", "description": "", "p": "mathlib"}, {"name": "prod.snd_inv", "description": "", "p": "mathlib"}, {"name": "monoid_hom.prod_unique", "description": "", "p": "mathlib"}, {"name": "monoid_hom.coprod_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coprod_apply", "description": "", "p": "mathlib"}, {"name": "add_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.unique_prod", "description": "Multiplying by the trivial monoid doesn't change the structure.", "p": "mathlib"}, {"name": "prod.has_sub", "description": "", "p": "mathlib"}, {"name": "prod.left_cancel_add_monoid", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.inl_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.inr", "description": "Given monoids `M`, `N`, the natural inclusion homomorphism from `N` to `M \u00d7 N`.", "p": "mathlib"}, {"name": "add_add_hom_apply", "description": "", "p": "mathlib"}, {"name": "prod.swap_add", "description": "", "p": "mathlib"}, {"name": "prod.swap_inv", "description": "", "p": "mathlib"}, {"name": "mul_hom.fst", "description": "Given magmas `M`, `N`, the natural projection homomorphism from `M \u00d7 N` to `M`.", "p": "mathlib"}, {"name": "mul_hom.coe_prod", "description": "", "p": "mathlib"}, {"name": "monoid_hom.coprod_comp_inl", "description": "", "p": "mathlib"}, {"name": "prod.right_cancel_monoid", "description": "", "p": "mathlib"}, {"name": "mul_mul_hom", "description": "Multiplication as a multiplicative homomorphism.", "p": "mathlib"}, {"name": "add_units.embed_product_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.snd", "description": "Given additive monoids `A`, `B`, the natural projection homomorphism\nfrom `A \u00d7 B` to `B`", "p": "mathlib"}, {"name": "mul_equiv.prod_prod_prod_comm_symm", "description": "", "p": "mathlib"}, {"name": "prod.snd_neg", "description": "", "p": "mathlib"}, {"name": "monoid_hom.coe_prod", "description": "", "p": "mathlib"}, {"name": "prod.fst_one", "description": "", "p": "mathlib"}, {"name": "prod.mk_div_mk", "description": "", "p": "mathlib"}, {"name": "prod.has_inv", "description": "", "p": "mathlib"}, {"name": "mul_hom.fst_comp_prod", "description": "", "p": "mathlib"}, {"name": "mul_monoid_hom", "description": "Multiplication as a monoid homomorphism.", "p": "mathlib"}, {"name": "prod.has_add", "description": "", "p": "mathlib"}, {"name": "mul_hom.prod_apply", "description": "", "p": "mathlib"}, {"name": "prod.division_comm_monoid", "description": "", "p": "mathlib"}, {"name": "prod.mul_def", "description": "", "p": "mathlib"}, {"name": "mul_hom.snd_comp_prod", "description": "", "p": "mathlib"}, {"name": "monoid_hom.snd_comp_prod", "description": "", "p": "mathlib"}, {"name": "prod.comm_semigroup", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.inr_apply", "description": "", "p": "mathlib"}, {"name": "div_monoid_with_zero_hom_apply", "description": "", "p": "mathlib"}, {"name": "mul_hom.comp_coprod", "description": "", "p": "mathlib"}, {"name": "monoid_hom.prod_map_def", "description": "", "p": "mathlib"}, {"name": "prod.comm_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "add_hom.coprod", "description": "Coproduct of two `add_hom`s with the same codomain:\n`f.coprod g (p : M \u00d7 N) = f p.1 + g p.2`.", "p": "mathlib"}, {"name": "monoid_hom.prod", "description": " Combine two `monoid_hom`s `f : M \u2192* N`, `g : M \u2192* P` into `f.prod g : M \u2192* N \u00d7 P`\ngiven by `(f.prod g) x = (f x, g x)`.", "p": "mathlib"}, {"name": "prod.group", "description": "", "p": "mathlib"}, {"name": "monoid_hom.comp_coprod", "description": "", "p": "mathlib"}, {"name": "prod.mk_one_mul_mk_one", "description": "", "p": "mathlib"}, {"name": "mul_equiv.prod_unique", "description": "Multiplying by the trivial monoid doesn't change the structure.", "p": "mathlib"}, {"name": "add_hom.coe_fst", "description": "", "p": "mathlib"}, {"name": "prod.add_def", "description": "", "p": "mathlib"}, {"name": "add_add_hom", "description": "Addition as an additive homomorphism.", "p": "mathlib"}, {"name": "prod.fst_inv", "description": "", "p": "mathlib"}, {"name": "units.embed_product_injective", "description": "", "p": "mathlib"}, {"name": "mul_hom.snd", "description": "Given magmas `M`, `N`, the natural projection homomorphism from `M \u00d7 N` to `N`.", "p": "mathlib"}, {"name": "monoid_hom.prod_comp_prod_map", "description": "", "p": "mathlib"}, {"name": "prod.mul_zero_one_class", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coprod_comp_inr", "description": "", "p": "mathlib"}, {"name": "add_hom.fst", "description": "Given additive magmas `A`, `B`, the natural projection homomorphism\nfrom `A \u00d7 B` to `A`", "p": "mathlib"}, {"name": "add_hom.fst_comp_prod", "description": "", "p": "mathlib"}, {"name": "monoid_hom.fst_comp_prod", "description": "", "p": "mathlib"}, {"name": "add_hom.coe_snd", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.prod_unique", "description": "", "p": "mathlib"}, {"name": "add_equiv.prod_comm", "description": "The equivalence between `M \u00d7 N` and `N \u00d7 M` given by swapping the\ncomponents is additive.", "p": "mathlib"}, {"name": "prod.fst_sub", "description": "", "p": "mathlib"}, {"name": "prod.left_cancel_semigroup", "description": "", "p": "mathlib"}, {"name": "prod.mk_mul_mk", "description": "", "p": "mathlib"}, {"name": "add_hom.comp_coprod", "description": "", "p": "mathlib"}, {"name": "mul_monoid_with_zero_hom_apply", "description": "", "p": "mathlib"}, {"name": "prod.fst_add_snd", "description": "", "p": "mathlib"}, {"name": "tactic.unsafe.type_context.get_env", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.level.instantiate_mvars", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.kabstract", "description": "Abstracts all occurrences of the term `t` in `e` using keyed matching.\n   If `unify` is `ff`, then matching is used instead of unification.\n   That is, metavariables occurring in `e` are not assigned.", "p": "core"}, {"name": "tactic.unsafe.type_context.bind", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.get_fun_info", "description": "Same as tactic.get_fun_info", "p": "core"}, {"name": "tactic.unsafe.type_context.whnf", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.list_mvars", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.fold_mvars", "description": "Iterate over all mvars in the mvar context.", "p": "core"}, {"name": "tactic.unsafe.type_context.run", "description": " Runs the given type_context monad using the type context of the current tactic state.\nYou can use this to perform unsafe operations such as direct metavariable assignment and the use of temporary metavariables.", "p": "core"}, {"name": "tactic.unsafe.type_context.level.tmp_get_assignment", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.monad_fail", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.mk_mvar", "description": "Create and declare a new metavariable. If the local context is not given then it will use the current local context.", "p": "core"}, {"name": "tactic.unsafe.type_context.assign", "description": " Set the mvar to the following assignments.\nWorks for temporary metas too.\n[WARNING] `assign` does not perform certain checks:\n- No typecheck is done before assignment.\n- If the metavariable is already assigned this will clobber the assignment.\n- It will not stop you from assigning an metavariable to itself or creating cycles of metavariable assignments.\n  These will manifest as 'deep recursion' exceptions when `instantiate_mvars` is used.\n- It is not checked whether the assignment uses local constants outside the declaration's context.\n\nYou can avoid the unsafety by using `unify` instead.", "p": "core"}, {"name": "tactic.unsafe.type_context.level.mk_tmp_mvar", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.tmp_mode", "description": " Run the given `type_context` monad in a temporary mvar scope.\nDoing this twice will push the old tmp_mvar assignments to a stack.\nSo it is safe to do this whether or not you are already in tmp mode.", "p": "core"}, {"name": "tactic.unsafe.type_context.get_assignment", "description": "Get the expression that is assigned to the given mvar expression. Fails if given a", "p": "core"}, {"name": "tactic.unsafe.type_context.is_stuck", "description": " A stuck expression `e` is an expression that _would_ reduce,\nexcept that a metavariable is present that prevents the reduction.\nReturns the metavariable which is causing the stuckage.\nFor example, `@has_add.add nat ?m a b` can't project because `?m` is not given.", "p": "core"}, {"name": "tactic.unsafe.type_context.is_declared", "description": "Returns true if the given expression is a declared local constant or a declared metavariable.", "p": "core"}, {"name": "tactic.unsafe.type_context.monad", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.print_mvars", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.unify", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.is_regular_mvar", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context", "description": " A monad that exposes the functionality of the C++ class `type_context_old`.\nThe idea is that the methods to `type_context` are more powerful but _unsafe_ in the\nsense that you can create terms that do not typecheck or that are infinitely descending.\nUnder the hood, `type_context` is implemented as a reader monad, with a mutable `type_context` object.", "p": "core"}, {"name": "tactic.unsafe.type_context.infer", "description": " Infer the type of the given expr. Inferring the type does not mean that it typechecks.\nWill fail if type can't be inferred.", "p": "core"}, {"name": "tactic.unsafe.type_context.to_tmp_mvars", "description": "Replace each metavariable in the given expression with a temporary metavariable.", "p": "core"}, {"name": "tactic.unsafe.type_context.is_tmp_mvar", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.in_tmp_mode", "description": "Returns true when in temp mode.", "p": "core"}, {"name": "tactic.unsafe.type_context.is_assigned", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.instantiate_mvars", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.orelse", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.get_context", "description": "Given a metavariable, returns the local context that the metavariable was declared with.", "p": "core"}, {"name": "tactic.unsafe.type_context.trace", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.try", "description": " Run the provided type_context within a backtracking scope.\nThis means that any changes to the metavariable context will not be committed if the inner monad fails.\n[warning]: the local context modified by `push_local` and `pop_local` is not affected by `try`.\nAny unpopped locals will be present after the `try` even if the inner `type_context` failed.", "p": "core"}, {"name": "tactic.unsafe.type_context.level.assign", "description": "Assigns a given level metavariable.", "p": "core"}, {"name": "tactic.unsafe.type_context.tmp_get_assignment", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.is_def_eq", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.tmp_is_assigned", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.failure", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.kdepends_on", "description": "Return tt iff `t` \"occurs\" in `e`. The occurrence checking is performed using\n   keyed matching with the given transparency setting.\n\n   We say `t` occurs in `e` by keyed matching iff there is a subterm `s`\n   s.t. `t` and `s` have the same head, and `is_def_eq t s md`\n\n   The main idea is to minimize the number of `is_def_eq` checks\n   performed.", "p": "core"}, {"name": "tactic.unsafe.type_context.fail", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.level.tmp_is_assigned", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.pop_local", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.get_local_context", "description": "Get the local context of the type_context.", "p": "core"}, {"name": "tactic.unsafe.type_context.mk_tmp_mvar", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.push_local", "description": "Add a local to the tc local context.", "p": "core"}, {"name": "tactic.unsafe.type_context.pure", "description": "", "p": "core"}, {"name": "tactic.unsafe.type_context.type_context_alternative", "description": "", "p": "core"}, {"name": "category_theory.bicone_hom.decidable_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_category_struct_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_category_struct", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_category", "description": "", "p": "mathlib"}, {"name": "category_theory.fin_bicone", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_mk_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_mk_map", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_fin_category", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_small_category", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_hom.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone.decidable_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_category_struct_to_quiver_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_hom", "description": "The homs for a walking `bicone J`.", "p": "mathlib"}, {"name": "category_theory.bicone_hom.left_id", "description": "The homs for a walking `bicone J`.", "p": "mathlib"}, {"name": "category_theory.bicone_hom.right_id", "description": "The homs for a walking `bicone J`.", "p": "mathlib"}, {"name": "category_theory.bicone_hom.left", "description": "The homs for a walking `bicone J`.", "p": "mathlib"}, {"name": "category_theory.bicone_hom.right", "description": "The homs for a walking `bicone J`.", "p": "mathlib"}, {"name": "category_theory.bicone_hom.diagram", "description": "The homs for a walking `bicone J`.", "p": "mathlib"}, {"name": "category_theory.bicone_category_struct_id", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone", "description": "Given a category `J`, construct a walking `bicone J` by adjoining two elements.", "p": "mathlib"}, {"name": "category_theory.bicone.left", "description": "Given a category `J`, construct a walking `bicone J` by adjoining two elements.", "p": "mathlib"}, {"name": "category_theory.bicone.right", "description": "Given a category `J`, construct a walking `bicone J` by adjoining two elements.", "p": "mathlib"}, {"name": "category_theory.bicone.diagram", "description": "Given a category `J`, construct a walking `bicone J` by adjoining two elements.", "p": "mathlib"}, {"name": "category_theory.fin_bicone_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.bicone_mk", "description": "Given a diagram `F : J \u2964 C` and two `cone F`s, we can join them into a diagram `bicone J \u2964 C`.", "p": "mathlib"}, {"name": "algebraic_geometry.generic_point_eq_of_is_open_immersion", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.germ_injective_of_is_integral", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.is_affine_open.prime_ideal_of_generic_point", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.Scheme.germ_to_function_field_injective", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.stalk_function_field_algebra", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.function_field_is_fraction_ring_of_affine", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.Scheme.function_field.field", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.Scheme.function_field.algebra", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.Scheme.restrict.is_integral", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.function_field_is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.Scheme.germ_to_function_field", "description": "The restriction map from a component to the function field.", "p": "mathlib"}, {"name": "algebraic_geometry.function_field_is_fraction_ring_of_is_affine_open", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.Scheme.function_field", "description": " The function field of an irreducible scheme is the local ring at its generic point.\nDespite the name, this is a field only when the scheme is integral.", "p": "mathlib"}, {"name": "algebraic_geometry.obj.is_affine", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.generic_point_eq_bot_of_affine", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.Scheme.function_field.is_fraction_ring", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.function_field.algebra", "description": "", "p": "mathlib"}, {"name": "affine_map.add_torsor", "description": " The space of affine maps from `P1` to `P2` is an affine space over the space of affine maps\nfrom `P1` to the vector space `V2` corresponding to `P2`.", "p": "mathlib"}, {"name": "affine_map.line_map_eq_right_iff", "description": "", "p": "mathlib"}, {"name": "affine_map.coe_line_map", "description": "", "p": "mathlib"}, {"name": "affine_map.nonempty", "description": "", "p": "mathlib"}, {"name": "affine_map.line_map_apply_one", "description": "", "p": "mathlib"}, {"name": "affine_map.snd", "description": "`prod.snd` as an `affine_map`.", "p": "mathli