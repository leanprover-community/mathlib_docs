 "mathlib"}, {"name": "add_units.eq_neg_of_add_eq_zero_right", "description": "", "p": "mathlib"}, {"name": "add_units.simps.coe_neg", "description": "See Note [custom simps projection]", "p": "mathlib"}, {"name": "eq_one_of_mul_left", "description": "", "p": "mathlib"}, {"name": "is_add_unit_zero", "description": "", "p": "mathlib"}, {"name": "add_units.neg_add_eq_iff_eq_add", "description": "", "p": "mathlib"}, {"name": "units.is_unit_units_mul", "description": "Multiplication by a `u : M\u02e3` on the left doesn't affect `is_unit`.", "p": "mathlib"}, {"name": "add_units.has_repr", "description": "", "p": "mathlib"}, {"name": "add_units.neg_add_cancel_right", "description": "", "p": "mathlib"}, {"name": "units.coe_inv_copy", "description": "", "p": "mathlib"}, {"name": "is_add_unit_iff_exists_neg", "description": "", "p": "mathlib"}, {"name": "units.eq_inv_of_mul_eq_one_right", "description": "", "p": "mathlib"}, {"name": "add_units.coe_neg", "description": "", "p": "mathlib"}, {"name": "add_units.add_neg_of_eq", "description": "", "p": "mathlib"}, {"name": "divp_eq_iff_mul_eq", "description": "", "p": "mathlib"}, {"name": "divp_mul_cancel", "description": "", "p": "mathlib"}, {"name": "add_units.add_neg", "description": "", "p": "mathlib"}, {"name": "units.coe_one", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add", "description": "", "p": "mathlib"}, {"name": "add_units.neg_mk", "description": "", "p": "mathlib"}, {"name": "units.inv_mul_eq_iff_eq_mul", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_unit", "description": "The element of the additive group of additive units, corresponding to an element of\nan additive monoid which is an additive unit. When `\u03b1` is a `subtraction_monoid`, use\n`is_add_unit.add_unit'` instead.", "p": "mathlib"}, {"name": "units.copy_eq", "description": "", "p": "mathlib"}, {"name": "add_units.neg_add_of_eq", "description": "", "p": "mathlib"}, {"name": "is_add_unit.coe_neg_add", "description": "", "p": "mathlib"}, {"name": "units.val_eq_coe", "description": "", "p": "mathlib"}, {"name": "units.mk_coe", "description": "", "p": "mathlib"}, {"name": "add_units.add_neg_cancel_right", "description": "", "p": "mathlib"}, {"name": "inv_eq_one_divp'", "description": "Used for `field_simp` to deal with inverses of units. This form of the lemma\nis essential since `field_simp` likes to use `inv_eq_one_div` to rewrite\n`\u2191u\u207b\u00b9 = \u2191(1 / u)`.", "p": "mathlib"}, {"name": "is_add_unit.add_unit_of_coe_add_units", "description": "", "p": "mathlib"}, {"name": "add_units.add_right_inj", "description": "", "p": "mathlib"}, {"name": "is_add_unit_of_add_is_add_unit_right", "description": "", "p": "mathlib"}, {"name": "is_unit.coe_inv_mul", "description": "", "p": "mathlib"}, {"name": "is_unit.exists_right_inv", "description": "", "p": "mathlib"}, {"name": "units.comm_group", "description": "", "p": "mathlib"}, {"name": "is_unit_iff_exists_inv'", "description": "", "p": "mathlib"}, {"name": "add_units.is_add_unit_add_add_units", "description": "Addition of a `u : add_units M` on the right doesn't\naffect `is_add_unit`.", "p": "mathlib"}, {"name": "is_unit.mul_left_inj", "description": "", "p": "mathlib"}, {"name": "add_units", "description": " Units of an `add_monoid`, bundled version.\n\nAn element of an `add_monoid` is a unit if it has a two-sided additive inverse.\nThis version bundles the inverse element so that it can be computed.\nFor a predicate see `is_add_unit`.", "p": "mathlib"}, {"name": "add_units.val", "description": " Units of an `add_monoid`, bundled version.\n\nAn element of an `add_monoid` is a unit if it has a two-sided additive inverse.\nThis version bundles the inverse element so that it can be computed.\nFor a predicate see `is_add_unit`.", "p": "mathlib"}, {"name": "add_units.neg", "description": " Units of an `add_monoid`, bundled version.\n\nAn element of an `add_monoid` is a unit if it has a two-sided additive inverse.\nThis version bundles the inverse element so that it can be computed.\nFor a predicate see `is_add_unit`.", "p": "mathlib"}, {"name": "add_units.val_neg", "description": " Units of an `add_monoid`, bundled version.\n\nAn element of an `add_monoid` is a unit if it has a two-sided additive inverse.\nThis version bundles the inverse element so that it can be computed.\nFor a predicate see `is_add_unit`.", "p": "mathlib"}, {"name": "add_units.neg_val", "description": " Units of an `add_monoid`, bundled version.\n\nAn element of an `add_monoid` is a unit if it has a two-sided additive inverse.\nThis version bundles the inverse element so that it can be computed.\nFor a predicate see `is_add_unit`.", "p": "mathlib"}, {"name": "add_units.coe_neg_copy", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_right_cancel", "description": "", "p": "mathlib"}, {"name": "units.inv_mul_of_eq", "description": "", "p": "mathlib"}, {"name": "units.copy", "description": "Copy a unit, adjusting definition equalities.", "p": "mathlib"}, {"name": "units.eq_iff", "description": "", "p": "mathlib"}, {"name": "is_unit_of_mul_is_unit_left", "description": "", "p": "mathlib"}, {"name": "is_unit.mul", "description": "", "p": "mathlib"}, {"name": "mul_divp_cancel", "description": "", "p": "mathlib"}, {"name": "is_add_unit.neg_add_cancel", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_neg_cancel", "description": "", "p": "mathlib"}, {"name": "add_units.mk_of_add_eq_zero", "description": "For `a, b` in an `add_comm_monoid` such that `a + b = 0`, makes an add_unit\nout of `a`.", "p": "mathlib"}, {"name": "units.mul_inv_cancel_left", "description": "", "p": "mathlib"}, {"name": "units.inv_eq_coe_inv", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_inv_cancel", "description": "", "p": "mathlib"}, {"name": "units.ext_iff", "description": "", "p": "mathlib"}, {"name": "is_unit.unit", "description": " The element of the group of units, corresponding to an element of a monoid which is a unit. When\n`\u03b1` is a `division_monoid`, use `is_unit.unit'` instead.", "p": "mathlib"}, {"name": "is_add_unit.add_left_cancel", "description": "", "p": "mathlib"}, {"name": "add_units.coe_zero", "description": "", "p": "mathlib"}, {"name": "is_unit.mul_right_injective", "description": "", "p": "mathlib"}, {"name": "add_units.neg_eq_coe_neg", "description": "", "p": "mathlib"}, {"name": "units.inv_mk", "description": "", "p": "mathlib"}, {"name": "add_units.eq_iff", "description": "", "p": "mathlib"}, {"name": "units.mk_of_mul_eq_one", "description": "For `a, b` in a `comm_monoid` such that `a * b = 1`, makes a unit out of `a`.", "p": "mathlib"}, {"name": "is_add_unit_of_add_eq_zero", "description": "", "p": "mathlib"}, {"name": "inv_eq_one_divp", "description": "Used for `field_simp` to deal with inverses of units.", "p": "mathlib"}, {"name": "add_units.is_add_unit_add_unit", "description": "", "p": "mathlib"}, {"name": "is_add_unit.add_left_injective", "description": "", "p": "mathlib"}, {"name": "is_add_unit", "description": "An element `a : M` of an add_monoid is an `add_unit` if it has\na two-sided additive inverse. The actual definition says that `a` is equal to some\n`u : add_units M`, where `add_units M` is a bundled version of `is_add_unit`.", "p": "mathlib"}, {"name": "coe_div_eq_divp", "description": "`field_simp` moves division inside `\u03b1\u02e3` to the right, and this lemma\nlifts the calculation to `\u03b1`.", "p": "mathlib"}, {"name": "comm_group_of_is_unit", "description": "Constructs a `comm_group` structure on a `comm_monoid` consisting only of units.", "p": "mathlib"}, {"name": "add_units.add_group", "description": "Additive units of an additive monoid form an additive group.", "p": "mathlib"}, {"name": "add_units.neg_eq_of_add_eq_zero_left", "description": "", "p": "mathlib"}, {"name": "add_units.mk_coe", "description": "", "p": "mathlib"}, {"name": "is_unit.can_lift", "description": "", "p": "mathlib"}, {"name": "units.mul_inv_of_eq", "descripti