iption": "If `x` is an element of a subgroup `s` of a seminormed group `E`, its norm in\n`s` is equal to its norm in `E`.", "p": "mathlib"}, {"name": "dist_self_sub_right", "description": "", "p": "mathlib"}, {"name": "tendsto_norm'", "description": "", "p": "mathlib"}, {"name": "continuous.nnnorm'", "description": "", "p": "mathlib"}, {"name": "pi_norm_le_iff_of_nonneg'", "description": " The seminorm of an element in a product space is `\u2264 r` if and only if the norm of each\ncomponent is.", "p": "mathlib"}, {"name": "nnnorm_neg", "description": "", "p": "mathlib"}, {"name": "seminormed_add_group", "description": " A seminormed group is an additive group endowed with a norm for which `dist x y = \u2016x - y\u2016`\ndefines a pseudometric space structure.", "p": "mathlib"}, {"name": "seminormed_add_group.to_has_norm", "description": " A seminormed group is an additive group endowed with a norm for which `dist x y = \u2016x - y\u2016`\ndefines a pseudometric space structure.", "p": "mathlib"}, {"name": "seminormed_add_group.to_add_group", "description": " A seminormed group is an additive group endowed with a norm for which `dist x y = \u2016x - y\u2016`\ndefines a pseudometric space structure.", "p": "mathlib"}, {"name": "seminormed_add_group.to_pseudo_metric_space", "description": " A seminormed group is an additive group endowed with a norm for which `dist x y = \u2016x - y\u2016`\ndefines a pseudometric space structure.", "p": "mathlib"}, {"name": "seminormed_add_group.dist_eq", "description": " A seminormed group is an additive group endowed with a norm for which `dist x y = \u2016x - y\u2016`\ndefines a pseudometric space structure.", "p": "mathlib"}, {"name": "rat.norm_cast_real", "description": "", "p": "mathlib"}, {"name": "abs_norm_sub_norm_le'", "description": "", "p": "mathlib"}, {"name": "nnnorm_prod_le", "description": "", "p": "mathlib"}, {"name": "lipschitz_with_iff_norm_div_le", "description": "", "p": "mathlib"}, {"name": "real.ennnorm_eq_of_rea