.neg_pred", "description": "", "p": "mathlib"}, {"name": "int.mod_add_div", "description": "", "p": "mathlib"}, {"name": "int.zero_ne_neg_of_nat", "description": "", "p": "mathlib"}, {"name": "int.mod_zero", "description": "", "p": "mathlib"}, {"name": "int.pred_nat_succ", "description": "", "p": "mathlib"}, {"name": "int.ring", "description": "", "p": "mathlib"}, {"name": "int.distrib", "description": "", "p": "mathlib"}, {"name": "int.of_nat_mod", "description": "", "p": "mathlib"}, {"name": "int.semiring", "description": "", "p": "mathlib"}, {"name": "int.comm_monoid", "description": "", "p": "mathlib"}, {"name": "int.monoid", "description": "", "p": "mathlib"}, {"name": "int.zero_div", "description": "", "p": "mathlib"}, {"name": "int.add_neg_one", "description": "", "p": "mathlib"}, {"name": "int.nat_succ_eq_int_succ", "description": "", "p": "mathlib"}, {"name": "int.to_nat_zero", "description": "", "p": "mathlib"}, {"name": "int.coe_nat_mul_neg_succ", "description": "", "p": "mathlib"}, {"name": "int.to_nat_add_nat", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_neg_of_nat", "description": "", "p": "mathlib"}, {"name": "int.mul_div_mul_of_pos_left", "description": "", "p": "mathlib"}, {"name": "int.to_nat_one", "description": "", "p": "mathlib"}, {"name": "int.div_eq_zero_of_lt", "description": "", "p": "mathlib"}, {"name": "int.neg_succ_mul_neg_succ", "description": "", "p": "mathlib"}, {"name": "int.coe_pred_of_pos", "description": "", "p": "mathlib"}, {"name": "int.comm_semigroup", "description": "", "p": "mathlib"}, {"name": "int.mod_one", "description": "", "p": "mathlib"}, {"name": "int.to_nat_add", "description": "", "p": "mathlib"}, {"name": "int.mod_def", "description": "", "p": "mathlib"}, {"name": "int.induction_on", "description": "", "p": "mathlib"}, {"name": "int.mul_sign", "description": "", "p": "mathlib"}, {"name": "subadditive.eventually_div_lt_of_div_lt", "description": "", "p": "mathlib"}, {"name": "subadditive", "description": " A real-valued sequence is subadditive if it satisfies the inequality `u (m + n) \u2264 u m + u n`\nfor all `m, n`.", "p": "mathlib"}, {"name": "subadditive.lim", "description": " The limit of a bounded-below subadditive sequence. The fact that the sequence indeed tends to\nthis limit is given in `subadditive.tendsto_lim`", "p": "mathlib"}, {"name": "subadditive.lim_le_div", "description": "", "p": "mathlib"}, {"name": "subadditive.tendsto_lim", "description": "Fekete's lemma: a subadditive sequence which is bounded below converges.", "p": "mathlib"}, {"name": "subadditive.apply_mul_add_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_test_against_nn_of_le_const", "description": " A bounded convergence theorem for a finite measure:\nIf a sequence of bounded continuous non-negative functions are uniformly bounded by a constant and\ntend pointwise to a limit, then their integrals (`measure_theory.finite_measure.test_against_nn`)\nagainst the finite measure tend to the integral of the limit.\n\nRelated results:\n * `measure_theory.finite_measure.tendsto_test_against_nn_filter_of_le_const`:\n   more general assumptions\n * `measure_theory.finite_measure.tendsto_lintegral_nn_of_le_const`:\n   using `measure_theory.lintegral` for integration.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.module", "description": "", "p": "mathlib"}, {"name": "bounded_continuous_function.nnreal.to_real_lintegral_eq_integral", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.eq_of_forall_apply_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.has_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.zero.mass", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.smul_test_against_nn_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.integrable_of_bounded_continuous_to_nnreal", "description": "", "p": "mathlib"}, {"name": "bounded_continuous_function.integral_eq_integral_nnreal_part_sub", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_to_weak_dual_bcnn", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_iff_weak_star_tendsto", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.zero.test_against_nn", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_fn_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_of_forall_integral_tendsto", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.zero.test_against_nn_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_iff_forall_test_against_nn_tendsto", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_fn_smul_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.restrict_mass", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_lt_top_of_bounded_continuous_to_nnreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.ennreal_mass", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.integrable_of_bounded_continuous_to_real", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.lintegral_lt_top_of_bounded_continuous_to_real", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.has_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_fn_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.mass_zero_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn_one", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.to_weak_dual_bcnn", "description": " Finite measures yield elements of the `weak_dual` of bounded continuous nonnegative\nfunctions via `measure_theory.finite_measure.test_against_nn`, i.e., integration.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.inhabited", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_lintegral_nn_filter_of_le_const", "description": " A bounded convergence theorem for a finite measure:\nIf bounded continuous non-negative functions are uniformly bounded by a constant and tend to a\nlimit, then their integrals against the finite measure tend to the integral of the limit.\nThis formulation assumes:\n * the functions tend to a limit along a countably generated filter;\n * the limit is in the almost everywhere sense;\n * boundedness holds almost everywhere;\n * integration is `measure_theory.lintegral`, i.e., the functions and their integrals are\n   `\u211d\u22650\u221e`-valued.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_zero_of_tendsto_zero_mass", "description": "If the total masses of finite measures tend to zero, then the measures tend to zero.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn_coe_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_add_monoid_hom", "description": "Coercion is an `add_monoid_hom`.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.restrict", "description": "Restrict a finite measure \u03bc to a set A.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.restrict_measure_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.restrict_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_iff_forall_integral_tendsto", "description": " A characterization of weak convergence in terms of integrals of bounded continuous\nreal-valued functions.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_iff_forall_lintegral_tendsto", "description": " A characterization of weak convergence in terms of integrals of bounded continuous\nnonnegative functions.", "p": "mathlib"}, {"name": "measure_theory.finite_measure", "description": " Finite measures are defined as the subtype of measures that have the property of being finite\nmeasures (i.e., their total mass is finite).", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn_lipschitz_estimate", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.is_finite_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_injective", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.eq_of_forall_measure_apply_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_test_against_nn_filter_of_le_const", "description": " A bounded convergence theorem for a finite measure:\nIf bounded continuous non-negative functions are uniformly bounded by a constant and tend to a\nlimit, then their integrals against the finite measure tend to the integral of the limit.\nThis formulation assumes:\n * the functions tend to a limit along a countably generated filter;\n * the limit is in the almost everywhere sense;\n * boundedness holds almost everywhere;\n * integration is the pairing against non-negative continuous test functions\n   (`measure_theory.finite_measure.test_against_nn`).\n\nA related result using `measure_theory.lintegral` for integration is\n`measure_theory.finite_measure.tendsto_lintegral_nn_filter_of_le_const`.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.restrict_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.measure_theory.measure.has_coe", "description": "A finite measure can be interpreted as a measure.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.val_eq_to_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.continuous_mass", "description": "The total mass of a finite measure depends continuously on the measure.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.ennreal_coe_fn_eq_coe_fn_to_measure", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.mass", "description": "Convergence of finite measures implies the convergence of their total masses.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.has_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.mass_nonzero_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.topological_space", "description": " The topology of weak convergence on `measure_theory.finite_measure \u03a9` is inherited (induced)\nfrom the weak-* topology on `weak_dual \u211d\u22650 (\u03a9 \u2192\u1d47 \u211d\u22650)` via the function\n`measure_theory.finite_measure.to_weak_dual_bcnn`.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.apply_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_fn_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn_lipschitz", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.restrict_apply_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.mass", "description": " The (total) mass of a finite measure `\u03bc` is `\u03bc univ`, i.e., the cast to `nnreal` of\n`(\u03bc : measure \u03a9) univ`.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.continuous_test_against_nn_eval", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.coe_fn_eq_to_nnreal_coe_fn_to_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.to_weak_dual_bcnn_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_lintegral_nn_of_le_const", "description": " A bounded convergence theorem for a finite measure:\nIf a sequence of bounded continuous non-negative functions are uniformly bounded by a constant\nand tend pointwise to a limit, then their integrals (`measure_theory.lintegral`) against the finite\nmeasure tend to the integral of the limit.\n\nA related result with more general assumptions is\n`measure_theory.finite_measure.tendsto_lintegral_nn_filter_of_le_const`.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.restrict_nonzero_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_iff_forall_to_weak_dual_bcnn_tendsto", "description": "", "p": "mathlib"}, {"name": "bounded_continuous_function.nnreal.to_ennreal_comp_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.tendsto_zero_test_against_nn_of_tendsto_zero_mass", "description": " If the total masses of finite measures tend to zero, then the measures tend to\nzero. This formulation concerns the associated functionals on bounded continuous\nnonnegative test functions. See `finite_measure.tendsto_zero_of_tendsto_zero_mass` for\na formulation stating the weak convergence of measures.", "p": "mathlib"}, {"name": "measure_theory.finite_measure.to_weak_dual_bcnn_continuous", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn_const", "description": "", "p": "mathlib"}, {"name": "measure_theory.finite_measure.test_against_nn", "description": " The pairing of a finite (Borel) measure `\u03bc` with a nonnegative bounded continuous\nfunction is obtained by (Lebesgue) integrating the (test) function against the measure.\nThis is `finite_measure.test_against_nn`.", "p": "mathlib"}, {"name": "nat.pow_sub_lt_desc_factorial", "description": "", "p": "mathlib"}, {"name": "nat.mul_factorial_pred", "description": "", "p": "mathlib"}, {"name": "nat.factorial_mul_asc_factorial", "description": " `n.asc_factorial k = (n + k)! / n!` but without \u2115-division. See `nat.asc_factorial_eq_div` for\nthe version with \u2115-division.", "p": "mathlib"}, {"name": "nat.desc_factorial_zero", "description": "", "p": "mathlib"}, {"name": "nat.desc_factorial_one", "description": "", "p": "mathlib"}, {"name": "nat.factorial_mul_pow_sub_le_factorial", "description": "", "p": "mathlib"}, {"name": "nat.desc_factorial_self", "description": "", "p": "mathlib"}, {"name": "nat.pow_sub_lt_desc_factorial'", "description": "", "p": "mathlib"}, {"name": "nat.factorial_mul_desc_factorial", "description": " `n.desc_factorial k = n! / (n - k)!` but without \u2115-division. See `nat.desc_factorial_eq_div`\nfor the version using \u2115-division.", "p": "mathlib"}, {"name": "nat.asc_factorial", "description": " `n.asc_factorial k = (n + k)! / n!` (as seen in `nat.asc_factorial_eq_div`), but implemented\nrecursively to allow for \"quick\" computation when using `norm_num`. This is closely related to\n`pochhammer`, but much less general.", "p": "mathlib"}, {"name": "nat.factorial", "description": "`nat.factorial n` is the factorial of `n`.", "p": "mathlib"}, {"name": "nat.succ_desc_factorial", "description": "", "p": "mathlib"}, {"name": "nat.succ_desc_factorial_succ", "description": "", "p": "mathlib"}, {"name": "nat.dvd_factorial", "description": "", "p": "mathlib"}, {"name": "nat.factorial_zero", "description": "", "p": "mathlib"}, {"name": "nat.monotone_factorial", "description": "", "p": "mathlib"}, {"name": "nat.desc_factorial_of_lt", "description": "**Alias** of the reverse direction of `nat.desc_factorial_eq_zero_iff_lt`.", "p": "mathlib"}, {"name": "nat.desc_factorial_succ", "description": "", "p": "mathlib"}, {"name": "nat.asc_factorial_le_pow_add", "description": "", "p": "mathlib"}, {"name": "nat.pow_lt_asc_factorial", "description": "", "p": "mathlib"}, {"name": "nat.add_factorial_le_factorial_add", "description": "", "p": "mathlib"}, {"name": "nat.pow_succ_le_asc_factorial", "description": "", "p": "mathlib"}, {"name": "nat.desc_factorial_le_pow", "description": "", "p": "mathlib"}, {"name": "nat.factorial_two", "description": "", "p": "mathlib"}, {"name": "nat.self_le_factorial", "description": "", "p": "mathlib"}, {"name": "nat.add_desc_factorial_eq_asc_factorial", "description": "", "p": "mathlib"}, {"name": "nat.asc_factorial_zero", "description": "", "p": "mathlib"}, {"name": "nat.factorial_one", "description": "", "p": "mathlib"}, {"name": "nat.asc_factorial_pos", "description": "", "p": "mathlib"}, {"name": "nat.pow_sub_le_desc_factorial", "description": "", "p": "mathlib"}, {"name": "nat.asc_factorial_of_sub", "description": "", "p": "mathlib"}, {"name": "nat.desc_factorial_lt_pow", "description": "", "p": "mathlib"}, {"name": "nat.add_factorial_succ_le_factorial_add_succ", "description": "", "p": "mathlib"}, {"name": "nat.pow_lt_asc_factorial'", "description": "", "p": "mathlib"}, {"name": "nat.add_factorial_lt_factorial_add", "description": "", "p": "mathlib"}, {"name": "nat.lt_factorial_self", "description": "", "p": "mathlib"}, {"name": "nat.factorial_pos", "description": "", "p": "mathlib"}, {"name": "nat.factorial_succ", "description": "", "p": "mathlib"}, {"name": "nat.factorial_le", "description": "", "p": "mathlib"}, {"name": "nat.succ_asc_factorial", "description": "", "p": "mathlib"}, {"name": "nat.factorial_dvd_factorial", "description": "", "p": "mathlib"}, {"name": "nat.zero_asc_factorial", "description": "", "p": "mathlib"}, {"name": "nat.factorial_eq_one", "description": "", "p": "mathlib"}, {"name": "nat.desc_factorial_eq_div", "description": "Avoid in favor of `nat.factorial_mul_desc_factorial` if you can. \u2115-division isn't worth it.", "p": "mathlib"}, {"name": "nat.asc_factorial_succ", "description": "", "p": "mathlib"}, {"name": "nat.factorial_ne_zero", "description": "", "p": "mathlib"}, {"name": "nat.one_lt_factorial", "description": "", "p": "mathlib"}, {"name": "nat.desc_factorial", "description": " `n.desc_factorial k = n! / (n - k)!` (as seen in `nat.desc_factorial_eq_div`), but\nimplemented recursively to allow for \"quick\" computation when using `norm_num`. This is closely\nrelated to `pochhammer`, but much less general.", "p": "mathlib"}, {"name": "nat.asc_factorial_lt_pow_add", "description": "", "p": "mathlib"}, {"name": "nat.factorial_lt", "description": "", "p": "mathlib"}, {"name": "nat.factorial_inj", "description": "", "p": "mathlib"}, {"name": "nat.add_factorial_succ_lt_factorial_add_succ", "description": "", "p": "mathlib"}, {"name": "nat.zero_desc_factorial_succ", "description": "", "p": "mathlib"}, {"name": "nat.desc_factorial_eq_zero_iff_lt", "description": "", "p": "mathlib"}, {"name": "nat.asc_factorial_eq_div", "description": "Avoid in favor of `nat.factorial_mul_asc_factorial` if you can. \u2115-division isn't worth it.", "p": "mathlib"}, {"name": "nat.factorial_mul_pow_le_factorial", "description": "", "p": "mathlib"}, {"name": "cardinal.bsup_lt_ord_lift_of_is_regular", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular", "description": "A cardinal is regular if it is infinite and it equals its own cofinality.", "p": "mathlib"}, {"name": "cardinal.nfp_family_lt_ord_of_is_regular", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_lsub_le_lift", "description": "", "p": "mathlib"}, {"name": "cardinal.nfp_lt_ord_of_is_regular", "description": "", "p": "mathlib"}, {"name": "ordinal.infinite_pigeonhole_card", "description": "Pigeonhole principle for a cardinality below the cardinality of the domain", "p": "mathlib"}, {"name": "ordinal.cof_cof", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_omega", "description": "", "p": "mathlib"}, {"name": "ordinal.exists_lsub_cof", "description": "", "p": "mathlib"}, {"name": "ordinal.le_cof_iff_blsub", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.lsub_lt_ord", "description": "", "p": "mathlib"}, {"name": "ordinal.unbounded_of_unbounded_Union", "description": "If the union of s is unbounded and s is smaller than the cofinality,\n then s has an unbounded member", "p": "mathlib"}, {"name": "ordinal.aleph'_cof", "description": "", "p": "mathlib"}, {"name": "cardinal.is_strong_limit.two_power_lt", "description": "", "p": "mathlib"}, {"name": "ordinal.le_cof_iff_lsub", "description": "", "p": "mathlib"}, {"name": "ordinal.is_normal.is_fundamental_sequence", "description": "", "p": "mathlib"}, {"name": "cardinal.bsup_lt_ord_of_is_regular", "description": "", "p": "mathlib"}, {"name": "cardinal.nfp_bfamily_lt_ord_lift_of_is_regular", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_add", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_bounded_subset", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular.ord_pos", "description": "", "p": "mathlib"}, {"name": "cardinal.is_strong_limit.ne_zero", "description": "", "p": "mathlib"}, {"name": "rel_iso.cof_le", "description": "", "p": "mathlib"}, {"name": "ordinal.nfp_family_lt_ord_lift", "description": "", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence.ord_cof", "description": "", "p": "mathlib"}, {"name": "ordinal.blsub_lt_ord", "description": "", "p": "mathlib"}, {"name": "ordinal.le_cof_type", "description": "", "p": "mathlib"}, {"name": "cardinal.supr_lt_lift_of_is_regular", "description": "", "p": "mathlib"}, {"name": "rel_iso.cof_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_eq_one_iff_is_succ", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_eq_zero", "description": "", "p": "mathlib"}, {"name": "ordinal.is_normal.cof_le", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular_succ", "description": "", "p": "mathlib"}, {"name": "order.cof_le", "description": "", "p": "mathlib"}, {"name": "cardinal.is_inaccessible", "description": "A cardinal is inaccessible if it is an uncountable regular strong limit cardinal.", "p": "mathlib"}, {"name": "ordinal.exists_fundamental_sequence", "description": "Every ordinal has a fundamental sequence.", "p": "mathlib"}, {"name": "ordinal.supr_lt", "description": "", "p": "mathlib"}, {"name": "ordinal.lt_cof_type", "description": "", "p": "mathlib"}, {"name": "ordinal.blsub_lt_ord_lift", "description": "", "p": "mathlib"}, {"name": "cardinal.deriv_lt_ord", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_type", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_type_le", "description": "", "p": "mathlib"}, {"name": "ordinal.cof", "description": "Cofinality of an ordinal. This is the smallest cardinal of a\n subset `S` of the ordinal which is unbounded, in the sense\n `\u2200 a, \u2203 b \u2208 S, a \u2264 b`. It is defined for all ordinals, but\n `cof 0 = 0` and `cof (succ o) = 1`, so it is only really\n interesting on limit ordinals (when it is an infinite cardinal).", "p": "mathlib"}, {"name": "cardinal.mk_subset_mk_lt_cof", "description": "", "p": "mathlib"}, {"name": "ordinal.bsup_lt_ord", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_eq_Inf_lsub", "description": "", "p": "mathlib"}, {"name": "ordinal.exists_blsub_cof", "description": "", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence.monotone", "description": "", "p": "mathlib"}, {"name": "ordinal.ord_cof_le", "description": "", "p": "mathlib"}, {"name": "ordinal.sup_lt_ord", "description": "", "p": "mathlib"}, {"name": "cardinal.lsub_lt_ord_lift_of_is_regular", "description": "", "p": "mathlib"}, {"name": "cardinal.univ_inaccessible", "description": "", "p": "mathlib"}, {"name": "cardinal.blsub_lt_ord_of_is_regular", "description": "", "p": "mathlib"}, {"name": "cardinal.lsub_lt_ord_of_is_regular", "description": "", "p": "mathlib"}, {"name": "ordinal.is_normal.cof_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_blsub_le_lift", "description": "", "p": "mathlib"}, {"name": "cardinal.lt_power_cof", "description": "", "p": "mathlib"}, {"name": "ordinal.lsub_lt_ord_lift", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular.pos", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular_cof", "description": "", "p": "mathlib"}, {"name": "ordinal.nfp_bfamily_lt_ord_lift", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular_aleph'_succ", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular_aleph_0", "description": "", "p": "mathlib"}, {"name": "ordinal.infinite_pigeonhole_set", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular_aleph_one", "description": "", "p": "mathlib"}, {"name": "order.cof_nonempty", "description": "The set in the definition of `order.cof` is nonempty.", "p": "mathlib"}, {"name": "ordinal.nfp_lt_ord", "description": "", "p": "mathlib"}, {"name": "ordinal.lift_cof", "description": "", "p": "mathlib"}, {"name": "cardinal.is_strong_limit", "description": "A cardinal is a strong limit if it is not zero and it is\n closed under powersets. Note that `\u2135\u2080` is a strong limit by this definition.", "p": "mathlib"}, {"name": "ordinal.nfp_bfamily_lt_ord", "description": "", "p": "mathlib"}, {"name": "ordinal.bsup_lt_ord_lift", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular_aleph_succ", "description": "", "p": "mathlib"}, {"name": "ordinal.aleph_0_le_cof", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_blsub_le", "description": "", "p": "mathlib"}, {"name": "order.le_cof", "description": "", "p": "mathlib"}, {"name": "cardinal.deriv_family_lt_ord_lift", "description": "", "p": "mathlib"}, {"name": "ordinal.aleph_cof", "description": "", "p": "mathlib"}, {"name": "cardinal.is_inaccessible.mk", "description": "", "p": "mathlib"}, {"name": "cardinal.is_strong_limit_beth", "description": "", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence.cof_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_ord_le", "description": "", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence", "description": "A fundamental sequence for `a` is an increasing sequence of length `o = cof a` that converges at\n   `a`. We provide `o` explicitly in order to avoid type rewrites.", "p": "mathlib"}, {"name": "rel_iso.cof_le_lift", "description": "", "p": "mathlib"}, {"name": "cardinal.lt_cof_power", "description": "", "p": "mathlib"}, {"name": "ordinal.sup_lt_ord_lift", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_eq'", "description": "", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence.zero", "description": "", "p": "mathlib"}, {"name": "cardinal.deriv_bfamily_lt_ord", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_zero", "description": "", "p": "mathlib"}, {"name": "cardinal.exists_infinite_fiber", "description": "A function whose codomain's cardinality is infinite but strictly smaller than its domain's\nhas an infinite fiber.", "p": "mathlib"}, {"name": "cardinal.is_strong_limit.is_succ_limit", "description": "", "p": "mathlib"}, {"name": "cardinal.supr_lt_of_is_regular", "description": "", "p": "mathlib"}, {"name": "cardinal.sup_lt_ord_of_is_regular", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_le_card", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_sup_le", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular.aleph_0_le", "description": "", "p": "mathlib"}, {"name": "rel_iso.cof_eq_lift", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_bsup_le_lift", "description": "", "p": "mathlib"}, {"name": "cardinal.le_range_of_union_finset_eq_top", "description": "If an infinite type `\u03b2` can be expressed as a union of finite sets,\nthen the cardinality of the collection of those finite sets\nmust be at least the cardinality of `\u03b2`.", "p": "mathlib"}, {"name": "cardinal.blsub_lt_ord_lift_of_is_regular", "description": "", "p": "mathlib"}, {"name": "order.cof", "description": "Cofinality of a reflexive order `\u227c`. This is the smallest cardinality\n of a subset `S : set \u03b1` such that `\u2200 a, \u2203 b \u2208 S, a \u227c b`.", "p": "mathlib"}, {"name": "cardinal.nfp_bfamily_lt_ord_of_is_regular", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_lsub_le", "description": "", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence.succ", "description": "", "p": "mathlib"}, {"name": "ordinal.unbounded_of_unbounded_sUnion", "description": "If the union of s is unbounded and s is smaller than the cofinality,\n then s has an unbounded member", "p": "mathlib"}, {"name": "ordinal.cof_bsup_le", "description": "", "p": "mathlib"}, {"name": "strict_order.cof", "description": " Cofinality of a strict order `\u227a`. This is the smallest cardinality of a set `S : set \u03b1` such\nthat `\u2200 a, \u2203 b \u2208 S, \u00ac b \u227a a`.", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence.id_of_le_cof", "description": "", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence.blsub_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.infinite_pigeonhole", "description": "The infinite pigeonhole principle", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence.strict_mono", "description": "", "p": "mathlib"}, {"name": "cardinal.sum_lt_of_is_regular", "description": "", "p": "mathlib"}, {"name": "cardinal.sup_lt_ord_lift_of_is_regular", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_lsub_def_nonempty", "description": "The set in the `lsub` characterization of `cof` is nonempty.", "p": "mathlib"}, {"name": "ordinal.cof_sup_le_lift", "description": "", "p": "mathlib"}, {"name": "ordinal.ord_cof_eq", "description": "", "p": "mathlib"}, {"name": "cardinal.infinite_pigeonhole_card_lt", "description": "A function whose codomain's cardinality is infinite but strictly smaller than its domain's\nhas a fiber with cardinality strictly great than the codomain.", "p": "mathlib"}, {"name": "cardinal.is_strong_limit_aleph_0", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_succ", "description": "", "p": "mathlib"}, {"name": "ordinal.is_fundamental_sequence.trans", "description": "", "p": "mathlib"}, {"name": "cardinal.is_regular.cof_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.nfp_family_lt_ord", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_ne_zero", "description": "", "p": "mathlib"}, {"name": "cardinal.deriv_family_lt_ord", "description": "", "p": "mathlib"}, {"name": "cardinal.sum_lt_lift_of_is_regular", "description": "", "p": "mathlib"}, {"name": "ordinal.cof_univ", "description": "", "p": "mathlib"}, {"name": "ordinal.supr_lt_lift", "description": "", "p": "mathlib"}, {"name": "strict_order.cof_nonempty", "description": "The set in the definition of `order.strict_order.cof` is nonempty.", "p": "mathlib"}, {"name": "cardinal.nfp_family_lt_ord_lift_of_is_regular", "description": "", "p": "mathlib"}, {"name": "cardinal.is_strong_limit.is_limit", "description": "", "p": "mathlib"}, {"name": "cardinal.deriv_bfamily_lt_ord_lift", "description": "", "p": "mathlib"}, {"name": "sylow.prime_pow_dvd_card_normalizer", "description": "If `H` is a `p`-subgroup but not a Sylow `p`-subgroup of cardinality `p ^ n`,\n then `p ^ (n + 1)` divides the cardinality of the normalizer of `H`.", "p": "mathlib"}, {"name": "sylow.characteristic_of_normal", "description": "", "p": "mathlib"}, {"name": "sylow.exists_subgroup_card_pow_prime", "description": "A generalisation of **Sylow's first theorem**. If `p ^ n` divides\n the cardinality of `G`, then there is a subgroup of cardinality `p ^ n`", "p": "mathlib"}, {"name": "sylow.fixed_points_mul_left_cosets_equiv_quotient", "description": "The fixed points of the action of `H` on its cosets correspond to `normalizer H / H`.", "p": "mathlib"}, {"name": "sylow.coe_smul", "description": "", "p": "mathlib"}, {"name": "sylow.prime_dvd_card_quotient_normalizer", "description": "If `H` is a `p`-subgroup but not a Sylow `p`-subgroup, then `p` divides the\n index of `H` inside its normalizer.", "p": "mathlib"}, {"name": "sylow.dvd_card_of_dvd_card", "description": "", "p": "mathlib"}, {"name": "sylow.exists_comap_eq_of_ker_is_p_group", "description": "", "p": "mathlib"}, {"name": "sylow.normalizer_normalizer", "description": "", "p": "mathlib"}, {"name": "sylow.fintype_of_ker_is_p_group", "description": "If the kernel of `f : H \u2192* G` is a `p`-group,\n then `fintype (sylow p G)` implies `fintype (sylow p H)`.", "p": "mathlib"}, {"name": "sylow.pow_dvd_card_of_pow_dvd_card", "description": "", "p": "mathlib"}, {"name": "sylow.equiv", "description": "Sylow subgroups are isomorphic", "p": "mathlib"}, {"name": "sylow.card_eq_multiplicity", "description": "The cardinality of a Sylow subgroup is `p ^ n`\nwhere `n` is the multiplicity of `p` in the group order.", "p": "mathlib"}, {"name": "sylow.mul_action", "description": "", "p": "mathlib"}, {"name": "sylow.coe_of_card", "description": "", "p": "mathlib"}, {"name": "sylow.nonempty", "description": "", "p": "mathlib"}, {"name": "sylow.of_card", "description": "A subgroup with cardinality `p ^ n` is a Sylow subgroup\nwhere `n` is the multiplicity of `p` in the group order.", "p": "mathlib"}, {"name": "sylow.card_coprime_index", "description": "Sylow subgroups are Hall subgroups.", "p": "mathlib"}, {"name": "sylow.comap_of_ker_is_p_group", "description": "The preimage of a Sylow subgroup under a p-group-kernel homomorphism is a Sylow subgroup.", "p": "mathlib"}, {"name": "sylow.smul_eq_of_normal", "description": "", "p": "mathlib"}, {"name": "sylow.coe_comap_of_injective", "description": "", "p": "mathlib"}, {"name": "sylow.orbit_eq_top", "description": "", "p": "mathlib"}, {"name": "sylow.normal_of_normalizer_condition", "description": "", "p": "mathlib"}, {"name": "is_p_group.exists_le_sylow", "description": "A generalization of **Sylow's first theorem**.\n Every `p`-subgroup is contained in a Sylow `p`-subgroup.", "p": "mathlib"}, {"name": "sylow.direct_product_of_normal", "description": " If all its Sylow subgroups are normal, then a finite group is isomorphic to the direct product\nof these Sylow subgroups.", "p": "mathlib"}, {"name": "not_dvd_index_sylow", "description": "", "p": "mathlib"}, {"name": "sylow.smul_subtype", "description": "", "p": "mathlib"}, {"name": "sylow.fintype_of_injective", "description": "If `f : H \u2192* G` is injective, then `fintype (sylow p G)` implies `fintype (sylow p H)`.", "p": "mathlib"}, {"name": "sylow.comap_of_injective", "description": "The preimage of a Sylow subgroup under an injective homomorphism is a Sylow subgroup.", "p": "mathlib"}, {"name": "sylow.to_subgroup_eq_coe", "description": "", "p": "mathlib"}, {"name": "sylow.ne_bot_of_dvd_card", "description": "", "p": "mathlib"}, {"name": "sylow.ext_iff", "description": "", "p": "mathlib"}, {"name": "sylow.stabilizer_eq_normalizer", "description": "", "p": "mathlib"}, {"name": "sylow.subgroup.has_coe", "description": "", "p": "mathlib"}, {"name": "sylow.subgroup_class", "description": "", "p": "mathlib"}, {"name": "sylow.card_quotient_normalizer_modeq_card_quotient", "description": "If `H` is a `p`-subgroup of `G`, then the index of `H` inside its normalizer is congruent\n mod `p` to the index of `H`.", "p": "mathlib"}, {"name": "sylow.conj_eq_normalizer_conj_of_mem", "description": "", "p": "mathlib"}, {"name": "sylow.exists_subgroup_card_pow_succ", "description": "If `H` is a subgroup of `G` of cardinality `p ^ n`,\n then `H` is contained in a subgroup of cardinality `p ^ (n + 1)`\n if `p ^ (n + 1)` divides the cardinality of `G`", "p": "mathlib"}, {"name": "sylow.smul_eq_iff_mem_normalizer", "description": "", "p": "mathlib"}, {"name": "sylow.card_normalizer_modeq_card", "description": "If `H` is a subgroup of `G` of cardinality `p ^ n`, then the cardinality of the\n normalizer of `H` is congruent mod `p ^ (n + 1)` to the cardinality of `G`.", "p": "mathlib"}, {"name": "quotient_group.card_preimage_mk", "description": "", "p": "mathlib"}, {"name": "sylow.coe_subtype", "description": "", "p": "mathlib"}, {"name": "card_sylow_modeq_one", "description": "A generalization of **Sylow's third theorem**.\n If the number of Sylow `p`-subgroups is finite, then it is congruent to `1` modulo `p`.", "p": "mathlib"}, {"name": "is_p_group.sylow_mem_fixed_points_iff", "description": "", "p": "mathlib"}, {"name": "has_quotient.quotient.fintype", "description": "", "p": "mathlib"}, {"name": "sylow.pointwise_smul_def", "description": "", "p": "mathlib"}, {"name": "sylow.normal_of_all_max_subgroups_normal", "description": "", "p": "mathlib"}, {"name": "sylow.smul_le", "description": "", "p": "mathlib"}, {"name": "is_p_group.inf_normalizer_sylow", "description": "", "p": "mathlib"}, {"name": "card_sylow_eq_card_quotient_normalizer", "description": "", "p": "mathlib"}, {"name": "card_sylow_dvd_index", "description": "", "p": "mathlib"}, {"name": "sylow.finite", "description": "If `H` is a subgroup of `G`, then `finite (sylow p G)` implies `finite (sylow p H)`.", "p": "mathlib"}, {"name": "sylow.mul_action_left", "description": "The action by a Sylow subgroup is the action by the underlying group.", "p": "mathlib"}, {"name": "sylow", "description": "A Sylow `p`-subgroup is a maximal `p`-subgroup.", "p": "mathlib"}, {"name": "sylow.to_subgroup", "description": "A Sylow `p`-subgroup is a maximal `p`-subgroup.", "p": "mathlib"}, {"name": "sylow.is_p_group'", "description": "A Sylow `p`-subgroup is a maximal `p`-subgroup.", "p": "mathlib"}, {"name": "sylow.is_maximal'", "description": "A Sylow `p`-subgroup is a maximal `p`-subgroup.", "p": "mathlib"}, {"name": "sylow.normalizer_sup_eq_top'", "description": "**Frattini's Argument**: If `N` is a normal subgroup of `G`, and if `P` is a Sylow `p`-subgroup\n of `N`, then `N_G(P) \u2294 N = G`.", "p": "mathlib"}, {"name": "sylow.conj_eq_normalizer_conj_of_mem_centralizer", "description": "", "p": "mathlib"}, {"name": "subgroup.sylow_mem_fixed_points_iff", "description": "", "p": "mathlib"}, {"name": "sylow.fintype", "description": "If `H` is a subgroup of `G`, then `fintype (sylow p G)` implies `fintype (sylow p H)`.", "p": "mathlib"}, {"name": "sylow.normalizer_sup_eq_top", "description": "**Frattini's Argument**: If `N` is a normal subgroup of `G`, and if `P` is a Sylow `p`-subgroup\n of `N`, then `N_G(P) \u2294 N = G`.", "p": "mathlib"}, {"name": "sylow.mul_action.is_pretransitive", "description": "A generalization of **Sylow's second theorem**.\n If the number of Sylow `p`-subgroups is finite, then all Sylow `p`-subgroups are conjugate.", "p": "mathlib"}, {"name": "not_dvd_card_sylow", "description": "", "p": "mathlib"}, {"name": "sylow.inhabited", "description": "", "p": "mathlib"}, {"name": "sylow.pointwise_mul_action", "description": "`subgroup.pointwise_mul_action` preserves Sylow subgroups.", "p": "mathlib"}, {"name": "card_sylow_eq_index_normalizer", "description": "", "p": "mathlib"}, {"name": "sylow.smul_def", "description": "", "p": "mathlib"}, {"name": "sylow.exists_subgroup_card_pow_prime_le", "description": "If `H` is a subgroup of `G` of cardinality `p ^ n`,\n then `H` is contained in a subgroup of cardinality `p ^ m`\n if `n \u2264 m` and `p ^ m` divides the cardinality of `G`", "p": "mathlib"}, {"name": "sylow.exists_comap_subtype_eq", "description": "", "p": "mathlib"}, {"name": "sy