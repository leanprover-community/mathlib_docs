name": "CommRing.category_theory.forget\u2082.category_theory.full", "description": "", "p": "mathlib"}, {"name": "Ring", "description": "The category of rings.", "p": "mathlib"}, {"name": "Ring.has_forget_to_AddCommGroup", "description": "", "p": "mathlib"}, {"name": "SemiRing.large_category", "description": "", "p": "mathlib"}, {"name": "ring_equiv.to_Ring_iso_inv", "description": "", "p": "mathlib"}, {"name": "CommSemiRing.of_hom_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.Ring_iso_to_ring_equiv", "description": "Build a `ring_equiv` from an isomorphism in the category `Ring`.", "p": "mathlib"}, {"name": "SemiRing.of", "description": "Construct a bundled SemiRing from the underlying type and typeclass.", "p": "mathlib"}, {"name": "CommRing.coe_of", "description": "", "p": "mathlib"}, {"name": "CommSemiRing.comm_semiring", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.CommRing_iso_to_ring_equiv_symm_to_ring_hom", "description": "", "p": "mathlib"}, {"name": "CommRing.has_forget_to_CommSemiRing", "description": "The forgetful functor from commutative rings to (multiplicative) commutative monoids.", "p": "mathlib"}, {"name": "CommSemiRing", "description": "The category of commutative semirings.", "p": "mathlib"}, {"name": "Ring.forget_reflects_isos", "description": "", "p": "mathlib"}, {"name": "Ring.of_hom_apply", "description": "", "p": "mathlib"}, {"name": "CommRing.of", "description": "Construct a bundled CommRing from the underlying type and typeclass.", "p": "mathlib"}, {"name": "ring_equiv.to_CommRing_iso", "description": "Build an isomorphism in the category `CommRing` from a `ring_equiv` between `comm_ring`s.", "p": "mathlib"}, {"name": "ring_equiv.to_Ring_iso_hom", "description": "", "p": "mathlib"}, {"name": "CommRing.of_hom_apply", "description": "", "p": "mathlib"}, {"name": "CommRing.comp_eq_ring_hom_comp", "description": "", "p": "mathlib"}, {"name": "CommRing.has_forget_to_Ring", "description": "", "p