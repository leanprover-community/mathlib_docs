fin_bounded_random", "description": "", "p": "mathlib"}, {"name": "io.run_rand_with", "description": "Run `cmd` using the provided seed.", "p": "mathlib"}, {"name": "io.random", "description": "randomly generate a value of type \u03b1", "p": "mathlib"}, {"name": "tactic.mk_generator", "description": "create a seeded random number generator in the `tactic` monad", "p": "mathlib"}, {"name": "random", "description": "`random \u03b1` gives us machinery to generate values of type `\u03b1`", "p": "mathlib"}, {"name": "random.random", "description": "`random \u03b1` gives us machinery to generate values of type `\u03b1`", "p": "mathlib"}, {"name": "io.random_series_r", "description": "randomly generate an infinite series of value of type \u03b1 between `x` and `y`", "p": "mathlib"}, {"name": "bitvec.random", "description": "generate a random bit vector of length `n`", "p": "mathlib"}, {"name": "rand.random_series", "description": "generate an infinite series of random values of type `\u03b1`", "p": "mathlib"}, {"name": "rand.random_r", "description": "Generate a random value between `x` and `y` inclusive.", "p": "mathlib"}, {"name": "fin_random", "description": "", "p": "mathlib"}, {"name": "bitvec.random_r", "description": "generate a random bit vector of length `n`", "p": "mathlib"}, {"name": "int_bounded_random", "description": " This `bounded_random` interval generates integers between `x` and\n`y` by first generating a natural number between `0` and `y - x` and\nshifting the result appropriately.", "p": "mathlib"}, {"name": "fin.random", "description": "generate a `fin` randomly", "p": "mathlib"}, {"name": "bounded_random_bitvec", "description": "", "p": "mathlib"}, {"name": "random_bitvec", "description": "", "p": "mathlib"}, {"name": "rand.split", "description": "create a new random number generator distinct from the one stored in the state", "p": "mathlib"}, {"name": "random_fin_of_pos", "description": " A shortcut for creating a `random (fin n)` instance from\na proof that `0 < n` rather than on matching on `fin (succ n)`", "p": "mathlib"}, {"name": "rand_g.next", "description": "Generate one more `\u2115`", "p": "mathlib"}, {"name": "io.run_rand", "description": "Run `cmd` using a randomly seeded random number generator", "p": "mathlib"}, {"name": "bool_of_nat_mem_Icc_of_mem_Icc_to_nat", "description": "", "p": "mathlib"}, {"name": "topological_group.tendsto_locally_uniformly_on_iff", "description": "", "p": "mathlib"}, {"name": "tendsto_div_comap_self", "description": "", "p": "mathlib"}, {"name": "topological_add_group.tendsto_locally_uniformly_iff", "description": "", "p": "mathlib"}, {"name": "uniform_add_group_Inf", "description": "", "p": "mathlib"}, {"name": "uniform_add_group", "description": "A uniform additive group is an additive group in which addition\n and negation are uniformly continuous.", "p": "mathlib"}, {"name": "uniform_add_group.uniform_continuous_sub", "description": "A uniform additive group is an additive group in which addition\n and negation are uniformly continuous.", "p": "mathlib"}, {"name": "uniform_continuous_inv", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly.add", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_neg", "description": "", "p": "mathlib"}, {"name": "prod.uniform_add_group", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_pow_const", "description": "", "p": "mathlib"}, {"name": "uniform_group.uniform_continuous_iff_open_ker", "description": " A homomorphism from a uniform group to a discrete uniform group is continuous if and only if\nits kernel is open.", "p": "mathlib"}, {"name": "subgroup.uniform_group", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.sub", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_zpow_const", "description": "", "p": "mathlib"}, {"name": "uniformity_eq_comap_nhds_one", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly.mul", "description": "", "p": "mathlib"}, {"name": "quotient_group.complete_space'", "description": " The quotient `G \u29f8 N` of a complete first countable topological group `G` by a normal subgroup\nis itself complete. [N. Bourbaki, *General Topology*, IX.3.1 Proposition 4][bourbaki1966b]\n\nBecause a topological group is not equipped with a `uniform_space` instance by default, we must\nexplicitly provide it in order to consider completeness. See `quotient_group.complete_space` for a\nversion in which `G` is already equipped with a uniform structure.", "p": "mathlib"}, {"name": "filter.has_basis.uniformity_of_nhds_zero_neg_add", "description": "", "p": "mathlib"}, {"name": "topological_add_comm_group_is_uniform", "description": "", "p": "mathlib"}, {"name": "uniformity_eq_comap_neg_add_nhds_zero_swapped", "description": "", "p": "mathlib"}, {"name": "topological_add_group.t2_space_of_zero_sep", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.neg", "description": "", "p": "mathlib"}, {"name": "uniformity_eq_comap_inv_mul_nhds_one", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.uniformity_of_nhds_zero_swapped", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.inv", "description": "", "p": "mathlib"}, {"name": "uniform_add_group.to_topological_add_group", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_of_tendsto_one", "description": "", "p": "mathlib"}, {"name": "uniform_group_infi", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_const_nsmul", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.sub", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.uniformity_of_nhds_one", "description": "", "p": "mathlib"}, {"name": "add_subgroup.uniform_add_group", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.uniformity_of_nhds_one_swapped", "description": "", "p": "mathlib"}, {"name": "mul_opposite.uniform_group", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.sub", "description": "", "p": "mathlib"}, {"name": "quotient_group.complete_space", "description": " The quotient `G \u29f8 N` of a complete first countable uniform group `G` by a normal subgroup\nis itself complete. In constrast to `quotient_group.complete_space'`, in this version `G` is\nalready equipped with a uniform structure.\n[N. Bourbaki, *General Topology*, IX.3.1 Proposition 4][bourbaki1966b]\n\nEven though `G` is equipped with a uniform structure, the quotient `G \u29f8 N` does not inherit a\nuniform structure, so it is still provided manually via `topological_group.to_uniform_space`.\nIn the most common use cases, this coincides (definitionally) with the uniform structure on the\nquotient obtained via other means.", "p": "mathlib"}, {"name": "quotient_add_group.complete_space'", "description": "The quotient `G \u29f8 N` of a complete first countable topological additive group\n`G` by a normal additive subgroup is itself complete. Consequently, quotients of Banach spaces by\nsubspaces are complete. [N. Bourbaki, *General Topology*, IX.3.1 Proposition 4][bourbaki1966b]\n\nBecause an additive topological group is not equipped with a `uniform_space` instance by default,\nwe must explicitly provide it in order to consider completeness. See\n`quotient_add_group.complete_space` for a version in which `G` is already equipped with a uniform\nstructure.", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.add", "description": "", "p": "mathlib"}, {"name": "uniformity_translate_add", "description": "", "p": "mathlib"}, {"name": "topological_add_group.tendsto_uniformly_on_iff", "description": "", "p": "mathlib"}, {"name": "uniformity_eq_comap_inv_mul_nhds_one_swapped", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.uniform_continuous_of_continuous_at_zero", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.div", "description": "", "p": "mathlib"}, {"name": "topological_add_group_is_uniform_of_compact_space", "description": "", "p": "mathlib"}, {"name": "uniformity_eq_comap_nhds_zero'", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_of_continuous_at_one", "description": " A group homomorphism (a bundled morphism of a type that implements `monoid_hom_class`) between\ntwo uniform groups is uniformly continuous provided that it is continuous at one. See also\n`continuous_of_continuous_at_one`.", "p": "mathlib"}, {"name": "tendsto_uniformly.div", "description": "", "p": "mathlib"}, {"name": "uniform_group", "description": "A uniform group is a group in which multiplication and inversion are uniformly continuous.", "p": "mathlib"}, {"name": "uniform_group.uniform_continuous_div", "description": "A uniform group is a group in which multiplication and inversion are uniformly continuous.", "p": "mathlib"}, {"name": "uniform_continuous_monoid_hom_of_continuous", "description": "", "p": "mathlib"}, {"name": "dense_inducing.extend_Z_bilin", "description": " Bourbaki GT III.6.5 Theorem I:\n\u2124-bilinear continuous maps from dense images into a complete Hausdorff group extend by continuity.\nNote: Bourbaki assumes that \u03b1 and \u03b2 are also complete Hausdorff, but this is not necessary.", "p": "mathlib"}, {"name": "uniformity_eq_comap_nhds_one'", "description": "", "p": "mathlib"}, {"name": "totally_bounded_iff_subset_finite_Union_nhds_zero", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.uniformity_of_nhds_one_inv_mul", "description": "", "p": "mathlib"}, {"name": "tendsto_sub_comap_self", "description": "", "p": "mathlib"}, {"name": "topological_group_is_uniform_of_compact_space", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.uniformity_of_nhds_one_inv_mul_swapped", "description": "", "p": "mathlib"}, {"name": "uniform_group.to_topological_group", "description": "", "p": "mathlib"}, {"name": "add_group_separation_rel", "description": "", "p": "mathlib"}, {"name": "uniform_add_group.uniform_continuous_iff_open_ker", "description": "A homomorphism from a uniform additive group to a discrete uniform additive group is\ncontinuous if and only if its kernel is open.", "p": "mathlib"}, {"name": "uniform_continuous.add", "description": "", "p": "mathlib"}, {"name": "uniform_group_Inf", "description": "", "p": "mathlib"}, {"name": "uniform_group_inf", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_add_monoid_hom_of_continuous", "description": "", "p": "mathlib"}, {"name": "add_opposite.uniform_add_group", "description": "", "p": "mathlib"}, {"name": "uniform_add_group_inf", "description": "", "p": "mathlib"}, {"name": "add_subgroup.is_closed_of_discrete", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.const_nsmul", "description": "", "p": "mathlib"}, {"name": "quotient_add_group.complete_space", "description": "The quotient `G \u29f8 N` of a complete first countable uniform additive group\n`G` by a normal additive subgroup is itself complete. Consequently, quotients of Banach spaces by\nsubspaces are complete. In constrast to `quotient_add_group.complete_space'`, in this version\n`G` is already equipped with a uniform structure.\n[N. Bourbaki, *General Topology*, IX.3.1 Proposition 4][bourbaki1966b]\n\nEven though `G` is equipped with a uniform structure, the quotient `G \u29f8 N` does not inherit a\nuniform structure, so it is still provided manually via `topological_add_group.to_uniform_space`.\nIn the most common use case \u2500 quotients of normed additive commutative groups by subgroups \u2500\nsignificant care was taken so that the uniform structure inherent in that setting coincides\n(definitionally) with the uniform structure provided here.", "p": "mathlib"}, {"name": "tendsto_uniformly_on.div", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.mul", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on.sub", "description": "", "p": "mathlib"}, {"name": "topological_add_group.to_uniform_space", "description": "The right uniformity on a topological additive group (as opposed to the left\nuniformity).\n\nWarning: in general the right and left uniformities do not coincide and so one does not obtain a\n`uniform_add_group` structure. Two important special cases where they _do_ coincide are for\ncommutative additive groups (see `topological_add_comm_group_is_uniform`) and for compact\nadditive groups (see `topological_add_comm_group_is_uniform_of_compact_space`).", "p": "mathlib"}, {"name": "filter.has_basis.uniformity_of_nhds_zero_neg_add_swapped", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.add", "description": "", "p": "mathlib"}, {"name": "uniform_group.mk'", "description": "", "p": "mathlib"}, {"name": "uniform_add_group.ext", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.neg", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_div", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.div", "description": "", "p": "mathlib"}, {"name": "topological_group.tendsto_uniformly_iff", "description": "", "p": "mathlib"}, {"name": "uniform_add_group.mk'", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_of_continuous_at_zero", "description": "An additive group homomorphism (a bundled morphism of a type that implements\n`add_monoid_hom_class`) between two uniform additive groups is uniformly continuous provided that it\nis continuous at zero. See also `continuous_of_continuous_at_zero`.", "p": "mathlib"}, {"name": "topological_add_group.tendsto_uniformly_iff", "description": "", "p": "mathlib"}, {"name": "uniformity_eq_comap_nhds_one_swapped", "description": "", "p": "mathlib"}, {"name": "uniform_add_group.to_uniform_space_eq", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_mul", "description": "", "p": "mathlib"}, {"name": "topological_add_group.t2_space_iff_zero_closed", "description": "", "p": "mathlib"}, {"name": "uniform_add_group_comap", "description": "", "p": "mathlib"}, {"name": "topological_comm_group_is_uniform", "description": "", "p": "mathlib"}, {"name": "uniform_embedding_translate_mul", "description": "", "p": "mathlib"}, {"name": "subgroup.is_closed_of_discrete", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.mul_const", "description": "", "p": "mathlib"}, {"name": "topological_group.tendsto_locally_uniformly_iff", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.uniformity_of_nhds_zero", "description": "", "p": "mathlib"}, {"name": "uniform_embedding_translate_add", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_of_tendsto_zero", "description": "", "p": "mathlib"}, {"name": "uniform_add_group.uniformity_countably_generated", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.zpow_const", "description": "", "p": "mathlib"}, {"name": "uniformity_translate_mul", "description": "", "p": "mathlib"}, {"name": "topological_group.t2_space_iff_one_closed", "description": "", "p": "mathlib"}, {"name": "prod.uniform_group", "description": "", "p": "mathlib"}, {"name": "uniform_group.to_uniform_space_eq", "description": "", "p": "mathlib"}, {"name": "uniform_group.ext_iff", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.const_zsmul", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.pow_const", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.add_const", "description": "", "p": "mathlib"}, {"name": "uniform_group.uniformity_countably_generated", "description": "", "p": "mathlib"}, {"name": "uniformity_eq_comap_nhds_zero", "description": "", "p": "mathlib"}, {"name": "topological_group.tendsto_uniformly_on_iff", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_sub", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.div", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.add", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_add", "description": "", "p": "mathlib"}, {"name": "topological_add_group.tendsto_locally_uniformly_on_iff", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.mul", "description": "", "p": "mathlib"}, {"name": "uniform_add_group.ext_iff", "description": "", "p": "mathlib"}, {"name": "uniformity_eq_comap_nhds_zero_swapped", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly.sub", "description": "", "p": "mathlib"}, {"name": "topological_group.t2_space_of_one_sep", "description": "", "p": "mathlib"}, {"name": "uniform_group_comap", "description": "", "p": "mathlib"}, {"name": "monoid_hom.uniform_continuous_of_continuous_at_one", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.inv", "description": "", "p": "mathlib"}, {"name": "topological_group.to_uniform_space", "description": " The right uniformity on a topological group (as opposed to the left uniformity).\n\nWarning: in general the right and left uniformities do not coincide and so one does not obtain a\n`uniform_group` structure. Two important special cases where they _do_ coincide are for\ncommutative groups (see `topological_comm_group_is_uniform`) and for compact groups (see\n`topological_group_is_uniform_of_compact_space`).", "p": "mathlib"}, {"name": "uniform_continuous_const_zsmul", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on.mul", "description": "", "p": "mathlib"}, {"name": "totally_bounded_iff_subset_finite_Union_nhds_one", "description": "", "p": "mathlib"}, {"name": "group_separation_rel", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.mul", "description": "", "p": "mathlib"}, {"name": "uniform_add_group_infi", "description": "", "p": "mathlib"}, {"name": "uniformity_eq_comap_neg_add_nhds_zero", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.mul", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.const_mul", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.const_add", "description": "", "p": "mathlib"}, {"name": "uniform_group.ext", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on.add", "description": "", "p": "mathlib"}, {"name": "imo2019_q2.imo2019q2_cfg.not_collinear_ABC", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.collinear_PAA\u2081A\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.P_mem_\u03c9", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.sbtw_B_A\u2081_C", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.B\u2081_ne_C", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.oangle_CQ\u2081Q_eq_oangle_CBA", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A_ne_A\u2081", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A\u2082_ne_C", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.B\u2082_ne_Q", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.two_zsmul_oangle_QPA\u2082_eq_two_zsmul_oangle_QB\u2082A\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.s_opp_side_CB_Q_Q\u2081", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.not_collinear_QPA\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.two_zsmul_oangle_QPA\u2082_eq_two_zsmul_oangle_BAA\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.\u03c9", "description": " `\u03c9` is the circle containing `Q`, `P` and `A\u2082`, which will be shown also to contain `B\u2082`,\n`P\u2081` and `Q\u2081`.", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.symm_\u03c9_eq_triangle_PQB\u2082_circumsphere", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.wbtw_B_Q_B\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.B\u2082_mem_circumsphere", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A\u2082_ne_A", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.two_zsmul_oangle_CA\u2082A\u2081_eq_two_zsmul_oangle_CQ\u2081A\u2081", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.affine_independent_PQB\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A\u2082_ne_P", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.sbtw_B_B\u2081_B\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.Q_not_mem_CB", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.symm_\u03c9", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.sbtw_A_A\u2081_A\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.Q\u2081_mem_\u03c9", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A_ne_B", "description": "", "p": "mathlib-archive"}, {"name": "library_note.IMO geometry formalization conventions", "description": "We apply the following conventions for formalizing IMO geometry problems. A problem is assumed\nto take place in the plane unless that is clearly not intended, so it is not required to prove\nthat the points are coplanar (whether or not that in fact follows from the other conditions).\nAngles in problem statements are taken to be unoriented. A reference to an angle `\u2220XYZ` is taken\nto imply that `X` and `Z` are not equal to `Y`, since choices of junk values play no role in\ninformal mathematics, and those implications are included as hypotheses for the problem whether\nor not they follow from the other hypotheses. Similar, a reference to `XY` as a line is taken to\nimply that `X` does not equal `Y` and that is included as a hypothesis, and a reference to `XY`\nbeing parallel to something is considered a reference to it as a line. However, such an implicit\nhypothesis about two points being different is included only once for any given two points (even\nif it follows from more than one reference to a line or an angle), if `X \u2260 Y` is included then\n`Y \u2260 X` is not included separately, and such hypotheses are not included in the case where there\nis also a reference in the problem to a triangle including those two points, or to strict\nbetweenness of three points including those two. If betweenness is stated, it is taken to be\nstrict betweenness. However, segments and sides are taken to include their endpoints (unless\nthis makes a problem false), although those degenerate cases might not necessarily have been\nconsidered when the problem was formulated and contestants might not have been expected to deal\nwith them. A reference to a point being on a side or a segment is expressed directly with `wbtw`\nrather than more literally with `affine_segment`.", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.triangle_PQB\u2082", "description": "`PQB\u2082` as a `triangle`.", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A\u2081_ne_C", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A\u2082_mem_circumsphere", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.Q\u2081_ne_A\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A_mem_circumsphere", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.C_mem_circumsphere", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.result", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A\u2082", "description": "`A\u2082` is the second point of intersection of the ray `AA\u2081` with the circumcircle of `ABC`.", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.B\u2082_ne_A\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.B\u2082_ne_B", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.symm_triangle_ABC", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.Q_ne_B", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.symm_A\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.A\u2082_ne_B", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.triangle_QPA\u2082", "description": "`QPA\u2082` as a `triangle`.", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.QP_parallel_BA", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.cospherical_A\u2081Q\u2081CA\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.not_collinear_CA\u2082A\u2081", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.affine_independent_QPA\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.oangle_CQ\u2081Q_sign_eq_oangle_CBA_sign", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.P\u2081_mem_\u03c9", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.some_orientation", "description": "A default choice of orientation, for lemmas that need to pick one.", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.cospherical_QPB\u2082A\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.B_mem_circumsphere", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.B_ne_C", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.symm_triangle_QPA\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.Q_mem_\u03c9", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.symm_triangle_ABC_circumsphere", "description": "", "p": "mathlib-archive"}, {"name": "imo2019_q2.imo2019q2_cfg.sbtw_A_B\u2081_C", "descriptio