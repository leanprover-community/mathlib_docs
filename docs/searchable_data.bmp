description": "", "p": "mathlib"}, {"name": "polynomial.coeff_inv_units", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_functor_obj_left", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements", "description": "The category structure on `F.elements`, for `F : C \u2964 Type`.\n   A morphism `(X, x) \u27f6 (Y, y)` is a morphism `f : X \u27f6 Y` in `C`, so `F.map f` takes `x` to `y`.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.from_costructured_arrow_obj_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_unit_iso_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_functor_map_right_down_down", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.from_structured_arrow_map", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.\u03c0", "description": "The functor out of the category of elements which forgets the element.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_inverse_map", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence", "description": "The equivalence between the category of elements `F.elements`\n   and the comma category `(*, F)`.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.map_obj_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_counit_iso_hom_app_left", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.from_structured_arrow", "description": "The reverse direction of the equivalence `F.elements \u2245 (*, F)`.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.to_costructured_arrow", "description": "The forward direction of the equivalence `F.elements\u1d52\u1d56 \u2245 (yoneda, F)`,\ngiven by `category_theory.yoneda_sections`.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.from_costructured_arrow_obj_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_inverse_map_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_counit_iso_hom_app_right", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_unit_iso_inv_app_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.elements", "description": "The type of objects for the category of elements of a functor `F : C \u2964 Type`\nis a pair `(X : C, x : F.obj X)`.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.id_val", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_naturality", "description": "The equivalence `(-.elements)\u1d52\u1d56 \u2245 (yoneda, -)` of is actually a natural isomorphism of functors.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.from_costructured_arrow_map_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.\u03c0_map", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.to_costructured_arrow_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.from_structured_arrow_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_counit_iso_inv_app_left", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.from_costructured_arrow", "description": "The reverse direction of the equivalence `F.elements\u1d52\u1d56 \u2245 (yoneda, F)`,\ngiven by `category_theory.yoneda_equiv`.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_functor_map_right", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_functor_obj_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.from_to_costructured_arrow_eq", "description": "The unit of the equivalence `F.elements\u1d52\u1d56 \u2245 (yoneda, F)` is indeed iso.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_functor_map_left_down_down", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_unit_iso_hom_app_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_inverse_obj_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_unit_iso_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.to_structured_arrow_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_functor_map_left", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.map_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.groupoid_of_elements", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_functor_obj_right", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.to_costructured_arrow_map", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_counit_iso_inv_app_right", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.map_map_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.\u03c0_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.to_structured_arrow", "description": "The forward direction of the equivalence `F.elements \u2245 (*, F)`.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.structured_arrow_equivalence_inverse_obj_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence", "description": "The equivalence `F.elements\u1d52\u1d56 \u2245 (yoneda, F)` given by yoneda lemma.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_counit_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_counit_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.to_from_costructured_arrow_eq", "description": "The counit of the equivalence `F.elements\u1d52\u1d56 \u2245 (yoneda, F)` is indeed iso.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.map_obj_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.from_costructured_arrow_obj_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.map", "description": "A natural transformation between functors induces a functor between the categories of elements.", "p": "mathlib"}, {"name": "category_theory.category_of_elements.to_comma_map_right", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.comp_val", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_inverse_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.category_of_elements.costructured_arrow_yoneda_equivalence_functor_obj_hom_app", "description": "", "p": "mathlib"}, {"name": "mul_opposite.map_op_nhds", "description": "", "p": "mathlib"}, {"name": "add_opposite.map_op_nhds", "description": "", "p": "mathlib"}, {"name": "add_units.embedding_embed_product", "description": "", "p": "mathlib"}, {"name": "units.inducing_embed_product", "description": "", "p": "mathlib"}, {"name": "add_units.topology_eq_inf", "description": "", "p": "mathlib"}, {"name": "add_opposite.op_homeomorph_apply", "description": "", "p": "mathlib"}, {"name": "add_opposite.op_homeomorph_symm_apply", "description": "", "p": "mathlib"}, {"name": "units.topological_space", "description": "The units of a monoid are equipped with a topology, via the embedding into `M \u00d7 M`.", "p": "mathlib"}, {"name": "add_opposite.comap_unop_nhds", "description": "", "p": "mathlib"}, {"name": "mul_opposite.op_homeomorph_apply", "description": "", "p": "mathlib"}, {"name": "add_units.inducing_embed_product", "description": "", "p": "mathlib"}, {"name": "units.embedding_coe_mk", "description": " An auxiliary lemma that can be used to prove that coercion `M\u02e3 \u2192 M` is a topological embedding.\nUse `units.coe_embedding\u2080`, `units.coe_embedding`, or `to_units_homeomorph` instead.", "p": "mathlib"}, {"name": "mul_opposite.map_unop_nhds", "description": "", "p": "mathlib"}, {"name": "units.topology_eq_inf", "description": "", "p": "mathlib"}, {"name": "add_units.topological_space", "description": "The additive units of a monoid are equipped with a topology, via the embedding into\n`M \u00d7 M`.", "p": "mathlib"}, {"name": "units.continuous_iff", "description": "", "p": "mathlib"}, {"name": "add_units.embedding_coe_mk", "description": "An auxiliary lemma that can be used to prove that coercion `add_units M \u2192 M` is a\ntopological embedding. Use `add_units.coe_embedding` or `to_add_units_homeomorph` instead.", "p": "mathlib"}, {"name": "add_units.continuous_coe_neg", "description": "", "p": "mathlib"}, {"name": "mul_opposite.topological_space", "description": "Put the same topological space structure on the opposite monoid as on the original space.", "p": "mathlib"}, {"name": "add_opposite.continuous_op", "description": "", "p": "mathlib"}, {"name": "add_opposite.comap_op_nhds", "description": "", "p": "mathlib"}, {"name": "add_opposite.continuous_unop", "description": "", "p": "mathlib"}, {"name": "units.continuous_coe_inv", "description": "", "p": "mathlib"}, {"name": "add_units.continuous_iff", "description": "", "p": "mathlib"}, {"name": "add_opposite.map_unop_nhds", "description": "", "p": "mathlib"}, {"name": "mul_opposite.op_homeomorph_symm_apply", "description": "", "p": "mathlib"}, {"name": "units.embedding_embed_product", "description": "", "p": "mathlib"}, {"name": "units.continuous_coe", "description": "", "p": "mathlib"}, {"name": "mul_opposite.continuous_unop", "description": "", "p": "mathlib"}, {"name": "add_opposite.t2_space", "description": "", "p": "mathlib"}, {"name": "mul_opposite.t2_space", "description": "", "p": "mathlib"}, {"name": "mul_opposite.continuous_op", "description": "", "p": "mathlib"}, {"name": "mul_opposite.op_homeomorph", "description": "`mul_opposite.op` as a homeomorphism.", "p": "mathlib"}, {"name": "add_units.continuous_coe", "description": "", "p": "mathlib"}, {"name": "units.continuous_embed_product", "description": "", "p": "mathlib"}, {"name": "add_opposite.op_homeomorph", "description": "`add_opposite.op` as a homeomorphism.", "p": "mathlib"}, {"name": "mul_opposite.comap_op_nhds", "description": "", "p": "mathlib"}, {"name": "add_opposite.topological_space", "description": "Put the same topological space structure on the opposite monoid as on the original\nspace.", "p": "mathlib"}, {"name": "add_units.continuous_embed_product", "description": "", "p": "mathlib"}, {"name": "mul_opposite.comap_unop_nhds", "description": "", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.measure_mul_le_scaling_constant_of_mul", "description": "", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.eventually_measure_le_scaling_constant_mul", "description": "", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.scaling_constant_of", "description": " A variant of `is_unif_loc_doubling_measure.doubling_constant` which allows for scaling the\nradius by values other than `2`.", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.scaling_scale_of", "description": " A scale below which the doubling measure `\u03bc` satisfies good rescaling properties when one\nmultiplies the radius of balls by at most `K`, as stated\nin `measure_mul_le_scaling_constant_of_mul`.", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.doubling_constant", "description": " A doubling constant for a uniformly locally doubling measure.\n\nSee also `is_unif_loc_doubling_measure.scaling_constant_of`.", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure", "description": " A measure `\u03bc` is said to be a uniformly locally doubling measure if there exists a constant `C`\nsuch that for all sufficiently small radii `\u03b5`, and for any centre, the measure of a ball of radius\n`2 * \u03b5` is bounded by `C` times the measure of the concentric ball of radius `\u03b5`.\n\nNote: it is important that this definition makes a demand only for sufficiently small `\u03b5`. For\nexample we want hyperbolic space to carry the instance `is_unif_loc_doubling_measure volume` but\nvolumes grow exponentially in hyperbolic space. To be really explicit, consider the hyperbolic plane\nof curvature -1, the area of a disc of radius `\u03b5` is `A(\u03b5) = 2\u03c0(cosh(\u03b5) - 1)` so\n`A(2\u03b5)/A(\u03b5) ~ exp(\u03b5)`.", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.exists_measure_closed_ball_le_mul", "description": " A measure `\u03bc` is said to be a uniformly locally doubling measure if there exists a constant `C`\nsuch that for all sufficiently small radii `\u03b5`, and for any centre, the measure of a ball of radius\n`2 * \u03b5` is bounded by `C` times the measure of the concentric ball of radius `\u03b5`.\n\nNote: it is important that this definition makes a demand only for sufficiently small `\u03b5`. For\nexample we want hyperbolic space to carry the instance `is_unif_loc_doubling_measure volume` but\nvolumes grow exponentially in hyperbolic space. To be really explicit, consider the hyperbolic plane\nof curvature -1, the area of a disc of radius `\u03b5` is `A(\u03b5) = 2\u03c0(cosh(\u03b5) - 1)` so\n`A(2\u03b5)/A(\u03b5) ~ exp(\u03b5)`.", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.one_le_scaling_constant_of", "description": "", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.eventually_measure_le_scaling_constant_mul'", "description": "", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.exists_eventually_forall_measure_closed_ball_le_mul", "description": "", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.exists_measure_closed_ball_le_mul'", "description": "", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.eventually_measure_mul_le_scaling_constant_of_mul", "description": "", "p": "mathlib"}, {"name": "is_unif_loc_doubling_measure.scaling_scale_of_pos", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation_def", "description": " The valuation at infinity is the nonarchimedean valuation on `Fq(t)` with uniformizer `1/t`.\nExplicitly, if `f/g \u2208 Fq(t)` is a nonzero quotient of polynomials, its valuation at infinity is\n`multiplicative.of_add(degree(f) - degree(g))`.", "p": "mathlib"}, {"name": "function_field", "description": " `F` is a function field over the finite field `Fq` if it is a finite\nextension of the field of rational functions in one variable over `Fq`.\n\nNote that `F` can be a function field over multiple, non-isomorphic, `Fq`.", "p": "mathlib"}, {"name": "function_field.ring_of_integers", "description": " The function field analogue of `number_field.ring_of_integers`:\n`function_field.ring_of_integers Fq Fqt F` is the integral closure of `Fq[t]` in `F`.\n\nWe don't actually assume `F` is a function field over `Fq` in the definition,\nonly when proving its properties.", "p": "mathlib"}, {"name": "function_field.Fqt_infty", "description": "The completion `Fq((t\u207b\u00b9))`  of `Fq(t)` with respect to the valuation at infinity.", "p": "mathlib"}, {"name": "function_field.ring_of_integers.is_domain", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation.map_add_le_max'", "description": "", "p": "mathlib"}, {"name": "function_field.valued_Fqt_infty", "description": "The valuation at infinity on `k(t)` extends to a valuation on `Fqt_infty`.", "p": "mathlib"}, {"name": "function_field.ring_of_integers.not_is_field", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation.C", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation.map_mul'", "description": "", "p": "mathlib"}, {"name": "algebra_map_injective", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation.X", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation.map_zero'", "description": "", "p": "mathlib"}, {"name": "function_field.ring_of_integers.is_fraction_ring", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation", "description": "The valuation at infinity on `Fq(t)`.", "p": "mathlib"}, {"name": "function_field.infty_valued_Fqt.def", "description": "", "p": "mathlib"}, {"name": "function_field.ring_of_integers.is_dedekind_domain", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation.polynomial", "description": "", "p": "mathlib"}, {"name": "function_field_iff", "description": "`F` is a function field over `Fq` iff it is a finite extension of `Fq(t)`.", "p": "mathlib"}, {"name": "function_field.valued_Fqt_infty.def", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation_apply", "description": "", "p": "mathlib"}, {"name": "function_field.ring_of_integers.is_integrally_closed", "description": "", "p": "mathlib"}, {"name": "function_field.ring_of_integers.is_integral_closure", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation_of_nonzero", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valuation.map_one'", "description": "", "p": "mathlib"}, {"name": "function_field.ring_of_integers.is_noetherian", "description": "", "p": "mathlib"}, {"name": "function_field.infty_valued_Fqt", "description": "The valued field `Fq(t)` with the valuation at infinity.", "p": "mathlib"}, {"name": "function_field.Fqt_infty.inhabited", "description": "", "p": "mathlib"}, {"name": "function_field.Fqt_infty.field", "description": "", "p": "mathlib"}, {"name": "function_field.ring_of_integers.algebra_map_injective", "description": "", "p": "mathlib"}, {"name": "Group.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit group.", "p": "mathlib"}, {"name": "AddCommGroup.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `AddCommGroup`.", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.colimit_neg_aux_eq_of_rel", "description": "", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.colimit_has_neg", "description": "Negation in the colimit. See also `colimit_neg_aux`.", "p": "mathlib"}, {"name": "CommGroup.filtered_colimits.colimit_comm_group", "description": "", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "Group.filtered_colimits.colimit", "description": "The bundled group giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.forget\u2082_AddMon_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "Group.filtered_colimits.G.mk", "description": "The canonical projection into the colimit, as a quotient type.", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.G.mk", "description": "The canonical projection into the colimit, as a quotient type.", "p": "mathlib"}, {"name": "AddCommGroup.filtered_colimits.G", "description": "The colimit of `F \u22d9 forget\u2082 AddCommGroup AddGroup` in the category `AddGroup`.\nIn the following, we will show that this has the structure of a _commutative_ additive group.", "p": "mathlib"}, {"name": "AddCommGroup.filtered_colimits.colimit_add_comm_group", "description": "", "p": "mathlib"}, {"name": "CommGroup.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `CommGroup`.", "p": "mathlib"}, {"name": "Group.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "Group.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `Group`.", "p": "mathlib"}, {"name": "CommGroup.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit commutative group.", "p": "mathlib"}, {"name": "Group.filtered_colimits.colimit_group", "description": "", "p": "mathlib"}, {"name": "Group.filtered_colimits.colimit_inv_aux", "description": "The \"unlifted\" version of taking inverses in the colimit.", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.G", "description": "The colimit of `F \u22d9 forget\u2082 AddGroup AddMon` in the category `AddMon`.\nIn the following, we will show that this has the structure of an additive group.", "p": "mathlib"}, {"name": "CommGroup.filtered_colimits.forget\u2082_Group_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.filtered_colimits.forget\u2082_AddGroup_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit additive commutative group.", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.colimit_neg_mk_eq", "description": "", "p": "mathlib"}, {"name": "CommGroup.filtered_colimits.G", "description": "The colimit of `F \u22d9 forget\u2082 CommGroup Group` in the category `Group`.\nIn the following, we will show that this has the structure of a _commutative_ group.", "p": "mathlib"}, {"name": "Group.filtered_colimits.forget\u2082_Mon_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit additive group.", "p": "mathlib"}, {"name": "Group.filtered_colimits.G", "description": "The colimit of `F \u22d9 forget\u2082 Group Mon` in the category `Mon`.\nIn the following, we will show that this has the structure of a group.", "p": "mathlib"}, {"name": "CommGroup.filtered_colimits.colimit", "description": "The bundled commutative group giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "CommGroup.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "Group.filtered_colimits.colimit_inv_mk_eq", "description": "", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.G.mk_eq", "description": "", "p": "mathlib"}, {"name": "Group.filtered_colimits.colimit_inv_aux_eq_of_rel", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.filtered_colimits.colimit", "description": "The bundled additive commutative group giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "Group.filtered_colimits.G.mk_eq", "description": "", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.colimit_add_group", "description": "", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.colimit_neg_aux", "description": "The \"unlifted\" version of negation in the colimit.", "p": "mathlib"}, {"name": "AddGroup.filtered_colimits.colimit", "description": "The bundled additive group giving the filtered colimit of a diagr