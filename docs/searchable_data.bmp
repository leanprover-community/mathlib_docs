: "mathlib"}, {"name": "upper_half_plane.dist_comm", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.dist_coe_center_sq", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.dist_log_im_le", "description": " Hyperbolic distance between two points is greater than or equal to the distance between the\nlogarithms of their imaginary parts.", "p": "mathlib"}, {"name": "upper_half_plane.dist_le_dist_coe_div_sqrt", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.im_pos_of_dist_center_le", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.sinh_half_dist", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.center_re", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.le_dist_coe", "description": " An upper estimate on the complex distance between two points in terms of the hyperbolic distance\nand the imaginary part of one of the points.", "p": "mathlib"}, {"name": "upper_half_plane.le_dist_iff_le_dist_coe_center", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.isometry_real_vadd", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.image_coe_sphere", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.dist_lt_iff_dist_coe_center_lt", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.isometry_vertical_line", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.dist_eq_iff_eq_sinh", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.exp_half_dist", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.dist_coe_le", "description": " An upper estimate on the complex distance between two points in terms of the hyperbolic distance\nand the imaginary part of one of the points.", "p": "mathlib"}, {"name": "upper_half_plane.has_dist", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.dist_le_iff_le_sinh", "description": "", "p": "mathlib"}, {"name": "upper_half_plane.im_le_im_mul_exp_dist", "description": "", "p": "mathlib"}, {"name": "uniform_space.ring_sep_quot", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.algebra_map_def", "description": "", "p": "mathlib"}, {"name": "dense_inducing.extend_ring_hom", "description": "The dense inducing extension as a ring homomorphism.", "p": "mathlib"}, {"name": "uniform_space.completion.top_ring_compl", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.coe_ring_hom", "description": "The map from a uniform ring to its completion, as a ring homomorphism.", "p": "mathlib"}, {"name": "uniform_space.completion.extension_hom", "description": "The completion extension as a ring morphism.", "p": "mathlib"}, {"name": "uniform_space.completion.coe_one", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.algebra", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.has_one", "description": "", "p": "mathlib"}, {"name": "uniform_space.sep_quot_equiv_ring_quot", "description": " Given a topological ring `\u03b1` equipped with a uniform structure that makes subtraction uniformly\ncontinuous, get an equivalence between the separated quotient of `\u03b1` and the quotient ring\ncorresponding to the closure of zero.", "p": "mathlib"}, {"name": "uniform_space.completion.continuous_mul", "description": "", "p": "mathlib"}, {"name": "uniform_space.comm_ring", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.comm_ring", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.ring", "description": "", "p": "mathlib"}, {"name": "uniform_space.topological_ring", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.map_ring_hom", "description": "The completion map as a ring morphism.", "p": "mathlib"}, {"name": "uniform_space.completion.coe_mul", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.algebra'", "description": "A shortcut instance for the common case", "p": "mathlib"}, {"name": "uniform_space.completion.continuous_coe_ring_hom", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.continuous.mul", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.map_smul_eq_mul_coe", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.has_mul", "description": "", "p": "mathlib"}, {"name": "uniform_space.ring_sep_rel", "description": "", "p": "mathlib"}, {"name": "small_of_fintype", "description": "", "p": "mathlib"}, {"name": "sq_add_sq_mul", "description": " The set of sums of two squares is closed under multiplication in any commutative ring.\nSee also `sq_add_sq_mul_sq_add_sq`.", "p": "mathlib"}, {"name": "zmod.is_square_neg_one_of_dvd", "description": "If `-1` is a square modulo `n` and `m` divides `n`, then `-1` is also a square modulo `m`.", "p": "mathlib"}, {"name": "nat.prime.mod_four_ne_three_of_dvd_is_square_neg_one", "description": "If a prime `p` divides `n` such that `-1` is a square modulo `n`, then `p % 4 \u2260 3`.", "p": "mathlib"}, {"name": "zmod.is_square_neg_one_mul", "description": " If `-1` is a square modulo coprime natural numbers `m` and `n`, then `-1` is also\na square modulo `m*n`.", "p": "mathlib"}, {"name": "zmod.is_square_neg_one_iff", "description": " If `n` is a squarefree natural number, then `-1` is a square modulo `n` if and only if\n`n` is not divisible by a prime `q` such that `q % 4 = 3`.", "p": "mathlib"}, {"name": "zmod.is_square_neg_one_of_eq_sq_add_sq_of_coprime", "description": " If the natural number `n` is a sum of two squares of coprime natural numbers, then\n`-1` is a square modulo `n`.", "p": "mathlib"}, {"name": "nat.eq_sq_add_sq_iff_eq_sq_mul", "description": " A natural number `n` is a sum of two squares if and only if `n = a^2 * b` with natural\nnumbers `a` and `b` such that `-1` is a square modulo `b`.", "p": "mathlib"}, {"name": "nat.sq_add_sq_mul", "description": "The set of natural numbers that are sums of two squares is closed under multiplication.", "p": "mathlib"}, {"name": "nat.eq_sq_add_sq_iff", "description": " A (positive) natural number `n` is a sum of two squares if and only if the exponent of\nevery prime `q` such that `q % 4 = 3` in the prime factorization of `n` is even.\n(The assumption `0 < n` is not present, since for `n = 0`, both sides are satisfied;\nthe right hand side holds, since `padic_val_nat q 0 = 0` by definition.)", "p": "mathlib"}, {"name": "zmod.is_square_neg_one_iff'", "description": " If `n` is a squarefree natural number, then `-1` is a square modulo `n` if and only if\n`n` has no divisor `q` that is `\u2261 3 mod 4`.", "p": "mathlib"}, {"name": "nat.prime.sq_add_sq", "description": " **Fermat's theorem on the sum of two squares**. Every prime not congruent to 3 mod 4 is the sum\nof two squares. Also known as **Fermat's Christmas theorem**.", "p": "mathlib"}, {"name": "nat.eq_sq_add_sq_of_is_square_mod_neg_one", "description": "If `-1` is a square modulo the natural number `n`, then `n` is a sum of two squares.", "p": "mathlib"}, {"name": "zmod.is_square_neg_one_of_eq_sq_add_sq_of_is_coprime", "description": " If the integer `n` is a sum of two squares of coprime integers,\nthen `-1` is a square modulo `n`.", "p": "mathlib"}, {"name": "ideal.is_homogeneous.radical", "description": "", "p": "mathlib"}, {"name": "ideal.is_homogeneous.is_prime_iff", "description": "", "p": "mathlib"}, {"name": "ideal.is_homogeneous.is_prime_of_homogeneous_mem_or_mem", "description": "", "p": "mathlib"}, {"name": "homogeneous_ideal.radical", "description": "The radical of a homogenous ideal, as another homogenous ideal.", "p": "mathlib"}, {"name": "ideal.is_prime.homogeneous_core", "description": "", "p": "mathlib"}, {"name": "ideal.is_homogeneous.radical_eq", "description": "", "p": "mathlib"}, {"name": "homogeneous_ideal.coe_radical", "description": "", "p": "mathlib"}, {"name": "uniform_convex_space", "description": " A *uniformly convex space* is a real normed space where the triangle inequality is strict with a\nuniform bound. Namely, over the `x` and `y` of norm `1`, `\u2016x + y\u2016` is uniformly bounded above\nby a constant `< 2` when `\u2016x - y\u2016` is uniformly bounded below by a positive constant.\n\nSee also `uniform_convex_space.of_uniform_convex_closed_unit_ball`.", "p": "mathlib"}, {"name": "uniform_convex_space.uniform_convex", "description": " A *uniformly convex space* is a real normed space where the triangle inequality is strict with a\nuniform bound. Namely, over the `x` and `y` of norm `1`, `\u2016x + y\u2016` is uniformly bounded above\nby a constant `< 2` when `\u2016x - y\u2016` is uniformly bounded below by a positive constant.\n\nSee also `uniform_convex_space.of_uniform_convex_closed_unit_ball`.", "p": "mathlib"}, {"name": "exists_forall_sphere_dist_add_le_two_sub", "description": "", "p": "mathlib"}, {"name": "exists_forall_closed_ball_dist_add_le_two_mul_sub", "description": "", "p": "mathlib"}, {"name": "uniform_convex_space.to_strict_convex_space", "description": "", "p": "mathlib"}, {"name": "exists_forall_closed_ball_dist_add_le_two_sub", "description": "", "p": "mathlib"}, {"name": "representation.as_module", "description": "If `\u03c1 : representation k G V`, then `\u03c1.as_module` is a type synonym for `V`,\nwhich we equip with an instance `module (monoid_algebra k G) \u03c1.as_module`.\n\nYou should use `as_module_equiv : \u03c1.as_module \u2243+ V` to translate terms.", "p": "mathlib"}, {"name": "representation.as_algebra_hom_of", "description": "", "p": "mathlib"}, {"name": "representation.of_module'", "description": "Build a `representation k G M` from a `[module (monoid_algebra k G) M]`.\n\nThis version is not always what we want, as it relies on an existing `[module k M]`\ninstance, along with a `[is_scalar_tower k (monoid_algebra k G) M]` instance.\n\nWe remedy this below in `of_module`\n(with the tradeoff that the representation is defined\nonly on a type synonym of the original module.)", "p": "mathlib"}, {"name": "representation.as_module.inhabited", "description": "", "p": "mathlib"}, {"name": "representation.trivial", "description": "The trivial representation of `G` on a `k`-module V.", "p": "mathlib"}, {"name": "representation.tprod_apply", "description": "", "p": "mathlib"}, {"name": "representation", "description": "A representation of `G` on the `k`-module `V` is an homomorphism `G \u2192* (V \u2192\u2097[k] V)`.", "p": "mathlib"}, {"name": "representation.of_mul_action", "description": "A `G`-action on `H` induces a representation `G \u2192* End(k[H])` in the natural way.", "p": "mathlib"}, {"name": "representation.as_algebra_hom_single", "description": "", "p": "mathlib"}, {"name": "representation.as_module.add_comm_group", "description": "", "p": "mathlib"}, {"name": "representation.as_module_equiv_map_smul", "description": "", "p": "mathlib"}, {"name": "representation.as_algebra_hom_def", "description": "", "p": "mathlib"}, {"name": "representation.dual", "description": "The dual of a representation `\u03c1` of `G` on a module `V`, given by `(dual \u03c1) g f = f \u2218\u2097 (\u03c1 g\u207b\u00b9)`,\nwhere `f : module.dual k V`.", "p": "mathlib"}, {"name": "representation.as_algebra_hom", "description": "A `k`-linear representation of `G` on `V` can be thought of as\nan algebra map from `monoid_algebra k G` into the `k`-linear endomorphisms of `V`.", "p": "mathlib"}, {"name": "representation.smul_one_tprod_as_module", "description": "", "p": "mathlib"}, {"name": "representation.of_module_as_algebra_hom_apply_apply", "description": "", "p": "mathlib"}, {"name": "representation.of_mul_action_self_as_module_equiv_apply", "description": "", "p": "mathlib"}, {"name": "representation.of_mul_action_self_smul_eq_mul", "description": "", "p": "mathlib"}, {"name": "representation.smul_of_module_as_module", "description": "", "p": "mathlib"}, {"name": "representation.as_module.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "representation.of_module", "description": "Build a `representation` from a `[module (monoid_algebra k G) M]`.\n\nNote that the representation is built on `restrict_scalars k (monoid_algebra k G) M`,\nrather than on `M` itself.", "p": "mathlib"}, {"name": "representation.of_mul_action_single", "description": "", "p": "mathlib"}, {"name": "representation.as_module_module", "description": "A `k`-linear representation of `G` on `V` can be thought of as\na module over `monoid_algebra k G`.", "p": "mathlib"}, {"name": "representation.trivial_def", "description": "", "p": "mathlib"}, {"name": "representation.as_module.module", "description": "", "p": "mathlib"}, {"name": "representation.lin_hom", "description": "Given representations of `G` on `V` and `W`, there is a natural representation of `G` on the\nmodule `V \u2192\u2097[k] W`, where `G` acts by conjugation.", "p": "mathlib"}, {"name": "representation.as_module_equiv_symm_map_smul", "description": "", "p": "mathlib"}, {"name": "representation.as_module_equiv", "description": "The additive equivalence from the `module (monoid_algebra k G)` to the original vector space\nof the representative.\n\nThis is just the identity, but it is helpful for typechecking and keeping track of instances.", "p": "mathlib"}, {"name": "representation.of_mul_action_self_as_module_equiv", "description": " If we equip `k[G]` with the `k`-linear `G`-representation induced by the left regular action of\n`G` on itself, the resulting object is isomorphic as a `k[G]`-module to `k[G]` with its natural\n`k[G]`-module structure.", "p": "mathlib"}, {"name": "representation.as_group_hom_apply", "description": "", "p": "mathlib"}, {"name": "representation.of_mul_action_def", "description": "", "p": "mathlib"}, {"name": "representation.as_group_hom", "description": "When `G` is a group, a `k`-linear representation of `G` on `V` can be thought of as\na group homomorphism from `G` into the invertible `k`-linear endomorphisms of `V`.", "p": "mathlib"}, {"name": "representation.dual_apply", "description": "", "p": "mathlib"}, {"name": "representation.lin_hom_apply", "description": "", "p": "mathlib"}, {"name": "representation.of_module_as_module_act", "description": "", "p": "mathlib"}, {"name": "representation.of_mul_action_self_as_module_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "representation.dual_tensor_hom_comm", "description": "Given $k$-modules $V, W$, there is a homomorphism $\u03c6 : V^* \u2297 W \u2192 Hom_k(V, W)$\n(implemented by `linear_algebra.contraction.dual_tensor_hom`).\nGiven representations of $G$ on $V$ and $W$,there are representations of $G$ on  $V^* \u2297 W$ and on\n$Hom_k(V, W)$.\nThis lemma says that $\u03c6$ is $G$-linear.", "p": "mathlib"}, {"name": "representation.smul_tprod_one_as_module", "description": "", "p": "mathlib"}, {"name": "representation.of_mul_action_apply", "description": "", "p": "mathlib"}, {"name": "representation.as_module_equiv_symm_map_rho", "description": "", "p": "mathlib"}, {"name": "representation.tprod", "description": "Given representations of `G` on `V` and `W`, there is a natural representation of `G` on their\ntensor product `V \u2297[k] W`.", "p": "mathlib"}, {"name": "representation.as_algebra_hom_single_one", "description": "", "p": "mathlib"}, {"name": "sigma.card_Icc", "description": "", "p": "mathlib"}, {"name": "sigma.locally_finite_order", "description": "", "p": "mathlib"}, {"name": "sigma.card_Ioo", "description": "", "p": "mathlib"}, {"name": "sigma.Icc_mk_mk", "description": "", "p": "mathlib"}, {"name": "sigma.card_Ioc", "description": "", "p": "mathlib"}, {"name": "sigma.Ico_mk_mk", "description": "", "p": "mathlib"}, {"name": "sigma.Ioo_mk_mk", "description": "", "p": "mathlib"}, {"name": "sigma.card_Ico", "description": "", "p": "mathlib"}, {"name": "sigma.Ioc_mk_mk", "description": "", "p": "mathlib"}, {"name": "counterexample.units_int.one_ne_neg_one", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.with_sign", "description": "Submodules of positive and negative integers, keyed by sign.", "p": "mathlib-counterexamples"}, {"name": "counterexample.mem_with_sign_one", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.with_sign.supr", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.with_sign.is_compl", "description": "The two submodules are complements.", "p": "mathlib-counterexamples"}, {"name": "counterexample.with_sign.not_injective", "description": "But there is no embedding into `\u2124` from the direct sum.", "p": "mathlib-counterexamples"}, {"name": "counterexample.with_sign.independent", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.mem_with_sign_neg_one", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.with_sign.not_internal", "description": "And so they do not represent an internal direct sum.", "p": "mathlib-counterexamples"}, {"name": "complex.same_ray_iff_arg_div_eq_zero", "description": "", "p": "mathlib"}, {"name": "complex.same_ray_of_arg_eq", "description": "", "p": "mathlib"}, {"name": "complex.abs_sub_eq", "description": "", "p": "mathlib"}, {"name": "complex.abs_add_eq_iff", "description": "", "p": "mathlib"}, {"name": "complex.abs_add_eq", "description": "", "p": "mathlib"}, {"name": "complex.same_ray_iff", "description": "", "p": "mathlib"}, {"name": "complex.abs_sub_eq_iff", "description": "", "p": "mathlib"}, {"name": "tactic.explode.core", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entries.inhabited", "description": "", "p": "mathlib"}, {"name": "tactic.explode.args", "description": "", "p": "mathlib"}, {"name": "tactic.explode.status", "description": "", "p": "mathlib"}, {"name": "tactic.explode.status.reg", "description": "", "p": "mathlib"}, {"name": "tactic.explode.status.intro", "description": "", "p": "mathlib"}, {"name": "tactic.explode.status.lam", "description": "", "p": "mathlib"}, {"name": "tactic.explode.status.sintro", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entries.size", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entries.has_to_tactic_format", "description": "", "p": "mathlib"}, {"name": "tactic.explode.append_dep", "description": "", "p": "mathlib"}, {"name": "tactic.explode.thm", "description": "A type to distinguish introduction or elimination rules represented as\nstrings from theorems referred to by their names.", "p": "mathlib"}, {"name": "tactic.explode.thm.expr", "description": "A type to distinguish introduction or elimination rules represented as\nstrings from theorems referred to by their names.", "p": "mathlib"}, {"name": "tactic.explode.thm.name", "description": "A type to distinguish introduction or elimination rules represented as\nstrings from theorems referred to by their names.", "p": "mathlib"}, {"name": "tactic.explode.thm.string", "description": "A type to distinguish introduction or elimination rules represented as\nstrings from theorems referred to by their names.", "p": "mathlib"}, {"name": "tactic.explode.may_be_proof", "description": "", "p": "mathlib"}, {"name": "tactic.explode", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entries.head", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entries.find", "description": "", "p": "mathlib"}, {"name": "tactic_doc.command.#explode / #explode_widget", "description": "`#explode decl_name` displays a proof term in a line-by-line format somewhat akin to a Fitch-style\nproof or the Metamath proof style.\n`#explode_widget decl_name` renders a widget that displays an `#explode` proof.\n\n`#explode iff_true_intro` produces\n\n```lean\niff_true_intro : \u2200 {a : Prop}, a \u2192 (a \u2194 true)\n0\u2502   \u2502 a         \u251c Prop\n1\u2502   \u2502 h         \u251c a\n2\u2502   \u2502 hl        \u2502 \u250c a\n3\u2502   \u2502 trivial   \u2502 \u2502 true\n4\u25022,3\u2502 \u2200I        \u2502 a \u2192 true\n5\u2502   \u2502 hr        \u2502 \u250c true\n6\u25025,1\u2502 \u2200I        \u2502 true \u2192 a\n7\u25024,6\u2502 iff.intro \u2502 a \u2194 true\n8\u25021,7\u2502 \u2200I        \u2502 a \u2192 (a \u2194 true)\n9\u25020,8\u2502 \u2200I        \u2502 \u2200 {a : Prop}, a \u2192 (a \u2194 true)\n```\n\nIn more detail:\n\nThe output of `#explode` is a Fitch-style proof in a four-column diagram modeled after Metamath\nproof displays like [this](http://us.metamath.org/mpeuni/ru.html). The headers of the columns are\n\"Step\", \"Hyp\", \"Ref\", \"Type\" (or \"Expression\" in the case of Metamath):\n* Step: An increasing sequence of numbers to number each step in the proof, used in the Hyp field.\n* Hyp: The direct children of the current step. Most theorems are implications like `A -> B -> C`,\n  and so on the step proving `C` the Hyp field will refer to the steps that prove `A` and `B`.\n* Ref: The name of the theorem being applied. This is well-defined in Metamath, but in Lean there\n  are some special steps that may have long names because the structure of proof terms doesn't\n  exactly match this mold.\n  * If the theorem is `foo (x y : Z) : A x -> B y -> C x y`:\n    * the Ref field will contain `foo`,\n    * `x` and `y` will be suppressed, because term construction is not interesting, and\n    * the Hyp field will reference steps proving `A x` and `B y`. This corresponds to a proof term\n      like `@foo x y pA pB` where `pA` and `pB` are subproofs.\n  * If the head of the proof term is a local constant or lambda, then in this case the Ref will\n    say `\u2200E` for forall-elimination. This happens when you have for example `h : A -> B` and\n    `ha : A` and prove `b` by `h ha`; we reinterpret this as if it said `\u2200E h ha` where `\u2200E` is\n    (n-ary) modus ponens.\n  * If the proof term is a lambda, we will also use `\u2200I` for forall-introduction, referencing the\n    body of the lambda. The indentation level will increase, and a bracket will surround the proof\n    of the body of the lambda, starting at a proof step labeled with the name of the lambda variable\n    and its type, and ending with the `\u2200I` step. Metamath doesn't have steps like this, but the\n    style is based on Fitch proofs in first-order logic.\n* Type: This contains the type of the proof term, the theorem being proven at the current step.\n  This proof layout differs from `#print` in using lots of intermediate step displays so that you\n  can follow along and don't have to see term construction steps because they are implicitly in the\n  intermediate step displays.\n\nAlso, it is common for a Lean theorem to begin with a sequence of lambdas introducing local\nconstants of the theorem. In order to minimize the indentation level, the `\u2200I` steps at the end of\nthe proof will be introduced in a group and the indentation will stay fixed. (The indentation\nbrackets are only needed in order to delimit the scope of assumptions, and these assumptions\nhave global scope anyway so detailed tracking is not necessary.)", "p": "mathlib"}, {"name": "tactic.explode.pad_right", "description": "", "p": "mathlib"}, {"name": "tactic.explode_expr", "description": "", "p": "mathlib"}, {"name": "tactic.explode.thm.to_string", "description": "Turn a thm into a string.", "p": "mathlib"}, {"name": "tactic.explode.format_aux", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entry", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entry.expr", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entry.line", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entry.depth", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entry.status", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entry.thm", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entry.deps", "description": "", "p": "mathlib"}, {"name": "tactic.explode.status.inhabited", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entries", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entries.s", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entries.l", "description": "", "p": "mathlib"}, {"name": "tactic.explode.entries.add", "description": "", "p": "mathlib"}, {"name": "tactic.explode_cmd", "description": "`#explode decl_name` displays a proof term in a line-by-line format somewhat akin to a Fitch-style\nproof or the Metamath proof style.\n`#explode_widget decl_name` renders a widget that displays an `#explode` proof.\n\n`#explode iff_true_intro` produces\n\n```lean\niff_true_intro : \u2200 {a : Prop}, a \u2192 (a \u2194 true)\n0\u2502   \u2502 a         \u251c Prop\n1\u2502   \u2502 h         \u251c a\n2\u2502   \u2502 hl        \u2502 \u250c a\n3\u2502   \u2502 trivial   \u2502 \u2502 true\n4\u25022,3\u2502 \u2200I        \u2502 a \u2192 true\n5\u2502   \u2502 hr        \u2502 \u250c true\n6\u25025,1\u2502 \u2200I        \u2502 true \u2192 a\n7\u25024,6\u2502 iff.intro \u2502 a \u2194 true\n8\u25021,7\u2502 \u2200I        \u2502 a \u2192 (a \u2194 true)\n9\u25020,8\u2502 \u2200I        \u2502 \u2200 {a : Prop}, a \u2192 (a \u2194 true)\n```\n\nIn more detail:\n\nThe output of `#explode` is a Fitch-style proof in a four-column diagram modeled after Metamath\nproof displays like [this](http://us.metamath.org/mpeuni/ru.html). The headers of the columns are\n\"Step\", \"Hyp\", \"Ref\", \"Type\" (or \"Expression\" in the case of Metamath):\n* Step: An increasing sequence of numbers to number each step in the proof, used in the Hyp field.\n* Hyp: The direct children of the current step. Most theorems are implications like `A -> B -> C`,\n  and so on the step proving `C` the Hyp field will refer to the steps that prove `A` and `B`.\n* Ref: The name of the theorem being applied. This is well-defined in Metamath, but in Lean there\n  are some special steps that may have long names because the structure of proof terms doesn't\n  exactly match this mold.\n  * If the theorem is `foo (x y : Z) : A x -> B y -> C x y`:\n    * the Ref field will contain `foo`,\n    * `x` and `y` will be suppressed, because term construction is not interesting, and\n    * the Hyp field will reference steps proving `A x` and `B y`. This corresponds to a proof term\n      like `@foo x y pA pB` where `pA` and `pB` are subproofs.\n  * If the head of the proof term is a local constant or lambda, then in this case the Ref will\n    say `\u2200E` for forall-elimination. This happens when you have for example `h : A -> B` and\n    `ha : A` and prove `b` by `h ha`; we reinterpret this as if it said `\u2200E h ha` where `\u2200E` is\n    (n-ary) modus ponens.\n  * If the proof term is a lambda, we will also use `\u2200I` for forall-introduction, referencing the\n    body of the lambda. The indentation level will increase, and a bracket will surround the proof\n    of the body of the lambda, starting at a proof step labeled with the name of the lambda variable\n    and its type, and ending with the `\u2200I` step. Metamath doesn't have steps like this, but the\n    style is based on Fitch proofs in first-order logic.\n* Type: This contains the type of the proof term, the theorem being proven at the current step.\n  This proof layout differs from `#print` in using lots of intermediate step displays so that you\n  can follow along and don't have to see term construction steps because they are implicitly in the\n  intermediate step displays.\n\nAlso, it is common for a Lean theorem to begin with a sequence of lambdas introducing local\nconstants of the theorem. In order to minimize the indentation level, the `\u2200I` steps at the end of\nthe proof will be introduced in a group and the indentation will stay fixed. (The indentation\nbrackets are only needed in order to delimit the scope of assumptions, and these assumptions\nhave global scope anyway so detailed tracking is not necessary.)", "p": "mathlib"}, {"name": "CommRing.filtered_colimits.colimit", "description": "The bundled commutative ring giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "Ring.filtered_colimits.colimit", "description": "The bundled ring giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "CommSemiRing.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "SemiRing.filtered_colimits.semiring_obj", "description": "", "p": "mathlib"}, {"name": "Ring.filtered_colimits.R", "description": "The colimit of `F \u22d9 forget\u2082 Ring SemiRing` in the category `SemiRing`.\nIn the following, we will show that this has the structure of a ring.", "p": "mathlib"}, {"name": "CommRing.filtered_colimits.R", "description": "The colimit of `F \u22d9 forget\u2082 CommRing Ring` in the category `Ring`.\nIn the following, we will show that this has the structure of a _commutative_ ring.", "p": "mathlib"}, {"name": "CommSemiRing.filtered_colimits.forget\u2082_SemiRing_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "CommSemiRing.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit commutative semiring.", "p": "mathlib"}, {"name": "Ring.filtered_colimits.colimit_ring", "description": "", "p": "mathlib"}, {"name": "Ring.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "CommRing.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "SemiRing.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit semiring.", "p": "mathlib"}, {"name": "SemiRing.filtered_colimits.R", "description": "The colimit of `F \u22d9 forget\u2082 SemiRing Mon` in the category `Mon`.\nIn the following, we will show that this has the structure of a semiring.", "p": "mathlib"}, {"name": "CommRing.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `CommRing`.", "p": "mathlib"}, {"name": "CommSemiRing.filtered_colimits.colimit", "description": "The bundled commutative semiring giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "SemiRing.filtered_colimits.colimit", "description": "The bundled semiring giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "CommRing.filtered_colimits.forget\u2082_Ring_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "CommSemiRing.filtered_colimits.colimit_comm_semiring", "description": "", "p": "mathlib"}, {"name": "CommRing.filtered_colimits.colimit_comm_ring", "description": "", "p": "mathlib"}, {"name": "Ring.filtered_colimits.forget\u2082_SemiRing_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "CommSemiRing.filtered_colimits.R", "description": "The colimit of `F \u22d9 forget\u2082 CommSemiRing SemiRing` in the category `SemiRing`.\nIn the following, we will show that this has the structure of a _commutative_ semiring.", "p": "mathlib"}, {"name": "SemiRing.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "CommSemiRing.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `CommSemiRing`.", "p": "mathlib"}, {"name": "SemiRing.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `SemiRing`.", "p": "mathlib"}, {"name": "Ring.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit ring.", "p": "mathlib"}, {"name": "SemiRing.filtered_colimits.forget\u2082_Mon_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "SemiRing.filtered_colimits.colimit_semiring", "description": "", "p": "mathlib"}, {"name": "Ring.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `Ring`.", "p": "mathlib"}, {"name": "CommRing.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit commutative ring.", "p": "mathlib"}, {"name": "prev_d", "description": " The composition of `f j j' \u226b D.d j' j` if there is some `j'` coming before `j`,\nand `0` otherwise.", "p": "mathlib"}, {"name": "d_next_nat", "description": "", "p": "mathlib"}, {"name": "homotopy.mk_inductive_aux\u2083", "description": "", "p": "mathlib"}, {"name": "homotopy.symm_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map_f_eq_zero", "description": "", "p": "mathlib"}, {"name": "homotopy.comp_left", "description": "homotopy is closed under composition (on the left)", "p": "mathlib"}, {"name": "category_theory.functor.map_homotopy_equiv", "description": "An additive functor preserves homotopy equivalences.", "p": "mathlib"}, {"name": "category_theory.functor.map_homotopy_equiv_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.d_next_cochain_complex", "description": "", "p": "mathlib"}, {"name": "homotopy_equiv.trans", "description": "Homotopy equivalence is a transitive relation.", "p": "mathlib"}, {"name": "homotopy_equiv.refl", "description": "Any complex is homotopy equivalent to itself.", "p": "mathlib"}, {"name": "homotopy.comp_right_id_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map'_f_of_not_rel_right", "description": "", "p": "mathlib"}, {"name": "d_next_comp_left", "description": "", "p": "mathlib"}, {"name": "homotopy.null_homotopy_hom", "description": "", "p": "mathlib"}, {"name": "prev_d_nat", "description": "", "p": "mathlib"}, {"name": "homology_map_eq_of_homotopy", "description": "Homotopic maps induce the same map on homology.", "p": "mathlib"}, {"name": "homotopy_equiv.of_iso", "description": "An isomorphism of complexes induces a homotopy equivalence.", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map_f", "description": "", "p": "mathlib"}, {"name": "homotopy.mk_inductive_aux\u2082", "description": "An auxiliary construction for `mk_inductive`.", "p": "mathlib"}, {"name": "homotopy.mk_coinductive_aux\u2083", "description": "", "p": "mathlib"}, {"name": "d_next", "description": " The composition of `C.d i i' \u226b f i' i` if there is some `i'` coming after `i`,\nand `0` otherwise.", "p": "mathlib"}, {"name": "homotopy.prev_d_chain_complex", "description": "", "p": "mathlib"}, {"name": "homotopy.add", "description": "the sum of two homotopies is a homotopy between the sum of the respective morphisms.", "p": "mathlib"}, {"name": "homotopy.prev_d_succ_cochain_complex", "description": "", "p": "mathlib"}, {"name": "homotopy.null_homotopy'_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.comp_left_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.equiv_sub_zero", "description": "`f` is homotopic to `g` iff `f - g` is homotopic to `0`.", "p": "mathlib"}, {"name": "homotopy.symm", "description": "`f` is homotopic to `g` iff `g` is homotopic to `f`.", "p": "mathlib"}, {"name": "homotopy.comp_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.mk_inductive", "description": "A constructor for a `homotopy e 0`, for `e` a chain map between `\u2115`-indexed chain complexes,\nworking by induction.\n\nYou need to provide the components of the homotopy in degrees 0 and 1,\nshow that these satisfy the homotopy condition,\nand then give a construction of each component,\nand the fact that it satisfies the homotopy condition,\nusing as an inductive hypothesis the data and homotopy condition for the previous two components.", "p": "mathlib"}, {"name": "d_next_comp_right", "description": "", "p": "mathlib"}, {"name": "homotopy.mk_coinductive", "description": "A constructor for a `homotopy e 0`, for `e` a chain map between `\u2115`-indexed cochain complexes,\nworking by induction.\n\nYou need to provide the components of the homotopy in degrees 0 and 1,\nshow that these satisfy the homotopy condition,\nand then give a construction of each component,\nand the fact that it satisfies the homotopy condition,\nusing as an inductive hypothesis the data and homotopy condition for the previous two components.", "p": "mathlib"}, {"name": "homotopy.comp_right_id", "description": "a variant of `homotopy.comp_right` useful for dealing with homotopy equivalences.", "p": "mathlib"}, {"name": "homotopy.trans", "description": "homotopy is a transitive relation.", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map_f_of_not_rel_right", "description": "", "p": "mathlib"}, {"name": "d_next_eq_d_from_from_next", "description": "", "p": "mathlib"}, {"name": "homotopy.mk_inductive_aux\u2081", "description": "An auxiliary construction for `mk_inductive`.\n\nHere we build by induction a family of diagrams,\nbut don't require at the type level that these successive diagrams actually agree.\nThey do in fact agree, and we then capture that at the type level (i.e. by constructing a homotopy)\nin `mk_inductive`.\n\nAt this stage, we don't check the homotopy condition in degree 0,\nbecause it \"falls off the end\", and is easier to treat using `X_next` and `X_prev`,\nwhich we do in `mk_inductive_aux\u2082`.", "p": "mathlib"}, {"name": "homotopy.of_eq_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.of_eq", "description": "Equal chain maps are homotopic.", "p": "mathlib"}, {"name": "prev_d_comp_left", "description": "", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map'_f", "description": "", "p": "mathlib"}, {"name": "homotopy.comp_right_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map_f_of_not_rel_left", "description": "", "p": "mathlib"}, {"name": "homotopy.add_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.ext_iff", "description": "", "p": "mathlib"}, {"name": "homotopy.comp_right", "description": "homotopy is closed under composition (on the right)", "p": "mathlib"}, {"name": "homotopy.refl_hom", "description": "", "p": "mathlib"}, {"name": "d_next_eq", "description": "", "p": "mathlib"}, {"name": "homotopy.prev_d_zero_cochain_complex", "description": "", "p": "mathlib"}, {"name": "homotopy.zero", "description": "", "p": "mathlib"}, {"name": "homotopy.trans_hom", "description": "", "p": "mathlib"}, {"name": "homotopy", "description": "A homotopy `h` between chain maps `f` and `g` consists of components `h i j : C.X i \u27f6 D.X j`\nwhich are zero unless `c.rel j i`, satisfying the homotopy condition.", "p": "mathlib"}, {"name": "homotopy.hom", "description": "A homotopy `h` between chain maps `f` and `g` consists of components `h i j : C.X i \u27f6 D.X j`\nwhich are zero unless `c.rel j i`, satisfying the homotopy condition.", "p": "mathlib"}, {"name": "homotopy.zero'", "description": "A homotopy `h` between chain maps `f` and `g` consists of components `h i j : C.X i \u27f6 D.X j`\nwhich are zero unless `c.rel j i`, satisfying the homotopy condition.", "p": "mathlib"}, {"name": "homotopy.comm", "description": "A homotopy `h` between chain maps `f` and `g` consists of components `h i j : C.X i \u27f6 D.X j`\nwhich are zero unless `c.rel j i`, satisfying the homotopy condition.", "p": "mathlib"}, {"name": "homotopy_equiv.inhabited", "description": "", "p": "mathlib"}, {"name": "homotopy.ext", "description": "", "p": "mathlib"}, {"name": "homotopy.d_next_zero_chain_complex", "description": "", "p": "mathlib"}, {"name": "homotopy.refl", "description": "Every chain map is homotopic to itself.", "p": "mathlib"}, {"name": "category_theory.functor.map_homotopy_hom", "description": "", "p": "mathlib"}, {"name": "homotopy.map_null_homotopic_map", "description": "Compatibility of `null_homotopic_map` with the application of additive functors", "p": "mathlib"}, {"name": "from_next", "description": " `f i' i` if `i'` comes after `i`, and 0 if there's no such `i'`.\nHopefully there won't be much need for this, except in `d_next_eq_d_from_from_next`\nto see that `d_next` factors through `C.d_from i`.", "p": "mathlib"}, {"name": "homotopy.comp_null_homotopic_map", "description": " Compatibility of `null_homotopic_map` with the precomposition by a morphism\nof complexes.", "p": "mathlib"}, {"name": "homotopy.comp_left_id", "description": "a variant of `homotopy.comp_left` useful for dealing with homotopy equivalences.", "p": "mathlib"}, {"name": "homology_obj_iso_of_homotopy_equiv", "description": "Homotopy equivalent complexes have isomorphic homologies.", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map'_f_of_not_rel_left", "description": "", "p": "mathlib"}, {"name": "prev_d_eq", "description": "", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map", "description": " The null homotopic map associated to a family `hom` of morphisms `C_i \u27f6 D_j`.\nThis is the same datum as for the field `hom` in the structure `homotopy`. For\nthis definition, we do not need the field `zero` of that structure\nas this definition uses only the maps `C_i \u27f6 C_j` when `c.rel j i`.", "p": "mathlib"}, {"name": "category_theory.functor.map_homotopy_equiv_homotopy_hom_inv_id", "description": "", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map'", "description": " Variant of `null_homotopic_map` where the input consists only of the\nrelevant maps `C_i \u27f6 D_j` such that `c.rel j i`.", "p": "mathlib"}, {"name": "category_theory.functor.map_homotopy_equiv_inv", "description": "", "p": "mathlib"}, {"name": "homotopy.null_homotopy", "description": " Tautological construction of the `homotopy` to zero for maps constructed by\n`null_homotopic_map`, at least when we have the `zero'` condition.", "p": "mathlib"}, {"name": "homotopy.null_homotopy'", "description": "Homotopy to zero for maps constructed with `null_homotopic_map'`", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map_comp", "description": " Compatibility of `null_homotopic_map` with the postcomposition by a morphism\nof complexes.", "p": "mathlib"}, {"name": "homotopy.mk_coinductive_aux\u2082", "description": "An auxiliary construction for `mk_inductive`.", "p": "mathlib"}, {"name": "category_theory.functor.map_homotopy", "description": "An additive functor takes homotopies to homotopies.", "p": "mathlib"}, {"name": "homotopy_equiv.symm", "description": "Being homotopy equivalent is a symmetric relation.", "p": "mathlib"}, {"name": "to_prev", "description": " `f j j'` if `j'` comes after `j`, and 0 if there's no such `j'`.\nHopefully there won't be much need for this, except in `d_next_eq_d_from_from_next`\nto see that `d_next` factors through `C.d_from i`.", "p": "mathlib"}, {"name": "homotopy.map_null_homotopic_map'", "description": "Compatibility of `null_homotopic_map'` with the application of additive functors", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map'_f_eq_zero", "description": "", "p": "mathlib"}, {"name": "homotopy.mk_coinductive_aux\u2081", "description": "An auxiliary construction for `mk_coinductive`.\n\nHere we build by induction a family of diagrams,\nbut don't require at the type level that these successive diagrams actually agree.\nThey do in fact agree, and we then capture that at the type level (i.e. by constructing a homotopy)\nin `mk_coinductive`.\n\nAt this stage, we don't check the homotopy condition in degree 0,\nbecause it \"falls off the end\", and is easier to treat using `X_next` and `X_prev`,\nwhich we do in `mk_inductive_aux\u2082`.", "p": "mathlib"}, {"name": "prev_d_comp_right", "description": "", "p": "mathlib"}, {"name": "homotopy.comp_null_homotopic_map'", "description": " Compatibility of `null_homotopic_map'` with the precomposition by a morphism\nof complexes.", "p": "mathlib"}, {"name": "homotopy_equiv", "description": "A homotopy equivalence between two chain complexes consists of a chain map each way,\nand homotopies from the compositions to the identity chain maps.\n\nNote that this contains data;\narguably it might be more useful for many applications if we truncated it to a Prop.", "p": "mathlib"}, {"name": "homotopy_equiv.hom", "description": "A homotopy equivalence between two chain complexes consists of a chain map each way,\nand homotopies from the compositions to the identity chain maps.\n\nNote that this contains data;\narguably it might be more useful for many applications if we truncated it to a Prop.", "p": "mathlib"}, {"name": "homotopy_equiv.inv", "description": "A homotopy equivalence between two chain complexes consists of a chain map each way,\nand homotopies from the compositions to the identity chain maps.\n\nNote that this contains data;\narguably it might be more useful for many applications if we truncated it to a Prop.", "p": "mathlib"}, {"name": "homotopy_equiv.homotopy_hom_inv_id", "description": "A homotopy equivalence between two chain complexes consists of a chain map each way,\nand homotopies from the compositions to the identity chain maps.\n\nNote that this contains data;\narguably it might be more useful for many applications if we truncated it to a Prop.", "p": "mathlib"}, {"name": "homotopy_equiv.homotopy_inv_hom_id", "description": "A homotopy equivalence between two chain complexes consists of a chain map each way,\nand homotopies from the compositions to the identity chain maps.\n\nNote that this contains data;\narguably it might be more useful for many applications if we truncated it to a Prop.", "p": "mathlib"}, {"name": "homotopy.null_homotopic_map'_comp", "description": " Compatibility of `null_homotopic_map'` with the postcomposition by a morphism\nof complexes.", "p": "mathlib"}, {"name": "homotopy.comp_left_id_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_homotopy_equiv_homotopy_inv_hom_id", "description": "", "p": "mathlib"}, {"name": "homotopy.d_next_succ_chain_complex", "description": "", "p": "mathlib"}, {"name": "prev_d_eq_to_prev_d_to", "description": "", "p": "mathlib"}, {"name": "homotopy.comp", "description": "homotopy is closed under composition", "p": "mathlib"}, {"name": "sum.Ico_inr_inl", "description": "", "p": "mathlib"}, {"name": "sum.Icc_inl_inl", "description": "", "p": "mathlib"}, {"name": "finset.inr_mem_sum_lex_lift", "description": "", "p": "mathlib"}, {"name": "finset.inl_mem_sum_lex_lift", "description": "", "p": "mathlib"}, {"name": "sum.Ioc_inr_inl", "description": "", "p": "mathlib"}, {"name": "finset.sum_lex_lift_inl_inl", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ioc_inl_inr", "description": "", "p": "mathlib"}, {"name": "sum.lex.locally_finite_order", "description": "", "p": "mathlib"}, {"name": "sum.Ioc_inr_inr", "description": "", "p": "mathlib"}, {"name": "sum.Icc_inl_inr", "description": "", "p": "mathlib"}, {"name": "finset.inl_mem_sum_lift\u2082", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ico_inr_inl", "description": "", "p": "mathlib"}, {"name": "sum.lex.Icc_inr_inl", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ico_inr_inr", "description": "", "p": "mathlib"}, {"name": "sum.locally_finite_order", "description": "", "p": "mathlib"}, {"name": "finset.sum_lex_lift_eq_empty", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ioc_inr_inr", "description": "", "p": "mathlib"}, {"name": "finset.sum_lift\u2082_mono", "description": "", "p": "mathlib"}, {"name": "sum.Ico_inl_inl", "description": "", "p": "mathlib"}, {"name": "finset.sum_lex_lift_inr_inr", "description": "", "p": "mathlib"}, {"name": "finset.sum_lex_lift", "description": " Lifts maps `\u03b1\u2081 \u2192 \u03b2\u2081 \u2192 finset \u03b3\u2081`, `\u03b1\u2082 \u2192 \u03b2\u2082 \u2192 finset \u03b3\u2082`, `\u03b1\u2081 \u2192 \u03b2\u2082 \u2192 finset \u03b3\u2081`,\n`\u03b1\u2082 \u2192 \u03b2\u2082 \u2192 finset \u03b3\u2082`  to a map `\u03b1\u2081 \u2295 \u03b1\u2082 \u2192 \u03b2\u2081 \u2295 \u03b2\u2082 \u2192 finset (\u03b3\u2081 \u2295 \u03b3\u2082)`. Could be generalized to\nalternative monads if we can make sure to keep computability and universe polymorphism.", "p": "mathlib"}, {"name": "sum.Ioc_inl_inr", "description": "", "p": "mathlib"}, {"name": "finset.sum_lift\u2082", "description": " Lifts maps `\u03b1\u2081 \u2192 \u03b2\u2081 \u2192 finset \u03b3\u2081` and `\u03b1\u2082 \u2192 \u03b2\u2082 \u2192 finset \u03b3\u2082` to a map\n`\u03b1\u2081 \u2295 \u03b1\u2082 \u2192 \u03b2\u2081 \u2295 \u03b2\u2082 \u2192 finset (\u03b3\u2081 \u2295 \u03b3\u2082)`. Could be generalized to `alternative` functors if we can\nmake sure to keep computability and universe polymorphism.", "p": "mathlib"}, {"name": "sum.lex.Ioo_inr_inl", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ioc_inl_inl", "description": "", "p": "mathlib"}, {"name": "sum.lex.Icc_inl_inr", "description": "", "p": "mathlib"}, {"name": "sum.Icc_inr_inl", "description": "", "p": "mathlib"}, {"name": "sum.Ioc_inl_inl", "description": "", "p": "mathlib"}, {"name": "sum.lex.Icc_inr_inr", "description": "", "p": "mathlib"}, {"name": "sum.Ico_inl_inr", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ioo_inl_inr", "description": "", "p": "mathlib"}, {"name": "sum.Icc_inr_inr", "description": "", "p": "mathlib"}, {"name": "finset.mem_sum_lift\u2082", "description": "", "p": "mathlib"}, {"name": "finset.sum_lift\u2082_eq_empty", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ico_inl_inr", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ioo_inl_inl", "description": "", "p": "mathlib"}, {"name": "finset.sum_lex_lift_mono", "description": "", "p": "mathlib"}, {"name": "sum.Ico_inr_inr", "description": "", "p": "mathlib"}, {"name": "sum.Ioo_inr_inl", "description": "", "p": "mathlib"}, {"name": "sum.Ioo_inl_inl", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ioo_inr_inr", "description": "", "p": "mathlib"}, {"name": "finset.sum_lex_lift_inr_inl", "description": "", "p": "mathlib"}, {"name": "sum.Ioo_inr_inr", "description": "", "p": "mathlib"}, {"name": "finset.mem_sum_lex_lift", "description": "", "p": "mathlib"}, {"name": "sum.Ioo_inl_inr", "description": "", "p": "mathlib"}, {"name": "finset.sum_lift\u2082_nonempty", "description": "", "p": "mathlib"}, {"name": "finset.inr_mem_sum_lift\u2082", "description": "", "p": "mathlib"}, {"name": "finset.sum_lex_lift_nonempty", "description": "", "p": "mathlib"}, {"name": "finset.sum_lex_lift_inl_inr", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ico_inl_inl", "description": "", "p": "mathlib"}, {"name": "sum.lex.Icc_inl_inl", "description": "", "p": "mathlib"}, {"name": "sum.lex.Ioc_inr_inl", "description": "", "p": "mathlib"}, {"name": "projectivization.map_injective", "description": " Mapping with respect to a semilinear map over an isomorphism of fields yields\nan injective map on projective spaces.", "p": "mathlib"}, {"name": "projectivization_setoid", "description": "The setoid whose quotient is the projectivization of `V`.", "p": "mathlib"}, {"name": "projectivization.mk", "description": "Construct an element of the projectivization from a nonzero vector.", "p": "mathlib"}, {"name": "projectivization.mk'_eq_mk", "description": "", "p": "mathlib"}, {"name": "projectivization.exists_smul_eq_mk_rep", "description": "", "p": "mathlib"}, {"name": "projectivization.submodule", "description": "Consider an element of the projectivization as a submodule of `V`.", "p": "mathlib"}, {"name": "projectivization", "description": " The projectivization of the `K`-vector space `V`.\nThe notation `\u2119 K V` is preferred.", "p": "mathlib"}, {"name": "projectivization.ind", "description": " An induction principle for `projectivization`.\nUse as `induction v using projectivization.ind`.", "p": "mathlib"}, {"name": "projectivization.submodule_mk", "description": "", "p": "mathlib"}, {"name": "projectivization.map_comp", "description": "", "p": "mathlib"}, {"name": "projectivization.finrank_submodule", "description": "", "p": "mathlib"}, {"name": "projectivization.mk_eq_mk_iff'", "description": " Two nonzero vectors go to the same point in projective space if and only if one is\na scalar multiple of the other.", "p": "mathlib"}, {"name": "projectivization.nonempty", "description": "", "p": "mathlib"}, {"name": "projectivization.submodule.finite_dimensional", "description": "", "p": "mathlib"}, {"name": "projectivization.equiv_submodule", "description": " The equivalence between the projectivization and the\ncollection of subspaces of dimension 1.", "p": "mathlib"}, {"name": "projectivization.rep", "description": "Choose a representative of `v : projectivization K V` in `V`.", "p": "mathlib"}, {"name": "projectivization.rep_nonzero", "description": "", "p": "mathlib"}, {"name": "projectivization.mk''", "description": "Construct an element of the projectivization from a subspace of dimension 1.", "p": "mathlib"}, {"name": "projectivization.submodule_eq", "description": "", "p": "mathlib"}, {"name": "projectivization.map_id", "description": "", "p": "mathlib"}, {"name": "projectivization.mk'", "description": "A variant of `projectivization.mk` in terms of a subtype. `mk` is preferred.", "p": "mathlib"}, {"name": "projectivization.map", "description": "An injective semilinear map of vector spaces induces a map on projective spaces.", "p": "mathlib"}, {"name": "projectivization.mk_rep", "description": "", "p": "mathlib"}, {"name": "projectivization.submodule_injective", "description": "", "p": "mathlib"}, {"name": "projectivization.submodule_mk''", "description": "", "p": "mathlib"}, {"name": "projectivization.mk''_submodule", "description": "", "p": "mathlib"}, {"name": "projectivization.mk_eq_mk_iff", "description": "", "p": "mathlib"}, {"name": "nnreal.add_rpow_le_rpow_add", "description": "", "p": "mathlib"}, {"name": "ennreal.add_rpow_le_rpow_add", "description": "", "p": "mathlib"}, {"name": "real.pow_arith_mean_le_arith_mean_pow_of_even", "description": "", "p": "mathlib"}, {"name": "nnreal.rpow_add_le_add_rpow", "description": "", "p": "mathlib"}, {"name": "real.pow_sum_div_card_le_sum_pow", "description": "Specific case of Jensen's inequality for sums of powers", "p": "mathlib"}, {"name": "real.zpow_arith_mean_le_arith_mean_zpow", "description": "", "p": "mathlib"}, {"name": "nnreal.pow_sum_div_card_le_sum_pow", "description": "", "p": "mathlib"}, {"name": "nnreal.rpow_arith_mean_le_arith_mean_rpow", "description": " Weighted generalized mean inequality, version for sums over finite sets, with `\u211d\u22650`-valued\nfunctions and real exponents.", "p": "mathlib"}, {"name": "nnreal.rpow_add_le_mul_rpow_add_rpow", "description": "Unweighted mean inequality, version for two elements of `\u211d\u22650` and real exponents.", "p": "mathlib"}, {"name": "real.rpow_arith_mean_le_arith_mean_rpow", "description": "", "p": "mathlib"}, {"name": "ennreal.rpow_arith_mean_le_arith_mean_rpow", "description": " Weighted generalized mean inequality, version for sums over finite sets, with `\u211d\u22650\u221e`-valued\nfunctions and real exponents.", "p": "mathlib"}, {"name": "real.arith_mean_le_rpow_mean", "description": "", "p": "mathlib"}, {"name": "nnreal.rpow_arith_mean_le_arith_mean2_rpow", "description": "Weighted generalized mean inequality, version for two elements of `\u211d\u22650` and real exponents.", "p": "mathlib"}, {"name": "ennreal.rpow_add_rpow_le_add", "description": "", "p": "mathlib"}, {"name": "nnreal.arith_mean_le_rpow_mean", "description": " Weighted generalized mean inequality, version for sums over finite sets, with `\u211d\u22650`-valued\nfunctions and real exponents.", "p": "mathlib"}, {"name": "ennreal.rpow_arith_mean_le_arith_mean2_rpow", "description": " Weighted generalized mean inequality, version for two elements of `\u211d\u22650\u221e` and real\nexponents.", "p": "mathlib"}, {"name": "nnreal.rpow_add_rpow_le", "description": "", "p": "mathlib"}, {"name": "ennreal.rpow_add_rpow_le", "description": "", "p": "mathlib"}, {"name": "nnreal.rpow_add_rpow_le_add", "description": "", "p": "mathlib"}, {"name": "ennreal.rpow_add_le_mul_rpow_add_rpow", "description": "Unweighted mean inequality, version for two elements of `\u211d\u22650\u221e` and real exponents.", "p": "mathlib"}, {"name": "real.pow_arith_mean_le_arith_mean_pow", "description": "", "p": "mathlib"}, {"name": "nnreal.pow_arith_mean_le_arith_mean_pow", "description": " Weighted generalized mean inequality, version sums over finite sets, with `\u211d\u22650`-valued\nfunctions and natural exponent.", "p": "mathlib"}, {"name": "ennreal.rpow_add_le_add_rpow", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category_abelian'", "description": "A variant with specialized universes for a common case.", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category.image_obj_iso", "description": "The abelian image in a functor category can be calculated componentwise.", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category.coimage_image_comparison_app'", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category.image_obj_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category.coimage_obj_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category.coimage_obj_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category.coimage_image_comparison_app", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category_abelian", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category.functor_category_is_iso_coimage_image_comparison", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category.coimage_obj_iso", "description": "The abelian coimage in a functor category can be calculated componentwise.", "p": "mathlib"}, {"name": "category_theory.abelian.functor_category.image_obj_iso_inv", "description": "", "p": "mathlib"}, {"name": "finite_field.is_square_iff", "description": "A non-zero `a : F` is a square if and only if `a ^ (#F / 2) = 1`.", "p": "mathlib"}, {"name": "zmod.card_units", "description": "", "p": "mathlib"}, {"name": "finite_field.is_square_of_char_two", "description": "In a finite field of characteristic `2`, all elements are squares.", "p": "mathlib"}, {"name": "finite_field.sum_pow_units", "description": " The sum of `x ^ i` as `x` ranges over the units of a finite field of cardinality `q`\nis equal to `0` unless `(q - 1) \u2223 i`, in which case the sum is `q - 1`.", "p": "mathlib"}, {"name": "finite_field.sum_pow_lt_card_sub_one", "description": " The sum of `x ^ i` as `x` ranges over a finite field of cardinality `q`\nis equal to `0` if `i < q - 1`.", "p": "mathlib"}, {"name": "zmod.units_pow_card_sub_one_eq_one", "description": "**Fermat's Little Theorem**: for every unit `a` of `zmod p`, we have `a ^ (p - 1) = 1`.", "p": "mathlib"}, {"name": "zmod.order_of_dvd_card_sub_one", "description": "", "p": "mathlib"}, {"name": "finite_field.exists_nonsquare", "description": "In a finite field of odd characteristic, not every element is a square.", "p": "mathlib"}, {"name": "finite_field.even_card_of_char_two", "description": "", "p": "mathlib"}, {"name": "finite_field.pow_card", "description": "", "p": "mathlib"}, {"name": "finite_field.forall_pow_eq_one_iff", "description": "", "p": "mathlib"}, {"name": "finite_field.X_pow_card_sub_X_ne_zero", "description": "", "p": "mathlib"}, {"name": "finite_field.frobenius_pow", "description": "", "p": "mathlib"}, {"name": "zmod.sq_add_sq", "description": "", "p": "mathlib"}, {"name": "finite_field.card_image_polynomial_eval", "description": "The cardinality of a field is at most `n` times the cardinality of the image of a degree `n`\n polynomial", "p": "mathlib"}, {"name": "zmod.pow_card_sub_one_eq_one", "description": "**Fermat's Little Theorem**: for all nonzero `a : zmod p`, we have `a ^ (p - 1) = 1`.", "p": "mathlib"}, {"name": "finite_field.card'", "description": "", "p": "mathlib"}, {"name": "finite_field.X_pow_card_pow_sub_X_nat_degree_eq", "description": "", "p": "mathlib"}, {"name": "finite_field.prod_univ_units_id_eq_neg_one", "description": "", "p": "mathlib"}, {"name": "finite_field.odd_card_of_char_ne_two", "description": "", "p": "mathlib"}, {"name": "finite_field.card", "description": "", "p": "mathlib"}, {"name": "finite_field.pow_card_sub_one_eq_one", "description": "", "p": "mathlib"}, {"name": "zmod.pow_totient", "description": "The **Fermat-Euler totient theorem**. `nat.modeq.pow_totient` is an alternative statement\n of the same theorem.", "p": "mathlib"}, {"name": "finite_field.unit_is_square_iff", "description": " A unit `a` of a finite field `F` of odd characteristic is a square\nif and only if `a ^ (#F / 2) = 1`.", "p": "mathlib"}, {"name": "finite_field.pow_dichotomy", "description": "If `F` has odd characteristic, then for nonzero `a : F`, we have that `a ^ (#F / 2) = \u00b11`.", "p": "mathlib"}, {"name": "char_p.sq_add_sq", "description": "", "p": "mathlib"}, {"name": "finite_field.even_card_iff_char_two", "description": "The finite field `F` has even cardinality iff it has characteristic `2`.", "p": "mathlib"}, {"name": "zmod.pow_card_pow", "description": "", "p": "mathlib"}, {"name": "nat.modeq.pow_totient", "description": "The **Fermat-Euler totient theorem**. `zmod.pow_totient` is an alternative statement\n of the same theorem.", "p": "mathlib"}, {"name": "finite_field.X_pow_card_pow_sub_X_ne_zero", "description": "", "p": "mathlib"}, {"name": "finite_field.X_pow_card_sub_X_nat_degree_eq", "description": "", "p": "mathlib"}, {"name": "finite_field.expand_card", "description": "", "p": "mathlib"}, {"name": "card_eq_pow_finrank", "description": "", "p": "mathlib"}, {"name": "int.modeq.pow_card_sub_one_eq_one", "description": " **Fermat's Little Theorem**: for all `a : \u2124` coprime to `p`, we have\n`a ^ (p - 1) \u2261 1 [ZMOD p]`.", "p": "mathlib"}, {"name": "zmod.frobenius_zmod", "description": "", "p": "mathlib"}, {"name": "finite_field.pow_card_pow", "description": "", "p": "mathlib"}, {"name": "finite_field.exists_root_sum_quadratic", "description": "If `f` and `g` are quadratic polynomials, then the `f.eval a + g.eval b = 0` has a solution.", "p": "mathlib"}, {"name": "zmod.pow_card", "description": "A variation on Fermat's little theorem. See `zmod.pow_card_sub_one_eq_one`", "p": "mathlib"}, {"name": "zmod.order_of_units_dvd_card_sub_one", "description": "", "p": "mathlib"}, {"name": "finite_field.roots_X_pow_card_sub_X", "description": "", "p": "mathlib"}, {"name": "finite_field.cast_card_eq_zero", "description": "", "p": "mathlib"}, {"name": "zmod.expand_card", "description": "", "p": "mathlib"}, {"name": "polynomial.exists_approx_polynomial", "description": " If `A` is a family of enough low-degree polynomials over a finite field,\nthere is a pair of elements in `A` (with different indices but not necessarily\ndistinct), such that the difference of their remainders is close together.", "p": "mathlib"}, {"name": "polynomial.exists_eq_polynomial", "description": " If `A` is a family of enough low-degree polynomials over a finite semiring, there is a\npair of equal elements in `A`.", "p": "mathlib"}, {"name": "polynomial.card_pow_degree_anti_archimedean", "description": "If `x` is close to `y` and `y` is close to `z`, then `x` and `z` are at least as close.", "p": "mathlib"}, {"name": "polynomial.exists_partition_polynomial", "description": " For all `\u03b5 > 0`, we can partition the remainders of any family of polynomials `A`\ninto classes, where all remainders in a class are close together.", "p": "mathlib"}, {"name": "polynomial.card_pow_degree_is_admissible", "description": " `\u03bb p, fintype.card Fq ^ degree p` is an admissible absolute value.\nWe set `q ^ degree 0 = 0`.", "p": "mathlib"}, {"name": "polynomial.exists_partition_polynomial_aux", "description": " A slightly stronger version of `exists_partition` on which we perform induction on `n`:\nfor all `\u03b5 > 0`, we can partition the remainders of any family of polynomials `A`\ninto equivalence classes, where the equivalence(!) relation is \"closer than `\u03b5`\".", "p": "mathlib"}, {"name": "polynomial.exists_approx_polynomial_aux", "description": " If `A` is a family of enough low-degree polynomials over a finite ring,\nthere is a pair of elements in `A` (with different indices but not necessarily\ndistinct), such that their difference has small degree.", "p": "mathlib"}, {"name": "symplectic_group.coe_inv'", "description": "", "p": "mathlib"}, {"name": "symplectic_group.coe_inv", "description": "", "p": "mathlib"}, {"name": "symplectic_group.sym_J", "description": "The canonical skew-symmetric matrix as an element in the symplectic group.", "p": "mathlib"}, {"name": "symplectic_group.transpose_mem", "description": "", "p": "mathlib"}, {"name": "symplectic_group.coe_matrix", "description": "", "p": "mathlib"}, {"name": "symplectic_group.J_mem", "description": "", "p": "mathlib"}, {"name": "symplectic_group.neg_mem", "description": "", "p": "mathlib"}, {"name": "matrix.J", "description": "The matrix defining the canonical skew-symmetric bilinear form.", "p": "mathlib"}, {"name": "symplectic_group.symplectic_det", "description": "", "p": "mathlib"}, {"name": "matrix.J_squared", "description": "", "p": "mathlib"}, {"name": "symplectic_group.coe_J", "description": "", "p": "mathlib"}, {"name": "symplectic_group.matrix.symplectic_group.has_inv", "description": "", "p": "mathlib"}, {"name": "matrix.symplectic_group", "description": "The group of symplectic matrices over a ring `R`.", "p": "mathlib"}, {"name": "symplectic_group.mem_iff'", "description": "", "p": "mathlib"}, {"name": "matrix.J_transpose", "description": "", "p": "mathlib"}, {"name": "matrix.J_inv", "description": "", "p": "mathlib"}, {"name": "symplectic_group.transpose_mem_iff", "description": "", "p": "mathlib"}, {"name": "symplectic_group.matrix.symplectic_group.group", "description": "", "p": "mathlib"}, {"name": "matrix.is_unit_det_J", "description": "", "p": "mathlib"}, {"name": "symplectic_group.inv_left_mul_aux", "description": "", "p": "mathlib"}, {"name": "matrix.J_det_mul_J_det", "description": "", "p": "mathlib"}, {"name": "symplectic_group.mem_iff", "description": "", "p": "mathlib"}, {"name": "symplectic_group.inv_eq_symplectic_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.is_localization.op", "description": "", "p": "mathlib"}, {"name": "category_theory.localization.is_localization_op", "description": "", "p": "mathlib"}, {"name": "category_theory.localization.strict_universal_property_fixed_target.op", "description": " If `L : C \u2964 D` satisfies the universal property of the localisation\nfor `W : morphism_property C`, then `L.op` also does.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_product.of_iso_comparison", "description": "If `pi_comparison G f` is an isomorphism, then `G` preserves the limit of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_coproduct.inv_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_map_cocone_cofan_mk_equiv", "description": "The map of a cofan is a colimit iff the cofan consisting of the mapped morphisms is a colimit.\nThis essentially lets us commute `cofan.mk` with `functor.map_cocone`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_coproduct.iso", "description": "If `G` preserves colimits,\nwe have an isomorphism from the image of a coproduct to the coproduct of the images.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_coproduct.of_iso_comparison", "description": "If `sigma_comparison G f` is an isomorphism, then `G` preserves the colimit of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.pi_comparison.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_of_is_limit_fan_mk_obj", "description": "The property of reflecting products expressed in terms of fans.", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_cofan_mk_obj_of_is_colimit", "description": "The property of preserving coproducts expressed in terms of cofans.", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_fan_mk_obj_of_is_limit", "description": "The property of preserving products expressed in terms of fans.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_product.iso", "description": "If `G` preserves limits, we have an isomorphism from the image of a product to the product of the\nimages.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_product.iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.sigma_comparison.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_of_has_coproduct_of_preserves_colimit", "description": "If `G` preserves coproducts and `C` has them,\nthen the cofan constructed of the mapped inclusion of a coproduct is a colimit.", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_map_cone_fan_mk_equiv", "description": "The map of a fan is a limit iff the fan consisting of the mapped morphisms is a limit. This\nessentially lets us commute `fan.mk` with `functor.map_cone`.", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_of_has_product_of_preserves_limit", "description": "If `G` preserves products and `C` has them, then the fan constructed of the mapped projection of a\nproduct is a limit.", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_of_is_colimit_cofan_mk_obj", "description": "The property of reflecting coproducts expressed in terms of cofans.", "p": "mathlib"}, {"name": "SemilatInf", "description": "The category of inf-semilattices with a top element.", "p": "mathlib"}, {"name": "SemilatInf.X", "description": "The category of inf-semilattices with a top element.", "p": "mathlib"}, {"name": "SemilatInf.is_semilattice_inf", "description": "The category of inf-semilattices with a top element.", "p": "mathlib"}, {"name": "SemilatInf.is_order_top", "description": "The category of inf-semilattices with a top element.", "p": "mathlib"}, {"name": "SemilatInf.dual_map", "description": "", "p": "mathlib"}, {"name": "SemilatInf.inhabited", "description": "", "p": "mathlib"}, {"name": "SemilatInf.has_forget_to_PartOrd", "description": "", "p": "mathlib"}, {"name": "SemilatInf.iso.mk", "description": "Constructs an isomorphism of lattices from an order isomorphism between them.", "p": "mathlib"}, {"name": "SemilatSup.of", "description": "Construct a bundled `SemilatSup` from a `semilattice_sup`.", "p": "mathlib"}, {"name": "SemilatInf.iso.mk_hom", "description": "", "p": "mathlib"}, {"name": "SemilatSup.category_theory.concrete_category", "description": "", "p": "mathlib"}, {"name": "SemilatInf.coe_forget_to_PartOrd", "description": "", "p": "mathlib"}, {"name": "SemilatInf.dual", "description": "`order_dual` as a functor.", "p": "mathlib"}, {"name": "SemilatInf.category_theory.large_category", "description": "", "p": "mathlib"}, {"name": "SemilatInf.of", "description": "Construct a bundled `SemilatInf` from a `semilattice_inf`.", "p": "mathlib"}, {"name": "SemilatSup", "description": "The category of sup-semilattices with a bottom element.", "p": "mathlib"}, {"name": "SemilatSup.X", "description": "The category of sup-semilattices with a bottom element.", "p": "mathlib"}, {"name": "SemilatSup.is_semilattice_sup", "description": "The category of sup-semilattices with a bottom element.", "p": "mathlib"}, {"name": "SemilatSup.is_order_bot", "description": "The category of sup-semilattices with a bottom element.", "p": "mathlib"}, {"name": "SemilatSup.dual", "description": "`order_dual` as a functor.", "p": "mathlib"}, {"name": "SemilatSup.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "SemilatSup.dual_obj", "description": "", "p": "mathlib"}, {"name": "SemilatInf.iso.mk_inv", "description": "", "p": "mathlib"}, {"name": "SemilatInf.dual_obj", "description": "", "p": "mathlib"}, {"name": "SemilatSup.has_forget_to_PartOrd", "description": "", "p": "mathlib"}, {"name": "SemilatSup.dual_map", "description": "", "p": "mathlib"}, {"name": "SemilatInf.coe_of", "description": "", "p": "mathlib"}, {"name": "SemilatSup.iso.mk", "description": "Constructs an isomorphism of lattices from an order isomorphism between them.", "p": "mathlib"}, {"name": "SemilatSup.inhabited", "description": "", "p": "mathlib"}, {"name": "SemilatInf_dual_comp_forget_to_PartOrd", "description": "", "p": "mathlib"}, {"name": "SemilatSup_equiv_SemilatInf_inverse", "description": "", "p": "mathlib"}, {"name": "SemilatSup_dual_comp_forget_to_PartOrd", "description": "", "p": "mathlib"}, {"name": "SemilatSup.iso.mk_hom", "description": "", "p": "mathlib"}, {"name": "SemilatSup_equiv_SemilatInf_functor", "description": "", "p": "mathlib"}, {"name": "SemilatSup.category_theory.large_category", "description": "", "p": "mathlib"}, {"name": "SemilatSup.coe_of", "description": "", "p": "mathlib"}, {"name": "SemilatInf.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "SemilatInf.category_theory.concrete_category", "description": "", "p": "mathlib"}, {"name": "SemilatSup_equiv_SemilatInf", "description": "The equivalence between `SemilatSup` and `SemilatInf` induced by `order_dual` both ways.", "p": "mathlib"}, {"name": "SemilatSup.iso.mk_inv", "description": "", "p": "mathlib"}, {"name": "SemilatSup.coe_forget_to_PartOrd", "description": "", "p": "mathlib"}, {"name": "Top.continuous_prelocal", "description": "Continuity is a \"prelocal\" predicate on functions to a fixed topological space `T`.", "p": "mathlib"}, {"name": "Top.prelocal_predicate.sheafify", "description": "Given a `P : prelocal_predicate`, we can always construct a `local_predicate`\nby asking that the condition from `P` holds locally near every point.", "p": "mathlib"}, {"name": "Top.subsheaf_to_Types", "description": "The subsheaf of the sheaf of all dependently typed functions satisfying the local predicate `P`.", "p": "mathlib"}, {"name": "Top.subpresheaf_to_Types.is_sheaf", "description": "The functions satisfying a local predicate satisfy the sheaf condition.", "p": "mathlib"}, {"name": "Top.inhabited_prelocal_predicate", "description": "Satisfying the inhabited linter.", "p": "mathlib"}, {"name": "Top.stalk_to_fiber_germ", "description": "", "p": "mathlib"}, {"name": "Top.sheaf_to_Top", "description": "The sheaf of continuous functions on `X` with values in a space `T`.", "p": "mathlib"}, {"name": "Top.stalk_to_fiber", "description": "There is a canonical map from the stalk to the original fiber, given by evaluating sections.", "p": "mathlib"}, {"name": "Top.prelocal_predicate", "description": "Given a topological space `X : Top` and a type family `T : X \u2192 Type`,\na `P : prelocal_predicate T` consists of:\n* a family of predicates `P.pred`, one for each `U : opens X`, of the form `(\u03a0 x : U, T x) \u2192 Prop`\n* a proof that if `f : \u03a0 x : V, T x` satisfies the predicate on `V : opens X`, then\n  the restriction of `f` to any open subset `U` also satisfies the predicate.", "p": "mathlib"}, {"name": "Top.prelocal_predicate.pred", "description": "Given a topological space `X : Top` and a type family `T : X \u2192 Type`,\na `P : prelocal_predicate T` consists of:\n* a family of predicates `P.pred`, one for each `U : opens X`, of the form `(\u03a0 x : U, T x) \u2192 Prop`\n* a proof that if `f : \u03a0 x : V, T x` satisfies the predicate on `V : opens X`, then\n  the restriction of `f` to any open subset `U` also satisfies the predicate.", "p": "mathlib"}, {"name": "Top.prelocal_predicate.res", "description": "Given a topological space `X : Top` and a type family `T : X \u2192 Type`,\na `P : prelocal_predicate T` consists of:\n* a family of predicates `P.pred`, one for each `U : opens X`, of the form `(\u03a0 x : U, T x) \u2192 Prop`\n* a proof that if `f : \u03a0 x : V, T x` satisfies the predicate on `V : opens X`, then\n  the restriction of `f` to any open subset `U` also satisfies the predicate.", "p": "mathlib"}, {"name": "Top.continuous_prelocal_pred", "description": "", "p": "mathlib"}, {"name": "Top.subpresheaf_to_Types_map_coe", "description": "", "p": "mathlib"}, {"name": "Top.subpresheaf_to_Types", "description": "The subpresheaf of dependent functions on `X` satisfying the \"pre-local\" predicate `P`.", "p": "mathlib"}, {"name": "Top.subpresheaf_continuous_prelocal_iso_presheaf_to_Top", "description": "Some repackaging:\nthe presheaf of functions satisfying `continuous_prelocal` is just the same thing as\nthe presheaf of continuous functions.", "p": "mathlib"}, {"name": "Top.prelocal_predicate.sheafify_of", "description": "", "p": "mathlib"}, {"name": "Top.stalk_to_fiber_injective", "description": "The `stalk_to_fiber` map is injective at `x` if any two allowed sections which agree at `x`\nagree on some neighborhood of `x`.", "p": "mathlib"}, {"name": "Top.subsheaf_to_Types_val", "description": "", "p": "mathlib"}, {"name": "Top.inhabited_local_predicate", "description": "Satisfying the inhabited linter.", "p": "mathlib"}, {"name": "Top.subpresheaf_to_Types_obj", "description": "", "p": "mathlib"}, {"name": "Top.stalk_to_fiber_surjective", "description": "The `stalk_to_fiber` map is surjective at `x` if\nevery point in the fiber `T x` has an allowed section passing through it.", "p": "mathlib"}, {"name": "Top.subpresheaf_to_Types.subtype", "description": "The natural transformation including the subpresheaf of functions satisfying a local predicate\ninto the presheaf of all functions.", "p": "mathlib"}, {"name": "Top.local_predicate", "description": "Given a topological space `X : Top` and a type family `T : X \u2192 Type`,\na `P : local_predicate T` consists of:\n* a family of predicates `P.pred`, one for each `U : opens X`, of the form `(\u03a0 x : U, T x) \u2192 Prop`\n* a proof that if `f : \u03a0 x : V, T x` satisfies the predicate on `V : opens X`, then\n  the restriction of `f` to any open subset `U` also satisfies the predicate, and\n* a proof that given some `f : \u03a0 x : U, T x`,\n  if for every `x : U` we can find an open set `x \u2208 V \u2264 U`\n  so that the restriction of `f` to `V` satisfies the predicate,\n  then `f` itself satisfies the predicate.", "p": "mathlib"}, {"name": "Top.local_predicate.to_prelocal_predicate", "description": "Given a topological space `X : Top` and a type family `T : X \u2192 Type`,\na `P : local_predicate T` consists of:\n* a family of predicates `P.pred`, one for each `U : opens X`, of the form `(\u03a0 x : U, T x) \u2192 Prop`\n* a proof that if `f : \u03a0 x : V, T x` satisfies the predicate on `V : opens X`, then\n  the restriction of `f` to any open subset `U` also satisfies the predicate, and\n* a proof that given some `f : \u03a0 x : U, T x`,\n  if for every `x : U` we can find an open set `x \u2208 V \u2264 U`\n  so that the restriction of `f` to `V` satisfies the predicate,\n  then `f` itself satisfies the predicate.", "p": "mathlib"}, {"name": "Top.local_predicate.locality", "description": "Given a topological space `X : Top` and a type family `T : X \u2192 Type`,\na `P : local_predicate T` consists of:\n* a family of predicates `P.pred`, one for each `U : opens X`, of the form `(\u03a0 x : U, T x) \u2192 Prop`\n* a proof that if `f : \u03a0 x : V, T x` satisfies the predicate on `V : opens X`, then\n  the restriction of `f` to any open subset `U` also satisfies the predicate, and\n* a proof that given some `f : \u03a0 x : U, T x`,\n  if for every `x : U` we can find an open set `x \u2208 V \u2264 U`\n  so that the restriction of `f` to `V` satisfies the predicate,\n  then `f` itself satisfies the predicate.", "p": "mathlib"}, {"name": "Top.continuous_local", "description": "Continuity is a \"local\" predicate on functions to a fixed topological space `T`.", "p": "mathlib"}, {"name": "polynomial.content_mul", "description": "", "p": "mathlib"}, {"name": "polynomial.prim_part_dvd", "description": "", "p": "mathlib"}, {"name": "polynomial.is_primitive.content_eq_one", "description": "", "p": "mathlib"}, {"name": "polynomial.prim_part", "description": "The primitive part of a polynomial `p` is the primitive polynomial gained by dividing `p` by\n `p.content`. If `p = 0`, then `p.prim_part = 1`.", "p": "mathlib"}, {"name": "polynomial.content_prim_part", "description": "", "p": "mathlib"}, {"name": "polynomial.monic.is_primitive", "description": "", "p": "mathlib"}, {"name": "polynomial.is_primitive_prim_part", "description": "", "p": "mathlib"}, {"name": "polynomial.nat_degree_prim_part", "description": "", "p": "mathlib"}, {"name": "polynomial.dvd_content_iff_C_dvd", "description": "", "p": "mathlib"}, {"name": "polynomial.normalize_content", "description": "", "p": "mathlib"}, {"name": "polynomial.prim_part_ne_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.degree_gcd_le_right", "description": "", "p": "mathlib"}, {"name": "polynomial.is_primitive_one", "description": "", "p": "mathlib"}, {"name": "polynomial.content_eq_gcd_range_of_lt", "description": "", "p": "mathlib"}, {"name": "polynomial.content_X_pow", "description": "", "p": "mathlib"}, {"name": "polynomial.content_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "polynomial.content_X_mul", "description": "", "p": "mathlib"}, {"name": "polynomial.aeval_prim_part_eq_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.is_primitive.prim_part_eq", "description": "", "p": "mathlib"}, {"name": "polynomial.eq_C_content_mul_prim_part", "description": "", "p": "mathlib"}, {"name": "polynomial.content_dvd_coeff", "description": "", "p": "mathlib"}, {"name": "polynomial.prim_part_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.is_primitive.mul", "description": "", "p": "mathlib"}, {"name": "polynomial.is_primitive_iff_is_unit_of_C_dvd", "description": "", "p": "mathlib"}, {"name": "polynomial.is_primitive_of_dvd", "description": "", "p": "mathlib"}, {"name": "polynomial.content_C_mul", "description": "", "p": "mathlib"}, {"name": "polynomial.content_X", "description": "", "p": "mathlib"}, {"name": "polynomial.eval\u2082_prim_part_eq_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.gcd_content_eq_of_dvd_sub", "description": "", "p": "mathlib"}, {"name": "polynomial.exists_primitive_lcm_of_is_primitive", "description": "", "p": "mathlib"}, {"name": "polynomial.content_mul_aux", "description": "", "p": "mathlib"}, {"name": "polynomial.content_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.content_eq_gcd_leading_coeff_content_erase_lead", "description": "", "p": "mathlib"}, {"name": "polynomial.normalized_gcd_monoid", "description": "", "p": "mathlib"}, {"name": "polynomial.prim_part_mul", "description": "", "p": "mathlib"}, {"name": "polynomial.content", "description": "`p.content` is the `gcd` of the coefficients of `p`.", "p": "mathlib"}, {"name": "polynomial.is_primitive.ne_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.dvd_iff_content_dvd_content_and_prim_part_dvd_prim_part", "description": "", "p": "mathlib"}, {"name": "polynomial.is_primitive", "description": "A polynomial is primitive when the only constant polynomials dividing it are units", "p": "mathlib"}, {"name": "polynomial.is_primitive.dvd_prim_part_iff_dvd", "description": "", "p": "mathlib"}, {"name": "polynomial.is_primitive_iff_content_eq_one", "description": "", "p": "mathlib"}, {"name": "polynomial.content_eq_gcd_range_succ", "description": "", "p": "mathlib"}, {"name": "polynomial.C_content_dvd", "description": "", "p": "mathlib"}, {"name": "polynomial.degree_gcd_le_left", "description": "", "p": "mathlib"}, {"name": "polynomial.content_C", "description": "", "p": "mathlib"}, {"name": "polynomial.content_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.is_unit_prim_part_C", "description": "", "p": "mathlib"}, {"name": "polynomial.content_one", "description": "", "p": "mathlib"}, {"name": "side", "description": "", "p": "mathlib"}, {"name": "side.L", "description": "", "p": "mathlib"}, {"name": "side.R", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.tracked_rewrite.replace_target_rhs", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.tracked_rewrite.replace_target_lhs", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.cfg", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.cfg.to_rewrite_cfg", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.cfg.try_simp", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.cfg.discharger", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.cfg.simplifier", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.tracked_rewrite", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.tracked_rewrite.exp", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.tracked_rewrite.proof", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.tracked_rewrite.addr", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.tracked_rewrite.eval", "description": "", "p": "mathlib"}, {"name": "side.other", "description": "", "p": "mathlib"}, {"name": "side.inhabited", "description": "", "p": "mathlib"}, {"name": "side.has_to_string", "description": "", "p": "mathlib"}, {"name": "side.to_string", "description": "", "p": "mathlib"}, {"name": "side.decidable_eq", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_all.tracked_rewrite.replace_target", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding.obj_obj_X", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding.map_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding.obj_map_f", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.app_idem_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.app_idem", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding.obj_obj_p", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.app_comp_p_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.app_p_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.app_p_comp_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding.map", "description": "Tautological action on maps of the functor `karoubi (J \u2964 C) \u2964 (J \u2964 karoubi C)`.", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding_map", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.app_comp_p", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding.category_theory.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding.obj", "description": " On objects, the functor which sends a formal direct factor `P` of a\nfunctor `F : J \u2964 C` to the functor `J \u2964 karoubi C` which sends `(j : J)` to\nthe corresponding direct factor of `F.obj j`.", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding", "description": "The tautological fully faithful functor `karoubi (J \u2964 C) \u2964 (J \u2964 karoubi C)`.", "p": "mathlib"}, {"name": "category_theory.idempotents.app_p_comm_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.functor_category_is_idempotent_complete", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.to_karoubi_comp_karoubi_functor_category_embedding", "description": " The composition of `(J \u2964 C) \u2964 karoubi (J \u2964 C)` and `karoubi (J \u2964 C) \u2964 (J \u2964 karoubi C)`\nequals the functor `(J \u2964 C) \u2964 (J \u2964 karoubi C)` given by the composition with\n`to_karoubi C : C \u2964 karoubi C`.", "p": "mathlib"}, {"name": "category_theory.idempotents.karoubi_functor_category_embedding.category_theory.full", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.app_p_comp", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.slash_invariant_form_class.coe_coe", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.coe_hom_injective", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.copy", "description": " Copy of a `slash_invariant_form` with a new `to_fun` equal to the old one.\nUseful to fix definitional equalities.", "p": "mathlib"}, {"name": "slash_invariant_form.has_sub", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.coe_sub", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.coe_hom", "description": "Additive coercion from `slash_invariant_form` to `\u210d \u2192 \u2102`.", "p": "mathlib"}, {"name": "slash_invariant_form.smul_apply", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form_class", "description": "`slash_invariant_form_class F \u0393 k` asserts `F` is a type of bundled functions that are invariant\nunder the `slash_action`.", "p": "mathlib"}, {"name": "slash_invariant_form_class.coe", "description": "`slash_invariant_form_class F \u0393 k` asserts `F` is a type of bundled functions that are invariant\nunder the `slash_action`.", "p": "mathlib"}, {"name": "slash_invariant_form_class.coe_injective'", "description": "`slash_invariant_form_class F \u0393 k` asserts `F` is a type of bundled functions that are invariant\nunder the `slash_action`.", "p": "mathlib"}, {"name": "slash_invariant_form_class.slash_action_eq", "description": "`slash_invariant_form_class F \u0393 k` asserts `F` is a type of bundled functions that are invariant\nunder the `slash_action`.", "p": "mathlib"}, {"name": "slash_invariant_form.slash_action_eqn", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form", "description": "Functions `\u210d \u2192 \u2102` that are invariant under the `slash_action`.", "p": "mathlib"}, {"name": "slash_invariant_form.to_fun", "description": "Functions `\u210d \u2192 \u2102` that are invariant under the `slash_action`.", "p": "mathlib"}, {"name": "slash_invariant_form.slash_action_eq'", "description": "Functions `\u210d \u2192 \u2102` that are invariant under the `slash_action`.", "p": "mathlib"}, {"name": "slash_invariant_form_ext", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.has_coe_t", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.one_coe_eq_one", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.slash_action_eqn'", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.coe_zero", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form_class.to_fun_like", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.add_apply", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.has_neg", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.slash_invariant_form_class.coe_to_fun", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.coe_add", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.add_comm_group", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form_to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.has_add", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form_class.slash_invariant_form", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.has_smul", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.sub_apply", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.coe_neg", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.has_one", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.coe_smul", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.inhabited", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.neg_apply", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.has_zero", "description": "", "p": "mathlib"}, {"name": "slash_invariant_form.module", "description": "", "p": "mathlib"}, {"name": "local_ring.cotangent_space", "description": "The `A \u29f8 I`-vector space `I \u29f8 I ^ 2`.", "p": "mathlib"}, {"name": "ideal.cotangent_to_quotient_square", "description": "The inclusion map `I \u29f8 I ^ 2` to `R \u29f8 I ^ 2`.", "p": "mathlib"}, {"name": "alg_hom.ker_ker_sqare_lift", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent_subsingleton_iff", "description": "", "p": "mathlib"}, {"name": "local_ring.cotangent_space.module", "description": "", "p": "mathlib"}, {"name": "ideal.to_cotangent_surjective", "description": "", "p": "mathlib"}, {"name": "ideal.to_cotangent_apply", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "local_ring.cotangent_space.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent.module", "description": "", "p": "mathlib"}, {"name": "ideal.map_to_cotangent_ker", "description": "", "p": "mathlib"}, {"name": "local_ring.cotangent_space.finite_dimensional", "description": "", "p": "mathlib"}, {"name": "alg_hom.ker_square_lift", "description": "The lift of `f : A \u2192\u2090[R] B` to `A \u29f8 J ^ 2 \u2192\u2090[R] B` with `J` being the kernel of `f`.", "p": "mathlib"}, {"name": "ideal.to_cotangent_range", "description": "", "p": "mathlib"}, {"name": "ideal.to_cotangent_eq", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent.inhabited", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent_equiv_ideal_apply", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent.is_noetherian", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent_equiv_ideal_symm_apply", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent_ideal", "description": "`I \u29f8 I ^ 2` as an ideal of `R \u29f8 I ^ 2`.", "p": "mathlib"}, {"name": "ideal.to_cotangent", "description": "The quotient map from `I` to `I \u29f8 I ^ 2`.", "p": "mathlib"}, {"name": "ideal.to_cotangent_eq_zero", "description": "", "p": "mathlib"}, {"name": "ideal.to_quotient_square_comp_to_cotangent", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent", "description": "`I \u29f8 I ^ 2` as a quotient of `I`.", "p": "mathlib"}, {"name": "ideal.mem_to_cotangent_ker", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent_ideal_square", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent_equiv_ideal", "description": " The equivalence of the two definitions of `I / I ^ 2`, either as the quotient of `I` or the\nideal of `R / I ^ 2`.", "p": "mathlib"}, {"name": "ideal.quot_cotangent", "description": "The quotient ring of `I \u29f8 I ^ 2` is `R \u29f8 I`.", "p": "mathlib"}, {"name": "ideal.to_cotangent_to_quotient_square", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent.add_comm_group", "description": "", "p": "mathlib"}, {"name": "ideal.cotangent.module_of_tower", "description": "", "p": "mathlib"}, {"name": "ideal.to_quotient_square_range", "description": "", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_mul_aux_eq_of_rel_right", "description": "Multiplication in the colimit is well-defined in the right argument.", "p": "mathlib"}, {"name": "AddCommMon.filtered_colimits.M", "description": "The colimit of `F \u22d9 forget\u2082 AddCommMon AddMon` in the category `AddMon`. In the\nfollowing, we will show that this has the structure of a _commutative_ additive monoid.", "p": "mathlib"}, {"name": "AddCommMon.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_add_aux_eq_of_rel_right", "description": "Addition in the colimit is well-defined in the right argument.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.cocone_morphism", "description": "The additive monoid homomorphism from a given additive monoid in the diagram to the\ncolimit additive monoid.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.cocone_naturality", "description": "", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_zero_eq", "description": "The definition of the \"zero\" in the colimit is independent of the chosen object\nof `J`. In particular, this lemma allows us to \"unfold\" the definition of `colimit_zero` at a\ncustom chosen object `j`.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_add_aux", "description": "The \"unlifted\" version of addition in the colimit. To add two dependent pairs\n`\u27e8j\u2081, x\u27e9` and `\u27e8j\u2082, y\u27e9`, we pass to a common successor of `j\u2081` and `j\u2082` (given by `is_filtered.max`)\nand add them there.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_has_add", "description": "Addition in the colimit. See also `colimit_add_aux`.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_add_aux_eq_of_rel_left", "description": "Addition in the colimit is well-defined in the left argument.", "p": "mathlib"}, {"name": "AddCommMon.filtered_colimits.forget\u2082_AddMon_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.M.mk", "description": "The canonical projection into the colimit, as a quotient type.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit monoid.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.M", "description": "The colimit of `F \u22d9 forget AddMon` in the category of types.\nIn the following, we will construct an additive monoid structure on `M`.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_has_mul", "description": "Multiplication in the colimit. See also `colimit_mul_aux`.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.cocone_naturality", "description": "", "p": "mathlib"}, {"name": "AddCommMon.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `AddCommMon`.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_mul_aux_eq_of_rel_left", "description": "Multiplication in the colimit is well-defined in the left argument.", "p": "mathlib"}, {"name": "AddCommMon.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit additive commutative monoid.", "p": "mathlib"}, {"name": "CommMon.filtered_colimits.M", "description": "The colimit of `F \u22d9 forget\u2082 CommMon Mon` in the category `Mon`.\nIn the following, we will show that this has the structure of a _commutative_ monoid.", "p": "mathlib"}, {"name": "AddCommMon.filtered_colimits.colimit", "description": "The bundled additive commutative monoid giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_one_eq", "description": "The definition of the \"one\" in the colimit is independent of the chosen object of `J`.\nIn particular, this lemma allows us to \"unfold\" the definition of `colimit_one` at a custom chosen\nobject `j`.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `AddMon`.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit additive monoid.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.M.mk", "description": "The canonical projection into the colimit, as a quotient type.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.M", "description": "The colimit of `F \u22d9 forget Mon` in the category of types.\nIn the following, we will construct a monoid structure on `M`.", "p": "mathlib"}, {"name": "CommMon.filtered_colimits.colimit_cocone", "description": "The cocone over the proposed colimit commutative monoid.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_mul_aux", "description": "The \"unlifted\" version of multiplication in the colimit. To multiply two dependent pairs\n`\u27e8j\u2081, x\u27e9` and `\u27e8j\u2082, y\u27e9`, we pass to a common successor of `j\u2081` and `j\u2082` (given by `is_filtered.max`)\nand multiply them there.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `Mon`.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.cocone_morphism", "description": "The monoid homomorphism from a given monoid in the diagram to the colimit monoid.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_desc", "description": "Given a cocone `t` of `F`, the induced monoid homomorphism from the colimit to the cocone point.\nAs a function, this is simply given by the induced map of the corresponding cocone in `Type`.\nThe only thing left to see is that it is a monoid homomorphism.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_monoid", "description": "", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.M.mk_eq", "description": "", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_add_monoid", "description": "", "p": "mathlib"}, {"name": "AddCommMon.filtered_colimits.colimit_add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_has_one", "description": "As `J` is nonempty, we can pick an arbitrary object `j\u2080 : J`. We use this object to define the\n\"one\" in the colimit as the equivalence class of `\u27e8j\u2080, 1 : F.obj j\u2080\u27e9`.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.M.mk_eq", "description": "", "p": "mathlib"}, {"name": "CommMon.filtered_colimits.forget_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_add_mk_eq", "description": "Addition in the colimit is independent of the chosen \"maximum\" in the filtered\ncategory. In particular, this lemma allows us to \"unfold\" the definition of the addition of `x`\nand `y`, using a custom object `k` and morphisms `f : x.1 \u27f6 k` and `g : y.1 \u27f6 k`.", "p": "mathlib"}, {"name": "CommMon.filtered_colimits.colimit_comm_monoid", "description": "", "p": "mathlib"}, {"name": "CommMon.filtered_colimits.colimit", "description": "The bundled commutative monoid giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "CommMon.filtered_colimits.forget\u2082_Mon_preserves_filtered_colimits", "description": "", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit", "description": "The bundled monoid giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "CommMon.filtered_colimits.colimit_cocone_is_colimit", "description": "The proposed colimit cocone is a colimit in `CommMon`.", "p": "mathlib"}, {"name": "Mon.filtered_colimits.colimit_mul_mk_eq", "description": "Multiplication in the colimit is independent of the chosen \"maximum\" in the filtered category.\nIn particular, this lemma allows us to \"unfold\" the definition of the multiplication of `x` and `y`,\nusing a custom object `k` and morphisms `f : x.1 \u27f6 k` and `g : y.1 \u27f6 k`.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit", "description": "The bundled additive monoid giving the filtered colimit of a diagram.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_desc", "description": "Given a cocone `t` of `F`, the induced additive monoid homomorphism from the colimit\nto the cocone point. As a function, this is simply given by the induced map of the corresponding\ncocone in `Type`. The only thing left to see is that it is an additive monoid homomorphism.", "p": "mathlib"}, {"name": "AddMon.filtered_colimits.colimit_has_zero", "description": "As `J` is nonempty, we can pick an arbitrary object `j\u2080 : J`. We use this object to\ndefine the \"zero\" in the colimit as the equivalence class of `\u27e8j\u2080, 0 : F.obj j\u2080\u27e9`.", "p": "mathlib"}, {"name": "monotone.tendsto_right_lim_within", "description": "", "p": "mathlib"}, {"name": "antitone.left_lim", "description": "", "p": "mathlib"}, {"name": "antitone.countable_not_continuous_at", "description": " In a second countable space, the set of points where an antitone function is not continuous\nis at most countable.", "p": "mathlib"}, {"name": "antitone.le_right_lim", "description": "", "p": "mathlib"}, {"name": "antitone.continuous_within_at_Iio_iff_left_lim_eq", "description": " An antitone function is continuous to the left at a point if and only if its left limit\ncoincides with the value of the function.", "p": "mathlib"}, {"name": "antitone.right_lim_le_left_lim", "description": "", "p": "mathlib"}, {"name": "monotone.left_lim_eq_Sup", "description": "", "p": "mathlib"}, {"name": "antitone.left_lim_le_right_lim", "description": "", "p": "mathlib"}, {"name": "antitone.continuous_at_iff_left_lim_eq_right_lim", "description": " An antitone function is continuous at a point if and only if its left and right limits\ncoincide.", "p": "mathlib"}, {"name": "antitone.tendsto_right_lim_within", "description": "", "p": "mathlib"}, {"name": "antitone.le_left_lim", "description": "", "p": "mathlib"}, {"name": "monotone.countable_not_continuous_within_at_Ioi", "description": " In a second countable space, the set of points where a monotone function is not right-continuous\nis at most countable. Superseded by `countable_not_continuous_at` which gives the two-sided\nversion.", "p": "mathlib"}, {"name": "antitone.right_lim", "description": "", "p": "mathlib"}, {"name": "monotone.left_lim_le", "description": "", "p": "mathlib"}, {"name": "function.right_lim", "description": " Let `f : \u03b1 \u2192 \u03b2` be a function from a linear order `\u03b1` to a topological_space `\u03b2`, and\nlet `a : \u03b1`. The limit strictly to the right of `f` at `a`, denoted with `right_lim f a`, is defined\nby using the order topology on `\u03b1`. If `a` is isolated to its right or the function has no right\nlimit, , we use `f a` instead to guarantee a good behavior in most cases.", "p": "mathlib"}, {"name": "monotone.countable_not_continuous_within_at_Iio", "description": " In a second countable space, the set of points where a monotone function is not left-continuous\nis at most countable. Superseded by `countable_not_continuous_at` which gives the two-sided\nversion.", "p": "mathlib"}, {"name": "monotone.tendsto_left_lim", "description": "", "p": "mathlib"}, {"name": "antitone.left_lim_le", "description": "", "p": "mathlib"}, {"name": "left_lim_eq_of_eq_bot", "description": "", "p": "mathlib"}, {"name": "monotone.continuous_within_at_Ioi_iff_right_lim_eq", "description": " A monotone function is continuous to the right at a point if and only if its right limit\ncoincides with the value of the function.", "p": "mathlib"}, {"name": "monotone.tendsto_right_lim", "description": "", "p": "mathlib"}, {"name": "antitone.tendsto_left_lim", "description": "", "p": "mathlib"}, {"name": "monotone.le_left_lim", "description": "", "p": "mathlib"}, {"name": "monotone.left_lim_le_right_lim", "description": "", "p": "mathlib"}, {"name": "antitone.continuous_within_at_Ioi_iff_right_lim_eq", "description": " An antitone function is continuous to the right at a point if and only if its right limit\ncoincides with the value of the function.", "p": "mathlib"}, {"name": "monotone.right_lim_le", "description": "", "p": "mathlib"}, {"name": "monotone.le_right_lim", "description": "", "p": "mathlib"}, {"name": "monotone.right_lim_le_left_lim", "description": "", "p": "mathlib"}, {"name": "monotone.continuous_at_iff_left_lim_eq_right_lim", "description": " A monotone function is continuous at a point if and only if its left and right limits\ncoincide.", "p": "mathlib"}, {"name": "antitone.tendsto_left_lim_within", "description": "", "p": "mathlib"}, {"name": "monotone.left_lim", "description": "", "p": "mathlib"}, {"name": "monotone.continuous_within_at_Iio_iff_left_lim_eq", "description": " A monotone function is continuous to the left at a point if and only if its left limit\ncoincides with the value of the function.", "p": "mathlib"}, {"name": "left_lim_eq_of_tendsto", "description": "", "p": "mathlib"}, {"name": "antitone.right_lim_le", "description": "", "p": "mathlib"}, {"name": "monotone.tendsto_left_lim_within", "description": "", "p": "mathlib"}, {"name": "function.left_lim", "description": " Let `f : \u03b1 \u2192 \u03b2` be a function from a linear order `\u03b1` to a topological_space `\u03b2`, and\nlet `a : \u03b1`. The limit strictly to the left of `f` at `a`, denoted with `left_lim f a`, is defined\nby using the order topology on `\u03b1`. If `a` is isolated to its left or the function has no left\nlimit, we use `f a` instead to guarantee a good behavior in most cases.", "p": "mathlib"}, {"name": "monotone.right_lim", "description": "", "p": "mathlib"}, {"name": "monotone.countable_not_continuous_at", "description": " In a second countable space, the set of points where a monotone function is not continuous\nis at most countable.", "p": "mathlib"}, {"name": "antitone.tendsto_right_lim", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_ball_of_fderiv", "description": " A variant of the second fundamental theorem of calculus (FTC-2): If a sequence of functions\nbetween real or complex normed spaces are differentiable on a ball centered at `x`, they\nform a Cauchy sequence _at_ `x`, and their derivatives are Cauchy uniformly on the ball, then the\nfunctions form a uniform Cauchy sequence on the ball.\n\nNOTE: The fact that we work on a ball is typically all that is necessary to work with power series\nand Dirichlet series (our primary use case). However, this can be generalized by replacing the ball\nwith any connected, bounded, open set and replacing uniform convergence with local uniform\nconvergence. See `cauchy_map_of_uniform_cauchy_seq_on_fderiv`.", "p": "mathlib"}, {"name": "has_deriv_at_of_tendsto_uniformly", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_of_tendsto_locally_uniformly_on'", "description": " A slight variant of `has_deriv_at_of_tendsto_locally_uniformly_on` with the assumption stated in\nterms of `differentiable_on` rather than `has_deriv_at`. This makes a few proofs nicer in complex\nanalysis where holomorphicity is assumed but the derivative is not known a priori.", "p": "mathlib"}, {"name": "has_fderiv_at_of_tendsto_uniformly_on_filter", "description": " `(d/dx) lim_{n \u2192 \u221e} f n x = lim_{n \u2192 \u221e} f' n x` when the `f' n` converge\n_uniformly_ to their limit at `x`.\n\nIn words the assumptions mean the following:\n  * `hf'`: The `f'` converge \"uniformly at\" `x` to `g'`. This does not mean that the `f' n` even\n    converge away from `x`!\n  * `hf`: For all `(y, n)` with `y` sufficiently close to `x` and `n` sufficiently large, `f' n` is\n    the derivative of `f n`\n  * `hfg`: The `f n` converge pointwise to `g` on a neighborhood of `x`", "p": "mathlib"}, {"name": "has_deriv_at_of_tendsto_locally_uniformly_on", "description": "", "p": "mathlib"}, {"name": "difference_quotients_converge_uniformly", "description": " If `f_n \u2192 g` pointwise and the derivatives `(f_n)' \u2192 h` _uniformly_ converge, then\nin fact for a fixed `y`, the difference quotients `\u2016z - y\u2016\u207b\u00b9 \u2022 (f_n z - f_n y)` converge\n_uniformly_ to `\u2016z - y\u2016\u207b\u00b9 \u2022 (g z - g y)`", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_filter_of_fderiv", "description": " If a sequence of functions real or complex functions are eventually differentiable on a\nneighborhood of `x`, they are Cauchy _at_ `x`, and their derivatives\nare a uniform Cauchy sequence in a neighborhood of `x`, then the functions form a uniform Cauchy\nsequence in a neighborhood of `x`.", "p": "mathlib"}, {"name": "has_deriv_at_of_tendsto_uniformly_on_filter", "description": "", "p": "mathlib"}, {"name": "has_fderiv_at_of_tendsto_uniformly_on", "description": " `(d/dx) lim_{n \u2192 \u221e} f n x = lim_{n \u2192 \u221e} f' n x` when the `f' n` converge\n_uniformly_ to their limit on an open set containing `x`.", "p": "mathlib"}, {"name": "has_fderiv_at_of_tendsto_locally_uniformly_on", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_ball_of_deriv", "description": "", "p": "mathlib"}, {"name": "has_fderiv_at_of_tendsto_uniformly", "description": " `(d/dx) lim_{n \u2192 \u221e} f n x = lim_{n \u2192 \u221e} f' n x` when the `f' n` converge\n_uniformly_ to their limit.", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_filter_of_deriv", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_filter.one_smul_right", "description": "If our derivatives converge uniformly, then the Fr\u00e9chet derivatives converge uniformly", "p": "mathlib"}, {"name": "has_fderiv_at_of_tendsto_locally_uniformly_on'", "description": " A slight variant of `has_fderiv_at_of_tendsto_locally_uniformly_on` with the assumption stated\nin terms of `differentiable_on` rather than `has_fderiv_at`. This makes a few proofs nicer in\ncomplex analysis where holomorphicity is assumed but the derivative is not known a priori.", "p": "mathlib"}, {"name": "cauchy_map_of_uniform_cauchy_seq_on_fderiv", "description": " If a sequence of functions between real or complex normed spaces are differentiable on a\npreconnected open set, they form a Cauchy sequence _at_ `x`, and their derivatives are Cauchy\nuniformly on the set, then the functions form a Cauchy sequence at any point in the set.", "p": "mathlib"}, {"name": "has_deriv_at_of_tendsto_uniformly_on", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_inj_of_nonneg_of_nonpos", "description": "", "p": "mathlib"}, {"name": "int.le_coe_nat_sub", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_inj_of_nonneg_of_nonneg", "description": "", "p": "mathlib"}, {"name": "int.to_nat_of_nonpos", "description": "", "p": "mathlib"}, {"name": "int.strict_anti_on_nat_abs", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_inj_of_nonpos_of_nonneg", "description": "", "p": "mathlib"}, {"name": "int.div2_bit", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_inj_of_nonpos_of_nonpos", "description": "", "p": "mathlib"}, {"name": "int.inj_on_nat_abs_Ici", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_lt_iff_sq_lt", "description": "", "p": "mathlib"}, {"name": "int.strict_mono_on_nat_abs", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_le_iff_sq_le", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_eq_iff_sq_eq", "description": "", "p": "mathlib"}, {"name": "int.succ_coe_nat_pos", "description": "", "p": "mathlib"}, {"name": "int.inj_on_nat_abs_Iic", "description": "", "p": "mathlib"}, {"name": "mvqpf.corecF", "description": " `corecF` is used as a basis for defining the corecursor of `cofix F \u03b1`. `corecF`\nuses corecursion to construct the M-type generated by `q.P` and uses function on `F`\nas a corecursive step", "p": "mathlib"}, {"name": "mvqpf.cofix.bisim", "description": "Bisimulation principle using `liftr` to match and relate children of two trees.", "p": "mathlib"}, {"name": "mvqpf.cofix.dest_corec", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.bisim\u2082", "description": "Bisimulation principle using `liftr'` to match and relate children of two trees.", "p": "mathlib"}, {"name": "mvqpf.corecF_eq", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.mvfunctor", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.repr", "description": "Representation function for `cofix F \u03b1`", "p": "mathlib"}, {"name": "mvqpf.Mcongr", "description": "Equivalence relation on M-types representing a value of type `cofix F`", "p": "mathlib"}, {"name": "mvqpf.cofix.abs_repr", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.dest_mk", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.dest_corec\u2081", "description": "", "p": "mathlib"}, {"name": "mvqpf.mv_bisim", "description": "tactic for proof by bisimulation", "p": "mathlib"}, {"name": "mvqpf.cofix.mk_dest", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.ext_mk", "description": "", "p": "mathlib"}, {"name": "mvqpf.liftr_map", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.mk", "description": "constructor for `cofix F`", "p": "mathlib"}, {"name": "mvqpf.cofix", "description": " Greatest fixed point of functor F. The result is a functor with one fewer parameters\nthan the input. For `F a b c` a ternary functor, fix F is a binary functor such that\n\n```lean\ncofix F a b = F a b (cofix F a b)\n```", "p": "mathlib"}, {"name": "mvqpf.cofix.bisim_rel", "description": "Bisimulation principle using `map` and `quot.mk` to match and relate children of two trees.", "p": "mathlib"}, {"name": "mvqpf.cofix.corec\u2081", "description": " Corecursor for `cofix F`. The shape allows recursive calls to\nlook like recursive calls.", "p": "mathlib"}, {"name": "tactic.interactive.mv_bisim", "description": "tactic for proof by bisimulation", "p": "mathlib"}, {"name": "mvqpf.cofix.dest", "description": "Destructor for `cofix F`", "p": "mathlib"}, {"name": "mvqpf.cofix.dest_corec'", "description": "", "p": "mathlib"}, {"name": "mvqpf.is_precongr", "description": "Characterization of desirable equivalence relations on M-types", "p": "mathlib"}, {"name": "mvqpf.cofix.abs", "description": "Abstraction function for `cofix F \u03b1`", "p": "mathlib"}, {"name": "mvqpf.corec_roll", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.ext", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.corec", "description": "Corecursor for `cofix F`", "p": "mathlib"}, {"name": "mvqpf.Mrepr", "description": "maps every element of the W type to a canonical representative", "p": "mathlib"}, {"name": "mvqpf.cofix.bisim'", "description": " Bisimulation principle the values `\u27e8a,f\u27e9` of the polynomial functor representing\n`cofix F \u03b1` as well as an invariant `Q : \u03b2 \u2192 Prop` and a state `\u03b2` generating the\nleft-hand side and right-hand side of the equality through functions `u v : \u03b2 \u2192 cofix F \u03b1`", "p": "mathlib"}, {"name": "mvqpf.cofix.inhabited", "description": "", "p": "mathlib"}, {"name": "mvqpf.liftr_map_last", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.corec'", "description": " More flexible corecursor for `cofix F`. Allows the return of a fully formed\nvalue instead of making a recursive call", "p": "mathlib"}, {"name": "mvqpf.liftr_map_last'", "description": "", "p": "mathlib"}, {"name": "mvqpf.cofix.map", "description": "the map function for the functor `cofix F`", "p": "mathlib"}, {"name": "mvqpf.cofix.corec'\u2081", "description": "Corecursor for `cofix F`", "p": "mathlib"}, {"name": "mvqpf.mvqpf_cofix", "description": "", "p": "mathlib"}, {"name": "quiver.hom.to_path", "description": "An arrow viewed as a path of length one.", "p": "mathlib"}, {"name": "quiver.path.heq_of_cons_eq_cons", "description": "", "p": "mathlib"}, {"name": "quiver.path.comp_inj", "description": "", "p": "mathlib"}, {"name": "quiver.path.to_list_chain_nonempty", "description": "", "p": "mathlib"}, {"name": "quiver.path.length_cons", "description": "", "p": "mathlib"}, {"name": "quiver.path.hom_heq_of_cons_eq_cons", "description": "", "p": "mathlib"}, {"name": "quiver.path.cons_ne_nil", "description": "", "p": "mathlib"}, {"name": "quiver.path.to_list_comp", "description": " `quiver.path.to_list` is a contravariant functor. The inversion comes from `quiver.path` and\n`list` having different preferred directions for adding elements.", "p": "mathlib"}, {"name": "quiver.path.comp_inj_left", "description": "", "p": "mathlib"}, {"name": "quiver.path.comp_cons", "description": "", "p": "mathlib"}, {"name": "quiver.path.length_comp", "description": "", "p": "mathlib"}, {"name": "prefunctor.map_path_cons", "description": "", "p": "mathlib"}, {"name": "quiver.path.comp_inj'", "description": "", "p": "mathlib"}, {"name": "quiver.path.comp_inj_right", "description": "", "p": "mathlib"}, {"name": "quiver.path.length", "description": "The length of a path is the number of arrows it uses.", "p": "mathlib"}, {"name": "quiver.path.nil_ne_cons", "description": "", "p": "mathlib"}, {"name": "quiver.path.to_list_inj", "description": "", "p": "mathlib"}, {"name": "quiver.path.comp_assoc", "description": "", "p": "mathlib"}, {"name": "quiver.path.comp_nil", "description": "", "p": "mathlib"}, {"name": "quiver.path.comp_injective_left", "description": "", "p": "mathlib"}, {"name": "quiver.path.obj_eq_of_cons_eq_cons", "description": "", "p": "mathlib"}, {"name": "quiver.path.length_nil", "description": "", "p": "mathlib"}, {"name": "prefunctor.map_path_nil", "description": "", "p": "mathlib"}, {"name": "prefunctor.map_path", "description": "The image of a path under a prefunctor.", "p": "mathlib"}, {"name": "quiver.path.to_list", "description": "Turn a path into a list. The list contains `a` at its head, but not `b` a priori.", "p": "mathlib"}, {"name": "quiver.path.to_list_injective", "description": "", "p": "mathlib"}, {"name": "quiver.path.inhabited", "description": "", "p": "mathlib"}, {"name": "quiver.path", "description": "`G.path a b` is the type of paths from `a` to `b` through the arrows of `G`.", "p": "mathlib"}, {"name": "quiver.path.nil", "description": "`G.path a b` is the type of paths from `a` to `b` through the arrows of `G`.", "p": "mathlib"}, {"name": "quiver.path.cons", "description": "`G.path a b` is the type of paths from `a` to `b` through the arrows of `G`.", "p": "mathlib"}, {"name": "quiver.path.comp", "description": "Composition of paths.", "p": "mathlib"}, {"name": "quiver.path.comp_injective_right", "description": "", "p": "mathlib"}, {"name": "quiver.path.nil_comp", "description": "", "p": "mathlib"}, {"name": "quiver.path.eq_of_length_zero", "description": "", "p": "mathlib"}, {"name": "prefunctor.map_path_to_path", "description": "", "p": "mathlib"}, {"name": "prefunctor.map_path_comp", "description": "", "p": "mathlib"}, {"name": "auto.do_subst", "description": "carries out a subst if there is one, fails otherwise", "p": "mathlib"}, {"name": "tactic.interactive.finish", "description": "`finish [h1,...,hn] using [e1,...,en]` negates the goal, normalizes hypotheses\n(by splitting conjunctions, eliminating existentials, pushing negations inwards,\nand calling `simp` with the supplied lemmas `h1,...,hn`), and then tries `contradiction`.\n\nIf this fails, it will create an SMT state and repeatedly use `ematch`\n(using `ematch` lemmas in the environment, universally quantified assumptions,\nand the supplied lemmas `e1,...,en`) and congruence closure.\n\n`finish` is complete for propositional logic.\n\nEither of the supplied simp lemmas or the supplied ematch lemmas are optional.\n\n`finish` will fail if it does not close the goal.", "p": "mathlib"}, {"name": "auto.do_substs", "description": "", "p": "mathlib"}, {"name": "auto.not_implies_eq", "description": "", "p": "mathlib"}, {"name": "auto.not_not_eq", "description": "", "p": "mathlib"}, {"name": "auto.eelims", "description": "eliminate all existential quantifiers, fails if there aren't any", "p": "mathlib"}, {"name": "auto.add_conjuncts", "description": "Assumes `pr` is a proof of `t`. Adds the consequences of `t` to the context\nand returns `tt` if anything nontrivial has been added.", "p": "mathlib"}, {"name": "auto.auto_config.inhabited", "description": "", "p": "mathlib"}, {"name": "auto.whnf_reducible", "description": "", "p": "mathlib"}, {"name": "auto.case_some_hyp", "description": "", "p": "mathlib"}, {"name": "auto.not_forall_eq", "description": "", "p": "mathlib"}, {"name": "auto.preprocess_goal", "description": "", "p": "mathlib"}, {"name": "auto.common_normalize_lemma_names", "description": "", "p": "mathlib"}, {"name": "auto.mk_hinst_lemmas", "description": "The terminal tactic, used to try to finish off goals:\n- Call the contradiction tactic.\n- Open an SMT state, and use ematching and congruence closure, with all the universal\n  statements in the context.\n\nTODO(Jeremy): allow users to specify attribute for ematching lemmas?", "p": "mathlib"}, {"name": "tactic.interactive.clarify", "description": "`clarify [h1,...,hn] using [e1,...,en]` negates the goal, normalizes hypotheses\n(by splitting conjunctions, eliminating existentials, pushing negations inwards,\nand calling `simp` with the supplied lemmas `h1,...,hn`), and then tries `contradiction`.\n\nIf this fails, it will create an SMT state and repeatedly use `ematch`\n(using `ematch` lemmas in the environment, universally quantified assumptions,\nand the supplied lemmas `e1,...,en`) and congruence closure.\n\n`clarify` is complete for propositional logic.\n\nEither of the supplied simp lemmas or the supplied ematch lemmas are optional.\n\n`clarify` will fail if it produces more than one goal.", "p": "mathlib"}, {"name": "auto.case_option", "description": "", "p": "mathlib"}, {"name": "auto.case_option.force", "description": "", "p": "mathlib"}, {"name": "auto.case_option.at_most_one", "description": "", "p": "mathlib"}, {"name": "auto.case_option.accept", "description": "", "p": "mathlib"}, {"name": "auto.not_exists_eq", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.safe", "description": "`safe [h1,...,hn] using [e1,...,en]` negates the goal, normalizes hypotheses\n(by splitting conjunctions, eliminating existentials, pushing negations inwards,\nand calling `simp` with the supplied lemmas `h1,...,hn`), and then tries `contradiction`.\n\nIf this fails, it will create an SMT state and repeatedly use `ematch`\n(using `ematch` lemmas in the environment, universally quantified assumptions,\nand the supplied lemmas `e1,...,en`) and congruence closure.\n\n`safe` is complete for propositional logic.\n\nEither of the supplied simp lemmas or the supplied ematch lemmas are optional.\n\n`safe` ignores the number of goals it produces, and should never fail.", "p": "mathlib"}, {"name": "auto.normalize_negations", "description": "", "p": "mathlib"}, {"name": "auto.normalize_hyps", "description": "", "p": "mathlib"}, {"name": "auto.not_and_eq", "description": "", "p": "mathlib"}, {"name": "auto.add_simps", "description": "", "p": "mathlib"}, {"name": "auto.done", "description": "`done` first attempts to close the goal using `contradiction`. If this fails, it creates an\nSMT state and will repeatedly use `ematch` (using `ematch` lemmas in the environment,\nuniversally quantified assumptions, and the supplied lemmas `ps`) and congruence closure.", "p": "mathlib"}, {"name": "auto.classical.implies_iff_not_or", "description": "", "p": "mathlib"}, {"name": "auto.split_hyp", "description": "return `tt` if any progress is made", "p": "mathlib"}, {"name": "auto.classical_normalize_lemma_names", "description": "", "p": "mathlib"}, {"name": "auto.normalize_hyp", "description": "", "p": "mathlib"}, {"name": "auto.split_hyps", "description": "fail if no progress is made", "p": "mathlib"}, {"name": "tactic.interactive.revert_all", "description": "", "p": "mathlib"}, {"name": "auto.eelim", "description": "eliminate an existential quantifier if there is one", "p": "mathlib"}, {"name": "auto.case_option.inhabited", "description": "", "p": "mathlib"}, {"name": "auto.preprocess_hyps", "description": "Eagerly apply all the preprocessing rules", "p": "mathlib"}, {"name": "auto.auto_config", "description": "Configuration information for the auto tactics.\n* `(use_simp := tt)`: call the simplifier\n* `(max_ematch_rounds := 20)`: for the \"done\" tactic", "p": "mathlib"}, {"name": "auto.auto_config.use_simp", "description": "Configuration information for the auto tactics.\n* `(use_simp := tt)`: call the simplifier\n* `(max_ematch_rounds := 20)`: for the \"done\" tactic", "p": "mathlib"}, {"name": "auto.auto_config.max_ematch_rounds", "description": "Configuration information for the auto tactics.\n* `(use_simp := tt)`: call the simplifier\n* `(max_ematch_rounds := 20)`: for the \"done\" tactic", "p": "mathlib"}, {"name": "auto.case_option.decidable_eq", "description": "", "p": "mathlib"}, {"name": "auto.auto_config.decidable_eq", "description": "", "p": "mathlib"}, {"name": "auto.safe_core", "description": "`safe_core s ps cfg opt` negates the goal, normalizes hypotheses\n(by splitting conjunctions, eliminating existentials, pushing negations inwards,\nand calling `simp` with the supplied lemmas `s`), and then tries `contradiction`.\n\nIf this fails, it will create an SMT state and repeatedly use `ematch`\n(using `ematch` lemmas in the environment, universally quantified assumptions,\nand the supplied lemmas `ps`) and congruence closure.\n\n`safe_core` is complete for propositional logic. Depending on the form of `opt`\nit will:\n\n- (if `opt` is `case_option.force`) fail if it does not close the goal,\n- (if `opt` is `case_option.at_most_one`) fail if it produces more than one goal, and\n- (if `opt` is `case_option.accept`) ignore the number of goals it produces.", "p": "mathlib"}, {"name": "auto.clarify", "description": "`clarify` is `safe_core`, but with the `(opt : case_option)`\nparameter fixed at `case_option.at_most_one`.", "p": "mathlib"}, {"name": "auto.finish", "description": "`finish` is `safe_core`, but with the `(opt : case_option)`\nparameter fixed at `case_option.force`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.finish / clarify / safe", "description": "These tactics do straightforward things: they call the simplifier, split conjunctive assumptions,\neliminate existential quantifiers on the left, and look for contradictions. They rely on ematching\nand congruence closure to try to finish off a goal at the end.\n\nThe procedures *do* split on disjunctions and recreate the smt state for each terminal call, so\nthey are only meant to be used on small, straightforward problems.\n\n* `finish`:  solves the goal or fails\n* `clarify`: makes as much progress as possible while not leaving more than one goal\n* `safe`:    splits freely, finishes off whatever subgoals it can, and leaves the rest\n\nAll accept an optional list of simplifier rules, typically definitions that should be expanded.\n(The equations and identities should not refer to the local context.) All also accept an optional\nlist of `ematch` lemmas, which must be preceded by `using`.", "p": "mathlib"}, {"name": "auto.split_hyps_aux", "description": "return `tt` if any progress is made", "p": "mathlib"}, {"name": "auto.not_or_eq", "description": "", "p": "mathlib"}, {"name": "auto.safe", "description": "`safe` is `safe_core`, but with the `(opt : case_option)`\nparameter fixed at `case_option.accept`.", "p": "mathlib"}, {"name": "auto.by_contradiction_trick", "description": "", "p": "mathlib"}, {"name": "auto.case_hyp", "description": "", "p": "mathlib"}, {"name": "auto.case_some_hyp_aux", "description": "", "p": "mathlib"}, {"name": "Top.adj\u2082_counit", "description": "", "p": "mathlib"}, {"name": "Top.adj\u2082_unit", "description": "", "p": "mathlib"}, {"name": "Top.category_theory.forget.category_theory.is_left_adjoint", "description": "", "p": "mathlib"}, {"name": "Top.adj\u2081", "description": " Equipping a type with the discrete topology is left adjoint to the forgetful functor\n`Top \u2964 Type`.", "p": "mathlib"}, {"name": "Top.adj\u2081_unit", "description": "", "p": "mathlib"}, {"name": "Top.adj\u2082", "description": " Equipping a type with the trivial topology is right adjoint to the forgetful functor\n`Top \u2964 Type`.", "p": "mathlib"}, {"name": "Top.category_theory.forget.category_theory.is_right_adjoint", "description": "", "p": "mathlib"}, {"name": "Top.adj\u2081_counit", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.left_derived_obj_projective_zero_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.nat_trans.left_derived_eq", "description": "A component of the natural transformation between left-derived functors can be computed\nusing a chosen projective resolution.", "p": "mathlib"}, {"name": "category_theory.functor.left_derived_obj_projective_succ", "description": "The higher derived functors vanish on projective objects.", "p": "mathlib"}, {"name": "category_theory.functor.left_derived_obj_projective_zero", "description": "The 0-th derived functor of `F` on a projective object `X` is just `F.obj X`.", "p": "mathlib"}, {"name": "category_theory.functor.left_derived_obj_iso", "description": "We can compute a left derived functor using a chosen projective resolution.", "p": "mathlib"}, {"name": "category_theory.functor.left_derived", "description": "The left derived functors of an additive functor.", "p": "mathlib"}, {"name": "category_theory.functor.left_derived_obj_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.nat_trans.left_derived_app", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.left_derived_obj_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.nat_trans.left_derived_id", "description": "", "p": "mathlib"}, {"name": "category_theory.nat_trans.left_derived_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.left_derived_obj_projective_zero_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.left_derived_obj_projective_succ_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.nat_trans.left_derived", "description": "The natural transformation between left-derived functors induced by a natural transformation.", "p": "mathlib"}, {"name": "category_theory.functor.left_derived_map_eq", "description": "We can compute a left derived functor on a morphism using a lift of that morphism\nto a chain map between chosen projective resolutions.", "p": "mathlib"}, {"name": "matrix.exp_diagonal", "description": "", "p": "mathlib"}, {"name": "pi.matrix_algebra", "description": "A special case of `pi.algebra` for when `f = \u03bb i, matrix (m i) (m i) A`.", "p": "mathlib"}, {"name": "matrix.exp_conj'", "description": "", "p": "mathlib"}, {"name": "matrix.is_unit_exp", "description": "", "p": "mathlib"}, {"name": "function.algebra_ring", "description": "A special case of `function.algebra` for when A is a `ring` not a `semiring`", "p": "mathlib"}, {"name": "matrix.exp_conj", "description": "", "p": "mathlib"}, {"name": "function.topological_ring", "description": "A special case of `pi.topological_ring` for when `R` is not dependently typed.", "p": "mathlib"}, {"name": "matrix.exp_zsmul", "description": "", "p": "mathlib"}, {"name": "matrix.exp_sum_of_commute", "description": "", "p": "mathlib"}, {"name": "matrix.exp_units_conj'", "description": "", "p": "mathlib"}, {"name": "matrix.exp_add_of_commute", "description": "", "p": "mathlib"}, {"name": "matrix.exp_conj_transpose", "description": "", "p": "mathlib"}, {"name": "matrix.exp_neg", "description": "", "p": "mathlib"}, {"name": "matrix.exp_block_diagonal", "description": "", "p": "mathlib"}, {"name": "matrix.is_hermitian.exp", "description": "", "p": "mathlib"}, {"name": "matrix.exp_nsmul", "description": "", "p": "mathlib"}, {"name": "matrix.exp_units_conj", "description": "", "p": "mathlib"}, {"name": "matrix.exp_block_diagonal'", "description": "", "p": "mathlib"}, {"name": "matrix.is_symm.exp", "description": "", "p": "mathlib"}, {"name": "pi.matrix_topological_ring", "description": "A special case of `pi.topological_ring` for when `f = \u03bb i, matrix (m i) (m i) A`.", "p": "mathlib"}, {"name": "matrix.exp_transpose", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.mk'", "description": " This is a constructor of `Top.glue_data` whose arguments are in terms of elements and\nintersections rather than subobjects and pullbacks. Please refer to `Top.glue_data.mk_core` for\ndetails.", "p": "mathlib"}, {"name": "Top.glue_data.\u03b9_injective", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.of_open_subsets_to_glue_data_U", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.\u03b9_from_open_subsets_glue_apply", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.rel", "description": "An equivalence relation on `\u03a3 i, D.U i` that holds iff `\ud835\udda3 .\u03b9 i x = \ud835\udda3 .\u03b9 j y`.\nSee `Top.glue_data.\u03b9_eq_iff_rel`.", "p": "mathlib"}, {"name": "Top.glue_data.preimage_range", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.preimage_image_eq_image", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.range_from_open_subsets_glue", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.open_image_open", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.of_open_subsets_to_glue_data_t", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.of_open_subsets", "description": "We may construct a glue data from a family of open sets.", "p": "mathlib"}, {"name": "Top.glue_data.of_open_subsets_to_glue_data_J", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.from_open_subsets_glue_is_open_map", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.\u03b9_open_embedding", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.\u03b9_mono", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.from_open_subsets_glue", "description": "The canonical map from the glue of a family of open subsets `\u03b1` into `\u03b1`.\nThis map is an open embedding (`from_open_subsets_glue_open_embedding`),\nand its range is `\u22c3 i, (U i : set \u03b1)` (`range_from_open_subsets_glue`).", "p": "mathlib"}, {"name": "Top.glue_data.from_open_subsets_glue_open_embedding", "description": "", "p": "mathlib"}, {"name": "Top.glue_data", "description": "A family of gluing data consists of\n1. An index type `J`\n2. An object `U i` for each `i : J`.\n3. An object `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 Top` rather than `J \u2192 J \u2192 Top` to connect to the\n  limits library easier.)\n4. An open embedding `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n    (This merely means that `V i j \u2229 V i k \u2286 t i j \u207b\u00b9' (V j i \u2229 V j k)`.)\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.\n\nMost of the times it would be easier to use the constructor `Top.glue_data.mk'` where the conditions\nare stated in a less categorical way.", "p": "mathlib"}, {"name": "Top.glue_data.to_glue_data", "description": "A family of gluing data consists of\n1. An index type `J`\n2. An object `U i` for each `i : J`.\n3. An object `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 Top` rather than `J \u2192 J \u2192 Top` to connect to the\n  limits library easier.)\n4. An open embedding `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n    (This merely means that `V i j \u2229 V i k \u2286 t i j \u207b\u00b9' (V j i \u2229 V j k)`.)\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.\n\nMost of the times it would be easier to use the constructor `Top.glue_data.mk'` where the conditions\nare stated in a less categorical way.", "p": "mathlib"}, {"name": "Top.glue_data.f_open", "description": "A family of gluing data consists of\n1. An index type `J`\n2. An object `U i` for each `i : J`.\n3. An object `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 Top` rather than `J \u2192 J \u2192 Top` to connect to the\n  limits library easier.)\n4. An open embedding `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n    (This merely means that `V i j \u2229 V i k \u2286 t i j \u207b\u00b9' (V j i \u2229 V j k)`.)\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.\n\nMost of the times it would be easier to use the constructor `Top.glue_data.mk'` where the conditions\nare stated in a less categorical way.", "p": "mathlib"}, {"name": "Top.glue_data.\u03b9_jointly_surjective", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.image_inter", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.\u03b9_eq_iff_rel", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.from_open_subsets_glue_injective", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.open_cover_glue_homeo", "description": "The gluing of an open cover is homeomomorphic to the original space.", "p": "mathlib"}, {"name": "Top.glue_data.eqv_gen_of_\u03c0_eq", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.t'", "description": "(Implementation) the restricted transition map to be fed into `glue_data`.", "p": "mathlib"}, {"name": "Top.glue_data.\u03b9_from_open_subsets_glue", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.preimage_image_eq_image'", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.of_open_subsets_to_glue_data_V", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.t.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.\u03c0_surjective", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.rel_equiv", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.t_inv", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.is_open_iff", "description": "", "p": "mathlib"}, {"name": "Top.glue_data.mk_core", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A bundled topological space `U i` for each `i : J`.\n3. An open set `V i j \u2286 U i` for each `i j : J`.\n4. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `V i i = U i`.\n7. `t i i` is the identity.\n8. For each `x \u2208 V i j \u2229 V i k`, `t i j x \u2208 V j k`.\n9. `t j k (t i j x) = t i k x`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`.", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.J", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A bundled topological space `U i` for each `i : J`.\n3. An open set `V i j \u2286 U i` for each `i j : J`.\n4. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `V i i = U i`.\n7. `t i i` is the identity.\n8. For each `x \u2208 V i j \u2229 V i k`, `t i j x \u2208 V j k`.\n9. `t j k (t i j x) = t i k x`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`.", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.U", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A bundled topological space `U i` for each `i : J`.\n3. An open set `V i j \u2286 U i` for each `i j : J`.\n4. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `V i i = U i`.\n7. `t i i` is the identity.\n8. For each `x \u2208 V i j \u2229 V i k`, `t i j x \u2208 V j k`.\n9. `t j k (t i j x) = t i k x`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`.", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.V", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A bundled topological space `U i` for each `i : J`.\n3. An open set `V i j \u2286 U i` for each `i j : J`.\n4. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `V i i = U i`.\n7. `t i i` is the identity.\n8. For each `x \u2208 V i j \u2229 V i k`, `t i j x \u2208 V j k`.\n9. `t j k (t i j x) = t i k x`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`.", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.t", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A bundled topological space `U i` for each `i : J`.\n3. An open set `V i j \u2286 U i` for each `i j : J`.\n4. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `V i i = U i`.\n7. `t i i` is the identity.\n8. For each `x \u2208 V i j \u2229 V i k`, `t i j x \u2208 V j k`.\n9. `t j k (t i j x) = t i k x`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`.", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.V_id", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A bundled topological space `U i` for each `i : J`.\n3. An open set `V i j \u2286 U i` for each `i j : J`.\n4. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `V i i = U i`.\n7. `t i i` is the identity.\n8. For each `x \u2208 V i j \u2229 V i k`, `t i j x \u2208 V j k`.\n9. `t j k (t i j x) = t i k x`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`.", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.t_id", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A bundled topological space `U i` for each `i : J`.\n3. An open set `V i j \u2286 U i` for each `i j : J`.\n4. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `V i i = U i`.\n7. `t i i` is the identity.\n8. For each `x \u2208 V i j \u2229 V i k`, `t i j x \u2208 V j k`.\n9. `t j k (t i j x) = t i k x`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`.", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.t_inter", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A bundled topological space `U i` for each `i : J`.\n3. An open set `V i j \u2286 U i` for each `i j : J`.\n4. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `V i i = U i`.\n7. `t i i` is the identity.\n8. For each `x \u2208 V i j \u2229 V i k`, `t i j x \u2208 V j k`.\n9. `t j k (t i j x) = t i k x`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`.", "p": "mathlib"}, {"name": "Top.glue_data.mk_core.cocycle", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A bundled topological space `U i` for each `i : J`.\n3. An open set `V i j \u2286 U i` for each `i j : J`.\n4. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `V i i = U i`.\n7. `t i i` is the identity.\n8. For each `x \u2208 V i j \u2229 V i k`, `t i j x \u2208 V j k`.\n9. `t j k (t i j x) = t i k x`.\n\nWe can then glue the topological spaces `U i` together by identifying `V i j` with `V j i`.", "p": "mathlib"}, {"name": "Top.glue_data.of_open_subsets_to_glue_data_f", "description": "", "p": "mathlib"}, {"name": "add_circle.closed_ball_eq_univ_of_half_period_le", "description": "", "p": "mathlib"}, {"name": "add_circle.normed_add_comm_group", "description": "", "p": "mathlib"}, {"name": "add_circle.coe_real_preimage_closed_ball_eq_Union", "description": "", "p": "mathlib"}, {"name": "add_circle.norm_eq_of_zero", "description": "", "p": "mathlib"}, {"name": "add_circle.coe_real_preimage_closed_ball_inter_eq", "description": "", "p": "mathlib"}, {"name": "add_circle.norm_coe_mul", "description": "", "p": "mathlib"}, {"name": "unit_add_circle.norm_eq", "description": "", "p": "mathlib"}, {"name": "add_circle.norm_div_nat_cast", "description": "", "p": "mathlib"}, {"name": "add_circle.norm_eq", "description": "", "p": "mathlib"}, {"name": "add_circle.norm_eq'", "description": "", "p": "mathlib"}, {"name": "add_circle.norm_neg_period", "description": "", "p": "mathlib"}, {"name": "add_circle.norm_le_half_period", "description": "", "p": "mathlib"}, {"name": "add_circle.norm_half_period_eq", "description": "", "p": "mathlib"}, {"name": "add_circle.exists_norm_eq_of_fin_add_order", "description": "", "p": "mathlib"}, {"name": "add_circle.norm_coe_eq_abs_iff", "description": "", "p": "mathlib"}, {"name": "add_circle.le_add_order_smul_norm_of_is_of_fin_add_order", "description": "", "p": "mathlib"}, {"name": "add_circle.coe_real_preimage_closed_ball_period_zero", "description": "", "p": "mathlib"}, {"name": "analytic_on.is_constant_or_is_open", "description": " The *open mapping theorem* for holomorphic functions, global version: if a function `g : E \u2192 \u2102`\nis analytic on a connected set `U`, then either it is constant on `U`, or it is open on `U` (in the\nsense that it maps any open set contained in `U` to an open set in `\u2102`).", "p": "mathlib"}, {"name": "diff_cont_on_cl.ball_subset_image_closed_ball", "description": " If the modulus of a holomorphic function `f` is bounded below by `\u03b5` on a circle, then its range\ncontains a disk of radius `\u03b5 / 2`.", "p": "mathlib"}, {"name": "analytic_at.eventually_constant_or_nhds_le_map_nhds", "description": " The *open mapping theorem* for holomorphic functions, local version: is a function `g : E \u2192 \u2102`\nis analytic at a point `z\u2080`, then either it is constant in a neighborhood of `z\u2080`, or it maps every\nneighborhood of `z\u2080` to a neighborhood of `z\u2080`. For the particular case of a holomorphic function on\n`\u2102`, see `analytic_at.eventually_constant_or_nhds_le_map_nhds_aux`.", "p": "mathlib"}, {"name": "analytic_at.eventually_constant_or_nhds_le_map_nhds_aux", "description": " A function `f : \u2102 \u2192 \u2102` which is analytic at a point `z\u2080` is either constant in a neighborhood\nof `z\u2080`, or behaves locally like an open function (in the sense that the image of every neighborhood\nof `z\u2080` is a neighborhood of `f z\u2080`, as in `is_open_map_iff_nhds_le`). For a function `f : E \u2192 \u2102`\nthe same result holds, see `analytic_at.eventually_constant_or_nhds_le_map_nhds`.", "p": "mathlib"}, {"name": "enat.to_ennreal_order_embedding_apply", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_max", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_le", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_bit1", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_add", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_lt", "description": "", "p": "mathlib"}, {"name": "enat.has_coe_ennreal", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_one", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_sub", "description": "", "p": "mathlib"}, {"name": "enat.to_ennreal_order_embedding", "description": "Coercion `\u2115\u221e \u2192 \u211d\u22650\u221e` as an `order_embedding`.", "p": "mathlib"}, {"name": "enat.coe_ennreal_mul", "description": "", "p": "mathlib"}, {"name": "enat.map_coe_nnreal", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_zero", "description": "", "p": "mathlib"}, {"name": "enat.to_ennreal_ring_hom", "description": "Coercion `\u2115\u221e \u2192 \u211d\u22650\u221e` as a ring homomorphism.", "p": "mathlib"}, {"name": "enat.coe_ennreal_coe", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_bit0", "description": "", "p": "mathlib"}, {"name": "enat.to_ennreal_ring_hom_apply", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_strict_mono", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_top", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_min", "description": "", "p": "mathlib"}, {"name": "enat.coe_ennreal_mono", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_add", "description": "", "p": "mathlib"}, {"name": "smooth_map.comp_left_add_monoid_hom", "description": "For a manifold `N` and a smooth homomorphism `\u03c6` between additive Lie groups `G'`,\n`G''`, the 'left-composition-by-`\u03c6`' group homomorphism from `C^\u221e\u27eeI, N; I', G'\u27ef` to\n`C^\u221e\u27eeI, N; I'', G''\u27ef`.", "p": "mathlib"}, {"name": "smooth_map.add_monoid", "description": "", "p": "mathlib"}, {"name": "smooth_map.smul_comp", "description": "", "p": "mathlib"}, {"name": "smooth_map.comp_left_monoid_hom", "description": " For a manifold `N` and a smooth homomorphism `\u03c6` between Lie groups `G'`, `G''`, the\n'left-composition-by-`\u03c6`' group homomorphism from `C^\u221e\u27eeI, N; I', G'\u27ef` to `C^\u221e\u27eeI, N; I'', G''\u27ef`.", "p": "mathlib"}, {"name": "smooth_map.comm_group", "description": "", "p": "mathlib"}, {"name": "smooth_map.eval_ring_hom", "description": "`function.eval` as a `ring_hom` on the ring of smooth functions.", "p": "mathlib"}, {"name": "smooth_map.restrict_add_monoid_hom", "description": "For an additive Lie group `G` and open sets `U \u2286 V` in `N`, the 'restriction' group\nhomomorphism from `C^\u221e\u27eeI, V; I', G\u27ef` to `C^\u221e\u27eeI, U; I', G\u27ef`.", "p": "mathlib"}, {"name": "smooth_map.module", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_fn_ring_hom", "description": "Coercion to a function as a `ring_hom`.", "p": "mathlib"}, {"name": "smooth_map.module'", "description": "", "p": "mathlib"}, {"name": "smooth_map.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "smooth_map.comm_ring", "description": "", "p": "mathlib"}, {"name": "smooth_map.comp_left_ring_hom", "description": " For a manifold `N` and a smooth homomorphism `\u03c6` between smooth rings `R'`, `R''`, the\n'left-composition-by-`\u03c6`' ring homomorphism from `C^\u221e\u27eeI, N; I', R'\u27ef` to `C^\u221e\u27eeI, N; I'', R''\u27ef`.", "p": "mathlib"}, {"name": "smooth_map.algebra", "description": "", "p": "mathlib"}, {"name": "smooth_map.add_comm_group", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_fn_monoid_hom", "description": "Coercion to a function as an `monoid_hom`. Similar to `monoid_hom.coe_fn`.", "p": "mathlib"}, {"name": "smooth_map.has_one", "description": "", "p": "mathlib"}, {"name": "smooth_map.add_comp", "description": "", "p": "mathlib"}, {"name": "smooth_map.has_smul", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_fn_alg_hom", "description": "Coercion to a function as an `alg_hom`.", "p": "mathlib"}, {"name": "smooth_map.restrict_ring_hom", "description": " For a \"smooth ring\" `R` and open sets `U \u2286 V` in `N`, the \"restriction\" ring homomorphism from\n`C^\u221e\u27eeI, V; I', R\u27ef` to `C^\u221e\u27eeI, U; I', R\u27ef`.", "p": "mathlib"}, {"name": "smooth_map.has_zero", "description": "", "p": "mathlib"}, {"name": "smooth_map.comm_monoid", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_fn_add_monoid_hom", "description": "Coercion to a function as an `add_monoid_hom`. Similar to `add_monoid_hom.coe_fn`.", "p": "mathlib"}, {"name": "smooth_map.semiring", "description": "", "p": "mathlib"}, {"name": "smooth_map.add_semigroup", "description": "", "p": "mathlib"}, {"name": "smooth_map.mul_comp", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_fn_ring_hom_apply", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_inv", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_fn_alg_hom_apply", "description": "", "p": "mathlib"}, {"name": "smooth_map.ring", "description": "", "p": "mathlib"}, {"name": "smooth_map.monoid", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_zero", "description": "", "p": "mathlib"}, {"name": "smooth_map.has_add", "description": "", "p": "mathlib"}, {"name": "smooth_map.add_group", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_mul", "description": "", "p": "mathlib"}, {"name": "smooth_map.C", "description": "Smooth constant functions as a `ring_hom`.", "p": "mathlib"}, {"name": "smooth_map.coe_smul", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_fn_linear_map", "description": "Coercion to a function as a `linear_map`.", "p": "mathlib"}, {"name": "smooth_map.coe_fn_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_div", "description": "", "p": "mathlib"}, {"name": "smooth_map.smul_comp'", "description": "", "p": "mathlib"}, {"name": "smooth_map.group", "description": "", "p": "mathlib"}, {"name": "smooth_map.semigroup", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_fn_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "smooth_map.restrict_monoid_hom", "description": " For a Lie group `G` and open sets `U \u2286 V` in `N`, the 'restriction' group homomorphism from\n`C^\u221e\u27eeI, V; I', G\u27ef` to `C^\u221e\u27eeI, U; I', G\u27ef`.", "p": "mathlib"}, {"name": "smooth_map.coe_fn_linear_map_apply", "description": "", "p": "mathlib"}, {"name": "smooth_map.has_mul", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_one", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_neg", "description": "", "p": "mathlib"}, {"name": "smooth_map.coe_sub", "description": "", "p": "mathlib"}, {"name": "smooth_map.has_smul'", "description": "", "p": "mathlib"}, {"name": "nat.succ_le_succ_sqrt'", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_eq", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_le_self", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_le_sqrt", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_lt_self", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_le'", "description": "", "p": "mathlib"}, {"name": "nat.lt_succ_sqrt'", "description": "", "p": "mathlib"}, {"name": "nat.exists_mul_self", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_one", "description": "", "p": "mathlib"}, {"name": "nat.eq_sqrt'", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_mul_sqrt_lt_succ'", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_aux_dec", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_mul_sqrt_lt_succ", "description": "", "p": "mathlib"}, {"name": "nat.lt_succ_sqrt", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_pos", "description": "", "p": "mathlib"}, {"name": "nat.not_exists_sq'", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_le_add", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_aux_1", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_aux", "description": " Auxiliary function for `nat.sqrt`. See e.g.\n<https://en.wikipedia.org/wiki/Methods_of_computing_square_roots#Binary_numeral_system_(base_2)>", "p": "mathlib"}, {"name": "nat.sqrt_aux_0", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_succ_le_succ_sqrt", "description": "", "p": "mathlib"}, {"name": "nat.sqrt", "description": "`sqrt n` is the square root of a natural number `n`. If `n` is not a\n perfect square, it returns the largest `k:\u2115` such that `k*k \u2264 n`.", "p": "mathlib"}, {"name": "nat.eq_sqrt", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_add_eq'", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_lt'", "description": "", "p": "mathlib"}, {"name": "nat.succ_le_succ_sqrt", "description": "", "p": "mathlib"}, {"name": "nat.le_sqrt", "description": "", "p": "mathlib"}, {"name": "nat.exists_mul_self'", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_aux_2", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_lt", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_zero", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_eq_zero", "description": "", "p": "mathlib"}, {"name": "nat.le_three_of_sqrt_eq_one", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_add_eq", "description": "", "p": "mathlib"}, {"name": "nat.sqrt_eq'", "description": "", "p": "mathlib"}, {"name": "nat.not_exists_sq", "description": "There are no perfect squares strictly between m\u00b2 and (m+1)\u00b2", "p": "mathlib"}, {"name": "nat.sqrt_le", "description": "", "p": "mathlib"}, {"name": "nat.le_sqrt'", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.aeval_algebra_map_eq_zero_iff_of_injective", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.aeval_algebra_map_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "subalgebra.mv_polynomial_aeval_coe", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.aeval_map_algebra_map", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.aeval_algebra_map_apply", "description": "", "p": "mathlib"}, {"name": "continuous_map.le_def", "description": "", "p": "mathlib"}, {"name": "continuous_map.inf_coe", "description": "", "p": "mathlib"}, {"name": "continuous_map.coe_Icc_extend", "description": "", "p": "mathlib"}, {"name": "continuous_map.semilattice_inf", "description": "", "p": "mathlib"}, {"name": "continuous_map.partial_order", "description": "", "p": "mathlib"}, {"name": "continuous_map.abs_apply", "description": "", "p": "mathlib"}, {"name": "continuous_map.inf'_coe", "description": "", "p": "mathlib"}, {"name": "continuous_map.Icc_extend", "description": "Extend a continuous function `f : C(set.Icc a b, \u03b2)` to a function `f : C(\u03b1, \u03b2)`.", "p": "mathlib"}, {"name": "continuous_map.lattice", "description": "", "p": "mathlib"}, {"name": "continuous_map.sup_coe", "description": "", "p": "mathlib"}, {"name": "continuous_map.inf_apply", "description": "", "p": "mathlib"}, {"name": "continuous_map.sup'_coe", "description": "", "p": "mathlib"}, {"name": "continuous_map.has_abs", "description": "", "p": "mathlib"}, {"name": "continuous_map.lt_def", "description": "", "p": "mathlib"}, {"name": "continuous_map.sup'_apply", "description": "", "p": "mathlib"}, {"name": "continuous_map.sup_apply", "description": "", "p": "mathlib"}, {"name": "continuous_map.semilattice_sup", "description": "", "p": "mathlib"}, {"name": "continuous_map.inf'_apply", "description": "", "p": "mathlib"}, {"name": "continuous_map.has_inf", "description": "", "p": "mathlib"}, {"name": "continuous_map.has_sup", "description": "", "p": "mathlib"}, {"name": "continuous_map.abs", "description": "The pointwise absolute value of a continuous function as a continuous function.", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_sub'", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_sub", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_eq.congr_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_add'", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_to_real", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_eq_with_density_pos_part_sub_with_density_neg_part", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_neg'", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.with_density\u1d65_absolutely_continuous", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.integrable.with_density\u1d65_trim_absolutely_continuous", "description": "", "p": "mathlib"}, {"name": "measure_theory.integrable.with_density\u1d65_trim_eq_integral", "description": "", "p": "mathlib"}, {"name": "measure_theory.integrable.with_density\u1d65_eq_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density\u1d65_smul'", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.with_density\u1d65", "description": " Given a measure `\u03bc` and an integrable function `f`, `\u03bc.with_density\u1d65 f` is\nthe vector measure which maps the set `s` to `\u222b\u209b f \u2202\u03bc`.", "p": "mathlib"}, {"name": "measure_theory.integrable.ae_eq_of_with_density\u1d65_eq", "description": "Having the same density implies the underlying functions are equal almost everywhere.", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_morphism\u2081_hom\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_morphism\u2082", "description": "The second morphism of triangles given an octahedron.", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_obj\u2083", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_mor\u2083", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.some_octahedron", "description": "A choice of octahedron given by the octahedron axiom.", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_mor\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.comm\u2082_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.is_triangulated", "description": " A triangulated category is a pretriangulated category which satisfies\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.is_triangulated.octahedron_axiom", "description": " A triangulated category is a pretriangulated category which satisfies\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_morphism\u2082_hom\u2081", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_morphism\u2082_hom\u2083", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_mor\u2081", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_obj\u2081", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_morphism\u2082_hom\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.comm\u2081_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.nonempty", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.comm\u2084_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron", "description": " An octahedron is a type of datum whose existence is asserted by\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.m\u2081", "description": " An octahedron is a type of datum whose existence is asserted by\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.m\u2083", "description": " An octahedron is a type of datum whose existence is asserted by\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.comm\u2081", "description": " An octahedron is a type of datum whose existence is asserted by\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.comm\u2082", "description": " An octahedron is a type of datum whose existence is asserted by\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.comm\u2083", "description": " An octahedron is a type of datum whose existence is asserted by\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.comm\u2084", "description": " An octahedron is a type of datum whose existence is asserted by\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.mem", "description": " An octahedron is a type of datum whose existence is asserted by\nthe octahedron axiom (TR 4), see https://stacks.math.columbia.edu/tag/05QK", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.comm\u2083_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle", "description": "The triangle `Z\u2081\u2082 \u27f6 Z\u2081\u2083 \u27f6 Z\u2082\u2083 \u27f6 Z\u2081\u2082\u27e61\u27e7` given by an octahedron.", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_morphism\u2081_hom\u2083", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_obj\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_morphism\u2081", "description": "The first morphism of triangles given by an octahedron.", "p": "mathlib"}, {"name": "category_theory.triangulated.octahedron.triangle_morphism\u2081_hom\u2081", "description": "", "p": "mathlib"}, {"name": "support_comp_inv_smul", "description": "", "p": "mathlib"}, {"name": "support_comp_inv_smul\u2080", "description": "", "p": "mathlib"}, {"name": "mul_support_comp_inv_smul", "description": "", "p": "mathlib"}, {"name": "mul_support_comp_inv_smul\u2080", "description": "", "p": "mathlib"}, {"name": "fermat_psp.frequently_at_top_fermat_psp", "description": "", "p": "mathlib"}, {"name": "fermat_psp.coprime_of_fermat_psp", "description": "If `n` is a Fermat pseudoprime to base `b`, then `n` is coprime with `b`, assuming that `b` is\npositive.\n\nThis lemma is a small wrapper based on `coprime_of_probable_prime`", "p": "mathlib"}, {"name": "fermat_psp.probable_prime", "description": "`n` is a probable prime to base `b` if `n` passes the Fermat primality test; that is, `n` divides\n`b ^ (n - 1) - 1`.\nThis definition implies that all numbers are probable primes to base 0 or 1, and that 0 and 1 are\nprobable primes to any base.", "p": "mathlib"}, {"name": "fermat_psp.decidable_psp", "description": "", "p": "mathlib"}, {"name": "fermat_psp.coprime_of_probable_prime", "description": "If `n` passes the Fermat primality test to base `b`, then `n` is coprime with `b`, assuming that\n`n` and `b` are both positive.", "p": "mathlib"}, {"name": "fermat_psp.probable_prime_iff_modeq", "description": "", "p": "mathlib"}, {"name": "fermat_psp.decidable_probable_prime", "description": "", "p": "mathlib"}, {"name": "fermat_psp", "description": "`n` is a Fermat pseudoprime to base `b` if `n` is a probable prime to base `b` and is composite. By\nthis definition, all composite natural numbers are pseudoprimes to base 0 and 1. This definition\nalso permits `n` to be less than `b`, so that 4 is a pseudoprime to base 5, for example.", "p": "mathlib"}, {"name": "fermat_psp.infinite_set_of_prime_modeq_one", "description": "Infinite set variant of `exists_infinite_pseudoprimes`", "p": "mathlib"}, {"name": "fermat_psp.base_one", "description": "All composite numbers are Fermat pseudoprimes to base 1.", "p": "mathlib"}, {"name": "fermat_psp.exists_infinite_pseudoprimes", "description": "For all positive bases, there exist Fermat infinite pseudoprimes to that base.\nGiven in this form: for all numbers `b \u2265 1` and `m`, there exists a pseudoprime `n` to base `b` such\nthat `m \u2264 n`. This form is similar to `nat.exists_infinite_primes`.", "p": "mathlib"}, {"name": "with_ideal.uniform_space", "description": "", "p": "mathlib"}, {"name": "with_ideal.topological_space_module", "description": " The adic topology on a `R` module coming from the ideal `with_ideal.I`.\nThis cannot be an instance because `R` cannot be inferred from `M`.", "p": "mathlib"}, {"name": "ideal.has_basis_nhds_adic", "description": "", "p": "mathlib"}, {"name": "ideal.open_add_subgroup", "description": " The elements of the basis of neighborhoods of zero for the `I`-adic topology\non a `R`-module `M`, seen as open additive subgroups of `M`.", "p": "mathlib"}, {"name": "ideal.nonarchimedean", "description": "", "p": "mathlib"}, {"name": "ideal.adic_module_basis", "description": "", "p": "mathlib"}, {"name": "with_ideal", "description": "The ring `R` is equipped with a preferred ideal.", "p": "mathlib"}, {"name": "with_ideal.I", "description": "The ring `R` is equipped with a preferred ideal.", "p": "mathlib"}, {"name": "ideal.adic_module_topology", "description": " The topology on a `R`-module `M` associated to an ideal `M`. Submodules $I^n M$,\nwritten `I^n \u2022 \u22a4` form a basis of neighborhoods of zero.", "p": "mathlib"}, {"name": "is_ideal_adic_pow", "description": "", "p": "mathlib"}, {"name": "ideal.adic_topology", "description": " The adic topology associated to an ideal `I`. This topology admits powers of `I` as a basis of\nneighborhoods of zero. It is compatible with the ring structure and is non-archimedean.", "p": "mathlib"}, {"name": "is_bot_adic_iff", "description": "", "p": "mathlib"}, {"name": "ideal.ring_filter_basis", "description": "The adic ring filter basis associated to an ideal `I` is made of powers of `I`.", "p": "mathlib"}, {"name": "ideal.has_basis_nhds_zero_adic", "description": "For the `I`-adic topology, the neighborhoods of zero has basis given by the powers of `I`.", "p": "mathlib"}, {"name": "with_ideal.nonarchimedean_ring", "description": "", "p": "mathlib"}, {"name": "is_adic_iff", "description": " A topological ring is `J`-adic if and only if it admits the powers of `J` as a basis of\nopen neighborhoods of zero.", "p": "mathlib"}, {"name": "is_adic", "description": " Given a topology on a ring `R` and an ideal `J`, `is_adic J` means the topology is the\n`J`-adic one.", "p": "mathlib"}, {"name": "with_ideal.uniform_add_group", "description": "", "p": "mathlib"}, {"name": "ideal.adic_basis", "description": "", "p": "mathlib"}, {"name": "with_ideal.topological_space", "description": "", "p": "mathlib"}, {"name": "print_warning", "description": "Formats a linter warning as `#check` command with comment.", "p": "mathlib"}, {"name": "tactic_doc.hole_command.Lint", "description": "Invoking the hole command `lint` (\"Find common mistakes in current file\") will print text that\nindicates mistakes made in the file above the command. It is equivalent to copying and pasting the\noutput of `#lint`. On large files, it may take some time before the output appears.", "p": "mathlib"}, {"name": "print_workflow_command", "description": "Prints a workflow command to emit an error understood by github in an actions workflow.\nThis enables CI to tag the parts of the file where linting failed with annotations, and makes it\neasier for mathlib contributors to see what needs fixing.\nSee https://docs.github.com/en/actions/learn-github-actions/workflow-commands-for-github-actions#setting-an-error-message", "p": "mathlib"}, {"name": "lint_cmd", "description": " The command `#lint` at the bottom of a file will warn you about some common mistakes\nin that file. Usage: `#lint`, `#lint linter_1 linter_2`, `#lint only linter_1 linter_2`.\n`#lint-` will suppress the output if all checks pass.\n`#lint+` will enable verbose output.\n\nUse the command `#list_linters` to see all available linters.", "p": "mathlib"}, {"name": "sort_results", "description": "Sorts a map with declaration keys as names by line number.", "p": "mathlib"}, {"name": "lint", "description": "Return the message printed by `#lint` and a `name_set` containing all declarations that fail.", "p": "mathlib"}, {"name": "lint_project", "description": " Returns the linter message by running the linter on all declarations in project `proj_name` in\nfolder `proj_folder`. It also returns a `name_set` containing all declarations that fail.\n\nTo add a linter command for your own project, write\n```lean\nopen lean.parser lean tactic interactive\n@[user_command] meta def lint_my_project_cmd (_ : parse $ tk \"#lint_my_project\") : parser unit :=\ndo str \u2190 get_project_dir n k, lint_cmd_aux (@lint_project str \"my project\")\n```\nHere `n` is the name of any declaration in the project (like `` `lint_my_project_cmd`` and `k` is\nthe number of characters in the filename of `n` *after* the `src/` directory\n(so e.g. the number of characters in `tactic/lint/frontend.lean`).\nWarning: the linter will not work in the file where `n` is declared.", "p": "mathlib"}, {"name": "lint_all_cmd", "description": " The command `#lint_all` checks all imported files for certain mistakes.\nUsage: `#lint_all`, `#lint_all linter_1 linter_2`, `#lint_all only linter_1 linter_2`.\n`#lint_all-` will suppress the output if all checks pass.\n`lint_all+` will enable verbose output.\n\nUse the command `#list_linters` to see all available linters.", "p": "mathlib"}, {"name": "format_linter_results", "description": "Formats the linter results as Lean code with comments and `#check` commands.", "p": "mathlib"}, {"name": "lint_verbosity", "description": "Verbosity for the linter output.\n* `low`: only print failing checks, print nothing on success.\n* `medium`: only print failing checks, print confirmation on success.\n* `high`: print output of every check.", "p": "mathlib"}, {"name": "lint_verbosity.low", "description": "Verbosity for the linter output.\n* `low`: only print failing checks, print nothing on success.\n* `medium`: only print failing checks, print confirmation on success.\n* `high`: print output of every check.", "p": "mathlib"}, {"name": "lint_verbosity.medium", "description": "Verbosity for the linter output.\n* `low`: only print failing checks, print nothing on success.\n* `medium`: only print failing checks, print confirmation on success.\n* `high`: print output of every check.", "p": "mathlib"}, {"name": "lint_verbosity.high", "description": "Verbosity for the linter output.\n* `low`: only print failing checks, print nothing on success.\n* `medium`: only print failing checks, print confirmation on success.\n* `high`: print output of every check.", "p": "mathlib"}, {"name": "lint_cmd_aux", "description": "The common denominator of `lint_cmd`, `lint_mathlib_cmd`, `lint_all_cmd`", "p": "mathlib"}, {"name": "lint_project_decls", "description": "Returns the declarations in the folder `proj_folder`.", "p": "mathlib"}, {"name": "lint_verbosity.inhabited", "description": "", "p": "mathlib"}, {"name": "lint_hole_cmd", "description": "Invoking the hole command `lint` (\"Find common mistakes in current file\") will print text that\nindicates mistakes made in the file above the command. It is equivalent to copying and pasting the\noutput of `#lint`. On large files, it may take some time before the output appears.", "p": "mathlib"}, {"name": "escape_workflow_command", "description": "Escape characters that may not be used in a workflow commands, following\nhttps://github.com/actions/toolkit/blob/7257597d731b34d14090db516d9ea53439300e98/packages/core/src/command.ts#L92-L105", "p": "mathlib"}, {"name": "parse_verbosity", "description": "Parses a \"-\" or \"+\", returning `lint_verbosity.low` or `lint_verbosity.high` respectively,\nor returns `none`.", "p": "mathlib"}, {"name": "lint_verbosity.decidable_eq", "description": "", "p": "mathlib"}, {"name": "list_linters", "description": "The command `#list_linters` prints a list of all available linters.", "p": "mathlib"}, {"name": "lint_aux", "description": " The common denominator of `#lint[|mathlib|all]`.\nThe different commands have different configurations for `l`,\n`group_by_filename` and `where_desc`.\nIf `slow` is false, doesn't do the checks that take a lot of time.\nIf `verbose` is false, it will suppress messages from passing checks.\nBy setting `checks` you can customize which checks are performed.\n\nReturns a `name_set` containing the names of all declarations that fail any check in `check`,\nand a `format` object describing the failures.", "p": "mathlib"}, {"name": "grouped_by_filename", "description": "Formats a map of linter warnings grouped by filename with `-- filename` comments.\nThe first `drop_fn_chars` characters are stripped from the filename.", "p": "mathlib"}, {"name": "get_checks", "description": " `get_checks slow extra use_only` produces a list of linters.\n`extras` is a list of names that should resolve to declarations with type `linter`.\nIf `use_only` is true, it only uses the linters in `extra`.\nOtherwise, it uses all linters in the environment tagged with `@[linter]`.\nIf `slow` is false, it only uses the fast default tests.", "p": "mathlib"}, {"name": "parse_lint_additions", "description": " Parses an optional `only`, followed by a sequence of zero or more identifiers.\nPrepends `linter.` to each of these identifiers.", "p": "mathlib"}, {"name": "lint_all", "description": " Return the message printed by `#lint_all` and a `name_set` containing all declarations\nthat fail.", "p": "mathlib"}, {"name": "lint_mathlib_cmd", "description": " The command `#lint_mathlib` checks all of mathlib for certain mistakes.\nUsage: `#lint_mathlib`, `#lint_mathlib linter_1 linter_2`, `#lint_mathlib only linter_1 linter_2`.\n`#lint_mathlib-` will suppress the output if all checks pass.\n`lint_mathlib+` will enable verbose output.\n\nUse the command `#list_linters` to see all available linters.", "p": "mathlib"}, {"name": "print_warnings", "description": "Formats a map of linter warnings using `print_warning`, sorted by line number.", "p": "mathlib"}, {"name": "lint_core", "description": "`lint_core all_decls non_auto_decls checks` applies the linters `checks` to the list of\ndeclarations.\nIf `auto_decls` is false for a linter (default) the linter is applied to `non_auto_decls`.\nIf `auto_decls` is true, then it is applied to `all_decls`.\nThe resulting list has one element for each linter, containing the linter as\nwell as a map from declaration name to warning.", "p": "mathlib"}, {"name": "complex.circle_integral_div_sub_of_differentiable_on_off_countable", "description": " **Cauchy integral formula**: if `f : \u2102 \u2192 \u2102` is continuous on a closed disc of radius `R` and is\ncomplex differentiable at all but countably many points of its interior, then for any `w` in this\ninterior we have $\\oint_{|z-c|=R}\\frac{f(z)}{z-w}dz=2\\pi i\\,f(w)$.", "p": "mathlib"}, {"name": "complex.integral_boundary_rect_of_continuous_on_of_has_fderiv_at_real", "description": " Suppose that a function `f : \u2102 \u2192 E` is continuous on a closed rectangle with opposite corners at\n`z w : \u2102`, is *real* differentiable on the corresponding open rectangle, and\n$\\frac{\\partial f}{\\partial \\bar z}$ is integrable on this rectangle. Then the integral of `f` over\nthe boundary of the rectangle is equal to the integral of\n$2i\\frac{\\partial f}{\\partial \\bar z}=i\\frac{\\partial f}{\\partial x}-\\frac{\\partial f}{\\partial y}$\nover the rectangle.", "p": "mathlib"}, {"name": "complex.integral_boundary_rect_eq_zero_of_continuous_on_of_differentiable_on", "description": " **Cauchy-Goursat theorem for a rectangle**: the integral of a complex differentiable function\nover the boundary of a rectangle equals zero. More precisely, if `f` is continuous on a closed\nrectangle and is complex differentiable on the corresponding open rectangle, then its integral over\nthe boundary of the rectangle equals zero.", "p": "mathlib"}, {"name": "complex.integral_boundary_rect_eq_zero_of_differentiable_on", "description": " **Cauchy-Goursat theorem** for a rectangle: the integral of a complex differentiable function\nover the boundary of a rectangle equals zero. More precisely, if `f` is complex differentiable on a\nclosed rectangle, then its integral over the boundary of the rectangle equals zero.", "p": "mathlib"}, {"name": "differentiable_on.circle_integral_sub_inv_smul", "description": " **Cauchy integral formula**: if `f : \u2102 \u2192 E` is complex differentiable on a closed disc of radius\n`R`, then for any `w` in its interior we have $\\oint_{|z-c|=R}(z-w)^{-1}f(z)\\,dz=2\u03c0if(w)$.", "p": "mathlib"}, {"name": "diff_cont_on_cl.two_pi_I_inv_smul_circle_integral_sub_inv_smul", "description": " **Cauchy integral formula**: if `f : \u2102 \u2192 E` is complex differentiable on an open disc and is\ncontinuous on its closure, then for any `w` in this open ball we have\n$\\frac{1}{2\u03c0i}\\oint_{|z-c|=R}(z-w)^{-1}f(z)\\,dz=f(w)$.", "p": "mathlib"}, {"name": "complex.two_pi_I_inv_smul_circle_integral_sub_inv_smul_of_differentiable_on_off_countable", "description": " **Cauchy integral formula**: if `f : \u2102 \u2192 E` is continuous on a closed disc of radius `R` and is\ncomplex differentiable at all but countably many points of its interior, then for any `w` in this\ninterior we have $\\frac{1}{2\u03c0i}\\oint_{|z-c|=R}(z-w)^{-1}f(z)\\,dz=f(w)$.", "p": "mathlib"}, {"name": "complex.circle_integral_eq_of_differentiable_on_annulus_off_countable", "description": " **Cauchy-Goursat theorem** for an annulus. If `f : \u2102 \u2192 E` is continuous on the closed annulus\n`r \u2264 \u2016z - c\u2016 \u2264 R`, `0 < r \u2264 R`, and is complex differentiable at all but countably many points of\nits interior, then the integrals of `f` over the circles `\u2016z - c\u2016 = r` and `\u2016z - c\u2016 = R` are equal\nto each other.", "p": "mathlib"}, {"name": "complex.circle_integral_sub_center_inv_smul_of_differentiable_on_off_countable", "description": " **Cauchy integral formula** for the value at the center of a disc. If `f : \u2102 \u2192 E` is continuous\non a closed disc of radius `R` and is complex differentiable at all but countably many points of its\ninterior, then the integral $\\oint_{|z-c|=R} \\frac{f(z)}{z-c}\\,dz$ is equal to $2\u03c0iy`.", "p": "mathlib"}, {"name": "complex.circle_integral_sub_inv_smul_of_differentiable_on_off_countable_aux", "description": " An auxiliary lemma for\n`complex.circle_integral_sub_inv_smul_of_differentiable_on_off_countable`. This lemma assumes\n`w \u2209 s` while the main lemma drops this assumption.", "p": "mathlib"}, {"name": "complex.circle_integral_eq_zero_of_differentiable_on_off_countable", "description": " **Cauchy-Goursat theorem** for a disk: if `f : \u2102 \u2192 E` is continuous on a closed disk\n`{z | \u2016z - c\u2016 \u2264 R}` and is complex differentiable at all but countably many points of its interior,\nthen the integral $\\oint_{|z-c|=R}f(z)\\,dz$ equals zero.", "p": "mathlib"}, {"name": "complex.has_fpower_series_on_ball_of_differentiable_off_countable", "description": " If `f : \u2102 \u2192 E` is continuous on a closed ball of positive radius and is differentiable at all\nbut countably many points of the corresponding open ball, then it is analytic on the open ball with\ncoefficients of the power series given by Cauchy integral formulas.", "p": "mathlib"}, {"name": "differentiable_on.analytic_at", "description": " If `f : \u2102 \u2192 E` is complex differentiable on some set `s`, then it is analytic at any point `z`\nsuch that `s \u2208 \ud835\udcdd z` (equivalently, `z \u2208 interior s`).", "p": "mathlib"}, {"name": "diff_cont_on_cl.circle_integral_sub_inv_smul", "description": " **Cauchy integral formula**: if `f : \u2102 \u2192 E` is complex differentiable on an open disc and is\ncontinuous on its closure, then for any `w` in this open ball we have\n$\\oint_{|z-c|=R}(z-w)^{-1}f(z)\\,dz=2\u03c0if(w)$.", "p": "mathlib"}, {"name": "differentiable.analytic_at", "description": "A complex differentiable function `f : \u2102 \u2192 E` is analytic at every point.", "p": "mathlib"}, {"name": "differentiable_on.analytic_on", "description": "", "p": "mathlib"}, {"name": "complex.integral_boundary_rect_eq_zero_of_differentiable_on_off_countable", "description": " **Cauchy-Goursat theorem** for a rectangle: the integral of a complex differentiable function\nover the boundary of a rectangle equals zero. More precisely, if `f` is continuous on a closed\nrectangle and is complex differentiable at all but countably many points of the corresponding open\nrectangle, then its integral over the boundary of the rectangle equals zero.", "p": "mathlib"}, {"name": "complex.integral_boundary_rect_of_has_fderiv_at_real_off_countable", "description": " Suppose that a function `f : \u2102 \u2192 E` is continuous on a closed rectangle with opposite corners at\n`z w : \u2102`, is *real* differentiable at all but countably many points of the corresponding open\nrectangle, and $\\frac{\\partial f}{\\partial \\bar z}$ is integrable on this rectangle. Then the\nintegral of `f` over the boundary of the rectangle is equal to the integral of\n$2i\\frac{\\partial f}{\\partial \\bar z}=i\\frac{\\partial f}{\\partial x}-\\frac{\\partial f}{\\partial y}$\nover the rectangle.", "p": "mathlib"}, {"name": "complex.circle_integral_sub_inv_smul_of_differentiable_on_off_countable", "description": " **Cauchy integral formula**: if `f : \u2102 \u2192 E` is continuous on a closed disc of radius `R` and is\ncomplex differentiable at all but countably many points of its interior, then for any `w` in this\ninterior we have $\\oint_{|z-c|=R}(z-w)^{-1}f(z)\\,dz=2\u03c0if(w)$.", "p": "mathlib"}, {"name": "differentiable.has_fpower_series_on_ball", "description": " When `f : \u2102 \u2192 E` is differentiable, the `cauchy_power_series f z R` represents `f` as a power\nseries centered at `z` in the entirety of `\u2102`, regardless of `R : \u211d\u22650`, with  `0 < R`.", "p": "mathlib"}, {"name": "complex.circle_integral_sub_center_inv_smul_of_differentiable_on_off_countable_of_tendsto", "description": " **Cauchy integral formula** for the value at the center of a disc. If `f` is continuous on a\npunctured closed disc of radius `R`, is differentiable at all but countably many points of the\ninterior of this disc, and has a limit `y` at the center of the disc, then the integral\n$\\oint_{\u2016z-c\u2016=R} \\frac{f(z)}{z-c}\\,dz$ is equal to $2\u03c0iy`.", "p": "mathlib"}, {"name": "diff_cont_on_cl.has_fpower_series_on_ball", "description": " If `f : \u2102 \u2192 E` is complex differentiable on an open disc of positive radius and is continuous\non its closure, then it is analytic on the open disc with coefficients of the power series given by\nCauchy integral formulas.", "p": "mathlib"}, {"name": "differentiable_on.has_fpower_series_on_ball", "description": " If `f : \u2102 \u2192 E` is complex differentiable on a closed disc of positive radius, then it is\nanalytic on the corresponding open disc, and the coefficients of the power series are given by\nCauchy integral formulas. See also\n`complex.has_fpower_series_on_ball_of_differentiable_off_countable` for a version of this lemma with\nweaker assumptions.", "p": "mathlib"}, {"name": "complex.integral_boundary_rect_of_differentiable_on_real", "description": " Suppose that a function `f : \u2102 \u2192 E` is *real* differentiable on a closed rectangle with opposite\ncorners at `z w : \u2102` and $\\frac{\\partial f}{\\partial \\bar z}$ is integrable on this rectangle. Then\nthe integral of `f` over the boundary of the rectangle is equal to the integral of\n$2i\\frac{\\partial f}{\\partial \\bar z}=i\\frac{\\partial f}{\\partial x}-\\frac{\\partial f}{\\partial y}$\nover the rectangle.", "p": "mathlib"}, {"name": "complex.circle_integral_sub_center_inv_smul_eq_of_differentiable_on_annulus_off_countable", "description": " If `f : \u2102 \u2192 E` is continuous the closed annulus `r \u2264 \u2016z - c\u2016 \u2264 R`, `0 < r \u2264 R`, and is complex\ndifferentiable at all but countably many points of its interior, then the integrals of\n`f z / (z - c)` (formally, `(z - c)\u207b\u00b9 \u2022 f z`) over the circles `\u2016z - c\u2016 = r` and `\u2016z - c\u2016 = R` are\nequal to each other.", "p": "mathlib"}, {"name": "writer_t.ext", "description": "", "p": "mathlib"}, {"name": "writer_t.monad_writer_adapter", "description": "", "p": "mathlib"}, {"name": "state_t.monad_writer", "description": "", "p": "mathlib"}, {"name": "writer_t.lift", "description": "", "p": "mathlib"}, {"name": "writer_t.equiv", "description": " reduce the equivalence between two writer monads to the equivalence between\ntheir underlying monad", "p": "mathlib"}, {"name": "swap_right", "description": "", "p": "mathlib"}, {"name": "writer_t.monad_functor", "description": "", "p": "mathlib"}, {"name": "writer_t.has_monad_lift", "description": "", "p": "mathlib"}, {"name": "monad_writer_adapter", "description": " Adapt a monad stack, changing the type of its top-most environment.\n\nThis class is comparable to\n[Control.Lens.Magnify](https://hackage.haskell.org/package/lens-4.15.4/docs/Control-Lens-Zoom.html#t:Magnify),\nbut does not use lenses (why would it), and is derived automatically for any transformer\nimplementing `monad_functor`.\n\nNote: This class can be seen as a simplification of the more \"principled\" definition\n```lean\nclass monad_reader_functor (\u03c1 \u03c1' : out_param (Type u)) (n n' : Type u \u2192 Type u) :=\n(map {\u03b1 : Type u} :\n  (\u2200 {m : Type u \u2192 Type u} [monad m], reader_t \u03c1 m \u03b1 \u2192 reader_t \u03c1' m \u03b1) \u2192 n \u03b1 \u2192 n' \u03b1)\n```", "p": "mathlib"}, {"name": "monad_writer_adapter.adapt_writer", "description": " Adapt a monad stack, changing the type of its top-most environment.\n\nThis class is comparable to\n[Control.Lens.Magnify](https://hackage.haskell.org/package/lens-4.15.4/docs/Control-Lens-Zoom.html#t:Magnify),\nbut does not use lenses (why would it), and is derived automatically for any transformer\nimplementing `monad_functor`.\n\nNote: This class can be seen as a simplification of the more \"principled\" definition\n```lean\nclass monad_reader_functor (\u03c1 \u03c1' : out_param (Type u)) (n n' : Type u \u2192 Type u) :=\n(map {\u03b1 : Type u} :\n  (\u2200 {m : Type u \u2192 Type u} [monad m], reader_t \u03c1 m \u03b1 \u2192 reader_t \u03c1' m \u03b1) \u2192 n \u03b1 \u2192 n' \u03b1)\n```", "p": "mathlib"}, {"name": "writer_t.tell", "description": "", "p": "mathlib"}, {"name": "option_t.pass_aux", "description": "", "p": "mathlib"}, {"name": "monad_writer_adapter_trans", "description": " Transitivity.\n\nThis instance generates the type-class problem with a metavariable argument (which is why this\nis marked as `[nolint dangerous_instance]`).\nCurrently that is not a problem, as there are almost no instances of `monad_functor` or\n`monad_writer_adapter`.\n\nsee Note [lower instance priority]", "p": "mathlib"}, {"name": "writer", "description": "", "p": "mathlib"}, {"name": "writer_t.monad", "description": "", "p": "mathlib"}, {"name": "except_t.pass_aux", "description": "", "p": "mathlib"}, {"name": "writer_t.adapt", "description": "", "p": "mathlib"}, {"name": "writer_t.monad_writer", "description": "", "p": "mathlib"}, {"name": "writer_t.pure", "description": "", "p": "mathlib"}, {"name": "monad_writer", "description": "An implementation of [MonadReader](\nhttps://hackage.haskell.org/package/mtl-2.2.2/docs/Control-Monad-Reader-Class.html#t:MonadReader).\nIt does not contain `local` because this function cannot be lifted using `monad_lift`.\nInstead, the `monad_reader_adapter` class provides the more general `adapt_reader` function.\n\nNote: This class can be seen as a simplification of the more \"principled\" definition\n```lean\nclass monad_reader (\u03c1 : out_param (Type u)) (n : Type u \u2192 Type u) :=\n(lift {\u03b1 : Type u} : (\u2200 {m : Type u \u2192 Type u} [monad m], reader_t \u03c1 m \u03b1) \u2192 n \u03b1)\n```", "p": "mathlib"}, {"name": "monad_writer.tell", "description": "An implementation of [MonadReader](\nhttps://hackage.haskell.org/package/mtl-2.2.2/docs/Control-Monad-Reader-Class.html#t:MonadReader).\nIt does not contain `local` because this function cannot be lifted using `monad_lift`.\nInstead, the `monad_reader_adapter` class provides the more general `adapt_reader` function.\n\nNote: This class can be seen as a simplification of the more \"principled\" definition\n```lean\nclass monad_reader (\u03c1 : out_param (Type u)) (n : Type u \u2192 Type u) :=\n(lift {\u03b1 : Type u} : (\u2200 {m : Type u \u2192 Type u} [monad m], reader_t \u03c1 m \u03b1) \u2192 n \u03b1)\n```", "p": "mathlib"}, {"name": "monad_writer.listen", "description": "An implementation of [MonadReader](\nhttps://hackage.haskell.org/package/mtl-2.2.2/docs/Control-Monad-Reader-Class.html#t:MonadReader).\nIt does not contain `local` because this function cannot be lifted using `monad_lift`.\nInstead, the `monad_reader_adapter` class provides the more general `adapt_reader` function.\n\nNote: This class can be seen as a simplification of the more \"principled\" definition\n```lean\nclass monad_reader (\u03c1 : out_param (Type u)) (n : Type u \u2192 Type u) :=\n(lift {\u03b1 : Type u} : (\u2200 {m : Type u \u2192 Type u} [monad m], reader_t \u03c1 m \u03b1) \u2192 n \u03b1)\n```", "p": "mathlib"}, {"name": "monad_writer.pass", "description": "An implementation of [MonadReader](\nhttps://hackage.haskell.org/package/mtl-2.2.2/docs/Control-Monad-Reader-Class.html#t:MonadReader).\nIt does not contain `local` because this function cannot be lifted using `monad_lift`.\nInstead, the `monad_reader_adapter` class provides the more general `adapt_reader` function.\n\nNote: This class can be seen as a simplification of the more \"principled\" definition\n```lean\nclass monad_reader (\u03c1 : out_param (Type u)) (n : Type u \u2192 Type u) :=\n(lift {\u03b1 : Type u} : (\u2200 {m : Type u \u2192 Type u} [monad m], reader_t \u03c1 m \u03b1) \u2192 n \u03b1)\n```", "p": "mathlib"}, {"name": "except_t.monad_writer", "description": "", "p": "mathlib"}, {"name": "writer_t.pass", "description": "", "p": "mathlib"}, {"name": "writer_t.monad_map", "description": "", "p": "mathlib"}, {"name": "writer_t.bind", "description": "", "p": "mathlib"}, {"name": "writer_t.listen", "description": "", "p": "mathlib"}, {"name": "writer_t.is_lawful_monad", "description": "", "p": "mathlib"}, {"name": "writer_t", "description": "", "p": "mathlib"}, {"name": "writer_t.run", "description": "", "p": "mathlib"}, {"name": "reader_t.monad_writer", "description": "", "p": "mathlib"}, {"name": "writer_t.monad_run", "description": "", "p": "mathlib"}, {"name": "option_t.monad_writer", "description": "", "p": "mathlib"}, {"name": "writer_t.monad_except", "description": "", "p": "mathlib"}, {"name": "category_theory.preadditive.nsmul_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.preadditive.is_limit_fork_of_kernel_fork_lift", "description": "", "p": "mathlib"}, {"name": "category_theory.preadditive", "description": "A category is called preadditive if `P \u27f6 Q` is an abelian group such that composition is\n   linear in both variables.", "p": "mathlib"}, {"name": "category_theory.preadditive.hom_group", "description": "A category is called preadditive if `P \u27f6 Q` is an abelian group such that composition is\n   linear in both variables.", "p": "mathlib"}, {"name": "category_theory.preadditive.add_comp'", "description": "A category is called preadditive if `P \u27f6 Q` is an abelian group such that composition is\n   linear in both variables.", "p": "mathlib"}, {"name": "category_theory.preadditive.comp_add'", "description": "A category is called preadditive if `P \u27f6 Q` is an abelian group such that composition is\n   linear in both variables.", "p": "mathlib"}, {"name": "category_theory.preadditive.has_coequalizer_of_has_cokernel", "description": "A preadditive category has a coequalizer for `f` and `g` if it has a cokernel for `f - g`.", "p": "mathlib"}, {"name": "category_theory.preadditive.is_iso.comp_right_eq_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.preadditive.sum_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.preadditive.zsmul_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.preadditive.has_equalizer_of_has_kernel", "description": "A preadditive category has an equalizer for `f` and `g` if it has a kernel for `f - g`.", "p": "mathlib"}, {"name": "category_theory.preadditive.comp_hom", "description": "Composition as a bilinear group homomorphism", "p": "mathlib"}, {"name": "category_theory.preadditive.fork_of_kernel_fork", "description": "Map a kernel cone on the difference of two morphisms to the equalizer fork.", "p": "mathlib"}, {"name": "category_theory.preadditive.comp_nsmul", "description": "", "p": "mathlib"}, {"name": "category_theory.preadditive.is_colimit_cofork_of_cokernel_cofork_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.preadditive.cokernel_cofork_of_cofork_of_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.preadditive.comp_neg_assoc", "descr