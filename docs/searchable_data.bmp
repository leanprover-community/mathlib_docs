thlib"}, {"name": "cardinal.mk_set_eq_nat_iff_finset", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_le_aleph_0_iff", "description": "", "p": "mathlib"}, {"name": "cardinal.sum_le_sum", "description": "", "p": "mathlib"}, {"name": "cardinal.to_nat_congr", "description": "", "p": "mathlib"}, {"name": "cardinal.mul_def", "description": "", "p": "mathlib"}, {"name": "cardinal.lift_mk_le", "description": "", "p": "mathlib"}, {"name": "cardinal.sum_const", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_emptyc_iff", "description": "", "p": "mathlib"}, {"name": "cardinal.le_mk_iff_exists_set", "description": "", "p": "mathlib"}, {"name": "cardinal.map\u2082", "description": "Lift a binary operation `Type* \u2192 Type* \u2192 Type*` to a binary operation on `cardinal`s.", "p": "mathlib"}, {"name": "cardinal.mk_Prop", "description": "", "p": "mathlib"}, {"name": "cardinal.to_part_enat_cast", "description": "", "p": "mathlib"}, {"name": "cardinal.sum_add_distrib'", "description": "", "p": "mathlib"}, {"name": "cardinal.sum_const'", "description": "", "p": "mathlib"}, {"name": "cardinal.powerlt_max", "description": "", "p": "mathlib"}, {"name": "cardinal.power_zero", "description": "", "p": "mathlib"}, {"name": "cardinal.lift_supr", "description": "The lift of a supremum is the supremum of the lifts.", "p": "mathlib"}, {"name": "cardinal.mk_diff_add_mk", "description": "", "p": "mathlib"}, {"name": "cardinal.lift_id", "description": "A cardinal lifted to the same universe equals itself.", "p": "mathlib"}, {"name": "cardinal.mk_vector", "description": "", "p": "mathlib"}, {"name": "cardinal.to_nat_hom", "description": "`cardinal.to_nat` as a `monoid_with_zero_hom`.", "p": "mathlib"}, {"name": "cardinal.mk_ne_zero", "description": "", "p": "mathlib"}, {"name": "cardinal.is_succ_limit_zero", "description": "", "p": "mathlib"}, {"name": "cardinal.nontrivial", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_singleton", "description": "", "p": "mathlib"}, {"name": "cardinal.is_limit.succ_lt", "description": "", "p": "mathlib"}, {"name": "cardinal.mul_lt_aleph_0", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.mono_inl_of_is_colimit", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.biproduct_to_pushout_is_cokernel.is_colimit_biproduct_to_pushout", "description": "The cofork induced by the canonical map `Y \u229e Z \u27f6 pushout f g` is in fact a colimit cokernel\n   cofork.", "p": "mathlib"}, {"name": "category_theory.abelian.image_iso_image", "description": "There is a canonical isomorphism between the abelian image and the categorical image of a\n   morphism.", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.normal_epi_category", "description": "A category with finite products in which coimage-image comparisons are all isomorphisms\nis a normal epi category.", "p": "mathlib"}, {"name": "category_theory.abelian.biproduct_to_pushout_is_cokernel.biproduct_to_pushout_cofork", "description": "The canonical map `Y \u229e Z \u27f6 pushout f g` induces a cokernel cofork on the map\n   `X \u27f6 Y \u229e Z` induced by `f` and `-g`.", "p": "mathlib"}, {"name": "category_theory.abelian.pullback_to_biproduct_is_kernel.is_limit_pullback_to_biproduct", "description": "The canonical map `pullback f g \u27f6 X \u229e Y` is a kernel of the map induced by\n   `(f, -g)`.", "p": "mathlib"}, {"name": "category_theory.abelian.has_finite_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.coimage_image_comparison.category_theory.is_iso", "description": "The coimage-image comparison morphism is always an isomorphism in an abelian category.\nSee `category_theory.abelian.of_coimage_image_comparison_is_iso` for the converse.", "p": "mathlib"}, {"name": "category_theory.abelian.factor_thru_image.category_theory.epi", "description": "The map `p : P \u27f6 image f` is an epimorphism", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.image_factorisation", "description": " If the coimage-image comparison morphism for a morphism `f` is an isomorphism,\nwe obtain an image factorisation of `f`.", "p": "mathlib"}, {"name": "category_theory.abelian.coimage_strong_epi_mono_factorisation_to_mono_factorisation_I", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.mono_lift", "description": "In an abelian category, any morphism that turns to zero when postcomposed with the cokernel of a\n   monomorphism factors through that monomorphism.", "p": "mathlib"}, {"name": "category_theory.abelian.mono_inr_of_is_colimit", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.has_zero_object", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.image_iso_image_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.image_iso_image_hom_comp_image_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.epi_of_cokernel_\u03c0_eq_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.epi_desc", "description": "In an abelian category, any morphism that turns to zero when precomposed with the kernel of an\n   epimorphism factors through that epimorphism.", "p": "mathlib"}, {"name": "category_theory.abelian.has_finite_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.image_mono_factorisation_e'", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.coimage_strong_epi_mono_factorisation_to_mono_factorisation_e", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.mono_lift_comp_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.factor_thru_image_comp_coimage_iso_image'_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.image_mono_factorisation_e", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.non_preadditive_abelian", "description": "Every abelian category is, in particular, `non_preadditive_abelian`.", "p": "mathlib"}, {"name": "category_theory.abelian.is_iso_factor_thru_image", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.mono_pushout_of_mono_f", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.image_\u03b9_comp_eq_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.non_preadditive_abelian.abelian", "description": "Every non_preadditive_abelian category can be promoted to an abelian category.", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.e.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.mono_of_kernel_\u03b9_eq_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.mono_is_kernel_of_cokernel", "description": "In an abelian category, a mono is the kernel of its cokernel. More precisely:\n   If `f` is a monomorphism and `s` is some colimit cokernel cocone on `f`, then `f` is a kernel\n   of `cofork.\u03c0 s`.", "p": "mathlib"}, {"name": "category_theory.abelian.category_theory.limits.has_strong_epi_mono_factorisations", "description": "An abelian category has strong epi-mono factorisations.", "p": "mathlib"}, {"name": "category_theory.abelian.image_strong_epi_mono_factorisation_to_mono_factorisation_I", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.image_mono_factorisation_I", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.image_mono_factorisation_m", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.has_pushouts", "description": "Any abelian category has pushouts", "p": "mathlib"}, {"name": "category_theory.abelian.pullback_to_biproduct_is_kernel.pullback_to_biproduct", "description": "The canonical map `pullback f g \u27f6 X \u229e Y`", "p": "mathlib"}, {"name": "category_theory.abelian.comp_coimage_\u03c0_eq_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.mono_lift_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.image_mono_factorisation", "description": "The factorisation of a morphism through its abelian image.", "p": "mathlib"}, {"name": "category_theory.abelian.has_coequalizers", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.normal_mono_category", "description": "A category with finite products in which coimage-image comparisons are all isomorphisms\nis a normal mono category.", "p": "mathlib"}, {"name": "category_theory.abelian.coimage_iso_image", "description": "There is a canonical isomorphism between the abelian coimage and the abelian image of a\n   morphism.", "p": "mathlib"}, {"name": "category_theory.abelian.coimage_iso_image'", "description": "There is a canonical isomorphism between the abelian coimage and the categorical image of a\n   morphism.", "p": "mathlib"}, {"name": "category_theory.abelian.mono_inl_of_factor_thru_epi_mono_factorization", "description": "Suppose `f` and `g` are two morphisms with a common domain and suppose we have written `g` as\n   an epimorphism followed by a monomorphism. If `f` factors through the epi part of this\n   factorization, then any pushout of `g` along `f` is a monomorphism.", "p": "mathlib"}, {"name": "category_theory.abelian.has_finite_biproducts", "description": "An abelian category has finite biproducts.", "p": "mathlib"}, {"name": "category_theory.abelian.has_equalizers", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.epi_is_cokernel_of_kernel", "description": "In an abelian category, an epi is the cokernel of its kernel. More precisely:\n   If `f` is an epimorphism and `s` is some limit kernel cone on `f`, then `f` is a cokernel\n   of `fork.\u03b9 s`.", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.m.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.coimage_iso_image'_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.epi_pullback_of_epi_f", "description": "In an abelian category, the pullback of an epimorphism is an epimorphism.\n   Proof from [aluffi2016, IX.2.3], cf. [borceux-vol2, 1.7.6]", "p": "mathlib"}, {"name": "category_theory.abelian.is_iso_factor_thru_coimage", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.biproduct_to_pushout_is_cokernel.biproduct_to_pushout", "description": "The canonical map `Y \u229e Z \u27f6 pushout f g`", "p": "mathlib"}, {"name": "category_theory.abelian.pullback_to_biproduct_is_kernel.pullback_to_biproduct_fork", "description": "The canonical map `pullback f g \u27f6 X \u229e Y` induces a kernel cone on the map\n   `biproduct X Y \u27f6 Z` induced by `f` and `g`. A slightly more intuitive way to think of\n   this may be that it induces an equalizer fork on the maps induced by `(f, 0)` and\n   `(0, g)`.", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso", "description": "A preadditive category with kernels, cokernels, and finite products,\nin which the coimage-image comparison morphism is always an isomorphism,\nis an abelian category.\n\nThe Stacks project uses this characterisation at the definition of an abelian category.\nSee <https://stacks.math.columbia.edu/tag/0109>.", "p": "mathlib"}, {"name": "category_theory.abelian.comp_epi_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.image_strong_epi_mono_factorisation_to_mono_factorisation_e", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.epi_snd_of_is_limit", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.comp_epi_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.coimage_strong_epi_mono_factorisation_to_mono_factorisation_m", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.image_strong_epi_mono_factorisation", "description": "Factoring through the image is a strong epi-mono factorisation.", "p": "mathlib"}, {"name": "category_theory.abelian.coimage_strong_epi_mono_factorisation", "description": "Factoring through the coimage is a strong epi-mono factorisation.", "p": "mathlib"}, {"name": "category_theory.abelian", "description": "A (preadditive) category `C` is called abelian if it has all finite products,\nall kernels and cokernels, and if every monomorphism is the kernel of some morphism\nand every epimorphism is the cokernel of some morphism.\n\n(This definition implies the existence of zero objects:\nfinite products give a terminal object, and in a preadditive category\nany terminal object is a zero object.)", "p": "mathlib"}, {"name": "category_theory.abelian.to_preadditive", "description": "A (preadditive) category `C` is called abelian if it has all finite products,\nall kernels and cokernels, and if every monomorphism is the kernel of some morphism\nand every epimorphism is the cokernel of some morphism.\n\n(This definition implies the existence of zero objects:\nfinite products give a terminal object, and in a preadditive category\nany terminal object is a zero object.)", "p": "mathlib"}, {"name": "category_theory.abelian.to_normal_mono_category", "description": "A (preadditive) category `C` is called abelian if it has all finite products,\nall kernels and cokernels, and if every monomorphism is the kernel of some morphism\nand every epimorphism is the cokernel of some morphism.\n\n(This definition implies the existence of zero objects:\nfinite products give a terminal object, and in a preadditive category\nany terminal object is a zero object.)", "p": "mathlib"}, {"name": "category_theory.abelian.to_normal_epi_category", "description": "A (preadditive) category `C` is called abelian if it has all finite products,\nall kernels and cokernels, and if every monomorphism is the kernel of some morphism\nand every epimorphism is the cokernel of some morphism.\n\n(This definition implies the existence of zero objects:\nfinite products give a terminal object, and in a preadditive category\nany terminal object is a zero object.)", "p": "mathlib"}, {"name": "category_theory.abelian.has_finite_products", "description": "A (preadditive) category `C` is called abelian if it has all finite products,\nall kernels and cokernels, and if every monomorphism is the kernel of some morphism\nand every epimorphism is the cokernel of some morphism.\n\n(This definition implies the existence of zero objects:\nfinite products give a terminal object, and in a preadditive category\nany terminal object is a zero object.)", "p": "mathlib"}, {"name": "category_theory.abelian.has_kernels", "description": "A (preadditive) category `C` is called abelian if it has all finite products,\nall kernels and cokernels, and if every monomorphism is the kernel of some morphism\nand every epimorphism is the cokernel of some morphism.\n\n(This definition implies the existence of zero objects:\nfinite products give a terminal object, and in a preadditive category\nany terminal object is a zero object.)", "p": "mathlib"}, {"name": "category_theory.abelian.has_cokernels", "description": "A (preadditive) category `C` is called abelian if it has all finite products,\nall kernels and cokernels, and if every monomorphism is the kernel of some morphism\nand every epimorphism is the cokernel of some morphism.\n\n(This definition implies the existence of zero objects:\nfinite products give a terminal object, and in a preadditive category\nany terminal object is a zero object.)", "p": "mathlib"}, {"name": "category_theory.abelian.mono_pushout_of_mono_g", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.factor_thru_coimage.category_theory.mono", "description": "The canonical morphism `i : coimage f \u27f6 Q` is a monomorphism", "p": "mathlib"}, {"name": "category_theory.abelian.epi_fst_of_is_limit", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.has_binary_biproducts", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.epi_pullback_of_epi_g", "description": "In an abelian category, the pullback of an epimorphism is an epimorphism.", "p": "mathlib"}, {"name": "category_theory.abelian.epi_fst_of_factor_thru_epi_mono_factorization", "description": "Suppose `f` and `g` are two morphisms with a common codomain and suppose we have written `g` as\n   an epimorphism followed by a monomorphism. If `f` factors through the mono part of this\n   factorization, then any pullback of `g` along `f` is an epimorphism.", "p": "mathlib"}, {"name": "category_theory.abelian.has_pullbacks", "description": "Any abelian category has pullbacks", "p": "mathlib"}, {"name": "category_theory.abelian.of_coimage_image_comparison_is_iso.has_images", "description": "A category in which coimage-image comparisons are all isomorphisms has images.", "p": "mathlib"}, {"name": "category_theory.abelian.image_strong_epi_mono_factorisation_to_mono_factorisation_m", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_one", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal_max", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_right_cancel_iff", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_right_comm", "description": "", "p": "mathlib"}, {"name": "ordinal.le_of_nadd_le_nadd_left", "description": "", "p": "mathlib"}, {"name": "ordinal.le_nadd_left", "description": "", "p": "mathlib"}, {"name": "ordinal.lt_nmul_iff", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.linear_order", "description": "", "p": "mathlib"}, {"name": "ordinal.le_of_nadd_le_nadd_right", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.has_add", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.has_one", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_le_iff\u2083'", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_lt_nadd_iff_left", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_def", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_eq_add", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_le_iff\u2083", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.succ_def", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.add_one_eq_succ", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.add_monoid_with_one", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.ordered_comm_semiring", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_left_comm", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.has_mul", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_le_iff", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.succ_order", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_left_cancel", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal_min", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_lt_nmul_of_pos_left", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_one_nmul", "description": "", "p": "mathlib"}, {"name": "ordinal.lt_of_nadd_lt_nadd_left", "description": "", "p": "mathlib"}, {"name": "ordinal.succ_nmul", "description": "", "p": "mathlib"}, {"name": "ordinal.add_le_nadd", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.has_well_founded", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.well_founded_lt", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.add_covariant_class_le", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_lt_nadd_left", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.has_lt.lt.is_well_order", "description": "", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal_min", "description": "", "p": "mathlib"}, {"name": "ordinal.one_nmul", "description": "", "p": "mathlib"}, {"name": "ordinal.lt_nmul_iff\u2083'", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.induction", "description": "`ordinal.induction` but for `nat_ordinal`.", "p": "mathlib"}, {"name": "ordinal.nmul_nadd_one", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_le_iff", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul", "description": " Natural multiplication on ordinals `a \u2a33 b`, also known as the Hessenberg product, is recursively\ndefined as the least ordinal such that `a \u2a33 b + a' \u2a33 b'` is greater than `a' \u2a33 b + a \u2a33 b'` for all\n`a' < a` and `b < b'`. In contrast to normal ordinal multiplication, it is commutative and\ndistributive (over natural addition).\n\nNatural multiplication can equivalently be characterized as the ordinal resulting from multiplying\nthe Cantor normal forms of `a` and `b` as if they were polynomials in `\u03c9`. Addition of exponents is\ndone via natural addition.", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal_max", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_zero", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_succ", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_nadd_lt", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_assoc", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_comm", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_le_nadd_left", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_le_nadd_right", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_lt_nmul_of_pos_right", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_lt_nadd_of_le_of_lt", "description": "", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal_to_ordinal", "description": "", "p": "mathlib"}, {"name": "ordinal.nat_nadd", "description": "", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal_one", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.lt_wf", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal_zero", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_nmul", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_lt_nadd_of_lt_of_le", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_eq_mul", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_le_nadd", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_le_nmul_of_nonneg_right", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_nadd_lt\u2083'", "description": "", "p": "mathlib"}, {"name": "ordinal.le_nadd_self", "description": "", "p": "mathlib"}, {"name": "ordinal.zero_nadd", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_succ", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_one", "description": "", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal_eq_zero", "description": "", "p": "mathlib"}, {"name": "ordinal.one_nadd", "description": "", "p": "mathlib"}, {"name": "ordinal.lt_of_nadd_lt_nadd_right", "description": "", "p": "mathlib"}, {"name": "ordinal.add_one_nmul", "description": "", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal_cast_nat", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_nadd_le\u2083'", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_add_one", "description": "", "p": "mathlib"}, {"name": "ordinal.lt_nmul_iff\u2083", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_le_nmul_of_nonneg_left", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_nadd", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_nat", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal_symm_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal_eq_one", "description": "", "p": "mathlib"}, {"name": "ordinal.le_self_nadd", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.ordered_cancel_add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "ordinal.blsub_nadd_of_mono", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal_one", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_assoc", "description": "", "p": "mathlib"}, {"name": "ordinal.le_nadd_right", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_left_cancel_iff", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_zero", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal_eq_one", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_nadd_le\u2083", "description": "", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal", "description": "The identity function between `ordinal` and `nat_ordinal`.", "p": "mathlib"}, {"name": "nat_ordinal", "description": "A type synonym for ordinals with natural addition and multiplication.", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal", "description": "The identity function between `nat_ordinal` and `ordinal`.", "p": "mathlib"}, {"name": "ordinal.nmul_nonempty", "description": "The set in the definition of `nmul` is nonempty.", "p": "mathlib"}, {"name": "ordinal.nadd_lt_nadd", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.add_contravariant_class_le", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.add_covariant_class_lt", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.mul_le_nmul", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_right_cancel", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal_eq_zero", "description": "", "p": "mathlib"}, {"name": "ordinal.zero_nmul", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd", "description": " Natural addition on ordinals `a \u266f b`, also known as the Hessenberg sum, is recursively defined\nas the least ordinal greater than `a' \u266f b` and `a \u266f b'` for all `a' < a` and `b' < b`. In contrast\nto normal ordinal addition, it is commutative.\n\nNatural addition can equivalently be characterized as the ordinal resulting from adding up\ncorresponding coefficients in the Cantor normal forms of `a` and `b`.", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal_cast_nat", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_comm", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.has_zero", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.inhabited", "description": "", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal_zero", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_nadd_le", "description": "", "p": "mathlib"}, {"name": "ordinal.succ_nadd", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.to_ordinal_to_nat_ordinal", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_lt_nadd_iff_right", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_def", "description": "", "p": "mathlib"}, {"name": "ordinal.nmul_nadd_lt\u2083", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_lt_nadd_right", "description": "", "p": "mathlib"}, {"name": "ordinal.to_nat_ordinal_symm_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.nadd_le_nadd_iff_right", "description": "", "p": "mathlib"}, {"name": "ordinal.lt_nadd_iff", "description": "", "p": "mathlib"}, {"name": "nat_ordinal.rec", "description": "A recursor for `nat_ordinal`. Use as `induction x using nat_ordinal.rec`.", "p": "mathlib"}, {"name": "ordinal.nadd_le_nadd_iff_left", "description": "", "p": "mathlib"}, {"name": "left_invariant_derivation.has_smul", "description": "", "p": "mathlib"}, {"name": "left_invariant_derivation.map_sub", "description": "", "p": "mathlib"}, {"name": "left_invariant_derivation.module", "description": "", "p": "mathlib"}, {"name": "left_invariant_derivation.map_smul", "description": "", "p": "mathlib"}, {"name": "left_invariant_derivation.left_invariant", "description": "", "p": "mathlib"}, {"name": "left_invariant_derivation.commutator_apply", "description": "", "p": "mathlib"}, {"name": "left_invariant_derivation.has_bracket", "description": "", "p": "mathlib"}, {"name": "left_invariant_derivation.lift_add", 