thlib"}, {"name": "box_integral.tagged_prepartition.filter", "description": "The tagged partition made of boxes of `\u03c0` that satisfy predicate `p`.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.bUnion_prepartition", "description": " Given a tagged partition `\u03c0` of `I` and a (not tagged) partition `\u03c0i J hJ` of each `J \u2208 \u03c0`,\nreturns the tagged partition of `I` into all the boxes of all `\u03c0i J hJ`. The tag of a box `J`\nis defined to be the `\u03c0.tag` of the box of the partition `\u03c0` that includes `J`.\n\nNote that usually the result is not a Henstock partition.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.disj_union_boxes", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.inf_prepartition", "description": " Given two partitions `\u03c0\u2081` and `\u03c0\u2081`, one of them tagged and the other is not, returns the tagged\npartition with `to_partition = \u03c0\u2081.to_partition \u2293 \u03c0\u2082` and tags coming from `\u03c0\u2081`.\n\nNote that usually the result is not a Henstock partition.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.disj_union", "description": "Union of two tagged prepartitions with disjoint unions of boxes.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.embed_box", "description": "If `I \u2264 J`, then every tagged prepartition of `I` is a tagged prepartition of `J`.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.bUnion_prepartition_tag", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.Union_single", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.distortion_filter_le", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.mem_Union", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_subordinate_single", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.mem_disj_union", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_subordinate.diam_le", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_Henstock", "description": " A tagged partition is said to be a Henstock partition if for each `J \u2208 \u03c0`, the tag of `J`\nbelongs to `J.Icc`.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.filter_tag", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_subordinate.disj_union", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.distortion_le_iff", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_subordinate.bUnion_prepartition", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.distortion", "description": "The distortion of a tagged prepartition is the maximum of distortions of its boxes.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_subordinate.mono'", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.Union", "description": "Union of all boxes of a tagged prepartition.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_Henstock.disj_union", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_subordinate.inf_prepartition", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.bUnion_tagged", "description": " Given a partition `\u03c0` of `I : box_integral.box \u03b9` and a collection of tagged partitions\n`\u03c0i J` of all boxes `J \u2208 \u03c0`, returns the tagged partition of `I` into all the boxes of `\u03c0i J`\nwith tags coming from `(\u03c0i J).tag`.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.distortion_bUnion_prepartition", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.forall_bUnion_tagged", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.inhabited", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_partition_single_iff", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_Henstock_bUnion_tagged", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.Union_mk", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.single_to_prepartition", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_partition_iff_Union_eq", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.subset_Union", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.Union_filter_not", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.distortion_bUnion_tagged", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_partition.inf_prepartition", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.distortion_le_of_mem", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition", "description": " A tagged prepartition is a prepartition enriched with a tagged point for each box of the\nprepartition. For simiplicity we require that `tag` is defined for all boxes in `\u03b9 \u2192 \u211d` but\nwe will use onle the values of `tag` on the boxes of the partition.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.to_prepartition", "description": " A tagged prepartition is a prepartition enriched with a tagged point for each box of the\nprepartition. For simiplicity we require that `tag` is defined for all boxes in `\u03b9 \u2192 \u211d` but\nwe will use onle the values of `tag` on the boxes of the partition.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.tag", "description": " A tagged prepartition is a prepartition enriched with a tagged point for each box of the\nprepartition. For simiplicity we require that `tag` is defined for all boxes in `\u03b9 \u2192 \u211d` but\nwe will use onle the values of `tag` on the boxes of the partition.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.tag_mem_Icc", "description": " A tagged prepartition is a prepartition enriched with a tagged point for each box of the\nprepartition. For simiplicity we require that `tag` is defined for all boxes in `\u03b9 \u2192 \u211d` but\nwe will use onle the values of `tag` on the boxes of the partition.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_partition.bUnion_prepartition", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.is_partition.bUnion_tagged", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.single", "description": "Tagged prepartition with single box and prescribed tag.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_partition", "description": "A tagged prepartition is a partition if it covers the whole box.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.distortion_single", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.Union_disj_union", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_partition_single", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.mem_single", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.filter_to_prepartition", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_Henstock.card_filter_tag_eq_le", "description": "In a Henstock prepartition, there are at most `2 ^ fintype.card \u03b9` boxes with a given tag.", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.single_tag", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.mem_to_prepartition", "description": "", "p": "mathlib"}, {"name": "box_integral.prepartition.Union_bUnion_tagged", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_subordinate.mono", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_subordinate_bUnion_tagged", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.disj_union_tag_of_mem_right", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.is_subordinate", "description": " A tagged partition `\u03c0` is subordinate to `r : (\u03b9 \u2192 \u211d) \u2192 \u211d` if each box `J \u2208 \u03c0` is included in\nthe closed ball with center `\u03c0.tag J` and radius `r (\u03c0.tag J)`.", "p": "mathlib"}, {"name": "box_integral.prepartition.tag_bUnion_tagged", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.Union_to_prepartition", "description": "", "p": "mathlib"}, {"name": "box_integral.tagged_prepartition.distortion_of_const", "description": "", "p": "mathlib"}, {"name": "finset.pimage_inter", "description": "", "p": "mathlib"}, {"name": "finset.pimage_subset", "description": "", "p": "mathlib"}, {"name": "finset.pimage_union", "description": "", "p": "mathlib"}, {"name": "finset.pimage", "description": "Image of `s : finset \u03b1` under a partially defined function `f : \u03b1 \u2192. \u03b2`.", "p": "mathlib"}, {"name": "finset.pimage_eq_image_filter", "description": "Rewrite `s.pimage f` in terms of `finset.filter`, `finset.attach`, and `finset.image`.", "p": "mathlib"}, {"name": "finset.pimage_mono", "description": "", "p": "mathlib"}, {"name": "finset.pimage_congr", "description": "", "p": "mathlib"}, {"name": "part.mem_to_finset", "description": "", "p": "mathlib"}, {"name": "finset.mem_pimage", "description": "", "p": "mathlib"}, {"name": "finset.pimage_some", "description": "", "p": "mathlib"}, {"name": "finset.coe_pimage", "description": "", "p": "mathlib"}, {"name": "part.to_finset", "description": "Convert a `o : part \u03b1` with decidable `part.dom o` to `finset \u03b1`.", "p": "mathlib"}, {"name": "part.to_finset_none", "description": "", "p": "mathlib"}, {"name": "part.coe_to_finset", "description": "", "p": "mathlib"}, {"name": "finset.pimage_empty", "description": "", "p": "mathlib"}, {"name": "part.to_finset_some", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_sublist_sublists'", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_aux_eq", "description": "", "p": "mathlib"}, {"name": "list.nodup_sublists'", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_of_length_lt", "description": "", "p": "mathlib"}, {"name": "list.nodup.of_sublists'", "description": "**Alias** of the forward direction of `list.nodup_sublists'`.", "p": "mathlib"}, {"name": "list.sublists_aux_eq_foldr", "description": "", "p": "mathlib"}, {"name": "list.length_sublists_len", "description": "", "p": "mathlib"}, {"name": "list.nodup.of_sublists", "description": "**Alias** of the forward direction of `list.nodup_sublists`.", "p": "mathlib"}, {"name": "list.sublists_len_succ_nil", "description": "", "p": "mathlib"}, {"name": "list.sublists_cons_perm_append", "description": "", "p": "mathlib"}, {"name": "list.mem_sublists_len_self", "description": "", "p": "mathlib"}, {"name": "list.sublists_nil", "description": "", "p": "mathlib"}, {"name": "list.nodup.sublists", "description": "**Alias** of the reverse direction of `list.nodup_sublists`.", "p": "mathlib"}, {"name": "list.sublists_reverse", "description": "", "p": "mathlib"}, {"name": "list.sublists'_eq_sublists", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_length", "description": "", "p": "mathlib"}, {"name": "list.mem_sublists_len", "description": "", "p": "mathlib"}, {"name": "list.sublists_append", "description": "", "p": "mathlib"}, {"name": "list.mem_sublists'", "description": "", "p": "mathlib"}, {"name": "list.nodup.sublists'", "description": "**Alias** of the reverse direction of `list.nodup_sublists'`.", "p": "mathlib"}, {"name": "list.sublists_aux_cons_eq_sublists_aux\u2081", "description": "", "p": "mathlib"}, {"name": "list.mem_sublists", "description": "", "p": "mathlib"}, {"name": "list.length_of_sublists_len", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_sublist_of_sublist", "description": "", "p": "mathlib"}, {"name": "list.sublists_aux_cons_cons", "description": "", "p": "mathlib"}, {"name": "list.sublists_concat", "description": "", "p": "mathlib"}, {"name": "list.sublists_aux_ne_nil", "description": "", "p": "mathlib"}, {"name": "list.sublists'_cons", "description": "", "p": "mathlib"}, {"name": "list.sublists_aux_eq_foldr.aux", "description": "", "p": "mathlib"}, {"name": "list.sublists'_reverse", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_succ_cons", "description": "", "p": "mathlib"}, {"name": "list.sublists_aux\u2081_eq_sublists_aux", "description": "", "p": "mathlib"}, {"name": "list.sublists_aux\u2081_bind", "description": "", "p": "mathlib"}, {"name": "list.pairwise_sublists", "description": "", "p": "mathlib"}, {"name": "list.sublists_singleton", "description": "", "p": "mathlib"}, {"name": "list.revzip_sublists", "description": "", "p": "mathlib"}, {"name": "list.sublists_len", "description": " The list of all sublists of a list `l` that are of length `n`. For instance, for\n`l = [0, 1, 2, 3]` and `n = 2`, one gets\n`[[2, 3], [1, 3], [1, 2], [0, 3], [0, 2], [0, 1]]`.", "p": "mathlib"}, {"name": "list.sublists_aux\u2081_append", "description": "", "p": "mathlib"}, {"name": "list.length_sublists", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_aux_zero", "description": "", "p": "mathlib"}, {"name": "list.map_sublists'_aux", "description": "", "p": "mathlib"}, {"name": "list.sublists'_singleton", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_aux_append", "description": "", "p": "mathlib"}, {"name": "list.map_ret_sublist_sublists", "description": "", "p": "mathlib"}, {"name": "list.pairwise.sublists'", "description": "", "p": "mathlib"}, {"name": "list.sublists_aux\u2081_concat", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_aux", "description": " Auxiliary function to construct the list of all sublists of a given length. Given an\ninteger `n`, a list `l`, a function `f` and an auxiliary list `L`, it returns the list made of\nof `f` applied to all sublists of `l` of length `n`, concatenated with `L`.", "p": "mathlib"}, {"name": "list.length_sublists'", "description": "", "p": "mathlib"}, {"name": "list.sublists'_aux_eq_sublists'", "description": "", "p": "mathlib"}, {"name": "list.sublists_perm_sublists'", "description": "", "p": "mathlib"}, {"name": "list.nodup_sublists_len", "description": "", "p": "mathlib"}, {"name": "list.nodup_sublists", "description": "", "p": "mathlib"}, {"name": "list.sublists'_aux_append", "description": "", "p": "mathlib"}, {"name": "list.revzip_sublists'", "description": "", "p": "mathlib"}, {"name": "list.range_bind_sublists_len_perm", "description": "", "p": "mathlib"}, {"name": "list.sublists'_nil", "description": "", "p": "mathlib"}, {"name": "list.sublists_eq_sublists'", "description": "", "p": "mathlib"}, {"name": "list.sublists_aux_cons_append", "description": "", "p": "mathlib"}, {"name": "list.sublists_len_zero", "description": "", "p": "mathlib"}, {"name": "convex_on.strict_mono_of_lt", "description": " If `f` is convex on a set `s` in a linearly ordered field, and `f x < f y` for two points\n`x < y` in `s`, then `f` is strictly monotone on `s \u2229 [y, \u221e)`.", "p": "mathlib"}, {"name": "strict_convex_on.secant_strict_mono_aux2", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.secant_strict_mono", "description": "", "p": "mathlib"}, {"name": "convex_on.secant_mono_aux1", "description": "", "p": "mathlib"}, {"name": "convex_on.slope_mono_adjacent", "description": " If `f : \ud835\udd5c \u2192 \ud835\udd5c` is convex, then for any three points `x < y < z` the slope of the secant line of\n`f` on `[x, y]` is less than the slope of the secant line of `f` on `[x, z]`.", "p": "mathlib"}, {"name": "convex_on_iff_slope_mono_adjacent", "description": " A function `f : \ud835\udd5c \u2192 \ud835\udd5c` is convex iff for any three points `x < y < z` the slope of the secant\nline of `f` on `[x, y]` is less than the slope of the secant line of `f` on `[x, z]`.", "p": "mathlib"}, {"name": "strict_concave_on_of_slope_strict_anti_adjacent", "description": " If for any three points `x < y < z`, the slope of the secant line of `f : \ud835\udd5c \u2192 \ud835\udd5c` on `[x, y]` is\nstrictly greater than the slope of the secant line of `f` on `[x, z]`, then `f` is strictly concave.", "p": "mathlib"}, {"name": "strict_convex_on.slope_strict_mono_adjacent", "description": " If `f : \ud835\udd5c \u2192 \ud835\udd5c` is strictly convex, then for any three points `x < y < z` the slope of the\nsecant line of `f` on `[x, y]` is strictly less than the slope of the secant line of `f` on\n`[x, z]`.", "p": "mathlib"}, {"name": "concave_on_iff_slope_anti_adjacent", "description": " A function `f : \ud835\udd5c \u2192 \ud835\udd5c` is concave iff for any three points `x < y < z` the slope of the secant\nline of `f` on `[x, y]` is greater than the slope of the secant line of `f` on `[x, z]`.", "p": "mathlib"}, {"name": "strict_concave_on.slope_anti_adjacent", "description": " If `f : \ud835\udd5c \u2192 \ud835\udd5c` is strictly concave, then for any three points `x < y < z` the slope of the\nsecant line of `f` on `[x, y]` is strictly greater than the slope of the secant line of `f` on\n`[x, z]`.", "p": "mathlib"}, {"name": "strict_concave_on_iff_slope_strict_anti_adjacent", "description": " A function `f : \ud835\udd5c \u2192 \ud835\udd5c` is strictly concave iff for any three points `x < y < z` the slope of\nthe secant line of `f` on `[x, y]` is strictly greater than the slope of the secant line of `f` on\n`[x, z]`.", "p": "mathlib"}, {"name": "convex_on_of_slope_mono_adjacent", "description": " If for any three points `x < y < z`, the slope of the secant line of `f : \ud835\udd5c \u2192 \ud835\udd5c` on `[x, y]` is\nless than the slope of the secant line of `f` on `[x, z]`, then `f` is convex.", "p": "mathlib"}, {"name": "concave_on.slope_anti_adjacent", "description": " If `f : \ud835\udd5c \u2192 \ud835\udd5c` is concave, then for any three points `x < y < z` the slope of the secant line of\n`f` on `[x, y]` is greater than the slope of the secant line of `f` on `[x, z]`.", "p": "mathlib"}, {"name": "strict_convex_on_iff_slope_strict_mono_adjacent", "description": " A function `f : \ud835\udd5c \u2192 \ud835\udd5c` is strictly convex iff for any three points `x < y < z` the slope of\nthe secant line of `f` on `[x, y]` is strictly less than the slope of the secant line of `f` on\n`[x, z]`.", "p": "mathlib"}, {"name": "concave_on_of_slope_anti_adjacent", "description": " If for any three points `x < y < z`, the slope of the secant line of `f : \ud835\udd5c \u2192 \ud835\udd5c` on `[x, y]` is\ngreater than the slope of the secant line of `f` on `[x, z]`, then `f` is concave.", "p": "mathlib"}, {"name": "strict_convex_on.secant_strict_mono_aux1", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.secant_strict_mono", "description": "", "p": "mathlib"}, {"name": "strict_convex_on_of_slope_strict_mono_adjacent", "description": " If for any three points `x < y < z`, the slope of the secant line of `f : \ud835\udd5c \u2192 \ud835\udd5c` on `[x, y]` is\nstrictly less than the slope of the secant line of `f` on `[x, z]`, then `f` is strictly convex.", "p": "mathlib"}, {"name": "convex_on.secant_mono", "description": "", "p": "mathlib"}, {"name": "convex_on.secant_mono_aux3", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.secant_strict_mono_aux3", "description": "", "p": "mathlib"}, {"name": "convex_on.secant_mono_aux2", "description": "", "p": "mathlib"}, {"name": "abel_ruffini.not_solvable_by_rad", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.leading_coeff_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.real_roots_Phi_le", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.real_roots_Phi_ge_aux", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.irreducible_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.coeff_five_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.nat_degree_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.map_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.not_solvable_by_rad'", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.\u03a6", "description": "A quintic polynomial that we will show is irreducible", "p": "mathlib-archive"}, {"name": "abel_ruffini.degree_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.coeff_zero_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.exists_not_solvable_by_rad", "description": "**Abel-Ruffini Theorem**", "p": "mathlib-archive"}, {"name": "abel_ruffini.monic_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.gal_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.complex_roots_Phi", "description": "", "p": "mathlib-archive"}, {"name": "abel_ruffini.real_roots_Phi_ge", "description": "", "p": "mathlib-archive"}, {"name": "category_theory.free_bicategory.of_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom", "description": "1-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom.of", "description": "1-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom.id", "description": "1-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom.comp", "description": "1-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_map", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_hom_id", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.of_map", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory", "description": "Free bicategory over a quiver. Its objects are the same as those in the underlying quiver.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_hom\u2082", "description": "Auxiliary definition for `lift`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_map\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_id", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.bicategory", "description": "Bicategory structure on the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_vcomp", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_associator_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_whisker_right", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_map_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.id", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.vcomp", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.whisker_left", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.whisker_right", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.associator", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.associator_inv", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.right_unitor", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.right_unitor_inv", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.left_unitor", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom\u2082.left_unitor_inv", "description": "Representatives of 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift", "description": "A prefunctor from a quiver `B` to a bicategory `C` can be lifted to a pseudofunctor from\n`free_bicategory B` to `C`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_map_id", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.vcomp_right", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.vcomp_left", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.id_comp", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.comp_id", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.assoc", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.whisker_left", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.whisker_left_id", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.whisker_left_comp", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.id_whisker_left", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.comp_whisker_left", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.whisker_right", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.id_whisker_right", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.comp_whisker_right", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.whisker_right_id", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.whisker_right_comp", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.whisker_assoc", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.whisker_exchange", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.associator_hom_inv", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.associator_inv_hom", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.left_unitor_hom_inv", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.left_unitor_inv_hom", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.right_unitor_hom_inv", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.right_unitor_inv_hom", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.pentagon", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.rel.triangle", "description": "Relations between 2-morphisms in the free bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_right_unitor_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_left_unitor_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_left_unitor_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_whisker_left", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.id_def", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_right_unitor_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_hom\u2082_congr", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.hom_category", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.of", "description": "Canonical prefunctor from `B` to `free_bicategory B`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_hom", "description": "Auxiliary definition for `lift`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.mk_associator_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.lift_hom_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.comp_def", "description": "", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded_covers", "description": "The union of all bounded set is the whole space.", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded.of_topological_space_le", "description": " If a topology `t'` is coarser than `t`, then any set `s` that is bounded with respect to\n`t` is bounded with respect to `t'`.", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded.union", "description": "The union of two bounded sets is bounded.", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded_iff", "description": "", "p": "mathlib"}, {"name": "normed_space.is_vonN_bounded_ball", "description": "", "p": "mathlib"}, {"name": "totally_bounded.is_vonN_bounded", "description": "", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded.smul_tendsto_zero", "description": "", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded.subset", "description": "Subsets of bounded sets are bounded.", "p": "mathlib"}, {"name": "filter.has_basis.is_vonN_bounded_basis_iff", "description": "", "p": "mathlib"}, {"name": "bornology.vonN_bornology", "description": " The von Neumann bornology defined by the von Neumann bounded sets.\n\nNote that this is not registered as an instance, in order to avoid diamonds with the\nmetric bornology.", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded", "description": "A set `s` is von Neumann bounded if every neighborhood of 0 absorbs `s`.", "p": "mathlib"}, {"name": "bornology.is_bounded_iff_is_vonN_bounded", "description": "", "p": "mathlib"}, {"name": "normed_space.is_bounded_iff_subset_smul_closed_ball", "description": "", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded_empty", "description": "", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded_of_smul_tendsto_zero", "description": "", "p": "mathlib"}, {"name": "normed_space.is_vonN_bounded_iff", "description": "", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded_iff_smul_tendsto_zero", "description": "Given any sequence `\u03b5` of scalars which tends to `\ud835\udcdd[\u2260] 0`, we have that a set `S` is bounded\n if and only if for any sequence `x : \u2115 \u2192 S`, `\u03b5 \u2022 x` tends to 0. This actually works for any\n indexing type `\u03b9`, but in the special case `\u03b9 = \u2115` we get the important fact that convergent\n sequences fully characterize bounded sets.", "p": "mathlib"}, {"name": "normed_space.vonN_bornology_eq", "description": " In a normed space, the von Neumann bornology (`bornology.vonN_bornology`) is equal to the\nmetric bornology.", "p": "mathlib"}, {"name": "normed_space.is_bounded_iff_subset_smul_ball", "description": "", "p": "mathlib"}, {"name": "normed_space.is_vonN_bounded_closed_ball", "description": "", "p": "mathlib"}, {"name": "normed_space.image_is_vonN_bounded_iff", "description": "", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded.image", "description": "A continuous linear image of a bounded set is bounded.", "p": "mathlib"}, {"name": "bornology.is_vonN_bounded_singleton", "description": "Singletons are bounded.", "p": "mathlib"}, {"name": "normed_space.is_vonN_bounded_iff'", "description": "", "p": "mathlib"}, {"name": "matrix.trace_fin_zero", "description": "", "p": "mathlib"}, {"name": "matrix.trace_transpose_mul", "description": "", "p": "mathlib"}, {"name": "matrix.trace_transpose", "description": "", "p": "mathlib"}, {"name": "matrix.trace_sub", "description": "", "p": "mathlib"}, {"name": "matrix.trace_col_mul_row", "description": "", "p": "mathlib"}, {"name": "matrix.trace_mul_cycle'", "description": "", "p": "mathlib"}, {"name": "matrix.trace_multiset_sum", "description": "", "p": "mathlib"}, {"name": "matrix.trace_add_monoid_hom", "description": "`matrix.trace` as an `add_monoid_hom`", "p": "mathlib"}, {"name": "matrix.trace_smul", "description": "", "p": "mathlib"}, {"name": "matrix.trace_zero", "description": "", "p": "mathlib"}, {"name": "matrix.trace_mul_cycle", "description": "", "p": "mathlib"}, {"name": "matrix.trace_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "matrix.trace_sum", "description": "", "p": "mathlib"}, {"name": "matrix.trace_fin_three", "description": "", "p": "mathlib"}, {"name": "matrix.trace_conj_transpose", "description": "", "p": "mathlib"}, {"name": "matrix.trace_fin_one", "description": "", "p": "mathlib"}, {"name": "matrix.trace_fin_two", "description": "", "p": "mathlib"}, {"name": "matrix.trace_neg", "description": "", "p": "mathlib"}, {"name": "matrix.trace_add", "description": "", "p": "mathlib"}, {"name": "matrix.trace_linear_map_apply", "description": "", "p": "mathlib"}, {"name": "matrix.trace", "description": " The trace of a square matrix. For more bundled versions, see:\n* `matrix.trace_add_monoid_hom`\n* `matrix.trace_linear_map`", "p": "mathlib"}, {"name": "matrix.trace_linear_map", "description": "`matrix.trace` as a `linear_map`", "p": "mathlib"}, {"name": "matrix.trace_mul_comm", "description": "", "p": "mathlib"}, {"name": "matrix.trace_list_sum", "description": "", "p": "mathlib"}, {"name": "matrix.trace_one", "description": "", "p": "mathlib"}, {"name": "units.is_open", "description": "The group of units of a complete normed ring is an open subset of the ring.", "p": "mathlib"}, {"name": "units.is_open_map_coe", "description": " In a normed ring, the coercion from `R\u02e3` (equipped with the induced topology from the\nembedding in `R \u00d7 R`) to `R` is an open map.", "p": "mathlib"}, {"name": "ideal.is_maximal.closure_eq", "description": "The `ideal.closure` of a maximal ideal in a complete normed ring is the ideal itself.", "p": "mathlib"}, {"name": "normed_ring.inverse_add", "description": "The formula `inverse (x + t) = inverse (1 + x\u207b\u00b9 * t) * x\u207b\u00b9` holds for `t` sufficiently small.", "p": "mathlib"}, {"name": "normed_ring.inverse_one_sub", "description": "", "p": "mathlib"}, {"name": "normed_ring.inverse_add_norm_diff_first_order", "description": "The function `\u03bb t, inverse (x + t) - x\u207b\u00b9` is `O(t)` as `t \u2192 0`.", "p": "mathlib"}, {"name": "normed_ring.inverse_one_sub_norm", "description": "", "p": "mathlib"}, {"name": "units.add", "description": " In a complete normed ring, a perturbation of a unit `x` by an element `t` of distance less than\n`\u2016x\u207b\u00b9\u2016\u207b\u00b9` from `x` is a unit.  Here we construct its `units` structure.", "p": "mathlib"}, {"name": "units.coe_one_sub", "description": "", "p": "mathlib"}, {"name": "units.unit_of_nearby", "description": " In a complete normed ring, an element `y` of distance less than `\u2016x\u207b\u00b9\u2016\u207b\u00b9` from `x` is a unit.\nHere we construct its `units` structure.", "p": "mathlib"}, {"name": "units.open_embedding_coe", "description": " In a normed ring, the coercion from `R\u02e3` (equipped with the induced topology from the\nembedding in `R \u00d7 R`) to `R` is an open embedding.", "p": "mathlib"}, {"name": "units.one_sub", "description": " In a complete normed ring, a perturbation of `1` by an element `t` of distance less than `1`\nfrom `1` is a unit.  Here we construct its `units` structure.", "p": "mathlib"}, {"name": "normed_ring.inverse_continuous_at", "description": "The function `inverse` is continuous at each unit of `R`.", "p": "mathlib"}, {"name": "ideal.is_maximal.is_closed", "description": "Maximal ideals in complete normed rings are closed.", "p": "mathlib"}, {"name": "normed_ring.inverse_add_norm", "description": "The function `\u03bb t, inverse (x + t)` is O(1) as `t \u2192 0`.", "p": "mathlib"}, {"name": "ideal.closure_ne_top", "description": "The `ideal.closure` of a proper ideal in a complete normed ring is proper.", "p": "mathlib"}, {"name": "nonunits.is_closed", "description": "", "p": "mathlib"}, {"name": "units.nhds", "description": "", "p": "mathlib"}, {"name": "normed_ring.inverse_one_sub_nth_order", "description": "", "p": "mathlib"}, {"name": "units.coe_unit_of_nearby", "description": "", "p": "mathlib"}, {"name": "normed_ring.inverse_add_norm_diff_second_order", "description": " The function\n`\u03bb t, inverse (x + t) - x\u207b\u00b9 + x\u207b\u00b9 * t * x\u207b\u00b9`\nis `O(t ^ 2)` as `t \u2192 0`.", "p": "mathlib"}, {"name": "nonunits.subset_compl_ball", "description": " The `nonunits` in a complete normed ring are contained in the complement of the ball of radius\n`1` centered at `1 : R`.", "p": "mathlib"}, {"name": "normed_ring.inverse_add_nth_order", "description": " The formula\n`inverse (x + t) = (\u2211 i in range n, (- x\u207b\u00b9 * t) ^ i) * x\u207b\u00b9 + (- x\u207b\u00b9 * t) ^ n * inverse (x + t)`\nholds for `t` sufficiently small.", "p": "mathlib"}, {"name": "ideal.eq_top_of_norm_lt_one", "description": "An ideal which contains an element within `1` of `1 : R` is the unit ideal.", "p": "mathlib"}, {"name": "units.coe_add", "description": "", "p": "mathlib"}, {"name": "normed_ring.inverse_add_norm_diff_nth_order", "description": " The function\n`\u03bb t, inverse (x + t) - (\u2211 i in range n, (- x\u207b\u00b9 * t) ^ i) * x\u207b\u00b9`\nis `O(t ^ n)` as `t \u2192 0`.", "p": "mathlib"}, {"name": "mv_polynomial.expand_monomial", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.map_expand", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.expand_bind\u2081", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.expand", "description": " Expand the polynomial by a factor of p, so `\u2211 a\u2099 x\u207f` becomes `\u2211 a\u2099 x\u207f\u1d56`.\n\nSee also `polynomial.expand`.", "p": "mathlib"}, {"name": "mv_polynomial.expand_X", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.expand_comp_bind\u2081", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.expand_C", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.rename_comp_expand", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.expand_one_apply", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.rename_expand", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.expand_one", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.generate_equivalence_opens_le_functor_obj_obj", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.whisker_iso_map_generate_cocone_inv_hom", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.generate_equivalence_opens_le_inverse_obj_obj", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.generate_equivalence_opens_le", "description": "Given a family of opens `U` and an open `Y` equal to the union of opens in `U`, we may\n   take the presieve on `Y` associated to `U` and the sieve generated by it, and form the\n   full subcategory (subposet) of opens contained in `Y` (`over Y`) consisting of arrows\n   in the sieve. This full subcategory is equivalent to `opens_le_cover U`, the (poset)\n   category of opens contained in some `U i`.", "p": "mathlib"}, {"name": "Top.presheaf.generate_equivalence_opens_le_counit_iso", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.sheaf_condition.opens_le_cover_cocone", "description": "`supr U` as a cocone over the opens sets contained in some element of the cover.\n\n(In fact this is a colimit cocone.)", "p": "mathlib"}, {"name": "Top.presheaf.sheaf_condition.opens_le_cover", "description": "The category of open sets contained in some element of the cover.", "p": "mathlib"}, {"name": "Top.presheaf.is_limit_opens_le_equiv_generate\u2082", "description": "Given a presheaf `F` on the topological space `X` and a presieve `R` whose generated sieve\n   is covering for the associated Grothendieck topology (equivalently, the presieve is covering\n   for the associated pretopology), the natural cone associated to `F` and the family of opens\n   associated to `R` is a limit cone iff the natural cone associated to `F` and the generated\n   sieve is a limit cone.\n   Since only the existence of a 1-1 correspondence will be used, the exact definition does\n   not matter, so tactics are used liberally.", "p": "mathlib"}, {"name": "Top.presheaf.generate_equivalence_opens_le_functor_map", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.sheaf_condition.opens_le_cover.index", "description": "An arbitrarily chosen index such that `V \u2264 U i`.", "p": "mathlib"}, {"name": "Top.presheaf.sheaf_condition.opens_le_cover.inhabited", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.sheaf_condition.opens_le_cover.category", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.sheaf_condition.opens_le_cover.hom_to_index", "description": "The morphism from `V` to `U i` for some `i`.", "p": "mathlib"}, {"name": "Top.presheaf.is_sheaf_iff_is_sheaf_opens_le_cover", "description": "A presheaf `(opens X)\u1d52\u1d56 \u2964 C` on a topological space `X` is a sheaf on the site `opens X` iff\n   it satisfies the `is_sheaf_opens_le_cover` sheaf condition. The latter is not the\n   official definition of sheaves on spaces, but has the advantage that it does not\n   require `has_products C`.", "p": "mathlib"}, {"name": "Top.presheaf.generate_equivalence_opens_le_inverse_map", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.whisker_iso_map_generate_cocone", "description": "Given a family of opens `opens_le_cover_cocone U` is essentially the natural cocone\n   associated to the sieve generated by the presieve associated to `U` with indexing\n   category changed using the above equivalence.", "p": "mathlib"}, {"name": "Top.presheaf.whisker_iso_map_generate_cocone_hom_hom", "description": "", "p": "mathlib"}, {"name": "Top.presheaf.is_limit_opens_le_equiv_generate\u2081", "description": "Given a presheaf `F` on the topological space `X` and a family of opens `U` of `X`,\n   the natural cone associated to `F` and `U` used in the definition of\n   `F.is_sheaf_opens_le_cover` is a limit cone iff the natural cone associated to `F`\n   and the sieve generated by the presieve associated to `U` is a limit cone.", "p": "mathlib"}, {"name": "Top.presheaf.is_sheaf_opens_le_cover", "description": "An equivalent formulation of the sheaf condition\n(which we prove equivalent to the usual one below as\n`is_sheaf_iff_is_sheaf_opens_le_cover`).\n\nA presheaf is a sheaf if `F` sends the cone `(opens_le_cover_cocone U).op` to a limit cone.\n(Recall `opens_le_cover_cocone U`, has cone point `supr U`,\nmapping down to any `V` which is contained in some `U i`.)", "p": "mathlib"}, {"name": "Top.presheaf.generate_equivalence_opens_le_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.coyoneda.colimit_cocone", "description": "The colimit cocone over `coyoneda.obj X`, with cocone point `punit`.", "p": "mathlib"}, {"name": "category_theory.coyoneda_functor_reflects_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.yoneda_jointly_reflects_limits", "description": "The yoneda embeddings jointly reflect limits.", "p": "mathlib"}, {"name": "category_theory.coyoneda.colimit_coyoneda_iso", "description": "The colimit of `coyoneda.obj X` is isomorphic to `punit`.", "p": "mathlib"}, {"name": "category_theory.coyoneda.colimit_cocone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.coyoneda_jointly_reflects_limits", "description": "The coyoneda embeddings jointly reflect limits.", "p": "mathlib"}, {"name": "category_theory.coyoneda.colimit_cocone_\u03b9_app", "description": "", "p": "mathlib"}, {"name": "category_theory.yoneda_functor_preserves_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.yoneda_functor_reflects_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.yoneda_preserves_limits", "description": "The yoneda embedding `yoneda.obj X : C\u1d52\u1d56 \u2964 Type v` for `X : C` preserves limits.", "p": "mathlib"}, {"name": "category_theory.coyoneda.obj.category_theory.limits.has_colimit", "description": "", "p": "mathlib"}, {"name": "category_theory.coyoneda_functor_preserves_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.coyoneda.colimit_cocone_is_colimit", "description": "The proposed colimit cocone over `coyoneda.obj X` is a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.coyoneda.colimit_cocone_is_colimit_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.coyoneda_preserves_limits", "description": "The coyoneda embedding `coyoneda.obj X : C \u2964 Type v` for `X : C\u1d52\u1d56` preserves limits.", "p": "mathlib"}, {"name": "local_context.is_subset", "description": "", "p": "core"}, {"name": "local_context.has_mem", "description": "", "p": "core"}, {"name": "local_context.has_to_format", "description": "", "p": "core"}, {"name": "local_context.mk_local", "description": " Add a new local constant to the lc. The new local has an unused unique_name.\nFails when the type depends on local constants that are not present in the context.", "p": "core"}, {"name": "local_decl", "description": "", "p": "core"}, {"name": "local_decl.unique_name", "description": "", "p": "core"}, {"name": "local_decl.pp_name", "description": "", "p": "core"}, {"name": "local_decl.type", "description": "", "p": "core"}, {"name": "local_decl.value", "description": "", "p": "core"}, {"name": "local_decl.bi", "description": "", "p": "core"}, {"name": "local_decl.idx", "description": "", "p": "core"}, {"name": "local_context", "description": " A local context is a list of local constant declarations.\nEach metavariable in a metavariable context holds a local_context\nto declare which locals the metavariable is allowed to depend on.", "p": "core"}, {"name": "local_context.get_local_decl", "description": "", "p": "core"}, {"name": "local_context.has_decidable_eq", "description": "", "p": "core"}, {"name": "local_decl.to_expr", "description": "", "p": "core"}, {"name": "local_context.has_emptyc", "description": "", "p": "core"}, {"name": "local_context.has_le", "description": "", "p": "core"}, {"name": "local_context.to_list", "description": "", "p": "core"}, {"name": "local_context.decidable_rel", "description": "", "p": "core"}, {"name": "local_context.empty", "description": "The empty local context.", "p": "core"}, {"name": "local_context.has_mem.mem.decidable", "description": "", "p": "core"}, {"name": "local_context.to_format", "description": "", "p": "core"}, {"name": "local_context.fold", "description": "", "p": "core"}, {"name": "local_context.get_local", "description": "", "p": "core"}, {"name": "local_context.inhabited", "description": "", "p": "core"}, {"name": "upper_set.coe_Ici_Sup_hom", "description": "", "p": "mathlib"}, {"name": "lower_set.Iic_Inf_hom", "description": "`lower_set.Iic` as an `Inf_hom`.", "p": "mathlib"}, {"name": "upper_set.Ici_sup_hom", "description": "`upper_set.Ici` as a `sup_hom`.", "p": "mathlib"}, {"name": "lower_set.Iic_inf_hom", "description": "`lower_set.Iic` as an `inf_hom`.", "p": "mathlib"}, {"name": "upper_set.Ici_Sup_hom", "description": "`upper_set.Ici` as a `Sup_hom`.", "p": "mathlib"}, {"name": "upper_set.Ici_Sup_hom_apply", "description": "", "p": "mathlib"}, {"name": "upper_set.coe_Ici_sup_hom", "description": "", "p": "mathlib"}, {"name": "lower_set.coe_Iic_inf_hom", "description": "", "p": "mathlib"}, {"name": "lower_set.Iic_Inf_hom_apply", "description": "", "p": "mathlib"}, {"name": "lower_set.Iic_inf_hom_apply", "description": "", "p": "mathlib"}, {"name": "lower_set.coe_Iic_Inf_hom", "description": "", "p": "mathlib"}, {"name": "upper_set.Ici_sup_hom_apply", "description": "", "p": "mathlib"}, {"name": "rat.uniform_continuous_add", "description": "", "p": "mathlib"}, {"name": "rat.order_topology", "description": "", "p": "mathlib"}, {"name": "nat.closed_embedding_coe_rat", "description": "", "p": "mathlib"}, {"name": "int.dist_cast_rat", "description": "", "p": "mathlib"}, {"name": "nat.uniform_embedding_coe_rat", "description": "", "p": "mathlib"}, {"name": "rat.topological_ring", "description": "", "p": "mathlib"}, {"name": "rat.dist_eq", "description": "", "p": "mathlib"}, {"name": "rat.totally_bounded_Icc", "description": "", "p": "mathlib"}, {"name": "rat.uniform_continuous_neg", "description": "", "p": "mathlib"}, {"name": "int.closed_embedding_coe_rat", "description": "", "p": "mathlib"}, {"name": "rat.topological_add_group", "description": "", "p": "mathlib"}, {"name": "rat.embedding_coe_real", "description": "", "p": "mathlib"}, {"name": "rat.uniform_continuous_coe_real", "description": "", "p": "mathlib"}, {"name": "rat.uniform_continuous_abs", "description": "", "p": "mathlib"}, {"name": "rat.continuous_mul", "description": "", "p": "mathlib"}, {"name": "nat.dist_cast_rat", "description": "", "p": "mathlib"}, {"name": "rat.noncompact_space", "description": "", "p": "mathlib"}, {"name": "rat.uniform_add_group", "description": "", "p": "mathlib"}, {"name": "rat.uniform_embedding_coe_real", "description": "", "p": "mathlib"}, {"name": "rat.dense_embedding_coe_real", "description": "", "p": "mathlib"}, {"name": "rat.metric_space", "description": "", "p": "mathlib"}, {"name": "rat.dist_cast", "description": "", "p": "mathlib"}, {"name": "rat.continuous_coe_real", "description": "", "p": "mathlib"}, {"name": "int.uniform_embedding_coe_rat", "description": "", "p": "mathlib"}, {"name": "category_theory.End.mul_action_right", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Aut", "description": "`f.map_iso` as a group hom between automorphism groups.", "p": "mathlib"}, {"name": "category_theory.Aut.units_End_equiv_Aut", "description": "Units in the monoid of endomorphisms of an object\nare (multiplicatively) equivalent to automorphisms of that object.", "p": "mathlib"}, {"name": "category_theory.End.mul_action_left", "description": "", "p": "mathlib"}, {"name": "category_theory.is_unit_iff_is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_End", "description": "`f.map` as a monoid hom between endomorphism monoids.", "p": "mathlib"}, {"name": "category_theory.End.monoid", "description": "Endomorphisms of an object form a monoid", "p": "mathlib"}, {"name": "category_theory.Aut.Aut_mul_equiv_of_iso", "description": "Isomorphisms induce isomorphisms of the automorphism group", "p": "mathlib"}, {"name": "category_theory.Aut.Aut_inv_def", "description": "", "p": "mathlib"}, {"name": "category_theory.End.mul_def", "description": "", "p": "mathlib"}, {"name": "category_theory.End.of", "description": "Assist the typechecker by expressing a morphism `X \u27f6 X` as a term of `End X`.", "p": "mathlib"}, {"name": "category_theory.End.has_mul", "description": "Multiplication of endomorphisms agrees with `function.comp`, not `category_struct.comp`.", "p": "mathlib"}, {"name": "category_theory.End.as_hom", "description": "Assist the typechecker by expressing an endomorphism `f : End X` as a term of `X \u27f6 X`.", "p": "mathlib"}, {"name": "category_theory.End.has_one", "description": "", "p": "mathlib"}, {"name": "category_theory.End.one_def", "description": "", "p": "mathlib"}, {"name": "category_theory.End.smul_right", "description": "", "p": "mathlib"}, {"name": "category_theory.End.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.Aut", "description": "Automorphisms of an object in a category.\n\nThe order of arguments in multiplication agrees with\n`function.comp`, not with `category.comp`.", "p": "mathlib"}, {"name": "category_theory.Aut.Aut_mul_def", "description": "", "p": "mathlib"}, {"name": "category_theory.End", "description": " Endomorphisms of an object in a category. Arguments order in multiplication agrees with\n`function.comp`, not with `category.comp`.", "p": "mathlib"}, {"name": "category_theory.Aut.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.End.smul_left", "description": "", "p": "mathlib"}, {"name": "category_theory.Aut.group", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_End_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.End.group", "description": "In a groupoid, endomorphisms form a group", "p": "mathlib"}, {"name": "add_action.of_quotient_stabilizer_vadd", "description": "", "p": "mathlib"}, {"name": "mul_action.quotient.smul_mk", "description": "", "p": "mathlib"}, {"name": "add_action.orbit_sum_stabilizer_equiv_add_group", "description": "Orbit-stabilizer theorem.", "p": "mathlib"}, {"name": "add_action.self_equiv_sigma_orbits_quotient_stabilizer", "description": "**Class formula**. This is a special case of\n`add_action.self_equiv_sigma_orbits_quotient_stabilizer'` with `\u03c6 = quotient.out'`.", "p": "mathlib"}, {"name": "add_action.sum_card_fixed_by_eq_card_orbits_add_card_add_group", "description": "**Burnside's lemma** : given a finite additive group `G` acting on a set `X`,\nthe average number of elements fixed by each `g \u2208 G` is the number of orbits.", "p": "mathlib"}, {"name": "mul_action.mul_left_cosets_comp_subtype_val", "description": "", "p": "mathlib"}, {"name": "mul_action.quotient.mk_smul_out'", "description": "", "p": "mathlib"}, {"name": "subgroup.quotient_center_embedding", "description": " If `G` is generated by `S`, then the quotient by the center embeds into `S`-indexed sequences\nof commutators.", "p": "mathlib"}, {"name": "add_action.add_left_cosets_comp_subtype_val", "description": "", "p": "mathlib"}, {"name": "add_action.right_quotient_action'", "description": "", "p": "mathlib"}, {"name": "add_action.quotient", "description": "", "p": "mathlib"}, {"name": "mul_action.quotient.coe_smul_out'", "description": "", "p": "mathlib"}, {"name": "add_action.is_pretransitive_quotient", "description": "", "p": "mathlib"}, {"name": "mul_action.of_quotient_stabilizer_smul", "description": "", "p": "mathlib"}, {"name": "add_action.quotient.coe_vadd_out'", "description": "", "p": "mathlib"}, {"name": "mul_action.left_quotient_action", "description": "", "p": "mathlib"}, {"name": "mul_action.injective_of_quotient_stabilizer", "description": "", "p": "mathlib"}, {"name": "mul_action.right_quotient_action'", "description": "", "p": "mathlib"}, {"name": "add_action.quotient.mk_vadd_out'", "description": "", "p": "mathlib"}, {"name": "add_action.left_quotient_action", "description": "", "p": "mathlib"}, {"name": "mul_action.self_equiv_sigma_orbits_quotient_stabilizer", "description": " **Class formula**. This is a special case of\n`mul_action.self_equiv_sigma_orbits_quotient_stabilizer'` with `\u03c6 = quotient.out'`.", "p": "mathlib"}, {"name": "add_action.stabilizer_quotient", "description": "", "p": "mathlib"}, {"name": "mul_action.orbit_prod_stabilizer_equiv_group", "description": "Orbit-stabilizer theorem.", "p": "mathlib"}, {"name": "mul_action.self_equiv_sigma_orbits_quotient_stabilizer'", "description": " **Class formula** : given `G` a group acting on `X` and `\u03c6` a function mapping each orbit of `X`\nunder this action (that is, each element of the quotient of `X` by the relation `orbit_rel G X`) to\nan element in this orbit, this gives a (noncomputable) bijection between `X` and the disjoint union\nof `G/Stab(\u03c6(\u03c9))` over all orbits `\u03c9`. In most cases you'll want `\u03c6` to be `quotient.out'`, so we\nprovide `mul_action.self_equiv_sigma_orbits_quotient_stabilizer` as a special case.", "p": "mathlib"}, {"name": "subgroup.normal_core_eq_ker", "description": "", "p": "mathlib"}, {"name": "quotient_group.out'_conj_pow_minimal_period_mem", "description": "", "p": "mathlib"}, {"name": "add_action.of_quotient_stabilizer_mk", "description": "", "p": "mathlib"}, {"name": "mul_action.sum_card_fixed_by_eq_card_orbits_mul_card_group", "description": " **Burnside's lemma** : given a finite group `G` acting on a set `X`, the average number of\nelements fixed by each `g \u2208 G` is the number of orbits.", "p": "mathlib"}, {"name": "mul_action.quotient_action", "description": "A typeclass for when a `mul_action \u03b2 \u03b1` descends to the quotient `\u03b1 \u29f8 H`.", "p": "mathlib"}, {"name": "mul_action.quotient_action.inv_mul_mem", "description": "A typeclass for when a `mul_action \u03b2 \u03b1` descends to the quotient `\u03b1 \u29f8 H`.", "p": "mathlib"}, {"name": "add_action.quotient_action", "description": "A typeclass for when an `add_action \u03b2 \u03b1` descends to the quotient `\u03b1 \u29f8 H`.", "p": "mathlib"}, {"name": "add_action.quotient_action.inv_mul_mem", "description": "A typeclass for when an `add_action \u03b2 \u03b1` descends to the quotient `\u03b1 \u29f8 H`.", "p": "mathlib"}, {"name": "add_action.of_quotient_stabilizer", "description": "The canonical map from the quotient of the stabilizer to the set.", "p": "mathlib"}, {"name": "add_action.orbit_equiv_quotient_stabilizer", "description": "Orbit-stabilizer theorem.", "p": "mathlib"}, {"name": "add_action.self_equiv_sigma_orbits_quotient_stabilizer'", "description": "**Class formula** : given `G` an additive group acting on `X` and `\u03c6` a function\nmapping each orbit of `X` under this action (that is, each element of the quotient of `X` by the\nrelation `orbit_rel G X`) to an element in this orbit, this gives a (noncomputable) bijection\nbetween `X` and the disjoint union of `G/Stab(\u03c6(\u03c9))` over all orbits `\u03c9`. In most cases you'll want\n`\u03c6` to be `quotient.out'`, so we provide `add_action.self_equiv_sigma_orbits_quotient_stabilizer`\nas a special case.", "p": "mathlib"}, {"name": "add_action.card_orbit_add_card_stabilizer_eq_card_add_group", "description": "Orbit-stabilizer theorem.", "p": "mathlib"}, {"name": "add_action.injective_of_quotient_stabilizer", "description": "", "p": "mathlib"}, {"name": "add_action.card_eq_sum_card_add_group_sub_card_stabilizer'", "description": "**Class formula** for a finite group acting on a finite type. See\n`add_action.card_eq_sum_card_add_group_div_card_stabilizer` for a specialized version using\n`quotient.out'`.", "p": "mathlib"}, {"name": "mul_action.card_eq_sum_card_group_div_card_stabilizer'", "description": " **Class formula** for a finite group acting on a finite type. See\n`mul_action.card_eq_sum_card_group_div_card_stabilizer` for a specialized version using\n`quotient.out'`.", "p": "mathlib"}, {"name": "add_action.right_quotient_action", "description": "", "p": "mathlib"}, {"name": "mul_action.of_quotient_stabilizer", "description": "The canonical map from the quotient of the stabilizer to the set.", "p": "mathlib"}, {"name": "subgroup.quotient_center_embedding_apply", "description": "", "p": "mathlib"}, {"name": "subgroup.quotient_centralizer_embedding", "description": "Cosets of the centralizer of an element embed into the set of commutators.", "p": "mathlib"}, {"name": "add_action.orbit_equiv_quotient_stabilizer_symm_apply", "description": "", "p": "mathlib"}, {"name": "mul_action.of_quotient_stabilizer_mem_orbit", "description": "", "p": "mathlib"}, {"name": "mul_action_hom.to_quotient_apply", "description": "", "p": "mathlib"}, {"name": "mul_action.orbit_equiv_quotient_stabilizer_symm_apply", "description": "", "p": "mathlib"}, {"name": "mul_action.of_quotient_stabilizer_mk", "description": "", "p": "mathlib"}, {"name": "add_action.sigma_fixed_by_equiv_orbits_sum_add_group", "description": "**Burnside's lemma** : a (noncomputable) bijection between the disjoint union of all\n`{x \u2208 X | g \u2022 x = x}` for `g \u2208 G` and the product `G \u00d7 X/G`, where `G` is an additive group acting\non `X` and `X/G`denotes the quotient of `X` by the relation `orbit_rel G X`.", "p": "mathlib"}, {"name": "mul_action.card_orbit_mul_card_stabilizer_eq_card_group", "description": "Orbit-stabilizer theorem.", "p": "mathlib"}, {"name": "mul_action.quotient", "description": "", "p": "mathlib"}, {"name": "mul_action.card_eq_sum_card_group_div_card_stabilizer", "description": "**Class formula** for a finite group acting on a finite type.", "p": "mathlib"}, {"name": "mul_action.stabilizer_quotient", "description": "", "p": "mathlib"}, {"name": "mul_action.quotient.smul_coe", "description": "", "p": "mathlib"}, {"name": "mul_action.sigma_fixed_by_equiv_orbits_prod_group", "description": " **Burnside's lemma** : a (noncomputable) bijection between the disjoint union of all\n`{x \u2208 X | g \u2022 x = x}` for `g \u2208 G` and the product `G \u00d7 X/G`, where `G` is a group acting on `X` and\n`X/G`denotes the quotient of `X` by the relation `orbit_rel G X`.", "p": "mathlib"}, {"name": "subgroup.quotient_centralizer_embedding_apply", "description": "", "p": "mathlib"}, {"name": "mul_action.orbit_equiv_quotient_stabilizer", "description": "Orbit-stabilizer theorem.", "p": "mathlib"}, {"name": "mul_action.is_pretransitive_quotient", "description": "", "p": "mathlib"}, {"name": "add_action.card_eq_sum_card_add_group_sub_card_stabilizer", "description": "**Class formula** for a finite group acting on a finite type.", "p": "mathlib"}, {"name": "mul_action.right_quotient_action", "description": "", "p": "mathlib"}, {"name": "add_action.of_quotient_stabilizer_mem_orbit", "description": "", "p": "mathlib"}, {"name": "add_action.quotient.vadd_mk", "description": "", "p": "mathlib"}, {"name": "mul_action_hom.to_quotient", "description": "The canonical map to the left cosets.", "p": "mathlib"}, {"name": "add_action.quotient.vadd_coe", "description": "", "p": "mathlib"}, {"name": "complex.eq_of_is_max_on_of_ball_subset", "description": " **Maximum modulus principle**. Let `f : E \u2192 F` be a function between complex normed spaces.\nSuppose that the codomain `F` is a strictly convex space, `f` is complex differentiable on a set\n`s`, `f` is continuous on the closure of `s`, the norm of `f` takes it maximum on `s` at `z`, and\n`w` is a point such that the closed ball with center `z` and radius `dist w z` is included in `s`,\nthen `f w = f z`.", "p": "mathlib"}, {"name": "complex.eq_on_closure_of_eq_on_frontier", "description": " If two complex differentiable functions `f g : E \u2192 F` are equal on the boundary of a bounded set\n`U`, then they are equal on `closure U`.", "p": "mathlib"}, {"name": "complex.eventually_eq_or_eq_zero_of_is_local_min_norm", "description": "", "p": "mathlib"}, {"name": "complex.norm_le_of_forall_mem_frontier_norm_le", "description": " **Maximum modulus principle**: if `f : E \u2192 F` is complex differentiable on a bounded set `U` and\n`\u2016f z\u2016 \u2264 C` for any `z \u2208 frontier U`, then the same is true for any `z \u2208 closure U`.", "p": "mathlib"}, {"name": "complex.norm_eventually_eq_of_is_local_max", "description": " **Maximum modulus principle**: if `f : E \u2192 F` is complex differentiable in a neighborhood of `c`\nand the norm `\u2016f z\u2016` has a local maximum at `c`, then `\u2016f z\u2016` is locally constant in a neighborhood\nof `c`.", "p": "mathlib"}, {"name": "complex.norm_max_aux\u2081", "description": "", "p": "mathlib"}, {"name": "complex.eq_on_closure_of_is_preconnected_of_is_max_on_norm", "description": " **Maximum modulus principle** on a connected set. Let `U` be a (pre)connected open set in a\ncomplex normed space.  Let `f : E \u2192 F` be a function that is complex differentiable on `U` and is\ncontinuous on its closure. Suppose that `\u2016f x\u2016` takes its maximum value on `U` at `c \u2208 U`. Then\n`f x = f c` for all `x \u2208 closure U`.", "p": "mathlib"}, {"name": "complex.eq_on_closed_ball_of_is_max_on_norm", "description": " **Maximum modulus principle** on a closed ball. Suppose that a function `f : E \u2192 F` from a\nnormed complex space to a strictly convex normed complex space has the following properties:\n\n- it is continuous on a closed ball `metric.closed_ball z r`,\n- it is complex differentiable on the corresponding open ball;\n- the norm `\u2016f w\u2016` takes its maximum value on the open ball at its center.\n\nThen `f` is a constant on the closed ball.", "p": "mathlib"}, {"name": "complex.eq_on_of_is_preconnected_of_is_max_on_norm", "description": " **Maximum modulus principle** on a connected set. Let `U` be a (pre)connected open set in a\ncomplex normed space.  Let `f : E \u2192 F` be a function that is complex differentiable on `U`. Suppose\nthat `\u2016f x\u2016` takes its maximum value on `U` at `c \u2208 U`. Then `f x = f c` for all `x \u2208 U`.\n\nTODO: change assumption from `is_max_on` to `is_local_max`.", "p": "mathlib"}, {"name": "complex.norm_eq_on_of_is_preconnected_of_is_max_on", "description": " **Maximum modulus principle** on a connected set. Let `U` be a (pre)connected open set in a\ncomplex normed space. Let `f : E \u2192 F` be a function that is complex differentiable on `U`. Suppose\nthat `\u2016f x\u2016` takes its maximum value on `U` at `c \u2208 U`. Then `\u2016f x\u2016 = \u2016f c\u2016` for all `x \u2208 U`.", "p": "mathlib"}, {"name": "complex.norm_eq_on_closed_ball_of_is_max_on", "description": " **Maximum modulus principle** on a closed ball: if `f : E \u2192 F` is continuous on a closed ball,\nis complex differentiable on the corresponding open ball, and the norm `\u2016f w\u2016` takes its maximum\nvalue on the open ball at its center, then the norm `\u2016f w\u2016` is constant on the closed ball.", "p": "mathlib"}, {"name": "complex.is_open_set_of_mem_nhds_and_is_max_on_norm", "description": "", "p": "mathlib"}, {"name": "complex.norm_max_aux\u2083", "description": "", "p": "mathlib"}, {"name": "complex.exists_mem_frontier_is_max_on_norm", "description": " **Maximum modulus principle**: if `f : E \u2192 F` is complex differentiable on a nonempty bounded\nset `U` and is continuous on its closure, then there exists a point `z \u2208 frontier U` such that\n`\u03bb z, \u2016f z\u2016` takes it maximum value on `closure U` at `z`.", "p": "mathlib"}, {"name": "complex.norm_max_aux\u2082", "description": "", "p": "mathlib"}, {"name": "complex.eq_on_of_eq_on_frontier", "description": " If two complex differentiable functions `f g : E \u2192 F` are equal on the boundary of a bounded set\n`U`, then they are equal on `U`.", "p": "mathlib"}, {"name": "complex.norm_eq_on_closure_of_is_preconnected_of_is_max_on", "description": " **Maximum modulus principle** on a connected set. Let `U` be a (pre)connected open set in a\ncomplex normed space.  Let `f : E \u2192 F` be a function that is complex differentiable on `U` and is\ncontinuous on its closure. Suppose that `\u2016f x\u2016` takes its maximum value on `U` at `c \u2208 U`. Then\n`\u2016f x\u2016 = \u2016f c\u2016` for all `x \u2208 closure U`.", "p": "mathlib"}, {"name": "complex.norm_eq_norm_of_is_max_on_of_ball_subset", "description": " **Maximum modulus principle**: if `f : E \u2192 F` is complex differentiable on a set `s`, the norm\nof `f` takes it maximum on `s` at `z`, and `w` is a point such that the closed ball with center `z`\nand radius `dist w z` is included in `s`, then `\u2016f w\u2016 = \u2016f z\u2016`.", "p": "mathlib"}, {"name": "complex.eventually_eq_of_is_local_max_norm", "description": " **Maximum modulus principle**: if `f : E \u2192 F` is complex differentiable in a neighborhood of `c`\nand the norm `\u2016f z\u2016` has a local maximum at `c`, then `f` is locally constant in a neighborhood\nof `c`.", "p": "mathlib"}, {"name": "commute.multiset_sum_right", "description": "", "p": "mathlib"}, {"name": "commute.multiset_sum_left", "description": "", "p": "mathlib"}, {"name": "multiset.sum_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "multiset.dvd_prod", "description": "", "p": "mathlib"}, {"name": "multiset.prod_eq_one_iff", "description": "", "p": "mathlib"}, {"name": "not_disjoint_segment_convex_hull_triple", "description": " In a tetrahedron with vertices `x`, `y`, `p`, `q`, any segment `[u, v]` joining the opposite\nedges `[x, p]` and `[y, q]` passes through any triangle of vertices `p`, `q`, `z` where\n`z \u2208 [x, y]`.", "p": "mathlib"}, {"name": "exists_convex_convex_compl_subset", "description": "**Stone's Separation Theorem**", "p": "mathlib"}, {"name": "op_nnnorm_mul", "description": " In a C\u22c6-algebra `E`, either unital or non-unital, multiplication on the left by `a : E` has\nnorm equal to the norm of `a`.", "p": "mathlib"}, {"name": "mul_isometry", "description": " In a C\u22c6-algebra `E`, either unital or non-unital, the left regular representation is an\nisometry.", "p": "mathlib"}, {"name": "op_nnnorm_mul_flip", "description": " In a C\u22c6-algebra `E`, either unital or non-unital, multiplication on the right by `a : E` has\nnorm eqaul to the norm of `a`.", "p": "mathlib"}, {"name": "mul_flip_isometry", "description": " In a C\u22c6-algebra `E`, either unital or non-unital, the right regular anti-representation is an\nisometry.", "p": "mathlib"}, {"name": "locally_bounded_map.coe_copy", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.has_coe_t", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.id_comp", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.cancel_right", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.comp_apply", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.coe_comp", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.locally_bounded_map_class", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.coe_id", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.comp_id", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.cancel_left", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.of_map_bounded_apply", "description": "", "p": "mathlib"}, {"name": "is_bounded.image", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.copy", "description": " Copy of a `locally_bounded_map` with a new `to_fun` equal to the old one. Useful to fix\ndefinitional equalities.", "p": "mathlib"}, {"name": "locally_bounded_map.comp_assoc", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.of_map_bounded", "description": " Construct a `locally_bounded_map` from the fact that the function maps bounded sets to bounded\nsets.", "p": "mathlib"}, {"name": "locally_bounded_map.coe_of_map_bounded", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.inhabited", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map", "description": "The type of bounded maps from `\u03b1` to `\u03b2`, the maps which send a bounded set to a bounded set.", "p": "mathlib"}, {"name": "locally_bounded_map.to_fun", "description": "The type of bounded maps from `\u03b1` to `\u03b2`, the maps which send a bounded set to a bounded set.", "p": "mathlib"}, {"name": "locally_bounded_map.comap_cobounded_le'", "description": "The type of bounded maps from `\u03b1` to `\u03b2`, the maps which send a bounded set to a bounded set.", "p": "mathlib"}, {"name": "locally_bounded_map.comp", "description": "Composition of `locally_bounded_map`s as a `locally_bounded_map`.", "p": "mathlib"}, {"name": "locally_bounded_map.id", "description": "`id` as a `locally_bounded_map`.", "p": "mathlib"}, {"name": "locally_bounded_map.has_coe_to_fun", "description": " Helper instance for when there's too many metavariables to apply `fun_like.has_coe_to_fun`\ndirectly.", "p": "mathlib"}, {"name": "locally_bounded_map_class", "description": " `locally_bounded_map_class F \u03b1 \u03b2` states that `F` is a type of bounded maps.\n\nYou should extend this class when you extend `locally_bounded_map`.", "p": "mathlib"}, {"name": "locally_bounded_map_class.coe", "description": " `locally_bounded_map_class F \u03b1 \u03b2` states that `F` is a type of bounded maps.\n\nYou should extend this class when you extend `locally_bounded_map`.", "p": "mathlib"}, {"name": "locally_bounded_map_class.coe_injective'", "description": " `locally_bounded_map_class F \u03b1 \u03b2` states that `F` is a type of bounded maps.\n\nYou should extend this class when you extend `locally_bounded_map`.", "p": "mathlib"}, {"name": "locally_bounded_map_class.comap_cobounded_le", "description": " `locally_bounded_map_class F \u03b1 \u03b2` states that `F` is a type of bounded maps.\n\nYou should extend this class when you extend `locally_bounded_map`.", "p": "mathlib"}, {"name": "locally_bounded_map.ext", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map_class.to_fun_like", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.copy_eq", "description": "", "p": "mathlib"}, {"name": "locally_bounded_map.id_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.dold_kan.N", "description": "The functor `N` for the equivalence is `normalized_Moore_complex A`", "p": "mathlib"}, {"name": "category_theory.abelian.dold_kan.equivalence_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.dold_kan.comparison_N_inv_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.dold_kan.comparison_N_hom_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian.dold_kan.\u0393", "description": "The functor `\u0393` for the equivalence is the same as in the pseudoabelian case.", "p": "mathlib"}, {"name": "category_theory.abelian.dold_kan.equivalence", "description": "The Dold-Kan equivalence for abelian categories", "p": "mathlib"}, {"name": "category_theory.abelian.dold_kan.comparison_N", "description": " The comparison isomorphism between `normalized_Moore_complex A` and\nthe functor `idempotents.dold_kan.N` from the pseudoabelian case", "p": "mathlib"}, {"name": "category_theory.abelian.dold_kan.equivalence_inverse", "description": "", "p": "mathlib"}, {"name": "exposed_point_def", "description": "", "p": "mathlib"}, {"name": "is_exposed.antisymm", "description": "", "p": "mathlib"}, {"name": "is_exposed", "description": " A set `B` is exposed with respect to `A` iff it maximizes some functional over `A` (and contains\nall points maximizing it). Written `is_exposed \ud835\udd5c A B`.", "p": "mathlib"}, {"name": "is_exposed.eq_inter_halfspace", "description": " For nontrivial `\ud835\udd5c`, if `B` is an exposed subset of `A`, then `B` is the intersection of `A` with\nsome closed halfspace. The converse is *not* true. It would require that the corresponding open\nhalfspace doesn't intersect `A`.", "p": "mathlib"}, {"name": "continuous_linear_map.to_exposed.is_exposed", "description": "", "p": "mathlib"}, {"name": "exposed_points_empty", "description": "", "p": "mathlib"}, {"name": "exposed_points_subset_extreme_points", "description": "", "p": "mathlib"}, {"name": "is_exposed.is_closed", "description": "", "p": "mathlib"}, {"name": "is_exposed.is_extreme", "description": "", "p": "mathlib"}, {"name": "is_exposed_empty", "description": "", "p": "mathlib"}, {"name": "is_exposed.mono", "description": "", "p": "mathlib"}, {"name": "is_exposed.is_compact", "description": "", "p": "mathlib"}, {"name": "is_exposed.sInter", "description": "", "p": "mathlib"}, {"name": "is_exposed.eq_inter_halfspace'", "description": " If `B` is a nonempty exposed subset of `A`, then `B` is the intersection of `A` with some closed\nhalfspace. The converse is *not* true. It would require that the corresponding open halfspace\ndoesn't intersect `A`.", "p": "mathlib"}, {"name": "is_exposed.inter", "description": "", "p": "mathlib"}, {"name": "mem_exposed_points_iff_exposed_singleton", "description": "Exposed points exactly correspond to exposed singletons.", "p": "mathlib"}, {"name": "exposed_points_subset", "description": "", "p": "mathlib"}, {"name": "set.exposed_points", "description": " A point is exposed with respect to `A` iff there exists an hyperplane whose intersection with\n`A` is exactly that point.", "p": "mathlib"}, {"name": "is_exposed.refl", "description": "", "p": "mathlib"}, {"name": "is_exposed.subset", "description": "", "p": "mathlib"}, {"name": "is_exposed.convex", "description": "", "p": "mathlib"}, {"name": "is_exposed.inter_right", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.to_exposed", "description": " A useful way to build exposed sets from intersecting `A` with halfspaces (modelled by an\ninequality with a functional).", "p": "mathlib"}, {"name": "is_exposed.inter_left", "description": "", "p": "mathlib"}, {"name": "tactic.flat_assoc", "description": "", "p": "core"}, {"name": "tactic.perm_ac", "description": "", "p": "core"}, {"name": "commute.geom_sum\u2082_Ico_mul", "description": "", "p": "mathlib"}, {"name": "geom_sum_two", "description": "", "p": "mathlib"}, {"name": "commute.geom_sum\u2082", "description": "", "p": "mathlib"}, {"name": "odd.add_dvd_pow_add_pow", "description": "", "p": "mathlib"}, {"name": "sub_dvd_pow_sub_pow", "description": "", "p": "mathlib"}, {"name": "commute.geom_sum\u2082_succ_eq", "description": "", "p": "mathlib"}, {"name": "geom_sum\u2082_with_one", "description": "", "p": "mathlib"}, {"name": "geom_sum_eq_zero_iff_neg_one", "description": "", "p": "mathlib"}, {"name": "op_geom_sum", "description": "", "p": "mathlib"}, {"name": "geom_sum_neg_iff", "description": "", "p": "mathlib"}, {"name": "geom_sum_ne_zero", "description": "", "p": "mathlib"}, {"name": "geom_sum_pos_iff", "description": "", "p": "mathlib"}, {"name": "nat.pred_mul_geom_sum_le", "description": "", "p": "mathlib"}, {"name": "geom_sum\u2082_self", "description": "", "p": "mathlib"}, {"name": "mul_neg_geom_sum", "description": "", "p": "mathlib"}, {"name": "neg_one_geom_sum", "description": "", "p": "mathlib"}, {"name": "nat.geom_sum_le", "description": "", "p": "mathlib"}, {"name": "zero_geom_sum", "description": "", "p": "mathlib"}, {"name": "geom_sum_eq", "description": "", "p": "mathlib"}, {"name": "geom_sum_Ico", "description": "", "p": "mathlib"}, {"name": "geom_sum_alternating_of_le_neg_one", "description": "", "p": "mathlib"}, {"name": "geom_sum\u2082_mul", "description": "", "p": "mathlib"}, {"name": "geom_sum_inv", "description": "", "p": "mathlib"}, {"name": "nat_sub_dvd_pow_sub_pow", "description": "", "p": "mathlib"}, {"name": "commute.geom_sum\u2082_mul_add", "description": "$x^n-y^n = (x-y) \\sum x^ky^{n-1-k}$ reformulated without `-` signs.", "p": "mathlib"}, {"name": "geom_sum_Ico_mul", "description": "", "p": "mathlib"}, {"name": "mul_geom_sum\u2082_Ico", "description": "", "p": "mathlib"}, {"name": "geom_sum_Ico_mul_neg", "description": "", "p": "mathlib"}, {"name": "op_geom_sum\u2082", "description": "", "p": "mathlib"}, {"name": "geom_sum_pos_and_lt_one", "description": "", "p": "mathlib"}, {"name": "mul_geom_sum", "description": "", "p": "mathlib"}, {"name": "geom_sum_mul_add", "description": "", "p": "mathlib"}, {"name": "geom_sum_mul", "description": "", "p": "mathlib"}, {"name": "geom_sum_alternating_of_lt_neg_one", "description": "", "p": "mathlib"}, {"name": "odd.nat_add_dvd_pow_add_pow", "description": "", "p": "mathlib"}, {"name": "commute.geom_sum\u2082_comm", "description": "", "p": "mathlib"}, {"name": "commute.geom_sum\u2082_mul", "description": "", "p": "mathlib"}, {"name": "geom_sum_mul_neg", "description": "", "p": "mathlib"}, {"name": "ring_hom.map_geom_sum\u2082", "description": "", "p": "mathlib"}, {"name": "geom_sum\u2082_mul_add", "description": "$x^n-y^n = (x-y) \\sum x^ky^{n-1-k}$ reformulated without `-` signs.", "p": "mathlib"}, {"name": "geom_sum_Ico_le_of_lt_one", "description": "", "p": "mathlib"}, {"name": "geom_sum_succ", "description": "", "p": "mathlib"}, {"name": "commute.mul_geom_sum\u2082", "description": "", "p": "mathlib"}, {"name": "commute.mul_neg_geom_sum\u2082", "description": "", "p": "mathlib"}, {"name": "commute.mul_geom_sum\u2082_Ico", "description": "", "p": "mathlib"}, {"name": "geom_sum_Ico'", "description": "", "p": "mathlib"}, {"name": "nat.geom_sum_Ico_le", "description": "", "p": "mathlib"}, {"name": "geom_sum\u2082_Ico", "description": "", "p": "mathlib"}, {"name": "odd.geom_sum_pos", "description": "", "p": "mathlib"}, {"name": "ring_hom.map_geom_sum", "description": "", "p": "mathlib"}, {"name": "geom_sum_one", "description": "", "p": "mathlib"}, {"name": "geom_sum_pos", "description": "", "p": "mathlib"}, {"name": "geom\u2082_sum", "description": "", "p": "mathlib"}, {"name": "geom_sum\u2082_succ_eq", "description": "", "p": "mathlib"}, {"name": "one_geom_sum", "description": "", "p": "mathlib"}, {"name": "commute.geom_sum\u2082_Ico", "description": "", "p": "mathlib"}, {"name": "geom_sum_pos'", "description": "", "p": "mathlib"}, {"name": "geom_sum\u2082_comm", "description": "", "p": "mathlib"}, {"name": "geom_sum_zero", "description": "", "p": "mathlib"}, {"name": "geom_sum_succ'", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.admissible_E'5", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.classification", "description": " A multiset `{p,q,r}` of positive natural numbers\nis a solution to `(p\u207b\u00b9 + q\u207b\u00b9 + r\u207b\u00b9 : \u211a) > 1` if and only if\nit is `admissible` which means it is one of:\n\n* `A' q r := {1,q,r}`\n* `D' r := {2,2,r}`\n* `E6 := {2,3,3}`, or `E7 := {2,3,4}`, or `E8 := {2,3,5}`", "p": "mathlib"}, {"name": "ADE_inequality.sum_inv", "description": " `sum_inv pqr` for a `pqr : multiset \u2115+` is the sum of the inverses\nof the elements of `pqr`, as rational number.\n\nThe intended argument is a multiset `{p,q,r}` of cardinality `3`.", "p": "mathlib"}, {"name": "ADE_inequality.E7", "description": " `E7 := {2,3,4}` is a `multiset \u2115+`\nthat is a solution to the inequality\n`(p\u207b\u00b9 + q\u207b\u00b9 + r\u207b\u00b9 : \u211a) > 1`.\n\nThis solution is related to the Dynkin diagrams $E_7$.", "p": "mathlib"}, {"name": "ADE_inequality.lt_three", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.admissible_of_one_lt_sum_inv_aux", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.E6", "description": " `E6 := {2,3,3}` is a `multiset \u2115+`\nthat is a solution to the inequality\n`(p\u207b\u00b9 + q\u207b\u00b9 + r\u207b\u00b9 : \u211a) > 1`.\n\nThis solution is related to the Dynkin diagrams $E_6$.", "p": "mathlib"}, {"name": "ADE_inequality.sum_inv_pqr", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.admissible_D'", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.admissible_of_one_lt_sum_inv", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.admissible_E'4", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.D'", "description": " `D' r := {2,2,r}` is a `multiset \u2115+`\nthat is a solution to the inequality\n`(p\u207b\u00b9 + q\u207b\u00b9 + r\u207b\u00b9 : \u211a) > 1`.\n\nThese solutions are related to the Dynkin diagrams $D_{r+2}$.", "p": "mathlib"}, {"name": "ADE_inequality.admissible_of_one_lt_sum_inv_aux'", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.lt_six", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.admissible_E7", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.admissible_E6", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.admissible_E'3", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.A'", "description": " `A' q r := {1,q,r}` is a `multiset \u2115+`\nthat is a solution to the inequality\n`(p\u207b\u00b9 + q\u207b\u00b9 + r\u207b\u00b9 : \u211a) > 1`.", "p": "mathlib"}, {"name": "ADE_inequality.E'", "description": " `E' r := {2,3,r}` is a `multiset \u2115+`.\nFor `r \u2208 {3,4,5}` is a solution to the inequality\n`(p\u207b\u00b9 + q\u207b\u00b9 + r\u207b\u00b9 : \u211a) > 1`.\n\nThese solutions are related to the Dynkin diagrams $E_{r+3}$.", "p": "mathlib"}, {"name": "ADE_inequality.admissible_E8", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.admissible", "description": " A multiset `pqr` of positive natural numbers is `admissible`\nif it is equal to `A' q r`, or `D' r`, or one of `E6`, `E7`, or `E8`.", "p": "mathlib"}, {"name": "ADE_inequality.admissible.one_lt_sum_inv", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.A", "description": " `A r := {1,1,r}` is a `multiset \u2115+`\nthat is a solution to the inequality\n`(p\u207b\u00b9 + q\u207b\u00b9 + r\u207b\u00b9 : \u211a) > 1`.\n\nThese solutions are related to the Dynkin diagrams $A_r$.", "p": "mathlib"}, {"name": "ADE_inequality.admissible_A'", "description": "", "p": "mathlib"}, {"name": "ADE_inequality.E8", "description": " `E8 := {2,3,5}` is a `multiset \u2115+`\nthat is a solution to the inequality\n`(p\u207b\u00b9 + q\u207b\u00b9 + r\u207b\u00b9 : \u211a) > 1`.\n\nThis solution is related to the Dynkin diagrams $E_8$.", "p": "mathlib"}, {"name": "ADE_inequality.lt_four", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.inv.is_mul_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_haar_measure", "description": " A measure on a group is a Haar measure if it is left-invariant, and gives finite mass to compact\nsets and positive mass to open sets.", "p": "mathlib"}, {"name": "measure_theory.measure.is_haar_measure.to_is_finite_measure_on_compacts", "description": " A measure on a group is a Haar measure if it is left-invariant, and gives finite mass to compact\nsets and positive mass to open sets.", "p": "mathlib"}, {"name": "measure_theory.measure.is_haar_measure.to_is_mul_left_invariant", "description": " A measure on a group is a Haar measure if it is left-invariant, and gives finite mass to compact\nsets and positive mass to open sets.", "p": "mathlib"}, {"name": "measure_theory.measure.is_haar_measure.to_is_open_pos_measure", "description": " A measure on a group is a Haar measure if it is left-invariant, and gives finite mass to compact\nsets and positive mass to open sets.", "p": "mathlib"}, {"name": "measure_theory.measure_preimage_add_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preimage_add", "description": "We shorten this from `measure_preimage_add_left`, since left invariant is the\npreferred option for measures in this formalization.", "p": "mathlib"}, {"name": "is_add_left_invariant.is_add_right_invariant", "description": "In an abelian additive\ngroup every left invariant measure is also right-invariant. We don't declare the converse as an\ninstance, since that would loop type-class inference, and we use `is_add_left_invariant` as the\ndefault hypothesis in abelian groups.", "p": "mathlib"}, {"name": "measure_theory.measure.prod.measure.is_add_right_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.map_inv_eq_self", "description": "", "p": "mathlib"}, {"name": "mul_equiv.is_haar_measure_map", "description": "A convenience wrapper for `measure_theory.measure.is_haar_measure_map`.", "p": "mathlib"}, {"name": "measure_theory.measure.inv_inv", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.measure_preimage_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.mul_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_lt_top_of_is_compact_of_is_mul_left_invariant'", "description": " If a left-invariant measure gives finite mass to a set with nonempty interior, then\nit gives finite mass to any compact set.", "p": "mathlib"}, {"name": "measure_theory.measure_preserving_add_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.map_mul_left_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_mul_right_invariant", "description": "A measure `\u03bc` on a measurable group is right invariant\n if the measure of right translations of a set are equal to the measure of the set itself.", "p": "mathlib"}, {"name": "measure_theory.measure.is_mul_right_invariant.map_mul_right_eq_self", "description": "A measure `\u03bc` on a measurable group is right invariant\n if the measure of right translations of a set are equal to the measure of the set itself.", "p": "mathlib"}, {"name": "measure_theory.measure.is_locally_finite_measure_of_is_haar_measure", "description": " Record that a Haar measure on a locally compact space is locally finite. This is needed as the\nfact that a measure which is finite on compacts is locally finite is not registered as an instance,\nto avoid an instance loop.\n\nSee Note [lower instance priority].", "p": "mathlib"}, {"name": "measure_theory.is_open_pos_measure_of_add_left_invariant_of_regular", "description": "A nonzero left-invariant regular measure gives positive mass to any open set.", "p": "mathlib"}, {"name": "measure_theory.map_sub_right_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.prod.measure.is_add_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.prod.is_haar_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.map_mul_right_inv_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.map_div_left_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.measure_preserving_inv", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.inv", "description": "The measure `A \u21a6 \u03bc (A\u207b\u00b9)`, where `A\u207b\u00b9` is the pointwise inverse of `A`.", "p": "mathlib"}, {"name": "measure_theory.is_open_pos_measure_of_add_left_invariant_of_compact", "description": "If a left-invariant measure gives positive mass to a compact set, then it gives\npositive mass to any open set.", "p": "mathlib"}, {"name": "measure_theory.measure.neg_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.null_iff_of_is_add_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.neg.is_add_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.eventually_mul_left_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.neg_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_haar_measure_map", "description": " The image of a Haar measure under a continuous surjective proper group homomorphism is again\na Haar measure. See also `mul_equiv.is_haar_measure_map`.", "p": "mathlib"}, {"name": "measure_theory.measure.map_sub_left_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.haar_singleton", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_haar_measure.smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_pos_iff_nonempty_of_is_add_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_right_invariant", "description": "A measure `\u03bc` on a measurable additive group is right invariant\n if the measure of right translations of a set are equal to the measure of the set itself.", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_right_invariant.map_add_right_eq_self", "description": "A measure `\u03bc` on a measurable additive group is right invariant\n if the measure of right translations of a set are equal to the measure of the set itself.", "p": "mathlib"}, {"name": "measure_theory.is_mul_left_invariant_smul_nnreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_mul_left_invariant_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.eventually_mul_right_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.map_div_left_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_mul_right_invariant_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_left_invariant", "description": "A measure `\u03bc` on a measurable additive group is left invariant\n if the measure of left translations of a set are equal to the measure of the set itself.", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_left_invariant.map_add_left_eq_self", "description": "A measure `\u03bc` on a measurable additive group is left invariant\n if the measure of left translations of a set are equal to the measure of the set itself.", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_haar_measure.smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.map_add_right_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.eventually_add_right_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_haar_measure.has_no_atoms", "description": " If the neutral element of a group is not isolated, then a Haar measure on this group has\nno atoms.\n\nThe additive version of this instance applies in particular to show that an additive Haar measure on\na nontrivial finite-dimensional real vector space has no atom.", "p": "mathlib"}, {"name": "measure_theory.measure_ne_zero_iff_nonempty_of_is_mul_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.add_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.regular.neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_mul_right_invariant.to_smul_invariant_measure_op", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_ne_zero_iff_nonempty_of_is_add_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.inv.measure_theory.sigma_finite", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preimage_mul_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_lt_top_of_is_compact_of_is_add_left_invariant'", "description": "If a left-invariant measure gives finite mass to a set with nonempty interior, then\nit gives finite mass to any compact set.", "p": "mathlib"}, {"name": "measure_theory.measure.map_add_right_neg_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.prod.is_add_haar_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.regular_inv_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.eventually_sub_right_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.inv.is_mul_right_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.subgroup.vadd_invariant_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_mul_right_invariant.to_vadd_invariant_measure_op", "description": "", "p": "mathlib"}, {"name": "measure_theory.eventually_div_right_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_lt_top_of_is_compact_of_is_mul_left_invariant", "description": " If a left-invariant measure gives finite mass to a nonempty open set, then it gives finite mass\nto any compact set.", "p": "mathlib"}, {"name": "measure_theory.map_mul_left_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_add_right_invariant_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_mul_left_invariant.smul_invariant_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.inv_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_haar_measure_of_is_compact_nonempty_interior", "description": " If a left-invariant measure gives positive mass to some compact set with nonempty interior, then\nit is a Haar measure.", "p": "mathlib"}, {"name": "measure_theory.forall_measure_preimage_add_iff", "description": "An alternative way to prove that `\u03bc` is left invariant under addition.", "p": "mathlib"}, {"name": "measure_theory.measure.measure_preserving_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.inv_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving_mul_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_haar_measure_map", "description": "The image of an additive Haar measure under a continuous surjective proper additive\ngroup homomorphism is again an additive Haar measure. See also\n`add_equiv.is_add_haar_measure_map`.", "p": "mathlib"}, {"name": "measure_theory.is_add_left_invariant_smul_nnreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_add_right_invariant_smul_nnreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.regular.inv", "description": "", "p": "mathlib"}, {"name": "measure_theory.forall_measure_preimage_mul_right_iff", "description": "An alternative way to prove that `\u03bc` is right invariant under multiplication.", "p": "mathlib"}, {"name": "measure_theory.measure.measure_preserving_mul_right_inv", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_haar_measure_of_is_compact_nonempty_interior", "description": "If a left-invariant measure gives positive mass to some compact set with nonempty\ninterior, then it is an additive Haar measure.", "p": "mathlib"}, {"name": "measure_theory.measure.prod.measure.is_mul_right_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_haar_measure.has_no_atoms", "description": "If the zero element of an additive group is not isolated, then an\nadditive Haar measure on this group has no atoms.\n\nThis applies in particular to show that an additive Haar measure on a nontrivial finite-dimensional\nreal vector space has no atom.", "p": "mathlib"}, {"name": "measure_theory.measure.is_mul_left_invariant", "description": "A measure `\u03bc` on a measurable group is left invariant\n if the measure of left translations of a set are equal to the measure of the set itself.", "p": "mathlib"}, {"name": "measure_theory.measure.is_mul_left_invariant.map_mul_left_eq_self", "description": "A measure `\u03bc` on a measurable group is left invariant\n if the measure of left translations of a set are equal to the measure of the set itself.", "p": "mathlib"}, {"name": "add_equiv.is_add_haar_measure_map", "description": "A convenience wrapper for `measure_theory.measure.is_add_haar_measure_map`.", "p": "mathlib"}, {"name": "measure_theory.measure.neg.measure_theory.sigma_finite", "description": "", "p": "mathlib"}, {"name": "measure_theory.eventually_add_left_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.map_sub_right_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_add_left_invariant_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_neg_invariant", "description": " A measure is invariant under negation if `- \u03bc = \u03bc`. Equivalently, this means that for all\nmeasurable `A` we have `\u03bc (- A) = \u03bc A`, where `- A` is the pointwise negation of `A`.", "p": "mathlib"}, {"name": "measure_theory.measure.is_neg_invariant.neg_eq_self", "description": " A measure is invariant under negation if `- \u03bc = \u03bc`. Equivalently, this means that for all\nmeasurable `A` we have `\u03bc (- A) = \u03bc A`, where `- A` is the pointwise negation of `A`.", "p": "mathlib"}, {"name": "measure_theory.measure.measure_preimage_inv", "description": "", "p": "mathlib"}, {"name": "measure_theory.regular_neg_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.add_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_mul_left_invariant.vadd_invariant_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving_add_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.mul_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.subgroup.smul_invariant_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_pos_iff_nonempty_of_is_mul_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.map_add_left_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_mul_right_invariant_smul_nnreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.map_add_left_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_haar_measure.sigma_finite", "description": " A Haar measure on a \u03c3-compact space is \u03c3-finite.\n\nSee Note [lower instance priority]", "p": "mathlib"}, {"name": "measure_theory.measure_preserving_mul_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_lt_top_of_is_compact_of_is_add_left_invariant", "description": "If a left-invariant measure gives finite mass to a nonempty open set, then it gives\nfinite mass to any compact set.", "p": "mathlib"}, {"name": "measure_theory.measure_preserving_div_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.neg", "description": "The measure `A \u21a6 \u03bc (- A)`, where `- A` is the pointwise negation of `A`.", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_haar_measure", "description": " A measure on an additive group is an additive Haar measure if it is left-invariant, and gives\nfinite mass to compact sets and positive mass to open sets.", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_haar_measure.to_is_finite_measure_on_compacts", "description": " A measure on an additive group is an additive Haar measure if it is left-invariant, and gives\nfinite mass to compact sets and positive mass to open sets.", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_haar_measure.to_is_add_left_invariant", "description": " A measure on an additive group is an additive Haar measure if it is left-invariant, and gives\nfinite mass to compact sets and positive mass to open sets.", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_haar_measure.to_is_open_pos_measure", "description": " A measure on an additive group is an additive Haar measure if it is left-invariant, and gives\nfinite mass to compact sets and positive mass to open sets.", "p": "mathlib"}, {"name": "measure_theory.measure.neg.is_add_right_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.measure_preserving_sub_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.forall_measure_preimage_mul_iff", "description": "An alternative way to prove that `\u03bc` is left invariant under multiplication.", "p": "mathlib"}, {"name": "measure_theory.measure_univ_of_is_mul_left_invariant", "description": " In a noncompact locally compact group, a left-invariant measure which is positive\non open sets has infinite mass.", "p": "mathlib"}, {"name": "measure_theory.measure.neg_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.map_neg_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.measure_inv", "description": "", "p": "mathlib"}, {"name": "measure_theory.null_iff_of_is_mul_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.forall_measure_preimage_add_right_iff", "description": "An alternative way to prove that `\u03bc` is right invariant under addition.", "p": "mathlib"}, {"name": "measure_theory.measure.add_haar_singleton", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_open_pos_measure_of_mul_left_invariant_of_regular", "description": "A nonzero left-invariant regular measure gives positive mass to any open set.", "p": "mathlib"}, {"name": "measure_theory.measure.is_inv_invariant", "description": " A measure is invariant under inversion if `\u03bc\u207b\u00b9 = \u03bc`. Equivalently, this means that for all\nmeasurable `A` we have `\u03bc (A\u207b\u00b9) = \u03bc A`, where `A\u207b\u00b9` is the pointwise inverse of `A`.", "p": "mathlib"}, {"name": "measure_theory.measure.is_inv_invariant.inv_eq_self", "description": " A measure is invariant under inversion if `\u03bc\u207b\u00b9 = \u03bc`. Equivalently, this means that for all\nmeasurable `A` we have `\u03bc (A\u207b\u00b9) = \u03bc A`, where `A\u207b\u00b9` is the pointwise inverse of `A`.", "p": "mathlib"}, {"name": "measure_theory.is_mul_left_invariant.is_mul_right_invariant", "description": "In an abelian group every left invariant measure is also right-invariant.\n We don't declare the converse as an instance, since that would loop type-class inference, and\n we use `is_mul_left_invariant` as the default hypothesis in abelian groups.", "p": "mathlib"}, {"name": "measure_theory.map_mul_right_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.map_sub_left_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.map_div_right_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.map_mul_right_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_mul_left_invariant_map", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_add_left_invariant_map", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.prod.measure.is_mul_left_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_add_haar_measure.sigma_finite", "description": "A Haar measure on a \u03c3-compact space is \u03c3-finite.\n\nSee Note [lower instance priority]", "p": "mathlib"}, {"name": "measure_theory.measure.measure_preserving_add_right_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_univ_of_is_add_left_invariant", "description": "In a noncompact locally compact additive group, a left-invariant measure which\nis positive on open sets has infinite mass.", "p": "mathlib"}, {"name": "measure_theory.is_open_pos_measure_of_mul_left_invariant_of_compact", "description": " If a left-invariant measure gives positive mass to a compact set, then it gives positive mass to\nany open set.", "p": "mathlib"}, {"name": "measure_theory.map_div_right_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving_sub_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.measure_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.is_locally_finite_measure_of_is_add_haar_measure", "description": "Record that an additive Haar measure on a locally compact space is\nlocally finite. This is needed as the fact that a measure which is finite on compacts is locally\nfinite is not registered as an instance, to avoid an instance loop.\n\nSee Note [lower instance priority]", "p": "mathlib"}, {"name": "measure_theory.map_add_right_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.measure_preserving_div_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preimage_mul", "description": "We shorten this from `measure_preimage_mul_left`, since left invariant is the preferred option\n for measures in this formalization.", "p": "mathlib"}, {"name": "linear_equiv.coe_to_continuous_linear_equiv_symm", "description": "", "p": "mathlib"}, {"name": "linear_equiv.coe_to_continuous_linear_equiv", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_to_continuous_linear_map", "description": "", "p": "mathlib"}, {"name": "linear_equiv.coe_to_continuous_linear_equiv_symm'", "description": "", "p": "mathlib"}, {"name": "continuous_equiv_fun_basis", "description": " In finite dimensions over a non-discrete complete normed field, the canonical identification\n(in terms of a basis) with `\ud835\udd5c^n` (endowed with the product topology) is continuous.\nThis is the key fact wich makes all linear maps from a T2 finite dimensional TVS over such a field\ncontinuous (see `linear_map.continuous_of_finite_dimensional`), which in turn implies that all\nnorms are equivalent in finite dimensions.", "p": "mathlib"}, {"name": "linear_equiv.can_lift_continuous_linear_equiv", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_to_continuous_linear_map", "description": "", "p": "mathlib"}, {"name": "basis.coe_constrL", "description": "", "p": "mathlib"}, {"name": "basis.constrL_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.det_to_continuous_linear_map", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.nonempty_continuous_linear_equiv_of_finrank_eq", "description": " Two finite-dimensional topological vector spaces over a complete normed field are continuously\nlinearly equivalent if they have the same (finite) dimension.", "p": "mathlib"}, {"name": "linear_map.continuous_of_finite_dimensional", "description": "Any linear map on a finite dimensional space over a complete field is continuous.", "p": "mathlib"}, {"name": "linear_map.to_continuous_linear_map", "description": "The continuous linear map induced by a linear map on a finite dimensional space", "p": "mathlib"}, {"name": "linear_map.is_open_map_of_finite_dimensional", "description": "A surjective linear map `f` with finite dimensional codomain is an open map.", "p": "mathlib"}, {"name": "unique_topology_of_t2", "description": " If `\ud835\udd5c` is a nontrivially normed field, any T2 topology on `\ud835\udd5c` which makes it a topological\nvector space over itself (with the norm topology) is *equal* to the norm topology.", "p": "mathlib"}, {"name": "continuous_linear_map.to_continuous_linear_equiv_of_det_ne_zero_apply", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.of_finrank_eq", "description": " A continuous linear equivalence between two finite-dimensional topological vector spaces over a\ncomplete normed field of the same (finite) dimension.", "p": "mathlib"}, {"name": "linear_map.range_to_continuous_linear_map", "description": "", "p": "mathlib"}, {"name": "linear_equiv.to_linear_equiv_to_continuous_linear_equiv_symm", "description": "", "p": "mathlib"}, {"name": "linear_equiv.to_linear_equiv_to_continuous_linear_equiv", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.nonempty_continuous_linear_equiv_iff_finrank_eq", "description": " Two finite-dimensional topological vector spaces over a complete normed field are continuously\nlinearly equivalent if and only if they have the same (finite) dimension.", "p": "mathlib"}, {"name": "basis.equiv_funL", "description": " The continuous linear equivalence between a vector space over `\ud835\udd5c` with a finite basis and\nfunctions from its basis indexing type to `\ud835\udd5c`.", "p": "mathlib"}, {"name": "linear_equiv.to_continuous_linear_equiv", "description": " The continuous linear equivalence induced by a linear equivalence on a finite dimensional\nspace.", "p": "mathlib"}, {"name": "linear_map.coe_to_continuous_linear_map'", "description": "", "p": "mathlib"}, {"name": "linear_map.continuous_of_nonzero_on_open", "description": "Over a nontrivially normed field, any linear form which is nonzero on a nonempty open set is\n   automatically continuous.", "p": "mathlib"}, {"name": "basis.constrL_basis", "description": "", "p": "mathlib"}, {"name": "basis.constrL", "description": "Construct a continuous linear map given the value at a finite basis.", "p": "mathlib"}, {"name": "continuous_linear_map.to_continuous_linear_equiv_of_det_ne_zero", "description": " Builds a continuous linear equivalence from a continuous linear map on a finite-dimensional\nvector space whose determinant is nonzero.", "p": "mathlib"}, {"name": "linear_equiv.coe_to_continuous_linear_equiv'", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.finite_dimensional", "description": "The space of continuous linear maps between finite-dimensional spaces is finite-dimensional.", "p": "mathlib"}, {"name": "linear_map.continuous_of_is_closed_ker", "description": "Any linear form on a topological vector space over a nontrivially normed field is continuous if\n   its kernel is closed.", "p": "mathlib"}, {"name": "linear_map.continuous_iff_is_closed_ker", "description": "Any linear form on a topological vector space over a nontrivially normed field is continuous if\n   and only if its kernel is closed.", "p": "mathlib"}, {"name": "linear_map.can_lift_continuous_linear_map", "description": "", "p": "mathlib"}, {"name": "linear_map.continuous_linear_map_class_of_finite_dimensional", "description": "", "p": "mathlib"}, {"name": "matrix.to_lin_fin_two_prod_to_continuous_linear_map", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.coe_to_continuous_linear_equiv_of_det_ne_zero", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_to_continuous_linear_map_symm", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem", "description": "An element `p` is said to be idempotent if `p * p = p`", "p": "mathlib"}, {"name": "is_idempotent_elem.one_sub", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.iff_eq_one", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.zero_compl", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.subtype.has_compl", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.of_is_idempotent", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.pow", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.one_sub_iff", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.eq", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.iff_eq_zero_or_one", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.coe_zero", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.subtype.has_zero", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.mul_of_commute", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.compl_compl", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.coe_compl", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.zero", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.coe_one", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.pow_succ_eq", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.subtype.has_one", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.one", "description": "", "p": "mathlib"}, {"name": "is_idempotent_elem.one_compl", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.exists_prime_spectrum_prod_le_and_ne_bot_of_domain", "description": "In a noetherian integral domain which is not a field, every non-zero ideal contains a non-zero\n  product of prime ideals; in a field, the whole ring is a non-zero ideal containing only 0 as\n  product or prime ideals ([samuel, \u00a7 3.3, Lemma 3])", "p": "mathlib"}, {"name": "prime_spectrum.exists_prime_spectrum_prod_le", "description": "In a noetherian ring, every ideal contains a product of prime ideals\n([samuel, \u00a7 3.3, Lemma 3])", "p": "mathlib"}, {"name": "prime_spectrum.topological_space.noetherian_space", "description": "", "p": "mathlib"}, {"name": "mul_zpow_neg_one", "description": "", "p": "mathlib"}, {"name": "commute.mul_zpow", "description": "", "p": "mathlib"}, {"name": "commute.zpow_zpow", "description": "", "p": "mathlib"}, {"name": "zsmul_sub", "description": "", "p": "mathlib"}, {"name": "has_dvd.dvd.pow", "description": "**Alias** of `dvd_pow`.", "p": "mathlib"}, {"name": "dvd_pow", "description": "", "p": "mathlib"}, {"name": "one_pow", "description": "", "p": "mathlib"}, {"name": "zsmul_neg'", "description": "", "p": "mathlib"}, {"name": "bit1_nsmul'", "description": "", "p": "mathlib"}, {"name": "bit0_nsmul'", "description": "", "p": "mathlib"}, {"name": "zpow_two", "description": "", "p": "mathlib"}, {"name": "commute.zpow_left", "description": "", "p": "mathlib"}, {"name": "zpow_neg_one", "description": "", "p": "mathlib"}, {"name": "pow_mul'", "description": "", "p": "mathlib"}, {"name": "nsmul_add", "description": "", "p": "mathlib"}, {"name": "nsmul_add_comm", "description": "", "p": "mathlib"}, {"name": "zsmul_add", "description": "", "p": "mathlib"}, {"name": "of_add_zsmul", "description": "", "p": "mathlib"}, {"name": "pow_bit0'", "description": "", "p": "mathlib"}, {"name": "nsmul_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "zpow_group_hom_apply", "description": "", "p": "mathlib"}, {"name": "neg_zsmul", "description": "", "p": "mathlib"}, {"name": "pow_ite", "description": "", "p": "mathlib"}, {"name": "pow_two", "description": "Note that most of the lemmas about powers of two refer to it as `sq`.", "p": "mathlib"}, {"name": "add_commute.zsmul_right", "description": "", "p": "mathlib"}, {"name": "of_add_nsmul", "description": "", "p": "mathlib"}, {"name": "two_nsmul", "description": "", "p": "mathlib"}, {"name": "pow_three", "description": "", "p": "mathlib"}, {"name": "bit0_nsmul", "description": "", "p": "mathlib"}, {"name": "dvd_pow_self", "description": "", "p": "mathlib"}, {"name": "nsmul_zero_sub", "description": "", "p": "mathlib"}, {"name": "pow_mul_comm", "description": "", "p": "mathlib"}, {"name": "zsmul_zero", "description": "", "p": "mathlib"}, {"name": "bit1_nsmul", "description": "", "p": "mathlib"}, {"name": "pow_eq_pow_mod", "description": "If `x ^ n = 1`, then `x ^ m` is the same as `x ^ (m % n)`", "p": "mathlib"}, {"name": "zpow_group_hom", "description": " The `n`-th power map (for an integer `n`) on a commutative group, considered as a group\nhomomorphism.", "p": "mathlib"}, {"name": "sub_nsmul", "description": "", "p": "mathlib"}, {"name": "commute.zpow_self", "description": "", "p": "mathlib"}, {"name": "zsmul_neg", "description": "", "p": "mathlib"}, {"name": "pow_add", "description": "", "p": "mathlib"}, {"name": "pow_three'", "description": "", "p": "mathlib"}, {"name": "add_semiconj_by.zsmul_right", "description": "", "p": "mathlib"}, {"name": "nsmul_add_nsmul_eq_zero", "description": "", "p": "mathlib"}, {"name": "zsmul_neg_coe_of_pos", "des