, {"name": "div_add_div_same", "description": "", "p": "mathlib"}, {"name": "neg_div_neg_eq", "description": "", "p": "mathlib"}, {"name": "neg_div", "description": "", "p": "mathlib"}, {"name": "one_div_mul_add_mul_one_div_eq_one_div_add_one_div", "description": "", "p": "mathlib"}, {"name": "div_neg_eq_neg_div", "description": "", "p": "mathlib"}, {"name": "div_sub_div_same", "description": "", "p": "mathlib"}, {"name": "one_div_add_one_div", "description": "", "p": "mathlib"}, {"name": "to_lex_rat_cast", "description": "", "p": "mathlib"}, {"name": "ring_hom.injective", "description": "", "p": "mathlib"}, {"name": "one_sub_div", "description": "", "p": "mathlib"}, {"name": "neg_div'", "description": "", "p": "mathlib"}, {"name": "div_add_div", "description": "", "p": "mathlib"}, {"name": "inv_add_inv", "description": "", "p": "mathlib"}, {"name": "same_sub_div", "description": "", "p": "mathlib"}, {"name": "div_sub_one", "description": "", "p": "mathlib"}, {"name": "order_dual.semifield", "description": "", "p": "mathlib"}, {"name": "add_div'", "description": "", "p": "mathlib"}, {"name": "is_smul_regular.pi", "description": "", "p": "mathlib"}, {"name": "pi.smul_with_zero'", "description": "", "p": "mathlib"}, {"name": "pi.mul_action_with_zero'", "description": "", "p": "mathlib"}, {"name": "pi.mul_action_with_zero", "description": "", "p": "mathlib"}, {"name": "function.module", "description": " A special case of `pi.module` for non-dependent types. Lean struggles to elaborate\ndefinitions elsewhere in the library without this.", "p": "mathlib"}, {"name": "pi.smul_with_zero", "description": "", "p": "mathlib"}, {"name": "pi.module", "description": "", "p": "mathlib"}, {"name": "function.no_zero_smul_divisors", "description": " A special case of `pi.no_zero_smul_divisors` for non-dependent types. Lean struggles to\nsynthesize this instance by itself elsewhere in the library.", "p": "mathlib"}, {"name": "pi.module'", "description": "", "p": "mathlib"}, {"name": "pi.no_zero_smul_divisors", "description": "", "p": "mathlib"}, {"name": "interactive.types.ident_", "description": "Parse an identifier or a '_'", "p": "core"}, {"name": "interactive.with_desc.reflectable", "description": "", "p": "core"}, {"name": "interactive.types.opt_pexpr_list", "description": "", "p": "core"}, {"name": "interactive.types.only_flag", "description": "", "p": "core"}, {"name": "interactive.types.with_ident_list", "description": "", "p": "core"}, {"name": "interactive.types.pexpr_list", "description": "", "p": "core"}, {"name": "interactive.loc.try_apply", "description": "", "p": "core"}, {"name": "interactive.noncomputable_modifier", "description": "", "p": "core"}, {"name": "interactive.noncomputable_modifier.computable", "description": "", "p": "core"}, {"name": "interactive.noncomputable_modifier.noncomputable", "description": "", "p": "core"}, {"name": "interactive.noncomputable_modifier.force_noncomputable", "description": "", "p": "core"}, {"name": "interactive.with_desc", "description": "Use `desc` as the interactive description of `p`.", "p": "core"}, {"name": "interactive.types.tac_rbp", "description": "The right-binding power 2 will terminate expressions by\n   '<|>' (rbp 2), ';' (rbp 1), and ',' (rbp 0). It should be used for any (potentially)\n   trailing expression parameters.", "p": "core"}, {"name": "interactive.types.without_ident_list", "description": "", "p": "core"}, {"name": "interactive.loc", "description": "A `loc` is either a 'wildcard', which means \"everywhere\", or a list of `option name`s. `none` means `target` and `some n` means `n` in the local context.", "p": "core"}, {"name": "interactive.loc.wildcard", "description": "A `loc` is either a 'wildcard', which means \"everywhere\", or a list of `option name`s. `none` means `target` and `some n` means `n` in the local context.", "p": "core"}, {"name": "interactive.loc.ns", "description": "A `loc` is either a 'wildcard', which means \"everywhere\", or a list of `option na