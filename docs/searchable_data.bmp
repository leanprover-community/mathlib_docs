_hom.parent_projection", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.add_comm_group_instance", "description": "", "p": "mathlib"}, {"name": "Group.forget_reflects_isos", "description": "", "p": "mathlib"}, {"name": "CommGroup.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "CommGroup.Group.has_coe", "description": "", "p": "mathlib"}, {"name": "Group.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "AddGroup.forget_reflects_isos", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.CommMon.has_coe", "description": "", "p": "mathlib"}, {"name": "add_equiv_iso_AddGroup_iso", "description": "additive equivalences between `add_group`s are the same\nas (isomorphic to) isomorphisms in `AddGroup`", "p": "mathlib"}, {"name": "CommGroup.coe_of", "description": "", "p": "mathlib"}, {"name": "AddGroup.of_hom", "description": "Typecheck a `add_monoid_hom` as a morphism in `AddGroup`.", "p": "mathlib"}, {"name": "Group.ext", "description": "", "p": "mathlib"}, {"name": "add_equiv_iso_AddCommGroup_iso", "description": "additive equivalences between `add_comm_group`s are\nthe same as (isomorphic to) isomorphisms in `AddCommGroup`", "p": "mathlib"}, {"name": "AddGroup.zero_apply", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.injective_of_mono", "description": "", "p": "mathlib"}, {"name": "mul_equiv.to_CommGroup_iso", "description": "Build an isomorphism in the category `CommGroup` from a `mul_equiv` between `comm_group`s.", "p": "mathlib"}, {"name": "CommGroup.has_forget_to_CommMon", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.as_hom_injective", "description": "", "p": "mathlib"}, {"name": "add_equiv.to_AddCommGroup_iso", "description": " Build an isomorphism in the category `AddCommGroup` from a `add_equiv` between\n`add_comm_group`s.", "p": "mathlib"}, {"name": "mul_equiv_iso_CommGroup_iso", "description": " multiplicative equivalences between `comm_group`s are the same as (isomorphic to) isomorphisms\nin `CommGroup`", "p": "mathlib"}, {"name": "mul_equiv.to_CommGroup_iso_inv", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.large_category", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.concrete_category", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.CommGroup_iso_to_mul_equiv_apply", "description": "", "p": "mathlib"}, {"name": "AddGroup.Mon.has_coe", "description": "", "p": "mathlib"}, {"name": "add_equiv.to_AddGroup_iso_neg", "description": "", "p": "mathlib"}, {"name": "CommGroup.forget_reflects_isos", "description": "", "p": "mathlib"}, {"name": "Group.of", "description": "Construct a bundled `Group` from the underlying type and typeclass.", "p": "mathlib"}, {"name": "AddCommGroup.inhabited", "description": "", "p": "mathlib"}, {"name": "AddGroup.ext", "description": "", "p": "mathlib"}, {"name": "Group.of_unique", "description": "", "p": "mathlib"}, {"name": "Group.inhabited", "description": "", "p": "mathlib"}, {"name": "CommGroup.comm_group.to_group.category_theory.bundled_hom.parent_projection", "description": "", "p": "mathlib"}, {"name": "Ab", "description": "`Ab` is an abbreviation for `AddCommGroup`, for the sake of mathematicians' sanity.", "p": "mathlib"}, {"name": "Group.large_category", "description": "", "p": "mathlib"}, {"name": "category_theory.Aut.iso_perm", "description": " The (bundled) group of automorphisms of a type is isomorphic to the (bundled) group\nof permutations.", "p": "mathlib"}, {"name": "AddCommGroup.of_hom", "description": "Typecheck a `add_monoid_hom` as a morphism in `AddCommGroup`.", "p": "mathlib"}, {"name": "mul_equiv.to_Group_iso_hom", "description": "", "p": "mathlib"}, {"name": "Group.concrete_category", "description": "", "p": "mathlib"}, {"name": "mul_equiv.to_Group_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.AddGroup_iso_to_add_equiv", "description": "Build an `add_equiv` from an isomorphism in the category\n`AddGroup`.", "p": "mathlib"}, {"name": "CommGroup.of", "description": "Construct a bundled `CommGroup` from the underlying type and typeclass.", "p": "mathlib"}, {"name": "CommGroup.concrete_category", "description": "", "p": "mathlib"}, {"name": "CommGroup.inhabited", "description": "", "p": "mathlib"}, {"name": "AddGroup.coe_of", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.int_hom_ext", "description": "", "p": "mathlib"}, {"name": "AddGroup.has_forget_to_AddMon", "description": "", "p": "mathlib"}, {"name": "CommGroup.of_unique", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.as_hom_apply", "description": "", "p": "mathlib"}, {"name": "Group.coe_of", "description": "", "p": "mathlib"}, {"name": "Group.one_apply", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.of_unique", "description": "", "p": "mathlib"}, {"name": "CommGroup", "description": "The category of commutative groups and group morphisms.", "p": "mathlib"}, {"name": "add_equiv.to_AddCommGroup_iso_hom", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.has_forget_to_AddCommMon", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.AddGroup_iso_to_add_equiv_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.Group_iso_to_mul_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "Group.Mon.has_coe", "description": "", "p": "mathlib"}, {"name": "Group", "description": "The category of groups and group morphisms.", "p": "mathlib"}, {"name": "AddCommGroup.Group.has_coe", "description": "", "p": "mathlib"}, {"name": "CommGroup.of_hom_apply", "description": "", "p": "mathlib"}, {"name": "Group.of_hom", "description": "Typecheck a `monoid_hom` as a morphism in `Group`.", "p": "mathlib"}, {"name": "dfinsupp.lt_of_forall_lt_of_lt", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex.covariant_class_lt_right", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex.covariant_class_le_right", "description": "", "p": "mathlib"}, {"name": "dfinsupp.to_lex_monotone", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex.partial_order", "description": " The partial order on `dfinsupp`s obtained by the lexicographic ordering.\nSee `dfinsupp.lex.linear_order` for a proof that this partial order is in fact linear.", "p": "mathlib"}, {"name": "dfinsupp.lex_def", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex.covariant_class_lt_left", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex", "description": " `dfinsupp.lex r s` is the lexicographic relation on `\u03a0\u2080 i, \u03b1 i`, where `\u03b9` is ordered by `r`,\nand `\u03b1 i` is ordered by `s i`.\nThe type synonym `lex (\u03a0\u2080 i, \u03b1 i)` has an order given by `dfinsupp.lex (<) (\u03bb i, (<))`.", "p": "mathlib"}, {"name": "dfinsupp.lex.covariant_class_le_left", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex_lt_of_lt", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex.decidable_lt", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex.linear_order", "description": "The linear order on `dfinsupp`s obtained by the lexicographic ordering.", "p": "mathlib"}, {"name": "dfinsupp.lex_lt_of_lt_of_preorder", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex.has_lt", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex.decidable_le", "description": "", "p": "mathlib"}, {"name": "pi.lex_eq_dfinsupp_lex", "description": "", "p": "mathlib"}, {"name": "dfinsupp.lex.is_strict_order", "description": "", "p": "mathlib"}, {"name": "pos_num.nat_size_pos", "description": "", "p": "mathlib"}, {"name": "pos_num.lt_to_nat", "description": "", "p": "mathlib"}, {"name": "znum.zneg_bit1", "description": "", "p": "mathlib"}, {"name": "num.transfer", "description": "This tactic tries to prove (in)equalities about `num`s by transfering them to the `nat` world and\nthen trying to call `simp`.\n```lean\nexample (n : num) (m : num) : n \u2264 n + m := by num.transfer\n```", "p": "mathlib"}, {"name": "pos_num.divmod_