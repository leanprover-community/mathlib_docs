: "mathlib"}, {"name": "add_monoid_hom_class.lipschitz_of_bound", "description": "A homomorphism `f` of seminormed groups is Lipschitz, if there exists a constant `C`\nsuch that for all `x`, one has `\u2016f x\u2016 \u2264 C * \u2016x\u2016`. The analogous condition for a linear map of\n(semi)normed spaces is in `normed_space.operator_norm`.", "p": "mathlib"}, {"name": "prod.normed_group", "description": "Product of normed groups, using the sup norm.", "p": "mathlib"}, {"name": "multiplicative.normed_comm_group", "description": "", "p": "mathlib"}, {"name": "norm_sub_norm_le'", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom_class.continuous_of_bound", "description": "A homomorphism `f` of seminormed groups is continuous, if there exists a constant `C`\nsuch that for all `x`, one has `\u2016f x\u2016 \u2264 C * \u2016x\u2016`", "p": "mathlib"}, {"name": "tendsto_norm_nhds_within_one", "description": "", "p": "mathlib"}, {"name": "coe_norm_add_group_seminorm", "description": "", "p": "mathlib"}, {"name": "edist_eq_coe_nnnorm", "description": "", "p": "mathlib"}, {"name": "nndist_eq_nnnorm_div", "description": "", "p": "mathlib"}, {"name": "seminormed_add_group.induced", "description": "A group homomorphism from an `add_group` to a `seminormed_add_group` induces a\n`seminormed_add_group` structure on the domain.", "p": "mathlib"}, {"name": "add_monoid_hom_class.isometry_of_norm", "description": "**Alias** of the reverse direction of `monoid_hom_class.isometry_iff_norm`.", "p": "mathlib"}, {"name": "additive.normed_add_group", "description": "", "p": "mathlib"}, {"name": "has_norm", "description": " Auxiliary class, endowing a type `E` with a function `norm : E \u2192 \u211d` with notation `\u2016x\u2016`. This\nclass is designed to be extended in more interesting classes specifying the properties of the norm.", "p": "mathlib"}, {"name": "has_norm.norm", "description": " Auxiliary class, endowing a type `E` with a function `norm : E \u2192 \u211d` with notation `\u2016x\u2016`. This\nclass is designed to be extended in more interesting classes specifying the properties of the norm.", "p": "mathlib"}, {"name": "lipschitz_with.add", "description": "", "p": "mathlib"}, {"name": "mem_sphere_one_iff_norm", "description": "", "p": "mathlib"}, {"name": "nnnorm_multiset_sum_le", "description": "", "p": "mathlib"}, {"name": "squeeze_zero_norm", "description": "Special case of the sandwich theorem: if the norm of `f` is bounded by a real\nfunction `a` which tends to `0`, then `f` tends to `0`.", "p": "mathlib"}, {"name": "pi.normed_group", "description": "Finite product of normed groups, using the sup norm.", "p": "mathlib"}, {"name": "norm_group_seminorm", "description": "The norm of a seminormed group as a group seminorm.", "p": "mathlib"}, {"name": "seminormed_group.of_mul_dist'", "description": "Construct a seminormed group from a multiplication-invariant pseudodistance.", "p": "mathlib"}, {"name": "norm_sum_le_of_le", "description": "", "p": "mathlib"}, {"name": "seminormed_add_comm_group.to_uniform_add_group", "description": "A seminormed group is a uniform additive group, i.e., addition and\nsubtraction are uniformly continuous.", "p": "mathlib"}, {"name": "cauchy_seq_sum_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "vadd_ball''", "description": "", "p": "mathlib"}, {"name": "norm_eq_zero", "description": "", "p": "mathlib"}, {"name": "ulift.nnnorm_def", "description": "", "p": "mathlib"}, {"name": "normed_add_group.to_seminormed_add_group", "description": "", "p": "mathlib"}, {"name": "norm_sub_le_of_le", "description": "", "p": "mathlib"}, {"name": "normed_add_comm_group.to_normed_add_group", "description": "", "p": "mathlib"}, {"name": "ball_zero_eq", "description": "", "p": "mathlib"}, {"name": "mem_ball_zero_iff", "description": "", "p": "mathlib"}, {"name": "normed_group.induced", "description": " An injective group homomorphism from a `group` to a `normed_group` induces a `normed_group`\nstructure on the domain.", "p": "mathlib"}, {"name": "squeeze_zero_norm'", "description": "Special case of the sandwich theorem: if the norm of `f` is eventually bounded by a\nreal function `a` which tends to `0`, then `f` tends to `1`. In this pair of lemmas\n(`squeeze_zero_norm'` and `squeeze_zero_norm`), following a convention of similar lemmas in\n`topology.metric_space.basic` and `topology.algebra.order`, the `'` version is phrased using\n\"eventually\" and the non-`'` version is phrased absolutely.", "p": "mathlib"}, {"name": "uniform_continuous_nnnorm'", "description": "", "p": "mathlib"}, {"name": "norm_div_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "prod.has_norm", "description": "", "p": "mathlib"}, {"name": "seminormed_group", "description": " A seminormed group is a group endowed with a norm for which `dist x y = \u2016x / y\u2016` defines a\npseudometric space structure.", "p": "mathlib"}, {"name": "seminormed_group.to_has_norm", "description": " A seminormed group is a group endowed with a norm for which `dist x y = \u2016x / y\u2016` defines a\npseudometric space structure.", "p": "mathlib"}, {"name": "seminormed_group.to_group", "description": " A seminormed group is a group endowed with a norm for which `dist x y = \u2016x / y\u2016` defines a\npseudometric space structure.", "p": "mathlib"}, {"name": "seminormed_group.to_pseudo_metric_space", "description": " A seminormed group is a group endowed with a norm for which `dist x y = \u2016x / y\u2016` defines a\npseudometric space structure.", "p": "mathlib"}, {"name": "seminormed_group.dist_eq", "description": " A seminormed group is a group endowed with a norm for which `dist x y = \u2016x / y\u2016` defines a\npseudometric space structure.", "p": "mathlib"}, {"name": "pi.sum_nnnorm_apply_le_nnnorm'", "description": "The $L^1$ norm is less than the $L^\\infty$ norm scaled by the cardinality.", "p": "mathlib"}, {"name": "lipschitz_with.inv", "description": "", "p": "mathlib"}, {"name": "nor