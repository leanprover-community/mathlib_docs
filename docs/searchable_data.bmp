cture.", "p": "mathlib"}, {"name": "set.fintype_insert_of_not_mem", "description": "A `fintype` structure on `insert a s` when inserting a new element.", "p": "mathlib"}, {"name": "set.finite.to_finset_subset", "description": "", "p": "mathlib"}, {"name": "set.finite.induction_on'", "description": "Analogous to `finset.induction_on'`.", "p": "mathlib"}, {"name": "set.finite.finite_subsets", "description": "There are finitely many subsets of a given finite set", "p": "mathlib"}, {"name": "set.infinite_or_finite", "description": "", "p": "mathlib"}, {"name": "set.finite_range_ite", "description": "", "p": "mathlib"}, {"name": "finite.set.finite_diff", "description": "", "p": "mathlib"}, {"name": "set.fintype_off_diag", "description": "", "p": "mathlib"}, {"name": "set.exists_max_image", "description": "", "p": "mathlib"}, {"name": "set.fintype_bind'", "description": "", "p": "mathlib"}, {"name": "set.finite.fin_param", "description": "", "p": "mathlib"}, {"name": "set.finite.to_finset_diff", "description": "", "p": "mathlib"}, {"name": "finset.finite_to_set", "description": " Gives a `set.finite` for the `finset` coerced to a `set`.\nThis is a wrapper around `set.to_finite`.", "p": "mathlib"}, {"name": "set.finite.induction_on", "description": "", "p": "mathlib"}, {"name": "set.infinite.prod_right", "description": "", "p": "mathlib"}, {"name": "set.infinite_of_inj_on_maps_to", "description": "", "p": "mathlib"}, {"name": "set.finite.exists_lt_map_eq_of_forall_mem", "description": "", "p": "mathlib"}, {"name": "set.finite.bUnion", "description": "", "p": "mathlib"}, {"name": "set.finite.subset_to_finset", "description": "", "p": "mathlib"}, {"name": "set.Inter_Union_of_monotone", "description": "An increasing intersection distributes over finite union.", "p": "mathlib"}, {"name": "set.not_infinite", "description": "", "p": "mathlib"}, {"name": "set.Inter_Union_of_antitone", "description": "A decreasing intersection distributes over finite union.", "p": "mathlib"}, {"name": "set.finite.bdd_above", "description": "A finite set is bounded above.", "p": "mathlib"}, {"name": "set.finite.to_finset_insert", "description": "", "p": "mathlib"}, {"name": "set.exists_finite_iff_finset", "description": "", "p": "mathlib"}, {"name": "set.finite.exists_maximal_wrt", "description": "", "p": "mathlib"}, {"name": "set.subsingleton.finite", "description": "", "p": "mathlib"}, {"name": "set.Union_pi_of_monotone", "description": "", "p": "mathlib"}, {"name": "set.finite_mem_finset", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_single", "description": "", "p": "mathlib"}, {"name": "finsupp.equiv_fun_on_finite_symm_apply_to_fun", "description": "", "p": "mathlib"}, {"name": "finsupp.erase_add", "description": "", "p": "mathlib"}, {"name": "finsupp.induction_linear", "description": "", "p": "mathlib"}, {"name": "finsupp.erase_add_hom_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.support_single_subset", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain_inj", "description": "", "p": "mathlib"}, {"name": "finsupp.ext", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain.add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.single_eq_update", "description": "", "p": "mathlib"}, {"name": "finsupp.congr_fun", "description": "Deprecated. Use `fun_like.congr_fun` instead.", "p": "mathlib"}, {"name": "finsupp.erase_of_not_mem_support", "description": "", "p": "mathlib"}, {"name": "finsupp.single_left_injective", "description": " `finsupp.single a b` is injective in `a`. For the statement that it is injective in `b`, see\n`finsupp.single_injective`", "p": "mathlib"}, {"name": "finsupp.apply_add_hom", "description": " Evaluation of a function `f : \u03b1 \u2192\u2080 M` at a point as an additive monoid homomorphism.\n\nSee `finsupp.lapply` in `linear_algebra/finsupp` for the stronger version as a linear map.", "p": "mathlib"}, {"name": "finsupp.of_support_finite_coe", "description": "", "p": "mathlib"}, {"name": "finsupp.single_apply_left", "description": "", "p": "mathlib"}, {"name": "finsupp.has_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.erase_eq_sub_single", "description": "", "p": "mathlib"}, {"name": "finsupp.single_left_inj", "description": "", "p": "mathlib"}, {"name": "finsupp.single_of_single_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.on_finset_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.support_map_range_of_injective", "description": "", "p": "mathlib"}, {"name": "finsupp.coe_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain_eq_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.update_self", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain.add_monoid_hom", "description": "Bundle `emb_domain f` as an additive map from `\u03b1 \u2192\u2080 M` to `\u03b2 \u2192\u2080 M`.", "p": "mathlib"}, {"name": "finsupp.zero_update", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_comp", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_sub", "description": "", "p": "mathlib"}, {"name": "finsupp.support_add", "description": "", "p": "mathlib"}, {"name": "finsupp.coe_fn_inj", "description": "Deprecated. Use `fun_like.coe_fn_eq` instead.", "p": "mathlib"}, {"name": "finsupp.card_support_eq_one'", "description": "", "p": "mathlib"}, {"name": "finsupp.support_update_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.single_apply_ne_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.erase_ne", "description": "", "p": "mathlib"}, {"name": "finsupp.single_of_emb_domain_single", "description": "", "p": "mathlib"}, {"name": "finsupp.equiv_fun_on_finite_symm_apply_support", "description": "", "p": "mathlib"}, {"name": "finsupp.has_nat_scalar", "description": " Note the general `finsupp.has_smul` instance doesn't apply as `\u2115` is not distributive\nunless `\u03b2 i`'s addition is commutative.", "p": "mathlib"}, {"name": "finsupp.single_add", "description": "", "p": "mathlib"}, {"name": "finsupp.support_single_ne_bot", "description": "", "p": "mathlib"}, {"name": "finsupp.support_single_disjoint", "description": "", "p": "mathlib"}, {"name": "finsupp.of_support_finite", "description": "The natural `finsupp` induced by the function `f` given that it has finite support.", "p": "mathlib"}, {"name": "finsupp.erase", "description": "`erase a f` is the finitely supported function equal to `f` except at `a` where it is equal to `0`.\nIf `a` is not in the support of `f` then `erase a f = f`.", "p": "mathlib"}, {"name": "finsupp.has_neg", "description": "", "p": "mathlib"}, {"name": "finsupp.has_sub", "description": "", "p": "mathlib"}, {"name": "finsupp.card_support_eq_one", "description": "", "p": "mathlib"}, {"name": "finsupp.card_support_le_one", "description": "", "p": "mathlib"}, {"name": "finsupp.equiv_fun_on_finite", "description": "Given `finite \u03b1`, `equiv_fun_on_finite` is the `equiv` between `\u03b1 \u2192\u2080 \u03b2` and `\u03b1 \u2192 \u03b2`.\n (All functions on a finite type are finitely supported.)", "p": "mathlib"}, {"name": "finsupp.mem_support_single", "description": "", "p": "mathlib"}, {"name": "finsupp.add_comm_group", "description": "", "p": "mathlib"}, {"name": "finsupp.mem_support_on_finset", "description": "", "p": "mathlib"}, {"name": "finsupp.support_eq_singleton'", "description": "", "p": "mathlib"}, {"name": "finsupp.single_eq_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.can_lift", "description": "", "p": "mathlib"}, {"name": "finsupp.not_mem_support_iff", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain_notin_range", "description": "", "p": "mathlib"}, {"name": "finsupp.induction\u2082", "description": "", "p": "mathlib"}, {"name": "finsupp.single_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_add'", "description": "", "p": "mathlib"}, {"name": "finsupp.apply_add_hom_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.has_coe_to_fun", "description": " Helper instance for when there are too many metavariables to apply `fun_like.has_coe_to_fun`\ndirectly.", "p": "mathlib"}, {"name": "finsupp.finite_support", "description": "", "p": "mathlib"}, {"name": "finsupp.update_eq_sub_add_single", "description": "", "p": "mathlib"}, {"name": "finsupp.equiv_fun_on_finite_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.support_eq_empty", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_neg", "description": "", "p": "mathlib"}, {"name": "finsupp.add_group", "description": "", "p": "mathlib"}, {"name": "finsupp.support_zip_with", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range", "description": " The composition of `f : M \u2192 N` and `g : \u03b1 \u2192\u2080 M` is `map_range f hf g : \u03b1 \u2192\u2080 N`,\nwhich is well-defined when `f 0 = 0`.\n\nThis preserves the structure on `f`, and exists in various bundled forms for when `f` is itself\nbundled (defined in `data/finsupp/basic`):\n\n* `finsupp.map_range.equiv`\n* `finsupp.map_range.zero_hom`\n* `finsupp.map_range.add_monoid_hom`\n* `finsupp.map_range.add_equiv`\n* `finsupp.map_range.linear_map`\n* `finsupp.map_range.linear_equiv`", "p": "mathlib"}, {"name": "finsupp.add_hom_ext", "description": " If two additive homomorphisms from `\u03b1 \u2192\u2080 M` are equal on each `single a b`,\nthen they are equal.", "p": "mathlib"}, {"name": "finsupp.single_eq_same", "description": "", "p": "mathlib"}, {"name": "finsupp.unique_single_eq_iff", "description": "", "p": "mathlib"}, {"name": "finsupp.update_eq_single_add_erase", "description": "", "p": "mathlib"}, {"name": "finsupp.single_add_hom", "description": " `finsupp.single` as an `add_monoid_hom`.\n\nSee `finsupp.lsingle` in `linear_algebra/finsupp` for the stronger version as a linear map.", "p": "mathlib"}, {"name": "finsupp.erase_add_hom", "description": "`finsupp.erase` as an `add_monoid_hom`.", "p": "mathlib"}, {"name": "finsupp.unique_single", "description": "", "p": "mathlib"}, {"name": "finsupp.single", "description": "`single a b` is the finitely supported function with value `b` at `a` and zero otherwise.", "p": "mathlib"}, {"name": "finsupp.support_erase", "description": "", "p": "mathlib"}, {"name": "finsupp.erase_add_single", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.coe_eq_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.single_injective", "description": " `finsupp.single a b` is injective in `b`. For the statement that it is injective in `a`, see\n`finsupp.single_left_injective`", "p": "mathlib"}, {"name": "finsupp.emb_domain_single", "description": "", "p": "mathlib"}, {"name": "finsupp.add_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.neg_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.ext_iff'", "description": "", "p": "mathlib"}, {"name": "finsupp.single_add_hom_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.zip_with_apply", "description": "", "p": "mathlib"}, {"name": "equiv.finsupp_unique_symm_apply_to_fun", "description": "", "p": "mathlib"}, {"name": "finsupp.add_hom_ext'", "description": " If two additive homomorphisms from `\u03b1 \u2192\u2080 M` are equal on each `single a b`,\nthen they are equal.\n\nWe formulate this using equality of `add_monoid_hom`s so that `ext` tactic can apply a type-specific\nextensionality lemma after this one.  E.g., if the fiber `M` is `\u2115` or `\u2124`, then it suffices to\nverify `f (single a 1) = g (single a 1)`.", "p": "mathlib"}, {"name": "finsupp.mul_hom_ext'", "description": "", "p": "mathlib"}, {"name": "finsupp", "description": "`finsupp \u03b1 M`, denoted `\u03b1 \u2192\u2080 M`, is the type of functions `f : \u03b1 \u2192 M` such that\n `f x = 0` for all but finitely many `x`.", "p": "mathlib"}, {"name": "finsupp.support", "description": "`finsupp \u03b1 M`, denoted `\u03b1 \u2192\u2080 M`, is the type of functions `f : \u03b1 \u2192 M` such that\n `f x = 0` for all but finitely many `x`.", "p": "mathlib"}, {"name": "finsupp.to_fun", "description": "`finsupp \u03b1 M`, denoted `\u03b1 \u2192\u2080 M`, is the type of functions `f : \u03b1 \u2192 M` such that\n `f x = 0` for all but finitely many `x`.", "p": "mathlib"}, {"name": "finsupp.mem_support_to_fun", "description": "`finsupp \u03b1 M`, denoted `\u03b1 \u2192\u2080 M`, is the type of functions `f : \u03b1 \u2192 M` such that\n `f x = 0` for all but finitely many `x`.", "p": "mathlib"}, {"name": "finsupp.erase_same", "description": "", "p": "mathlib"}, {"name": "finsupp.support_map_range", "description": "", "p": "mathlib"}, {"name": "finsupp.coe_update", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain_add", "description": "", "p": "mathlib"}, {"name": "finsupp.erase_single_ne", "description": "", "p": "mathlib"}, {"name": "finsupp.single_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.single_add_single_eq_single_add_single", "description": "", "p": "mathlib"}, {"name": "finsupp.support_subset_singleton'", "description": "", "p": "mathlib"}, {"name": "finsupp.fun_like", "description": "", "p": "mathlib"}, {"name": "finsupp.support_update_ne_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.mem_support_iff", "description": "", "p": "mathlib"}, {"name": "finsupp.support_neg", "description": "", "p": "mathlib"}, {"name": "finsupp.zero_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain", "description": " Given `f : \u03b1 \u21aa \u03b2` and `v : \u03b1 \u2192\u2080 M`, `emb_domain f v : \u03b2 \u2192\u2080 M`\nis the finitely supported function whose value at `f a : \u03b2` is `v a`.\nFor a `b : \u03b2` outside the range of `f`, it is zero.", "p": "mathlib"}, {"name": "finsupp.map_range_sub'", "description": "", "p": "mathlib"}, {"name": "finsupp.unique_ext", "description": "", "p": "mathlib"}, {"name": "finsupp.equiv_fun_on_finite_single", "description": "", "p": "mathlib"}, {"name": "finsupp.coe_fn_add_hom_apply", "description": "", "p": "mathlib"}, {"name": "equiv.finsupp_unique", "description": "If `\u03b1` has a unique term, the type of finitely supported functions `\u03b1 \u2192\u2080 \u03b2` is equivalent to `\u03b2`.", "p": "mathlib"}, {"name": "finsupp.support_on_finset", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_id", "description": "", "p": "mathlib"}, {"name": "finsupp.single_eq_single_iff", "description": "", "p": "mathlib"}, {"name": "finsupp.has_add", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_add", "description": "", "p": "mathlib"}, {"name": "finsupp.inhabited", "description": "", "p": "mathlib"}, {"name": "finsupp.support_on_finset_subset", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_neg'", "description": "", "p": "mathlib"}, {"name": "finsupp.single_swap", "description": "", "p": "mathlib"}, {"name": "finsupp.zip_with", "description": " Given finitely supported functions `g\u2081 : \u03b1 \u2192\u2080 M` and `g\u2082 : \u03b1 \u2192\u2080 N` and function `f : M \u2192 N \u2192 P`,\n`zip_with f hf g\u2081 g\u2082` is the finitely supported function `\u03b1 \u2192\u2080 P` satisfying\n`zip_with f hf g\u2081 g\u2082 a = f (g\u2081 a) (g\u2082 a)`, which is well-defined when `f 0 0 = 0`.", "p": "mathlib"}, {"name": "finsupp.support_emb_domain", "description": "", "p": "mathlib"}, {"name": "finsupp.update", "description": " Replace the value of a `\u03b1 \u2192\u2080 M` at a given point `a : \u03b1` by a given value `b : M`.\nIf `b = 0`, this amounts to removing `a` from the `finsupp.support`.\nOtherwise, if `a` was not in the `finsupp.support`, it is added to it.\n\nThis is the finitely-supported version of `function.update`.", "p": "mathlib"}, {"name": "finsupp.equiv_fun_on_finite_symm_single", "description": "", "p": "mathlib"}, {"name": "finsupp.add_closure_set_of_eq_single", "description": "", "p": "mathlib"}, {"name": "finsupp.erase_single", "description": "", "p": "mathlib"}, {"name": "finsupp.equiv_fun_on_finite_symm_coe", "description": "", "p": "mathlib"}, {"name": "finsupp.add_zero_class", "description": "", "p": "mathlib"}, {"name": "finsupp.ext_iff", "description": "Deprecated. Use `fun_like.ext_iff` instead.", "p": "mathlib"}, {"name": "finsupp.mul_hom_ext", "description": "", "p": "mathlib"}, {"name": "finsupp.erase_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.fun_support_eq", "description": "", "p": "mathlib"}, {"name": "finsupp.on_finset", "description": " `on_finset s f hf` is the finsupp function representing `f` restricted to the finset `s`.\nThe function must be `0` outside of `s`. Use this when the set needs to be filtered anyways,\notherwise a better set representation is often available.", "p": "mathlib"}, {"name": "finsupp.support_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.nonzero_iff_exists", "description": "", "p": "mathlib"}, {"name": "finsupp.eq_single_iff", "description": "", "p": "mathlib"}, {"name": "finsupp.support_sub", "description": "", "p": "mathlib"}, {"name": "finsupp.single_apply_eq_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.map_range_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.single_eq_set_indicator", "description": "", "p": "mathlib"}, {"name": "finsupp.coe_add", "description": "", "p": "mathlib"}, {"name": "finsupp.emb_domain_injective", "description": "", "p": "mathlib"}, {"name": "finsupp.support_single_ne_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.support_update", "description": "", "p": "mathlib"}, {"name": "finsupp.single_add_erase", "description": "", "p": "mathlib"}, {"name": "finsupp.card_support_eq_zero", "description": "", "p": "mathlib"}, {"name": "finsupp.single_apply_