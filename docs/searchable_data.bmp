}, {"name": "cardinal.bdd_above_iff_small", "description": "A set of cardinals is bounded above iff it's small, i.e. it corresponds to an usual ZFC set.", "p": "mathlib"}, {"name": "cardinal.is_limit", "description": "A cardinal is a limit if it is not zero or a successor cardinal. Note that `\u2135\u2080` is a limit\n cardinal by this definition, but `0` isn't.\n\n Use `is_succ_limit` if you want to include the `c = 0` case.", "p": "mathlib"}, {"name": "cardinal.to_part_enat_eq_iff_eq_of_le_aleph_0", "description": "", "p": "mathlib"}, {"name": "cardinal.mk", "description": "The cardinal number of a type", "p": "mathlib"}, {"name": "cardinal.out_mk_equiv", "description": "The representative of the cardinal of a type is equivalent ot the original type.", "p": "mathlib"}, {"name": "cardinal.le_mk_diff_add_mk", "description": "", "p": "mathlib"}, {"name": "cardinal.add_lt_aleph_0", "description": "", "p": "mathlib"}, {"name": "cardinal.is_limit_aleph_0", "description": "", "p": "mathlib"}, {"name": "cardinal.aleph_0_mul_aleph_0", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_out", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_le_mk_mul_of_mk_preimage_le", "description": "", "p": "mathlib"}, {"name": "cardinal.powerlt", "description": "The function `a ^< b`, defined as the supremum of `a ^ c` for `c < b`.", "p": "mathlib"}, {"name": "cardinal.induction_on\u2082", "description": "", "p": "mathlib"}, {"name": "cardinal.prod_const'", "description": "", "p": "mathlib"}, {"name": "cardinal.has_pow", "description": "The cardinal exponential. `#\u03b1 ^ #\u03b2` is the cardinal of `\u03b2 \u2192 \u03b1`.", "p": "mathlib"}, {"name": "cardinal.supr_of_empty", "description": "A variant of `csupr_of_empty` but with `0` on the RHS for convenience", "p": "mathlib"}, {"name": "cardinal.mk_subtype_le_of_subset", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_Union_le", "description": "", "p": "mathlib"}, {"name": "cardinal.mk_eq_one", "description":