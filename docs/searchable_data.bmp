scription": "", "p": "mathlib"}, {"name": "category_theory.limits.has_coequalizers_opposite", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.op_span_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_coproducts_of_shape_of_opposite", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_cone_unop_of_cocone_lift", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.pullback_iso_unop_pushout_inv_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.pullback_cone.op_\u03b9_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.op_cospan", "description": "The canonical isomorphism relating `(cospan f g).op` and `span f.op g.op`", "p": "mathlib"}, {"name": "category_theory.limits.pushout_cocone.op_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_finite_products_opposite", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_cone_of_cocone_unop_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_finite_coproducts_of_opposite", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.pullback_iso_unop_pushout_hom_inl_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_cocone_of_cone_left_op", "description": "Turn a limit of `F.left_op : J\u1d52\u1d56 \u2964 C` into a colimit of `F : J \u2964 C\u1d52\u1d56`.", "p": "mathlib"}, {"name": "category_theory.limits.pushout_cocone.op", "description": "The obvious map `pushout_cocone f.op g.op \u2192 pullback_cone f g`", "p": "mathlib"}, {"name": "category_theory.limits.pullback_cone.is_limit_equiv_is_colimit_unop", "description": " A pullback cone is a limit cone in `C\u1d52\u1d56` if and only if the corresponding pushout cocone\nin `C` is a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.has_colimit_of_has_limit_op", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.op_span_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_colimits_of_shape_op_of_has_limits_of_shape", "description": "If `C` has colimits of shape `J\u1d52\u1d56`, we can construct limits in `C\u1d52\u1d56` of shape `J`.", "p": "mathlib"}, {"name": "category_theory.limits.has_cofiltered_limits_of_has_filtered_colimits_op", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.pullback_iso_unop_pushout_hom_inr", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.pushout_cocone.unop_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.pullback_cone.op_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.pullback_cone.unop_\u03b9_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.pushout_iso_unop_pullback_inr_hom_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_finite_coproducts_opposite", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_coproducts_opposite", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_cone_right_op_of_cocone", "description": "Turn a colimit for `F : J\u1d52\u1d56 \u2964 C` into a limit for `F.right_op : J \u2964 C\u1d52\u1d56`.", "p": "mathlib"}, {"name": "category_theory.limits.pullback_iso_unop_pushout_inv_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_cone_of_cocone_unop", "description": "Turn a colimit for `F.unop : J \u2964 C` into a limit for `F : J\u1d52\u1d56 \u2964 C\u1d52\u1d56`.", "p": "mathlib"}, {"name": "gen_loop.homotopy_from_apply", "description": "", "p": "mathlib"}, {"name": "gen_loop.homotopic.setoid", "description": "", "p": "mathlib"}, {"name": "gen_loop_homeo_of_is_empty", "description": "The 0-dimensional generalized loops based at `x` are in bijection with `X`.", "p": "mathlib"}, {"name": "homotopy_group.group", "description": "Group structure on `homotopy_group N X x` for nonempty `N` (in particular `\u03c0_(n+1) X x`).", "p": "mathlib"}, {"name": "gen_loop.from_loop_apply", "description": "", "p": "mathlib"}, {"name": "homotopy_group.is_unital_aux_group", "description": "", "p": "mathlib"}, {"name": "homotopy_group", "description": "The `n`th homotopy group at `x` defined as the quotient of `\u03a9^n x` by the\n `gen_loop.homotopic` relation.", "p": "mathlib"}, {"name": "homotopy_group.aux_group", "description": "Group structure on `homotopy_group` obtained by pulling back path composition along the\n `i`th direction. The group structures for two different `i j : N` distribute over each\n other, and therefore are equal by the Eckmann-Hilton argument.", "p": "mathlib"}, {"name": "cube.boundary", "description": "The points in a cube with at least one projection equal to 0 or 1.", "p": "mathlib"}, {"name": "gen_loop.c_comp_insert", "description": "Composition with `cube.insert_at` as a continuous map.", "p": "mathlib"}, {"name": "gen_loop.homotopic_to", "description": "", "p": "mathlib"}, {"name": "homotopy_group.aux_group_indep", "description": "", "p": "mathlib"}, {"name": "gen_loop_equiv_of_unique_symm_apply_coe_apply", "description": "", "p": "mathlib"}, {"name": "homotopy_group_equiv_zeroth_homotopy_of_is_empty", "description": "The homotopy \"group\" indexed by an empty type is in bijection with\n the path components of `X`, aka the `zeroth_homotopy`.", "p": "mathlib"}, {"name": "gen_loop.from_loop", "description": "Generalized loop from a loop by uncurrying $I \u2192 (I^{N\\setminus\\{j\\}} \u2192 X)$ into $I^N \u2192 X$.", "p": "mathlib"}, {"name": "gen_loop.ext", "description": "", "p": "mathlib"}, {"name": "gen_loop.from_loop_coe", "description": "", "p": "mathlib"}, {"name": "homotopy_group.inhabited", "description": "", "p": "mathlib"}, {"name": "gen_loop.homotopy_from", "description": "The converse to `gen_loop.homotopy_to`: a homotopy between two loops in the space of\n `n`-dimensional loops can be seen as a homotopy between two `n+1`-dimensional paths.", "p": "mathlib"}, {"name": "gen_loop.loop_homeo", "description": "The `n+1`-dimensional loops are in bijection with the loops in the space of\n `n`-dimensional loops with base point `const`.\n We allow an arbitrary indexing type `N` in place of `fin n` here.", "p": "mathlib"}, {"name": "homotopy_group.pi", "description": "Homotopy group of finite index.", "p": "mathlib"}, {"name": "homotopy_group.one_def", "description": "Characterization of multiplicative identity", "p": "mathlib"}, {"name": "gen_loop.trans_at", "description": "Concatenation of two `gen_loop`s along the `i`th coordinate.", "p": "mathlib"}, {"name": "gen_loop.boundary", "description": "", "p": "mathlib"}, {"name": "gen_loop.to_loop", "description": "Loop from a generalized loop by currying $I^N \u2192 X$ into $I \u2192 (I^{N\\setminus\\{j\\}} \u2192 X)$.", "p": "mathlib"}, {"name": "gen_loop.const_apply", "description": "", "p": "mathlib"}, {"name": "homotopy_group.symm_at_indep", "description": "", "p": "mathlib"}, {"name": "homotopy_group.pi_0_equiv_zeroth_homotopy", "description": "The 0th homotopy \"group\" is in bijection with `zeroth_homotopy`.", "p": "mathlib"}, {"name": "gen_loop.homotopic_from", "description": "", "p": "mathlib"}, {"name": "cube.insert_at", "description": "The backward direction of the homeomorphism\n between the cube $I^N$ and $I \u00d7 I^{N\\setminus\\{j\\}}$.", "p": "mathlib"}, {"name": "gen_loop.homotopy_to_apply", "description": "", "p": "mathlib"}, {"name": "gen_loop.inhabited", "description": "", "p": "mathlib"}, {"name": "gen_loop.loop_homeo_symm_apply", "description": "", "p": "mathlib"}, {"name": "gen_loop.symm_at", "description": "Reversal of a `gen_loop` along the `i`th coordinate.", "p": "mathlib"}, {"name": "gen_loop.mk_apply", "description": "", "p": "mathlib"}, {"name": "gen_loop.trans_at_distrib", "description": "", "p": "mathlib"}, {"name": "cube.split_at", "description": "The forward direction of the homeomorphism\n between the cube $I^N$ and $I \u00d7 I^{N\\setminus\\{j\\}}$.", "p": "mathlib"}, {"name": "gen_loop.homotopic.symm", "description": "", "p": "mathlib"}, {"name": "gen_loop.homotopy_to", "description": "A homotopy between `n+1`-dimensional loops `p` and `q` constant on the boundary\n seen as a homotopy between two paths in the space of `n`-dimensional paths.", "p": "mathlib"}, {"name": "homotopy_group.pi_1_equiv_fundamental_group", "description": "The first homotopy group at `x` is in bijection with the fundamental group.", "p": "mathlib"}, {"name": "gen_loop", "description": "The `n`-dimensional generalized loops based at `x` in a space `X` are\n continuous functions `I^n \u2192 X` that sends the boundary to `x`.\n We allow an arbitrary indexing type `N` in place of `fin n` here.", "p": "mathlib"}, {"name": "gen_loop.to_loop_apply", "description": "", "p": "mathlib"}, {"name": "gen_loop.homotopic.equiv", "description": "", "p": "mathlib"}, {"name": "gen_loop.copy", "description": "Copy of a `gen_loop` with a new map from the unit cube equal to the old one.\n Useful to fix definitional equalities.", "p": "mathlib"}, {"name": "gen_loop.from_loop_trans_to_loop", "description": "", "p": "mathlib"}, {"name": "homotopy_group_equiv_fundamental_group_of_unique", "description": "The homotopy group at `x` indexed by a singleton is in bijection with the fundamental group,\n i.e. the loops based at `x` up to homotopy.", "p": "mathlib"}, {"name": "gen_loop.continuous_to_loop", "description": "", "p": "mathlib"}, {"name": "homotopy_group_equiv_fundamental_group", "description": "Equivalence between the homotopy group of X and the fundamental group of\n `\u03a9^{j // j \u2260 i} x`.", "p": "mathlib"}, {"name": "gen_loop.fun_like", "description": "", "p": "mathlib"}, {"name": "gen_loop.continuous_from_loop", "description": "", "p": "mathlib"}, {"name": "gen_loop.const", "description": "The constant `gen_loop` at `x`.", "p": "mathlib"}, {"name": "gen_loop_equiv_of_unique_apply_apply", "description": "", "p": "mathlib"}, {"name": "gen_loop.homotopic", "description": "The \"homotopic relative to boundary\" relation between `gen_loop`s.", "p": "mathlib"}, {"name": "gen_loop_equiv_of_unique", "description": "The 1-dimensional generalized loops based at `x` are in bijection with loops at `x`.", "p": "mathlib"}, {"name": "homotopy_group.comm_group", "description": "Multiplication on `homotopy_group N X x` is commutative for nontrivial `N`.\n In particular, multiplication on `\u03c0_(n+2)` is commutative.", "p": "mathlib"}, {"name": "gen_loop.homotopic.trans", "description": "", "p": "mathlib"}, {"name": "gen_loop.to_from", "description": "", "p": "mathlib"}, {"name": "loop_space", "description": "The space of paths with both endpoints equal to a specified point `x : X`.", "p": "mathlib"}, {"name": "homotopy_group.inv_spec", "description": "Characterization of multiplicative inverse", "p": "mathlib"}, {"name": "loop_space.inhabited", "description": "", "p": "mathlib"}, {"name": "gen_loop.from_loop_symm_to_loop", "description": "", "p": "mathlib"}, {"name": "gen_loop.to_loop_apply_coe", "description": "", "p": "mathlib"}, {"name": "gen_loop.copy_eq", "description": "", "p": "mathlib"}, {"name": "homotopy_group.mul_spec", "description": "Characterization of multiplication", "p": "mathlib"}, {"name": "gen_loop.loop_homeo_apply", "description": "", "p": "mathlib"}, {"name": "gen_loop.homotopic.refl", "description": "", "p": "mathlib"}, {"name": "cube.insert_at_boundary", "description": "", "p": "mathlib"}, {"name": "gen_loop.coe_copy", "description": "", "p": "mathlib"}, {"name": "homotopy_group.trans_at_indep", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.ext", "description": "To construct an isomorphism between cotridents,\nit suffices to give an isomorphism between the cocone points\nand check that it commutes with the `\u03c0` morphisms.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident", "description": "A cotrident on `f` and `g` is just a `cocone (parallel_family f)`.", "p": "mathlib"}, {"name": "category_theory.limits.has_wide_coequalizers", "description": "`has_wide_coequalizers` represents a choice of wide coequalizer for every family of morphisms", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.cotrident", "description": "An arbitrary choice of coequalizer cocone for a parallel family `f`.", "p": "mathlib"}, {"name": "category_theory.limits.trident.ext_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.epi_of_is_colimit_parallel_family", "description": "The wide coequalizer morphism in any colimit cocone is an epimorphism.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.is_colimit.desc'", "description": "If `s` is a colimit cotrident over `f`, then a morphism `k : Y \u27f6 W` satisfying\n   `\u2200 j\u2081 j\u2082, f j\u2081 \u226b k = f j\u2082 \u226b k` induces a morphism `l : s.X \u27f6 W` such that\n   `cotrident.\u03c0 s \u226b l = k`.", "p": "mathlib"}, {"name": "category_theory.limits.trident.\u03b9_of_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_wide_equalizers_of_has_limit_parallel_family", "description": "If `C` has all limits of diagrams `parallel_family f`, then it has all wide equalizers", "p": "mathlib"}, {"name": "category_theory.limits.trident.is_limit.mk'", "description": "This is another convenient method to verify that a trident is a limit cone. It\n   only asks for a proof of facts that carry any mathematical content, and allows access to the\n   same `s` for all parts.", "p": "mathlib"}, {"name": "category_theory.limits.trident.\u03b9", "description": "A trident `t` on the parallel family `f : J \u2192 (X \u27f6 Y)` consists of two morphisms\n   `t.\u03c0.app zero : t.X \u27f6 X` and `t.\u03c0.app one : t.X \u27f6 Y`. Of these, only the first one is\n   interesting, and we give it the shorter name `trident.\u03b9 t`.", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.hom_id", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.is_colimit.hom_iso_apply_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.hom", "description": "The type family of morphisms for the diagram indexing a wide (co)equalizer.", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.hom.id", "description": "The type family of morphisms for the diagram indexing a wide (co)equalizer.", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.hom.line", "description": "The type family of morphisms for the diagram indexing a wide (co)equalizer.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.is_colimit.hom_iso", "description": "Given a colimit cocone for the family `f : J \u2192 (X \u27f6 Y)`, for any `Z`, morphisms from the cocone\npoint to `Z` are in bijection with morphisms `h : Z \u27f6 X` such that\n`\u2200 j\u2081 j\u2082, f j\u2081 \u226b h = f j\u2082 \u226b h`.  Further, this bijection is natural in `Z`: see\n`cotrident.is_colimit.hom_iso_natural`.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.is_colimit.hom_iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.of_\u03b9", "description": "A trident on `f : J \u2192 (X \u27f6 Y)` is determined by the morphism `\u03b9 : P \u27f6 X` satisfying\n`\u2200 j\u2081 j\u2082, \u03b9 \u226b f j\u2081 = \u03b9 \u226b f j\u2082`.", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.condition_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.lift'", "description": "A morphism `k : W \u27f6 X` satisfying `\u2200 j\u2081 j\u2082, k \u226b f j\u2081 = k \u226b f j\u2082` induces a morphism\n   `l : W \u27f6 wide_equalizer f` satisfying `l \u226b wide_equalizer.\u03b9 f = k`.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.is_colimit.mk", "description": "This is a slightly more convenient method to verify that a cotrident is a colimit cocone. It\n   only asks for a proof of facts that carry any mathematical content", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.lift_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.hom.comp", "description": "Composition of morphisms in the indexing diagram for wide (co)equalizers.", "p": "mathlib"}, {"name": "category_theory.limits.trident.\u03b9_eq_app_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.of_\u03b9_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.desc'", "description": "Any morphism `k : Y \u27f6 W` satisfying `\u2200 j\u2081 j\u2082, f j\u2081 \u226b k = f j\u2082 \u226b k` induces a morphism\n   `l : wide_coequalizer f \u27f6 W` satisfying `wide_coequalizer.\u03c0 \u226b g = l`.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.of_cocone", "description": "Given `F : walking_parallel_family \u2964 C`, which is really the same as\n   `parallel_family (F.map left) (F.map right)` and a cocone on `F`, we get a cotrident on\n   `\u03bb j, F.map (line j)`.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.\u03c0_of_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer", "description": "If a wide coequalizer of `f`, we can access an arbitrary choice of such by\n   saying `wide_coequalizer f`.", "p": "mathlib"}, {"name": "category_theory.limits.has_wide_equalizers", "description": "`has_wide_equalizers` represents a choice of wide equalizer for every family of morphisms", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.cotrident_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident", "description": "A trident on `f` is just a `cone (parallel_family f)`.", "p": "mathlib"}, {"name": "category_theory.limits.trident.condition_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cone.of_trident_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cocone.of_cotrident", "description": "This is a helper construction that can be useful when verifying that a category has all\n   coequalizers. Given `F : walking_parallel_family \u2964 C`, which is really the same as\n   `parallel_family (\u03bb j, F.map (line j))`, and a cotrident on `\u03bb j, F.map (line j)` we get a\n   cocone on `F`.\n\n   If you're thinking about using this, have a look at\n   `has_wide_coequalizers_of_has_colimit_parallel_family`, which you may find to be an easier way\n   of achieving your goal.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.is_colimit.hom_iso_natural", "description": "The bijection of `cotrident.is_colimit.hom_iso` is natural in `Z`.", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.trident", "description": "A wide equalizer cone for a parallel family `f`.", "p": "mathlib"}, {"name": "category_theory.limits.parallel_family", "description": "`parallel_family f` is the diagram in `C` consisting of the given family of morphisms, each with\ncommon domain and codomain.", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family", "description": "The type of objects for the diagram indexing a wide (co)equalizer.", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.zero", "description": "The type of objects for the diagram indexing a wide (co)equalizer.", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.one", "description": "The type of objects for the diagram indexing a wide (co)equalizer.", "p": "mathlib"}, {"name": "category_theory.limits.cocone.of_cotrident_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.app_one_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.condition_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.parallel_family_obj_one", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family_equiv_walking_parallel_pair_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.parallel_family_obj_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.is_limit.hom_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.decidable_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.app_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_coequalizers_of_has_wide_coequalizers", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.is_colimit.mk'", "description": "This is another convenient method to verify that a cotrident is a colimit cocone. It\n   only asks for a proof of facts that carry any mathematical content, and allows access to the\n   same `s` for all parts.", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family_equiv_walking_parallel_pair_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.ext_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.condition", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.mk_hom", "description": "Helper function for constructing morphisms between coequalizer cotridents.", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.\u03c0", "description": "If a wide_coequalizer of `f` exists, we can access the corresponding projection by\n  saying `wide_coequalizer.\u03c0 f`.", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.condition", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.is_limit.hom_iso_natural", "description": "The bijection of `trident.is_limit.hom_iso` is natural in `Z`.", "p": "mathlib"}, {"name": "category_theory.limits.trident.ext", "description": "To construct an isomorphism between tridents,\nit suffices to give an isomorphism between the cone points\nand check that it commutes with the `\u03b9` morphisms.", "p": "mathlib"}, {"name": "category_theory.limits.diagram_iso_parallel_family_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.cotrident_\u03b9_app_one", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.\u03b9_mono", "description": "A wide equalizer morphism is a monomorphism", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.category", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family_equiv_walking_parallel_pair", "description": " `walking_parallel_pair` as a category is equivalent to a special case of\n`walking_parallel_family`.", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.\u03c0_epi", "description": "A wide coequalizer morphism is an epimorphism", "p": "mathlib"}, {"name": "category_theory.limits.mono_of_is_limit_parallel_family", "description": "The wide equalizer morphism in any limit cone is a monomorphism.", "p": "mathlib"}, {"name": "category_theory.limits.trident.app_zero_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.lift_\u03b9_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_equalizers_of_has_wide_equalizers", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.equalizer_ext", "description": " To check whether two maps are equalized by both maps of a trident, it suffices to check it for\nthe first map", "p": "mathlib"}, {"name": "category_theory.limits.trident.is_limit.hom_iso_apply_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.diagram_iso_parallel_family", "description": "Every functor indexing a wide (co)equalizer is naturally isomorphic (actually, equal) to a\n   `parallel_family`", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.hom.decidable_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.is_limit.hom_iso", "description": "Given a limit cone for the family `f : J \u2192 (X \u27f6 Y)`, for any `Z`, morphisms from `Z` to its point\nare in bijection with morphisms `h : Z \u27f6 X` such that `\u2200 j\u2081 j\u2082, h \u226b f j\u2081 = h \u226b f j\u2082`.\nFurther, this bijection is natural in `Z`: see `trident.is_limit.hom_iso_natural`.", "p": "mathlib"}, {"name": "category_theory.limits.trident.of_cone", "description": "Given `F : walking_parallel_family \u2964 C`, which is really the same as\n   `parallel_family (\u03bb j, F.map (line j))` and a cone on `F`, we get a trident on\n   `\u03bb j, F.map (line j)`.", "p": "mathlib"}, {"name": "category_theory.limits.trident.of_\u03b9_\u03c0_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.condition", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.\u03c0", "description": "A cotrident `t` on the parallel family `f : J \u2192 (X \u27f6 Y)` consists of two morphisms\n   `t.\u03b9.app zero : X \u27f6 t.X` and `t.\u03b9.app one : Y \u27f6 t.X`. Of these, only the second one is\n   interesting, and we give it the shorter name `cotrident.\u03c0 t`.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.mk_hom_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_wide_coequalizers_of_has_colimit_parallel_family", "description": "If `C` has all colimits of diagrams `parallel_family f`, then it has all wide coequalizers", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.of_\u03c0_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer_is_wide_equalizer", "description": "The wide_equalizer built from `wide_equalizer.\u03b9 f` is limiting.", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.\u03c0_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.\u03c0_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.app_one", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.condition", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.is_limit.hom_iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.of_\u03c0", "description": "A cotrident on `f : J \u2192 (X \u27f6 Y)` is determined by the morphism `\u03c0 : Y \u27f6 P` satisfying\n`\u2200 j\u2081 j\u2082, f j\u2081 \u226b \u03c0 = f j\u2082 \u226b \u03c0`.", "p": "mathlib"}, {"name": "category_theory.limits.has_wide_equalizer", "description": "`has_wide_equalizer f` represents a particular choice of limiting cone for the parallel family of\nmorphisms `f`.", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family_equiv_walking_parallel_pair_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family.hom.inhabited", "description": "Satisfying the inhabited linter", "p": "mathlib"}, {"name": "category_theory.limits.parallel_family_map_left", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.hom_ext", "description": "Two maps from a wide coequalizer are equal if they are equal when composed with the wide\n   coequalizer map", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.of_\u03c0_\u03b9_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.is_colimit.hom_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.walking_parallel_family_equiv_walking_parallel_pair_counit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.trident_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.of_cocone_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cone.of_trident", "description": "This is a helper construction that can be useful when verifying that a category has certain wide\n   equalizers. Given `F : walking_parallel_family \u2964 C`, which is really the same as\n   `parallel_family (\u03bb j, F.map (line j))`, and a trident on `\u03bb j, F.map (line j)`, we get a cone\n   on `F`.\n\n   If you're thinking about using this, have a look at\n   `has_wide_equalizers_of_has_limit_parallel_family`, which you may find to be an easier way of\n   achieving your goal.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.\u03c0_eq_app_one", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.trident_\u03c0_app_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.trident.is_limit.mk", "description": "This is a slightly more convenient method to verify that a trident is a limit cone. It\n   only asks for a proof of facts that carry any mathematical content", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer", "description": "If a wide equalizer of `f` exists, we can access an arbitrary choice of such by\n   saying `wide_equalizer f`.", "p": "mathlib"}, {"name": "category_theory.limits.trident.mk_hom", "description": "Helper function for constructing morphisms between wide equalizer tridents.", "p": "mathlib"}, {"name": "category_theory.limits.cotrident.coequalizer_ext", "description": " To check whether two maps are coequalized by both maps of a cotrident, it suffices to check it\nfor the second map", "p": "mathlib"}, {"name": "category_theory.limits.trident.of_cone_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.\u03b9", "description": "If a wide equalizer of `f` exists, we can access the inclusion `wide_equalizer f \u27f6 X` by\n   saying `wide_equalizer.\u03b9 f`.", "p": "mathlib"}, {"name": "category_theory.limits.trident.is_limit.lift'", "description": "If `s` is a limit trident over `f`, then a morphism `k : W \u27f6 X` satisfying\n   `\u2200 j\u2081 j\u2082, k \u226b f j\u2081 = k \u226b f j\u2082` induces a morphism `l : W \u27f6 s.X` such that\n   `l \u226b trident.\u03b9 s = k`.", "p": "mathlib"}, {"name": "category_theory.limits.has_wide_coequalizer", "description": "`has_wide_coequalizer f g` represents a particular choice of colimiting cocone\nfor the parallel family of morphisms `f`.", "p": "mathlib"}, {"name": "category_theory.limits.trident.mk_hom_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.condition_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.lift", "description": "A morphism `k : W \u27f6 X` satisfying `\u2200 j\u2081 j\u2082, k \u226b f j\u2081 = k \u226b f j\u2082` factors through the\n   wide equalizer of `f` via `wide_equalizer.lift : W \u27f6 wide_equalizer f`.", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer.desc", "description": "Any morphism `k : Y \u27f6 W` satisfying `\u2200 j\u2081 j\u2082, f j\u2081 \u226b k = f j\u2082 \u226b k` factors through the\n   wide coequalizer of `f` via `wide_coequalizer.desc : wide_coequalizer f \u27f6 W`.", "p": "mathlib"}, {"name": "category_theory.limits.wide_equalizer.hom_ext", "description": "Two maps into a wide equalizer are equal if they are are equal when composed with the wide\n   equalizer map.", "p": "mathlib"}, {"name": "category_theory.limits.wide_coequalizer_is_wide_coequalizer", "description": "The cotrident built from `wide_coequalizer.\u03c0 f` is colimiting.", "p": "mathlib"}, {"name": "category_theory.limits.diagram_iso_parallel_family_inv_app", "description": "", "p": "mathlib"}, {"name": "imo2006_q3.four_pow_four_pos", "description": "", "p": "mathlib-archive"}, {"name": "imo2006_q3", "description": "", "p": "mathlib-archive"}, {"name": "imo2006_q3.zero_lt_32", "description": "", "p": "mathlib-archive"}, {"name": "imo2006_q3.lhs_ineq", "description": "Replacing `x` and `y` with their average increases the left side.", "p": "mathlib-archive"}, {"name": "imo2006_q3.subst_proof\u2081", "description": "Proof that `M = 9 * sqrt 2 / 32` works with the substitution.", "p": "mathlib-archive"}, {"name": "imo2006_q3.proof\u2081", "description": "", "p": "mathlib-archive"}, {"name": "imo2006_q3.proof\u2082", "description": "", "p": "mathlib-archive"}, {"name": "imo2006_q3.lhs_identity", "description": "", "p": "mathlib-archive"}, {"name": "imo2006_q3.mid_ineq", "description": "", "p": "mathlib-archive"}, {"name": "imo2006_q3.rhs_ineq", "description": "Replacing `x` and `y` with their average decreases the right side.", "p": "mathlib-archive"}, {"name": "imo2006_q3.subst_wlog", "description": "", "p": "mathlib-archive"}, {"name": "category_theory.abelian_of_adjunction.has_kernels", "description": "No point making this an instance, as it requires `i`.", "p": "mathlib"}, {"name": "category_theory.abelian_of_adjunction.coimage_iso_image_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.abelian_of_adjunction", "description": "If `C` is an additive category, `D` is an abelian category,\nwe have `F : C \u2964 D` `G : D \u2964 C` (both preserving zero morphisms),\n`G` is left exact (that is, preserves finite limits),\nand further we have `adj : G \u22a3 F` and `i : F \u22d9 G \u2245 \ud835\udfed C`,\nthen `C` is also abelian.\n\nSee <https://stacks.math.columbia.edu/tag/03A3>", "p": "mathlib"}, {"name": "category_theory.abelian_of_adjunction.coimage_iso_image_aux", "description": "Auxiliary construction for `coimage_iso_image`", "p": "mathlib"}, {"name": "category_theory.abelian_of_equivalence", "description": "If `C` is an additive category equivalent to an abelian category `D`\nvia a functor that preserves zero morphisms,\nthen `C` is also abelian.", "p": "mathlib"}, {"name": "category_theory.abelian_of_adjunction.coimage_iso_image", "description": "Auxiliary definition: the abelian coimage and abelian image agree.\nWe still need to check that this agrees with the canonical morphism.", "p": "mathlib"}, {"name": "category_theory.abelian_of_adjunction.cokernel_iso", "description": "Auxiliary construction for `coimage_iso_image`", "p": "mathlib"}, {"name": "category_theory.abelian_of_adjunction.has_cokernels", "description": "No point making this an instance, as it requires `i` and `adj`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout_symmetry", "description": "If `F` preserves the pushout of `f, g`, it also preserves the pushout of `g, f`.", "p": "mathlib"}, {"name": "category_theory.limits.pullback_comparison.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_of_has_pushout_of_preserves_colimit", "description": " If `G` preserves pushouts and `C` has them, then the pushout cocone constructed of the mapped\nmorphisms of the pushout cocone is a colimit.", "p": "mathlib"}, {"name": "category_theory.limits.has_pullback_of_preserves_pullback", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.of_iso_comparison", "description": " If the pullback comparison map for `G` at `(f,g)` is an isomorphism, then `G` preserves the\npullback of `(f,g)`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.inr_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.inr_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.pushout_comparison.category_theory.is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.of_iso_comparison", "description": " If the pushout comparison map for `G` at `(f,g)` is an isomorphism, then `G` preserves the\npushout of `(f,g)`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso_inv_fst_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_pushout_of_preserves_pushout", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso_hom_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso_inv_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso_hom_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.iso", "description": " If `G` preserves the pushout of `(f,g)`, then the pushout comparison map for `G` at `(f,g)` is\nan isomorphism.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.inl_iso_hom_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso_hom_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_of_is_limit_pullback_cone_map", "description": "The property of reflecting pullbacks expressed in terms of binary fans.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso_hom_fst_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback_symmetry", "description": "If `F` preserves the pullback of `f, g`, it also preserves the pullback of `g, f`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.inr_iso_inv_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.inl_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_of_is_colimit_pushout_cocone_map", "description": "The property of reflecting pushouts expressed in terms of binary cofans.", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_map_cone_pullback_cone_equiv", "description": " The map of a pullback cone is a limit iff the fork consisting of the mapped morphisms is a\nlimit. This essentially lets us commute `pullback_cone.mk` with `functor.map_cone`.", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_map_cocone_pushout_cocone_equiv", "description": " The map of a pushout cocone is a colimit iff the cofork consisting of the mapped morphisms is a\ncolimit. This essentially lets us commute `pushout_cocone.mk` with `functor.map_cocone`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso_inv_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_pullback_cone_map_of_is_limit", "description": "The property of preserving pullbacks expressed in terms of binary fans.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso_inv_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso", "description": " If `G` preserves the pullback of `(f,g)`, then the pullback comparison map for `G` at `(f,g)` is\nan isomorphism.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.inl_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.inr_iso_hom_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pullback.iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_of_has_pullback_of_preserves_limit", "description": " If `G` preserves pullbacks and `C` has them, then the pullback cone constructed of the mapped\nmorphisms of the pullback cone is a limit.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_pushout.inl_iso_inv_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_pushout_cocone_map_of_is_colimit", "description": "The property of preserving pushouts expressed in terms of binary cofans.", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.basic_open", "description": "The basic open of a section `f` is the set of all points `x`, such that the germ of `f` at\n`x` is a unit.", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.basic_open_of_is_unit", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.basic_open_le", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.is_unit_res_basic_open", "description": "The restriction of a section `f` to the basic open of `f` is a unit.", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.mem_basic_open", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace", "description": "The type of Ringed spaces, as an abbreviation for `SheafedSpace CommRing`.", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.is_unit_of_is_unit_germ", "description": "If a section `f` is a unit in each stalk, `f` must be a unit.", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.is_unit_res_of_is_unit_germ", "description": "If the germ of a section `f` is a unit in the stalk at `x`, then `f` must be a unit on some small\nneighborhood around `x`.", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.mem_top_basic_open", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.basic_open_res", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.basic_open_res_eq", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.RingedSpace.basic_open_mul", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter.scomp", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter.comp_has_fderiv_at_filter", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.iterate", "description": "", "p": "mathlib"}, {"name": "has_strict_fderiv_at.comp_has_strict_deriv_at", "description": "", "p": "mathlib"}, {"name": "deriv_within.comp", "description": "", "p": "mathlib"}, {"name": "deriv.comp", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.comp_has_fderiv_within_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.comp", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at.comp_has_strict_fderiv_at", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at.comp", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.scomp_has_deriv_at", "description": "", "p": "mathlib"}, {"name": "fderiv.comp_deriv", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.scomp", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter.iterate", "description": "", "p": "mathlib"}, {"name": "fderiv_within.comp_deriv_within", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter.comp", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.scomp_has_deriv_within_at", "description": "", "p": "mathlib"}, {"name": "has_fderiv_at.comp_has_deriv_at", "description": " The composition `l \u2218 f` where `l : F \u2192 E` and `f : \ud835\udd5c \u2192 F`, has a derivative equal to the\nFr\u00e9chet derivative of `l` applied to the derivative of `f`.", "p": "mathlib"}, {"name": "has_deriv_at.comp_has_fderiv_within_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.scomp", "description": "The chain rule.", "p": "mathlib"}, {"name": "deriv_within.scomp", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at.scomp", "description": "", "p": "mathlib"}, {"name": "has_fderiv_within_at.comp_has_deriv_within_at", "description": " The composition `l \u2218 f` where `l : F \u2192 E` and `f : \ud835\udd5c \u2192 F`, has a derivative within a set\nequal to the Fr\u00e9chet derivative of `l` applied to the derivative of `f`.", "p": "mathlib"}, {"name": "has_deriv_at.comp_has_deriv_within_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.iterate", "description": "", "p": "mathlib"}, {"name": "has_fderiv_at.comp_has_deriv_within_at", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.comp", "description": "The chain rule.", "p": "mathlib"}, {"name": "has_strict_deriv_at.iterate", "description": "", "p": "mathlib"}, {"name": "deriv.scomp", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.comp_has_fderiv_at", "description": "", "p": "mathlib"}, {"name": "with_one.coe_mul_hom_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.with_one_congr_refl", "description": "", "p": "mathlib"}, {"name": "with_zero.lift_coe", "description": "", "p": "mathlib"}, {"name": "with_zero.map_id", "description": "", "p": "mathlib"}, {"name": "with_zero.lift_unique", "description": "", "p": "mathlib"}, {"name": "with_zero.lift", "description": "Lift an add_semigroup homomorphism `f` to a bundled add_monoid homorphism.", "p": "mathlib"}, {"name": "with_one.map_coe", "description": "", "p": "mathlib"}, {"name": "with_zero.map_comp", "description": "", "p": "mathlib"}, {"name": "mul_equiv.with_one_congr_apply", "description": "", "p": "mathlib"}, {"name": "with_zero.map_coe", "description": "", "p": "mathlib"}, {"name": "mul_equiv.with_one_congr_symm", "description": "", "p": "mathlib"}, {"name": "with_one.map", "description": "Given a multiplicative map from `\u03b1 \u2192 \u03b2` returns a monoid homomorphism\n from `with_one \u03b1` to `with_one \u03b2`", "p": "mathlib"}, {"name": "with_one.map_map", "description": "", "p": "mathlib"}, {"name": "add_equiv.with_zero_congr_apply", "description": "", "p": "mathlib"}, {"name": "with_one.lift_unique", "description": "", "p": "mathlib"}, {"name": "with_one.lift_coe", "description": "", "p": "mathlib"}, {"name": "mul_equiv.with_one_congr_trans", "description": "", "p": "mathlib"}, {"name": "with_zero.lift_zero", "description": "", "p": "mathlib"}, {"name": "with_one.lift_one", "description": "", "p": "mathlib"}, {"name": "with_zero.map_map", "description": "", "p": "mathlib"}, {"name": "with_one.map_comp", "description": "", "p": "mathlib"}, {"name": "with_zero.coe_add_hom", "description": "`coe` as a bundled morphism", "p": "mathlib"}, {"name": "with_zero.coe_add_hom_apply", "description": "", "p": "mathlib"}, {"name": "with_one.lift", "description": "Lift a semigroup homomorphism `f` to a bundled monoid homorphism.", "p": "mathlib"}, {"name": "add_equiv.with_zero_congr", "description": "A version of `equiv.option_congr` for `with_zero`.", "p": "mathlib"}, {"name": "with_zero.map", "description": "Given an additive map from `\u03b1 \u2192 \u03b2` returns an add_monoid homomorphism\n  from `with_zero \u03b1` to `with_zero \u03b2`", "p": "mathlib"}, {"name": "mul_equiv.with_one_congr", "description": "A version of `equiv.option_congr` for `with_one`.", "p": "mathlib"}, {"name": "with_one.map_id", "description": "", "p": "mathlib"}, {"name": "with_one.coe_mul_hom", "description": "`coe` as a bundled morphism", "p": "mathlib"}, {"name": "char_p.pi'", "description": "", "p": "mathlib"}, {"name": "char_p.pi", "description": "", "p": "mathlib"}, {"name": "equiv.fun_split_at", "description": "A product of copies of a type can be split as the binary product of one copy and the product\n of all the remaining copies.", "p": "mathlib"}, {"name": "equiv.prod_comm", "description": " Type product is commutative up to an equivalence: `\u03b1 \u00d7 \u03b2 \u2243 \u03b2 \u00d7 \u03b1`. This is `prod.swap` as an\nequivalence.", "p": "mathlib"}, {"name": "equiv.perm.subtype_congr.apply", "description": "", "p": "mathlib"}, {"name": "equiv.coe_prod_comm", "description": "", "p": "mathlib"}, {"name": "function.injective.map_swap", "description": "", "p": "mathlib"}, {"name": "equiv.sum_congr_refl", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_comm", "description": " Given `\u03c6 : \u03b1 \u2192 \u03b2 \u2192 Sort*`, we have an equivalence between `\u03a0 a b, \u03c6 a b` and `\u03a0 b a, \u03c6 a b`.\nThis is `function.swap` as an `equiv`.", "p": "mathlib"}, {"name": "equiv.sigma_subtype_equiv_of_subset", "description": " A sigma type over a subtype is equivalent to the sigma set over the original type,\nif the fiber is empty outside of the subset", "p": "mathlib"}, {"name": "equiv.sum_empty", "description": "Sum with `empty` is equivalent to the original type.", "p": "mathlib"}, {"name": "function.involutive.to_perm", "description": "Convert an involutive function `f` to a permutation with `to_fun = inv_fun = f`.", "p": "mathlib"}, {"name": "equiv.psum_equiv_sum", "description": "`psum` is equivalent to `sum`.", "p": "mathlib"}, {"name": "equiv.subtype_equiv_codomain_apply", "description": "", "p": "mathlib"}, {"name": "equiv.perm.prod_extend_right", "description": " `prod_extend_right a e` extends `e : perm \u03b2` to `perm (\u03b1 \u00d7 \u03b2)` by sending `(a, b)` to\n`(a, e b)` and keeping the other `(a', b)` fixed.", "p": "mathlib"}, {"name": "equiv.subtype_equiv_symm", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_equiv_codomain_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.pi_equiv_pi_subtype_prod", "description": " The type `\u03a0 (i : \u03b1), \u03b2 i` can be split as a product by separating the indices in `\u03b1`\ndepending on whether they satisfy a predicate `p` or not.", "p": "mathlib"}, {"name": "equiv.subtype_equiv_of_subtype", "description": " If `\u03b1 \u2243 \u03b2`, then for any predicate `p : \u03b2 \u2192 Prop` the subtype `{a // p (e a)}` is equivalent\nto the subtype `{b // p b}`.", "p": "mathlib"}, {"name": "equiv.prod_prod_prod_comm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_comm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.curry_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_subtype_equiv_subtype_symm_apply_coe_coe", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_option_equiv_of_some", "description": " A sigma type over an `option` is equivalent to the sigma set over the original type,\nif the fiber is empty at none.", "p": "mathlib"}, {"name": "equiv.of_fiber_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_prod_distrib_apply_right", "description": "", "p": "mathlib"}, {"name": "equiv.coe_subtype_equiv_codomain_symm", "description": "", "p": "mathlib"}, {"name": "equiv.prod_congr_left_trans_prod_comm", "description": "", "p": "mathlib"}, {"name": "equiv.prod_unique", "description": "Any `unique` type is a right identity for type product up to equivalence.", "p": "mathlib"}, {"name": "equiv.bool_prod_equiv_sum_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_compl_apply_symm_of_pos", "description": "", "p": "mathlib"}, {"name": "function.update_apply_equiv_apply", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_equiv_codomain_symm_apply_ne", "description": "", "p": "mathlib"}, {"name": "function.involutive.to_perm_involutive", "description": "", "p": "mathlib"}, {"name": "equiv.prod_empty", "description": "`empty` type is a right absorbing element for type product up to an equivalence.", "p": "mathlib"}, {"name": "equiv.swap_apply_self", "description": "", "p": "mathlib"}, {"name": "equiv.perm.sum_congr_refl", "description": "", "p": "mathlib"}, {"name": "equiv.perm.extend_domain_trans", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_congr_right_sigma_equiv_prod", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_subtype_equiv_subtype_apply_coe", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_equiv_of_subtype'", "description": " If `\u03b1 \u2243 \u03b2`, then for any predicate `p : \u03b1 \u2192 Prop` the subtype `{a // p a}` is equivalent\nto the subtype `{b // p (e.symm b)}`. This version is used by `equiv_rw`.", "p": "mathlib"}, {"name": "equiv.sum_assoc_apply_inl_inr", "description": "", "p": "mathlib"}, {"name": "equiv.swap_apply_eq_iff", "description": "", "p": "mathlib"}, {"name": "equiv.arrow_prod_equiv_prod_arrow", "description": " The type of functions to a product `\u03b1 \u00d7 \u03b2` is equivalent to the type of pairs of functions\n`\u03b3 \u2192 \u03b1` and `\u03b3 \u2192 \u03b2`.", "p": "mathlib"}, {"name": "equiv.subtype_equiv_right_symm_apply_coe", "description": "", "p": "mathlib"}, {"name": "equiv.sum_compl_apply_inl", "description": "", "p": "mathlib"}, {"name": "equiv.prod_congr", "description": " Product of two equivalences. If `\u03b1\u2081 \u2243 \u03b1\u2082` and `\u03b2\u2081 \u2243 \u03b2\u2082`, then `\u03b1\u2081 \u00d7 \u03b2\u2081 \u2243 \u03b1\u2082 \u00d7 \u03b2\u2082`. This is\n`prod.map` as an equivalence.", "p": "mathlib"}, {"name": "equiv.subtype_univ_equiv", "description": " If a proposition holds for all elements, then the subtype is\nequivalent to the original type.", "p": "mathlib"}, {"name": "equiv.of_fiber_equiv_apply", "description": "", "p": "mathlib"}, {"name": "equiv.coe_subtype_equiv_codomain", "description": "", "p": "mathlib"}, {"name": "equiv.pprod_equiv_prod_plift_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.curry", "description": "Functions on `\u03b1 \u00d7 \u03b2` are equivalent to functions `\u03b1 \u2192 \u03b2 \u2192 \u03b3`.", "p": "mathlib"}, {"name": "equiv.subtype_univ_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_arrow_equiv_prod_arrow_symm_apply_inl", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_equiv_codomain_symm_apply_eq", "description": "", "p": "mathlib"}, {"name": "equiv.bool_prod_equiv_sum", "description": "The product `bool \u00d7 \u03b1` is equivalent to `\u03b1 \u2295 \u03b1`.", "p": "mathlib"}, {"name": "equiv.prod_congr_refl_left", "description": "", "p": "mathlib"}, {"name": "equiv.punit_prod", "description": "`punit` is a left identity for type product up to an equivalence.", "p": "mathlib"}, {"name": "equiv.semiconj_conj", "description": "", "p": "mathlib"}, {"name": "equiv.pi_option_equiv_prod_apply", "description": "", "p": "mathlib"}, {"name": "equiv.prod_sum_distrib_symm_apply_left", "description": "", "p": "mathlib"}, {"name": "equiv.prod_congr_right_trans_prod_comm", "description": "", "p": "mathlib"}, {"name": "equiv.coe_prod_unique", "description": "", "p": "mathlib"}, {"name": "equiv.prod_punit", "description": "`punit` is a right identity for type product up to an equivalence.", "p": "mathlib"}, {"name": "function.Pi_congr_left'_symm_update", "description": "", "p": "mathlib"}, {"name": "equiv.prod_shear_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_equiv_trans", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_subtype_fiber_equiv_subtype", "description": " If for each `x` we have `p x \u2194 q (f x)`, then `\u03a3 y : {y // q y}, f \u207b\u00b9' {y}` is equivalent\nto `{x // p x}`.", "p": "mathlib"}, {"name": "function.Pi_congr_left'_update", "description": "", "p": "mathlib"}, {"name": "equiv.arrow_congr.is_right_cancel", "description": "", "p": "mathlib"}, {"name": "equiv.prod_unique_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.of_bijective_symm_apply_apply", "description": "", "p": "mathlib"}, {"name": "equiv.option_equiv_sum_punit_some", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_prod_distrib", "description": " The product of an indexed sum of types (formally, a `sigma`-type `\u03a3 i, \u03b1 i`) by a type `\u03b2` is\nequivalent to the sum of products `\u03a3 i, (\u03b1 i \u00d7 \u03b2)`.", "p": "mathlib"}, {"name": "equiv.perm.sum_congr_apply", "description": "", "p": "mathlib"}, {"name": "equiv.swap_apply_right", "description": "", "p": "mathlib"}, {"name": "equiv.sum_prod_distrib_symm_apply_left", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_preimage_symm_apply_coe_neg", "description": "", "p": "mathlib"}, {"name": "equiv.prod_pprod", "description": "Combine two equivalences using `pprod` in the codomain and `prod` in the domain.", "p": "mathlib"}, {"name": "equiv.subtype_quotient_equiv_quotient_subtype_mk", "description": "", "p": "mathlib"}, {"name": "equiv.perm.subtype_congr.left_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_empty_apply_inl", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_congr_left", "description": "Transporting dependent functions through an equivalence of the base,\nexpressed as a \"simplification\".", "p": "mathlib"}, {"name": "equiv.sigma_sum_distrib_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_arrow_equiv_prod_arrow_apply_snd", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_subtype_equiv_subtype_inter", "description": "A subtype of a subtype is equivalent to the subtype of elements satisfying both predicates.", "p": "mathlib"}, {"name": "equiv.prod_prod_prod_comm_symm", "description": "", "p": "mathlib"}, {"name": "equiv.coe_Pi_congr'", "description": "", "p": "mathlib"}, {"name": "equiv.swap_self", "description": "", "p": "mathlib"}, {"name": "equiv.is_empty", "description": "", "p": "mathlib"}, {"name": "equiv.prod_punit_apply", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_preimage_symm_apply_coe", "description": "", "p": "mathlib"}, {"name": "equiv.perm.sum_congr_trans", "description": "", "p": "mathlib"}, {"name": "equiv.sum_assoc_apply_inr", "description": "", "p": "mathlib"}, {"name": "equiv.pi_equiv_pi_subtype_prod_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.bool_arrow_equiv_prod", "description": "The function type `bool \u2192 \u03b1` is equivalent to `\u03b1 \u00d7 \u03b1`.", "p": "mathlib"}, {"name": "equiv.swap_apply_left", "description": "", "p": "mathlib"}, {"name": "equiv.perm.extend_domain_refl", "description": "", "p": "mathlib"}, {"name": "equiv.pprod_prod_apply", "description": "", "p": "mathlib"}, {"name": "equiv.prod_congr_left", "description": " A family of equivalences `\u03a0 (a : \u03b1\u2081), \u03b2\u2081 \u2243 \u03b2\u2082` generates an equivalence\nbetween `\u03b2\u2081 \u00d7 \u03b1\u2081` and `\u03b2\u2082 \u00d7 \u03b1\u2081`.", "p": "mathlib"}, {"name": "equiv.subtype_equiv_prop", "description": "If two predicates are equal, then the corresponding subtypes are equivalent.", "p": "mathlib"}, {"name": "function.involutive.coe_to_perm", "description": "", "p": "mathlib"}, {"name": "equiv.perm.subtype_congr.symm", "description": "", "p": "mathlib"}, {"name": "equiv.sum_assoc_symm_apply_inr_inr", "description": "", "p": "mathlib"}, {"name": "equiv.of_bijective", "description": "If `f` is a bijective function, then its domain is equivalent to its codomain.", "p": "mathlib"}, {"name": "equiv.prod_assoc_symm_apply", "description": "", "p": "mathlib"}, {"name": "function.involutive.to_perm_symm", "description": "", "p": "mathlib"}, {"name": "equiv.of_fiber_equiv_map", "description": "", "p": "mathlib"}, {"name": "equiv.prod_sum_distrib_symm_apply_right", "description": "", "p": "mathlib"}, {"name": "equiv.perm.sum_congr_swap_refl", "description": "", "p": "mathlib"}, {"name": "equiv.sum_congr_symm", "description": "", "p": "mathlib"}, {"name": "equiv.perm.subtype_congr.refl", "description": "", "p": "mathlib"}, {"name": "equiv.perm.subtype_congr", "description": " Combining permutations on `\u03b5` that permute only inside or outside the subtype\nsplit induced by `p : \u03b5 \u2192 Prop` constructs a permutation on `\u03b5`.", "p": "mathlib"}, {"name": "equiv.prod_congr_symm", "description": "", "p": "mathlib"}, {"name": "equiv.sum_arrow_equiv_prod_arrow", "description": " The type of functions on a sum type `\u03b1 \u2295 \u03b2` is equivalent to the type of pairs of functions\non `\u03b1` and on `\u03b2`.", "p": "mathlib"}, {"name": "equiv.sum_equiv_sigma_bool", "description": " `\u03b1 \u2295 \u03b2` is equivalent to a `sigma`-type over `bool`. Note that this definition assumes `\u03b1` and\n`\u03b2` to be types from the same universe, so it cannot by used directly to transfer theorems about\nsigma types to theorems about sum types. In many cases one can use `ulift` to work around this\ndifficulty.", "p": "mathlib"}, {"name": "equiv.sigma_sum_distrib", "description": "An indexed sum of disjoint sums of types is equivalent to the sum of the indexed sums.", "p": "mathlib"}, {"name": "equiv.subtype_equiv_codomain", "description": " The type of all functions `X \u2192 Y` with prescribed values for all `x' \u2260 x`\nis equivalent to the codomain `Y`.", "p": "mathlib"}, {"name": "equiv.is_empty_congr", "description": "If `\u03b1` is equivalent to `\u03b2`, then `is_empty \u03b1` is equivalent to `is_empty \u03b2`.", "p": "mathlib"}, {"name": "equiv.option_equiv_sum_punit_none", "description": "", "p": "mathlib"}, {"name": "equiv.perm.sum_congr", "description": "Combine a permutation of `\u03b1` and of `\u03b2` into a permutation of `\u03b1 \u2295 \u03b2`.", "p": "mathlib"}, {"name": "equiv.swap_core", "description": "A helper function for `equiv.swap`.", "p": "mathlib"}, {"name": "equiv.empty_sum_apply_inr", "description": "", "p": "mathlib"}, {"name": "equiv.semiconj\u2082_conj", "description": "", "p": "mathlib"}, {"name": "equiv.perm.prod_extend_right_apply_eq", "description": "", "p": "mathlib"}, {"name": "equiv.prod_congr_right", "description": " A family of equivalences `\u03a0 (a : \u03b1\u2081), \u03b2\u2081 \u2243 \u03b2\u2082` generates an equivalence\nbetween `\u03b1\u2081 \u00d7 \u03b2\u2081` and `\u03b1\u2081 \u00d7 \u03b2\u2082`.", "p": "mathlib"}, {"name": "equiv.apply_swap_eq_self", "description": "A function is invariant to a swap if it is equal at both elements", "p": "mathlib"}, {"name": "equiv.pprod_equiv_prod_plift", "description": "`pprod \u03b1 \u03b2` is equivalent to `plift \u03b1 \u00d7 plift \u03b2`", "p": "mathlib"}, {"name": "equiv.empty_sum", "description": "The sum of `empty` with any `Sort*` is equivalent to the right summand.", "p": "mathlib"}, {"name": "plift.eq_up_iff_down_eq", "description": "", "p": "mathlib"}, {"name": "equiv.perm.subtype_congr.right_apply", "description": "", "p": "mathlib"}, {"name": "equiv.pempty_prod", "description": "`pempty` type is a left absorbing element for type product up to an equivalence.", "p": "mathlib"}, {"name": "equiv.subtype_preimage_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_congr_apply", "description": "", "p": "mathlib"}, {"name": "equiv.arrow_congr.is_left_cancel", "description": "", "p": "mathlib"}, {"name": "equiv.symm_trans_swap_trans", "description": "", "p": "mathlib"}, {"name": "equiv.coe_unique_prod", "description": "", "p": "mathlib"}, {"name": "equiv.prod_shear_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_compl_apply_symm_of_neg", "description": "", "p": "mathlib"}, {"name": "equiv.perm.extend_domain_apply_not_subtype", "description": "", "p": "mathlib"}, {"name": "equiv.bool_prod_equiv_sum_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_comm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.nat_equiv_nat_sum_punit", "description": "The set of natural numbers is equivalent to `\u2115 \u2295 punit`.", "p": "mathlib"}, {"name": "equiv.unique_prod_apply", "description": "", "p": "mathlib"}, {"name": "equiv.prod_congr_refl_right", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_comm_symm", "description": "", "p": "mathlib"}, {"name": "equiv.fun_split_at_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.prod_comm_symm", "description": "", "p": "mathlib"}, {"name": "equiv.pprod_equiv_prod_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_psum", "description": "Combine two `equiv`s using `sum` in the domain and `psum` in the codomain.", "p": "mathlib"}, {"name": "equiv_of_subsingleton_of_subsingleton", "description": "To give an equivalence between two subsingleton types, it is sufficient to give any two\n   functions between them.", "p": "mathlib"}, {"name": "equiv.Pi_congr'_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_comm_symm", "description": "", "p": "mathlib"}, {"name": "equiv.prod_shear", "description": "A variation on `equiv.prod_congr` where the equivalence in the second component can depend\n on the first component. A typical example is a shear mapping, explaining the name of this\n declaration.", "p": "mathlib"}, {"name": "equiv.swap_apply_of_ne_of_ne", "description": "", "p": "mathlib"}, {"name": "equiv.of_bijective_apply_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.swap_eq_update", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_subtype_equiv_subtype", "description": " If the outer subtype has more restrictive predicate than the inner one,\nthen we can drop the latter.", "p": "mathlib"}, {"name": "equiv.prod_assoc", "description": "Type product is associative up to an equivalence.", "p": "mathlib"}, {"name": "equiv.option_equiv_sum_punit_symm_inl", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_subtype_equiv_subtype_inter_apply_coe", "description": "", "p": "mathlib"}, {"name": "equiv.prod_congr_right_apply", "description": "", "p": "mathlib"}, {"name": "equiv.fun_split_at_apply", "description": "", "p": "mathlib"}, {"name": "equiv.arrow_congr.is_idempotent", "description": "", "p": "mathlib"}, {"name": "function.update_comp_equiv", "description": "", "p": "mathlib"}, {"name": "equiv.sum_compl", "description": " For any predicate `p` on `\u03b1`,\nthe sum of the two subtypes `{a // p a}` and its complement `{a // \u00ac p a}`\nis naturally equivalent to `\u03b1`.\n\nSee `subtype_or_equiv` for sum types over subtypes `{x // p x}` and `{x // q x}`\nthat are not necessarily `is_compl p q`.", "p": "mathlib"}, {"name": "equiv.prod_pprod_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.pi_equiv_pi_subtype_prod_apply", "description": "", "p": "mathlib"}, {"name": "equiv.pprod_equiv_prod_plift_apply", "description": "", "p": "mathlib"}, {"name": "equiv.pprod_equiv_prod_apply", "description": "", "p": "mathlib"}, {"name": "equiv.option_equiv_sum_punit_coe", "description": "", "p": "mathlib"}, {"name": "unique_unique_equiv", "description": "`unique (unique \u03b1)` is equivalent to `unique \u03b1`.", "p": "mathlib"}, {"name": "equiv.pprod_prod_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.bool_equiv_punit_sum_punit", "description": "`bool` is equivalent the sum of two `punit`s.", "p": "mathlib"}, {"name": "equiv.set_value_eq", "description": "", "p": "mathlib"}, {"name": "equiv.swap_eq_refl_iff", "description": "", "p": "mathlib"}, {"name": "equiv.perm.subtype_congr.trans", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_equiv_refl", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_pi_equiv_pi", "description": " The set of functions `f : \u03a0 a, \u03b2 a` such that for all `a` we have `p a (f a)` is equivalent\nto the set of functions `\u03a0 a, {b : \u03b2 a // p a b}`.", "p": "mathlib"}, {"name": "equiv.subtype_equiv_right", "description": " If two predicates `p` and `q` are pointwise equivalent, then `{x // p x}` is equivalent to\n`{x // q x}`.", "p": "mathlib"}, {"name": "equiv.pprod_equiv_prod", "description": "`pprod \u03b1 \u03b2` is equivalent to `\u03b1 \u00d7 \u03b2`", "p": "mathlib"}, {"name": "equiv.option_is_some_equiv_symm_apply_coe", "description": "", "p": "mathlib"}, {"name": "equiv.sum_prod_distrib_symm_apply_right", "description": "", "p": "mathlib"}, {"name": "equiv.list_equiv_of_equiv", "description": "An equivalence between `\u03b1` and `\u03b2` generates an equivalence between `list \u03b1` and `list \u03b2`.", "p": "mathlib"}, {"name": "equiv.psum_congr", "description": "If `\u03b1 \u2243 \u03b1'` and `\u03b2 \u2243 \u03b2'`, then `psum \u03b1 \u03b2 \u2243 psum \u03b1' \u03b2'`.", "p": "mathlib"}, {"name": "equiv.perm.extend_domain_symm", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_fiber_equiv_apply", "description": "", "p": "mathlib"}, {"name": "equiv.perm.extend_domain_apply_image", "description": "", "p": "mathlib"}, {"name": "equiv.sum_empty_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.option_equiv_sum_punit_symm_inr", "description": "", "p": "mathlib"}, {"name": "equiv.unique_prod", "description": "Any `unique` type is a left identity for type product up to equivalence.", "p": "mathlib"}, {"name": "equiv.subtype_equiv_right_apply_coe", "description": "", "p": "mathlib"}, {"name": "equiv.perm.extend_domain", "description": "Extend the domain of `e : equiv.perm \u03b1` to one that is over `\u03b2` via `f : \u03b1 \u2192 subtype p`,\nwhere `p : \u03b2 \u2192 Prop`, permuting only the `b : \u03b2` that satisfy `p b`.\nThis can be used to extend the domain across a function `f : \u03b1 \u2192 \u03b2`,\nkeeping everything outside of `set.range f` fixed. For this use-case `equiv` given by `f` can\nbe constructed by `equiv.of_left_inverse'` or `equiv.of_left_inverse` when there is a known\ninverse, or `equiv.of_injective` in the general case.`.", "p": "mathlib"}, {"name": "equiv.subtype_quotient_equiv_quotient_subtype", "description": " Subtype of the quotient is equivalent to the quotient of the subtype. Let `\u03b1` be a setoid with\nequivalence relation `~`. Let `p\u2082` be a predicate on the quotient type `\u03b1/~`, and `p\u2081` be the lift\nof this predicate to `\u03b1`: `p\u2081 a \u2194 p\u2082 \u27e6a\u27e7`. Let `~\u2082` be the restriction of `~` to `{x // p\u2081 x}`.\nThen `{x // p\u2082 x}` is equivalent to the quotient of `{x // p\u2081 x}` by `~\u2082`.", "p": "mathlib"}, {"name": "equiv.bool_arrow_equiv_prod_apply", "description": "", "p": "mathlib"}, {"name": "equiv.swap_core_self", "description": "", "p": "mathlib"}, {"name": "equiv.sum_congr_trans", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_subtype_equiv_subtype_exists", "description": " A subtype of a subtype is equivalent to the subtype of elements satisfying both predicates. This\nversion allows the \u201cinner\u201d predicate to depend on `h : p a`.", "p": "mathlib"}, {"name": "equiv.prod_punit_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.arrow_congr.is_associative", "description": "", "p": "mathlib"}, {"name": "equiv.empty_sum_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.pi_option_equiv_prod_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.prod_comm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.curry_apply", "description": "", "p": "mathlib"}, {"name": "equiv.comp_swap_eq_update", "description": "", "p": "mathlib"}, {"name": "equiv.pprod_congr", "description": " Product of two equivalences, in terms of `pprod`. If `\u03b1 \u2243 \u03b2` and `\u03b3 \u2243 \u03b4`, then\n`pprod \u03b1 \u03b3 \u2243 pprod \u03b2 \u03b4`.", "p": "mathlib"}, {"name": "equiv.prod_congr_apply", "description": "", "p": "mathlib"}, {"name": "equiv.prod_pempty", "description": "`pempty` type is a right absorbing element for type product up to an equivalence.", "p": "mathlib"}, {"name": "equiv.nat_sum_punit_equiv_nat", "description": "`\u2115 \u2295 punit` is equivalent to `\u2115`.", "p": "mathlib"}, {"name": "equiv.pi_option_equiv_prod", "description": " The product over `option \u03b1` of `\u03b2 a` is the binary product of the\nproduct over `\u03b1` of `\u03b2 (some \u03b1)` and `\u03b2 none`", "p": "mathlib"}, {"name": "equiv.punit_prod_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_nat_succ", "description": "An equivalence that separates out the 0th fiber of `(\u03a3 (n : \u2115), f n)`.", "p": "mathlib"}, {"name": "equiv.sum_assoc_symm_apply_inl", "description": "", "p": "mathlib"}, {"name": "equiv.option_is_some_equiv_apply", "description": "", "p": "mathlib"}, {"name": "equiv.perm.fst_prod_extend_right", "description": "", "p": "mathlib"}, {"name": "equiv.perm.extend_domain_apply_subtype", "description": "", "p": "mathlib"}, {"name": "equiv.prod_pprod_apply", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_quotient_equiv_quotient_subtype_symm_mk", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_congr_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.function.bijective.can_lift", "description": "", "p": "mathlib"}, {"name": "equiv.perm.eq_of_prod_extend_right_ne", "description": "", "p": "mathlib"}, {"name": "equiv.prod_sum_distrib_apply_right", "description": "", "p": "mathlib"}, {"name": "equiv.sum_assoc", "description": "Sum of types is associative up to an equivalence.", "p": "mathlib"}, {"name": "equiv.Pi_congr_left'_apply", "description": "", "p": "mathlib"}, {"name": "equiv.unique_congr", "description": "If `\u03b1` is equivalent to `\u03b2`, then `unique \u03b1` is equivalent to `unique \u03b2`.", "p": "mathlib"}, {"name": "equiv.psum_sum", "description": "Combine two `equiv`s using `psum` in the domain and `sum` in the codomain.", "p": "mathlib"}, {"name": "equiv.perm.prod_extend_right_apply_ne", "description": "", "p": "mathlib"}, {"name": "equiv.sum_compl_apply_inr", "description": "", "p": "mathlib"}, {"name": "equiv.pi_equiv_subtype_sigma", "description": " The `pi`-type `\u03a0 i, \u03c0 i` is equivalent to the type of sections `f : \u03b9 \u2192 \u03a3 i, \u03c0 i` of the\n`sigma` type such that for all `i` we have `(f i).fst = i`.", "p": "mathlib"}, {"name": "equiv.sum_assoc_apply_inl_inl", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_curry", "description": " Dependent `curry` equivalence: the type of dependent functions on `\u03a3 i, \u03b2 i` is equivalent\nto the type of dependent functions of two arguments (i.e., functions to the space of functions).\n\nThis is `sigma.curry` and `sigma.uncurry` together as an equiv.", "p": "mathlib"}, {"name": "equiv.prod_sum_distrib", "description": "Type product is left distributive with respect to type sum up to an equivalence.", "p": "mathlib"}, {"name": "equiv.swap_comp_apply", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_prod_equiv_sigma_subtype", "description": "A subtype of a `prod` is equivalent to a sigma type whose fibers are subtypes.", "p": "mathlib"}, {"name": "equiv.sigma_fiber_equiv_symm_apply_snd_coe", "description": "", "p": "mathlib"}, {"name": "equiv.sum_prod_distrib", "description": "Type product is right distributive with respect to type sum up to an equivalence.", "p": "mathlib"}, {"name": "function.injective.swap_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_fiber_equiv_symm_apply_fst", "description": "", "p": "mathlib"}, {"name": "equiv.swap", "description": "`swap a b` is the permutation that swaps `a` and `b` and\n leaves other values as is.", "p": "mathlib"}, {"name": "equiv.perm.subtype_congr.left_apply_subtype", "description": "", "p": "mathlib"}, {"name": "subsingleton_prod_self_equiv", "description": "If `\u03b1` is a subsingleton, then it is equivalent to `\u03b1 \u00d7 \u03b1`.", "p": "mathlib"}, {"name": "equiv.sum_congr", "description": "If `\u03b1 \u2243 \u03b1'` and `\u03b2 \u2243 \u03b2'`, then `\u03b1 \u2295 \u03b2 \u2243 \u03b1' \u2295 \u03b2'`. This is `sum.map` as an equivalence.", "p": "mathlib"}, {"name": "equiv.sum_comm", "description": "Sum of types is commutative up to an equivalence. This is `sum.swap` as an equivalence.", "p": "mathlib"}, {"name": "equiv.prod_congr_left_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_sum_distrib_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.empty_prod", "description": "`empty` type is a left absorbing element for type product up to an equivalence.", "p": "mathlib"}, {"name": "equiv.pi_split_at_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.perm.sum_congr_symm", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_congr_left'", "description": "Transport dependent functions through an equivalence of the base space.", "p": "mathlib"}, {"name": "equiv.perm.sum_congr_refl_swap", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_prod_equiv_prod", "description": " A subtype of a product defined by componentwise conditions\nis equivalent to a product of subtypes.", "p": "mathlib"}, {"name": "equiv.Pi_congr'_symm_apply_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.option_is_some_equiv", "description": "The set of `x : option \u03b1` such that `is_some x` is equivalent to `\u03b1`.", "p": "mathlib"}, {"name": "equiv.subtype_subtype_equiv_subtype_exists_symm_apply_coe_coe", "description": "", "p": "mathlib"}, {"name": "equiv.punit_of_nonempty_of_subsingleton", "description": "A nonempty subsingleton type is (noncomputably) equivalent to `punit`.", "p": "mathlib"}, {"name": "equiv.sum_prod_distrib_apply_left", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_equiv_apply", "description": "", "p": "mathlib"}, {"name": "equiv.option_equiv_sum_punit", "description": "`option \u03b1` is equivalent to `\u03b1 \u2295 punit`", "p": "mathlib"}, {"name": "equiv.subtype_congr", "description": "Combines an `equiv` between two subtypes with an `equiv` between their complements to form a\n permutation.", "p": "mathlib"}, {"name": "equiv.sum_arrow_equiv_prod_arrow_symm_apply_inr", "description": "", "p": "mathlib"}, {"name": "equiv.swap_core_comm", "description": "", "p": "mathlib"}, {"name": "equiv.int_equiv_nat_sum_nat", "description": "The type of integer numbers is equivalent to `\u2115 \u2295 \u2115`.", "p": "mathlib"}, {"name": "equiv.perm.subtype_congr.right_apply_subtype", "description": "", "p": "mathlib"}, {"name": "equiv.unique_prod_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.pi_split_at", "description": "A product of types can be split as the binary product of one of the types and the product\n of all the remaining types.", "p": "mathlib"}, {"name": "equiv.symm_swap", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_congr'", "description": "Transport dependent functions through\nan equivalence of the base spaces and a family\nof equivalences of the matching fibres.", "p": "mathlib"}, {"name": "equiv.trans_swap_trans_symm", "description": "", "p": "mathlib"}, {"name": "equiv.of_fiber_equiv", "description": "A family of equivalences between fibers gives an equivalence between domains.", "p": "mathlib"}, {"name": "equiv.subtype_preimage_symm_apply_coe_pos", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_subtype_fiber_equiv", "description": " If a predicate `p : \u03b2 \u2192 Prop` is true on the range of a map `f : \u03b1 \u2192 \u03b2`, then\n`\u03a3 y : {y // p y}, {x // f x = y}` is equivalent to `\u03b1`.", "p": "mathlib"}, {"name": "equiv.swap_apply_def", "description": "", "p": "mathlib"}, {"name": "equiv.set_value", "description": "Augment an equivalence with a prescribed mapping `f a = b`", "p": "mathlib"}, {"name": "equiv.sum_arrow_equiv_prod_arrow_apply_fst", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_subtype_equiv_subtype_inter_symm_apply_coe_coe", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_univ_equiv_apply", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_sigma_equiv", "description": "A subtype of a sigma-type is a sigma-type over a subtype.", "p": "mathlib"}, {"name": "equiv.Pi_congr_apply_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sum_assoc_symm_apply_inr_inl", "description": "", "p": "mathlib"}, {"name": "equiv.swap_comm", "description": "", "p": "mathlib"}, {"name": "equiv.punit_prod_apply", "description": "", "p": "mathlib"}, {"name": "equiv.prod_assoc_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_equiv_prod_sigma_congr_right", "description": "", "p": "mathlib"}, {"name": "equiv.subtype_preimage", "description": " For a fixed function `x\u2080 : {a // p a} \u2192 \u03b2` defined on a subtype of `\u03b1`,\nthe subtype of functions `x : \u03b1 \u2192 \u03b2` that agree with `x\u2080` on the subtype `{a // p a}`\nis naturally equivalent to the type of functions `{a // \u00ac p a} \u2192 \u03b2`.", "p": "mathlib"}, {"name": "equiv.subtype_equiv", "description": " If `\u03b1` is equivalent to `\u03b2` and the predicates `p : \u03b1 \u2192 Prop` and `q : \u03b2 \u2192 Prop` are equivalent\nat corresponding points, then `{a // p a}` is equivalent to `{b // q b}`.\nFor the statement where `\u03b1 = \u03b2`, that is, `e : perm \u03b1`, see `perm.subtype_perm`.", "p": "mathlib"}, {"name": "equiv.subtype_subtype_equiv_subtype_exists_apply_coe", "description": "", "p": "mathlib"}, {"name": "function.injective.swap_comp", "description": "", "p": "mathlib"}, {"name": "equiv.coe_Pi_congr_symm", "description": "", "p": "mathlib"}, {"name": "equiv.swap_core_swap_core", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_congr_right", "description": " A family of equivalences `\u03a0 a, \u03b2\u2081 a \u2243 \u03b2\u2082 a` generates an equivalence between `\u03a0 a, \u03b2\u2081 a` and\n`\u03a0 a, \u03b2\u2082 a`.", "p": "mathlib"}, {"name": "equiv.prod_sum_distrib_apply_left", "description": "", "p": "mathlib"}, {"name": "equiv.pi_split_at_apply", "description": "", "p": "mathlib"}, {"name": "equiv.sigma_fiber_equiv", "description": " `sigma_fiber_equiv f` for `f : \u03b1 \u2192 \u03b2` is the natural equivalence between\nthe type of all fibres of `f` and the total space `\u03b1`.", "p": "mathlib"}, {"name": "equiv.swap_swap", "description": "", "p": "mathlib"}, {"name": "equiv.pprod_prod", "description": "Combine two equivalences using `pprod` in the domain and `prod` in the codomain.", "p": "mathlib"}, {"name": "equiv.swap_apply_ne_self_iff", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_congr", "description": "Transport dependent functions through\nan equivalence of the base spaces and a family\nof equivalences of the matching fibers.", "p": "mathlib"}, {"name": "equiv.prod_prod_prod_comm", "description": "Four-way commutativity of `prod`. The name matches `mul_mul_mul_comm`.", "p": "mathlib"}, {"name": "equiv.of_bijective_apply", "description": "", "p": "mathlib"}, {"name": "equiv.prod_unique_apply", "description": "", "p": "mathlib"}, {"name": "equiv.bool_arrow_equiv_prod_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.Pi_congr_left'_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.pprod_congr_apply", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.comap_apply", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.comap", "description": "Given an algebra hom `f : mv_polynomial \u03c3 R \u2192\u2090[R] mv_polynomial \u03c4 R`\nand a variable evaluation `v : \u03c4 \u2192 R`,\n`comap f v` produces a variable evaluation `\u03c3 \u2192 R`.", "p": "mathlib"}, {"name": "mv_polynomial.comap_equiv_coe", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.comap_rename", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.comap_id_apply", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.comap_equiv", "description": "If two polynomial types over the same coefficient ring `R` are equivalent,\nthere is a bijection between the types of functions from their variable types to `R`.", "p": "mathlib"}, {"name": "mv_polynomial.comap_equiv_symm_coe", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.comap_comp", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.comap_id", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.comap_eq_id_of_eq_id", "description": "", "p": "mathlib"}, {"name": "mv_polynomial.comap_comp_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.comp_reflects_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limit_of_nat_iso", "description": "Transfer reflection of a limit along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limit_of_iso_diagram", "description": "Transfer preservation of limits along a natural isomorphism in the diagram.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_shape_of_reflects_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_nat_iso", "description": "Transfer preservation of colimits along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_nat_iso", "description": "Transfer reflection of colimits along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.comp_reflects_colimits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimit", "description": "A functor `F : C \u2964 D` reflects colimits for `K : J \u2964 C` if\nwhenever the image of a cocone over `K` under `F` is a colimit cocone in `D`,\nthe cocone was already a colimit cocone in `C`.\nNote that we do not assume a priori that `D` actually has any colimits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimit.reflects", "description": "A functor `F : C \u2964 D` reflects colimits for `K : J \u2964 C` if\nwhenever the image of a cocone over `K` under `F` is a colimit cocone in `D`,\nthe cocone was already a colimit cocone in `C`.\nNote that we do not assume a priori that `D` actually has any colimits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_shape_of_reflects_isomorphisms", "description": "If `C` has limits of shape `J` and `G` preserves them, then if `G` reflects isomorphisms then it\nreflects limits of shape `J`.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimit_of_reflects_colimits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_shape_of_equiv", "description": "Transfer preservation of limits along a equivalence in the shape.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_shape_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limit_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimit_of_reflects_of_preserves", "description": " If `F \u22d9 G` preserves colimits for `K`, and `G` reflects colimits for `K \u22d9 F`,\nthen `F` preserves colimits for `K`.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limit", "description": "A functor `F : C \u2964 D` reflects limits for `K : J \u2964 C` if\nwhenever the image of a cone over `K` under `F` is a limit cone in `D`,\nthe cone was already a limit cone in `C`.\nNote that we do not assume a priori that `D` actually has any limits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limit.reflects", "description": "A functor `F : C \u2964 D` reflects limits for `K : J \u2964 C` if\nwhenever the image of a cone over `K` under `F` is a limit cone in `D`,\nthe cone was already a limit cone in `C`.\nNote that we do not assume a priori that `D` actually has any limits.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_shape", "description": "We say that `F` preserves colimits of shape `J` if `F` preserves colimits for every diagram\n   `K : J \u2964 C`, i.e., `F` maps colimit cocones over `K` to colimit cocones.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_shape.preserves_colimit", "description": "We say that `F` preserves colimits of shape `J` if `F` preserves colimits for every diagram\n   `K : J \u2964 C`, i.e., `F` maps colimit cocones over `K` to colimit cocones.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_shape_of_reflects_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimit_of_reflects_isomorphisms", "description": "If the colimit of `F` exists and `G` preserves it, then if `G` reflects isomorphisms then it\nreflects the colimit of `F`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_size_shrink", "description": "`preserves_limits_of_size_shrink.{w w'} F` tries to obtain `preserves_limits_of_size.{w w'} F`\nfrom some other `preserves_limits_of_size F`.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_reflects_isomorphisms", "description": "If `C` has limits and `G` preserves limits, then if `G` reflects isomorphisms then it reflects\nlimits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_shape_of_reflects_isomorphisms", "description": "If `C` has colimits of shape `J` and `G` preserves them, then if `G` reflects isomorphisms then it\nreflects colimits of shape `J`.", "p": "mathlib"}, {"name": "category_theory.limits.fully_faithful_reflects_limits", "description": "A fully faithful functor reflects limits.", "p": "mathlib"}, {"name": "category_theory.limits.comp_preserves_colimits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limit_of_preserves_limit_cone", "description": "If F preserves one limit cone for the diagram K,\n then it preserves any limit cone for K.", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_of_preserves", "description": "A convenience function for `preserves_colimit`, which takes the functor as an explicit argument to\nguide typeclass resolution.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_reflects_of_preserves", "description": "If `F \u22d9 G` preserves limits and `G` reflects limits, then `F` preserves limits.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limit_of_reflects_of_preserves", "description": " If `F \u22d9 G` preserves limits for `K`, and `G` reflects limits for `K \u22d9 F`,\nthen `F` preserves limits for `K`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_shape_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_reflects_of_preserves", "description": "If `F \u22d9 G` preserves colimits and `G` reflects colimits, then `F` preserves colimits.", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_of_reflects", "description": "A convenience function for `reflects_colimit`, which takes the functor as an explicit argument to\nguide typeclass resolution.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_size_shrink", "description": "`reflects_colimits_of_size_shrink.{w w'} F` tries to obtain `reflects_colimits_of_size.{w w'} F`\nfrom some other `reflects_colimits_of_size F`.", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_of_reflects", "description": "A convenience function for `reflects_limit`, which takes the functor as an explicit argument to\nguide typeclass resolution.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimit_of_preserves_colimit_cocone", "description": "If F preserves one colimit cocone for the diagram K,\n then it preserves any colimit cocone for K.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_smallest_limits_of_reflects_limits", "description": "Reflecting limits at any universe implies reflecting limits at universe `0`.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_shape_of_equiv", "description": "Transfer reflection of limits along a equivalence in the shape.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limit_of_reflects_limits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.comp_preserves_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_size_shrink", "description": "`preserves_colimits_of_size_shrink.{w w'} F` tries to obtain `preserves_colimits_of_size.{w w'} F`\nfrom some other `preserves_colimits_of_size F`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limit_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.comp_reflects_limit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_size", "description": " `preserves_colimits_of_size.{v u} F` means that `F` sends all colimit cocones over any\ndiagram `J \u2964 C` to colimit cocones, where `J : Type u` with `[category.{v} J]`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_size.preserves_colimits_of_shape", "description": " `preserves_colimits_of_size.{v u} F` means that `F` sends all colimit cocones over any\ndiagram `J \u2964 C` to colimit cocones, where `J : Type u` with `[category.{v} J]`.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limit_of_reflects_isomorphisms", "description": "If the limit of `F` exists and `G` preserves it, then if `G` reflects isomorphisms then it\nreflects the limit of `F`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimit", "description": "A functor `F` preserves colimits of `K` (written as `preserves_colimit K F`)\nif `F` maps any colimit cocone over `K` to a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimit.preserves", "description": "A functor `F` preserves colimits of `K` (written as `preserves_colimit K F`)\nif `F` maps any colimit cocone over `K` to a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.id_preserves_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_shape_of_equiv", "description": "Transfer preservation of colimits along a equivalence in the shape.", "p": "mathlib"}, {"name": "category_theory.limits.comp_preserves_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_shape", "description": "We say that `F` preserves limits of shape `J` if `F` preserves limits for every diagram\n   `K : J \u2964 C`, i.e., `F` maps limit cones over `K` to limit cones.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_shape.preserves_limit", "description": "We say that `F` preserves limits of shape `J` if `F` preserves limits for every diagram\n   `K : J \u2964 C`, i.e., `F` maps limit cones over `K` to limit cones.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_size", "description": "A functor `F : C \u2964 D` reflects colimits if\nwhenever the image of a cocone over some `K : J \u2964 C` under `F` is a colimit cocone in `D`,\nthe cocone was already a colimit cocone in `C`.\nNote that we do not assume a priori that `D` actually has any colimits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_size.reflects_colimits_of_shape", "description": "A functor `F : C \u2964 D` reflects colimits if\nwhenever the image of a cocone over some `K : J \u2964 C` under `F` is a colimit cocone in `D`,\nthe cocone was already a colimit cocone in `C`.\nNote that we do not assume a priori that `D` actually has any colimits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimit_of_iso_diagram", "description": "Transfer reflection of colimits along a natural isomorphism in the diagram.", "p": "mathlib"}, {"name": "category_theory.limits.comp_reflects_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_shape", "description": "A functor `F : C \u2964 D` reflects colimits of shape `J` if\nwhenever the image of a cocone over some `K : J \u2964 C` under `F` is a colimit cocone in `D`,\nthe cocone was already a colimit cocone in `C`.\nNote that we do not assume a priori that `D` actually has any colimits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_shape.reflects_colimit", "description": "A functor `F : C \u2964 D` reflects colimits of shape `J` if\nwhenever the image of a cocone over some `K : J \u2964 C` under `F` is a colimit cocone in `D`,\nthe cocone was already a colimit cocone in `C`.\nNote that we do not assume a priori that `D` actually has any colimits.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimit_of_iso_diagram", "description": "Transfer preservation of colimits along a natural isomorphism in the shape.", "p": "mathlib"}, {"name": "category_theory.limits.comp_preserves_colimit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_smallest_limits_of_preserves_limits", "description": "Preserving limits at any universe level implies preserving limits in universe `0`.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_shape", "description": "A functor `F : C \u2964 D` reflects limits of shape `J` if\nwhenever the image of a cone over some `K : J \u2964 C` under `F` is a limit cone in `D`,\nthe cone was already a limit cone in `C`.\nNote that we do not assume a priori that `D` actually has any limits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_shape.reflects_limit", "description": "A functor `F : C \u2964 D` reflects limits of shape `J` if\nwhenever the image of a cone over some `K : J \u2964 C` under `F` is a limit cone in `D`,\nthe cone was already a limit cone in `C`.\nNote that we do not assume a priori that `D` actually has any limits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_reflects_isomorphisms", "description": "If `C` has colimits and `G` preserves colimits, then if `G` reflects isomorphisms then it reflects\ncolimits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits", "description": "A functor `F : C \u2964 D` reflects (small) limits if\nwhenever the image of a cone over some `K : J \u2964 C` under `F` is a limit cone in `D`,\nthe cone was already a limit cone in `C`.\nNote that we do not assume a priori that `D` actually has any limits.", "p": "mathlib"}, {"name": "category_theory.limits.fully_faithful_reflects_colimits", "description": "A fully faithful functor reflects colimits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimit_of_nat_iso", "description": "Transfer reflection of a colimit along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_shape_of_nat_iso", "description": "Transfer reflection of limits of shape along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_size_shrink", "description": "`reflects_limits_of_size_shrink.{w w'} F` tries to obtain `reflects_limits_of_size.{w w'} F`\nfrom some other `reflects_limits_of_size F`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits", "description": " We say that `F` preserves (small) limits if it sends small\nlimit cones over any diagram to limit cones.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimit_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_shape_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limit_of_nat_iso", "description": "Transfer preservation of a limit along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limit", "description": "A functor `F` preserves limits of `K` (written as `preserves_limit K F`)\nif `F` maps any limit cone over `K` to a limit cone.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limit.preserves", "description": "A functor `F` preserves limits of `K` (written as `preserves_limit K F`)\nif `F` maps any limit cone over `K` to a limit cone.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimit_of_nat_iso", "description": "Transfer preservation of a colimit along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_shape_of_equiv", "description": "Transfer reflection of colimits along a equivalence in the shape.", "p": "mathlib"}, {"name": "category_theory.limits.comp_reflects_colimit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.comp_preserves_limit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_nat_iso", "description": "Transfer preservation of limits along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.id_reflects_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.comp_preserves_limits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limit_of_iso_diagram", "description": "Transfer reflection of limits along a natural isomorphism in the diagram.", "p": "mathlib"}, {"name": "category_theory.limits.id_reflects_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_smallest_colimits_of_preserves_colimits", "description": "Preserving colimits at any universe implies preserving colimits at universe `0`.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_nat_iso", "description": "Transfer reflection of limits along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimit_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.comp_reflects_limits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits", "description": " We say that `F` preserves (small) limits if it sends small\nlimit cones over any diagram to limit cones.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_smallest_colimits_of_reflects_colimits", "description": "Reflecting colimits at any universe implies reflecting colimits at universe `0`.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_size", "description": "A functor `F : C \u2964 D` reflects limits if\nwhenever the image of a cone over some `K : J \u2964 C` under `F` is a limit cone in `D`,\nthe cone was already a limit cone in `C`.\nNote that we do not assume a priori that `D` actually has any limits.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_limits_of_size.reflects_limits_of_shape", "description": "A functor `F : C \u2964 D` reflects limits if\nwhenever the image of a cone over some `K : J \u2964 C` under `F` is a limit cone in `D`,\nthe cone was already a limit cone in `C`.\nNote that we do not assume a priori that `D` actually has any limits.", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_of_preserves", "description": "A convenience function for `preserves_limit`, which takes the functor as an explicit argument to\nguide typeclass resolution.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_shape_of_reflects_of_preserves", "description": "If `F \u22d9 G` preserves colimits of shape `J` and `G` reflects colimits of shape `J`, then `F`\npreserves colimits of shape `J`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_shape_of_nat_iso", "description": "Transfer preservation of limits of shape along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_shape_of_reflects_of_preserves", "description": "If `F \u22d9 G` preserves limits of shape `J` and `G` reflects limits of shape `J`, then `F` preserves\nlimits of shape `J`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_shape_of_nat_iso", "description": "Transfer preservation of colimits of shape along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_shape_of_nat_iso", "description": "Transfer reflection of colimits of shape along a natural isomorphism in the functor.", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits_of_shape_subsingleton", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.reflects_colimits", "description": "A functor `F : C \u2964 D` reflects (small) colimits if\nwhenever the image of a cocone over some `K : J \u2964 C` under `F` is a colimit cocone in `D`,\nthe cocone was already a colimit cocone in `C`.\nNote that we do not assume a priori that `D` actually has any colimits.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_size", "description": " `preserves_limits_of_size.{v u} F` means that `F` sends all limit cones over any\ndiagram `J \u2964 C` to limit cones, where `J : Type u` with `[category.{v} J]`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_size.preserves_limits_of_shape", "description": " `preserves_limits_of_size.{v u} F` means that `F` sends all limit cones over any\ndiagram `J \u2964 C` to limit cones, where `J : Type u` with `[category.{v} J]`.", "p": "mathlib"}, {"name": "category_theory.limits.id_preserves_limits", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.ae_eq_of_forall_set_integral_eq'", "description": "**Uniqueness of the conditional expectation**", "p": "mathlib"}, {"name": "measure_theory.integral_norm_le_of_forall_fin_meas_integral_eq", "description": " Let `m` be a sub-\u03c3-algebra of `m0`, `f` a `m0`-measurable function and `g` a `m`-measurable\nfunction, such that their integrals coincide on `m`-measurable sets with finite measure.\nThen `\u222b x in s, \u2016g x\u2016 \u2202\u03bc \u2264 \u222b x in s, \u2016f x\u2016 \u2202\u03bc` on all `m`-measurable sets with finite measure.", "p": "mathlib"}, {"name": "measure_theory.Lp_meas.ae_eq_zero_of_forall_set_integral_eq_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_nnnorm_le_of_forall_fin_meas_integral_eq", "description": " Let `m` be a sub-\u03c3-algebra of `m0`, `f` a `m0`-measurable function and `g` a `m`-measurable\nfunction, such that their integrals coincide on `m`-measurable sets with finite measure.\nThen `\u222b\u207b x in s, \u2016g x\u2016\u208a \u2202\u03bc \u2264 \u222b\u207b x in s, \u2016f x\u2016\u208a \u2202\u03bc` on all `m`-measurable sets with finite\nmeasure.", "p": "mathlib"}, {"name": "measure_theory.ae_eq_of_forall_set_integral_eq_of_sigma_finite'", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp.ae_eq_zero_of_forall_set_integral_eq_zero'", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.t0_space", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.le_vanishing_ideal_zero_locus", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.image_comap_zero_locus_eq_zero_locus_comap", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.closeds_embedding", "description": "The antitone order embedding of closed subsets of `Spec R` into ideals of `R`.", "p": "mathlib"}, {"name": "prime_spectrum.basic_open_mul", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_irreducible_zero_locus_iff_of_radical", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.localization_away_comap_range", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.localization_comap_embedding", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.closure_singleton", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_radical_vanishing_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.mem_vanishing_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_anti_mono_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.unique", "description": "", "p": "mathlib"}, {"name": "prime_spectrum", "description": " The prime spectrum of a commutative ring `R` is the type of all prime ideals of `R`.\n\nIt is naturally endowed with a topology (the Zariski topology),\nand a sheaf of commutative rings (see `algebraic_geometry.structure_sheaf`).\nIt is a fundamental building block in algebraic geometry.", "p": "mathlib"}, {"name": "prime_spectrum.as_ideal", "description": " The prime spectrum of a commutative ring `R` is the type of all prime ideals of `R`.\n\nIt is naturally endowed with a topology (the Zariski topology),\nand a sheaf of commutative rings (see `algebraic_geometry.structure_sheaf`).\nIt is a fundamental building block in algebraic geometry.", "p": "mathlib"}, {"name": "prime_spectrum.is_prime", "description": " The prime spectrum of a commutative ring `R` is the type of all prime ideals of `R`.\n\nIt is naturally endowed with a topology (the Zariski topology),\nand a sheaf of commutative rings (see `algebraic_geometry.structure_sheaf`).\nIt is a fundamental building block in algebraic geometry.", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_subset_zero_locus_singleton_iff", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.basic_open_mul_le_right", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.nhds_order_embedding", "description": "`nhds` as an order embedding.", "p": "mathlib"}, {"name": "prime_spectrum.gc_set", "description": "`zero_locus` and `vanishing_ideal` form a galois connection.", "p": "mathlib"}, {"name": "prime_spectrum.is_irreducible_iff_vanishing_ideal_is_prime", "description": "", "p": "mathlib"}, {"name": "local_ring.closed_point", "description": "The closed point in the prime spectrum of a local ring.", "p": "mathlib"}, {"name": "prime_spectrum.range_comap_of_surjective", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_mul", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_basis_basic_opens", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.as_ideal_le_as_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.ext", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.localization_comap_injective", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.basic_open_mul_le_left", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.localization_map_of_specializes", "description": " If `x` specializes to `y`, then there is a natural map from the localization of `y` to the\nlocalization of `x`.", "p": "mathlib"}, {"name": "prime_spectrum.partial_order", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.comap_comp", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.sup_vanishing_ideal_le", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.quasi_sober", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.localization_comap_inducing", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.t1_space_iff_is_field", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.subset_zero_locus_vanishing_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.localization_away_open_embedding", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.vanishing_ideal_singleton", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.mem_compl_zero_locus_iff_not_mem", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_closed_iff_zero_locus", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.union_zero_locus", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_span", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.mem_basic_open", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.basic_open_zero", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_closed_zero_locus", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.basic_open_eq_zero_locus_compl", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.coe_vanishing_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.basic_open_eq_bot_iff", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_supr", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.localization_comap_range", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.vanishing_ideal", "description": " The vanishing ideal of a set `t` of points of the prime spectrum of a commutative ring `R` is\nthe intersection of all the prime ideals in the set `t`.\n\nAn element `f` of `R` can be thought of as a dependent function on the prime spectrum of `R`.\nAt a point `x` (a prime ideal) the function (i.e., element) `f` takes values in the quotient ring\n`R` modulo the prime ideal `x`. In this manner, `vanishing_ideal t` is exactly the ideal of `R`\nconsisting of all \"functions\" that vanish on all of `t`.", "p": "mathlib"}, {"name": "prime_spectrum.le_iff_specializes", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_vanishing_ideal_eq_closure", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_closed_range_comap_of_surjective", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.preimage_comap_zero_locus", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.prime_spectrum_prod", "description": " The prime spectrum of `R \u00d7 S` is in bijection with the disjoint unions of the prime spectrum of\n`R` and the prime spectrum of `S`.", "p": "mathlib"}, {"name": "prime_spectrum.subset_zero_locus_iff_le_vanishing_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_closed_iff_zero_locus_radical_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.gc", "description": "`zero_locus` and `vanishing_ideal` form a galois connection.", "p": "mathlib"}, {"name": "prime_spectrum.zariski_topology", "description": " The Zariski topology on the prime spectrum of a commutative ring is defined via the closed sets\nof the topology: they are exactly those sets that are the zero locus of a subset of the ring.", "p": "mathlib"}, {"name": "prime_spectrum.basic_open_one", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.comap_residue", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.preimage_comap_zero_locus_aux", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_singleton_pow", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_empty", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.basic_open_pow", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_closed_iff_zero_locus_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_univ", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_empty_iff_eq_top", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_union", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.vanishing_ideal_zero_locus_eq_radical", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_empty_of_one_mem", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_radical", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.le_iff_mem_closure", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.prime_spectrum_prod_of_sum", "description": "The map from the direct sum of prime spectra to the prime spectrum of a direct product.", "p": "mathlib"}, {"name": "prime_spectrum.as_ideal_lt_as_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_subset_zero_locus_iff", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.comap_injective_of_surjective", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.vanishing_ideal_Union", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_topological_basis_basic_opens", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_singleton_zero", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.basic_open_le_basic_open_iff", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.order_bot", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.vanishing_ideal_strict_anti_mono_iff", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.basic_open", "description": "`basic_open r` is the open subset containing all prime ideals not containing `r`.", "p": "mathlib"}, {"name": "prime_spectrum.comap", "description": " The function between prime spectra of commutative rings induced by a ring homomorphism.\nThis function is continuous.", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_sup", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_bUnion", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.comap_id", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus", "description": " The zero locus of a set `s` of elements of a commutative ring `R` is the set of all prime ideals\nof the ring that contain the set `s`.\n\nAn element `f` of `R` can be thought of as a dependent function on the prime spectrum of `R`.\nAt a point `x` (a prime ideal) the function (i.e., element) `f` takes values in the quotient ring\n`R` modulo the prime ideal `x`. In this manner, `zero_locus s` is exactly the subset of\n`prime_spectrum R` where all \"functions\" in `s` vanish simultaneously.", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_inf", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.vanishing_ideal_anti_mono_iff", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.prime_spectrum_prod_symm_inl_as_ideal", "description": "", "p": "mathlib"}, {"name": "local_ring.closed_point_mem_iff", "description": "", "p": "mathlib"}, {"name": "local_ring.specializes_closed_point", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.zero_locus_anti_mono", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.punit", "description": "The prime spectrum of the zero ring is empty.", "p": "mathlib"}, {"name": "prime_spectrum.prime_spectrum_prod_symm_inr_as_ideal", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.is_open_iff", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.vanishing_ideal_eq_top_iff", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.vanishing_ideal_univ", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.irreducible_space", "description": "", "p": "mathlib"}, {"name": "prime_spectrum.nonempty", "description": "", "p": "mathlib"}, {"