is_unit.filter", "description": "", "p": "mathlib"}, {"name": "filter.tendsto_zero", "description": "", "p": "mathlib"}, {"name": "filter.mem_neg", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot.of_smul_filter", "description": "", "p": "mathlib"}, {"name": "filter.add_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "filter.mul_bot", "description": "", "p": "mathlib"}, {"name": "filter.add_monoid", "description": "`filter \u03b1` is an `add_monoid` under pointwise operations if `\u03b1` is.", "p": "mathlib"}, {"name": "filter.pure_add_hom", "description": "The singleton operation as an `add_hom`.", "p": "mathlib"}, {"name": "filter.has_vsub", "description": "The filter `f -\u1d65 g` is generated by `{s -\u1d65 t | s \u2208 f, t \u2208 g}` in locale `pointwise`.", "p": "mathlib"}, {"name": "filter.inv_le_inv_iff", "description": "", "p": "mathlib"}, {"name": "filter.smul_le_smul_left", "description": "", "p": "mathlib"}, {"name": "filter.sub_bot", "description": "", "p": "mathlib"}, {"name": "filter.smul_comm_class_filter''", "description": "", "p": "mathlib"}, {"name": "filter.pure_one", "description": "", "p": "mathlib"}, {"name": "filter.one_le_div_iff", "description": "", "p": "mathlib"}, {"name": "filter.mem_div", "description": "", "p": "mathlib"}, {"name": "filter.pure_add_monoid_hom", "description": "`pure` as an `add_monoid_hom`.", "p": "mathlib"}, {"name": "filter.add_top_of_nonneg", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot.vsub", "description": "", "p": "mathlib"}, {"name": "filter.mul_add_subset", "description": "", "p": "mathlib"}, {"name": "filter.has_involutive_inv", "description": "Inversion is involutive on `filter \u03b1` if it is on `\u03b1`.", "p": "mathlib"}, {"name": "filter.smul_filter_bot", "description": "", "p": "mathlib"}, {"name": "filter.zero_ne_bot", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot.smul_filter", "description": "", "p": "mathlib"}, {"name": "filter.pure_smul", "description": "", "p": "mathlib"}, {"name": "filter.mem_mul", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.sub_sub", "description": "", "p": "mathlib"}, {"name": "filter.is_scalar_tower''", "description": "", "p": "mathlib"}, {"name": "filter.coe_pure_one_hom", "description": "", "p": "mathlib"}, {"name": "filter.le_vsub_iff", "description": "", "p": "mathlib"}, {"name": "filter.mul_one_class", "description": "`filter \u03b1` is a `mul_one_class` under pointwise operations if `\u03b1` is.", "p": "mathlib"}, {"name": "filter.coe_pure_monoid_hom", "description": "", "p": "mathlib"}, {"name": "filter.map_zero'", "description": "", "p": "mathlib"}, {"name": "filter.neg_mem_neg", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot.of_vadd_filter", "description": "", "p": "mathlib"}, {"name": "filter.covariant_mul", "description": "", "p": "mathlib"}, {"name": "filter.add_mul_subset", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot.add", "description": "", "p": "mathlib"}, {"name": "filter.monoid", "description": "`filter \u03b1` is a `monoid` under pointwise operations if `\u03b1` is.", "p": "mathlib"}, {"name": "filter.bot_pow", "description": "", "p": "mathlib"}, {"name": "filter.map_monoid_hom", "description": " If `\u03c6 : \u03b1 \u2192* \u03b2` then `map_monoid_hom \u03c6` is the monoid homomorphism\n`filter \u03b1 \u2192* filter \u03b2` induced by `map \u03c6`.", "p": "mathlib"}, {"name": "filter.ne_bot.of_mul_left", "description": "", "p": "mathlib"}, {"name": "filter.le_one_iff", "description": "", "p": "mathlib"}, {"name": "filter.map\u2082_add", "description": "", "p": "mathlib"}, {"name": "filter.vsub_le_vsub_right", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot_neg_iff", "description": "", "p": "mathlib"}, {"name": "filter.map_add", "description": "", "p": "mathlib"}, {"name": "filter.map\u2082_div", "description": "", "p": "mathlib"}, {"name": "filter.has_div", "description": "The filter `f / g` is generated by `{s / t | s \u2208 f, t \u2208 g}` in locale `pointwise`.", "p": "mathlib"}, {"name": "filter.mem_one", "description": "", "p": "mathlib"}, {"name": "filter.pure_add_hom_apply", "description": "", "p": "mathlib"}, {"name": "filter.top_pow", "description": "", "p": "mathlib"}, {"name": "filter.comap_mul_comap_le", "description": "", "p": "mathlib"}, {"name": "filter.mem_vadd_filter", "description": "", "p": "mathlib"}, {"name": "filter.inv_mem_inv", "description": "", "p": "mathlib"}, {"name": "filter.sub_pure", "description": "", "p": "mathlib"}, {"name": "filter.pure_mul_hom", "description": "`pure` operation as a `mul_hom`.", "p": "mathlib"}, {"name": "filter.vadd_filter_bot", "description": "", "p": "mathlib"}, {"name": "filter.has_zsmul", "description": " Repeated pointwise addition/subtraction (not the same as pointwise repeated\naddition/subtraction!) of a `filter`. See Note [pointwise nat action].", "p": "mathlib"}, {"name": "filter.vadd_le_vadd", "description": "", "p": "mathlib"}, {"name": "filter.vsub_mem_vsub", "description": "", "p": "mathlib"}, {"name": "filter.mul_eq_bot_iff", "description": "", "p": "mathlib"}, {"name": "filter.smul_bot", "description": "", "p": "mathlib"}, {"name": "filter.covariant_swap_mul", "description": "", "p": "mathlib"}, {"name": "filter.has_neg", "description": "The negation of a filter is the pointwise preimage under `-` of its sets.", "p": "mathlib"}, {"name": "filter.ne_bot.zero_smul_nonneg", "description": "", "p": "mathlib"}, {"name": "filter.vsub_le_vsub_left", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot.div_zero_nonneg", "description": "", "p": "mathlib"}, {"name": "filter.map_inv'", "description": "", "p": "mathlib"}, {"name": "is_add_unit.filter", "description": "", "p": "mathlib"}, {"name": "filter.vsub_ne_bot_iff", "description": "", "p": "mathlib"}, {"name": "filter.map_vadd", "description": "", "p": "mathlib"}, {"name": "filter.smul_set_mem_smul_filter", "description": "", "p": "mathlib"}, {"name": "filter.neg_pure", "description": "", "p": "mathlib"}, {"name": "filter.coe_pure_mul_hom", "description": "", "p": "mathlib"}, {"name": "filter.zero_smul_filter", "description": "", "p": "mathlib"}, {"name": "filter.map_zero", "description": "", "p": "mathlib"}, {"name": "filter.mem_add", "description": "", "p": "mathlib"}, {"name": "filter.ne_bot.zero_mul_nonneg", "description": "", "p": "mathlib"}, {"name": "filter.vadd_comm_class_filter'", "description": "", "p": "mathlib"}, {"name": "filter.top_add_of_nonneg", "description": "", "p": "mathlib"}, {"name": "filter.add_mem_add", "description": "", "p": "mathlib"}, {"name": "filter.le_smul_iff", "description": "", "p": "mathlib"}, {"name": "filter.zero_smul_filter_nonpos", "description": "", "p": "mathlib"}, {"name": "filter.vsub_le_vsub", "description": "", "p": "mathlib"}, {"name": "filter.div_eq_bot_iff", "description": "", "p": "mathlib"}, {"name": "filter.smul_mem_smul", "description": "", "p": "mathlib"}, {"name": "filter.covariant_smul", "description": "", "p": "mathlib"}, {"name": "filter.inv_eq_bot_iff", "description": "", "p": "mathlib"}, {"name": "has_groupoid_of_le", "description": "", "p": "mathlib"}, {"name": "open_embedding.singleton_has_groupoid", "description": "", "p": "mathlib"}, {"name": "charted_space.ext", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.inhabited", "description": "", "p": "mathlib"}, {"name": "structure_groupoid", "description": " A structure groupoid is a set of local homeomorphisms of a topological space stable under\ncomposition and inverse. They appear in the definition of the smoothness class of a manifold.", "p": "mathlib"}, {"name": "structure_groupoid.members", "description": " A structure groupoid is a set of local homeomorphisms of a topological space stable under\ncomposition and inverse. They appear in the definition of the smoothness class of a manifold.", "p": "mathlib"}, {"name": "structure_groupoid.trans'", "description": " A structure groupoid is a set of local homeomorphisms of a topological space stable under\ncomposition and inverse. They appear in the definition of the smoothness class of a manifold.", "p": "mathlib"}, {"name": "structure_groupoid.symm'", "description": " A structure groupoid is a set of local homeomorphisms of a topological space stable under\ncomposition and inverse. They appear in the definition of the smoothness class of a manifold.", "p": "mathlib"}, {"name": "structure_groupoid.id_mem'", "description": " A structure groupoid is a set of local homeomorphisms of a topological space stable under\ncomposition and inverse. They appear in the definition of the smoothness class of a manifold.", "p": "mathlib"}, {"name": "structure_groupoid.locality'", "description": " A structure groupoid is a set of local homeomorphisms of a topological space stable under\ncomposition and inverse. They appear in the definition of the smoothness class of a manifold.", "p": "mathlib"}, {"name": "structure_groupoid.eq_on_source'", "description": " A structure groupoid is a set of local homeomorphisms of a topological space stable under\ncomposition and inverse. They appear in the definition of the smoothness class of a manifold.", "p": "mathlib"}, {"name": "library_note.Manifold type tags", "description": " For technical reasons we introduce two type tags:\n\n* `model_prod H H'` is the same as `H \u00d7 H'`;\n* `model_pi H` is the same as `\u03a0 i, H i`, where `H : \u03b9 \u2192 Type*` and `\u03b9` is a finite type.\n\nIn both cases the reason is the same, so we explain it only in the case of the product. A charted\nspace `M` with model `H` is a set of local charts from `M` to `H` covering the space. Every space is\nregistered as a charted space over itself, using the only chart `id`, in `manifold_model_space`. You\ncan also define a product of charted space `M` and `M'` (with model space `H \u00d7 H'`) by taking the\nproducts of the charts. Now, on `H \u00d7 H'`, there are two charted space structures with model space\n`H \u00d7 H'` itself, the one coming from `manifold_model_space`, and the one coming from the product of\nthe two `manifold_model_space` on each component. They are equal, but not defeq (because the product\nof `id` and `id` is not defeq to `id`), which is bad as we know. This expedient of renaming `H \u00d7 H'`\nsolves this problem.", "p": "mathlib"}, {"name": "has_groupoid", "description": " A charted space has an atlas in a groupoid `G` if the change of coordinates belong to the\ngroupoid", "p": "mathlib"}, {"name": "has_groupoid.compatible", "description": " A charted space has an atlas in a groupoid `G` if the change of coordinates belong to the\ngroupoid", "p": "mathlib"}, {"name": "chart_source_mem_nhds", "description": "", "p": "mathlib"}, {"name": "charted_space.locally_connected_space", "description": " If a topological space admits an atlas with locally connected charts, then the space itself is\nlocally connected.", "p": "mathlib"}, {"name": "has_groupoid_of_pregroupoid", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.singleton_charted_space_chart_at_eq", "description": "", "p": "mathlib"}, {"name": "continuous_groupoid.closed_under_restriction", "description": "The groupoid of all local homeomorphisms on a topological space `H` is closed under restriction.", "p": "mathlib"}, {"name": "prod_charted_space", "description": " The product of two charted spaces is naturally a charted space, with the canonical\nconstruction of the atlas of product maps.", "p": "mathlib"}, {"name": "id_groupoid", "description": " The trivial groupoid, containing only the identity (and maps with empty source, as this is\nnecessary from the definition)", "p": "mathlib"}, {"name": "charted_space.ext_iff", "description": "", "p": "mathlib"}, {"name": "closed_under_restriction'", "description": "", "p": "mathlib"}, {"name": "groupoid_of_pregroupoid_le", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.locality", "description": "", "p": "mathlib"}, {"name": "chart_at_self_eq", "description": "In the model space, chart_at is always the identity", "p": "mathlib"}, {"name": "continuous_pregroupoid", "description": "The pregroupoid of all local maps on a topological space `H`", "p": "mathlib"}, {"name": "structomorph.trans", "description": "The composition of structomorphisms is a structomorphism", "p": "mathlib"}, {"name": "mem_groupoid_of_pregroupoid", "description": "", "p": "mathlib"}, {"name": "closed_under_restriction_iff_id_le", "description": " A groupoid is closed under restriction if and only if it contains the trivial restriction-closed\ngroupoid.", "p": "mathlib"}, {"name": "closed_under_restriction_id_restr_groupoid", "description": "The trivial restriction-closed groupoid is indeed `closed_under_restriction`.", "p": "mathlib"}, {"name": "topological_space.opens.has_groupoid", "description": " If a groupoid `G` is `closed_under_restriction`, then an open subset of a space which is\n`has_groupoid G` is naturally `has_groupoid G`.", "p": "mathlib"}, {"name": "continuous_groupoid", "description": "The groupoid of all local homeomorphisms on a topological space `H`", "p": "mathlib"}, {"name": "model_prod.topological_space", "description": "", "p": "mathlib"}, {"name": "id_restr_groupoid_mem", "description": "", "p": "mathlib"}, {"name": "prod_charted_space_chart_at", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.trans", "description": "", "p": "mathlib"}, {"name": "model_pi", "description": " Same thing as `\u03a0 i, H i` We introduce it for technical reasons,\nsee note [Manifold type tags].", "p": "mathlib"}, {"name": "pregroupoid", "description": " To construct a groupoid, one may consider classes of local homeos such that both the function\nand its inverse have some property. If this property is stable under composition,\none gets a groupoid. `pregroupoid` bundles the properties needed for this construction, with the\ngroupoid of smooth functions with smooth inverses as an application.", "p": "mathlib"}, {"name": "pregroupoid.property", "description": " To construct a groupoid, one may consider classes of local homeos such that both the function\nand its inverse have some property. If this property is stable under composition,\none gets a groupoid. `pregroupoid` bundles the properties needed for this construction, with the\ngroupoid of smooth functions with smooth inverses as an application.", "p": "mathlib"}, {"name": "pregroupoid.comp", "description": " To construct a groupoid, one may consider classes of local homeos such that both the function\nand its inverse have some property. If this property is stable under composition,\none gets a groupoid. `pregroupoid` bundles the properties needed for this construction, with the\ngroupoid of smooth functions with smooth inverses as an application.", "p": "mathlib"}, {"name": "pregroupoid.id_mem", "description": " To construct a groupoid, one may consider classes of local homeos such that both the function\nand its inverse have some property. If this property is stable under composition,\none gets a groupoid. `pregroupoid` bundles the properties needed for this construction, with the\ngroupoid of smooth functions with smooth inverses as an application.", "p": "mathlib"}, {"name": "pregroupoid.locality", "description": " To construct a groupoid, one may consider classes of local homeos such that both the function\nand its inverse have some property. If this property is stable under composition,\none gets a groupoid. `pregroupoid` bundles the properties needed for this construction, with the\ngroupoid of smooth functions with smooth inverses as an application.", "p": "mathlib"}, {"name": "pregroupoid.congr", "description": " To construct a groupoid, one may consider classes of local homeos such that both the function\nand its inverse have some property. If this property is stable under composition,\none gets a groupoid. `pregroupoid` bundles the properties needed for this construction, with the\ngroupoid of smooth functions with smooth inverses as an application.", "p": "mathlib"}, {"name": "coe_achart", "description": "", "p": "mathlib"}, {"name": "charted_space_self_atlas", "description": " In the trivial charted_space structure of a space modelled over itself through the identity, the\natlas members are just the identity", "p": "mathlib"}, {"name": "achart_val", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.mem_maximal_atlas_of_mem_groupoid", "description": "In the model space, any element of the groupoid is in the maximal atlas.", "p": "mathlib"}, {"name": "has_groupoid_continuous_groupoid", "description": "Any charted space structure is compatible with the groupoid of all local homeomorphisms", "p": "mathlib"}, {"name": "charted_space.comp", "description": " If `M` is modelled on `H'` and `H'` is itself modelled on `H`, then we can consider `M` as being\nmodelled on `H`.", "p": "mathlib"}, {"name": "local_homeomorph.singleton_charted_space_chart_at_source", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.subset_maximal_atlas", "description": "The elements of the atlas belong to the maximal atlas for any structure groupoid", "p": "mathlib"}, {"name": "charted_space_core.open_target", "description": "", "p": "mathlib"}, {"name": "chart_target_mem_nhds", "description": "", "p": "mathlib"}, {"name": "model_prod_range_prod_id", "description": "", "p": "mathlib"}, {"name": "model_pi.topological_space", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.compatible", "description": " Reformulate in the `structure_groupoid` namespace the compatibility condition of charts in a\ncharted space admitting a structure groupoid, to make it more easily accessible with dot\nnotation.", "p": "mathlib"}, {"name": "local_homeomorph.singleton_charted_space", "description": " If a single local homeomorphism `e` from a space `\u03b1` into `H` has source covering the whole\nspace `\u03b1`, then that local homeomorphism induces an `H`-charted space structure on `\u03b1`.\n(This condition is equivalent to `e` being an open embedding of `\u03b1` into `H`; see\n`open_embedding.singleton_charted_space`.)", "p": "mathlib"}, {"name": "structure_groupoid.order_bot", "description": "Every structure groupoid contains the identity groupoid", "p": "mathlib"}, {"name": "charted_space_core.local_homeomorph", "description": " An element of the atlas in a charted space without topology becomes a local homeomorphism\nfor the topology constructed from this atlas. The `local_homeomorph` version is given in this\ndefinition.", "p": "mathlib"}, {"name": "open_embedding.singleton_charted_space", "description": " An open embedding of `\u03b1` into `H` induces an `H`-charted space structure on `\u03b1`.\nSee `local_homeomorph.singleton_charted_space`", "p": "mathlib"}, {"name": "model_pi_inhabited", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.id_mem", "description": "", "p": "mathlib"}, {"name": "structomorph.refl", "description": "The identity is a diffeomorphism of any charted space, for any groupoid.", "p": "mathlib"}, {"name": "structure_groupoid.compatible_of_mem_maximal_atlas", "description": " Changing coordinates between two elements of the maximal atlas gives rise to an element\nof the structure groupoid.", "p": "mathlib"}, {"name": "pi_charted_space_chart_at", "description": "", "p": "mathlib"}, {"name": "structomorph.symm", "description": "The inverse of a structomorphism is a structomorphism", "p": "mathlib"}, {"name": "charted_space_core.to_charted_space", "description": " Given a charted space without topology, endow it with a genuine charted space structure with\nrespect to the topology constructed from the atlas.", "p": "mathlib"}, {"name": "charted_space.second_countable_of_countable_cover", "description": "", "p": "mathlib"}, {"name": "charted_space_core.open_source'", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.id_mem_maximal_atlas", "description": "In the model space, the identity is in any maximal atlas.", "p": "mathlib"}, {"name": "local_homeomorph.singleton_has_groupoid", "description": " Given a local homeomorphism `e` from a space `\u03b1` into `H`, if its source covers the whole\nspace `\u03b1`, then the induced charted space structure on `\u03b1` is `has_groupoid G` for any structure\ngroupoid `G` which is closed under restrictions.", "p": "mathlib"}, {"name": "topological_space.opens.chart_at_inclusion_symm_eventually_eq", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.maximal_atlas", "description": " Given a charted space admitting a structure groupoid, the maximal atlas associated to this\nstructure groupoid is the set of all local charts that are compatible with the atlas, i.e., such\nthat changing coordinates with an atlas member gives an element of the groupoid.", "p": "mathlib"}, {"name": "pregroupoid.groupoid", "description": " Construct a groupoid of local homeos for which the map and its inverse have some property,\nfrom a pregroupoid asserting that this property is stable under composition.", "p": "mathlib"}, {"name": "structomorph", "description": " A `G`-diffeomorphism between two charted spaces is a homeomorphism which, when read in the\ncharts, belongs to `G`. We avoid the word diffeomorph as it is too related to the smooth category,\nand use structomorph instead.", "p": "mathlib"}, {"name": "structomorph.to_homeomorph", "description": " A `G`-diffeomorphism between two charted spaces is a homeomorphism which, when read in the\ncharts, belongs to `G`. We avoid the word diffeomorph as it is too related to the smooth category,\nand use structomorph instead.", "p": "mathlib"}, {"name": "structomorph.mem_groupoid", "description": " A `G`-diffeomorphism between two charted spaces is a homeomorphism which, when read in the\ncharts, belongs to `G`. We avoid the word diffeomorph as it is too related to the smooth category,\nand use structomorph instead.", "p": "mathlib"}, {"name": "has_groupoid_model_space", "description": "The trivial charted space structure on the model space is compatible with any groupoid", "p": "mathlib"}, {"name": "closed_under_restriction", "description": " A groupoid is closed under restriction if it contains all restrictions of its element local\nhomeomorphisms to open subsets of the source.", "p": "mathlib"}, {"name": "closed_under_restriction.closed_under_restriction", "description": " A groupoid is closed under restriction if it contains all restrictions of its element local\nhomeomorphisms to open subsets of the source.", "p": "mathlib"}, {"name": "structure_groupoid.le_iff", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.eq_on_source", "description": "", "p": "mathlib"}, {"name": "mem_maximal_atlas_iff", "description": "", "p": "mathlib"}, {"name": "pi_charted_space", "description": " The product of a finite family of charted spaces is naturally a charted space, with the\ncanonical construction of the atlas of finite product maps.", "p": "mathlib"}, {"name": "achart_def", "description": "", "p": "mathlib"}, {"name": "pregroupoid.inhabited", "description": "", "p": "mathlib"}, {"name": "charted_space.second_countable_of_sigma_compact", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.chart_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "mem_pregroupoid_of_eq_on_source", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.order_top", "description": "Every structure groupoid is contained in the groupoid of all local homeomorphisms", "p": "mathlib"}, {"name": "model_prod", "description": " Same thing as `H \u00d7 H'` We introduce it for technical reasons,\nsee note [Manifold type tags].", "p": "mathlib"}, {"name": "structure_groupoid.partial_order", "description": "Partial order on the set of groupoids, given by inclusion of the members of the groupoid", "p": "mathlib"}, {"name": "structure_groupoid.has_mem", "description": "", "p": "mathlib"}, {"name": "achart", "description": " `achart H x` is the chart at `x`, considered as an element of the atlas.\nEspecially useful for working with `basic_smooth_vector_bundle_core`", "p": "mathlib"}, {"name": "charted_space", "description": " A charted space is a topological space endowed with an atlas, i.e., a set of local\nhomeomorphisms taking value in a model space `H`, called charts, such that the domains of the charts\ncover the whole space. We express the covering property by chosing for each `x` a member\n`chart_at H x` of the atlas containing `x` in its source: in the smooth case, this is convenient to\nconstruct the tangent bundle in an efficient way.\nThe model space is written as an explicit parameter as there can be several model spaces for a\ngiven topological space. For instance, a complex manifold (modelled over `\u2102^n`) will also be seen\nsometimes as a real manifold over `\u211d^(2n)`.", "p": "mathlib"}, {"name": "charted_space.atlas", "description": " A charted space is a topological space endowed with an atlas, i.e., a set of local\nhomeomorphisms taking value in a model space `H`, called charts, such that the domains of the charts\ncover the whole space. We express the covering property by chosing for each `x` a member\n`chart_at H x` of the atlas containing `x` in its source: in the smooth case, this is convenient to\nconstruct the tangent bundle in an efficient way.\nThe model space is written as an explicit parameter as there can be several model spaces for a\ngiven topological space. For instance, a complex manifold (modelled over `\u2102^n`) will also be seen\nsometimes as a real manifold over `\u211d^(2n)`.", "p": "mathlib"}, {"name": "charted_space.chart_at", "description": " A charted space is a topological space endowed with an atlas, i.e., a set of local\nhomeomorphisms taking value in a model space `H`, called charts, such that the domains of the charts\ncover the whole space. We express the covering property by chosing for each `x` a member\n`chart_at H x` of the atlas containing `x` in its source: in the smooth case, this is convenient to\nconstruct the tangent bundle in an efficient way.\nThe model space is written as an explicit parameter as there can be several model spaces for a\ngiven topological space. For instance, a complex manifold (modelled over `\u2102^n`) will also be seen\nsometimes as a real manifold over `\u211d^(2n)`.", "p": "mathlib"}, {"name": "charted_space.mem_chart_source", "description": " A charted space is a topological space endowed with an atlas, i.e., a set of local\nhomeomorphisms taking value in a model space `H`, called charts, such that the domains of the charts\ncover the whole space. We express the covering property by chosing for each `x` a member\n`chart_at H x` of the atlas containing `x` in its source: in the smooth case, this is convenient to\nconstruct the tangent bundle in an efficient way.\nThe model space is written as an explicit parameter as there can be several model spaces for a\ngiven topological space. For instance, a complex manifold (modelled over `\u2102^n`) will also be seen\nsometimes as a real manifold over `\u211d^(2n)`.", "p": "mathlib"}, {"name": "charted_space.chart_mem_atlas", "description": " A charted space is a topological space endowed with an atlas, i.e., a set of local\nhomeomorphisms taking value in a model space `H`, called charts, such that the domains of the charts\ncover the whole space. We express the covering property by chosing for each `x` a member\n`chart_at H x` of the atlas containing `x` in its source: in the smooth case, this is convenient to\nconstruct the tangent bundle in an efficient way.\nThe model space is written as an explicit parameter as there can be several model spaces for a\ngiven topological space. For instance, a complex manifold (modelled over `\u2102^n`) will also be seen\nsometimes as a real manifold over `\u211d^(2n)`.", "p": "mathlib"}, {"name": "model_prod_inhabited", "description": "", "p": "mathlib"}, {"name": "charted_space.locally_compact", "description": " If a topological space admits an atlas with locally compact charts, then the space itself\nis locally compact.", "p": "mathlib"}, {"name": "id_restr_groupoid", "description": " The trivial restriction-closed groupoid, containing only local homeomorphisms equivalent to the\nrestriction of the identity to the various open subsets.", "p": "mathlib"}, {"name": "charted_space_self", "description": "Any space is a charted_space modelled over itself, by just using the identity chart", "p": "mathlib"}, {"name": "open_embedding.singleton_charted_space_chart_at_eq", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.symm", "description": "", "p": "mathlib"}, {"name": "mem_achart_source", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.singleton_charted_space_mem_atlas_eq", "description": "", "p": "mathlib"}, {"name": "charted_space_core", "description": " Sometimes, one may want to construct a charted space structure on a space which does not yet\nhave a topological structure, where the topology would come from the charts. For this, one needs\ncharts that are only local equivs, and continuity properties for their composition.\nThis is formalised in `charted_space_core`.", "p": "mathlib"}, {"name": "charted_space_core.atlas", "description": " Sometimes, one may want to construct a charted space structure on a space which does not yet\nhave a topological structure, where the topology would come from the charts. For this, one needs\ncharts that are only local equivs, and continuity properties for their composition.\nThis is formalised in `charted_space_core`.", "p": "mathlib"}, {"name": "charted_space_core.chart_at", "description": " Sometimes, one may want to construct a charted space structure on a space which does not yet\nhave a topological structure, where the topology would come from the charts. For this, one needs\ncharts that are only local equivs, and continuity properties for their composition.\nThis is formalised in `charted_space_core`.", "p": "mathlib"}, {"name": "charted_space_core.mem_chart_source", "description": " Sometimes, one may want to construct a charted space structure on a space which does not yet\nhave a topological structure, where the topology would come from the charts. For this, one needs\ncharts that are only local equivs, and continuity properties for their composition.\nThis is formalised in `charted_space_core`.", "p": "mathlib"}, {"name": "charted_space_core.chart_mem_atlas", "description": " Sometimes, one may want to construct a charted space structure on a space which does not yet\nhave a topological structure, where the topology would come from the charts. For this, one needs\ncharts that are only local equivs, and continuity properties for their composition.\nThis is formalised in `charted_space_core`.", "p": "mathlib"}, {"name": "charted_space_core.open_source", "description": " Sometimes, one may want to construct a charted space structure on a space which does not yet\nhave a topological structure, where the topology would come from the charts. For this, one needs\ncharts that are only local equivs, and continuity properties for their composition.\nThis is formalised in `charted_space_core`.", "p": "mathlib"}, {"name": "charted_space_core.continuous_to_fun", "description": " Sometimes, one may want to construct a charted space structure on a space which does not yet\nhave a topological structure, where the topology would come from the charts. For this, one needs\ncharts that are only local equivs, and continuity properties for their composition.\nThis is formalised in `charted_space_core`.", "p": "mathlib"}, {"name": "topological_space.opens.charted_space", "description": "An open subset of a charted space is naturally a charted space.", "p": "mathlib"}, {"name": "mem_chart_target", "description": "", "p": "mathlib"}, {"name": "charted_space_core.to_topological_space", "description": "Topology generated by a set of charts on a Type.", "p": "mathlib"}, {"name": "charted_space_self_prod", "description": "", "p": "mathlib"}, {"name": "antitone_on.Icc", "description": "", "p": "mathlib"}, {"name": "monotone_on.Iio", "description": "", "p": "mathlib"}, {"name": "monotone.Ioc", "description": "", "p": "mathlib"}, {"name": "strict_mono_on.Iic_id_le", "description": "", "p": "mathlib"}, {"name": "strict_mono_on_Iic_of_lt_succ", "description": " A function `\u03c8` on a `succ_order` is strictly monotone before some `n` if for all `m` such that\n`m < n`, we have `\u03c8 m < \u03c8 (succ m)`.", "p": "mathlib"}, {"name": "monotone.Iic", "description": "", "p": "mathlib"}, {"name": "monotone.Ico", "description": "", "p": "mathlib"}, {"name": "antitone.Ioi", "description": "", "p": "mathlib"}, {"name": "antitone_on.Ioo", "description": "", "p": "mathlib"}, {"name": "strict_anti_on_Ici_of_lt_pred", "description": "", "p": "mathlib"}, {"name": "monotone_on.Ioo", "description": "", "p": "mathlib"}, {"name": "antitone_on.Ioi", "description": "", "p": "mathlib"}, {"name": "monotone_on.Ico", "description": "", "p": "mathlib"}, {"name": "monotone.Ici", "description": "", "p": "mathlib"}, {"name": "antitone_on.Iic", "description": "", "p": "mathlib"}, {"name": "antitone.Ioo", "description": "", "p": "mathlib"}, {"name": "monotone_Iio", "description": "", "p": "mathlib"}, {"name": "Union_Ioo_of_mono_of_is_glb_of_is_lub", "description": "", "p": "mathlib"}, {"name": "monotone.Icc", "description": "", "p": "mathlib"}, {"name": "monotone.Ioo", "description": "", "p": "mathlib"}, {"name": "antitone.Iic", "description": "", "p": "mathlib"}, {"name": "strict_mono_on_Ici_of_pred_lt", "description": "", "p": "mathlib"}, {"name": "monotone.Ioi", "description": "", "p": "mathlib"}, {"name": "antitone.Ioc", "description": "", "p": "mathlib"}, {"name": "antitone.Icc", "description": "", "p": "mathlib"}, {"name": "strict_mono_on.Ici_le_id", "description": "", "p": "mathlib"}, {"name": "monotone_on.Iic", "description": "", "p": "mathlib"}, {"name": "monotone_on.Icc", "description": "", "p": "mathlib"}, {"name": "monotone_on.Ioi", "description": "", "p": "mathlib"}, {"name": "antitone_on.Ioc", "description": "", "p": "mathlib"}, {"name": "monotone_on.Ioc", "description": "", "p": "mathlib"}, {"name": "antitone_Ici", "description": "", "p": "mathlib"}, {"name": "antitone_on.Iio", "description": "", "p": "mathlib"}, {"name": "monotone_on.Ici", "description": "", "p": "mathlib"}, {"name": "monotone.Iio", "description": "", "p": "mathlib"}, {"name": "antitone_Ioi", "description": "", "p": "mathlib"}, {"name": "antitone.Ici", "description": "", "p": "mathlib"}, {"name": "monotone_Iic", "description": "", "p": "mathlib"}, {"name": "strict_anti_on_Iic_of_succ_lt", "description": "", "p": "mathlib"}, {"name": "antitone_on.Ico", "description": "", "p": "mathlib"}, {"name": "antitone_on.Ici", "description": "", "p": "mathlib"}, {"name": "antitone.Iio", "description": "", "p": "mathlib"}, {"name": "antitone.Ico", "description": "", "p": "mathlib"}, {"name": "tactic.get_tagged_ancestors", "description": "Returns the parents of a structure added via the `ancestor` attribute.\n\nOn failure, the empty list is returned.", "p": "mathlib"}, {"name": "tactic_doc.attribute.ancestor", "description": " The `ancestor` attributes is used to record the names of structures which appear in the\nextends clause of a `structure` or `class` declared with `old_structure_cmd` set to true.\n\nAs an example:\n```lean\nset_option old_structure_cmd true\n\nstructure base_one := (one : \u2115)\n\nstructure base_two (\u03b1 : Type*) := (two : \u2115)\n\n@[ancestor base_one base_two]\nstructure bar extends base_one, base_two \u03b1\n```\n\nThe list of ancestors should be in the order they appear in the `extends` clause, and should\ncontain only the names of the ancestor structures, without any arguments.", "p": "mathlib"}, {"name": "tactic.ancestor_attr", "description": " The `ancestor` attributes is used to record the names of structures which appear in the\nextends clause of a `structure` or `class` declared with `old_structure_cmd` set to true.\n\nAs an example:\n```lean\nset_option old_structure_cmd true\n\nstructure base_one := (one : \u2115)\n\nstructure base_two (\u03b1 : Type*) := (two : \u2115)\n\n@[ancestor base_one base_two]\nstructure bar extends base_one, base_two \u03b1\n```\n\nThe list of ancestors should be in the order they appear in the `extends` clause, and should\ncontain only the names of the ancestor structures, without any arguments.", "p": "mathlib"}, {"name": "tactic.find_ancestors", "description": "Returns the (transitive) ancestors of a structure added via the `ancestor`\nattribute (or reachable via subobjects).\n\nOn failure, the empty list is returned.", "p": "mathlib"}, {"name": "tactic.get_ancestors", "description": "Returns the parents of a structure added via the `ancestor` attribute, as well as subobjects.\n\nOn failure, the empty list is returned.", "p": "mathlib"}, {"name": "path.homotopy.hcomp_apply", "description": "", "p": "mathlib"}, {"name": "path.homotopic.setoid", "description": "The setoid on `path`s defined by the equivalence relation `path.homotopic`. That is, two paths are\nequivalent if there is a `homotopy` between them.", "p": "mathlib"}, {"name": "path.homotopic.trans", "description": "", "p": "mathlib"}, {"name": "continuous_map.homotopy.eval_at", "description": "Given a homotopy H: f \u223c g, get the path traced by the point `x` as it moves from\n`f x` to `g x`", "p": "mathlib"}, {"name": "path.homotopy.source", "description": "", "p": "mathlib"}, {"name": "path.homotopy.reparam", "description": "Suppose `p` is a path, then we have a homotopy from `p` to `p.reparam f` by the convexity of `I`.", "p": "mathlib"}, {"name": "path.homotopic.quotient.map_fn", "description": "The image of a path homotopy class `P\u2080` under a map `f`.\n   This is `path.map` descended to the quotient", "p": "mathlib"}, {"name": "path.homotopic.hcomp", "description": "", "p": "mathlib"}, {"name": "path.homotopy.symm_trans", "description": "", "p": "mathlib"}, {"name": "path.homotopy.symm", "description": "Given a `homotopy p\u2080 p\u2081`, we can define a `homotopy p\u2081 p\u2080` by reversing the homotopy.", "p": "mathlib"}, {"name": "path.homotopy.trans", "description": "Given `homotopy p\u2080 p\u2081` and `homotopy p\u2081 p\u2082`, we can define a `homotopy p\u2080 p\u2082` by putting the first\nhomotopy on `[0, 1/2]` and the second on `[1/2, 1]`.", "p": "mathlib"}, {"name": "path.homotopy", "description": "The type of homotopies between two paths.", "p": "mathlib"}, {"name": "path.homotopy.cast", "description": "Casting a `homotopy p\u2080 p\u2081` to a `homotopy q\u2080 q\u2081` where `p\u2080 = q\u2080` and `p\u2081 = q\u2081`.", "p": "mathlib"}, {"name": "path.homotopy.symm_symm", "description": "", "p": "mathlib"}, {"name": "path.homotopy.symm\u2082", "description": "Suppose `F : homotopy p q`. Then we have a `homotopy p.symm q.symm` by reversing the second\nargument.", "p": "mathlib"}, {"name": "path.homotopic.equivalence", "description": "", "p": "mathlib"}, {"name": "path.homotopy.cast_apply", "description": "", "p": "mathlib"}, {"name": "path.homotopy.target", "description": "", "p": "mathlib"}, {"name": "path.homotopy.trans_apply", "description": "", "p": "mathlib"}, {"name": "path.homotopic", "description": "Two paths `p\u2080` and `p\u2081` are `path.homotopic` if there exists a `homotopy` between them.", "p": "mathlib"}, {"name": "path.homotopy.map_apply", "description": "", "p": "mathlib"}, {"name": "path.homotopic.quotient.inhabited", "description": "", "p": "mathlib"}, {"name": "path.homotopy.symm_apply", "description": "", "p": "mathlib"}, {"name": "path.homotopic.hpath_hext", "description": "", "p": "mathlib"}, {"name": "path.homotopy.eval_one", "description": "", "p": "mathlib"}, {"name": "path.homotopy.eval_zero", "description": "", "p": "mathlib"}, {"name": "path.homotopy.symm\u2082_apply", "description": "", "p": "mathlib"}, {"name": "path.homotopy.cast_to_homotopy", "description": "", "p": "mathlib"}, {"name": "path.homotopic.quotient", "description": "The quotient on `path x\u2080 x\u2081` by the equivalence relation `path.homotopic`.", "p": "mathlib"}, {"name": "path.homotopy.refl_apply", "description": "", "p": "mathlib"}, {"name": "path.homotopy.map_to_homotopy_apply", "description": "", "p": "mathlib"}, {"name": "path.homotopy.hcomp_half", "description": "", "p": "mathlib"}, {"name": "path.homotopy.map", "description": "Given `F : homotopy p q`, and `f : C(X, Y)`, we can define a homotopy from `p.map f.continuous` to\n`q.map f.continuous`.", "p": "mathlib"}, {"name": "path.homotopy.hcomp", "description": "Suppose `p\u2080` and `q\u2080` are paths from `x\u2080` to `x\u2081`, `p\u2081` and `q\u2081` are paths from `x\u2081` to `x\u2082`.\nFurthermore, suppose `F : homotopy p\u2080 q\u2080` and `G : homotopy p\u2081 q\u2081`. Then we can define a homotopy\nfrom `p\u2080.trans p\u2081` to `q\u2080.trans q\u2081`.", "p": "mathlib"}, {"name": "path.homotopy.eval", "description": "Evaluating a path homotopy at an intermediate point, giving us a `path`.", "p": "mathlib"}, {"name": "path.homotopic.quotient.comp", "description": "The composition of path homotopy classes. This is `path.trans` descended to the quotient.", "p": "mathlib"}, {"name": "path.homotopy.refl_to_homotopy", "description": "", "p": "mathlib"}, {"name": "path.homotopic.comp_lift", "description": "", "p": "mathlib"}, {"name": "path.homotopy.symm_to_homotopy", "description": "", "p": "mathlib"}, {"name": "path.homotopic.symm", "description": "", "p": "mathlib"}, {"name": "path.homotopic.refl", "description": "", "p": "mathlib"}, {"name": "path.homotopic.map", "description": "", "p": "mathlib"}, {"name": "path.homotopy.symm\u2082_to_homotopy_apply", "description": "", "p": "mathlib"}, {"name": "path.homotopy.refl", "description": "Given a path `p`, we can define a `homotopy p p` by `F (t, x) = p x`", "p": "mathlib"}, {"name": "path.homotopic.map_lift", "description": "", "p": "mathlib"}, {"name": "path.homotopy.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "path.homotopy.coe_fn_injective", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.associator_naturality", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.right_unitor_hom_apply", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.associator_hom_apply", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.associator", "description": "(implementation) the associator for R-modules", "p": "mathlib"}, {"name": "Module.monoidal_category.right_unitor_naturality", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.left_unitor", "description": "(implementation) the left unitor for R-modules", "p": "mathlib"}, {"name": "Module.monoidal_category.left_unitor_inv_apply", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.tensor_hom", "description": "(implementation) tensor product of morphisms R-modules", "p": "mathlib"}, {"name": "Module.monoidal_category.left_unitor_naturality", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.tensor_comp", "description": "", "p": "mathlib"}, {"name": "Module.category_theory.monoidal_preadditive", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.right_unitor_inv_apply", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.pentagon", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.tensor_obj", "description": "(implementation) tensor product of R-modules", "p": "mathlib"}, {"name": "Module.category_theory.monoidal_linear", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.hom_apply", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.tensor_id", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.right_unitor", "description": "(implementation) the right unitor for R-modules", "p": "mathlib"}, {"name": "Module.category_theory.monoidal_category.tensor_unit.comm_ring", "description": "Remind ourselves that the monoidal unit, being just `R`, is still a commutative ring.", "p": "mathlib"}, {"name": "Module.monoidal_category.triangle", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.associator_inv_apply", "description": "", "p": "mathlib"}, {"name": "Module.monoidal_category.left_unitor_hom_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.mul_action", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.comap_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.inhabited", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_infi", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.measure_of_eq_coe", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.sUnion_null_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_sup", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by_union_of_top_of_nonempty_inter", "description": " If `m u = \u221e` for any set `u` that has nonempty intersection both with `s` and `t`, then\n`\u03bc (s \u222a t) = \u03bc s + \u03bc t`, where `\u03bc = measure_theory.outer_measure.bounded_by m`.\n\nE.g., if `\u03b1` is an (e)metric space and `m u = \u221e` on any set of diameter `\u2265 r`, then this lemma\nimplies that `\u03bc (s \u222a t) = \u03bc s + \u03bc t` on any two sets such that `r \u2264 edist x y` for all `x \u2208 s`\nand `y \u2208 t`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_empty", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_univ", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_bounded_by", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.supr_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_greatest_of_function", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.has_bot", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by_eq_of_function", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure", "description": "An outer measure is a countably subadditive monotone function that sends `\u2205` to `0`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.measure_of", "description": "An outer measure is a countably subadditive monotone function that sends `\u2205` to `0`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.empty", "description": "An outer measure is a countably subadditive monotone function that sends `\u2205` to `0`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.mono", "description": "An outer measure is a countably subadditive monotone function that sends `\u2205` to `0`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Union_nat", "description": "An outer measure is a countably subadditive monotone function that sends `\u2205` to `0`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_supr", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_binfi_comap", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Sup_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_iff_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Union", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.top_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_comap_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.dirac_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.zero_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.sum", "description": "The sum of an (arbitrary) collection of outer measures.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.comap_map", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_binop", "description": " If `m\u2081 s = op (m\u2082 s) (m\u2083 s)` for all `s`, then the same is true for `m\u2081.trim`, `m\u2082.trim`,\nand `m\u2083 s`.", "p": "mathlib"}, {"name": "measure_theory.extend", "description": "We can trivially extend a function defined on a subclass of objects (with codomain `\u211d\u22650\u221e`)\n to all objects by defining it to be `\u221e` on the objects not in the class.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.ext", "description": "", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure_eq_extend'", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.of_function_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_inter", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_infi_restrict", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.coe_fn_injective", "description": "", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.of_function_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_Union_nat", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.module", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.comap_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.comap", "description": "Pullback of an `outer_measure`: `comap f \u03bc s = \u03bc (f '' s)`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_eq_infi", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_compl", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Union_of_tendsto_zero", "description": " If `s : \u03b9 \u2192 set \u03b1` is a sequence of sets, `S = \u22c3 n, s n`, and `m (S \\ s n)` tends to zero along\nsome nontrivial filter (usually `at_top` on `\u03b9 = \u2115`), then `m S = \u2a06 n, m (s n)`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_comap_of_surjective", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_comap_map", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Inf_apply'", "description": " The value of the Infimum of a set of outer measures on a nonempty set is not simply\nthe minimum value of a measure on that set: it is the infimum sum of measures of countable set of\nsets that covers that set, where a different measure can be used for each set in the cover.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.empty'", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_smul", "description": "`trim` respects scalar multiplication.", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure_eq'", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.binfi_apply", "description": " The value of the Infimum of a nonempty family of outer measures on a set is not simply\nthe minimum value of a measure on that set: it is the infimum sum of measures of countable set of\nsets that covers that set, where a different measure can be used for each set in the cover.", "p": "mathlib"}, {"name": "measure_theory.extend_Union_le_tsum_nat", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_union", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_infi_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.union", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_eq_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_congr", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_bounded_by'", "description": "", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure_union_of_false_of_nonempty_inter", "description": " If `P u` is `false` for any set `u` that has nonempty intersection both with `s` and `t`, then\n`\u03bc (s \u222a t) = \u03bc s + \u03bc t`, where `\u03bc = induced_outer_measure m P0 m0`.\n\nE.g., if `\u03b1` is an (e)metric space and `P u = diam u < r`, then this lemma implies that\n`\u03bc (s \u222a t) = \u03bc s + \u03bc t` on any two sets such that `r \u2264 edist x y` for all `x \u2208 s` and `y \u2208 t`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim", "description": "Given an outer measure `m` we can forget its value on non-measurable sets, and then consider\n `m.trim`, the unique maximal outer measure less than that function.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.exists_mem_forall_mem_nhds_within_pos", "description": "If `m s \u2260 0`, then for some point `x \u2208 s` and any `t \u2208 \ud835\udcdd[s] x` we have `0 < m t`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_central_scalar", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Inf_gen", "description": "Given a set of outer measures, we define a new function that on a set `s` is defined to be the\n infimum of `\u03bc(s)` for the outer measures `\u03bc` in the collection. We ensure that this\n function is defined to be `0` on `\u2205`, even if the collection of outer measures is empty.\n The outer measure generated by this function is the infimum of the given outer measures.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_top_of_surjective", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.distrib_mul_action", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.outer_measure.order_bot", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_le_restrict_range", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_of_function_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.measure_inter_union", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_union", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_trim", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_comap", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.coe_supr", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_Union_nat", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.exists_measurable_superset_of_trim_eq_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_iff_le'", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_smul_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.comap_supr", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.top_apply'", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_empty", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_Inf_eq_Inf_restrict", "description": " This proves that Inf and restrict commute for outer measures, so long as the set of\nouter measures is nonempty.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.infi_apply'", "description": " The value of the Infimum of a family of outer measures on a nonempty set is not simply\nthe minimum value of a measure on that set: it is the infimum sum of measures of countable set of\nsets that covers that set, where a different measure can be used for each set in the cover.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.comap_bounded_by", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.comap_infi", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.of_function_eq_Sup", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.smul_dirac_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.sum_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.smul_of_function", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_Union_lt", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_empty", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_of_function", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict", "description": "Restrict an `outer_measure` to a set.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_sum_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Union_null_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.ext_nonempty", "description": " A version of `measure_theory.outer_measure.ext` that assumes `\u03bc\u2081 s = \u03bc\u2082 s` on all *nonempty*\nsets `s`, and gets `\u03bc\u2081 \u2205 = \u03bc\u2082 \u2205` from `measure_theory.outer_measure.empty'`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_infi", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.null_of_locally_null", "description": " If a set has zero measure in a neighborhood of each of its points, then it has zero measure\nin a second-countable space.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.of_function", "description": "Given any function `m` assigning measures to sets satisying `m \u2205 = 0`, there is\n a unique maximal outer measure `\u03bc` satisfying `\u03bc s \u2264 m s` for all `s : set \u03b1`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.comap_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.caratheodory", "description": "Given an outer measure `\u03bc`, the Carath\u00e9odory-measurable space is\n defined such that `s` is measurable if `\u2200t, \u03bc t = \u03bc (t \u2229 s) + \u03bc (t \\ s)`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_trim", "description": " The trimmed property of a measure \u03bc states that `\u03bc.to_outer_measure.trim = \u03bc.to_outer_measure`.\nThis theorem shows that a restricted trimmed outer measure is a trimmed outer measure.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.mono'", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.coe_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Union_nat_of_monotone_of_tsum_ne_top", "description": " If `s : \u2115 \u2192 set \u03b1` is a monotone sequence of sets such that `\u2211' k, m (s (k + 1) \\ s k) \u2260 \u221e`,\nthen `m (\u22c3 n, s n) = \u2a06 n, m (s n)`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.smul_supr", "description": "", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure_eq_infi", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Inf_apply", "description": " The value of the Infimum of a nonempty set of outer measures on a set is not simply\nthe minimum value of a measure on that set: it is the infimum sum of measures of countable set of\nsets that covers that set, where a different measure can be used for each set in the cover.", "p": "mathlib"}, {"name": "measure_theory.extend_Union_le_tsum_nat'", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_supr", "description": " `trim` sends the supremum of a countable family of outer measures to the supremum\nof the trimmed measures.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_op", "description": "If `m\u2081 s = op (m\u2082 s)` for all `s`, then the same is true for `m\u2081.trim` and `m\u2082.trim`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.coe_fn_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Union_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.has_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_map", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Union_eq_of_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_Union", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_trim", "description": "", "p": "mathlib"}, {"name": "measure_theory.le_induced_outer_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map", "description": "The pushforward of `m` along `f`. The outer measure on `s` is defined to be `m (f \u207b\u00b9' s)`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.exists_measurable_superset_forall_eq_trim", "description": " If `\u03bc i` is a countable family of outer measures, then for every set `s` there exists\na measurable set `t \u2287 s` such that `\u03bc i t = (\u03bc i).trim s` for all `i`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.univ_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_trim_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.mono_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_le_trim_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_compl_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.coe_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.coe_bot", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.has_Sup", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.coe_fn_add_monoid_hom", "description": "`coe_fn` as an `add_monoid_hom`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.diff_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.dirac", "description": "The dirac outer measure.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Inf_gen_def", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.f_Union", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.coe_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.of_function_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Union_null_iff'", "description": " A version of `Union_null_iff` for unions indexed by Props.\nTODO: in the long run it would be better to combine this with `Union_null_iff` by\ngeneralising to `Sort`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.top_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.smul_extend", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_inter_add_diff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.smul_bounded_by", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure_preimage", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by_eq_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_of_function", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure_exists_set", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.mono''", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_id", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.smul_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.outer_measure.partial_order", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.union_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.supr_Inf_gen_nonempty", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Union_finset", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.smul_comm_class", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_mono'", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.Inf_eq_bounded_by_Inf_gen", "description": "", "p": "mathlib"}, {"name": "measure_theory.le_extend", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_add_caratheodory", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_eq_trim_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_sup", "description": "`trim` sends the supremum of two outer measures to the supremum of the trimmed measures.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_eq_infi'", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_sum_ge", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.sup_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.trim_add", "description": "`trim` is additive.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.caratheodory_dynkin", "description": "The Carath\u00e9odory-measurable sets for an outer measure `m` form a Dynkin system.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bUnion_null_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory", "description": "A set `s` is Carath\u00e9odory-measurable for an outer measure `m` if for all sets `t` we have\n `m t = m (t \u2229 s) + m (t \\ s)`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.functor", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.bounded_by", "description": "Given any function `m` assigning measures to sets, there is a unique maximal outer measure `\u03bc`\n satisfying `\u03bc s \u2264 m s` for all `s : set \u03b1`. This is the same as `outer_measure.of_function`,\n except that it doesn't require `m \u2205 = 0`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_supr", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.binfi_apply'", "description": " The value of the Infimum of a nonempty family of outer measures on a set is not simply\nthe minimum value of a measure on that set: it is the infimum sum of measures of countable set of\nsets that covers that set, where a different measure can be used for each set in the cover.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.comap_of_function", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.of_function_union_of_top_of_nonempty_inter", "description": " If `m u = \u221e` for any set `u` that has nonempty intersection both with `s` and `t`, then\n`\u03bc (s \u222a t) = \u03bc s + \u03bc t`, where `\u03bc = measure_theory.outer_measure.of_function m m_empty`.\n\nE.g., if `\u03b1` is an (e)metric space and `m u = \u221e` on any set of diameter `\u2265 r`, then this lemma\nimplies that `\u03bc (s \u222a t) = \u03bc s + \u03bc t` on any two sets such that `r \u2264 edist x y` for all `x \u2208 s`\nand `y \u2208 t`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.has_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_le_self", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.has_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.infi_apply", "description": " The value of the Infimum of a nonempty family of outer measures on a set is not simply\nthe minimum value of a measure on that set: it is the infimum sum of measures of countable set of\nsets that covers that set, where a different measure can be used for each set in the cover.", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure", "description": "Given an arbitrary function on a subset of sets, we can define the outer measure corresponding\n to it (this is the unique maximal outer measure that is at most `m` on the domain of `m`).", "p": "mathlib"}, {"name": "measure_theory.outer_measure.dirac_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure_eq_extend", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.pos_of_subset_ne_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.map_infi_comap", "description": "", "p": "mathlib"}, {"name": "measure_theory.extend_congr", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_caratheodory_sum", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.complete_lattice", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.is_lawful_functor", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.exists_measurable_superset_eq_trim", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.le_of_function", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.add_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.outer_measure.restrict_binfi", "description": "", "p": "mathlib"}, {"name": "measure_theory.induced_outer_measure_caratheodory", "description": "To test whether `s` is Carath\u00e9odory-measurable we only need to check the sets `t` for which\n `P t` holds. See `of_function_caratheodory` for another way to show the Carath\u00e9odory-measurability\n of `s`.", "p": "mathlib"}, {"name": "measure_theory.outer_measure.of_function_eq", "description": "", "p": "mathlib"}, {"name": "dslope_sub_smul", "description": "", "p": "mathlib"}, {"name": "differentiable_within_at.of_dslope", "description": "", "p": "mathlib"}, {"name": "eq_on_dslope_sub_smul", "description": "", "p": "mathlib"}, {"name": "dslope_eventually_eq_slope_of_ne", "description": "", "p": "mathlib"}, {"name": "differentiable_on_dslope_of_nmem", "description": "", "p": "mathlib"}, {"name": "differentiable_on.of_dslope", "description": "", "p": "mathlib"}, {"name": "sub_smul_dslope", "description": "", "p": "mathlib"}, {"name": "continuous_on.of_dslope", "description": "", "p": "mathlib"}, {"name": "differentiable_within_at_dslope_of_ne", "description": "", "p": "mathlib"}, {"name": "continuous_at.of_dslope", "description": "", "p": "mathlib"}, {"name": "dslope_of_ne", "description": "", "p": "mathlib"}, {"name": "continuous_on_dslope", "description": "", "p": "mathlib"}, {"name": "continuous_at_dslope_same", "description": "", "p": "mathlib"}, {"name": "continuous_within_at_dslope_of_ne", "description": "", "p": "mathlib"}, {"name": "differentiable_at_dslope_of_ne", "description": "", "p": "mathlib"}, {"name": "differentiable_at.of_dslope", "description": "", "p": "mathlib"}, {"name": "dslope", "description": " `dslope f a b` is defined as `slope f a b = (b - a)\u207b\u00b9 \u2022 (f b - f a)` for `a \u2260 b` and\n`deriv f a` for `a = b`.", "p": "mathlib"}, {"name": "continuous_linear_map.dslope_comp", "description": "", "p": "mathlib"}, {"name": "dslope_sub_smul_of_ne", "description": "", "p": "mathlib"}, {"name": "dslope_same", "description": "", "p": "mathlib"}, {"name": "eq_on_dslope_slope", "description": "", "p": "mathlib"}, {"name": "continuous_at_dslope_of_ne", "description": "", "p": "mathlib"}, {"name": "continuous_within_at.of_dslope", "description": "", "p": "mathlib"}, {"name": "dslope_eventually_eq_slope_punctured_nhds", "description": "", "p": "mathlib"}, {"name": "mem_span_points", "description": "A point in a set is in its affine span.", "p": "mathlib"}, {"name": "affine_subspace.affine_span_parallel_iff_vector_span_eq_and_eq_empty_iff_eq_empty", "description": "", "p": "mathlib"}, {"name": "affine_subspace.map_bot", "description": "", "p": "mathlib"}, {"name": "affine_subspace.coe_comap", "description": "", "p": "mathlib"}, {"name": "affine_subspace.gc_map_comap", "description": "", "p": "mathlib"}, {"name": "affine_subspace.not_le_iff_exists", "description": " One subspace is not less than or equal to another if and only if\nit has a point not in the second subspace.", "p": "mathlib"}, {"name": "affine_subspace.coe_vadd", "description": "", "p": "mathlib"}, {"name": "affine_subspace.mem_mk'_iff_vsub_mem", "description": " A point lies in an affine subspace constructed from another point and a direction if and only\nif their difference is in that direction.", "p": "mathlib"}, {"name": "affine_subspace.ext_of_direction_eq", "description": " Two affine subspaces with the same direction and nonempty\nintersection are equal.", "p": "mathlib"}, {"name": "affine_subspace.mem_coe", "description": " A point is in an affine subspace coerced to a set if and only if\nit is in that affine subspace.", "p": "mathlib"}, {"name": "affine_subspace.direction_eq_vector_span", "description": "The direction equals the `vector_span`.", "p": "mathlib"}, {"name": "span_points_nonempty", "description": " The `span_points` of a set is nonempty if and only if that set\nis.", "p": "mathlib"}, {"name": "affine_subspace.le_comap_map", "description": "", "p": "mathlib"}, {"name": "affine_subspace.lt_def", "description": " The `<` order on subspaces is the same as that on the corresponding\nsets.", "p": "mathlib"}, {"name": "vector_span_mono", "description": "`vector_span` is monotone.", "p": "mathlib"}, {"name": "affine_subspace.eq_iff_direction_eq_of_mem", "description": " Two affine subspaces with nonempty intersection are equal if and\nonly if their directions are equal.", "p": "mathlib"}, {"name": "affine_subspace.affine_span_eq_top_iff_vector_span_eq_top_of_nontrivial", "description": "For a non-trivial space, the affine span of a set is `\u22a4` iff its vector span is `\u22a4`.", "p": "mathlib"}, {"name": "affine_subspace.vsub_right_mem_direction_iff_mem", "description": " Given a point in an affine subspace, a result of subtracting that\npoint on the right is in the direction if and only if the other point\nis in the subspace.", "p": "mathlib"}, {"name": "smul_vsub_vadd_mem_affine_span_pair", "description": " A multiple of the difference of two points added to the first point lies in their affine\nspan.", "p": "mathlib"}, {"name": "affine_subspace.card_pos_of_affine_span_eq_top", "description": "", "p": "mathlib"}, {"name": "affine_span_induction'", "description": "A dependent version of `affine_span_induction`.", "p": "mathlib"}, {"name": "affine_subspace.span_univ", "description": "The span of `univ` is `\u22a4`.", "p": "mathlib"}, {"name": "affine_subspace.map_id", "description": "", "p": "mathlib"}, {"name": "affine_subspace.mem_direction_iff_eq_vsub_left", "description": " Given a point in an affine subspace, a vector is in its direction\nif and only if it results from subtracting that point on the left.", "p": "mathlib"}, {"name": "affine_subspace.parallel_bot_iff_eq_bot", "description": "", "p": "mathlib"}, {"name": "affine_subspace.bot_parallel_iff_eq_bot", "description": "", "p": "mathlib"}, {"name": "affine_span_nonempty", "description": "The affine span of a set is nonempty if and only if that set is.", "p": "mathlib"}, {"name": "mem_vector_span_pair", "description": " A vector lies in the `vector_span` of two points if and only if it is a multiple of their\ndifference.", "p": "mathlib"}, {"name": "affine_subspace.to_add_torsor", "description": "This is not an instance because it loops with `add_torsor.nonempty`.", "p": "mathlib"}, {"name": "affine_span_insert_eq_affine_span", "description": " If a point is in the affine span of a set, adding it to that set\ndoes not change the affine span.", "p": "mathlib"}, {"name": "bot_lt_affine_span", "description": "", "p": "mathlib"}, {"name": "affine_subspace.direction_bot", "description": "The direction of `\u22a5` is the submodule `\u22a5`.", "p": "mathlib"}, {"name": "affine_subspace.vsub_mem_direction", "description": " Subtracting two points in the subspace produces a vector in the\ndirection.", "p": "mathlib"}, {"name": "vector_span_eq_span_vsub_finset_right_ne", "description": " The `vector_span` is the span of the pairwise subtractions with a\ngiven point on the right, excluding the subtraction of that point from\nitself.", "p": "mathlib"}, {"name": "affine_subspace.comap_inf", "description": "", "p": "mathlib"}, {"name": "affine_span_pair_le_of_left_mem", "description": " One line is contained in another differing in the first point if the first point of the first\nline is contained in the second line.", "p": "mathlib"}, {"name": "affine_subspace.eq_of_direction_eq_of_nonempty_of_le", "description": " If an affine subspace is nonempty and contained in another with\nthe same direction, they are equal.", "p": "mathlib"}, {"name": "affine_subspace.coe_map", "description": "", "p": "mathlib"}, {"name": "affine_subspace.mem_map_of_mem", "description": "", "p": "mathlib"}, {"name": "mem_affine_span", "description": "A point in a set is in its affine span.", "p": "mathlib"}, {"name": "affine_subspace.subtype", "description": "Embedding of an affine subspace to the ambient space, as an affine map.", "p": "mathlib"}, {"name": "vector_span_def", "description": "The definition of `vector_span`, for rewriting.", "p": "mathlib"}, {"name": "vsub_mem_vector_span_of_mem_span_points_of_mem_span_points", "description": " Subtracting two points in the affine span produces a vector in the\nspanning submodule.", "p": "mathlib"}, {"name": "affine_subspace.map_sup", "description": "", "p": "mathlib"}, {"name": "affine_subspace.complete_lattice", "description": "", "p": "mathlib"}, {"name": "affine_span_induction", "description": "An induction principle for span membership. If `p` holds for all elements of `s` and is\npreserved under certain affine combinations, then `p` holds for all elements of the span of `s`.", "p": "mathlib"}, {"name": "affine_span_eq_bot", "description": "The affine span of a set is `\u22a5` if and only if that set is empty.", "p": "mathlib"}, {"name": "affine_subspace.comap_id", "description": "", "p": "mathlib"}, {"name": "affine_subspace.map_symm", "description": "", "p": "mathlib"}, {"name": "vector_span_eq_span_vsub_set_left", "description": " The `vector_span` is the span of the pairwise subtractions with a\ngiven point on the left.", "p": "mathlib"}, {"name": "affine_subspace.direction", "description": " The direction of an affine subspace is the submodule spanned by\nthe pairwise differences of points.  (Except in the case of an empty\naffine subspace, where the direction is the zero submodule, every\nvector in the direction is the difference of two points in the affine\nsubspace.)", "p": "mathlib"}, {"name": "affine_subspace.map_span", "description": "", "p": "mathlib"}, {"name": "set.nonempty.affine_span", "description": "**Alias** of the reverse direction of `affine_span_nonempty`.", "p": "mathlib"}, {"name": "affine_subspace.comap_supr", "description": "", "p": "mathlib"}, {"name": "affine_subspace.vadd_mem_iff_mem_of_mem_direction", "description": " Adding a vector in the direction to a point produces a point in the subspace if and only if\nthe original point is in the subspace.", "p": "mathlib"}, {"name": "affine_subspace.map_map", "description": "", "p": "mathlib"}, {"name": "affine_subspace.inf_coe", "description": " The inf of two affine subspaces, coerced to a set, is the\nintersection of the two sets of points.", "p": "mathlib"}, {"name": "affine_subspace.mem_top", "description": "All points are in `\u22a4`.", "p": "mathlib"}, {"name": "affine_subspace.coe_direction_eq_vsub_set_right", "description": " Given a point in an affine subspace, the set of vectors in its\ndirection equals the set of vectors subtracting that point on the\nright.", "p": "mathlib"}, {"name": "vector_span_empty", "description": "The `vector_span` of the empty set is `\u22a5`.", "p": "mathlib"}, {"name": "vector_span_image_eq_span_vsub_set_right_ne", "description": " The `vector_span` of the image of a function is the span of the\npairwise subtractions with a given point on the right, excluding the\nsubtraction of that point from itself.", "p": "mathlib"}, {"name": "affine_subspace.subtype_linear", "description": "", "p": "mathlib"}, {"name": "vector_span_pair_rev", "description": "The `vector_span` of two points is the span of their difference (reversed).", "p": "mathlib"}, {"name": "affine_subspace.map_comap_le", "description": "", "p": "mathlib"}, {"name": "affine_subspace.mem_map_iff_mem_of_injective", "description": "", "p": "mathlib"}, {"name": "affine_subspace.direction_of_nonempty_eq_direction", "description": " `direction_of_nonempty` gives the same submodule as\n`direction`.", "p": "mathlib"}, {"name": "affine_subspace.direction_lt_of_nonempty", "description": " If one nonempty affine subspace is less than another, the same\napplies to their directions", "p": "mathlib"}, {"name": "affine_subspace.top_coe", "description": "`\u22a4`, coerced to a set, is the whole set of points.", "p": "mathlib"}, {"name": "vsub_rev_mem_vector_span_pair", "description": "The difference between two points (reversed) lies in their `vector_span`.", "p": "mathlib"}, {"name": "vector_span_pair", "description": "The `vector_span` of two points is the span of their difference.", "p": "mathlib"}, {"name": "affine_subspace.map", "description": "The image of an affine subspace under an affine map as an affine subspace.", "p": "mathlib"}, {"name": "affine_subspace.ext", "description": "", "p": "mathlib"}, {"name": "affine_subspace.inter_nonempty_of_nonempty_of_sup_direction_eq_top", "description": " If the directions of two nonempty affine subspaces span the whole\nmodule, they have nonempty intersection.", "p": "mathlib"}, {"name": "affine_subspace.parallel.direction_eq", "description": "", "p": "mathlib"}, {"name": "affine_subspace.preimage_coe_affine_span_singleton", "description": "", "p": "mathlib"}, {"name": "affine_subspace.comap_symm", "description": "", "p": "mathlib"}, {"name": "affine_subspace.subsingleton_of_subsingleton_span_eq_top", "description": "", "p": "mathlib"}, {"name": "affine_subspace.comap_span", "description": "", "p": "mathlib"}, {"name": "vector_span_range_eq_span_range_vsub_left", "description": " The `vector_span` of an indexed family is the span of the pairwise\nsubtractions with a given point on the left.", "p": "mathlib"}, {"name": "vector_span_insert_eq_vector_span", "description": " If a point is in the affine span of a set, adding it to that set\ndoes not change the vector span.", "p": "mathlib"}, {"name": "affine_subspace.injective_subtype", "description": "", "p": "mathlib"}, {"name": "affine_subspace.direction_eq_top_iff_of_nonempty", "description": " A nonempty affine subspace is `\u22a4` if and only if its direction is\n`\u22a4`.", "p": "mathlib"}, {"name": "affine_subspace.parallel", "description": " Two affine subspaces are parallel if one is related to the other by adding the same vector\nto all points.", "p": "mathlib"}, {"name": "vector_span_eq_span_vsub_set_right", "description": " The `vector_span` is the span of the pairwise subtractions with a\ngiven point on the right.", "p": "mathlib"}, {"name": "affine_subspace.mk'", "description": "Construct an affine subspace from a point and a direction.", "p": "mathlib"}, {"name": "vector_span_range_eq_span_range_vsub_right_ne", "description": " The `vector_span` of an indexed family is the span of the pairwise\nsubtractions with a given point on the right, excluding the subtraction\nof that point from itself.", "p": "mathlib"}, {"name": "affine_subspace.lt_iff_le_and_exists", "description": " A subspace is less than another if and only if it is less than or\nequal to the second subspace and there is a point only in the\nsecond.", "p": "mathlib"}, {"name": "affine_subspace.affine_span_coe", "description": " Coercing a subspace to a set then taking the affine span produces\nthe original subspace.", "p": "mathlib"}, {"name": "affine_subspace.span_Union", "description": " The span of a union of an indexed family of sets is the sup of\ntheir spans.", "p": "mathlib"}, {"name": "affine_subspace.comap_top", "description": "", "p": "mathlib"}, {"name": "affine_subspace.set_like", "description": "", "p": "mathlib"}, {"name": "affine_subspace.coe_direction_eq_vsub_set_left", "description": " Given a point in an affine subspace, the set of vectors in its\ndirection equals the set of vectors subtracting that point on the\nleft.", "p": "mathlib"}, {"name": "affine_subspace.sup_direction_le", "description": " The sup of the directions of two affine subspaces is less than or\nequal to the direction of their sup.", "p": "mathlib"}, {"name": "affine_subspace.comap", "description": "The preimage of an affine subspace under an affine map as an affine subspace.", "p": "mathlib"}, {"name": "affine_span_le", "description": "", "p": "mathlib"}, {"name": "affine_map.map_top_of_surjective", "description": "", "p": "mathlib"}, {"name": "affine_subspace.mk'_nonempty", "description": " An affine subspace constructed from a point and a direction is\nnonempty.", "p": "mathlib"}, {"name": "affine_subspace.direction_inf_of_mem_inf", "description": " If two affine subspaces have a point in their inf, the direction\nof their inf equals the inf of their directions.", "p": "mathlib"}, {"name": "affine_subspace.coe_direction_eq_vsub_set", "description": " The set of vectors in the direction of a nonempty affine subspace\nis given by `vsub_set`.", "p": "mathlib"}, {"name": "mem_vector_span_pair_rev", "description": " A vector lies in the `vector_span` of two points if and only if it is a multiple of their\ndifference (reversed).", "p": "mathlib"}, {"name": "vector_span_eq_span_vsub_set_left_ne", "description": " The `vector_span` is the span of the pairwise subtractions with a\ngiven point on the left, excluding the subtraction of that point from\nitself.", "p": "mathlib"}, {"name": "affine_subspace.vadd_mem_of_mem_direction", "description": " Adding a vector in the direction to a point in the subspace\nproduces a point in the subspace.", "p": "mathlib"}, {"name": "affine_subspace.mem_comap", "description": "", "p": "mathlib"}, {"name": "affine_subspace.nonempty_of_affine_span_eq_top", "description": "", "p": "mathlib"}, {"name": "affine_subspace.parallel_iff_direction_eq_and_eq_bot_iff_eq_bot", "description": "", "p": "mathlib"}, {"name": "affine_subspace.mem_affine_span_insert_iff", "description": " Given a point `p1` in an affine subspace `s`, and a point `p2`, a\npoint `p` is in the span of `s` with `p2` added if and only if it is a\nmultiple of `p2 -\u1d65 p1` added to a point in `s`.", "p": "mathlib"}, {"name": "affine_subspace.self_mem_mk'", "description": " An affine subspace constructed from a point and a direction contains\nthat point.", "p": "mathlib"}, {"name": "affine_subspace.map_direction", "description": "", "p": "mathlib"}, {"name": "affine_subspace.direction_inf_of_mem", "description": " If two affine subspaces have a point in common, the direction of\ntheir inf equals the inf of their directions.", "p": "mathlib"}, {"name": "affine_subspace.nonempty_iff_ne_bot", "description": "", "p": "mathlib"}, {"name": "affine_subspace.not_mem_bot", "description": "No points are in `\u22a5`.", "p": "mathlib"}, {"name": "affine_subspace.mk'_eq", "description": " Constructing an affine subspace from a point in a subspace and\nthat subspace's direction yields the original subspace.", "p": "mathlib"}, {"name": "affine_subspace.direction_of_nonempty", "description": " Alternative definition of the direction when the affine subspace\nis nonempty.  This is defined so that the order on submodules (as used\nin the definition of `submodule.span`) can be used in the proof of\n`coe_direction_eq_vsub_set`, and is not intended to be used beyond\nthat proof.", "p": "mathlib"}, {"name": "affine_subspace.parallel.refl", "description": "", "p": "mathlib"}, {"name": "affine_subspace.subtype_apply", "description": "", "p": "mathlib"}, {"name": "affine_subspace.parallel.symm", "description": "", "p": "mathlib"}, {"name": "affine_subspace.inhabited", "description": "", "p": "mathlib"}, {"name": "subset_affine_span", "description": "A set is contained in its affine span.", "p": "mathlib"}, {"name": "affine_map.vector_span_image_eq_submodule_map", "description": "", "p": "mathlib"}, {"name": "vector_span_range_eq_span_range_vsub_left_ne", "description": " The `vector_span` of an indexed family is the span of the pairwise\nsubtractions with a given point on the left, excluding the subtraction\nof that point from itself.", "p": "mathlib"}, {"name": "smul_vsub_rev_mem_vector_span_pair", "description": "A multiple of the difference between two points (reversed) lies in their `vector_span`.", "p": "mathlib"}, {"name": "smul_vsub_rev_vadd_mem_affine_span_pair", "description": " A multiple of the difference of two points added to the second point lies in their affine\nspan.", "p": "mathlib"}, {"name": "affine_span_singleton_union_vadd_eq_top_of_span_eq_top", "description": " Suppose a set of vectors spans `V`.  Then a point `p`, together\nwith those vectors added to `p`, spans `P`.", "p": "mathlib"}, {"name": "left_mem_affine_span_pair", "description": "The first of two points lies in their affine span.", "p": "mathlib"}, {"name": "coe_affine_span", "description": "The affine span, converted to a set, is `span_points`.", "p": "mathlib"}, {"name": "affine_subspace.inter_eq_singleton_of_nonempty_of_is_compl", "description": " If the directions of two nonempty affine subspaces are complements\nof each other, they intersect in exactly one point.", "p": "mathlib"}, {"name": "vsub_mem_vector_span_pair", "description": "The difference between two points lies in their `vector_span`.", "p": "mathlib"}, {"name": "affine_subspace.mem_inf_iff", "description": " A point is in the inf of two affine subspaces if and only if it is\nin both of them.", "p": "mathlib"}, {"name": "vsub_set_subset_vector_span", "description": "The `s -\u1d65 s` lies within the `vector_span k s`.", "p": "mathlib"}, {"name": "affine_subspace.vadd_mem_mk'", "description": " An affine subspace constructed from a point and a direction contains\nthe result of adding a vector in that direction to that point.", "p": "mathlib"}, {"name": "affine_span", "description": " The affine span of a set of points is the smallest affine subspace\ncontaining those points. (Actually defined here in terms of spans in\nmodules.)", "p": "mathlib"}, {"name": "smul_vsub_mem_vector_span_pair", "description": "A multiple of the difference between two points lies in their `vector_span`.", "p": "mathlib"}, {"name": "affine_map.line_map_mem", "description": "", "p": "mathlib"}, {"name": "affine_subspace.ext_iff", "description": "", "p": "mathlib"}, {"name": "affine_subspace.direction_mk'", "description": " The direction of an affine subspace constructed from a point and a\ndirection.", "p": "mathlib"}, {"name": "affine_subspace.comap_comap", "description": "", "p": "mathlib"}, {"name": "affine_subspace.coe_affine_span_singleton", "description": " The affine span of a single point, coerced to a set, contains just\nthat point.", "p": "mathlib"}, {"name": "affine_subspace.bot_ne_top", "description": "", "p": "mathlib"}, {"name": "vector_span_eq_span_vsub_set_right_ne", "description": " The `vector_span` is the span of the pairwise subtractions with a\ngiven point on the right, excluding the subtraction of that point from\nitself.", "p": "mathlib"}, {"name": "subset_span_points", "description": "A set is contained in its `span_points`.", "p": "mathlib"}, {"name": "affine_subspace.mem_map", "description": "", "p": "mathlib"}, {"name": "affine_subspace.nontrivial", "description": "", "p": "mathlib"}, {"name": "vector_span", "description": " The submodule spanning the differences of a (possibly empty) set\nof points.", "p": "mathlib"}, {"name": "affine_span_mono", "description": "`affine_span` is monotone.", "p": "mathlib"}, {"name": "affine_subspace.bot_coe", "description": "`\u22a5`, coerced to a set, is the empty set.", "p": "mathlib"}, {"name": "affine_subspace.parallel.trans", "description": "", "p": "mathlib"}, {"name": "affine_subspace.affine_span_eq_Inf", "description": " The affine span is the `Inf` of subspaces containing the given\npoints.", "p": "mathlib"}, {"name": "vector_span_image_eq_span_vsub_set_left_ne", "description": " The `vector_span` of the image of a function is the span of the\npairwise subtractions with a given point on the left, excluding the\nsubtraction of that point from itself.", "p": "mathlib"}, {"name": "affine_subspace.comap_mono", "description": "", "p": "mathlib"}, {"name": "affine_subspace.coe_subtype", "description": "", "p": "mathlib"}, {"name": "affine_subspace.coe_vsub", "description": "", "p": "mathlib"}, {"name": "affine_map.span_eq_top_of_surjective", "description": "", "p": "mathlib"}, {"name": "affine_span_coe_preimage_eq_top", "description": "A set, considered as a subset of its spanned affine subspace, spans the whole subspace.", "p": "mathlib"}, {"name": "affine_subspace", "description": " An `affine_subspace k P` is a subset of an `affine_space V P`\nthat, if not empty, has an affine space structure induced by a\ncorresponding subspace of the `module k V`.", "p": "mathlib"}, {"name": "affine_subspace.carrier", "description": " An `affine_subspace k P` is a subset of an `affine_space V P`\nthat, if not empty, has an affine space structure induced by a\ncorresponding subspace of the `module k V`.", "p": "mathlib"}, {"name": "affine_subspace.smul_vsub_vadd_mem", "description": " An `affine_subspace k P` is a subset of an `affine_space V P`\nthat, if not empty, has an affine space structure induced by a\ncorresponding subspace of the `module k V`.", "p": "mathlib"}, {"name": "affine_subspace.map_eq_bot_iff", "description": "", "p": "mathlib"}, {"name": "affine_subspace.le_def'", "description": " One subspace is less than or equal to another if and only if all\nits points are in the second subspace.", "p": "mathlib"}, {"name": "affine_subspace.span_points_subset_coe_of_subset_coe", "description": " If an affine subspace contains a set of points, it contains the\n`span_points` of that set.", "p": "mathlib"}, {"name": "vsub_mem_vector_span", "description": "Each pairwise difference is in the `vector_span`.", "p": "mathlib"}, {"name": "affine_subspace.mem_direction_iff_eq_vsub_right", "description": " Given a point in an affine subspace, a vector is in its direction\nif and only if it results from subtracting that point on the right.", "p": "mathlib"}, {"name": "affine_subspace.eq_bot_or_nonempty", "description": "", "p": "mathlib"}, {"name": "affine_subspace.mem_affine_span_singleton", "description": " A point is in the affine span of a single point if and only if\nthey are equal.", "p": "mathlib"}, {"name": "vector_span_range_eq_span_range_vsub_right", "description": " The `vector_span` of an indexed family is the span of the pairwise\nsubtractions with a given point on the right.", "p": "mathlib"}, {"name": "affine_subspace.direction_top", "description": "The direction of `\u22a4` is the whole module as a submodule.", "p": "mathlib"}, {"name": "span_points", "description": " The points in the affine span of a (possibly empty) set of\npoints. Use `affine_span` instead to get an `affine_subspace k P`.", "p": "mathlib"}, {"name": "affine_span_insert_affine_span", "description": " Taking the affine span of a set, adding a point and taking the\nspan again produces the same results as adding the point to the set\nand taking the span.", "p": "mathlib"}, {"name": "affine_subspace.parallel_comm", "description": "", "p": "mathlib"}, {"name": "affine_subspace.direction_sup", "description": " The direction of the sup of two nonempty affine subspaces is the\nsup of the two directions and of any one difference between points in\nthe two subspaces.", "p": "mathlib"}, {"name": "affine_subspace.parallel.vector_span_eq", "description": "", "p": "mathlib"}, {"name": "affine_subspace.map_le_iff_le_comap", "description": "", "p": "mathlib"}, {"name": "affine_subspace.map_supr", "description": "", "p": "mathlib"}, {"name": "affine_subspace.mem_direction_iff_eq_vsub", "description": " A vector is in the direction of a nonempty affine subspace if and\nonly if it is the subtraction of two vectors in the subspace.", "p": "mathlib"}, {"name": "affine_subspace.affine_span_eq_top_iff_vector_span_eq_top_of_nonempty", "description": "For a nonempty set, the affine span is `\u22a4` iff its vector span is `\u22a4`.", "p": "mathlib"}, {"name": "affine_subspace.vadd_mem_iff_mem_direction", "description": " Adding a vector to a point in a subspace produces a point in the\nsubspace if and only if the vector is in the direction.", "p": "mathlib"}, {"name": "affine_span.nonempty", "description": "The affine span of a nonempty set is nonempty.", "p": "mathlib"}, {"name": "vector_span_singleton", "description": "The `vector_span` of a single point is `\u22a5`.", "p": "mathlib"}, {"name": "affine_map.line_map_mem_affine_span_pair", "description": "A combination of two points expressed with `line_map` lies in their affine span.", "p": "mathlib"}, {"name": "affine_subspace.direction_affine_span_insert", "description": " The direction of the span of the result of adding a point to a\nnonempty affine subspace is the sup of the direction of that subspace\nand of any one difference between that point and a point in the\nsubspace.", "p": "mathlib"}, {"name": "affine_equiv.span_eq_top_iff", "description": "", "p": "mathlib"}, {"name": "affine_span_pair_le_of_right_mem", "description": " One line is contained in another differing in the second point if the second point of the\nfirst line is contained in the second line.", "p": "mathlib"}, {"name": "affine_subspace.le_def", "description": " The `\u2264` order on subspaces is the same as that on the corresponding\nsets.", "p": "mathlib"}, {"name": "affine_subspace.gi", "description": " The Galois insertion formed by `affine_span` and coercion back to\na set.", "p": "mathlib"}, {"name": "affine_subspace.span_union", "description": "The span of a union of sets is the sup of their spans.", "p": "mathlib"}, {"name": "affine_subspace.vector_span_eq_top_of_affine_span_eq_top", "description": "If the affine span of a set is `\u22a4`, then the vector span of the same set is the `\u22a4`.", "p": "mathlib"}, {"name": "affine_subspace.exists_of_lt", "description": " If a subspace is less than another, there is a point only in the\nsecond.", "p": "mathlib"}, {"name": "affine_map.line_map_rev_mem_affine_span_pair", "description": " A combination of two points expressed with `line_map` (with the two points reversed) lies in\ntheir affine span.", "p": "mathlib"}, {"name": "vadd_right_mem_affine_span_pair", "description": " A vector added to the second point lies in the affine span of two points if and only if it is\na multiple of their difference.", "p": "mathlib"}, {"name": "affine_subspace.direction_le", "description": " If one affine subspace is less than or equal to another, the same\napplies to their directions.", "p": "mathlib"}, {"name": "submodule.to_affine_subspace", "description": "Reinterpret `p : submodule k V` as an `affine_subspace k V`.", "p": "mathlib"}, {"name": "affine_subspace.sup_direction_lt_of_nonempty_of_inter_empty", "description": " The sup of the directions of two nonempty affine subspaces with\nempty intersection is less than the direction of their sup.", "p": "mathlib"}, {"name": "right_mem_affine_span_pair", "description": "The second of two points lies in their affine span.", "p": "mathlib"}, {"name": "affine_subspace.coe_eq_bot_iff", "description": "", "p": "mathlib"}, {"name": "vadd_left_mem_affine_span_pair", "description": " A vector added to the first point lies in the affine span of two points if and only if it is\na multiple of their difference.", "p": "mathlib"}, {"name": "direction_affine_span", "description": "The direction of the affine span is the `vector_span`.", "p": "mathlib"}, {"name": "affine_subspace.direction_inf", "description": " The direction of the inf of two affine subspaces is less than or\nequal to the inf of their directions.", "p": "mathlib"}, {"name": "affine_subspace.eq_univ_of_subsingleton_span_eq_top", "description": "", "p": "mathlib"}, {"name": "affine_subspace.coe_eq_univ_iff", "description": "", "p": "mathlib"}, {"name": "affine_subspace.vsub_left_mem_direction_iff_mem", "description": " Given a point in an affine subspace, a result of subtracting that\npoint on the left is in the direction if and only if the other point\nis in the subspace.", "p": "mathlib"}, {"name": "affine_subspace.affine_span_pair_parallel_iff_vector_span_eq", "description": "", "p": "mathlib"}, {"name": "affine_subspace.span_empty", "description": "The span of the empty set is `\u22a5`.", "p": "mathlib"}, {"name": "affine_span_pair_le_of_mem_of_mem", "description": "The span of two points that lie in an affine subspace is contained in that subspace.", "p": "mathlib"}, {"name": "vadd_mem_span_points_of_mem_span_points_of_mem_vector_span", "description": " Adding a point in the affine span and a vector in the spanning\nsubmodule produces a point in the affine span.", "p": "mathlib"}, {"name": "affine_subspace.coe_injective", "description": "Two affine subspaces are equal if they have the same points.", "p": "mathlib"}, {"name": "tactic.auto_cases.opens_find_tac", "description": "Find an `auto_cases_tac` which matches `topological_space.opens`.", "p": "mathlib"}, {"name": "topologi