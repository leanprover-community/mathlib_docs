_mul_left_eq", "description": "", "p": "mathlib"}, {"name": "ordinal.principal_add_of_principal_mul_opow", "description": "", "p": "mathlib"}, {"name": "ordinal.add_absorp", "description": "", "p": "mathlib"}, {"name": "ordinal.principal.iterate_lt", "description": "", "p": "mathlib"}, {"name": "ordinal.mul_principal_add_is_principal_add", "description": "", "p": "mathlib"}, {"name": "ordinal.principal_add_omega_opow", "description": "", "p": "mathlib"}, {"name": "ordinal.principal_add_iff_add_lt_ne_self", "description": "", "p": "mathlib"}, {"name": "ordinal.principal_mul_is_limit", "description": "", "p": "mathlib"}, {"name": "ordinal.principal_add_is_limit", "description": "", "p": "mathlib"}, {"name": "ordinal.principal_mul_two", "description": "", "p": "mathlib"}, {"name": "ordinal.exists_lt_add_of_not_principal_add", "description": "", "p": "mathlib"}, {"name": "ordinal.op_eq_self_of_principal", "description": "", "p": "mathlib"}, {"name": "ordinal.principal_mul_iff_le_two_or_omega_opow_opow", "description": "The main characterization theorem for multiplicative principal ordinals.", "p": "mathlib"}, {"name": "ordinal.principal_add_of_principal_mul", "description": "", "p": "mathlib"}, {"name": "ordinal.principal_add_omega", "description": "", "p": "mathlib"}, {"name": "ordinal.opow_omega", "description": "", "p": "mathlib"}, {"name": "ordinal.nfp_le_of_principal", "description": "", "p": "mathlib"}, {"name": "ordinal.principal_one_iff", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.is_scalar_tower'", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.set_like", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.smul_mem_iff", "description": "", "p": "mathlib"}, {"name": "set_like.mk_smul_mk", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.smul_mem", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.smul_mem_class.coe_subtype", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.subtype_eq_val", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.zero_mem", "description": "", "p": "mathlib"}, {"name": "set_like.coe_vadd", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.coe_image_orbit", "description": "Orbits in a `sub_mul_action` coincide with orbits in the ambient space.", "p": "mathlib"}, {"name": "sub_mul_action.neg_mem_iff", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.copy_eq", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.coe_mk", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.has_zero", "description": " If the scalar product forms a `module`, and the `sub_mul_action` is not `\u22a5`, then the\nsubset inherits the zero.", "p": "mathlib"}, {"name": "sub_mul_action.smul_mem_iff'", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.neg_mem", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.subtype", "description": "Embedding of a submodule `p` to the ambient space `M`.", "p": "mathlib"}, {"name": "sub_mul_action.stabilizer_of_sub_mul.submonoid", "description": "Stabilizers in monoid sub_mul_action coincide with stabilizers in the ambient space", "p": "mathlib"}, {"name": "set_like.coe_smul", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.smul_mem_class.subtype", "description": "The natural `mul_action_hom` over `R` from a `sub_mul_action` of `M` to `M`.", "p": "mathlib"}, {"name": "set_like.has_vadd", "description": "A subset closed under the additive action inherits that action.", "p": "mathlib"}, {"name": "set_like.vadd_def", "description": "", "p": "mathlib"}, {"name": "set_like.mk_vadd_mk", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.smul_mem_class", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.mul_action", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.mul_action'", "description": "If the scalar product forms a `mul_action`, then the subset inherits this action", "p": "mathlib"}, {"name": "sub_mul_action.stabilizer_of_sub_mul", "description": "Stabilizers in group sub_mul_action coincide with stabilizers in the ambient space", "p": "mathlib"}, {"name": "set_like.has_smul", "description": "A subset closed under the scalar action inherits that action.", "p": "mathlib"}, {"name": "set_like.smul_def", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.coe_smul", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.coe_copy", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.has_bot", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.has_neg", "description": "", "p": "mathlib"}, {"name": "vadd_mem_class", "description": " `vadd_mem_class S R M` says `S` is a type of subsets `s \u2264 M` that are closed under the\nadditive action of `R` on `M`.\n\nNote that only `R` is marked as an `out_param` here, since `M` is supplied by the `set_like`\nclass instead.", "p": "mathlib"}, {"name": "vadd_mem_class.vadd_mem", "description": " `vadd_mem_class S R M` says `S` is a type of subsets `s \u2264 M` that are closed under the\nadditive action of `R` on `M`.\n\nNote that only `R` is marked as an `out_param` here, since `M` is supplied by the `set_like`\nclass instead.", "p": "mathlib"}, {"name": "sub_mul_action.mem_carrier", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.ext", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.subtype_apply", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.coe_neg", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.copy", "description": " Copy of a sub_mul_action with a new `carrier` equal to the old one. Useful to fix definitional\nequalities.", "p": "mathlib"}, {"name": "sub_mul_action.smul_of_tower_mem", "description": "", "p": "mathlib"}, {"name": "sub_mul_action", "description": "A sub_mul_action is a set which is closed under scalar multiplication.", "p": "mathlib"}, {"name": "sub_mul_action.carrier", "description": "A sub_mul_action is a set which is closed under scalar multiplication.", "p": "mathlib"}, {"name": "sub_mul_action.smul_mem'", "description": "A sub_mul_action is a set which is closed under scalar multiplication.", "p": "mathlib"}, {"name": "sub_mul_action.smul_mem_class.to_mul_action", "description": "A `sub_mul_action` of a `mul_action` is a `mul_action`.", "p": "mathlib"}, {"name": "sub_mul_action.inhabited", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.has_smul", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.has_smul'", "description": "", "p": "mathlib"}, {"name": "smul_mem_class", "description": " `smul_mem_class S R M` says `S` is a type of subsets `s \u2264 M` that are closed under the\nscalar action of `R` on `M`.\n\nNote that only `R` is marked as an `out_param` here, since `M` is supplied by the `set_like`\nclass instead.", "p": "mathlib"}, {"name": "smul_mem_class.smul_mem", "description": " `smul_mem_class S R M` says `S` is a type of subsets `s \u2264 M` that are closed under the\nscalar action of `R` on `M`.\n\nNote that only `R` is marked as an `out_param` here, since `M` is supplied by the `set_like`\nclass instead.", "p": "mathlib"}, {"name": "set_like.forall_smul_mem_iff", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.is_central_scalar", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.coe_smul_of_tower", "description": "", "p": "mathlib"}, {"name": "string.pop_back", "description": "", "p": "core"}, {"name": "string.popn_back", "description": "", "p": "core"}, {"name": "string.iterator", "description": "", "p": "core"}, {"name": "string.iterator.extract", "description": "", "p": "core"}, {"name": "string.iterator.set_curr", "description": "In the VM, `set_curr` is constant time if the string being iterated is not shared and linear time\n  if it is.", "p": "core"}, {"name": "string.back", "description": "", "p": "core"}, {"name": "string.iterator.next_to_string", "description": "", "p": "core"}, {"name": "string_imp", "description": "In the VM, strings are implemented using a dynamic array and UTF-8 encoding.\n\n  TODO: we currently cannot mark string_imp as private because\n  we need to bind string_imp.mk and string_imp.cases_on in the VM.", "p": "core"}, {"name": "string_imp.data", "description": "In the VM, strings are implemented using a dynamic array and UTF-8 encoding.\n\n  TODO: we currently cannot mark string_imp as private because\n  we need to bind string_imp.mk and string_imp.cases_on in the VM.", "p": "core"}, {"name": "string.empty", "description": "", "p": "core"}, {"name": "string.str", "description": "", "p": "core"}, {"name": "string.iterator.curr", "description": "", "p": "core"}, {"name": "string.fold", "description": "", "p": "core"}, {"name": "string.iterator.prevn", "description": "", "p": "core"}, {"name": "string.singleton", "description": "", "p": "core"}, {"name": "char.to_string", "description": "", "p": "core"}, {"name": "string.iterator.nextn", "description": "", "p": "core"}, {"name": "string.iterator.has_next", "description": "", "p": "core"}, {"name": "string.str_ne_empty", "description": "", "p": "core"}, {"name": "string.iterator.next", "description": "", "p": "core"}, {"name": "string.inhabited", "description": "", "p": "core"}, {"name": "string.iterator.extract_core", "description": "", "p": "core"}, {"name": "string.push", "description": "The internal implementation uses dynamic arrays and will perform destructive updates\n  if the string is not shared.", "p": "core"}, {"name": "string.iterator.prev", "description": "", "p": "core"}, {"name": "string.has_sizeof", "description": "", "p": "core"}, {"name": "string.str_ne_str_right", "description": "", "p": "core"}, {"name": "string.to_list", "description": "O(n) in the VM, where n is the length of the string", "p": "core"}, {"name": "string.intercalate", "description": "", "p": "core"}, {"name": "string.is_empty", "description": "", "p": "core"}, {"name": "string.backn", "description": "", "p": "core"}, {"name": "string.empty_ne_str", "description": "", "p": "core"}, {"name": "string.iterator.insert", "description": "", "p": "core"}, {"name": "string.iterator.remove", "description": "", "p": "core"}, {"name": "string.iterator.has_prev", "description": "", "p": "core"}, {"name": "string.has_decidable_eq", "description": "", "p": "core"}, {"name": "string.iterator.prev_to_string", "description": "", "p": "core"}, {"name": "list.as_string", "description": "", "p": "core"}, {"name": "string", "description": "", "p": "core"}, {"name": "string.str_ne_str_left", "description": "", "p": "core"}, {"name": "string.has_append", "description": "", "p": "core"}, {"name": "string.append", "description": "The internal implementation uses dynamic arrays and will perform destructive updates\n  if the string is not shared.", "p": "core"}, {"name": "string.has_decidable_lt", "description": "Remark: this function has a VM builtin efficient implementation.", "p": "core"}, {"name": "string.iterator_imp", "description": "In the VM, the string iterator is implemented as a pointer to the string being iterated + index.\n\n  TODO: we currently cannot mark interator_imp as private because\n  we need to bind string_imp.mk and string_imp.cases_on in the VM.", "p": "core"}, {"name": "string.iterator_imp.fst", "description": "In the VM, the string iterator is implemented as a pointer to the string being iterated + index.\n\n  TODO: we currently cannot mark interator_imp as private because\n  we need to bind string_imp.mk and string_imp.cases_on in the VM.", "p": "core"}, {"name": "string.iterator_imp.snd", "description": "In the VM, the string iterator is implemented as a pointer to the string being iterated + index.\n\n  TODO: we currently cannot mark interator_imp as private because\n  we need to bind string_imp.mk and string_imp.cases_on in the VM.", "p": "core"}, {"name": "string.iterator.to_string", "description": "In the VM, `to_string` is a constant time operation.", "p": "core"}, {"name": "string.has_lt", "description": "", "p": "core"}, {"name": "string.front", "description": "", "p": "core"}, {"name": "string.join", "description": "", "p": "core"}, {"name": "string.length", "description": "", "p": "core"}, {"name": "string.iterator.to_end", "description": "", "p": "core"}, {"name": "string.to_nat", "description": "", "p": "core"}, {"name": "string.mk_iterator", "description": "", "p": "core"}, {"name": "tactic.simplify", "description": "`simplify s e cfg r prove` simplify `e` using `s` using bottom-up traversal.\n`discharger` is a tactic for dischaging new subgoals created by the simplifier.\n If it fails, the simplifier tries to discharge the subgoal by simplifying it to `true`.\n\n The parameter `to_unfold` specifies definitions that should be delta-reduced,\n and projection applications that should be unfolded.", "p": "core"}, {"name": "tactic.delta", "description": "Delta reduce the given constant names", "p": "core"}, {"name": "tactic.to_simp_lemmas", "description": "", "p": "core"}, {"name": "simp.default_max_steps", "description": "", "p": "core"}, {"name": "mk_simp_attr_decl_name", "description": "Prefix the given `attr_name` with `\"simp_attr\"`.", "p": "core"}, {"name": "tactic.simp_config", "description": "", "p": "core"}, {"name": "tactic.simp_config.max_steps", "description": "", "p": "core"}, {"name": "tactic.simp_config.contextual", "description": "", "p": "core"}, {"name": "tactic.simp_config.lift_eq", "description": "", "p": "core"}, {"name": "tactic.simp_config.canonize_instances", "description": "", "p": "core"}, {"name": "tactic.simp_config.canonize_proofs", "description": "", "p": "core"}, {"name": "tactic.simp_config.use_axioms", "description": "", "p": "core"}, {"name": "tactic.simp_config.zeta", "description": "", "p": "core"}, {"name": "tactic.simp_config.beta", "description": "", "p": "core"}, {"name": "tactic.simp_config.eta", "description": "", "p": "core"}, {"name": "tactic.simp_config.proj", "description": "", "p": "core"}, {"name": "tactic.simp_config.iota", "description": "", "p": "core"}, {"name": "tactic.simp_config.iota_eqn", "description": "", "p": "core"}, {"name": "tactic.simp_config.constructor_eq", "description": "", "p": "core"}, {"name": "tactic.simp_config.single_pass", "description": "", "p": "core"}, {"name": "tactic.simp_config.fail_if_unchanged", "description": "", "p": "core"}, {"name": "tactic.simp_config.memoize", "description": "", "p": "core"}, {"name": "tactic.simp_config.trace_lemmas", "description": "", "p": "core"}, {"name": "tactic.dsimplify", "description": "", "p": "core"}, {"name": "tactic.simplify_top_down", "description": "", "p": "core"}, {"name": "simp_lemmas.rewrite", "description": "`simp_lemmas.rewrite s e prove R` apply a simplification lemma from 's'\n\n  - 'e'     is the expression to be \"simplified\"\n  - 'prove' is used to discharge proof obligations.\n  - 'r'     is the equivalence relation being used (e.g., 'eq', 'iff')\n  - 'md'    is the transparency; how aggresively should the simplifier perform reductions.\n\n  Result (new_e, pr) is the new expression 'new_e' and a proof (pr : e R new_e)", "p": "core"}, {"name": "tactic.simp_all_entry", "description": "", "p": "core"}, {"name": "tactic.simp_all_entry.h", "description": "", "p": "core"}, {"name": "tactic.simp_all_entry.new_type", "description": "", "p": "core"}, {"name": "tactic.simp_all_entry.pr", "description": "", "p": "core"}, {"name": "tactic.simp_all_entry.s", "description": "", "p": "core"}, {"name": "simp_lemmas.erase_simp_lemmas", "description": "Remove all simp lemmas from the table.", "p": "core"}, {"name": "tactic.dunfold_head", "description": "Tries to unfold `e` if it is a constant or a constant application.\n   Remark: this is not a recursive procedure.", "p": "core"}, {"name": "tactic.non_dep_prop_hyps", "description": "Return the list of hypothesis that are propositions and do not have\n  forward dependencies.", "p": "core"}, {"name": "simp_lemmas", "description": " Simp lemmas are used by the \"simplifier\" family of tactics.\n`simp_lemmas` is essentially a pair of tables `rb_map (expr_type \u00d7 name) (priority_list simp_lemma)`.\nOne of the tables is for congruences and one is for everything else.\nAn individual simp lemma is:\n- A kind which can be `Refl`, `Simp` or `Congr`.\n- A pair of `expr`s `l ~> r`. The rb map is indexed by the name of `get_app_fn(l)`.\n- A proof that `l = r` or `l \u2194 r`.\n- A list of the metavariables that must be filled before the proof can be applied.\n- A priority number", "p": "core"}, {"name": "tactic.mk_simp_attr", "description": "", "p": "core"}, {"name": "tactic.dsimp_hyp", "description": "", "p": "core"}, {"name": "tactic.join_user_simp_lemmas_core", "description": "", "p": "core"}, {"name": "tactic.mk_eq_simp_ext", "description": "", "p": "core"}, {"name": "tactic.delta_config", "description": "", "p": "core"}, {"name": "tactic.delta_config.max_steps", "description": "", "p": "core"}, {"name": "tactic.delta_config.visit_instances", "description": "", "p": "core"}, {"name": "tactic.delta_target", "description": "", "p": "core"}, {"name": "simp_lemmas.add", "description": " Add a simplification lemma by an expression `p`. Some conditions on `p` must hold for it to be added, see list below.\nIf your lemma is not being added, you can see the reasons by setting `set_option trace.simp_lemmas true`.\n\n- `p` must have the type `\u03a0 (h\u2081 : _) ... (h\u2099 : _), LHS ~ RHS` for some reflexive, transitive relation (usually `=`).\n- Any of the hypotheses `h\u1d62` should either be present in `LHS` or otherwise a `Prop` or a typeclass instance.\n- `LHS` should not occur within `RHS`.\n- `LHS` should not occur within a hypothesis `h\u1d62`.", "p": "core"}, {"name": "tactic.dsimplify_core", "description": "Remark: the configuration parameters `cfg.md` and `cfg.eta` are ignored by this tactic.", "p": "core"}, {"name": "tactic.ext_simplify_core", "description": "`ext_simplify_core a c s discharger pre post r e`:\n\n- `a : \u03b1` - initial user data\n- `c : simp_config` - simp configuration options\n- `s : simp_lemmas` - the set of simp_lemmas to use. Remark: the simplification lemmas are not applied automatically like in the simplify tactic. The caller must use them at pre/post.\n- `discharger : \u03b1 \u2192 tactic \u03b1` - tactic for dischaging hypothesis in conditional rewriting rules. The argument '\u03b1' is the current user data.\n- `pre a s r p e` is invoked before visiting the children of subterm 'e'.\n  + arguments:\n    - `a` is the current user data\n    - `s` is the updated set of lemmas if 'contextual' is `tt`,\n    - `r` is the simplification relation being used,\n    - `p` is the \"parent\" expression (if there is one).\n    - `e` is the current subexpression in question.\n  + if it succeeds the result is `(new_a, new_e, new_pr, flag)` where\n    - `new_a` is the new value for the user data\n    - `new_e` is a new expression s.t. `r e new_e`\n    - `new_pr` is a proof for `r e new_e`, If it is none, the proof is assumed to be by reflexivity\n    - `flag`  if tt `new_e` children should be visited, and `post` invoked.\n- `(post a s r p e)` is invoked after visiting the children of subterm `e`,\n  The output is similar to `(pre a r s p e)`, but the 'flag' indicates whether the new expression should be revisited or not.\n- `r` is the simplification relation. Usually `=` or `\u2194`.\n- `e` is the input expression to be simplified.\n\nThe method returns `(a,e,pr)` where\n\n - `a` is the final user data\n - `e` is the new expression\n - `pr` is the proof that the given expression equals the input expression.\n\nNote that `ext_simplify_core` will succeed even if `pre` and `post` fail, as failures are used to indicate that the method should move on to the next subterm.\nIf it is desirable to propagate errors from `pre`, they can be propagated through the \"user data\".\nAn easy way to do this is to call `tactic.capture (do ...)` in the parts of `pre`/`post` where errors matter, and then use `tactic.unwrap a` on the result.\n\nAdditionally, `ext_simplify_core` does not propagate changes made to the tactic state by `pre` and `post.\nIf it is desirable to propagate changes to the tactic state in addition to errors, use `tactic.resume` instead of `tactic.unwrap`.", "p": "core"}, {"name": "tactic.id_tag.simp", "description": "", "p": "core"}, {"name": "simp_lemmas.add_congr", "description": " Adds a congruence simp lemma to simp_lemmas.\nA congruence simp lemma is a lemma that breaks the simplification down into separate problems.\nFor example, to simplify `a \u2227 b` to `c \u2227 d`, we should try to simp `a` to `c` and `b` to `d`.\nFor examples of congruence simp lemmas look for lemmas with the `@[congr]` attribute.\n```lean\nlemma if_simp_congr ... (h_c : b \u2194 c) (h_t : x = u) (h_e : y = v) : ite b x y = ite c u v := ...\nlemma imp_congr_right (h : a \u2192 (b \u2194 c)) : (a \u2192 b) \u2194 (a \u2192 c) := ...\nlemma and_congr (h\u2081 : a \u2194 c) (h\u2082 : b \u2194 d) : (a \u2227 b) \u2194 (c \u2227 d) := ...\n```", "p": "core"}, {"name": "simp_lemmas.add_simp", "description": "Add a simplification lemma by it's declaration name. See `simp_lemmas.add` for more information.", "p": "core"}, {"name": "tactic.simp_top_down", "description": "", "p": "core"}, {"name": "simp_lemmas.append_with_symm", "description": "Add expressions to a set of simp lemmas using `simp_lemmas.add`.\n\n This is the new version of `simp_lemmas.append`,\n which also allows you to set the `symm` flag.", "p": "core"}, {"name": "tactic.simp_intros_config", "description": "", "p": "core"}, {"name": "tactic.simp_intros_config.to_simp_config", "description": "", "p": "core"}, {"name": "tactic.simp_intros_config.use_hyps", "description": "", "p": "core"}, {"name": "tactic.get_simp_lemmas_or_default", "description": "", "p": "core"}, {"name": "tactic.simp_bottom_up", "description": "", "p": "core"}, {"name": "tactic.simp_intros_aux", "description": "", "p": "core"}, {"name": "simp_lemmas.mk_default", "description": "Makes the default simp_lemmas table which is composed of all lemmas tagged with `simp`.", "p": "core"}, {"name": "tactic.unfold_proj_config", "description": "", "p": "core"}, {"name": "tactic.unfold_proj_config.to_dsimp_config", "description": "", "p": "core"}, {"name": "tactic.dunfold_target", "description": "", "p": "core"}, {"name": "simp_attr.norm", "description": "", "p": "core"}, {"name": "tactic.revert_and_transform", "description": "Revert a local constant, change its type using `transform`.", "p": "core"}, {"name": "tactic.simplify_bottom_up", "description": "", "p": "core"}, {"name": "is_valid_simp_lemma", "description": "", "p": "core"}, {"name": "simp_lemmas.join", "description": "Merge the simp_lemma tables.", "p": "core"}, {"name": "tactic.simp_intros", "description": "", "p": "core"}, {"name": "tactic.dunfold_hyp", "description": "", "p": "core"}, {"name": "simp_lemmas.rewrites", "description": "", "p": "core"}, {"name": "tactic.join_user_simp_lemmas", "description": "", "p": "core"}, {"name": "is_valid_simp_lemma_cnst", "description": "", "p": "core"}, {"name": "tactic.unfold_projs", "description": "", "p": "core"}, {"name": "tactic.dsimp_config", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.md", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.max_steps", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.canonize_instances", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.single_pass", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.fail_if_unchanged", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.eta", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.zeta", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.beta", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.proj", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.iota", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.unfold_reducible", "description": "", "p": "core"}, {"name": "tactic.dsimp_config.memoize", "description": "", "p": "core"}, {"name": "simp_lemmas.erase", "description": "Remove the given lemmas from the table. Use the names of the lemmas.", "p": "core"}, {"name": "tactic.unfold_proj", "description": "If `e` is a projection application, try to unfold it, otherwise fail.", "p": "core"}, {"name": "tactic.collect_ctx_simps", "description": "", "p": "core"}, {"name": "tactic.delta_hyp", "description": "", "p": "core"}, {"name": "tactic.simp_hyp", "description": "", "p": "core"}, {"name": "tactic.dsimp_target", "description": "", "p": "core"}, {"name": "tactic.unfold_projs_target", "description": "", "p": "core"}, {"name": "tactic.simp_all", "description": "", "p": "core"}, {"name": "tactic.intro1_aux", "description": "", "p": "core"}, {"name": "simp_lemmas.append", "description": "Add expressions to a set of simp lemmas using `simp_lemmas.add`.\n\n This is the backwards-compatibility version of `simp_lemmas.append_with_symm`,\n and sets all `symm` flags to `ff`.", "p": "core"}, {"name": "tactic.dunfold", "description": "", "p": "core"}, {"name": "tactic.trace_algebra_info", "description": "", "p": "core"}, {"name": "simp_lemmas.has_to_tactic_format", "description": "", "p": "core"}, {"name": "tactic.dunfold_config", "description": "", "p": "core"}, {"name": "tactic.dunfold_config.to_dsimp_config", "description": "", "p": "core"}, {"name": "simp_lemmas.mk", "description": "Make a new table of simp lemmas", "p": "core"}, {"name": "tactic.simp_target", "description": "", "p": "core"}, {"name": "simp_lemmas.pp", "description": "", "p": "core"}, {"name": "simp_lemmas.dsimplify", "description": "(Definitional) Simplify the given expression using *only* reflexivity equality lemmas from the given set of lemmas.\n  The resulting expression is definitionally equal to the input.\n\n  The list `u` contains defintions to be delta-reduced, and projections to be reduced.", "p": "core"}, {"name": "tactic.get_user_simp_lemmas", "description": "### Example usage:\n```lean\n-- make a new simp attribute called \"my_reduction\"\nrun_cmd mk_simp_attr `my_reduction\n-- Add \"my_reduction\" attributes to these if-reductions\nattribute [my_reduction] if_pos if_neg dif_pos dif_neg\n\n-- will return the simp_lemmas with the `my_reduction` attribute.\n#eval get_user_simp_lemmas `my_reduction\n\n```", "p": "core"}, {"name": "simp_lemmas.drewrite", "description": "`simp_lemmas.drewrite s e` tries to rewrite 'e' using only refl lemmas in 's'", "p": "core"}, {"name": "tactic.unfold_projs_hyp", "description": "", "p": "core"}, {"name": "tactic.get_eqn_lemmas_for", "description": "`get_eqn_lemmas_for deps d` returns the automatically generated equational lemmas for definition d.\n  If deps is tt, then lemmas for automatically generated auxiliary declarations used to define d are also included.", "p": "core"}, {"name": "list.of_mem_lookup", "description": "", "p": "mathlib"}, {"name": "list.lookup_all_cons_eq", "description": "", "p": "mathlib"}, {"name": "list.kunion", "description": " `kunion l\u2081 l\u2082` is the append to l\u2081 of l\u2082 after, for each key in l\u2081, the\nfirst matching pair in l\u2082 is erased.", "p": "mathlib"}, {"name": "list.mem_keys_of_mem_keys_kerase", "description": "", "p": "mathlib"}, {"name": "list.dedupkeys", "description": "Remove entries with duplicate keys from `l : list (sigma \u03b2)`.", "p": "mathlib"}, {"name": "list.not_mem_keys_of_nodupkeys_cons", "description": "", "p": "mathlib"}, {"name": "list.head_lookup_all", "description": "", "p": "mathlib"}, {"name": "list.lookup_kinsert_ne", "description": "", "p": "mathlib"}, {"name": "list.kerase_append_right", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys.kerase", "description": "", "p": "mathlib"}, {"name": "list.not_mem_keys", "description": "", "p": "mathlib"}, {"name": "list.sizeof_kerase", "description": "", "p": "mathlib"}, {"name": "list.mem_keys_kinsert", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys", "description": "Determines whether the store uses a key several times.", "p": "mathlib"}, {"name": "list.lookup_kunion_right", "description": "", "p": "mathlib"}, {"name": "list.mem_lookup", "description": "", "p": "mathlib"}, {"name": "list.lookup_all_cons_ne", "description": "", "p": "mathlib"}, {"name": "list.lookup_ext", "description": "", "p": "mathlib"}, {"name": "list.lookup_kerase_ne", "description": "", "p": "mathlib"}, {"name": "list.lookup_is_some", "description": "", "p": "mathlib"}, {"name": "list.lookup", "description": "`lookup a l` is the first value in `l` corresponding to the key `a`,\n or `none` if no such element exists.", "p": "mathlib"}, {"name": "list.kerase_of_not_mem_keys", "description": "", "p": "mathlib"}, {"name": "list.lookup_kinsert", "description": "", "p": "mathlib"}, {"name": "list.exists_of_mem_keys", "description": "", "p": "mathlib"}, {"name": "list.keys_nil", "description": "", "p": "mathlib"}, {"name": "list.kerase_cons_ne", "description": "", "p": "mathlib"}, {"name": "list.keys", "description": "List of keys from a list of key-value pairs", "p": "mathlib"}, {"name": "list.lookup_all", "description": "`lookup_all a l` is the list of all values in `l` corresponding to the key `a`.", "p": "mathlib"}, {"name": "list.lookup_dedupkeys", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys.eq_of_fst_eq", "description": "", "p": "mathlib"}, {"name": "list.mem_lookup_iff", "description": "", "p": "mathlib"}, {"name": "list.kerase_cons_eq", "description": "", "p": "mathlib"}, {"name": "list.lookup_all_nil", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys.kunion", "description": "", "p": "mathlib"}, {"name": "list.kerase_append_left", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys.sublist", "description": "", "p": "mathlib"}, {"name": "list.kextract_eq_lookup_kerase", "description": "", "p": "mathlib"}, {"name": "list.kerase_keys_subset", "description": "", "p": "mathlib"}, {"name": "list.nodup_enum_map_fst", "description": "", "p": "mathlib"}, {"name": "list.not_eq_key", "description": "", "p": "mathlib"}, {"name": "list.keys_kreplace", "description": "", "p": "mathlib"}, {"name": "list.mem_lookup_all", "description": "", "p": "mathlib"}, {"name": "list.lookup_kerase", "description": "", "p": "mathlib"}, {"name": "list.perm_nodupkeys", "description": "", "p": "mathlib"}, {"name": "list.kinsert_nodupkeys", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys_cons", "description": "", "p": "mathlib"}, {"name": "list.mem_keys", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys.eq_of_mk_mem", "description": "", "p": "mathlib"}, {"name": "list.kreplace_of_forall_not", "description": "", "p": "mathlib"}, {"name": "list.lookup_all_sublist", "description": "", "p": "mathlib"}, {"name": "list.kerase_nil", "description": "", "p": "mathlib"}, {"name": "list.perm.kreplace", "description": "", "p": "mathlib"}, {"name": "list.kerase_comm", "description": "", "p": "mathlib"}, {"name": "list.lookup_eq_none", "description": "", "p": "mathlib"}, {"name": "list.not_mem_keys_kerase", "description": "", "p": "mathlib"}, {"name": "list.keys_kerase", "description": "", "p": "mathlib"}, {"name": "list.kreplace_nodupkeys", "description": "", "p": "mathlib"}, {"name": "list.map_lookup_eq_find", "description": "", "p": "mathlib"}, {"name": "list.perm_lookup_all", "description": "", "p": "mathlib"}, {"name": "list.nil_kunion", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys_nil", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys_of_nodupkeys_cons", "description": "", "p": "mathlib"}, {"name": "list.kreplace_self", "description": "", "p": "mathlib"}, {"name": "list.perm.kunion_left", "description": "", "p": "mathlib"}, {"name": "list.lookup_all_eq_lookup", "description": "", "p": "mathlib"}, {"name": "list.perm_lookup", "description": "", "p": "mathlib"}, {"name": "list.mem_keys_kunion", "description": "", "p": "mathlib"}, {"name": "list.sizeof_dedupkeys", "description": "", "p": "mathlib"}, {"name": "list.mem_keys_of_mem", "description": "", "p": "mathlib"}, {"name": "list.lookup_kunion_left", "description": "", "p": "mathlib"}, {"name": "list.kerase", "description": "Remove the first pair with the key `a`.", "p": "mathlib"}, {"name": "list.kunion_nil", "description": "", "p": "mathlib"}, {"name": "list.lookup_cons_eq", "description": "", "p": "mathlib"}, {"name": "list.mem_ext", "description": "", "p": "mathlib"}, {"name": "list.mem_keys_kerase_of_ne", "description": "", "p": "mathlib"}, {"name": "list.kinsert_def", "description": "", "p": "mathlib"}, {"name": "list.lookup_cons_ne", "description": "", "p": "mathlib"}, {"name": "list.kinsert", "description": "Insert the pair `\u27e8a, b\u27e9` and erase the first pair with the key `a`.", "p": "mathlib"}, {"name": "list.mem_lookup_kunion", "description": "", "p": "mathlib"}, {"name": "list.dedupkeys_cons", "description": "", "p": "mathlib"}, {"name": "list.exists_of_kerase", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys_singleton", "description": "", "p": "mathlib"}, {"name": "list.perm.kunion", "description": "", "p": "mathlib"}, {"name": "list.lookup_all_length_le_one", "description": "", "p": "mathlib"}, {"name": "list.lookup_nil", "description": "", "p": "mathlib"}, {"name": "list.kunion_cons", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys.pairwise_ne", "description": "", "p": "mathlib"}, {"name": "list.lookup_all_nodup", "description": "", "p": "mathlib"}, {"name": "list.kerase_kerase", "description": "", "p": "mathlib"}, {"name": "list.kunion_kerase", "description": "", "p": "mathlib"}, {"name": "list.lookup_all_eq_nil", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys.nodup", "description": "", "p": "mathlib"}, {"name": "list.perm.kerase", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys_join", "description": "", "p": "mathlib"}, {"name": "list.kextract", "description": " Finds the first entry with a given key `a` and returns its value (as an `option` because there\nmight be no entry with key `a`) alongside with the rest of the entries.", "p": "mathlib"}, {"name": "list.kreplace", "description": "Replaces the first value with key `a` by `b`.", "p": "mathlib"}, {"name": "list.kerase_sublist", "description": "", "p": "mathlib"}, {"name": "list.mem_lookup_kunion_middle", "description": "", "p": "mathlib"}, {"name": "list.keys_cons", "description": "", "p": "mathlib"}, {"name": "list.perm.kinsert", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys_iff_pairwise", "description": "", "p": "mathlib"}, {"name": "list.nodupkeys_dedupkeys", "description": "", "p": "mathlib"}, {"name": "list.perm.kunion_right", "description": "", "p": "mathlib"}, {"name": "native.rb_map.scale", "description": "`scale b m` multiplies every value in `m` by `b`.", "p": "mathlib"}, {"name": "expr_set.local_set_to_name_set", "description": "`local_set_to_name_set lcs` is the set of unique names of the local constants\n`lcs`. If any of the `lcs` are not local constants, the returned set will\ncontain bogus names.", "p": "mathlib"}, {"name": "native.rb_set.sdiff", "description": "`sdiff s1 s2` returns the set of elements that are in `s1` but not in `s2`.\nIt does so by folding over `s2`. If `s1` is significantly smaller than `s2`,\nit may be worth it to reverse the fold.", "p": "mathlib"}, {"name": "native.rb_map.add", "description": "Returns the pointwise sum of `m1` and `m2`, treating nonexistent values as 0.", "p": "mathlib"}, {"name": "native.rb_map.has_to_tactic_format", "description": "", "p": "mathlib"}, {"name": "name_map.inhabited", "description": "", "p": "mathlib"}, {"name": "native.rb_set.mfilter", "description": " `mfilter s P` returns the subset of elements of `s` satisfying `P`,\nwhere the check `P` is monadic.", "p": "mathlib"}, {"name": "native.rb_set.of_list", "description": "`of_list l` transforms a list `l : list key` into an `rb_set`,\ninferring an order on the type `key`.", "p": "mathlib"}, {"name": "list.to_rb_map", "description": "`to_rb_map as` is the map that associates each index `i` of `as` with the\ncorresponding element of `as`.\n\n```lean\nto_rb_map ['a', 'b', 'c'] = rb_map.of_list [(0, 'a'), (1, 'b'), (2, 'c')]\n```", "p": "mathlib"}, {"name": "native.rb_set.insert_list", "description": "`insert_list s l` inserts each element of `l` into `s`.", "p": "mathlib"}, {"name": "name_set.local_list_to_name_set", "description": "`local_list_to_name_set lcs` is the set of unique names of the local\nconstants `lcs`. If any of the `lcs` are not local constants, the returned set\nwill contain bogus names.", "p": "mathlib"}, {"name": "name_set.mfilter", "description": " `mfilter P s` returns the subset of elements of `s` satisfying `P`,\nwhere the check `P` is monadic.", "p": "mathlib"}, {"name": "name_set.insert_list", "description": "`insert_list s l` inserts every element of `l` into `s`.", "p": "mathlib"}, {"name": "native.rb_lmap.values", "description": "Returns the list of values of an `rb_lmap`.", "p": "mathlib"}, {"name": "name_set.inhabited", "description": "", "p": "mathlib"}, {"name": "native.rb_map.mfilter", "description": "`mfilter P s` filters `s` by the monadic predicate `P` on keys and values.", "p": "mathlib"}, {"name": "native.rb_set.union", "description": "`union s t` returns an rb_set containing every element that appears in either `s` or `t`.", "p": "mathlib"}, {"name": "native.rb_map.inhabited", "description": "", "p": "mathlib"}, {"name": "native.rb_map.zfind", "description": " `zfind m key` returns the value corresponding to `key` in `m`, if it exists.\nOtherwise it returns 0.", "p": "mathlib"}, {"name": "native.rb_lmap.of_list", "description": "Construct a rb_lmap from a list of key-data pairs", "p": "mathlib"}, {"name": "native.rb_map.mmap", "description": "`mmap f s` maps the monadic function `f` over values in `s`.", "p": "mathlib"}, {"name": "name_set.mmap", "description": "`mmap f s` maps the monadic function `f` over values in `s`.", "p": "mathlib"}, {"name": "native.rb_set.inhabited", "description": "", "p": "mathlib"}, {"name": "native.rb_set.of_list_core", "description": "`of_list_core empty l` turns a list of keys into an `rb_set`.\nIt takes a user_provided `rb_set` to use for the base case.\nThis can be used to pre-seed the set with additional elements,\nand/or to use a custom comparison operator.", "p": "mathlib"}, {"name": "name_set.filter", "description": "`filter P s` returns the subset of elements of `s` satisfying `P`.", "p": "mathlib"}, {"name": "native.rb_lmap.inhabited", "description": "", "p": "mathlib"}, {"name": "native.rb_map.find_def", "description": " `find_def default m k` returns the value corresponding to `k` in `m`, if it exists.\nOtherwise it returns `default`.", "p": "mathlib"}, {"name": "native.rb_set.filter", "description": "`filter s P` returns the subset of elements of `s` satisfying `P`.", "p": "mathlib"}, {"name": "native.rb_map.ifind", "description": " `ifind m key` returns the value corresponding to `key` in `m`, if it exists.\nOtherwise it returns the default value of `value`.", "p": "mathlib"}, {"name": "inv_pos_of_pos", "description": "**Alias** of the reverse direction of `inv_pos`.", "p": "mathlib"}, {"name": "one_div_le_of_neg", "description": "", "p": "mathlib"}, {"name": "lt_of_one_div_lt_one_div", "description": "", "p": "mathlib"}, {"name": "one_half_lt_one", "description": "", "p": "mathlib"}, {"name": "div_lt_one_iff", "description": "", "p": "mathlib"}, {"name": "mul_sub_mul_div_mul_nonpos", "description": "**Alias** of the reverse direction of `mul_sub_mul_div_mul_nonpos_iff`.", "p": "mathlib"}, {"name": "one_div_nonneg", "description": "", "p": "mathlib"}, {"name": "div_lt_iff_of_neg", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_left\u2080", "description": "`equiv.mul_left\u2080` as an order_iso.", "p": "mathlib"}, {"name": "half_pos", "description": "", "p": "mathlib"}, {"name": "inv_lt_of_neg", "description": "", "p": "mathlib"}, {"name": "div_pos_of_neg_of_neg", "description": "", "p": "mathlib"}, {"name": "one_div_le", "description": "", "p": "mathlib"}, {"name": "inv_pow_lt_inv_pow_of_lt", "description": "", "p": "mathlib"}, {"name": "inv_lt_one_iff_of_pos", "description": "", "p": "mathlib"}, {"name": "one_div_le_one_div", "description": "For the single implications with fewer assumptions, see `one_div_le_one_div_of_le` and\n `le_of_one_div_le_one_div`", "p": "mathlib"}, {"name": "one_half_pos", "description": "", "p": "mathlib"}, {"name": "inv_lt_inv", "description": "See `inv_lt_inv_of_lt` for the implication from right-to-left with one fewer assumption.", "p": "mathlib"}, {"name": "div_le_one_of_le", "description": "", "p": "mathlib"}, {"name": "inv_mul_le_iff'", "description": "", "p": "mathlib"}, {"name": "abs_one_div", "description": "", "p": "mathlib"}, {"name": "div_le_one_iff", "description": "", "p": "mathlib"}, {"name": "div_le_div_iff", "description": "", "p": "mathlib"}, {"name": "exists_add_lt_and_pos_of_lt", "description": "", "p": "mathlib"}, {"name": "one_le_one_div", "description": "", "p": "mathlib"}, {"name": "inv_nonneg", "description": "", "p": "mathlib"}, {"name": "le_of_neg_of_one_div_le_one_div", "description": "", "p": "mathlib"}, {"name": "one_le_div_of_neg", "description": "", "p": "mathlib"}, {"name": "div_le_one", "description": "", "p": "mathlib"}, {"name": "left_lt_add_div_two", "description": "", "p": "mathlib"}, {"name": "div_lt_div_of_lt", "description": "", "p": "mathlib"}, {"name": "order_iso.mul_left\u2080_apply", "description": "", "p": "mathlib"}, {"name": "div_le_div_of_mul_sub_mul_div_nonpos", "description": "**Alias** of the forward direction of `mul_sub_mul_div_mul_nonpos_iff`.", "p": "math