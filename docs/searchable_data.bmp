ction of `equiv.perm.same_cycle_apply_right`.", "p": "mathlib"}, {"name": "equiv.perm.is_cycle_swap", "description": "", "p": "mathlib"}, {"name": "equiv.perm.cycle_of", "description": "`f.cycle_of x` is the cycle of the permutation `f` to which `x` belongs.", "p": "mathlib"}, {"name": "equiv.perm.same_cycle_conj", "description": "", "p": "mathlib"}, {"name": "equiv.perm.cycle_of_mem_cycle_factors_finset_iff", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle.zpowers_equiv_support_apply", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle_on.exists_pow_eq'", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle.two_le_card_support", "description": "", "p": "mathlib"}, {"name": "equiv.perm.same_cycle_zpow_left", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle.is_conj", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle_on.pow_apply_eq_pow_apply", "description": "", "p": "mathlib"}, {"name": "list.nodup.is_cycle_on_form_perm", "description": "", "p": "mathlib"}, {"name": "equiv.perm.same_cycle.exists_pow_eq", "description": "", "p": "mathlib"}, {"name": "equiv.perm.same_cycle.inv_apply_right", "description": "**Alias** of the reverse direction of `equiv.perm.same_cycle_inv_apply_right`.", "p": "mathlib"}, {"name": "equiv.perm.is_cycle.is_cycle_pow_pos_of_lt_prime_order", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle_on.apply_mem_iff", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle_on.range_zpow", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_cycle_on.extend_domain", "description": "", "p": "mathlib"}, {"name": "equiv.perm.not_is_cycle_one", "description": "", "p": "mathlib"}, {"name": "equiv.perm.cycle_factors_finset_one", "description": "", "p": "mathlib"}, {"name": "equiv.perm.is_swap.is_cycle", "description": "", "p": "mathlib"}, {"name": "equiv.perm.same_cycle.zpow_right", "description": "**Alias** of the reverse direction of `equiv.perm