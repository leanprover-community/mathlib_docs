lock_local.present", "description": "", "p": "mathlib"}, {"name": "tactic.local_cache.internal.def_local.is_name_dead", "description": "", "p": "mathlib"}, {"name": "tactic.local_cache.internal.def_local.present", "description": "", "p": "mathlib"}, {"name": "tactic.run_once", "description": "Using the namespace `ns` as its key, when called for the first\n   time `run_once ns t` runs `t`, then saves and returns the result.\n   Upon subsequent invocations in the same tactic block, with the scope\n   of the caching being inherited by child tactic blocks) we return the\n   cached result directly.\n\n   You can configure the cached scope to be entire `def`/`lemma`s changing\n   the optional cache_scope argument to `cache_scope.def_local`.\n   Note: the caches backing each scope are different.\n\n   If `\u03b1` is just `unit`, this means we just run `t` once each tactic\n   block.", "p": "mathlib"}, {"name": "tactic.local_cache.internal.def_local.kill_name", "description": "", "p": "mathlib"}, {"name": "tactic.local_cache.cache_scope.block_local", "description": "This scope propogates the cache within a `begin ... end` or `by` block\n   and its decendants.", "p": "mathlib"}, {"name": "tactic.local_cache.internal.def_local.RADIX", "description": "", "p": "mathlib"}, {"name": "tactic.local_cache.internal.def_local.get_name", "description": "", "p": "mathlib"}, {"name": "tactic.local_cache.cache_scope.def_local", "description": "This scope propogates the cache within an entire `def`/`lemma`.", "p": "mathlib"}, {"name": "tactic.local_cache.internal.def_local.get_tag_with_status", "description": "", "p": "mathlib"}, {"name": "tactic.local_cache.internal.block_local.try_get_name", "description": "", "p": "mathlib"}, {"name": "tactic.local_cache.internal.poke_data", "description": "", "p": "mathlib"}, {"name": "tactic.local_cache.internal.def_local.clear", "description": "", "p": "mathlib"}, {"name": "tactic.local_cache.internal.mk_full_namespace", "description": "", "p": "math