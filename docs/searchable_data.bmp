thlib"}, {"name": "category_theory.morphism_property.injective_stable_under_composition", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.stable_under_base_change.fst", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.respects_iso.cancel_left_is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.stable_under_composition.universally", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.stable_under_inverse.unop", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.epimorphisms.infer_property", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.stable_under_composition.isomorphisms", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.injective_respects_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.respects_iso.inverse_image", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.is_inverted_by", "description": " If `P : morphism_property C` and `F : C \u2964 D`, then\n`P.is_inverted_by F` means that all morphisms in `P` are mapped by `F`\nto isomorphisms in `D`.", "p": "mathlib"}, {"name": "category_theory.morphism_property.respects_iso", "description": "A morphism property `respects_iso` if it still holds when composed with an isomorphism", "p": "mathlib"}, {"name": "category_theory.morphism_property.stable_under_base_change.mk", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.complete_lattice", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.stable_under_composition.unop", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.injective", "description": "Injectiveness (in a concrete category) as a `morphism_property`", "p": "mathlib"}, {"name": "category_theory.morphism_property.is_inverted_by.right_op", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.surjective", "description": "Surjectiveness (in a concrete category) as a `morphism_property`", "p": "mathlib"}, {"name": "category_theory.morphism_property.bijective_respects_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.stable_under_inverse", "description": " A morphism property is `stable_under_inverse` if the inverse of a morphism satisfying\nthe property still falls in the class.", "p": "mathlib"}, {"name": "category_theory.morphism_property.isomorphisms.infer_property", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.functors_inverting.category", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.respects_iso.arrow_iso_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.stable_under_cobase_change.respects_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.universally", "description": "`P.universally` holds for a morphism `f : X \u27f6 Y` iff `P` holds for all `X \u00d7[Y] Y' \u27f6 Y'`.", "p": "mathlib"}, {"name": "category_theory.morphism_property.stable_under_base_change.universally_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.respects_iso.monomorphisms", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.is_inverted_by.op", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.epimorphisms", "description": "The `morphism_property C` satisfied by epimorphisms in `C`.", "p": "mathlib"}, {"name": "category_theory.morphism_property.diagonal_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.monomorphisms", "description": "The `morphism_property C` satisfied by monomorphisms in `C`.", "p": "mathlib"}, {"name": "category_theory.morphism_property.respects_iso.cancel_right_is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.is_inverted_by.iff_of_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.monomorphisms.iff", "description": "", "p": "mathlib"}, {"name": "category_theory.morphism_property.op_unop", "description": "", "p": "mathlib"}, {"name": "algebra_map_int_eq", "description": "A special case of `eq_int_cast'` that happens to be true definitionally", "p": "mathlib"}, {"name": "algebra.of_module", "description": " Let `R` be a commutative semiring, let `A` be a semiring with a `module R` structure.\nIf `(r \u2022 x) * y = x * (r \u2022 y) = r \u2022 (x * y)` for all `r : R` and `x y : A`, then `A`\nis an `algebra` over `R`.\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "algebra_int", "description": "Ring \u2964 \u2124-Alg", "p": "mathlib"}, {"name": "ulift.algebra", "description": "", "p": "mathlib"}, {"name": "int_algebra_subsingleton", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_zero", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_div", "description": "", "p": "mathlib"}, {"name": "algebra.algebra_map_of_subsemiring_apply", "description": "", "p": "mathlib"}, {"name": "mul_opposite.algebra_map_apply", "description": "", "p": "mathlib"}, {"name": "module.End_algebra_map_is_unit_inv_apply_eq_iff", "description": "", "p": "mathlib"}, {"name": "punit.algebra", "description": "", "p": "mathlib"}, {"name": "no_zero_smul_divisors.algebra_map_injective", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_one", "description": "", "p": "mathlib"}, {"name": "algebra.coe_linear_map", "description": "", "p": "mathlib"}, {"name": "algebra.id.map_eq_self", "description": "", "p": "mathlib"}, {"name": "module.algebra_map_End_eq_smul_id", "description": "", "p": "mathlib"}, {"name": "no_zero_smul_divisors.iff_algebra_map_injective", "description": "", "p": "mathlib"}, {"name": "algebra.commutes", "description": "`mul_comm` for `algebra`s when one element is from the base ring.", "p": "mathlib"}, {"name": "algebra.semiring_to_ring", "description": " A `semiring` that is an `algebra` over a commutative ring carries a natural `ring` structure.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "algebra.id.smul_eq_mul", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.to_smul_comm_class'", "description": "", "p": "mathlib"}, {"name": "smul_algebra_smul_comm", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_zpow", "description": "", "p": "mathlib"}, {"name": "algebra.linear_map_apply", "description": "", "p": "mathlib"}, {"name": "algebra.to_module", "description": "", "p": "mathlib"}, {"name": "algebra.id.map_eq_id", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.right", "description": "", "p": "mathlib"}, {"name": "module.End_algebra_map_is_unit_inv_apply_eq_iff'", "description": "", "p": "mathlib"}, {"name": "smul_algebra_map", "description": "", "p": "mathlib"}, {"name": "algebra.bit0_smul_one'", "description": "", "p": "mathlib"}, {"name": "algebra.mul_smul_comm", "description": " This is just a special case of the global `mul_smul_comm` lemma that requires less typeclass\nsearch (and was here first).", "p": "mathlib"}, {"name": "algebra.mul_sub_algebra_map_commutes", "description": "", "p": "mathlib"}, {"name": "algebra.algebra_map_eq_smul_one", "description": "", "p": "mathlib"}, {"name": "ring_hom.to_algebra", "description": "Creating an algebra from a morphism to a commutative semiring.", "p": "mathlib"}, {"name": "algebra.of_module'", "description": " Let `R` be a commutative semiring, let `A` be a semiring with a `module R` structure.\nIf `(r \u2022 1) * x = x * (r \u2022 1) = r \u2022 x` for all `r : R` and `x : A`, then `A` is an `algebra`\nover `R`.\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "module.End_is_unit_inv_apply_apply_of_is_unit", "description": "", "p": "mathlib"}, {"name": "algebra.coe_algebra_map_of_subsemiring", "description": "", "p": "mathlib"}, {"name": "algebra_nat", "description": "Semiring \u2964 \u2115-Alg", "p": "mathlib"}, {"name": "algebra_rat", "description": "", "p": "mathlib"}, {"name": "algebra.mul_sub_algebra_map_pow_commutes", "description": "", "p": "mathlib"}, {"name": "module.End_is_unit_iff", "description": "", "p": "mathlib"}, {"name": "algebra_map", "description": "Embedding `R \u2192+* A` given by `algebra` structure.", "p": "mathlib"}, {"name": "algebra.algebra_map_of_subring_apply", "description": "", "p": "mathlib"}, {"name": "algebra.bit0_smul_bit1", "description": "", "p": "mathlib"}, {"name": "algebra_map.has_lift_t", "description": "", "p": "mathlib"}, {"name": "algebra_map_rat_rat", "description": "", "p": "mathlib"}, {"name": "algebra_rat_subsingleton", "description": "", "p": "mathlib"}, {"name": "algebra.bit1_smul_bit1", "description": "", "p": "mathlib"}, {"name": "algebra.algebra_map_of_subsemiring", "description": "", "p": "mathlib"}, {"name": "ulift.down_algebra_map", "description": "", "p": "mathlib"}, {"name": "algebra.algebra_map_submonoid", "description": " Explicit characterization of the submonoid map in the case of an algebra.\n`S` is made explicit to help with type inference", "p": "mathlib"}, {"name": "algebra.bit1_smul_one'", "description": "", "p": "mathlib"}, {"name": "algebra.algebra_ext", "description": "To prove two algebra structures on a fixed `[comm_semiring R] [semiring A]` agree,\nit suffices to check the `algebra_map`s agree.", "p": "mathlib"}, {"name": "linear_map.map_mul_algebra_map", "description": "", "p": "mathlib"}, {"name": "algebra_compatible_smul", "description": "", "p": "mathlib"}, {"name": "algebra_map.lift_map_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "algebra.linear_map", "description": "The canonical ring homomorphism `algebra_map R A : R \u2192* A` for any `R`-algebra `A`,\npackaged as an `R`-linear map.", "p": "mathlib"}, {"name": "algebra_map_smul", "description": "", "p": "mathlib"}, {"name": "ring_hom.map_rat_algebra_map", "description": "", "p": "mathlib"}, {"name": "ne_zero.of_no_zero_smul_divisors", "description": "", "p": "mathlib"}, {"name": "algebra.algebra_map_eq_smul_one'", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_rat_cast", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_inj", "description": "", "p": "mathlib"}, {"name": "module.End_is_unit_apply_inv_apply_of_is_unit", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_prod", "description": "", "p": "mathlib"}, {"name": "algebra.bit1_smul_one", "description": "", "p": "mathlib"}, {"name": "linear_map.map_algebra_map_mul", "description": " An alternate statement of `linear_map.map_smul` for when `algebra_map` is more convenient to\nwork with than `\u2022`.", "p": "mathlib"}, {"name": "algebra.algebra_map_punit", "description": "", "p": "mathlib"}, {"name": "no_zero_smul_divisors.char_zero.no_zero_smul_divisors_nat", "description": "", "p": "mathlib"}, {"name": "algebra.right_comm", "description": "`mul_right_comm` for `algebra`s when one element is from the base ring.", "p": "mathlib"}, {"name": "linear_map.ker_restrict_scalars", "description": "", "p": "mathlib"}, {"name": "module.End.algebra", "description": "", "p": "mathlib"}, {"name": "module.algebra_map_End_apply", "description": "", "p": "mathlib"}, {"name": "no_zero_smul_divisors.char_zero.no_zero_smul_divisors_int", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.to_smul_comm_class", "description": "", "p": "mathlib"}, {"name": "algebra", "description": "An associative unital `R`-algebra is a semiring `A` equipped with a map into its center `R \u2192 A`.\n\nSee the implementation notes in this file for discussion of the details of this definition.", "p": "mathlib"}, {"name": "algebra.to_has_smul", "description": "An associative unital `R`-algebra is a semiring `A` equipped with a map into its center `R \u2192 A`.\n\nSee the implementation notes in this file for discussion of the details of this definition.", "p": "mathlib"}, {"name": "algebra.to_ring_hom", "description": "An associative unital `R`-algebra is a semiring `A` equipped with a map into its center `R \u2192 A`.\n\nSee the implementation notes in this file for discussion of the details of this definition.", "p": "mathlib"}, {"name": "algebra.commutes'", "description": "An associative unital `R`-algebra is a semiring `A` equipped with a map into its center `R \u2192 A`.\n\nSee the implementation notes in this file for discussion of the details of this definition.", "p": "mathlib"}, {"name": "algebra.smul_def'", "description": "An associative unital `R`-algebra is a semiring `A` equipped with a map into its center `R \u2192 A`.\n\nSee the implementation notes in this file for discussion of the details of this definition.", "p": "mathlib"}, {"name": "algebra.mem_algebra_map_submonoid_of_mem", "description": "", "p": "mathlib"}, {"name": "no_zero_smul_divisors.trans", "description": "", "p": "mathlib"}, {"name": "algebra.of_subsemiring", "description": "Algebra over a subsemiring. This builds upon `subsemiring.module`.", "p": "mathlib"}, {"name": "nat_algebra_subsingleton", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_pow", "description": "", "p": "mathlib"}, {"name": "algebra.smul_def", "description": "", "p": "mathlib"}, {"name": "ring_hom.algebra_map_to_algebra", "description": "", "p": "mathlib"}, {"name": "ring_hom.to_algebra'", "description": "Creating an algebra from a morphism to the center of a semiring.", "p": "mathlib"}, {"name": "algebra.to_smul_comm_class", "description": "", "p": "mathlib"}, {"name": "algebra.of_subring", "description": "Algebra over a subring. This builds upon `subring.module`.", "p": "mathlib"}, {"name": "linear_map.coe_coe_is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "algebra.left_comm", "description": "`mul_left_comm` for `algebra`s when one element is from the base ring.", "p": "mathlib"}, {"name": "algebra_map.coe_add", "description": "", "p": "mathlib"}, {"name": "ulift.algebra_map_eq", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_sum", "description": "", "p": "mathlib"}, {"name": "no_zero_smul_divisors.of_algebra_map_injective", "description": " If `algebra_map R A` is injective and `A` has no zero divisors,\n`R`-multiples in `A` are zero only if one of the factors is zero.\n\nCannot be an instance because there is no `injective (algebra_map R A)` typeclass.", "p": "mathlib"}, {"name": "algebra.bit0_smul_bit0", "description": "", "p": "mathlib"}, {"name": "mul_opposite.algebra", "description": "", "p": "mathlib"}, {"name": "no_zero_smul_divisors.algebra.no_zero_smul_divisors", "description": "", "p": "mathlib"}, {"name": "algebra.bit1_smul_bit0", "description": "", "p": "mathlib"}, {"name": "algebra.coe_algebra_map_of_subring", "description": "", "p": "mathlib"}, {"name": "linear_map.lto_fun", "description": " `A`-linearly coerce a `R`-linear map from `M` to `A` to a function, given an algebra `A` over\na commutative semiring `R` and `M` a module over `R`.", "p": "mathlib"}, {"name": "algebra_map.coe_inv", "description": "", "p": "mathlib"}, {"name": "algebra.id", "description": "", "p": "mathlib"}, {"name": "algebra.smul_mul_assoc", "description": " This is just a special case of the global `smul_mul_assoc` lemma that requires less typeclass\nsearch (and was here first).", "p": "mathlib"}, {"name": "algebra.bit0_smul_one", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_restrict_scalars_eq_coe", "description": "", "p": "mathlib"}, {"name": "algebra.algebra_map_of_subring", "description": "", "p": "mathlib"}, {"name": "module.ker_algebra_map_End", "description": "", "p": "mathlib"}, {"name": "int_cast_smul", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_neg", "description": "", "p": "mathlib"}, {"name": "algebra_map.coe_mul", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.arg_eq_pi_iff", "description": "", "p": "mathlib"}, {"name": "complex.is_primitive_root_exp_of_coprime", "description": "", "p": "mathlib"}, {"name": "complex.mem_roots_of_unity", "description": " The complex `n`-th roots of unity are exactly the\ncomplex numbers of the form `e ^ (2 * real.pi * complex.I * (i / n))` for some `i < n`.", "p": "mathlib"}, {"name": "complex.is_primitive_root_exp", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.nnnorm_eq_one", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.arg_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.norm'_eq_one", "description": "", "p": "mathlib"}, {"name": "complex.card_roots_of_unity", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.arg", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.arg_ext", "description": "", "p": "mathlib"}, {"name": "complex.is_primitive_root_iff", "description": "", "p": "mathlib"}, {"name": "complex.card_primitive_roots", "description": "", "p": "mathlib"}, {"name": "tactic.local_def_value_has_local_in_name_set", "description": "`local_def_value_has_local_in_name_set h ns` returns true iff `h` is a local\ndefinition whose value contains a local constant whose unique name appears in\n`ns`.", "p": "mathlib"}, {"name": "tactic.hyp_directly_depends_on_locals_inclusive", "description": "`hyp_directly_depends_on_locals_inclusive h ns` is true iff the hypothesis `h`\ndirectly depends on any of the hypotheses `hs` or `h` appears in `hs`.", "p": "mathlib"}, {"name": "tactic.revert_set", "description": "`revert_set hs` reverts the hypotheses `hs`, as well as any hypotheses that\ndepend on them. Returns the number of reverted hypotheses and a list containing\nthese hypotheses. The reverted hypotheses are returned in the order in which\nthey used to appear in the context and are guaranteed to store the correct type\n(see `tactic.update_type`).", "p": "mathlib"}, {"name": "tactic.direct_dependencies_of_hyp", "description": "`direct_dependencies_of_hyp h` is the list of hypotheses that the hypothesis `h`\ndirectly depends on. These are the hypotheses that appear in `h`'s type or value\n(if `h` is a local definition). The dependencies are returned in no particular\norder.", "p": "mathlib"}, {"name": "tactic.dependencies_of_hyps", "description": "`dependencies_of_hyps hs` returns, for each `h \u2208 hs`, the dependencies of `h`.\nThe dependencies appear in no particular order in the returned lists. This is\nthe same as (but more performant than) using `tactic.dependencies_of_hyp` on\nevery `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.hyps_depend_on_local_name_set_inclusive", "description": "`hyps_depend_on_local_name_set_inclusive hs ns` returns, for each `h \u2208 hs`,\nwhether `h` inclusively depends on a hypothesis whose unique name appears in\n`ns`. This is the same as (but more efficient than) calling\n`tactic.hyp_depends_on_local_name_set_inclusive` for every `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.direct_dependency_name_set_of_hyp_inclusive", "description": "`direct_dependency_name_set_of_hyp_inclusive h` is the set of unique names of\nhypotheses that the hypothesis `h` directly depends on, plus `h` itself.", "p": "mathlib"}, {"name": "tactic.direct_dependency_name_set_of_hyp", "description": "`direct_dependency_name_set_of_hyp h` is the set of unique names of hypotheses\nthat the hypothesis `h` directly depends on. These are the hypotheses that\nappear in `h`'s type or value (if `h` is a local definition).", "p": "mathlib"}, {"name": "tactic.reverse_dependencies_of_hyp_name_set_inclusive", "description": "`reverse_dependencies_of_hyp_name_set_inclusive hs` is the list of reverse\ndependencies of the hypotheses whose unique names appear in `hs`, including the\n`hs` themselves. The reverse dependencies are returned in the order in which\nthey appear in the context.", "p": "mathlib"}, {"name": "tactic.hyp_directly_depends_on_local_set", "description": "`hyp_directly_depends_on_local_set h hs` is true iff the hypothesis `h` directly\ndepends on any of the hypotheses `hs`.", "p": "mathlib"}, {"name": "tactic.dependency_set_of_hyp_inclusive'", "description": "`dependency_set_of_hyp_inclusive' cache h` is the set of dependencies of the\nhypothesis `h`, plus `h` itself. `cache` is a map from hypotheses to all their\ndependencies (including indirect dependencies). This is a performance\noptimisation, so you can give an empty cache. The tactic also returns an\nexpanded cache with hypotheses which the tactic has encountered. Note that the\ncache records exclusive, not inclusive dependencies.\n\nYou probably want to use `tactic.dependency_set_of_hyp_inclusive` or\n`tactic.dependency_sets_of_hyps_inclusive` instead of this tactic.", "p": "mathlib"}, {"name": "tactic.type_has_local_in_name_set", "description": "`type_has_local_in_name_set h ns` returns true iff the type of `h` contains a\nlocal constant whose unique name appears in `ns`.", "p": "mathlib"}, {"name": "tactic.dependency_name_sets_of_hyps_inclusive", "description": "`dependency_name_sets_of_hyps_inclusive hs` returns, for each `h \u2208 hs`, the\nunique names of the dependencies of `h`, plus the unique name of `h` itself.\nThis is the same as (but more performant than) using\n`tactic.dependency_name_set_of_hyp_inclusive` on every `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.hyps_depend_on_locals_inclusive", "description": "`hyps_depend_on_locals_inclusive hs is` returns, for each `h \u2208 hs`, whether `h`\ndepends inclusively on any of the hypotheses `is`. This is the same as (but more\nefficient than) calling `tactic.hyp_depends_on_locals_inclusive` for every\n`h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.hyp_directly_depends_on_locals", "description": "`hyp_directly_depends_on_locals h hs` is true iff the hypothesis `h` directly\ndepends on any of the hypotheses `hs`.", "p": "mathlib"}, {"name": "tactic.hyps_depend_on_local_name_set", "description": "`hyps_depend_on_local_name_set hs ns` returns, for each `h \u2208 hs`, whether `h`\ndepends on a hypothesis whose unique name appears in `ns`. This is the same as\n(but more efficient than) calling `tactic.hyp_depends_on_local_name_set` for\nevery `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.revert_reverse_dependencies_of_hyp_name_set", "description": "`revert_reverse_dependencies_of_hyp_name_set hs` reverts all the hypotheses that\ndepend on a hypothesis whose unique name appears in `hs`. The `hs` themselves\nare not reverted, unless they depend on each other. Returns the number of\nreverted hypotheses.", "p": "mathlib"}, {"name": "tactic.dependency_sets_of_hyps", "description": "`dependency_sets_of_hyps hs` returns, for each `h \u2208 hs`, the set of dependencies\nof `h`. This is the same as (but more performant than) using\n`tactic.dependency_set_of_hyp` on every `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.hyps_depend_on_locals", "description": "`hyps_depend_on_locals hs is` returns, for each `h \u2208 hs`, whether `h` depends\non any of the hypotheses `is`. This is the same as (but more efficient than)\ncalling `tactic.hyp_depends_on_locals` for every `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.dependency_sets_of_hyps_inclusive", "description": "`dependency_sets_of_hyps_inclusive hs` returns, for each `h \u2208 hs`, the\ndependencies of `h`, plus `h` itself. This is the same as (but more performant\nthan) using `tactic.dependency_set_of_hyp_inclusive` on every `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.hyp_depends_on_local_set", "description": "`hyp_depends_on_local_set h hs` is true iff the hypothesis `h` depends on\nany of the hypotheses `hs`. If you need to check dependencies of multiple\nhypotheses, use `tactic.hyps_depend_on_local_set`.", "p": "mathlib"}, {"name": "tactic.hyps_depend_on_local_set_inclusive", "description": "`hyps_depend_on_local_set_inclusive hs is` returns, for each `h \u2208 hs`, whether\n`h` depends inclusively on any of the hypotheses `is`. This is the same as\n(but more efficient than) calling `tactic.hyp_depends_on_local_set_inclusive`\nfor every `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.hyp_depends_on_local_name_set_inclusive'", "description": "`hyp_depends_on_local_name_set_inclusive' cache h ns` is true iff the hypothesis\n`h` inclusively depends on a hypothesis whose unique name appears in `ns`.\n`cache` must be a set of hypotheses known *not* to depend (even indirectly) on\nany of the `ns`. This is a performance optimisation, so you can give an empty\ncache. The tactic also returns an expanded cache with hypotheses which the\ntactic has encountered. Note that the cache records exclusive, not inclusive\ndependencies.\n\nYou probably want to use `tactic.hyp_depends_on_local_name_set_inclusive` or\n`tactic.hyps_depend_on_local_name_set_inclusive` instead of this tactic.", "p": "mathlib"}, {"name": "tactic.dependency_name_set_of_hyp", "description": "`dependency_name_set_of_hyp h` is the set of unique names of the dependencies of\nthe hypothesis `h`. If you need the dependencies of multiple hypotheses, use\n`tactic.dependency_name_sets_of_hyps`.", "p": "mathlib"}, {"name": "tactic.dependency_name_sets_of_hyps", "description": "`dependency_name_sets_of_hyps hs` returns, for each `h \u2208 hs`, the set of unique\nnames of the dependencies of `h`. This is the same as (but more performant than)\nusing `tactic.dependency_name_set_of_hyp` on every `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.hyp_directly_depends_on_local_name_set", "description": "`hyp_directly_depends_on_local_name_set h ns` is true iff the hypothesis `h`\ndirectly depends on a hypothesis whose unique name appears in `ns`.", "p": "mathlib"}, {"name": "tactic.revert_reverse_dependencies_of_hyps", "description": "`revert_reverse_dependencies_of_hyp hs` reverts all the hypotheses that depend\non a hypothesis in `hs`. The `hs` themselves are not reverted, unless they\ndepend on each other. Returns the number of reverted hypotheses.", "p": "mathlib"}, {"name": "tactic.hyp_depends_on_local_set_inclusive", "description": "`hyp_depends_on_local_set_inclusive h hs` is true iff the hypothesis `h`\ninclusively depends on any of the hypotheses `hs`. If you need to check\ndependencies of multiple hypotheses, use\n`tactic.hyps_depend_on_local_set_inclusive`.", "p": "mathlib"}, {"name": "tactic.hyps_depend_on_local_set", "description": "`hyps_depend_on_local_set hs is` returns, for each `h \u2208 hs`, whether `h` depends\non any of the hypotheses `is`. This is the same as (but more efficient than)\ncalling `tactic.hyp_depends_on_local_set` for every `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.revert_lst'", "description": "`revert_lst' hs` reverts the hypotheses `hs`, as well as any hypotheses that\ndepend on them. Returns the number of reverted hypotheses and a list containing\nthese hypotheses. The reverted hypotheses are returned in the order in which\nthey used to appear in the context and are guaranteed to store the correct type\n(see `tactic.update_type`).\n\nThis is a more informative version of `tactic.revert_lst`.", "p": "mathlib"}, {"name": "tactic.local_def_value_has_local_in_set", "description": "`local_def_value_has_local_in_set h hs` returns true iff `h` is a local\ndefinition whose value contains any of the local constants `hs`.", "p": "mathlib"}, {"name": "tactic.hyp_depends_on_local_name_set", "description": "`hyp_depends_on_local_name_set h ns` is true iff the hypothesis `h` depends on\nany of the hypotheses whose unique names appear in `ns`. If you need to check\ndependencies of multiple hypotheses, use `tactic.hyps_depend_on_local_name_set`.", "p": "mathlib"}, {"name": "tactic.dependencies_of_hyp_inclusive", "description": "`dependencies_of_hyp_inclusive h` is the list of dependencies of the hypothesis\n`h`, plus `h` itself. The dependencies are returned in no particular order. If\nyou need the dependencies of multiple hypotheses, use\n`tactic.dependencies_of_hyps_inclusive`.", "p": "mathlib"}, {"name": "tactic.revert_reverse_dependencies_of_hyp_set", "description": "`revert_reverse_dependencies_of_hyp_set hs` reverts all the hypotheses that\ndepend on a hypothesis in `hs`. The `hs` themselves are not reverted, unless\nthey depend on each other. Returns the number of reverted hypotheses.", "p": "mathlib"}, {"name": "tactic.reverse_dependencies_of_hyps_inclusive", "description": "`reverse_dependencies_of_hyps_inclusive hs` is the list of reverse dependencies\nof the hypotheses `hs`, including the `hs` themselves. The reverse dependencies\nare returned in the order in which they appear in the context.", "p": "mathlib"}, {"name": "tactic.direct_dependencies_of_hyp_inclusive", "description": "`direct_dependencies_of_hyp_inclusive h` is the list of hypotheses that the\nhypothesis `h` directly depends on, plus `h` itself. The dependencies are\nreturned in no particular order.", "p": "mathlib"}, {"name": "tactic.local_def_value_has_local_in", "description": "`local_def_value_has_local_in h hs` returns true iff `h` is a local definition\nwhose value contains any of the local constants `hs`.", "p": "mathlib"}, {"name": "tactic.revert_reverse_dependencies_of_hyp", "description": "`revert_reverse_dependencies_of_hyp h` reverts all the hypotheses that depend on\nthe hypothesis `h`, including the local definitions that have `h` in their\nvalue. This fixes a bug in `tactic.revert_kdependencies` that does not revert\nlocal definitions for which `h` only appears in the value. Returns the number\nof reverted hypotheses.", "p": "mathlib"}, {"name": "tactic.dependency_set_of_hyp_inclusive", "description": "`dependency_set_of_hyp_inclusive h` is the set of dependencies of the hypothesis\n`h`, plus `h` itself. If you need the dependencies of multiple hypotheses, use\n`tactic.dependency_sets_of_hyps_inclusive`.", "p": "mathlib"}, {"name": "tactic.direct_dependency_set_of_hyp_inclusive", "description": "`direct_dependency_set_of_hyp_inclusive h` is the set of hypotheses that the\nhypothesis `h` directly depends on, plus `h` itself.", "p": "mathlib"}, {"name": "tactic.direct_dependency_set_of_hyp", "description": "`direct_dependency_set_of_hyp h` is the set of hypotheses that the hypothesis\n`h` directly depends on. These are the hypotheses that appear in `h`'s type or\nvalue (if `h` is a local definition).", "p": "mathlib"}, {"name": "tactic.type_has_local_in", "description": "`type_has_local_in h hs` returns true iff the type of `h` contains any of the\nlocal constants `hs`.", "p": "mathlib"}, {"name": "tactic.reverse_dependencies_of_hyps", "description": "`reverse_dependencies_of_hyps hs` is the list of reverse dependencies of the\nhypotheses `hs`, excluding the `hs` themselves. The reverse dependencies are\nreturned in the order in which they appear in the context.", "p": "mathlib"}, {"name": "tactic.hyp_directly_depends_on_local_name_set_inclusive", "description": "`hyp_directly_depends_on_local_name_set_inclusive h ns` is true iff the\nhypothesis `h` directly depends on a hypothesis whose unique name appears in\n`ns` or `h`'s name appears in `ns`.", "p": "mathlib"}, {"name": "tactic.reverse_dependencies_of_hyp_name_set", "description": "`reverse_dependencies_of_hyp_name_set hs` is the list of reverse dependencies of\nthe hypotheses whose unique names appear in `hs`, excluding the `hs` themselves.\nThe reverse dependencies are returned in the order in which they appear in the\ncontext.", "p": "mathlib"}, {"name": "tactic.hyp_depends_on_locals_inclusive", "description": "`hyp_depends_on_locals_inclusive h hs` is true iff the hypothesis `h`\ninclusively depends on any of the hypotheses `hs`. If you need to check\ndependencies of multiple hypotheses, use\n`tactic.hyps_depend_on_locals_inclusive`.", "p": "mathlib"}, {"name": "tactic.type_has_local_in_set", "description": "`type_has_local_in_set h hs` returns true iff the type of `h` contains any of\nthe local constants `hs`.", "p": "mathlib"}, {"name": "tactic.dependency_name_set_of_hyp_inclusive", "description": "`dependency_name_set_of_hyp_inclusive h` is the set of unique names of the\ndependencies of the hypothesis `h`, plus the unique name of `h` itself. If you\nneed the dependencies of multiple hypotheses, use\n`tactic.dependency_name_sets_of_hyps_inclusive`.", "p": "mathlib"}, {"name": "tactic.hyp_depends_on_local_name_set_inclusive", "description": "`hyp_depends_on_local_name_set_inclusive h ns` is true iff the hypothesis `h`\ninclusively depends on any of the hypotheses whose unique names appear in `ns`.\nIf you need to check the dependencies of multiple hypotheses, use\n`tactic.hyps_depend_on_local_name_set_inclusive`.", "p": "mathlib"}, {"name": "tactic.reverse_dependencies_of_hyp_set_inclusive", "description": "`reverse_dependencies_of_hyp_set_inclusive hs` is the list of reverse\ndependencies of the hypotheses `hs`, including the `hs` themselves. The\ninclusive reverse dependencies are returned in the order in which they appear in\nthe context.", "p": "mathlib"}, {"name": "tactic.dependency_set_of_hyp", "description": "`dependency_set_of_hyp h` is the set of dependencies of the hypothesis `h`. If\nyou need the dependencies of multiple hypotheses, use\n`tactic.dependency_sets_of_hyps`.", "p": "mathlib"}, {"name": "tactic.reverse_dependencies_of_hyp_set", "description": "`reverse_dependencies_of_hyp_set hs` is the list of reverse dependencies of the\nhypotheses `hs`, excluding the `hs` themselves. The reverse dependencies are\nreturned in the order in which they appear in the context.", "p": "mathlib"}, {"name": "tactic.hyp_directly_depends_on_local_set_inclusive", "description": "`hyp_directly_depends_on_local_set_inclusive h ns` is true iff the hypothesis `h`\ndirectly depends on any of the hypotheses `hs` or `h` appears in `hs`.", "p": "mathlib"}, {"name": "tactic.dependencies_of_hyps_inclusive", "description": "`dependencies_of_hyps_inclusive hs` returns, for each `h \u2208 hs`, the dependencies\nof `h`, plus `h` itself. The dependencies appear in no particular order in the\nreturned lists. This is the same as (but more performant than) using\n`tactic.dependencies_of_hyp_inclusive` on every `h \u2208 hs`.", "p": "mathlib"}, {"name": "tactic.hyp_depends_on_locals", "description": "`hyp_depends_on_locals h hs` is true iff the hypothesis `h` depends on any of\nthe hypotheses `hs`. If you need to check dependencies of multiple hypotheses,\nuse `tactic.hyps_depend_on_locals`.", "p": "mathlib"}, {"name": "tactic.dependency_set_of_hyp'", "description": "`dependency_set_of_hyp' cache h` is the set of dependencies of the hypothesis\n`h`. `cache` is a map from hypotheses to all their dependencies (including\nindirect dependencies). This is a performance optimisation, so you can give an\nempty cache. The tactic also returns an expanded cache with hypotheses which\nthe tactic has encountered.\n\nYou probably want to use `tactic.dependency_set_of_hyp` or\n`tactic.dependency_sets_of_hyps` instead of this tactic.", "p": "mathlib"}, {"name": "tactic.revert_name_set", "description": "`revert_name_set hs` reverts the hypotheses whose unique names appear in `hs`,\nas well as any hypotheses that depend on them. Returns the number of reverted\nhypotheses and a list containing these hypotheses. The reverted hypotheses are\nreturned in the order in which they used to appear in the context and are\nguaranteed to store the correct type (see `tactic.update_type`).", "p": "mathlib"}, {"name": "tactic.dependencies_of_hyp", "description": "`dependencies_of_hyp h` is the list of dependencies of the hypothesis `h`.\nThe dependencies are returned in no particular order. If you need the\ndependencies of multiple hypotheses, use `tactic.dependencies_of_hyps`.", "p": "mathlib"}, {"name": "tactic.hyp_depends_on_local_name_set'", "description": "`hyp_depends_on_local_name_set' cache h ns` is true iff `h` depends on any of\nthe hypotheses whose unique names appear in `ns`. `cache` must be a set of\nhypotheses known *not* to depend (even indirectly) on any of the `ns`. This is\na performance optimisation, so you can give an empty cache. The tactic also\nreturns an expanded cache with hypotheses which the tactic has encountered.\n\nYou probably want to use `tactic.hyp_depends_on_local_name_set` or\n`tactic.hyps_depend_on_local_name_set` instead of this tactic.", "p": "mathlib"}, {"name": "d_array.iterate_aux", "description": "", "p": "core"}, {"name": "array.has_to_format", "description": "", "p": "core"}, {"name": "array.to_list", "description": "", "p": "core"}, {"name": "d_array.read", "description": "`read a i` reads the `i`th member of `a`. Has builtin VM implementation.", "p": "core"}, {"name": "array.push_back_idx", "description": "", "p": "core"}, {"name": "array.decidable_eq", "description": "", "p": "core"}, {"name": "d_array.beq", "description": "Boolean element-wise equality check.", "p": "core"}, {"name": "d_array.nil", "description": "The empty array.", "p": "core"}, {"name": "array.read_mem", "description": "", "p": "core"}, {"name": "d_array.of_beq_aux_eq_tt", "description": "", "p": "core"}, {"name": "array", "description": "A non-dependent array (see `d_array`). Implemented in the VM as a persistent array.", "p": "core"}, {"name": "array.read_write_of_ne", "description": "", "p": "core"}, {"name": "d_array.map\u2082", "description": "", "p": "core"}, {"name": "array.has_to_tactic_format", "description": "", "p": "core"}, {"name": "array.has_repr", "description": "", "p": "core"}, {"name": "array.read", "description": "", "p": "core"}, {"name": "d_array.rev_iterate", "description": "", "p": "core"}, {"name": "d_array.read_write", "description": "", "p": "core"}, {"name": "array.write", "description": "", "p": "core"}, {"name": "array.write'", "description": "", "p": "core"}, {"name": "array.read_write", "description": "", "p": "core"}, {"name": "array.pop_back_idx", "description": "", "p": "core"}, {"name": "array.mmap_core", "description": "Auxilliary function for monadically mapping a function over an array.", "p": "core"}, {"name": "d_array.of_beq_aux_eq_ff", "description": "", "p": "core"}, {"name": "d_array.write", "description": "`write a i v` sets the `i`th member of `a` to be `v`. Has builtin VM implementation.", "p": "core"}, {"name": "array.mem", "description": "", "p": "core"}, {"name": "array.ext'", "description": "", "p": "core"}, {"name": "array.read'", "description": "", "p": "core"}, {"name": "d_array.map", "description": "", "p": "core"}, {"name": "d_array.iterate", "description": "Fold over the elements of the given array in ascending order. Has builtin VM implementation.", "p": "core"}, {"name": "d_array.decidable_eq", "description": "", "p": "core"}, {"name": "array.mmap", "description": "Monadically map a function over the array.", "p": "core"}, {"name": "array.map\u2082", "description": "", "p": "core"}, {"name": "array.pop_back", "description": "Discard _last_ element in the array. Has builtin VM implementation.", "p": "core"}, {"name": "mk_array", "description": "`mk_array n v` creates a new array of length `n` where each element is `v`. Has builtin VM implementation.", "p": "core"}, {"name": "array.read_eq_read'", "description": "", "p": "core"}, {"name": "d_array.foreach", "description": "Map the array. Has builtin VM implementation.", "p": "core"}, {"name": "d_array.of_beq_eq_tt", "description": "", "p": "core"}, {"name": "d_array", "description": "In the VM, d_array is implemented as a persistent array.", "p": "core"}, {"name": "d_array.data", "description": "In the VM, d_array is implemented as a persistent array.", "p": "core"}, {"name": "array.foreach", "description": "Map each element of the given array with an index argument.", "p": "core"}, {"name": "d_array.ext'", "description": "", "p": "core"}, {"name": "d_array.ext", "description": "", "p": "core"}, {"name": "d_array.rev_iterate_aux", "description": "", "p": "core"}, {"name": "array.push_back", "description": "`push_back a v` pushes value `v` to the end of the array. Has builtin VM implementation.", "p": "core"}, {"name": "array.rev_foldl", "description": "", "p": "core"}, {"name": "array.iterate", "description": "Fold array starting from 0, folder function includes an index argument.", "p": "core"}, {"name": "d_array.of_beq_eq_ff", "description": "", "p": "core"}, {"name": "array.map", "description": "Map a function over the array.", "p": "core"}, {"name": "array.has_mem", "description": "", "p": "core"}, {"name": "array.ext", "description": "", "p": "core"}, {"name": "array.write_eq_write'", "description": "", "p": "core"}, {"name": "d_array.read_write_of_ne", "description": "", "p": "core"}, {"name": "array.rev_iterate", "description": "", "p": "core"}, {"name": "array.rev_list", "description": "", "p": "core"}, {"name": "d_array.foldl", "description": "", "p": "core"}, {"name": "array.nil", "description": "", "p": "core"}, {"name": "d_array.beq_aux", "description": "", "p": "core"}, {"name": "array.foldl", "description": "", "p": "core"}, {"name": "polyrith.mul_parser", "description": "A parser object that parses `string`s of the form `\"poly.mul p q\"`\nto the appropriate `poly` object representing the product of two `poly`s.\nHere, `p` and `q` are themselves string forms of `poly`s.", "p": "mathlib"}, {"name": "polyrith.poly.has_neg", "description": "", "p": "mathlib"}, {"name": "polyrith.pow_parser", "description": "A parser object that parses `string`s of the form `\"poly.pow p n\"`\nto the appropriate `poly` object representing a `poly` raised to the\npower of a natural number. Here, `p` is the string form of a `poly`\nand `n` is a natural number.", "p": "mathlib"}, {"name": "polyrith.poly.inhabited", "description": "", "p": "mathlib"}, {"name": "polyrith.parse_target_to_poly", "description": " `(vars, poly, typ) \u2190 parse_target_to_poly` interprets the current target (an equality over\nsome field) into a `poly`. The result is a list of the atomic expressions in the target,\nthe `poly` itself, and an `expr` representing the type of the field.", "p": "mathlib"}, {"name": "polyrith.convert_sage_output", "description": " Parse the json output from `scripts/polyrith.py` into either an error message, a list of `poly`\nobjects, or `none` if only trace output was requested.", "p": "mathlib"}, {"name": "polyrith.sage_json_failure.inhabited", "description": "", "p": "mathlib"}, {"name": "polyrith.poly.has_sub", "description": "", "p": "mathlib"}, {"name": "polyrith.sage_json_failure.non_null_json_serializable", "description": "", "p": "mathlib"}, {"name": "polyrith.component_to_lc_format", "description": "Given a pair of `expr`s, where one represents the hypothesis/proof term,\nand the other representes the coefficient attached to it, this tactic\ncreates a string combining the two in the appropriate format for\n`linear_combination`.\n\nThe boolean value returned is `tt` if the format needs to be negated\nto accurately reflect the input expressions.\nThe negation is not applied in the format output by this function,\nbecause it may appear as a negation (if this is the first component)\nor a subtraction.", "p": "mathlib"}, {"name": "polyrith.sage_json_failure", "description": "A schema for failure messages from the python script", "p": "mathlib"}, {"name": "polyrith.sage_json_failure.success", "description": "A schema for failure messages from the python script", "p": "mathlib"}, {"name": "polyrith.sage_json_failure.error_name", "description": "A schema for failure messages from the python script", "p": "mathlib"}, {"name": "polyrith.sage_json_failure.error_value", "description": "A schema for failure messages from the python script", "p": "mathlib"}, {"name": "tactic.interactive.polyrith", "description": "Attempts to prove polynomial equality goals through polynomial arithmetic\non the hypotheses (and additional proof terms if the user specifies them).\nIt proves the goal by generating an appropriate call to the tactic\n`linear_combination`. If this call succeeds, the call to `linear_combination`\nis suggested to the user.\n\n* `polyrith` will use all relevant hypotheses in the local context.\n* `polyrith [t1, t2, t3]` will add proof terms t1, t2, t3 to the local context.\n* `polyrith only [h1, h2, h3, t1, t2, t3]` will use only local hypotheses\n  `h1`, `h2`, `h3`, and proofs `t1`, `t2`, `t3`. It will ignore the rest of the local context.\n\nNotes:\n* This tactic only works with a working internet connection, since it calls Sage\n  using the SageCell web API at <https://sagecell.sagemath.org/>.\n  Many thanks to the Sage team and organization for allowing this use.\n* This tactic assumes that the user has `python3` installed and available on the path.\n  (Test by opening a terminal and executing `python3 --version`.)\n  It also assumes that the `requests` library is installed: `python3 -m pip install requests`.\n\nExamples:\n\n```lean\nexample (x y : \u211a) (h1 : x*y + 2*x = 1) (h2 : x = y) :\n  x*y = -2*y + 1 :=\nby polyrith\n-- Try this: linear_combination h1 - 2 * h2\n\nexample (x y z w : \u211a) (hzw : z = w) : x*z + 2*y*z = x*w + 2*y*w :=\nby polyrith\n-- Try this: linear_combination (2 * y + x) * hzw\n\nconstant scary : \u2200 a b : \u211a, a + b = 0\n\nexample (a b c d : \u211a) (h : a + b = 0) (h2: b + c = 0) : a + b + c + d = 0 :=\nby polyrith only [scary c d, h]\n-- Try this: linear_combination scary c d + h\n```", "p": "mathlib"}, {"name": "polyrith.no_hypotheses_case", "description": "Tactic for the special case when no hypotheses are available.", "p": "mathlib"}, {"name": "polyrith.poly.has_to_format", "description": "", "p": "mathlib"}, {"name": "polyrith.poly_parser", "description": " A parser for `poly` that uses an s-essresion style formats such as\n`(poly.add (poly.var 0) (poly.const 1)`.", "p": "mathlib"}, {"name": "polyrith.const_fraction_parser", "description": "A parser object that parses `string`s of the form `\"poly.const r\"`\nto the appropriate `poly` object representing a rational coefficient.\nHere, `r` is a rational number", "p": "mathlib"}, {"name": "polyrith.process_output", "description": "The second half of `tactic.polyrith` processes the output from Sage into\na call to `linear_combination`.", "p": "mathlib"}, {"name": "polyrith.poly.has_mul", "description": "", "p": "mathlib"}, {"name": "polyrith.add_parser", "description": "A parser object that parses `string`s of the form `\"poly.add p q\"`\nto the appropriate `poly` object representing the sum of two `poly`s.\nHere, `p` and `q` are themselves string forms of `poly`s.", "p": "mathlib"}, {"name": "tactic_doc.tactic.polyrith", "description": "Attempts to prove polynomial equality goals through polynomial arithmetic\non the hypotheses (and additional proof terms if the user specifies them).\nIt proves the goal by generating an appropriate call to the tactic\n`linear_combination`. If this call succeeds, the call to `linear_combination`\nis suggested to the user.\n\n* `polyrith` will use all relevant hypotheses in the local context.\n* `polyrith [t1, t2, t3]` will add proof terms t1, t2, t3 to the local context.\n* `polyrith only [h1, h2, h3, t1, t2, t3]` will use only local hypotheses\n  `h1`, `h2`, `h3`, and proofs `t1`, `t2`, `t3`. It will ignore the rest of the local context.\n\nNotes:\n* This tactic only works with a working internet connection, since it calls Sage\n  using the SageCell web API at <https://sagecell.sagemath.org/>.\n  Many thanks to the Sage team and organization for allowing this use.\n* This tactic assumes that the user has `python3` installed and available on the path.\n  (Test by opening a terminal and executing `python3 --version`.)\n  It also assumes that the `requests` library is installed: `python3 -m pip install requests`.\n\nExamples:\n\n```lean\nexample (x y : \u211a) (h1 : x*y + 2*x = 1) (h2 : x = y) :\n  x*y = -2*y + 1 :=\nby polyrith\n-- Try this: linear_combination h1 - 2 * h2\n\nexample (x y z w : \u211a) (hzw : z = w) : x*z + 2*y*z = x*w + 2*y*w :=\nby polyrith\n-- Try this: linear_combination (2 * y + x) * hzw\n\nconstant scary : \u2200 a b : \u211a, a + b = 0\n\nexample (a b c d : \u211a) (h : a + b = 0) (h2: b + c = 0) : a + b + c + d = 0 :=\nby polyrith only [scary c d, h]\n-- Try this: linear_combination scary c d + h\n```", "p": "mathlib"}, {"name": "polyrith.poly.to_pexpr", "description": "This can convert a `poly` into a `pexpr` that would evaluate to a polynomial.\nTo do so, it uses a list `m` of expressions, the atomic expressions that appear in the `poly`.\nThe index of an expression in this list corresponds to its `poly.var` argument: that is,\nif `e` is the `k`th element of `m`, then it is represented as `poly.var k`.\n\n`poly` objects only contain coefficients from `\u211a`. However, the `poly` object might\nbe referring to a polynomial over some other field. As such, the resulting `pexpr` contains\nno typing information.", "p": "mathlib"}, {"name": "polyrith.poly.decidable_eq", "description": "", "p": "mathlib"}, {"name": "polyrith.create_args", "description": "The first half of `tactic.polyrith` produces a list of arguments to be sent to Sage.", "p": "mathlib"}, {"name": "polyrith.components_to_lc_format", "description": "This tactic repeats the process above for a `list` of pairs of `expr`s.", "p": "mathlib"}, {"name": "polyrith.equality_to_left_side", "description": "Convert an expression of the form `lhs = rhs` into the form `lhs - rhs`", "p": "mathlib"}, {"name": "polyrith.sage_output", "description": "This tactic calls python from the command line with the args in `arg_list`.\nThe output printed to the console is returned as a `string`.\nIt assumes that `python3` is available on the path.", "p": "mathlib"}, {"name": "polyrith.poly_form_of_expr", "description": "`poly_form_of_expr red map e` computes the polynomial form of `e`.\n\n`map` is a lookup map from atomic expressions to variable numbers.\nIf a new atomic expression is encountered, it is added to the map with a new number.\nIt matches atomic expressions up to reducibility given by `red`.\n\nBecause it matches up to definitional equality, this function must be in the `tactic` monad,\nand forces some functions that call it into `tactic` as well.", "p": "mathlib"}, {"name": "polyrith.sage_json_success.non_null_json_serializable", "description": "", "p": "mathlib"}, {"name": "polyrith.get_equalities_of_type", "description": "Filter `l` to the elements which are equalities of type `expt`.", "p": "mathlib"}, {"name": "polyrith.neg_parser", "description": "A parser object that parses `string`s of the form `\"poly.neg p\"`\nto the appropriate `poly` object representing the negation of a `poly`.\nHere, `p` is the string form of a `poly`.", "p": "mathlib"}, {"name": "polyrith.add_parens", "description": "Adds parentheses around additions and subtractions, for printing at\nprecedence 65.", "p": "mathlib"}, {"name": "polyrith.intersperse_ops", "description": "Given a `list (bool \u00d7 format)`, this function uses `+` and `-` to conjoin the\n`format`s in the list. A `format` is negated if its corresponding `bool` is `tt`.", "p": "mathlib"}, {"name": "polyrith.sage_json_success.inhabited", "description": "", "p": "mathlib"}, {"name": "polyrith.sage_json_success", "description": "A schema for success messages from the python script", "p": "mathlib"}, {"name": "polyrith.sage_json_success.success", "description": "A schema for success messages from the python script", "p": "mathlib"}, {"name": "polyrith.sage_json_success.trace", "description": "A schema for success messages from the python script", "p": "mathlib"}, {"name": "polyrith.sage_json_success.data", "description": "A schema for success messages from the python script", "p": "mathlib"}, {"name": "polyrith.sub_parser", "description": "A parser object that parses `string`s of the form `\"poly.sub p q\"`\nto the appropriate `poly` object representing the subtraction of two `poly`s.\nHere, `p` and `q` are themselves string forms of `poly`s.", "p": "mathlib"}, {"name": "polyrith.no_variables_case", "description": "Tactic for the special case when there are no variables.", "p": "mathlib"}, {"name": "polyrith.var_parser", "description": "A parser object that parses `string`s of the form `\"poly.var n\"`\nto the appropriate `poly` object representing a variable.\nHere, `n` is a natural number", "p": "mathlib"}, {"name": "polyrith.poly.non_null_json_serializable", "description": "", "p": "mathlib"}, {"name": "polyrith.poly.has_add", "description": "", "p": "mathlib"}, {"name": "polyrith.parse_ctx_to_polys", "description": "The purpose of this tactic is to collect all the hypotheses\nand proof terms (specified by the user) that are equalities\nof the same type as the target. It takes in an `expr` representing\nthe type, a list of expressions representing the atoms\n(typically this starts as only containing\ninformation about the target), a `bool` representing whether the\nuser used the key word \"only\", and a `list pexpr` of all the\nhypotheses and proof terms selected by the user.\n\nIf the key word \"only\" is used, it collects together only those\nhypotheses/proof terms selected by the user. If not, they are\ncombined with hypotheses from the local context. We throw out\nthose hypotheses that are not equalities of the given type,\nand then modify each equality such that everything has been\nmoved to the left of the \"=\" sign.\n\nThe tactic returns the names of these hypotheses (as `expr`s),\na list of atoms updated with information from all these hypotheses,\nand a list of these hypotheses converted into `poly` objects.", "p": "mathlib"}, {"name": "tactic.polyrith", "description": "This is the main body of the `polyrith` tactic. It takes in the following inputs:\n* `(only_on : bool)` - This represents whether the user used the key word \"only\"\n* `(hyps : list pexpr)` - the hypotheses/proof terms selecteed by the user\n\nFirst, the tactic converts the target into a `poly`, and finds out what type it\nis an equality of. (It also fills up a list of `expr`s with its atoms). Then, it\ncollects all the relevant hypotheses/proof terms from the context, and from those\nselected by the user, taking into account whether `only_on` is true. (The list of atoms is\nupdated accordingly as well).\n\nThis information is used to create a list of args that get used in a call to\nthe appropriate python file that executes a grobner basis computation. The\noutput of this computation is a `string` representing the certificate. This\nstring is parsed into a list of `poly` objects that are then converted into\n`pexpr`s (using the updated list of atoms).\n\nthe names of the hypotheses, along with the corresponding coefficients are\ngiven to `linear_combination`. If that tactic succeeds, the user is prompted\nto replace the call to `polyrith` with the appropriate call to\n`linear_combination`.\n\nThis returns `none` if this was a \"dry run\" attempt that does not actually invoke sage.", "p": "mathlib"}, {"name": "polyrith.poly", "description": "A datatype representing the semantics of multivariable polynomials.\nEach `poly` can be converted into a string.", "p": "mathlib"}, {"name": "polyrith.poly.const", "description": "A datatype representing the semantics of multivariable polynomials.\nEach `poly` can be converted into a string.", "p": "mathlib"}, {"name": "polyrith.poly.var", "description": "A datatype representing the semantics of multivariable polynomials.\nEach `poly` can be converted into a string.", "p": "mathlib"}, {"name": "polyrith.poly.add", "description": "A datatype representing the semantics of multivariable polynomials.\nEach `poly` can be converted into a string.", "p": "mathlib"}, {"name": "polyrith.poly.sub", "description": "A datatype representing the semantics of multivariable polynomials.\nEach `poly` can be converted into a string.", "p": "mathlib"}, {"name": "polyrith.poly.mul", "description": "A datatype representing the semantics of multivariable polynomials.\nEach `poly` can be converted into a string.", "p": "mathlib"}, {"name": "polyrith.poly.pow", "description": "A datatype representing the semantics of multivariable polynomials.\nEach `poly` can be converted into a string.", "p": "mathlib"}, {"name": "polyrith.poly.neg", "description": "A datatype representing the semantics of multivariable polynomials.\nEach `poly` can be converted into a string.", "p": "mathlib"}, {"name": "polyrith.poly_form_of_atom", "description": "`(vars, p) \u2190 poly_form_of_atom red vars e` is the atomic case for `poly_form_of_expr`.\nIf `e` appears with index `k` in `vars`, it returns the singleton sum `p = poly.var k`.\nOtherwise it updates `vars`, adding `e` with index `n`, and returns the singleton `p = poly.var n`.", "p": "mathlib"}, {"name": "polyrith.poly.has_repr", "description": "", "p": "mathlib"}, {"name": "polyrith.poly.mk_string", "description": "This converts a poly object into a string representing it. The string\nmaintains the semantic structure of the poly object.\n\nThe output of this function must be valid Python syntax, and it assumes the variables `varN` from\n`scripts/polyrith.py.`", "p": "mathlib"}, {"name": "polyrith.nat.has_pow", "description": "", "p": "mathlib"}, {"name": "category_theory.preserves_finite_limits_of_flat.fac", "description": "", "p": "mathlib"}, {"name": "category_theory.structured_arrow_cone.to_cone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.representably_flat.id", "description": "", "p": "mathlib"}, {"name": "category_theory.preserves_finite_limits_of_flat.lift", "description": "(Implementation).\nGiven a limit cone `c : cone K` and a cone `s : cone (K \u22d9 F)` with `F` representably flat,\n`s` can factor through `F.map_cone c`.", "p": "mathlib"}, {"name": "category_theory.structured_arrow_cone.to_cone", "description": "Given a cone `c : cone K` and a map `f : X \u27f6 F.obj c.X`, we can construct a cone of structured\narrows over `X` with `f` as the cone point.", "p": "mathlib"}, {"name": "category_theory.structured_arrow_cone.to_diagram_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.structured_arrow_cone.diagram_to_cone", "description": "Given a diagram of `structured_arrow X F`s, we may obtain a cone with cone point `X`.", "p": "mathlib"}, {"name": "category_theory.Lan_preserves_finite_limits_of_flat", "description": "If `F : C \u2964 D` is a representably flat functor between small categories, then the functor\n`Lan F.op` that takes presheaves over `C` to presheaves over `D` preserves finite limits.", "p": "mathlib"}, {"name": "category_theory.representably_flat.comp", "description": "", "p": "mathlib"}, {"name": "category_theory.flat_iff_Lan_flat", "description": "", "p": "mathlib"}, {"name": "category_theory.preserves_finite_limits_iff_Lan_preserves_finite_limits", "description": "If `C` is finitely complete, then `F : C \u2964 D` preserves finite limits iff\n`Lan F.op : (C\u1d52\u1d56 \u2964 Type*) \u2964 (D\u1d52\u1d56 \u2964 Type*)` preserves finite limits.", "p": "mathlib"}, {"name": "category_theory.preserves_finite_limits_of_flat", "description": "Representably flat functors preserve finite limits.", "p": "mathlib"}, {"name": "category_theory.structured_arrow_cone.diagram_to_cone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.structured_arrow_cone.diagram_to_cone_\u03c0_app", "description": "", "p": "mathlib"}, {"name": "category_theory.preserves_finite_limits_of_flat.uniq", "description": "", "p": "mathlib"}, {"name": "category_theory.representably_flat", "description": "A functor `F : C \u2964 D` is representably-flat functor if the comma category `(X/F)`\nis cofiltered for each `X : C`.", "p": "mathlib"}, {"name": "category_theory.representably_flat.cofiltered", "description": "A functor `F : C \u2964 D` is representably-flat functor if the comma category `(X/F)`\nis cofiltered for each `X : C`.", "p": "mathlib"}, {"name": "category_theory.preserves_finite_limits_iff_flat", "description": "If `C` is finitely cocomplete, then `F : C \u2964 D` is representably flat iff it preserves\nfinite limits.", "p": "mathlib"}, {"name": "category_theory.Lan_evaluation_iso_colim", "description": "(Implementation)\nThe evaluation of `Lan F` at `X` is the colimit over the costructured arrows over `X`.", "p": "mathlib"}, {"name": "category_theory.structured_arrow_cone.to_diagram_map", "description": "", "p": "mathlib"}, {"name": "category_theory.flat_of_preserves_finite_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.structured_arrow_cone.to_cone_\u03c0_app", "description": "", "p": "mathlib"}, {"name": "category_theory.cofiltered_of_has_finite_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.structured_arrow_cone.to_diagram", "description": "Given a cone `c : cone K` and a map `f : X \u27f6 c.X`, we can construct a cone of structured\narrows over `X` with `f` as the cone point. This is the underlying diagram.", "p": "mathlib"}, {"name": "category_theory.Lan_preserves_finite_limits_of_preserves_finite_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.Lan_flat_of_flat", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.equiv_direct_sum_symm_apply", "description": "", "p": "mathlib"}, {"name": "tensor_power.to_tensor_algebra", "description": "The canonical embedding from a tensor power to the tensor algebra", "p": "mathlib"}, {"name": "tensor_power.to_tensor_algebra_ghas_mul", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.to_direct_sum_tensor_power_tprod", "description": "", "p": "mathlib"}, {"name": "tensor_power.list_prod_graded_monoid_mk_single", "description": " The product of tensor products made of a single vector is the same as a single product of\nall the vectors.", "p": "mathlib"}, {"name": "tensor_algebra.mk_reindex_fin_cast", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.to_direct_sum_\u03b9", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.to_direct_sum_of_direct_sum", "description": "", "p": "mathlib"}, {"name": "tensor_power.to_tensor_algebra_galgebra_to_fun", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.of_direct_sum_comp_to_direct_sum", "description": "", "p": "mathlib"}, {"name": "tensor_power.to_tensor_algebra_tprod", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.of_direct_sum_of_tprod", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.equiv_direct_sum", "description": "The tensor algebra is isomorphic to a direct sum of tensor powers.", "p": "mathlib"}, {"name": "tensor_algebra.to_direct_sum_comp_of_direct_sum", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.of_direct_sum", "description": "The canonical map from a direct sum of tensor powers to the tensor algebra.", "p": "mathlib"}, {"name": "tensor_algebra.equiv_direct_sum_apply", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.mk_reindex_cast", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.of_direct_sum_to_direct_sum", "description": "", "p": "mathlib"}, {"name": "tensor_algebra.to_direct_sum", "description": "The canonical map from the tensor algebra to a direct sum of tensor powers.", "p": "mathlib"}, {"name": "tensor_power.to_tensor_algebra_ghas_one", "description": "", "p": "mathlib"}, {"name": "pgame.numeric_zero", "description": "", "p": "mathlib"}, {"name": "pgame.lt_iff_exists_le", "description": "Definition of `x < y` on numeric pre-games, in terms of `\u2264`", "p": "mathlib"}, {"name": "pgame.relabelling.numeric_congr", "description": "Relabellings preserve being numeric.", "p": "mathlib"}, {"name": "surreal.inhabited", "description": "", "p": "mathlib"}, {"name": "surreal.has_one", "description": "", "p": "mathlib"}, {"name": "pgame.lt_def", "description": "The definition of `x < y` on numeric pre-games, in terms of `<` two moves later.", "p": "mathlib"}, {"name": "pgame.numeric.move_left_le", "description": "", "p": "mathlib"}, {"name": "surreal.upper_bound_numeric", "description": "", "p": "mathlib"}, {"name": "pgame.lt_of_exists_le", "description": "", "p": "mathlib"}, {"name": "surreal.ordered_add_comm_group", "description": "", "p": "mathlib"}, {"name": "pgame.numeric_nat", "description": "Pre-games defined by natural numbers are numeric.", "p": "mathlib"}, {"name": "pgame.numeric", "description": " A pre-game is numeric if everything in the L set is less than everything in the R set,\nand all the elements of L and R are also numeric.", "p": "mathlib"}, {"name": "pgame.numeric.le_move_right", "description": "", "p": "mathlib"}, {"name": "pgame.numeric_one", "description": "", "p": "mathlib"}, {"name": "pgame.lf.lt", "description": "**Alias** of `pgame.lt_of_lf`.", "p": "mathlib"}, {"name": "pgame.numeric.left_lt_right", "description": "", "p": "mathlib"}, {"name": "pgame.lf.le", "description": "**Alias** of `pgame.le_of_lf`.", "p": "mathlib"}, {"name": "pgame.numeric.lt_move_right", "description": "", "p": "mathlib"}, {"name": "surreal.lift\u2082", "description": "Lift a binary equivalence-respecting function on pre-games to surreals.", "p": "mathlib"}, {"name": "pgame.lf_asymm", "description": "", "p": "mathlib"}, {"name": "surreal.has_add", "description": " Addition on surreals is inherited from pre-game addition:\nthe sum of `x = {xL | xR}` and `y = {yL | yR}` is `{xL + y, x + yL | xR + y, x + yR}`.", "p": "mathlib"}, {"name": "pgame.numeric_of_is_empty_right_moves", "description": "", "p": "mathlib"}, {"name": "pgame.le_of_lf", "description": "", "p": "mathlib"}, {"name": "pgame.numeric_to_pgame", "description": "Ordinal games are numeric.", "p": "mathlib"}, {"name": "surreal.one_to_game", "description": "", "p": "mathlib"}, {"name": "surreal.mk", "description": "Construct a surreal number from a numeric pre-game.", "p": "mathlib"}, {"name": "pgame.lf_iff_lt", "description": "", "p"