, {"name": "real.logb_nonpos", "description": "", "p": "mathlib"}, {"name": "real.logb_ne_zero_of_pos_of_ne_one_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.logb_neg_iff", "description": "", "p": "mathlib"}, {"name": "real.logb_nonneg", "description": "", "p": "mathlib"}, {"name": "real.logb_pos_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.logb_ne_zero_of_pos_of_ne_one", "description": "", "p": "mathlib"}, {"name": "real.logb_inj_on_pos_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.logb_lt_iff_lt_rpow", "description": "", "p": "mathlib"}, {"name": "real.logb_mul_base", "description": "", "p": "mathlib"}, {"name": "real.tendsto_logb_at_top_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.logb_lt_logb_iff", "description": "", "p": "mathlib"}, {"name": "real.inv_logb", "description": "", "p": "mathlib"}, {"name": "real.logb_nonneg_iff_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.range_logb", "description": "", "p": "mathlib"}, {"name": "real.surj_on_logb'", "description": "", "p": "mathlib"}, {"name": "real.logb_pos_iff", "description": "", "p": "mathlib"}, {"name": "real.floor_logb_nat_cast", "description": "", "p": "mathlib"}, {"name": "real.inv_logb_div_base", "description": "", "p": "mathlib"}, {"name": "real.logb_div_base", "description": "", "p": "mathlib"}, {"name": "real.logb_rpow", "description": "", "p": "mathlib"}, {"name": "real.logb_inv", "description": "", "p": "mathlib"}, {"name": "real.logb_eq_zero", "description": "", "p": "mathlib"}, {"name": "real.logb_nonpos_iff", "description": "", "p": "mathlib"}, {"name": "real.eq_one_of_pos_of_logb_eq_zero", "description": "", "p": "mathlib"}, {"name": "real.logb_neg", "description": "", "p": "mathlib"}, {"name": "real.logb_pos", "description": "", "p": "mathlib"}, {"name": "real.logb_pos_iff_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.rpow_logb_of_neg", "description": "", "p": "mathlib"}, {"name": "real.logb_lt_logb_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.strict_anti_on_logb_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.logb_nonneg_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.logb_inj_on_pos", "description": "", "p": "mathlib"}, {"name": "real.strict_anti_on_logb", "description": "", "p": "mathlib"}, {"name": "real.lt_logb_iff_rpow_lt_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "real.logb_neg_of_base_lt_one", "description": "", "p": "mathlib"}, {"name": "is_local_extr_on.closure", "description": "", "p": "mathlib"}, {"name": "is_local_max_on.closure", "description": "", "p": "mathlib"}, {"name": "is_max_on.closure", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.closure", "description": "", "p": "mathlib"}, {"name": "is_min_on.closure", "description": "", "p": "mathlib"}, {"name": "is_extr_on.closure", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.map_id", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.has_coe_t", "description": "Automatic coercion from `\u03b1` to its completion. Not always injective.", "p": "mathlib"}, {"name": "uniform_space.completion.extension_unique", "description": "", "p": "mathlib"}, {"name": "Cauchy.uniform_embedding_pure_cauchy", "description": "", "p": "mathlib"}, {"name": "Cauchy.extend", "description": " Extend a uniformly continuous function `\u03b1 \u2192 \u03b2` to a function `Cauchy \u03b1 \u2192 \u03b2`. Outputs junk when\n`f` is not uniformly continuous.", "p": "mathlib"}, {"name": "uniform_space.completion.induction_on\u2083", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.dense_embedding_coe", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.dense_range_coe\u2082", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.continuous_map", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.separated_space", "description": "", "p": "mathlib"}, {"name": "Cauchy.inhabited", "description": "", "p": "mathlib"}, {"name": "Cauchy.separated_pure_cauchy_injective", "description": "", "p": "mathlib"}, {"name": "Cauchy.mem_uniformity", "description": "", "p": "mathlib"}, {"name": "Cauchy.complete_space", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.extension\u2082", "description": "Extend a two variable map to the Hausdorff completions.", "p": "mathlib"}, {"name": "uniform_space.completion.extension_coe", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.comap_coe_eq_uniformity", "description": "", "p": "mathlib"}, {"name": "Cauchy.mem_uniformity'", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.uniform_continuous_extension", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.ext", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.extension\u2082_coe_coe", "description": "", "p": "mathlib"}, {"name": "Cauchy.dense_embedding_pure_cauchy", "description": "", "p": "mathlib"}, {"name": "Cauchy.uniform_inducing_pure_cauchy", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.map\u2082_coe_coe", "description": "", "p": "mathlib"}, {"name": "Cauchy.gen", "description": "The pairs of Cauchy filters generated by a set.", "p": "mathlib"}, {"name": "uniform_space.completion.dense_range_coe\u2083", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.map_coe", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.continuous_map\u2082", "description": "", "p": "mathlib"}, {"name": "uniform_space.completion.extension", "description": " \"Extension\" to the completion. It is defined for any map `f` but\nreturns an arbitrary constant value if `f` is not uniformly continuous", "p": "mathlib"}, {"name": "uniform_space.completion.dense_inducing_coe", "description": "", "p": "mathlib"}, {"name": "unif