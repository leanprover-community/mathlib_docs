mathlib"}, {"name": "prod.measurable_space", "description": "", "p": "mathlib"}, {"name": "measurable_find_greatest", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.pi_fin_succ_above_equiv_apply", "description": "", "p": "mathlib"}, {"name": "measurable_prod_mk_right", "description": "", "p": "mathlib"}, {"name": "measurable_tprod_mk", "description": "", "p": "mathlib"}, {"name": "measurable_space.map_comp", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.sum_prod_sum", "description": "Products distribute over sums as measurable spaces.", "p": "mathlib"}, {"name": "measurable_quotient_mk", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.pi_fin_two_apply", "description": "", "p": "mathlib"}, {"name": "measurable_of_subsingleton_codomain", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.fin_two_arrow_apply", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.measurable_set_image", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.refl", "description": "Any measurable space is equivalent to itself.", "p": "mathlib"}, {"name": "measurable_set.coe_insert", "description": "", "p": "mathlib"}, {"name": "measurable_space.comap_sup", "description": "", "p": "mathlib"}, {"name": "measurable_set.prod", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.image_eq_preimage", "description": "", "p": "mathlib"}, {"name": "measurable_set_range_inl", "description": "", "p": "mathlib"}, {"name": "measurable_of_measurable_on_compl_finite", "description": "", "p": "mathlib"}, {"name": "measurable.subtype_mk", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.measurable_comp_iff", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.measurable", "description": "", "p": "mathlib"}, {"name": "quotient.measurable_space", "description": "", "p": "mathlib"}, {"name": "measurable_space.comap_eq_generate_from", "description": "", "p": "mathlib"}, {"name": "measurable_space.prod", "description": "A `measurable_space` structure on the product of two measurable spaces.", "p": "mathlib"}, {"name": "measurable_set_prod_of_nonempty", "description": "", "p": "mathlib"}, {"name": "measurable_space.comap", "description": "The reverse image of a measurable space under a function. `comap f m` contains the sets\n `s : set \u03b1` such that `s` is the `f`-preimage of a measurable set in `\u03b2`.", "p": "mathlib"}, {"name": "measurable_inr", "description": "", "p": "mathlib"}, {"name": "measurable_set.measurable_set_limsup", "description": "", "p": "mathlib"}, {"name": "measurable_const'", "description": " A version of `measurable_const` that assumes `f x = f y` for all `x, y`. This version works\nfor functions between empty types.", "p": "mathlib"}, {"name": "measurable_space.comap_map_le", "description": "", "p": "mathlib"}, {"name": "measurable_of_countable", "description": "", "p": "mathlib"}, {"name": "measurable_to_prop", "description": "", "p": "mathlib"}, {"name": "measurable_set.coe_inter", "description": "", "p": "mathlib"}, {"name": "measurable_quotient_mk'", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.prod_assoc", "description": "Products of measurable spaces are associative.", "p": "mathlib"}, {"name": "measurable_find", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.equiv_range", "description": "The domain of `f` is equivalent to its range as measurable spaces,\n if `f` is a measurable embedding", "p": "mathlib"}, {"name": "measurable_set.subtype.has_inter", "description": "", "p": "mathlib"}, {"name": "measurable_set.subtype.has_sdiff", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.schroeder_bernstein", "description": " The **`measurable Schr\u00f6der-Bernstein Theorem**: Given measurable embeddings\n`\u03b1 \u2192 \u03b2` and `\u03b2 \u2192 \u03b1`, we can find a measurable equivalence `\u03b1 \u2243\u1d50 \u03b2`.", "p": "mathlib"}, {"name": "measurable_equiv.set.range_inr", "description": "`\u03b2` is equivalent to its image in `\u03b1 \u2295 \u03b2` as measurable spaces.", "p": "mathlib"}, {"name": "is_countably_spanning", "description": "We say that a collection of sets is countably spanning if a countable subset spans the\n whole type. This is a useful condition in various parts of measure theory. For example, it is\n a needed condition to show that the product of two collections generate the product sigma algebra,\n see `generate_from_prod_eq`.", "p": "mathlib"}, {"name": "measurable_equiv.prod_congr", "description": "Products of equivalent measurable spaces are equivalent.", "p": "mathlib"}, {"name": "exists_measurable_piecewise_nat", "description": " Given countably many disjoint measurable sets `t n` and countably many measurable\nfunctions `g n`, one can construct a measurable function that coincides with `g n` on `t n`.", "p": "mathlib"}, {"name": "measurable_zero", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.to_equiv_injective", "description": "", "p": "mathlib"}, {"name": "bool.measurable_space", "description": "", "p": "mathlib"}, {"name": "measurable_space.gc_comap_map", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.fin_two_arrow_to_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.Pi_congr_right", "description": "A family of measurable equivalences `\u03a0 a, \u03b2\u2081 a \u2243\u1d50 \u03b2\u2082 a` generates a measurable equivalence\n between  `\u03a0 a, \u03b2\u2081 a` and `\u03a0 a, \u03b2\u2082 a`.", "p": "mathlib"}, {"name": "punit.measurable_space", "description": "", "p": "mathlib"}, {"name": "measurable_space.comap_supr", "description": "", "p": "mathlib"}, {"name": "measurable_set.coe_sdiff", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.fun_unique_to_equiv", "description": "", "p": "mathlib"}, {"name": "measurable_tprod_elim", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.symm_preimage_preimage", "description": "", "p": "mathlib"}, {"name": "comap_measurable", "description": "", "p": "mathlib"}, {"name": "measurable_space.map_inf", "description": "", "p": "mathlib"}, {"name": "measurable_set_swap_iff", "description": "", "p": "mathlib"}, {"name": "prod.measurable_singleton_class", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.fun_unique_apply", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.coe_mk", "description": "", "p": "mathlib"}, {"name": "measurable.ite", "description": " this is slightly different from `measurable.piecewise`. It can be used to show\n`measurable (ite (x=0) 0 1)` by\n`exact measurable.ite (measurable_set_singleton 0) measurable_const measurable_const`,\nbut replacing `measurable.ite` by `measurable.piecewise` in that example proof does not work.", "p": "mathlib"}, {"name": "measurable_set_quotient", "description": "", "p": "mathlib"}, {"name": "measurable.comap_le", "description": "**Alias** of the forward direction of `measurable_iff_comap_le`.", "p": "mathlib"}, {"name": "measurable.prod_map", "description": "", "p": "mathlib"}, {"name": "measurable_of_measurable_union_cover", "description": "", "p": "mathlib"}, {"name": "measurable_set.mem_coe", "description": "", "p": "mathlib"}, {"name": "measurable_mem", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.self_comp_symm", "description": "", "p": "mathlib"}, {"name": "measurable_set.subtype.bounded_order", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.apply_symm_apply", "description": "", "p": "mathlib"}, {"name": "measurable.of_comap_le", "description": "**Alias** of the reverse direction of `measurable_iff_comap_le`.", "p": "mathlib"}, {"name": "measurable_equiv.symm_apply_apply", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.pi_equiv_pi_subtype_prod", "description": " Measurable equivalence between (dependent) functions on a type and pairs of functions on\n`{i // p i}` and `{i // \u00acp i}`. See also `equiv.pi_equiv_pi_subtype_prod`.", "p": "mathlib"}, {"name": "quot.measurable_space", "description": "", "p": "mathlib"}, {"name": "measurable_set.tprod", "description": "", "p": "mathlib"}, {"name": "measurable_update", "description": "The function `update f a : \u03c0 a \u2192 \u03a0 a, \u03c0 a` is always measurable.\n This doesn't require `f` to be measurable.\n This should not be confused with the statement that `update f a x` is measurable.", "p": "mathlib"}, {"name": "measurable_equiv.pi_fin_two_to_equiv", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.set.singleton", "description": "`{a} \u2243 unit` as measurable spaces.", "p": "mathlib"}, {"name": "measurable_to_countable", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.pi_measurable_equiv_tprod", "description": "Pi-types are measurably equivalent to iterated products.", "p": "mathlib"}, {"name": "filter.principal_is_measurably_generated_iff", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.measurable_set_preimage", "description": "", "p": "mathlib"}, {"name": "measurable_set_preimage", "description": "", "p": "mathlib"}, {"name": "filter.eventually.exists_measurable_mem_of_small_sets", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.prod_comm", "description": "Products of measurable spaces are symmetric.", "p": "mathlib"}, {"name": "rat.measurable_singleton_class", "description": "", "p": "mathlib"}, {"name": "measurable.prod_mk", "description": "", "p": "mathlib"}, {"name": "measurable_iff_le_map", "description": "", "p": "mathlib"}, {"name": "measurable_to_bool", "description": "", "p": "mathlib"}, {"name": "measurable_set.subtype.has_insert", "description": "", "p": "mathlib"}, {"name": "is_countably_spanning_measurable_set", "description": "", "p": "mathlib"}, {"name": "measurable_one", "description": "", "p": "mathlib"}, {"name": "measurable_set.principal_is_measurably_generated", "description": "**Alias** of the reverse direction of `filter.principal_is_measurably_generated_iff`.", "p": "mathlib"}, {"name": "measurable_set.subtype.has_compl", "description": "", "p": "mathlib"}, {"name": "measurable_from_top", "description": "", "p": "mathlib"}, {"name": "Prop.measurable_singleton_class", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.iff_comap_eq", "description": "", "p": "mathlib"}, {"name": "measurable_space.comap_mono", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.fun_unique_symm_apply", "description": "", "p": "mathlib"}, {"name": "measurable_set.subtype.boolean_algebra", "description": "", "p": "mathlib"}, {"name": "measurable_prod_mk_left", "description": "", "p": "mathlib"}, {"name": "filter.is_measurably_generated", "description": "A filter `f` is measurably generates if each `s \u2208 f` includes a measurable `t \u2208 f`.", "p": "mathlib"}, {"name": "filter.is_measurably_generated.exists_measurable_subset", "description": "A filter `f` is measurably generates if each `s \u2208 f` includes a measurable `t \u2208 f`.", "p": "mathlib"}, {"name": "measurable_embedding.measurable_set_range", "description": "", "p": "mathlib"}, {"name": "measurable_pi_equiv_pi_subtype_prod_symm", "description": "", "p": "mathlib"}, {"name": "measurable_space.map_top", "description": "", "p": "mathlib"}, {"name": "measurable_set_inr_image", "description": "", "p": "mathlib"}, {"name": "measurable_space.map", "description": "The forward image of a measurable space under a function. `map f m` contains the sets\n `s : set \u03b2` whose preimage under `f` is measurable.", "p": "mathlib"}, {"name": "measurable_equiv.symm", "description": "The inverse of an equivalence between measurable spaces.", "p": "mathlib"}, {"name": "measurable_equiv.measurable_comp_iff", "description": "", "p": "mathlib"}, {"name": "measurable_space.map_infi", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.set.prod", "description": "`s \u00d7\u02e2 t \u2243 (s \u00d7 t)` as measurable spaces.", "p": "mathlib"}, {"name": "measurable_set.subtype.has_bot", "description": "", "p": "mathlib"}, {"name": "measurable_space.measurable_injection_nat_bool_of_countably_generated", "description": " If a measurable space is countably generated, it admits a measurable injection\ninto the Cantor space `\u2115 \u2192 bool` (equipped with the product sigma algebra).", "p": "mathlib"}, {"name": "measurable_from_quotient", "description": "", "p": "mathlib"}, {"name": "measurable_unit", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.symm_comp_self", "description": "", "p": "mathlib"}, {"name": "empty.measurable_singleton_class", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.symm_refl", "description": "", "p": "mathlib"}, {"name": "filter.is_measurably_generated_top", "description": "", "p": "mathlib"}, {"name": "measurable.measurable_of_countable_ne", "description": " If a function coincides with a measurable function outside of a countable set, it is\nmeasurable.", "p": "mathlib"}, {"name": "measurable_set.exists_measurable_proj", "description": "", "p": "mathlib"}, {"name": "measurable_space.pi", "description": "", "p": "mathlib"}, {"name": "measurable_iff_comap_le", "description": "", "p": "mathlib"}, {"name": "quotient_group.measurable_coe", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.bijective", "description": "", "p": "mathlib"}, {"name": "sigma.measurable_space", "description": "", "p": "mathlib"}, {"name": "measurable.snd", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.pi_fin_two", "description": "The space `\u03a0 i : fin 2, \u03b1 i` is measurably equivalent to `\u03b1 0 \u00d7 \u03b1 1`.", "p": "mathlib"}, {"name": "measurable_equiv.pi_measurable_equiv_tprod_to_equiv", "description": "", "p": "mathlib"}, {"name": "measurable_embedding", "description": " A map `f : \u03b1 \u2192 \u03b2` is called a *measurable embedding* if it is injective, measurable, and sends\nmeasurable sets to measurable sets. The latter assumption can be replaced with \u201c`f` has measurable\ninverse `g : range f \u2192 \u03b1`\u201d, see `measurable_embedding.measurable_range_splitting`,\n`measurable_embedding.of_measurable_inverse_range`, and\n`measurable_embedding.of_measurable_inverse`.\n\nOne more interpretation: `f` is a measurable embedding if it defines a measurable equivalence to its\nrange and the range is a measurable set. One implication is formalized as\n`measurable_embedding.equiv_range`; the other one follows from\n`measurable_equiv.measurable_embedding`, `measurable_embedding.subtype_coe`, and\n`measurable_embedding.comp`.", "p": "mathlib"}, {"name": "measurable_embedding.injective", "description": " A map `f : \u03b1 \u2192 \u03b2` is called a *measurable embedding* if it is injective, measurable, and sends\nmeasurable sets to measurable sets. The latter assumption can be replaced with \u201c`f` has measurable\ninverse `g : range f \u2192 \u03b1`\u201d, see `measurable_embedding.measurable_range_splitting`,\n`measurable_embedding.of_measurable_inverse_range`, and\n`measurable_embedding.of_measurable_inverse`.\n\nOne more interpretation: `f` is a measurable embedding if it defines a measurable equivalence to its\nrange and the range is a measurable set. One implication is formalized as\n`measurable_embedding.equiv_range`; the other one follows from\n`measurable_equiv.measurable_embedding`, `measurable_embedding.subtype_coe`, and\n`measurable_embedding.comp`.", "p": "mathlib"}, {"name": "measurable_embedding.measurable", "description": " A map `f : \u03b1 \u2192 \u03b2` is called a *measurable embedding* if it is injective, measurable, and sends\nmeasurable sets to measurable sets. The latter assumption can be replaced with \u201c`f` has measurable\ninverse `g : range f \u2192 \u03b1`\u201d, see `measurable_embedding.measurable_range_splitting`,\n`measurable_embedding.of_measurable_inverse_range`, and\n`measurable_embedding.of_measurable_inverse`.\n\nOne more interpretation: `f` is a measurable embedding if it defines a measurable equivalence to its\nrange and the range is a measurable set. One implication is formalized as\n`measurable_embedding.equiv_range`; the other one follows from\n`measurable_equiv.measurable_embedding`, `measurable_embedding.subtype_coe`, and\n`measurable_embedding.comp`.", "p": "mathlib"}, {"name": "measurable_embedding.measurable_set_image'", "description": " A map `f : \u03b1 \u2192 \u03b2` is called a *measurable embedding* if it is injective, measurable, and sends\nmeasurable sets to measurable sets. The latter assumption can be replaced with \u201c`f` has measurable\ninverse `g : range f \u2192 \u03b1`\u201d, see `measurable_embedding.measurable_range_splitting`,\n`measurable_embedding.of_measurable_inverse_range`, and\n`measurable_embedding.of_measurable_inverse`.\n\nOne more interpretation: `f` is a measurable embedding if it defines a measurable equivalence to its\nrange and the range is a measurable set. One implication is formalized as\n`measurable_embedding.equiv_range`; the other one follows from\n`measurable_equiv.measurable_embedding`, `measurable_embedding.subtype_coe`, and\n`measurable_embedding.comp`.", "p": "mathlib"}, {"name": "measurable_equiv.fin_two_arrow_to_equiv_apply", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.injective", "description": "", "p": "mathlib"}, {"name": "bool.measurable_singleton_class", "description": "", "p": "mathlib"}, {"name": "measurable_set_prod", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.pi_fin_succ_above_equiv_to_equiv", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.of_measurable_inverse", "description": "", "p": "mathlib"}, {"name": "measurable_of_measurable_on_compl_singleton", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.comap_eq", "description": "", "p": "mathlib"}, {"name": "measurable_space.le_map_comap", "description": "", "p": "mathlib"}, {"name": "measurable_from_prod_countable", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.surjective", "description": "", "p": "mathlib"}, {"name": "measurable.of_uncurry_left", "description": "", "p": "mathlib"}, {"name": "measurable_pi_iff", "description": "", "p": "mathlib"}, {"name": "measurable_set.mem", "description": "**Alias** of the reverse direction of `measurable_mem`.", "p": "mathlib"}, {"name": "nat.measurable_space", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.self_trans_symm", "description": "", "p": "mathlib"}, {"name": "sum.measurable_space", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.sum_prod_distrib", "description": "Products distribute over sums (on the right) as measurable spaces.", "p": "mathlib"}, {"name": "measurable_equiv.symm_mk", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.refl_apply", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.pi_measurable_equiv_tprod_symm_apply", "description": "", "p": "mathlib"}, {"name": "measurable_snd", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.comp", "description": "", "p": "mathlib"}, {"name": "measurable_pi_apply", "description": "", "p": "mathlib"}, {"name": "measurable_to_countable'", "description": "", "p": "mathlib"}, {"name": "measurable.subtype_coe", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.measurable_range_splitting", "description": "", "p": "mathlib"}, {"name": "measurable.eval", "description": "", "p": "mathlib"}, {"name": "measurable_set.subtype.has_emptyc", "description": "", "p": "mathlib"}, {"name": "measurable_set.measurable_set_liminf", "description": "", "p": "mathlib"}, {"name": "measurable_equiv.coe_to_equiv", "description": "", "p": "mathlib"}, {"name": "subsingleton.measurable", "description": "", "p": "mathlib"}, {"name": "measurable_set_range_inr", "description": "", "p": "mathlib"}, {"name": "measurable_embedding.measurable_set_image", "description": "", "p": "mathlib"}, {"na