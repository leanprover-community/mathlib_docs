_add", "description": "", "p": "mathlib"}, {"name": "vector_ex_iff_exists", "description": "", "p": "mathlib"}, {"name": "vector3.insert_fs", "description": "", "p": "mathlib"}, {"name": "vector3.append_cons", "description": "", "p": "mathlib"}, {"name": "vector3.insert", "description": "Insert `a` into `v` at index `i`.", "p": "mathlib"}, {"name": "vector3.eq_nil", "description": "", "p": "mathlib"}, {"name": "vector3", "description": "Alternate definition of `vector` based on `fin2`.", "p": "mathlib"}, {"name": "exists_vector_zero", "description": "", "p": "mathlib"}, {"name": "vector_all_iff_forall", "description": "", "p": "mathlib"}, {"name": "vector3.cons_fs", "description": "", "p": "mathlib"}, {"name": "vector3.append_left", "description": "", "p": "mathlib"}, {"name": "vector3.cons_elim", "description": "Recursion principle for a nonempty vector.", "p": "mathlib"}, {"name": "vector3.nth", "description": "Get the `i`th element of a vector", "p": "mathlib"}, {"name": "vector3.rec_on_cons", "description": "", "p": "mathlib"}, {"name": "vector_allp_singleton", "description": "", "p": "mathlib"}, {"name": "commute_lmul_rmul_sq", "description": "", "p": "mathlib"}, {"name": "commute_lmul_rmul", "description": "", "p": "mathlib"}, {"name": "is_comm_jordan.to_is_jordan", "description": "A (commutative) Jordan multiplication is also a Jordan multipication", "p": "mathlib"}, {"name": "commute_rmul_rmul_sq", "description": "", "p": "mathlib"}, {"name": "is_comm_jordan", "description": "A commutative Jordan multipication", "p": "mathlib"}, {"name": "is_comm_jordan.mul_comm", "description": "A commutative Jordan multipication", "p": "mathlib"}, {"name": "is_comm_jordan.lmul_comm_rmul_rmul", "description": "A commutative Jordan multipication", "p": "mathlib"}, {"name": "is_jordan", "description": "A (non-commutative) Jordan multiplication.", "p": "mathlib"}, {"name": "is_jordan.lmul_comm_rmul", "description": "A (non-commutative) Jordan multiplication.", "p": "mathlib"}, {"name": "is_jordan.lmul_lmul_comm_lmul", "description": "A (non-commutative) Jordan multiplication.", "p": "mathlib"}, {"name": "is_jordan.lmul_lmul_comm_rmul", "description": "A (non-commutative) Jordan multiplication.", "p": "mathlib"}, {"name": "is_jordan.lmul_comm_rmul_rmul", "description": "A (non-commutative) Jordan multiplication.", "p": "mathlib"}, {"name": "is_jordan.rmul_comm_rmul_rmul", "description": "A (non-commutative) Jordan multiplication.", "p": "mathlib"}, {"name": "comm_semigroup.is_comm_jordan", "description": "", "p": "mathlib"}, {"name": "semigroup.is_jordan", "description": "Semigroup multiplication satisfies the (non-commutative) Jordan axioms", "p": "mathlib"}, {"name": "commute_lmul_lmul_sq", "description": "", "p": "mathlib"}, {"name": "two_nsmul_lie_lmul_lmul_add_add_eq_zero", "description": "", "p": "mathlib"}, {"name": "two_nsmul_lie_lmul_lmul_add_eq_lie_lmul_lmul_add", "description": "", "p": "mathlib"}, {"name": "commute_lmul_sq_rmul", "description": "", "p": "mathlib"}, {"name": "inv_monoid_with_zero_hom", "description": "Inversion on a commutative group with zero, considered as a monoid with zero homomorphism.", "p": "mathlib"}, {"name": "map_ne_zero", "description": "", "p": "mathlib"}, {"name": "div_eq_of_eq_mul", "description": "", "p": "mathlib"}, {"name": "map_inv\u2080", "description": "A monoid homomorphism between groups with zeros sending `0` to `0` sends `a\u207b\u00b9` to `(f a)\u207b\u00b9`.", "p": "mathlib"}, {"name": "inv_mul_eq_iff_eq_mul\u2080", "description": "", "p": "mathlib"}, {"name": "mul_eq_one_iff_eq_inv\u2080", "description": "", "p": "mathlib"}, {"name": "mul_div_cancel_of_imp'", "description": "", "p": "mathlib"}, {"name": "div_mul_div_cancel", "description": "", "p": "mathlib"}, {"name": "div_mul_cancel", "description": "", "p": "mathlib"}, {"name": "mul_div_cancel_left", "description": "", "p": "mathlib"}, {"name": "div_self", "description": "", "p": "mathlib"}, {"name": "div_helper", "description": "", "p": "mathlib"}, {"name": "div_mul_left", "description": "", "p": "mathlib"}, {"name": "mul_one_div_cancel", "description": "", "p": "mathlib"}, {"name": "map_eq_zero", "description": "", "p": "mathlib"}, {"name": "eq_div_of_mul_eq", "description": "", "p": "mathlib"}, {"name": "eq_mul_inv_iff_mul_eq\u2080", "description": "", "p": "mathlib"}, {"name": "mul_eq_one_iff_inv_eq\u2080", "description": "", "p": "mathlib"}, {"name": "inv_mul_eq_one\u2080", "description": "", "p": "mathlib"}, {"name": "eq_inv_mul_iff_mul_eq\u2080", "description": "", "p": "mathlib"}, {"name": "one_div_mul_cancel", "description": "", "p": "mathlib"}, {"name": "div_mul_right", "description": "", "p": "mathlib"}, {"name": "monoid_with_zero.inverse_apply", "description": "", "p": "mathlib"}, {"name": "units.smul_mk0", "description": "", "p": "mathlib"}, {"name": "div_div_div_cancel_right", "description": "", "p": "mathlib"}, {"name": "monoid_with_zero.coe_inverse", "description": "", "p": "mathlib"}, {"name": "div_eq_iff_mul_eq", "description": "", "p": "mathlib"}, {"name": "div_eq_iff", "description": "", "p": "mathlib"}, {"name": "div_div_cancel'", "description": "", "p": "mathlib"}, {"name": "mul_eq_mul_of_div_eq_div", "description": "", "p": "mathlib"}, {"name": "div_eq_one_iff_eq", "description": "", "p": "mathlib"}, {"name": "mul_div_mul_left", "description": "", "p": "mathlib"}, {"name": "div_div_cancel_left'", "description": "", "p": "mathlib"}, {"name": "mul_inv_eq_iff_eq_mul\u2080", "description": "", "p": "mathlib"}, {"name": "mul_div_cancel'", "description": "", "p": "mathlib"}, {"name": "mul_div_mul_right", "description": "", "p": "mathlib"}, {"name": "eq_div_iff", "description": "", "p": "mathlib"}, {"name": "mul_div_cancel", "description": "", "p": "mathlib"}, {"name": "mul_inv_eq_one\u2080", "description": "", "p": "mathlib"}, {"name": "div_left_inj'", "description": "", "p": "mathlib"}, {"name": "mul_mul_div", "description": "", "p": "mathlib"}, {"name": "div_mul_cancel_of_imp", "description": "", "p": "mathlib"}, {"name": "map_div\u2080", "description": "", "p": "mathlib"}, {"name": "eq_on_inv\u2080", "description": "", "p": "mathlib"}, {"name": "div_eq_div_iff", "description": "", "p": "mathlib"}, {"name": "mul_div_cancel_of_imp", "description": "", "p": "mathlib"}, {"name": "mul_div_cancel_left_of_imp", "description": "", "p": "mathlib"}, {"name": "divp_mk0", "description": "", "p": "mathlib"}, {"name": "eq_div_iff_mul_eq", "description": "", "p": "mathlib"}, {"name": "monoid_with_zero.inverse", "description": " We define the inverse as a `monoid_with_zero_hom` by extending the inverse map by zero\non non-units.", "p": "mathlib"}, {"name": "quasiconcave_on.dual", "description": "", "p": "mathlib"}, {"name": "monotone.quasilinear_on", "description": "", "p": "mathlib"}, {"name": "antitone.quasiconvex_on", "description": "", "p": "mathlib"}, {"name": "quasilinear_on", "description": " A function is quasilinear if it is both quasiconvex and quasiconcave.\nThis means that, for all `r`,\nthe sets `{x \u2208 s | f x \u2264 r}` and `{x \u2208 s | r \u2264 f x}` are `\ud835\udd5c`-convex.", "p": "mathlib"}, {"name": "quasilinear_on_iff_mem_uIcc", "description": "", "p": "mathlib"}, {"name": "monotone.quasiconvex_on", "description": "", "p": "mathlib"}, {"name": "antitone_on.quasilinear_on", "description": "", "p": "mathlib"}, {"name": "quasilinear_on.monotone_on_or_antitone_on", "description": "", "p": "mathlib"}, {"name": "quasiconcave_on.inf", "description": "", "p": "mathlib"}, {"name": "quasiconvex_on.sup", "description": "", "p": "mathlib"}, {"name": "antitone_on.quasiconcave_on", "description": "", "p": "mathlib"}, {"name": "monotone_on.quasilinear_on", "description": "", "p": "mathlib"}, {"name": "convex_on.quasiconvex_on", "description": "", "p": "mathlib"}, {"name": "convex.quasiconcave_on_of_convex_ge", "description": "", "p": "mathlib"}, {"name": "quasilinear_on.dual", "description": "", "p": "mathlib"}, {"name": "quasiconvex_on", "description": " A function is quasiconvex if all its sublevels are convex.\nThis means that, for all `r`, `{x \u2208 s | f x \u2264 r}` is `\ud835\udd5c`-convex.", "p": "mathlib"}, {"name": "quasiconcave_on.convex_gt", "description": "", "p": "mathlib"}, {"name": "monotone_on.quasiconcave_on", "description": "", "p": "mathlib"}, {"name": "quasiconvex_on.dual", "description": "", "p": "mathlib"}, {"name": "convex.quasiconvex_on_of_convex_le", "description": "", "p": "mathlib"}, {"name": "monotone.quasiconcave_on", "description": "", "p": "mathlib"}, {"name": "quasiconvex_on.convex_lt", "description": "", "p": "mathlib"}, {"name": "quasilinear_on_iff_monotone_on_or_antitone_on", "description": "", "p": "mathlib"}, {"name": "quasiconcave_on_iff_min_le", "description": "", "p": "mathlib"}, {"name": "quasiconcave_on.convex", "description": "", "p": "mathlib"}, {"name": "concave_on.quasiconcave_on", "description": "", "p": "mathlib"}, {"name": "antitone.quasilinear_on", "description": "", "p": "mathlib"}, {"name": "antitone.quasiconcave_on", "description": "", "p": "mathlib"}, {"name": "quasiconvex_on.convex", "description": "", "p": "mathlib"}, {"name": "quasiconcave_on", "description": " A function is quasiconcave if all its superlevels are convex.\nThis means that, for all `r`, `{x \u2208 s | r \u2264 f x}` is `\ud835\udd5c`-convex.", "p": "mathlib"}, {"name": "quasiconvex_on_iff_le_max", "description": "", "p": "mathlib"}, {"name": "antitone_on.quasiconvex_on", "description": "", "p": "mathlib"}, {"name": "monotone_on.quasiconvex_on", "description": "", "p": "mathlib"}, {"name": "omega.update_zero", "description": "Assign a new value to the zeroth variable, and push all\n   other assignments up by 1", "p": "mathlib"}, {"name": "omega.revert_cond_all", "description": "Revert all exprs in the context that pass the given test", "p": "mathlib"}, {"name": "omega.pred_mono_2", "description": "", "p": "mathlib"}, {"name": "omega.update", "description": "Update variable assignment for a specific variable\n   and leave everything else unchanged", "p": "mathlib"}, {"name": "omega.update_eq_of_ne", "description": "", "p": "mathlib"}, {"name": "omega.app_first", "description": "Try applying a tactic to each of the element in a list\n   until success, and return the first successful result", "p": "mathlib"}, {"name": "omega.pred_mono_2'", "description": "", "p": "mathlib"}, {"name": "omega.revert_cond", "description": "Revert an expr if it passes the given test", "p": "mathlib"}, {"name": "omega.update_eq", "description": "", "p": "mathlib"}, {"name": "omega.fun_mono_2", "description": "", "p": "mathlib"}, {"name": "omega.intro_fresh", "description": "Intro with a fresh name", "p": "mathlib"}, {"name": "polynomial.derivative_bernoulli_add_one", "description": "", "p": "mathlib"}, {"name": "polynomial.bernoulli_generating_function", "description": "The theorem that $(e^X - 1) * \u2211 B\u2099(t)* X^n/n! = Xe^{tX}$", "p": "mathlib"}, {"name": "polynomial.bernoulli", "description": "The Bernoulli polynomials are defined in terms of the negative Bernoulli numbers.", "p": "mathlib"}, {"name": "polynomial.derivative_bernoulli", "description": "", "p": "mathlib"}, {"name": "polynomial.bernoulli_eval_one_add", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_bernoulli", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_range_pow_eq_bernoulli_sub", "description": "Another version of `bernoulli.sum_range_pow`.", "p": "mathlib"}, {"name": "polynomial.bernoulli_succ_eval", "description": "Rearrangement of `polynomial.sum_range_pow_eq_bernoulli_sub`.", "p": "mathlib"}, {"name": "polynomial.bernoulli_eq_sub_sum", "description": "Another version of `polynomial.sum_bernoulli`.", "p": "mathlib"}, {"name": "polynomial.bernoulli_eval_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.bernoulli_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.bernoulli_eval_one", "description": "", "p": "mathlib"}, {"name": "polynomial.bernoulli_def", "description": "", "p": "mathlib"}, {"name": "is_bounded_bilinear_map.fderiv_within", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.fderiv_of_bilinear", "description": "", "p": "mathlib"}, {"name": "is_bounded_bilinear_map.differentiable_on", "description": "", "p": "mathlib"}, {"name": "is_bounded_bilinear_map.fderiv", "description": "", "p": "mathlib"}, {"name": "is_bounded_bilinear_map.has_fderiv_at", "description": "", "p": "mathlib"}, {"name": "is_bounded_bilinear_map.differentiable_at", "description": "", "p": "mathlib"}, {"name": "is_bounded_bilinear_map.differentiable_within_at", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.fderiv_within_of_bilinear", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.has_fderiv_within_at_of_bilinear", "description": "", "p": "mathlib"}, {"name": "is_bounded_bilinear_map.has_strict_fderiv_at", "description": "", "p": "mathlib"}, {"name": "is_bounded_bilinear_map.has_fderiv_within_at", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.has_fderiv_at_of_bilinear", "description": "", "p": "mathlib"}, {"name": "is_bounded_bilinear_map.differentiable", "description": "", "p": "mathlib"}, {"name": "category_theory.locally_discrete.eq_of_hom", "description": "Extract the equation from a 2-morphism in a locally discrete 2-category.", "p": "mathlib"}, {"name": "category_theory.locally_discrete_bicategory.strict", "description": "A locally discrete bicategory is strict.", "p": "mathlib"}, {"name": "category_theory.locally_discrete.category_theory.category_struct", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.to_oplax_functor_map_id", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.to_oplax_functor_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.locally_discrete_bicategory", "description": "The locally discrete bicategory on a category is a bicategory in which the objects and the\n1-morphisms are the same as those in the underlying category, and the 2-morphisms are the\nequalities between 1-morphisms.", "p": "mathlib"}, {"name": "category_theory.functor.to_oplax_functor_map\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.to_oplax_functor", "description": "If `B` is a strict bicategory and `I` is a (1-)category, any functor (of 1-categories) `I \u2964 B` can\nbe promoted to an oplax functor from `locally_discrete I` to `B`.", "p": "mathlib"}, {"name": "category_theory.functor.to_oplax_functor_map_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.to_oplax_functor_map", "description": "", "p": "mathlib"}, {"name": "category_theory.locally_discrete", "description": "A type synonym for promoting any type to a category,\nwith the only morphisms being equalities.", "p": "mathlib"}, {"name": "category_theory.locally_discrete.hom_small_category", "description": "", "p": "mathlib"}, {"name": "category_theory.locally_discrete.inhabited", "description": "", "p": "mathlib"}, {"name": "finset.eventually_cofinite_nmem", "description": "", "p": "mathlib"}, {"name": "filter.cofinite_ne_bot", "description": "", "p": "mathlib"}, {"name": "set.finite.compl_mem_cofinite", "description": "", "p": "mathlib"}, {"name": "filter.has_basis_cofinite", "description": "", "p": "mathlib"}, {"name": "function.injective.tendsto_cofinite", "description": " For an injective function `f`, inverse images of finite sets are finite. See also\n`filter.comap_cofinite_le` and `function.injective.comap_cofinite_eq`.", "p": "mathlib"}, {"name": "filter.tendsto.exists_within_forall_ge", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.exists_forall_le", "description": "", "p": "mathlib"}, {"name": "set.finite.eventually_cofinite_nmem", "description": "", "p": "mathlib"}, {"name": "nat.frequently_at_top_iff_infinite", "description": "", "p": "mathlib"}, {"name": "filter.eventually_cofinite", "description": "", "p": "mathlib"}, {"name": "filter.le_cofinite_iff_eventually_ne", "description": "", "p": "mathlib"}, {"name": "filter.mem_cofinite", "description": "", "p": "mathlib"}, {"name": "set.infinite_iff_frequently_cofinite", "description": "", "p": "mathlib"}, {"name": "nat.cofinite_eq_at_top", "description": "For natural numbers the filters `cofinite` and `at_top` coincide.", "p": "mathlib"}, {"name": "filter.comap_cofinite_le", "description": "", "p": "mathlib"}, {"name": "filter.frequently_cofinite_iff_infinite", "description": "", "p": "mathlib"}, {"name": "filter.disjoint_cofinite_right", "description": "", "p": "mathlib"}, {"name": "filter.coprod_cofinite", "description": "The coproduct of the cofinite filters on two types is the cofinite filter on their product.", "p": "mathlib"}, {"name": "filter.cofinite", "description": "The cofinite filter is the filter of subsets whose complements are finite.", "p": "mathlib"}, {"name": "filter.disjoint_cofinite_left", "description": "", "p": "mathlib"}, {"name": "filter.le_cofinite_iff_compl_singleton_mem", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.exists_within_forall_le", "description": "", "p": "mathlib"}, {"name": "function.injective.nat_tendsto_at_top", "description": "An injective sequence `f : \u2115 \u2192 \u2115` tends to infinity at infinity.", "p": "mathlib"}, {"name": "filter.eventually_cofinite_ne", "description": "", "p": "mathlib"}, {"name": "filter.at_top_le_cofinite", "description": "If `\u03b1` is a preorder with no maximal element, then `at_top \u2264 cofinite`.", "p": "mathlib"}, {"name": "function.injective.comap_cofinite_eq", "description": " The pullback of the `filter.cofinite` under an injective function is equal to `filter.cofinite`.\nSee also `filter.comap_cofinite_le` and `function.injective.tendsto_cofinite`.", "p": "mathlib"}, {"name": "filter.Coprod_cofinite", "description": "Finite product of finite sets is finite", "p": "mathlib"}, {"name": "filter.tendsto.exists_forall_ge", "description": "", "p": "mathlib"}, {"name": "Profinite.as_limit_cone_iso", "description": "The isomorphism of cones `X.as_limit_cone` and `Profinite.limit_cone X.diagram`.\nThe underlying isomorphism is defeq to `X.iso_as_limit_cone_lift`.", "p": "mathlib"}, {"name": "Profinite.is_iso_as_limit_cone_lift", "description": "", "p": "mathlib"}, {"name": "Profinite.diagram", "description": "An abbreviation for `X.fintype_diagram \u22d9 Fintype_to_Profinite`.", "p": "mathlib"}, {"name": "Profinite.iso_as_limit_cone_lift", "description": "The isomorphism between `X` and the explicit limit of `X.diagram`,\ninduced by lifting `X.as_limit_cone`.", "p": "mathlib"}, {"name": "Profinite.as_limit", "description": "`X.as_limit_cone` is indeed a limit cone.", "p": "mathlib"}, {"name": "Profinite.as_limit_cone", "description": "A cone over `X.diagram` whose cone point is `X`.", "p": "mathlib"}, {"name": "Profinite.fintype_diagram", "description": "The functor `discrete_quotient X \u2964 Fintype` whose limit is isomorphic to `X`.", "p": "mathlib"}, {"name": "Profinite.lim", "description": "A bundled version of `X.as_limit_cone` and `X.as_limit`.", "p": "mathlib"}, {"name": "part.fix.approx", "description": " A series of successive, finite approximation of the fixed point of `f`, defined by\n`approx f n = f^[n] \u22a5`. The limit of this chain is the fixed point of `f`.", "p": "mathlib"}, {"name": "has_fix", "description": " `has_fix \u03b1` gives us a way to calculate the fixed point\nof function of type `\u03b1 \u2192 \u03b1`.", "p": "mathlib"}, {"name": "has_fix.fix", "description": " `has_fix \u03b1` gives us a way to calculate the fixed point\nof function of type `\u03b1 \u2192 \u03b1`.", "p": "mathlib"}, {"name": "pi.part.has_fix", "description": "", "p": "mathlib"}, {"name": "part.fix_aux", "description": "loop body for finding the fixed point of `f`", "p": "mathlib"}, {"name": "part.fix_def'", "description": "", "p": "mathlib"}, {"name": "part.has_fix", "description": "", "p": "mathlib"}, {"name": "part.fix_def", "description": "", "p": "mathlib"}, {"name": "part.fix", "description": " The least fixed point of `f`.\n\nIf `f` is a continuous function (according to complete partial orders),\nit satisfies the equations:\n\n  1. `fix f = f (fix f)`          (is a fixed point)\n  2. `\u2200 X, f X \u2264 X \u2192 fix f \u2264 X`   (least fixed point)", "p": "mathlib"}, {"name": "has_fderiv_at_boundary_of_tendsto_fderiv", "description": " If a function `f` is differentiable in a convex open set and continuous on its closure, and its\nderivative converges to a limit `f'` at a point on the boundary, then `f` is differentiable there\nwith derivative `f'`.", "p": "mathlib"}, {"name": "has_deriv_at_interval_right_endpoint_of_tendsto_deriv", "description": " If a function is differentiable on the left of a point `a : \u211d`, continuous at `a`, and\nits derivative also converges at `a`, then `f` is differentiable on the left at `a`.", "p": "mathlib"}, {"name": "has_deriv_at_of_has_deriv_at_of_ne'", "description": " If a real function `f` has a derivative `g` everywhere but at a point, and `f` and `g` are\ncontinuous at this point, then `g` is the derivative of `f` everywhere.", "p": "mathlib"}, {"name": "has_deriv_at_interval_left_endpoint_of_tendsto_deriv", "description": " If a function is differentiable on the right of a point `a : \u211d`, continuous at `a`, and\nits derivative also converges at `a`, then `f` is differentiable on the right at `a`.", "p": "mathlib"}, {"name": "has_deriv_at_of_has_deriv_at_of_ne", "description": " If a real function `f` has a derivative `g` everywhere but at a point, and `f` and `g` are\ncontinuous at this point, then `g` is also the derivative of `f` at this point.", "p": "mathlib"}, {"name": "ring.closure_subset_iff", "description": "", "p": "mathlib"}, {"name": "ring.closure", "description": " The smallest subring containing a given subset of a ring, considered as a set. This function\nis deprecated; use `subring.closure`.", "p": "mathlib"}, {"name": "ring_hom.is_subring_preimage", "description": "", "p": "mathlib"}, {"name": "ring.exists_list_of_mem_closure", "description": "", "p": "mathlib"}, {"name": "ring.image_closure", "description": "", "p": "mathlib"}, {"name": "is_subring.Inter", "description": "", "p": "mathlib"}, {"name": "is_subring_Union_of_directed", "description": "", "p": "mathlib"}, {"name": "ring.subset_closure", "description": "", "p": "mathlib"}, {"name": "is_subring.inter", "description": "", "p": "mathlib"}, {"name": "ring_hom.is_subring_set_range", "description": "", "p": "mathlib"}, {"name": "ring.closure_mono", "description": "", "p": "mathlib"}, {"name": "ring.in_closure.rec_on", "description": "", "p": "mathlib"}, {"name": "is_subring", "description": " `S` is a subring: a set containing 1 and closed under multiplication, addition and additive\ninverse.", "p": "mathlib"}, {"name": "is_subring.to_is_add_subgroup", "description": " `S` is a subring: a set containing 1 and closed under multiplication, addition and additive\ninverse.", "p": "mathlib"}, {"name": "is_subring.to_is_submonoid", "description": " `S` is a subring: a set containing 1 and closed under multiplication, addition and additive\ninverse.", "p": "mathlib"}, {"name": "ring.mem_closure", "description": "", "p": "mathlib"}, {"name": "ring.closure_subset", "description": "", "p": "mathlib"}, {"name": "ring.closure.is_subring", "description": "", "p": "mathlib"}, {"name": "ring_hom.is_subring_image", "description": "", "p": "mathlib"}, {"name": "is_subring.subring", "description": "Construct a `subring` from a set satisfying `is_subring`.", "p": "mathlib"}, {"name": "ideal.finprod_count", "description": "The multiplicity of `v` in `\u220f_v v^(val_v(I))` equals `val_v(I)`.", "p": "mathlib"}, {"name": "ideal.finite_mul_support_coe", "description": " For every nonzero ideal `I` of `v`, there are finitely many maximal ideals `v` such that\n`v^(val_v(I))`, regarded as a fractional ideal, is not `(1)`.", "p": "mathlib"}, {"name": "ideal.finprod_height_one_spectrum_factorization_coe", "description": " The ideal `I` equals the finprod `\u220f_v v^(val_v(I))`, when both sides are regarded as fractional\nideals of `R`.", "p": "mathlib"}, {"name": "associates.finite_factors", "description": "For every nonzero ideal `I` of `v`, there are finitely many maximal ideals `v` such that the\n multiplicity of `v` in the factorization of `I`, denoted `val_v(I)`, is nonzero.", "p": "mathlib"}, {"name": "associates.finprod_ne_zero", "description": "", "p": "mathlib"}, {"name": "ideal.finprod_not_dvd", "description": "For every nonzero ideal `I` of `v`, `v^(val_v(I) + 1)` does not divide `\u220f_v v^(val_v(I))`.", "p": "mathlib"}, {"name": "ideal.finprod_height_one_spectrum_factorization", "description": "The ideal `I` equals the finprod `\u220f_v v^(val_v(I))`.", "p": "mathlib"}, {"name": "ideal.finite_mul_support_inv", "description": " For every nonzero ideal `I` of `v`, there are finitely many maximal ideals `v` such that\n`v^-(val_v(I))` is not the unit ideal.", "p": "mathlib"}, {"name": "is_dedekind_domain.height_one_spectrum.max_pow_dividing", "description": "Given a maximal ideal `v` and an ideal `I` of `R`, `max_pow_dividing` returns the maximal\n power of `v` dividing `I`.", "p": "mathlib"}, {"name": "ideal.finite_factors", "description": "Only finitely many maximal ideals of `R` divide a given nonzero ideal.", "p": "mathlib"}, {"name": "ideal.finite_mul_support", "description": "For every nonzero ideal `I` of `v`, there are finitely many maximal ideals `v` such that\n `v^(val_v(I))` is not the unit ideal.", "p": "mathlib"}, {"name": "bit1_eq_one", "description": "", "p": "mathlib"}, {"name": "sub_half", "description": "", "p": "mathlib"}, {"name": "ring_hom.injective_nat", "description": "", "p": "mathlib"}, {"name": "zero_eq_bit0", "description": "", "p": "mathlib"}, {"name": "neg_eq_self_iff", "description": "", "p": "mathlib"}, {"name": "zero_ne_bit0", "description": "", "p": "mathlib"}, {"name": "with_top.char_zero", "description": "", "p": "mathlib"}, {"name": "bit1_injective", "description": "", "p": "mathlib"}, {"name": "half_sub", "description": "", "p": "mathlib"}, {"name": "bit0_eq_bit0", "description": "", "p": "mathlib"}, {"name": "nat.cast_pow_eq_one", "description": "", "p": "mathlib"}, {"name": "nat.cast_div_char_zero", "description": "", "p": "mathlib"}, {"name": "nat.cast_embedding_apply", "description": "", "p": "mathlib"}, {"name": "nat.cast_embedding", "description": "`nat.cast` as an embedding into monoids of characteristic `0`.", "p": "mathlib"}, {"name": "bit1_eq_bit1", "description": "", "p": "mathlib"}, {"name": "half_add_self", "description": "", "p": "mathlib"}, {"name": "ring_hom.char_zero_iff", "description": "", "p": "mathlib"}, {"name": "ring_hom.char_zero", "description": "", "p": "mathlib"}, {"name": "bit0_eq_zero", "description": "", "p": "mathlib"}, {"name": "nat_mul_inj", "description": "", "p": "mathlib"}, {"name": "add_halves'", "description": "", "p": "mathlib"}, {"name": "add_self_eq_zero", "description": "", "p": "mathlib"}, {"name": "nat_mul_inj'", "description": "", "p": "mathlib"}, {"name": "bit0_injective", "description": "", "p": "mathlib"}, {"name": "eq_neg_self_iff", "description": "", "p": "mathlib"}, {"name": "bit0_ne_zero", "description": "", "p": "mathlib"}, {"name": "char_zero.ne_zero.two", "description": "", "p": "mathlib"}, {"name": "one_eq_bit1", "description": "", "p": "mathlib"}, {"name": "graded_ring.proj_zero_ring_hom_apply", "description": "", "p": "mathlib"}, {"name": "graded_algebra.proj_apply", "description": "", "p": "mathlib"}, {"name": "direct_sum.decompose_alg_equiv_apply", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_decompose_mul_of_right_mem_of_le", "description": "", "p": "mathlib"}, {"name": "graded_algebra", "description": " A special case of `graded_ring` with `\u03c3 = submodule R A`. This is useful both because it\ncan avoid typeclass search, and because it provides a more concise name.", "p": "mathlib"}, {"name": "graded_ring.proj_apply", "description": "", "p": "mathlib"}, {"name": "graded_algebra.of_alg_hom", "description": " A helper to construct a `graded_algebra` when the `set_like.graded_monoid` structure is already\navailable. This makes the `left_inv` condition easier to prove, and phrases the `right_inv`\ncondition in a way that allows custom `@[ext]` lemmas to apply.\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "graded_algebra.proj", "description": "The projection maps of graded algebra", "p": "mathlib"}, {"name": "direct_sum.decompose_symm_mul", "description": "", "p": "mathlib"}, {"name": "graded_ring", "description": " An internally-graded `R`-algebra `A` is one that can be decomposed into a collection\nof `submodule R A`s indexed by `\u03b9` such that the canonical map `A \u2192 \u2a01 i, \ud835\udc9c i` is bijective and\nrespects multiplication, i.e. the product of an element of degree `i` and an element of degree `j`\nis an element of degree `i + j`.\n\nNote that the fact that `A` is internally-graded, `graded_algebra \ud835\udc9c`, implies an externally-graded\nalgebra structure `direct_sum.galgebra R (\u03bb i, \u21a5(\ud835\udc9c i))`, which in turn makes available an\n`algebra R (\u2a01 i, \ud835\udc9c i)` instance.", "p": "mathlib"}, {"name": "graded_ring.to_graded_monoid", "description": " An internally-graded `R`-algebra `A` is one that can be decomposed into a collection\nof `submodule R A`s indexed by `\u03b9` such that the canonical map `A \u2192 \u2a01 i, \ud835\udc9c i` is bijective and\nrespects multiplication, i.e. the product of an element of degree `i` and an element of degree `j`\nis an element of degree `i + j`.\n\nNote that the fact that `A` is internally-graded, `graded_algebra \ud835\udc9c`, implies an externally-graded\nalgebra structure `direct_sum.galgebra R (\u03bb i, \u21a5(\ud835\udc9c i))`, which in turn makes available an\n`algebra R (\u2a01 i, \ud835\udc9c i)` instance.", "p": "mathlib"}, {"name": "graded_ring.to_decomposition", "description": " An internally-graded `R`-algebra `A` is one that can be decomposed into a collection\nof `submodule R A`s indexed by `\u03b9` such that the canonical map `A \u2192 \u2a01 i, \ud835\udc9c i` is bijective and\nrespects multiplication, i.e. the product of an element of degree `i` and an element of degree `j`\nis an element of degree `i + j`.\n\nNote that the fact that `A` is internally-graded, `graded_algebra \ud835\udc9c`, implies an externally-graded\nalgebra structure `direct_sum.galgebra R (\u03bb i, \u21a5(\ud835\udc9c i))`, which in turn makes available an\n`algebra R (\u2a01 i, \ud835\udc9c i)` instance.", "p": "mathlib"}, {"name": "direct_sum.coe_decompose_mul_of_right_mem", "description": "", "p": "mathlib"}, {"name": "direct_sum.decompose_alg_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "graded_algebra.mem_support_iff", "description": "", "p": "mathlib"}, {"name": "graded_ring.proj", "description": "The projection maps of a graded ring", "p": "mathlib"}, {"name": "direct_sum.decompose_one", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_decompose_mul_add_of_left_mem", "description": "", "p": "mathlib"}, {"name": "direct_sum.decompose_mul_add_left", "description": "", "p": "mathlib"}, {"name": "direct_sum.decompose_alg_equiv", "description": " If `A` is graded by `\u03b9` with degree `i` component `\ud835\udc9c i`, then it is isomorphic as\nan algebra to a direct sum of components.", "p": "mathlib"}, {"name": "graded_algebra.proj_recompose", "description": "", "p": "mathlib"}, {"name": "direct_sum.decompose_mul_add_right", "description": "", "p": "mathlib"}, {"name": "graded_ring.mem_support_iff", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_decompose_mul_of_left_mem", "description": "", "p": "mathlib"}, {"name": "direct_sum.decompose_mul", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_decompose_mul_of_right_mem_of_not_le", "description": "", "p": "mathlib"}, {"name": "graded_ring.proj_zero_ring_hom", "description": "If `A` is graded by a canonically ordered add monoid, then the projection map `x \u21a6 x\u2080` is a ring\nhomomorphism.", "p": "mathlib"}, {"name": "direct_sum.decompose_symm_one", "description": "", "p": "mathlib"}, {"name": "direct_sum.decompose_ring_equiv", "description": " If `A` is graded by `\u03b9` with degree `i` component `\ud835\udc9c i`, then it is isomorphic as\na ring to a direct sum of components.", "p": "mathlib"}, {"name": "direct_sum.coe_decompose_mul_of_left_mem_of_le", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_decompose_mul_of_left_mem_of_not_le", "description": "", "p": "mathlib"}, {"name": "graded_ring.proj_recompose", "description": "", "p": "mathlib"}, {"name": "direct_sum.coe_decompose_mul_add_of_right_mem", "description": "", "p": "mathlib"}, {"name": "polynomial.op_ring_equiv_symm_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.op_ring_equiv_op_C_mul_X_pow", "description": "", "p": "mathlib"}, {"name": "polynomial.op_ring_equiv_op_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.op_ring_equiv", "description": " Ring isomorphism between `R[X]\u1d50\u1d52\u1d56` and `R\u1d50\u1d52\u1d56[X]` sending each coefficient of a polynomial\nto the corresponding element of the opposite ring.", "p": "mathlib"}, {"name": "polynomial.op_ring_equiv_symm_C_mul_X_pow", "description": "", "p": "mathlib"}, {"name": "polynomial.op_ring_equiv_symm_X", "description": "", "p": "mathlib"}, {"name": "polynomial.op_ring_equiv_symm_C", "description": "", "p": "mathlib"}, {"name": "polynomial.support_op_ring_equiv", "description": "", "p": "mathlib"}, {"name": "polynomial.op_ring_equiv_op_C", "description": "", "p": "mathlib"}, {"name": "polynomial.leading_coeff_op_ring_equiv", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff_op_ring_equiv", "description": "", "p": "mathlib"}, {"name": "polynomial.op_ring_equiv_op_X", "description": "", "p": "mathlib"}, {"name": "polynomial.nat_degree_op_ring_equiv", "description": "", "p": "mathlib"}, {"name": "tactic.group.zpow_trick_one", "description": "", "p": "mathlib"}, {"name": "tactic.aux_group\u2081", "description": "Auxiliary tactic for the `group` tactic. Calls the simplifier only.", "p": "mathlib"}, {"name": "tactic.group.zsmul_trick_sub", "description": "", "p": "mathlib"}, {"name": "tactic.group.zpow_trick_one'", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.group", "description": "Tactic for normalizing expressions in multiplicative groups, without assuming\ncommutativity, using only the group axioms without any information about which group\nis manipulated.\n\n(For additive commutative groups, use the `abel` tactic instead.)\n\nExample:\n```lean\nexample {G : Type} [group G] (a b c d : G) (h : c = (a*b^2)*((b*b)\u207b\u00b9*a\u207b\u00b9)*d) : a*c*d\u207b\u00b9 = a :=\nbegin\n  group at h, -- normalizes `h` which becomes `h : c = d`\n  rw h,       -- the goal is now `a*d*d\u207b\u00b9 = a`\n  group,      -- which then normalized and closed\nend\n```", "p": "mathlib"}, {"name": "tactic.group.zpow_trick_sub", "description": "", "p": "mathlib"}, {"name": "tactic.aux_group\u2082", "description": "Auxiliary tactic for the `group` tactic. Calls `ring_nf` to normalize exponents.", "p": "mathlib"}, {"name": "tactic_doc.tactic.group", "description": "Tactic for normalizing expressions in multiplicative groups, without assuming\ncommutativity, using only the group axioms without any information about which group\nis manipulated.\n\n(For additive commutative groups, use the `abel` tactic instead.)\n\nExample:\n```lean\nexample {G : Type} [group G] (a b c d : G) (h : c = (a*b^2)*((b*b)\u207b\u00b9*a\u207b\u00b9)*d) : a*c*d\u207b\u00b9 = a :=\nbegin\n  group at h, -- normalizes `h` which becomes `h : c = d`\n  rw h,       -- the goal is now `a*d*d\u207b\u00b9 = a`\n  group,      -- which then normalized and closed\nend\n```", "p": "mathlib"}, {"name": "tactic.group.zsmul_trick", "description": "", "p": "mathlib"}, {"name": "tactic.group.zsmul_trick_zero", "description": "", "p": "mathlib"}, {"name": "tactic.group.zsmul_trick_zero'", "description": "", "p": "mathlib"}, {"name": "tactic.group.zpow_trick", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.functor_category_symmetric", "description": "When `C` is any category, and `D` is a symmetric monoidal category,\nthe natural pointwise monoidal structure on the functor category `C \u2964 D`\nis also symmetric.", "p": "mathlib"}, {"name": "category_theory.monoidal.functor_category.tensor_obj_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.functor_category_braided", "description": "When `C` is any category, and `D` is a braided monoidal category,\nthe natural pointwise monoidal structure on the functor category `C \u2964 D`\nis also braided.", "p": "mathlib"}, {"name": "category_theory.monoidal.functor_category.tensor_obj", "description": "(An auxiliary definition for `functor_category_monoidal`.)\nTensor product of functors `C \u2964 D`, when `D` is monoidal.", "p": "mathlib"}, {"name": "category_theory.monoidal.associator_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.functor_category_monoidal", "description": "When `C` is any category, and `D` is a monoidal category,\nthe functor category `C \u2964 D` has a natural pointwise monoidal structure,\nwhere `(F \u2297 G).obj X = F.obj X \u2297 G.obj X`.", "p": "mathlib"}, {"name": "category_theory.monoidal.tensor_unit_map", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.functor_category.tensor_obj_map", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.tensor_obj_map", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.tensor_obj_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.tensor_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.functor_category.tensor_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.right_unitor_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.left_unitor_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.left_unitor_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.tensor_unit_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.associator_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.monoidal.functor_category.tensor_hom", "description": "(An auxiliary definition for `functor_category_monoidal`.)\nTensor product of natural transformations into `D`, when `D` is monoidal.", "p": "mathlib"}, {"name": "category_theory.monoidal.right_unitor_hom_app", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.int_gcd_helper_neg_left", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.int_gcd_helper_neg_right", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.nat_gcd_helper_2", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_div", "description": "", "p": "mathlib"}, {"name": "int.gcd_assoc", "description": "", "p": "mathlib"}, {"name": "int.gcd_b", "description": "The extended GCD `b` value in the equation `gcd x y = x * a + y * b`.", "p": "mathlib"}, {"name": "nat.gcd_eq_gcd_ab", "description": " **B\u00e9zout's lemma**: given `x y : \u2115`, `gcd x y = x * a + y * b`, where `a = gcd_a x y` and\n`b = gcd_b x y` are computed by the extended Euclidean algorithm.", "p": "mathlib"}, {"name": "int.gcd_div", "description": "", "p": "mathlib"}, {"name": "nat.xgcd_aux", "description": "Helper function for the extended GCD algorithm (`nat.xgcd`).", "p": "mathlib"}, {"name": "int.gcd_mul_left", "description": "", "p": "mathlib"}, {"name": "int.exists_gcd_one'", "description": "", "p": "mathlib"}, {"name": "int.lcm_one_left", "description": "", "p": "mathlib"}, {"name": "int.gcd_pos_of_ne_zero_right", "description": "", "p": "mathlib"}, {"name": "int.gcd_mul_right", "description": "", "p": "mathlib"}, {"name": "int.gcd_pos_of_ne_zero_left", "description": "", "p": "mathlib"}, {"name": "int.gcd_div_gcd_div_gcd", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.nat_gcd_helper_1", "description": "", "p": "mathlib"}, {"name": "int.lcm_zero_left", "description": "", "p": "mathlib"}, {"name": "int.gcd_eq_gcd_ab", "description": "**B\u00e9zout's lemma**", "p": "mathlib"}, {"name": "tactic.norm_num.prove_lcm_nat", "description": "Evaluates the `nat.lcm` function.", "p": "mathlib"}, {"name": "tactic.norm_num.prove_coprime_nat", "description": "Evaluates the `nat.coprime` function.", "p": "mathlib"}, {"name": "nat.gcd_b_zero_left", "description": "", "p": "mathlib"}, {"name": "int.gcd_neg_left", "description": "", "p": "mathlib"}, {"name": "int.pow_dvd_pow_iff", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.nat_coprime_helper_1", "description": "", "p": "mathlib"}, {"name": "int.dvd_of_dvd_mul_right_of_gcd_one", "description": " Euclid's lemma: if `a \u2223 b * c` and `gcd a b = 1` then `a \u2223 c`.\nCompare with `is_coprime.dvd_of_dvd_mul_right` and\n`unique_factorization_monoid.dvd_of_dvd_mul_right_of_no_prime_factors`", "p": "mathlib"}, {"name": "int.gcd_comm", "description": "", "p": "mathlib"}, {"name": "int.gcd_one_left", "description": "", "p": "mathlib"}, {"name": "nat.xgcd_aux_rec", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.eval_gcd", "description": "Evaluates the `gcd`, `lcm`, and `coprime` functions.", "p": "mathlib"}, {"name": "int.gcd_dvd_gcd_mul_right_right", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.int_lcm_helper_neg_right", "description": "", "p": "mathlib"}, {"name": "int.gcd_zero_left", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.prove_gcd_int", "description": "Evaluates the `int.gcd` function.", "p": "mathlib"}, {"name": "int.dvd_of_mul_dvd_mul_right", "description": "", "p": "mathlib"}, {"name": "int.gcd_zero_right", "description": "", "p": "mathlib"}, {"name": "int.gcd_least_linear", "description": " For nonzero integers `a` and `b`, `gcd a b` is the smallest positive natural number that can be\nwritten in the form `a * x + b * y` for some pair of integers `x` and `y`", "p": "mathlib"}, {"name": "tactic.norm_num.int_lcm_helper_neg_left", "description": "", "p": "mathlib"}, {"name": "nat.gcd_b_zero_right", "description": "", "p": "mathlib"}, {"name": "nat.xgcd", "description": "Use the extended GCD algorithm to generate the `a` and `b` values\n satisfying `gcd x y = x * a + y * b`.", "p": "mathlib"}, {"name": "nat.xgcd_zero_left", "description": "", "p": "mathlib"}, {"name": "int.ne_zero_of_gcd", "description": "", "p": "mathlib"}, {"name": "int.gcd_dvd_gcd_of_dvd_right", "description": "", "p": "mathlib"}, {"name": "nat.gcd_a_zero_left", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.nat_lcm_helper", "description": "", "p": "mathlib"}, {"name": "int.gcd_dvd_left", "description": "", "p": "mathlib"}, {"name": "int.coe_nat_gcd", "description": "", "p": "mathlib"}, {"name": "nat.xgcd_aux_P", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.int_gcd_helper'", "description": "", "p": "mathlib"}, {"name": "int.gcd_one_right", "description": "", "p": "mathlib"}, {"name": "int.dvd_lcm_right", "description": "", "p": "mathlib"}, {"name": "int.lcm_assoc", "description": "", "p": "mathlib"}, {"name": "int.dvd_gcd", "description": "", "p": "mathlib"}, {"name": "nat.exists_mul_mod_eq_one_of_coprime", "description": "", "p": "mathlib"}, {"name": "int.lcm", "description": "\u2124 specific version of least common multiple.", "p": "mathlib"}, {"name": "tactic.norm_num.nat_gcd_helper_dvd_left", "description": "", "p": "mathlib"}, {"name": "int.gcd_dvd_gcd_of_dvd_left", "description": "", "p": "mathlib"}, {"name": "int.gcd_dvd_gcd_mul_left_right", "description": "", "p": "mathlib"}, {"name": "int.dvd_of_dvd_mul_left_of_gcd_one", "description": " Euclid's lemma: if `a \u2223 b * c` and `gcd a c = 1` then `a \u2223 b`.\nCompare with `is_coprime.dvd_of_dvd_mul_left` and\n`unique_factorization_monoid.dvd_of_dvd_mul_left_of_no_prime_factors`", "p": "mathlib"}, {"name": "int.gcd_eq_left", "description": "", "p": "mathlib"}, {"name": "int.coe_nat_lcm", "description": "", "p": "mathlib"}, {"name": "nat.xgcd_aux_fst", "description": "", "p": "mathlib"}, {"name": "int.gcd_a", "description": "The extended GCD `a` value in the equation `gcd x y = x * a + y * b`.", "p": "mathlib"}, {"name": "tactic.norm_num.nat_not_coprime_helper", "description": "", "p": "mathlib"}, {"name": "int.lcm_one_right", "description": "", "p": "mathlib"}, {"name": "nat.gcd_a", "description": "The extended GCD `a` value in the equation `gcd x y = x * a + y * b`.", "p": "mathlib"}, {"name": "nat.gcd_b", "description": "The extended GCD `b` value in the equation `gcd x y = x * a + y * b`.", "p": "mathlib"}, {"name": "int.gcd_self", "description": "", "p": "mathlib"}, {"name": "int.lcm_dvd", "description": "", "p": "mathlib"}, {"name": "int.dvd_lcm_left", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.prove_lcm_int", "description": "Evaluates the `int.lcm` function.", "p": "mathlib"}, {"name": "int.gcd_neg_right", "description": "", "p": "mathlib"}, {"name": "int.gcd_eq_right", "description": "", "p": "mathlib"}, {"name": "int.gcd_greatest", "description": "", "p": "mathlib"}, {"name": "int.gcd_dvd_gcd_mul_right", "description": "", "p": "mathlib"}, {"name": "int.lcm_self", "description": "", "p": "mathlib"}, {"name": "gcd_nsmul_eq_zero", "description": "", "p": "mathlib"}, {"name": "int.exists_gcd_one", "description": "", "p": "mathlib"}, {"name": "pow_gcd_eq_one", "description": "", "p": "mathlib"}, {"name": "int.gcd_dvd_right", "description": "", "p": "mathlib"}, {"name": "int.gcd_dvd_gcd_mul_left", "description": "", "p": "mathlib"}, {"name": "int.lcm_zero_right", "description": "", "p": "mathlib"}, {"name": "nat.xgcd_aux_val", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.nat_coprime_helper_zero_right", "description": "", "p": "mathlib"}, {"name": "int.gcd_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "int.gcd_mul_lcm", "description": "", "p": "mathlib"}, {"name": "int.dvd_of_mul_dvd_mul_left", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.nat_gcd_helper_dvd_right", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.nat_coprime_helper_zero_left", "description": "", "p": "mathlib"}, {"name": "int.lcm_comm", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.nat_coprime_helper_2", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.int_lcm_helper", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.int_gcd_helper", "description": "", "p": "mathlib"}, {"name": "tactic.norm_num.prove_gcd_nat", "description": "Evaluates the `nat.gcd` function.", "p": "mathlib"}, {"name": "nat.gcd_a_zero_right", "description": "", "p": "mathlib"}, {"name": "int.lcm_def", "description": "", "p": "mathlib"}, {"name": "int.gcd_pos_iff", "description": "", "p": "mathlib"}, {"name": "nat.exists_mul_mod_eq_gcd", "description": "", "p": "mathlib"}, {"name": "nat.xgcd_val", "description": "", "p": "mathlib"}, {"name": "int.gcd_dvd_iff", "description": "", "p": "mathlib"}, {"name": "lie_algebra.matrix_trace_commutator_zero", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.type_D", "description": " The classical Lie algebra of type D as a Lie subalgebra of matrices associated to the matrix\n`JD`.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.JD", "description": " A matrix defining a canonical even-rank symmetric bilinear form.\n\nIt looks like this as a `2l x 2l` matrix of `l x l` blocks:\n\n   [ 0 1 ]\n   [ 1 0 ]", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.indefinite_diagonal", "description": "The indefinite diagonal matrix with `p` 1s and `q` -1s.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.so_indefinite_equiv", "description": " An equivalence between the indefinite and definite orthogonal Lie algebras, over a ring\ncontaining a square root of -1.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.type_B_equiv_so'", "description": "An equivalence between two possible definitions of the classical Lie algebra of type B.", "p": "mathlib"}, {"name": "lie_algebra.special_linear.Eb_val", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.JB_transform", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.PB", "description": " A matrix transforming the bilinear form defined by the matrix `JB` into an\nalmost-split-signature diagonal matrix.\n\nIt looks like this as a `(2l+1) x (2l+1)` matrix of blocks:\n\n   [ 1 0  0 ]\n   [ 0 1 -1 ]\n   [ 0 1  1 ]\n\nwhere sizes of the blocks are:\n\n   [`1 x 1` `1 x l` `1 x l`]\n   [`l x 1` `l x l` `l x l`]\n   [`l x 1` `l x l` `l x l`]", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.invertible_PB", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.Pso_inv", "description": "", "p": "mathlib"}, {"name": "lie_algebra.special_linear.sl_bracket", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.PD_inv", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.so_indefinite_equiv_apply", "description": "", "p": "mathlib"}, {"name": "lie_algebra.symplectic.sp", "description": " The symplectic Lie algebra: skew-adjoint matrices with respect to the canonical skew-symmetric\nbilinear form.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.invertible_Pso", "description": "There is a constructive inverse of `Pso p q R i`.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.S_as_blocks", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.so'", "description": " The indefinite orthogonal Lie subalgebra: skew-adjoint matrices with respect to the symmetric\nbilinear form defined by the indefinite diagonal matrix.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.mem_so", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.invertible_PD", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.Pso", "description": " A matrix for transforming the indefinite diagonal bilinear form into the definite one, provided\nthe parameter `i` is a square root of -1.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.PB_inv", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.so", "description": " The definite orthogonal Lie subalgebra: skew-adjoint matrices with respect to the symmetric\nbilinear form defined by the identity matrix.", "p": "mathlib"}, {"name": "lie_algebra.special_linear.Eb", "description": " When j \u2260 i, the elementary matrices are elements of sl n R, in fact they are part of a natural\nbasis of sl n R.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.indefinite_diagonal_assoc", "description": "", "p": "mathlib"}, {"name": "lie_algebra.special_linear.sl_non_abelian", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.type_B", "description": " The classical Lie algebra of type B as a Lie subalgebra of matrices associated to the matrix\n`JB`.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.JD_transform", "description": "", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.S", "description": "The split-signature diagonal matrix.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.type_D_equiv_so'", "description": "An equivalence between two possible definitions of the classical Lie algebra of type D.", "p": "mathlib"}, {"name": "lie_algebra.special_linear.sl", "description": "The special linear Lie algebra: square matrices of trace zero.", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.PD", "description": " A matrix transforming the bilinear form defined by the matrix `JD` into a split-signature\ndiagonal matrix.\n\nIt looks like this as a `2l x 2l` matrix of `l x l` blocks:\n\n   [ 1 -1 ]\n   [ 1  1 ]", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.JB", "description": " A matrix defining a canonical odd-rank symmetric bilinear form.\n\nIt looks like this as a `(2l+1) x (2l+1)` matrix of blocks:\n\n   [ 2 0 0 ]\n   [ 0 0 1 ]\n   [ 0 1 0 ]\n\nwhere sizes of the blocks are:\n\n   [`1 x 1` `1 x l` `1 x l`]\n   [`l x 1` `l x l` `l x l`]\n   [`l x 1` `l x l` `l x l`]", "p": "mathlib"}, {"name": "lie_algebra.orthogonal.indefinite_diagonal_transform", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.inclusion_path_aux", "description": "Auxiliary definition for `inclusion_path`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.normalize_aux_nil_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.preinclusion_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.preinclusion_map\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.free_bicategory.preinclusion", "description": "The inclusion from the locally discrete bicategory on the path category into the free bicategory\nas a prelax functor. This will be promoted to a pseudofunctor after proving the coherence theorem.\nSee `inclusion`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.locally_thin", "description": "The coherence theorem for bicategories.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.inclusion_path", "description": "The discrete category on the paths includes into the category of 1-morphisms in the free\nbicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.inclusion_map_comp_aux", "description": "Auxiliary definition for `inclusion`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.inclusion", "description": "The inclusion pseudofunctor from the locally discrete bicategory on the path category into the\nfree bicategory.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.normalize_iso", "description": "A 2-isomorphism between a partially-normalized 1-morphism in the free bicategory to the\nfully-normalized 1-morphism.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.normalize_unit_iso", "description": "Auxiliary definition for `normalize_equiv`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.normalize_aux", "description": "The normalization of the composition of `p : path a b` and `f : hom b c`.\n`p` will eventually be taken to be `nil` and we then get the normalization\nof `f` alone, but the auxiliary `p` is necessary for Lean to accept the definition of\n`normalize_iso` and the `whisker_left` case of `normalize_aux_congr` and `normalize_naturality`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.normalize_naturality", "description": "The 2-isomorphism `normalize_iso p f` is natural in `f`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.normalize", "description": "The normalization pseudofunctor for the free bicategory on a quiver `B`.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.normalize_equiv", "description": "Normalization as an equivalence of categories.", "p": "mathlib"}, {"name": "category_theory.free_bicategory.normalize_aux_congr", "description": "Given a 2-morphism between `f` and `g` in the free bicategory, we have the equality\n`normalize_aux p f = normalize_aux p g`.", "p": "mathlib"}, {"name": "unit_add_circle.mem_approx_add_order_of_iff", "description": "", "p": "mathlib"}, {"name": "approx_order_of.smul_eq_of_mul_dvd", "description": "", "p": "mathlib"}, {"name": "mem_add_well_approximable_iff", "description": "", "p": "mathlib"}, {"name": "approx_add_order_of", "description": "In a seminormed additive group `A`, given `n : \u2115` and `\u03b4 : \u211d`,\n`approx_add_order_of A n \u03b4` is the set of elements within a distance `\u03b4` of a point of order `n`.", "p": "mathlib"}, {"name": "approx_add_order_of.image_nsmul_subset_of_coprime", "description": "", "p": "mathlib"}, {"name": "approx_order_of", "description": " In a seminormed group `A`, given `n : \u2115` and `\u03b4 : \u211d`, `approx_order_of A n \u03b4` is the set of\nelements within a distance `\u03b4` of a point of order `n`.", "p": "mathlib"}, {"name": "approx_add_order_of.image_nsmul_subset", "description": "", "p": "mathlib"}, {"name": "mem_approx_order_of_iff", "description": "", "p": "mathlib"}, {"name": "add_circle.add_well_approximable_ae_empty_or_univ", "description": "*Gallagher's ergodic theorem* on Diophantine approximation.", "p": "mathlib"}, {"name": "approx_order_of.smul_subset_of_coprime", "description": "", "p": "mathlib"}, {"name": "add_well_approximable", "description": "In a seminormed additive group `A`, given a sequence of\ndistances `\u03b4\u2081, \u03b4\u2082, ...`, `add_well_approximable A \u03b4` is the limsup as `n \u2192 \u221e` of the sets\n`approx_add_order_of A n \u03b4\u2099`. Thus, it is the set of points that lie in infinitely many of the sets\n`approx_add_order_of A n \u03b4\u2099`.", "p": "mathlib"}, {"name": "approx_order_of.image_pow_subset_of_coprime", "description": "", "p": "mathlib"}, {"name": "approx_order_of.image_pow_subset", "description": "", "p": "mathlib"}, {"name": "approx_add_order_of.vadd_subset_of_coprime", "description": "", "p": "mathlib"}, {"name": "mem_well_approximable_iff", "description": "", "p": "mathlib"}, {"name": "unit_add_circle.mem_add_well_approximable_iff", "description": "", "p": "mathlib"}, {"name": "well_approximable", "description": " In a seminormed group `A`, given a sequence of distances `\u03b4\u2081, \u03b4\u2082, ...`, `well_approximable A \u03b4`\nis the limsup as `n \u2192 \u221e` of the sets `approx_order_of A n \u03b4\u2099`. Thus, it is the set of points that\nlie in infinitely many of the sets `approx_order_of A n \u03b4\u2099`.", "p": "mathlib"}, {"name": "mem_approx_add_order_of_iff", "description": "", "p": "mathlib"}, {"name": "approx_add_order_of.vadd_eq_of_mul_dvd", "description": "", "p": "mathlib"}, {"name": "group.rootable_by_int_of_rootable_by_nat", "description": "A group is `\u2124`-rootable if it is `\u2115`-rootable.", "p": "mathlib"}, {"name": "rootable_by.surjective_pow", "description": "", "p": "mathlib"}, {"name": "quotient_add_group.divisible_by", "description": "Any quotient group of a divisible group is divisible", "p": "mathlib"}, {"name": "pow_left_surj_of_rootable_by", "description": "", "p": "mathlib"}, {"name": "quotient_group.rootable_by", "description": "Any quotient group of a rootable group is rootable.", "p": "mathlib"}, {"name": "function.surjective.rootable_by", "description": "If `f : A \u2192 B` is a surjective homomorphism and `A` is `\u03b1`-rootable, then `B` is also `\u03b1`-rootable.", "p": "mathlib"}, {"name": "add_comm_group.divisible_by_int_of_smul_top_eq_top", "description": "If for all `n \u2260 0 \u2208 \u2124`, `n \u2022 A = A`, then `A` is divisible.", "p": "mathlib"}, {"name": "prod.divisible_by", "description": "", "p": "mathlib"}, {"name": "smul_right_surj_of_divisible_by", "description": "", "p": "mathlib"}, {"name": "rootable_by_of_pow_left_surj", "description": "A `monoid A` is `\u03b1`-rootable iff the `pow _ n` function is surjective, i.e. the constructive version\nimplies the textbook approach.", "p": "mathlib"}, {"name": "group.rootable_by_nat_of_rootable_by_int", "description": "A group is `\u2115`-rootable if it is `\u2124`-rootable", "p": "mathlib"}, {"name": "add_comm_group.smul_top_eq_top_of_divisible_by_int", "description": "", "p": "mathlib"}, {"name": "function.surjective.divisible_by", "description": "If `f : A \u2192 B` is a surjective homomorphism and\n`A` is `\u03b1`-divisible, then `B` is also `\u03b1`-divisible.", "p": "mathlib"}, {"name": "rootable_by", "description": "A `monoid A` is `\u03b1`-rootable iff `x\u207f = a` has a solution for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.\nHere we adopt a constructive approach where we ask an explicit `root : A \u2192 \u03b1 \u2192 A` function such that\n* `root a 0 = 1` for all `a \u2208 A`\n* `(root a n)\u207f = a` for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.", "p": "mathlib"}, {"name": "rootable_by.root", "description": "A `monoid A` is `\u03b1`-rootable iff `x\u207f = a` has a solution for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.\nHere we adopt a constructive approach where we ask an explicit `root : A \u2192 \u03b1 \u2192 A` function such that\n* `root a 0 = 1` for all `a \u2208 A`\n* `(root a n)\u207f = a` for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.", "p": "mathlib"}, {"name": "rootable_by.root_zero", "description": "A `monoid A` is `\u03b1`-rootable iff `x\u207f = a` has a solution for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.\nHere we adopt a constructive approach where we ask an explicit `root : A \u2192 \u03b1 \u2192 A` function such that\n* `root a 0 = 1` for all `a \u2208 A`\n* `(root a n)\u207f = a` for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.", "p": "mathlib"}, {"name": "rootable_by.root_cancel", "description": "A `monoid A` is `\u03b1`-rootable iff `x\u207f = a` has a solution for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.\nHere we adopt a constructive approach where we ask an explicit `root : A \u2192 \u03b1 \u2192 A` function such that\n* `root a 0 = 1` for all `a \u2208 A`\n* `(root a n)\u207f = a` for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.", "p": "mathlib"}, {"name": "divisible_by.surjective_smul", "description": "", "p": "mathlib"}, {"name": "pi.rootable_by", "description": "", "p": "mathlib"}, {"name": "divisible_by_of_smul_right_surj", "description": "An `add_monoid A` is `\u03b1`-divisible iff `n \u2022 _` is a surjective function, i.e. the constructive\nversion implies the textbook approach.", "p": "mathlib"}, {"name": "divisible_by", "description": "An `add_monoid A` is `\u03b1`-divisible iff `n \u2022 x = a` has a solution for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.\nHere we adopt a constructive approach where we ask an explicit `div : A \u2192 \u03b1 \u2192 A` function such that\n* `div a 0 = 0` for all `a \u2208 A`\n* `n \u2022 div a n = a` for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.", "p": "mathlib"}, {"name": "divisible_by.div", "description": "An `add_monoid A` is `\u03b1`-divisible iff `n \u2022 x = a` has a solution for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.\nHere we adopt a constructive approach where we ask an explicit `div : A \u2192 \u03b1 \u2192 A` function such that\n* `div a 0 = 0` for all `a \u2208 A`\n* `n \u2022 div a n = a` for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.", "p": "mathlib"}, {"name": "divisible_by.div_zero", "description": "An `add_monoid A` is `\u03b1`-divisible iff `n \u2022 x = a` has a solution for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.\nHere we adopt a constructive approach where we ask an explicit `div : A \u2192 \u03b1 \u2192 A` function such that\n* `div a 0 = 0` for all `a \u2208 A`\n* `n \u2022 div a n = a` for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.", "p": "mathlib"}, {"name": "divisible_by.div_cancel", "description": "An `add_monoid A` is `\u03b1`-divisible iff `n \u2022 x = a` has a solution for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.\nHere we adopt a constructive approach where we ask an explicit `div : A \u2192 \u03b1 \u2192 A` function such that\n* `div a 0 = 0` for all `a \u2208 A`\n* `n \u2022 div a n = a` for all `n \u2260 0 \u2208 \u03b1` and `a \u2208 A`.", "p": "mathlib"}, {"name": "divisible_by_int_of_char_zero", "description": "", "p": "mathlib"}, {"name": "add_group.divisible_by_nat_of_divisible_by_int", "description": "An additive group is `\u2115`-divisible if it `\u2124`-divisible.", "p": "mathlib"}, {"name": "add_group.divisible_by_int_of_divisible_by_nat", "description": "An additive group is `\u