inal.fp_iff_deriv_family", "description": "", "p": "mathlib"}, {"name": "ordinal.is_normal.fp_iff_deriv", "description": "", "p": "mathlib"}, {"name": "ordinal.fp_unbounded", "description": " The fixed point lemma for normal functions: any normal function has an unbounded set of\nfixed points.", "p": "mathlib"}, {"name": "ordinal.foldr_le_nfp_family", "description": "", "p": "mathlib"}, {"name": "ordinal.nfp", "description": " The next fixed point function, the least fixed point of the normal function `f`, at least `a`.\n\nThis is defined as `ordinal.nfp_family` applied to a family consisting only of `f`.", "p": "mathlib"}, {"name": "ordinal.nfp_mul_zero", "description": "", "p": "mathlib"}, {"name": "ordinal.fp_family_unbounded", "description": "A generalization of the fixed point lemma for normal functions: any family of normal functions\n   has an unbounded set of common fixed points.", "p": "mathlib"}, {"name": "ordinal.is_normal.apply_le_nfp", "description": "", "p": "mathlib"}, {"name": "ordinal.deriv_family_fp", "description": "", "p": "mathlib"}, {"name": "ordinal.deriv_bfamily_is_normal", "description": "", "p": "mathlib"}, {"name": "ordinal.add_eq_right_iff_mul_omega_le", "description": "", "p": "mathlib"}, {"name": "ordinal.is_normal.nfp_le_apply", "description": "", "p": "mathlib"}, {"name": "ordinal.apply_le_nfp_family", "description": "", "p": "mathlib"}, {"name": "ordinal.nfp_id", "description": "", "p": "mathlib"}, {"name": "ordinal.deriv_succ", "description": "", "p": "mathlib"}, {"name": "ordinal.nfp_monotone", "description": "", "p": "mathlib"}, {"name": "ordinal.deriv_family_is_normal", "description": "", "p": "mathlib"}, {"name": "ordinal.le_nfp", "description": "", "p": "mathlib"}, {"name": "ordinal.lt_nfp", "description": "", "p": "mathlib"}, {"name": "ordinal.deriv_family_eq_enum_ord", "description": "For a family of normal functions, `ordinal.deriv_family` enumerates the common fixed points.", "p": "mathlib"}, {"name": "ordinal.deriv_eq_enum