escription": "", "p": "mathlib"}, {"name": "bool.cond_to_bool", "description": "", "p": "mathlib"}, {"name": "bool.to_bool_coe", "description": "", "p": "mathlib"}, {"name": "bool.bor_bnot_self", "description": "", "p": "mathlib"}, {"name": "bool.bor_band_distrib_left", "description": "", "p": "mathlib"}, {"name": "bool.exists_bool", "description": "", "p": "mathlib"}, {"name": "bool.bxor_bnot_bnot", "description": "", "p": "mathlib"}, {"name": "bool.le_iff_imp", "description": "", "p": "mathlib"}, {"name": "bool.bnot_tt", "description": "", "p": "mathlib"}, {"name": "bool.tt_eq_to_bool_iff", "description": "", "p": "mathlib"}, {"name": "bool.default_bool", "description": "", "p": "mathlib"}, {"name": "bool.of_nat_le_of_nat", "description": "", "p": "mathlib"}, {"name": "bool.decidable_forall_bool", "description": "If `p b` is decidable for all `b : bool`, then `\u2200 b, p b` is decidable", "p": "mathlib"}, {"name": "bool.bnot_ne", "description": "", "p": "mathlib"}, {"name": "bool.bnot_eq_iff", "description": "", "p": "mathlib"}, {"name": "bool.band_intro", "description": "", "p": "mathlib"}, {"name": "bool.bor_inr", "description": "", "p": "mathlib"}, {"name": "bool.bxor_ff_right", "description": "", "p": "mathlib"}, {"name": "bool.decidable_exists_bool", "description": "If `p b` is decidable for all `b : bool`, then `\u2203 b, p b` is decidable", "p": "mathlib"}, {"name": "bool.band_assoc", "description": "", "p": "mathlib"}, {"name": "bool.bxor_left_comm", "description": "", "p": "mathlib"}, {"name": "bool.band_left_comm", "description": "", "p": "mathlib"}, {"name": "bool.not_eq_bnot", "description": "", "p": "mathlib"}, {"name": "bool.coe_to_bool", "description": "", "p": "mathlib"}, {"name": "bool.bor_left_comm", "description": "", "p": "mathlib"}, {"name": "bool.right_le_bor", "description": "", "p": "mathlib"}, {"name": "bool.of_nat_to_nat", "description": "", "p": "mathlib"}, {"name": "bool.eq_or_eq_bnot", "description": "", "p": "mathlib"}, {"name": "bool.bxor_bnot_right", "description": "", "p": "mathlib"}, {"name": "bool.band_elim_right", "description": "", "p": "mathlib"}, {"name": "bool.to_bool_or", "description": "", "p": "mathlib"}, {"name": "bool.of_nat", "description": "convert a `\u2115` to a `bool`, `0 -> false`, everything else -> `true`", "p": "mathlib"}, {"name": "bool.linear_order", "description": "", "p": "mathlib"}, {"name": "bool.bor_comm", "description": "", "p": "mathlib"}, {"name": "bool.cond_bnot", "description": "", "p": "mathlib"}, {"name": "bool.bxor_bnot_left", "description": "", "p": "mathlib"}, {"name": "bool.injective_iff", "description": "", "p": "mathlib"}, {"name": "bool.to_bool_eq", "description": "", "p": "mathlib"}, {"name": "bool.cond_eq_ite", "description": "", "p": "mathlib"}, {"name": "bool.band_bxor_distrib_right", "description": "", "p": "mathlib"}, {"name": "bool.not_ff", "description": "", "p": "mathlib"}, {"name": "bool.bxor_assoc", "description": "", "p": "mathlib"}, {"name": "bool.bnot_ne_self", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coe_mul_right", "description": "", "p": "mathlib"}, {"name": "succ_ne_self", "description": "", "p": "mathlib"}, {"name": "add_hom.mul_left", "description": "Left multiplication by an element of a type with distributive multiplication is an `add_hom`.", "p": "mathlib"}, {"name": "add_hom.mul_right_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.mul_right_apply", "description": "", "p": "mathlib"}, {"name": "is_domain.to_no_zero_divisors", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.coe_mul_left", "description": "", "p": "mathlib"}, {"name": "add_hom.mul_left_apply", "description": "", "p": "mathlib"}, {"name": "inv_neg'", "description": "", "p": "mathlib"}, {"name": "add_hom.mul_right", "description": "Left multiplication by an element of a type with distributive multiplication is an `add_hom`.", "p": "mathlib"}, {"name": "add_monoid_hom.mul_left", "description": "Left multiplication by an element of a (semi)ring is an `add_monoid_hom`", "p": "mathlib"}, {"name": "is_right_cancel_mul_zero.to_no_zero_divisors", "description": "", "p": "mathlib"}, {"name": "mul_opposite.has_distrib_neg", "description": "", "p": "mathlib"}, {"name": "is_left_cancel_mul_zero.to_no_zero_divisors", "description": "", "p": "mathlib"}, {"name": "no_zero_divisors.to_is_cancel_mul_zero", "description": "", "p": "mathlib"}, {"name": "map_bit0", "description": "Additive homomorphisms preserve `bit0`.", "p": "mathlib"}, {"name": "no_zero_divisors.to_is_domain", "description": "", "p": "mathlib"}, {"name": "pred_ne_self", "description": "", "p": "mathlib"}, {"name": "Vieta_formula_quadratic", "description": "Vieta's formula for a quadratic equation, relating the coefficients of the polynomial with\n its roots. This particular version states that if we have a root `x` of a monic quadratic\n polynomial, then there is another root `y` such that `x + y` is negative the `a_1` coefficient\n and `x * y` is the `a_0` coefficient.", "p": "mathlib"}, {"name": "add_monoid_hom.mul_right", "description": "Right multiplication by an element of a (semi)ring is an `add_monoid_hom`", "p": "mathlib"}, {"name": "occurrences_repr", "description": "", "p": "core"}, {"name": "occurrences_to_format", "description": "", "p": "core"}, {"name": "occurrences.has_repr", "description": "", "p": "core"}, {"name": "occurrences.has_to_format", "description": "", "p": "core"}, {"name": "occurrences.contains", "description": "", "p": "core"}, {"name": "occurrences", "description": "We can specify the scope of application of some tactics using\n the following type.\n\n - all : all occurrences of a given term are considered.\n\n - pos [1, 3] : only the first and third occurrences of a given\n   term are consiered.\n\n - neg [2] : all but the second occurrence of a given term\n   are considered.", "p": "core"}, {"name": "occurrences.all", "description": "We can specify the scope of application of some tactics using\n the following type.\n\n - all : all occurrences of a given term are considered.\n\n - pos [1, 3] : only the first and third occurrences of a given\n   term are consiered.\n\n - neg [2] : all but the second occurrence of a given term\n   are considered.", "p": "core"}, {"name": "occurrences.pos", "description": "We can specify the scope of application of some tactics using\n the following type.\n\n - all : all occurrences of a given term are considered.\n\n - pos [1, 3] : only the first and third occurrences of a given\n   term are consiered.\n\n - neg [2] : all but the second occurrence of a given term\n   are considered.", "p": "core"}, {"name": "occurrences.neg", "description": "We can specify the scope of application of some tactics using\n the following type.\n\n - all : all occurrences of a given term are considered.\n\n - pos [1, 3] : only the first and third occurrences of a given\n   term are consiered.\n\n - neg [2] : all but the second occurrence of a given term\n   are considered.", "p": "core"}, {"name": "occurrences.inhabited", "description": "", "p": "core"}, {"name": "homological_complex.hom.iso_app", "description": "The `i`-th component of an isomorphism of chain complexes.", "p": "mathlib"}, {"name": "homological_complex.kernel_from_eq_kernel", "description": "", "p": "mathlib"}, {"name": "homological_complex.zero_apply", "description": "", "p": "mathlib"}, {"name": "cochain_complex.of_d", "description": "", "p": "mathlib"}, {"name": "chain_complex.of_d", "description": "", "p": "mathlib"}, {"name": "chain_complex.of_hom", "description": "A constructor for chain maps between `\u03b1`-indexed chain complexes built using `chain_complex.of`,\nfrom a dependently typed collection of morphisms.", "p": "mathlib"}, {"name": "homological_complex.hom.inhabited", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.sq_from_left", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.comm_to_assoc", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.ext", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk'_X_0", "description": "", "p": "mathlib"}, {"name": "homological_complex.kernel_eq_kernel", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.comm_assoc", "description": "", "p": "mathlib"}, {"name": "homological_complex.zero", "description": "The zero complex", "p": "mathlib"}, {"name": "homological_complex.d_to_eq", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom_f_injective", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk'_X_0", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.comm_from_apply", "description": "", "p": "mathlib"}, {"name": "homological_complex.X_next", "description": "Either `C.X j`, if there is some `j` with `c.rel i j`, or `C.X i`.", "p": "mathlib"}, {"name": "homological_complex.hom.sq_to_left", "description": "", "p": "mathlib"}, {"name": "homological_complex", "description": "A `homological_complex V c` with a \"shape\" controlled by `c : complex_shape \u03b9`\nhas chain groups `X i` (objects in `V`) indexed by `i : \u03b9`,\nand a differential `d i j` whenever `c.rel i j`.\n\nWe in fact ask for differentials `d i j` for all `i j : \u03b9`,\nbut have a field `shape'` requiring that these are zero when not allowed by `c`.\nThis avoids a lot of dependent type theory hell!\n\nThe composite of any two differentials `d i j \u226b d j k` must be zero.", "p": "mathlib"}, {"name": "homological_complex.X", "description": "A `homological_complex V c` with a \"shape\" controlled by `c : complex_shape \u03b9`\nhas chain groups `X i` (objects in `V`) indexed by `i : \u03b9`,\nand a differential `d i j` whenever `c.rel i j`.\n\nWe in fact ask for differentials `d i j` for all `i j : \u03b9`,\nbut have a field `shape'` requiring that these are zero when not allowed by `c`.\nThis avoids a lot of dependent type theory hell!\n\nThe composite of any two differentials `d i j \u226b d j k` must be zero.", "p": "mathlib"}, {"name": "homological_complex.d", "description": "A `homological_complex V c` with a \"shape\" controlled by `c : complex_shape \u03b9`\nhas chain groups `X i` (objects in `V`) indexed by `i : \u03b9`,\nand a differential `d i j` whenever `c.rel i j`.\n\nWe in fact ask for differentials `d i j` for all `i j : \u03b9`,\nbut have a field `shape'` requiring that these are zero when not allowed by `c`.\nThis avoids a lot of dependent type theory hell!\n\nThe composite of any two differentials `d i j \u226b d j k` must be zero.", "p": "mathlib"}, {"name": "homological_complex.shape'", "description": "A `homological_complex V c` with a \"shape\" controlled by `c : complex_shape \u03b9`\nhas chain groups `X i` (objects in `V`) indexed by `i : \u03b9`,\nand a differential `d i j` whenever `c.rel i j`.\n\nWe in fact ask for differentials `d i j` for all `i j : \u03b9`,\nbut have a field `shape'` requiring that these are zero when not allowed by `c`.\nThis avoids a lot of dependent type theory hell!\n\nThe composite of any two differentials `d i j \u226b d j k` must be zero.", "p": "mathlib"}, {"name": "homological_complex.d_comp_d'", "description": "A `homological_complex V c` with a \"shape\" controlled by `c : complex_shape \u03b9`\nhas chain groups `X i` (objects in `V`) indexed by `i : \u03b9`,\nand a differential `d i j` whenever `c.rel i j`.\n\nWe in fact ask for differentials `d i j` for all `i j : \u03b9`,\nbut have a field `shape'` requiring that these are zero when not allowed by `c`.\nThis avoids a lot of dependent type theory hell!\n\nThe composite of any two differentials `d i j \u226b d j k` must be zero.", "p": "mathlib"}, {"name": "cochain_complex.mk_X_2", "description": "", "p": "mathlib"}, {"name": "homological_complex.ext", "description": "", "p": "mathlib"}, {"name": "homological_complex.shape", "description": "", "p": "mathlib"}, {"name": "cochain_complex.prev_nat_zero", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.sq_from_right", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.iso_app_inv", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_comp_eq_to_hom", "description": "If `C.d i j` and `C.d i j'` are both allowed, then we must have `j = j'`,\nand so the differentials only differ by an `eq_to_hom`.", "p": "mathlib"}, {"name": "homological_complex.X_prev_iso_self_comp_d_to_assoc", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_to_eq_zero", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_struct", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "chain_complex.mk_struct.X\u2080", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "chain_complex.mk_struct.X\u2081", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "chain_complex.mk_struct.X\u2082", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "chain_complex.mk_struct.d\u2080", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "chain_complex.mk_struct.d\u2081", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "chain_complex.mk_struct.s", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "homological_complex.X_prev_iso", "description": "If `c.rel i j`, then `C.X_prev j` is isomorphic to `C.X i`.", "p": "mathlib"}, {"name": "homological_complex.hom.ext_iff", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_from_comp_X_next_iso_assoc", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk'_d_1_0", "description": "", "p": "mathlib"}, {"name": "homological_complex.congr_hom", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk_X_0", "description": "", "p": "mathlib"}, {"name": "homological_complex.comp_f", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_hom_f_0", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_X_0", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk_struct.flat", "description": "Flatten to a tuple.", "p": "mathlib"}, {"name": "chain_complex.mk_X_1", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_from_comp_X_next_iso_self", "description": "", "p": "mathlib"}, {"name": "cochain_complex.of_hom_f", "description": "", "p": "mathlib"}, {"name": "homological_complex.inhabited", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk_hom_aux", "description": "An auxiliary construction for `mk_hom`.\n\nHere we build by induction a family of commutative squares,\nbut don't require at the type level that these successive commutative squares actually agree.\nThey do in fact agree, and we then capture that at the type level (i.e. by constructing a chain map)\nin `mk_hom`.", "p": "mathlib"}, {"name": "homological_complex.X_next_iso_self", "description": "If there is no `j` so `c.rel i j`, then `C.X_next i` is isomorphic to `C.X i`.", "p": "mathlib"}, {"name": "cochain_complex.of_X", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk'", "description": "A simpler inductive constructor for `\u2115`-indexed chain complexes.\n\nYou provide explicitly the first differential,\nthen a function which takes a differential,\nand returns the next object, its differential, and the fact it composes appropriately to zero.", "p": "mathlib"}, {"name": "homological_complex.X_prev_iso_comp_d_to", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.iso_of_components_hom_f", "description": "", "p": "mathlib"}, {"name": "chain_complex.next", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk_hom", "description": "A constructor for chain maps between `\u2115`-indexed cochain complexes,\nworking by induction on commutative squares.\n\nYou need to provide the components of the chain map in degrees 0 and 1,\nshow that these form a commutative square,\nand then give a construction of each component,\nand the fact that it forms a commutative square with the previous component,\nusing as an inductive hypothesis the data (and commutativity) of the previous two components.", "p": "mathlib"}, {"name": "homological_complex.is_zero_zero", "description": "", "p": "mathlib"}, {"name": "cochain_complex.next", "description": "", "p": "mathlib"}, {"name": "homological_complex.eval_map", "description": "", "p": "mathlib"}, {"name": "chain_complex.of_hom_f", "description": "", "p": "mathlib"}, {"name": "chain_complex.of_X", "description": "", "p": "mathlib"}, {"name": "homological_complex.category_theory.category", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk'_d_1_0", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk_struct", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "cochain_complex.mk_struct.X\u2080", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "cochain_complex.mk_struct.X\u2081", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "cochain_complex.mk_struct.X\u2082", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "cochain_complex.mk_struct.d\u2080", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "cochain_complex.mk_struct.d\u2081", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "cochain_complex.mk_struct.s", "description": "Auxiliary structure for setting up the recursion in `mk`.\nThis is purely an implementation detail: for some reason just using the dependent 6-tuple directly\nresults in `mk_aux` taking much longer (well over the `-T100000` limit) to elaborate.", "p": "mathlib"}, {"name": "homological_complex.hom.sq_from_comp", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_comp_d", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_hom_f_1", "description": "", "p": "mathlib"}, {"name": "homological_complex.forget_obj", "description": "", "p": "mathlib"}, {"name": "homological_complex.forget_map", "description": "", "p": "mathlib"}, {"name": "homological_complex.id", "description": "Identity chain map.", "p": "mathlib"}, {"name": "homological_complex.hom.is_iso_of_components", "description": "", "p": "mathlib"}, {"name": "homological_complex.forget_eval", "description": " Forgetting the differentials than picking out the `i`-th object is the same as\njust picking out the `i`-th object.", "p": "mathlib"}, {"name": "homological_complex.forget", "description": "The functor forgetting the differential in a complex, obtaining a graded object.", "p": "mathlib"}, {"name": "homological_complex.image_eq_image", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_from_eq", "description": "", "p": "mathlib"}, {"name": "chain_complex.of_d_ne", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk", "description": "A inductive constructor for `\u2115`-indexed cochain complexes.\n\nYou provide explicitly the first two differentials,\nthen a function which takes two differentials and the fact they compose to zero,\nand returns the next object, its differential, and the fact it composes appropiately to zero.\n\nSee also `mk'`, which only sees the previous differential in the inductive step.", "p": "mathlib"}, {"name": "homological_complex.d_to", "description": "The differential mapping into `C.X j`, or zero if there isn't one.", "p": "mathlib"}, {"name": "chain_complex.mk_d_1_0", "description": "", "p": "mathlib"}, {"name": "chain_complex.of", "description": "Construct an `\u03b1`-indexed chain complex from a dependently-typed differential.", "p": "mathlib"}, {"name": "chain_complex.mk_X_2", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.comm_from_assoc", "description": "", "p": "mathlib"}, {"name": "homological_complex.eq_to_hom_f", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk_aux", "description": "Auxiliary definition for `mk`.", "p": "mathlib"}, {"name": "homological_complex.category_theory.limits.has_zero_object", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.comm_to", "description": "", "p": "mathlib"}, {"name": "homological_complex.category_theory.limits.has_zero_morphisms", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.sq_to", "description": "A morphism of chain complexes\ninduces a morphism of arrows of the differentials into each object.", "p": "mathlib"}, {"name": "homological_complex.id_f", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_from_comp_X_next_iso", "description": "", "p": "mathlib"}, {"name": "homological_complex.X_prev_iso_self", "description": "If there is no `i` so `c.rel i j`, then `C.X_prev j` is isomorphic to `C.X j`.", "p": "mathlib"}, {"name": "homological_complex.X_prev", "description": "Either `C.X i`, if there is some `i` with `c.rel i j`, or `C.X j`.", "p": "mathlib"}, {"name": "homological_complex.forget_eval_inv_app", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.comm_from", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.sq_from_id", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk_hom_f_succ_succ", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_hom", "description": "A constructor for chain maps between `\u2115`-indexed chain complexes,\nworking by induction on commutative squares.\n\nYou need to provide the components of the chain map in degrees 0 and 1,\nshow that these form a commutative square,\nand then give a construction of each component,\nand the fact that it forms a commutative square with the previous component,\nusing as an inductive hypothesis the data (and commutativity) of the previous two components.", "p": "mathlib"}, {"name": "chain_complex.mk'_X_1", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_hom_f_succ_succ", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_aux", "description": "Auxiliary definition for `mk`.", "p": "mathlib"}, {"name": "chain_complex.next_nat_zero", "description": "", "p": "mathlib"}, {"name": "homological_complex.forget_eval_hom_app", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk'_X_1", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.prev", "description": "`f.prev j` is `f.f i` if there is some `r i j`, and `f.f j` otherwise.", "p": "mathlib"}, {"name": "cochain_complex.prev", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_d_2_0", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.iso_of_components_app", "description": "", "p": "mathlib"}, {"name": "cochain_complex", "description": "An `\u03b1`-indexed cochain complex is a `homological_complex`\nin which `d i j \u2260 0` only if `i + 1 = j`.", "p": "mathlib"}, {"name": "homological_complex.hom.comm", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.iso_app_hom", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_to_comp_d_from", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.sq_to_right", "description": "", "p": "mathlib"}, {"name": "cochain_complex.of", "description": "Construct an `\u03b1`-indexed cochain complex from a dependently-typed differential.", "p": "mathlib"}, {"name": "homological_complex.hom.iso_of_components_inv_f", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_hom_aux", "description": "An auxiliary construction for `mk_hom`.\n\nHere we build by induction a family of commutative squares,\nbut don't require at the type level that these successive commutative squares actually agree.\nThey do in fact agree, and we then capture that at the type level (i.e. by constructing a chain map)\nin `mk_hom`.", "p": "mathlib"}, {"name": "cochain_complex.mk_hom_f_1", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk_d_1_0", "description": "", "p": "mathlib"}, {"name": "cochain_complex.mk_d_2_0", "description": "", "p": "mathlib"}, {"name": "chain_complex", "description": "An `\u03b1`-indexed chain complex is a `homological_complex`\nin which `d i j \u2260 0` only if `j + 1 = i`.", "p": "mathlib"}, {"name": "homological_complex.eval_obj", "description": "", "p": "mathlib"}, {"name": "homological_complex.X_next_iso", "description": "If `c.rel i j`, then `C.X_next i` is isomorphic to `C.X j`.", "p": "mathlib"}, {"name": "homological_complex.eq_to_hom_comp_d", "description": "If `C.d i j` and `C.d i' j` are both allowed, then we must have `i = i'`,\nand so the differentials only differ by an `eq_to_hom`.", "p": "mathlib"}, {"name": "homological_complex.hom.prev_eq", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom", "description": "A morphism of homological complexes consists of maps between the chain groups,\ncommuting with the differentials.", "p": "mathlib"}, {"name": "homological_complex.hom.f", "description": "A morphism of homological complexes consists of maps between the chain groups,\ncommuting with the differentials.", "p": "mathlib"}, {"name": "homological_complex.hom.comm'", "description": "A morphism of homological complexes consists of maps between the chain groups,\ncommuting with the differentials.", "p": "mathlib"}, {"name": "cochain_complex.mk_X_1", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_from", "description": "The differential mapping out of `C.X i`, or zero if there isn't one.", "p": "mathlib"}, {"name": "homological_complex.eval", "description": "The functor picking out the `i`-th object of a complex.", "p": "mathlib"}, {"name": "homological_complex.hom.sq_from", "description": "A morphism of chain complexes\ninduces a morphism of arrows of the differentials out of each object.", "p": "mathlib"}, {"name": "homological_complex.hom.comm_to_apply", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_from_eq_zero", "description": "", "p": "mathlib"}, {"name": "cochain_complex.of_hom", "description": "A constructor for chain maps between `\u03b1`-indexed cochain complexes built using `cochain_complex.of`,\nfrom a dependently typed collection of morphisms.", "p": "mathlib"}, {"name": "chain_complex.next_nat_succ", "description": "", "p": "mathlib"}, {"name": "chain_complex.mk_struct.flat", "description": "Flatten to a tuple.", "p": "mathlib"}, {"name": "homological_complex.X_prev_iso_self_comp_d_to", "description": "", "p": "mathlib"}, {"name": "cochain_complex.prev_nat_succ", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_from_comp_X_next_iso_self_assoc", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.iso_of_components", "description": " Construct an isomorphism of chain complexes from isomorphism of the objects\nwhich commute with the differentials.", "p": "mathlib"}, {"name": "chain_complex.mk", "description": "A inductive constructor for `\u2115`-indexed chain complexes.\n\nYou provide explicitly the first two differentials,\nthen a function which takes two differentials and the fact they compose to zero,\nand returns the next object, its differential, and the fact it composes appropiately to zero.\n\nSee also `mk'`, which only sees the previous differential in the inductive step.", "p": "mathlib"}, {"name": "chain_complex.prev", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.next_eq", "description": "", "p": "mathlib"}, {"name": "homological_complex.comp", "description": "Composition of chain maps.", "p": "mathlib"}, {"name": "cochain_complex.mk_hom_f_0", "description": "", "p": "mathlib"}, {"name": "homological_complex.image_to_eq_image", "description": "", "p": "mathlib"}, {"name": "cochain_complex.of_d_ne", "description": "", "p": "mathlib"}, {"name": "homological_complex.d_comp_d_assoc", "description": "", "p": "mathlib"}, {"name": "homological_complex.X_prev_iso_comp_d_to_assoc", "description": "", "p": "mathlib"}, {"name": "homological_complex.hom.next", "description": "`f.next i` is `f.f j` if there is some `r i j`, and `f.f j` otherwise.", "p": "mathlib"}, {"name": "cochain_complex.mk'", "description": "A simpler inductive constructor for `\u2115`-indexed cochain complexes.\n\nYou provide explicitly the first differential,\nthen a function which takes a differential,\nand returns the next object, its differential, and the fact it composes appropriately to zero.", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry0", "description": "Associating to a continuous multilinear map in `0` variables the unique value it takes.", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_dom_dom_congr", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_left_equiv_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.comp_continuous_linear_map_equivL_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_map_init_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry_curry_left", "description": "", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous", "description": " Constructing a continuous multilinear map from a multilinear map satisfying a boundedness\ncondition.", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous_multilinear_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.le_op_norm_mul_pow_of_le", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.uncurry_left", "description": " Given a continuous linear map `f` from `E 0` to continuous multilinear maps on `n` variables,\nconstruct the corresponding continuous multilinear map on `n+1` variables obtained by concatenating\nthe variables, given by `m \u21a6 f (m 0) (tail m)`", "p": "mathlib"}, {"name": "continuous_multilinear_map.apply_zero_curry0", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_comp_continuous_linear_isometry_equiv", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.le_of_op_norm_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.op_norm_prod", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.normed_add_comm_group'", "description": " An alias of `continuous_multilinear_map.normed_add_comm_group` with non-dependent types to help\ntypeclass search.", "p": "mathlib"}, {"name": "continuous_multilinear_curry_right_equiv_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.normed_add_comm_group", "description": "Continuous multilinear maps themselves form a normed space with respect to\n   the operator norm.", "p": "mathlib"}, {"name": "continuous_linear_map.norm_map_tail_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_fin_finset_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.comp_continuous_linear_mapL_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.le_of_op_nnnorm_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_fin1", "description": " Continuous multilinear maps from `G^1` to `G'` are isomorphic with continuous linear maps from\n`G` to `G'`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry0_norm", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.comp_continuous_multilinear_mapL_symm", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry_right_norm", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_image_sub_le", "description": " The difference `f m\u2081 - f m\u2082` is controlled in terms of `\u2016f\u2016` and `\u2016m\u2081 - m\u2082\u2016`, less precise\nversion. For a more precise but less usable version, see `norm_image_sub_le'`.\nThe bound is `\u2016f m - f m'\u2016 \u2264 \u2016f\u2016 * card \u03b9 * \u2016m - m'\u2016 * (max \u2016m\u2016 \u2016m'\u2016) ^ (card \u03b9 - 1)`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.bounds_nonempty", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_right_equiv'", "description": " The space of continuous multilinear maps on `\u03a0(i : fin (n+1)), G` is canonically isomorphic to\nthe space of continuous multilinear maps on `\u03a0(i : fin n), G` with values in the space\nof continuous linear maps on `G`, by separating the last variable. We register this\nisomorphism as a continuous linear equiv in `continuous_multilinear_curry_right_equiv' \ud835\udd5c n G G'`.\nFor a version allowing dependent types, see `continuous_multilinear_curry_right_equiv`. When there\nare no dependent types, use the primed version as it helps Lean a lot for unification.\n\nThe direct and inverse maps are given by `f.uncurry_right` and `f.curry_right`. Use these\nunless you need the full framework of linear isometric equivs.", "p": "mathlib"}, {"name": "continuous_multilinear_map.complete_space", "description": " If the target space is complete, the space of continuous multilinear maps with its norm is also\ncomplete. The proof is essentially the same as for the space of continuous linear maps (modulo the\naddition of `finset.prod` where needed. The duplication could be avoided by deducing the linear\ncase from the multilinear case via a currying isomorphism. However, this would mess up imports,\nand it is more satisfactory to have the simplest case as a standalone proof.", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_sum_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.pi_field_equiv", "description": " Continuous multilinear maps on `\ud835\udd5c^n` with values in `G` are in bijection with `G`, as such a\ncontinuous multilinear map is completely determined by its value on the constant vector made of\nones. We register this bijection as a linear isometry in\n`continuous_multilinear_map.pi_field_equiv`.", "p": "mathlib"}, {"name": "continuous_linear_map.comp_continuous_multilinear_mapL", "description": "`continuous_linear_map.comp_continuous_multilinear_map` as a bundled continuous bilinear map.", "p": "mathlib"}, {"name": "continuous_multilinear_map.op_norm_zero", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.le_op_norm_mul_pow_card_of_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.nnnorm_const_of_is_empty", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.comp_continuous_linear_map_equivL", "description": " `continuous_multilinear_map.comp_continuous_linear_map` as a bundled continuous linear equiv,\ngiven `f : \u03a0 i, E i \u2243L[\ud835\udd5c] E\u2081 i`.", "p": "mathlib"}, {"name": "continuous_linear_equiv.comp_continuous_multilinear_mapL", "description": " `continuous_linear_map.comp_continuous_multilinear_map` as a bundled\ncontinuous linear equiv.", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry_sum", "description": " A continuous multilinear map with variables indexed by `\u03b9` taking values in the space of\ncontinuous multilinear maps with variables indexed by `\u03b9'` defines a continuous multilinear map with\nvariables indexed by `\u03b9 \u2295 \u03b9'`.", "p": "mathlib"}, {"name": "multilinear_map.bound_of_shell", "description": " If a multilinear map in finitely many variables on normed spaces satisfies the inequality\n`\u2016f m\u2016 \u2264 C * \u220f i, \u2016m i\u2016` on a shell `\u03b5 i / \u2016c i\u2016 < \u2016m i\u2016 < \u03b5 i` for some positive numbers `\u03b5 i`\nand elements `c i : \ud835\udd5c`, `1 < \u2016c i\u2016`, then it satisfies this inequality for all `m`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.dom_dom_congr\u2097\u1d62", "description": " An equivalence of the index set defines a linear isometric equivalence between the spaces\nof multilinear maps.", "p": "mathlib"}, {"name": "continuous_multilinear_map.le_op_norm", "description": " The fundamental property of the operator norm of a continuous multilinear map:\n`\u2016f m\u2016` is bounded by `\u2016f\u2016` times the product of the `\u2016m i\u2016`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_left_norm", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.op_norm_zero_iff", "description": "A continuous linear map is zero iff its norm vanishes.", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_def", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_fin_finset", "description": " If `s : finset (fin n)` is a finite set of cardinality `k` and its complement has cardinality\n`l`, then the space of continuous multilinear maps `G [\u00d7n]\u2192L[\ud835\udd5c] G'` of `n` variables is isomorphic\nto the space of continuous multilinear maps `G [\u00d7k]\u2192L[\ud835\udd5c] G [\u00d7l]\u2192L[\ud835\udd5c] G'` of `k` variables taking\nvalues in the space of continuous multilinear maps of `l` variables.", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_left", "description": " Given a continuous multilinear map `f` in `n+1` variables, split the first variable to obtain\na continuous linear map into continuous multilinear maps in `n` variables, given by\n`x \u21a6 (m \u21a6 f (cons x m))`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.normed_space", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.op_norm", "description": "The operator norm of a continuous multilinear map is the inf of all its bounds.", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_mk_pi_algebra", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_mk_pi_field", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.pi\u2097\u1d62", "description": "`continuous_multilinear_map.pi` as a `linear_isometry_equiv`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.mk_pi_field_zero", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_restr", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_mk_pi_algebra_fin", "description": "", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous_linear_norm_le", "description": "", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous_linear", "description": " Given a map `f : G \u2192\u2097[\ud835\udd5c] multilinear_map \ud835\udd5c E G'` and an estimate\n`H : \u2200 x m, \u2016f x m\u2016 \u2264 C * \u2016x\u2016 * \u220f i, \u2016m i\u2016`, construct a continuous linear\nmap from `G` to `continuous_multilinear_map \ud835\udd5c E G'`.\n\nIn order to lift, e.g., a map `f : (multilinear_map \ud835\udd5c E G) \u2192\u2097[\ud835\udd5c] multilinear_map \ud835\udd5c E' G'`\nto a map `(continuous_multilinear_map \ud835\udd5c E G) \u2192L[\ud835\udd5c] continuous_multilinear_map \ud835\udd5c E' G'`,\none can apply this construction to `f.comp continuous_multilinear_map.to_multilinear_map_linear`\nwhich is a linear map from `continuous_multilinear_map \ud835\udd5c E G` to `multilinear_map \ud835\udd5c E' G'`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.op_norm_smul_le", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.uncurry_left_norm", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_right_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_left_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_right_norm", "description": "", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous_multilinear_norm_le'", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.continuous_eval", "description": "Applying a multilinear map to a vector is continuous in both coordinates.", "p": "mathlib"}, {"name": "continuous_multilinear_map.has_op_norm", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_fin0_apply", "description": "", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous_linear_norm_le'", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.comp_continuous_multilinear_mapL_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.restrict_scalars_linear", "description": "`continuous_multilinear_map.restrict_scalars` as a `continuous_linear_map`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_right", "description": " Given a continuous multilinear map `f` in `n+1` variables, split the last variable to obtain\na continuous multilinear map in `n` variables into continuous linear maps, given by\n`m \u21a6 (x \u21a6 f (snoc m x))`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry0_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.mk_pi_field", "description": " The canonical continuous multilinear map on `\ud835\udd5c^\u03b9`, associating to `m` the product of all the\n`m i` (multiplied by a fixed reference element `z` in the target module)", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_image_sub_le'", "description": " The difference `f m\u2081 - f m\u2082` is controlled in terms of `\u2016f\u2016` and `\u2016m\u2081 - m\u2082\u2016`, precise version.\nFor a less precise but more usable version, see `norm_image_sub_le`. The bound reads\n`\u2016f m - f m'\u2016 \u2264\n  \u2016f\u2016 * \u2016m 1 - m' 1\u2016 * max \u2016m 2\u2016 \u2016m' 2\u2016 * max \u2016m 3\u2016 \u2016m' 3\u2016 * ... * max \u2016m n\u2016 \u2016m' n\u2016 + ...`,\nwhere the other terms in the sum are the same products where `1` is replaced by any `i`.", "p": "mathlib"}, {"name": "multilinear_map.continuous_of_bound", "description": " If a multilinear map satisfies an inequality `\u2016f m\u2016 \u2264 C * \u220f i, \u2016m i\u2016`, then it is\ncontinuous.", "p": "mathlib"}, {"name": "continuous_multilinear_map.le_op_nnnorm", "description": " The fundamental property of the operator norm of a continuous multilinear map:\n`\u2016f m\u2016` is bounded by `\u2016f\u2016` times the product of the `\u2016m i\u2016`, `nnnorm` version.", "p": "mathlib"}, {"name": "continuous_multilinear_curry_right_equiv_symm_apply'", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.has_op_norm'", "description": " An alias of `continuous_multilinear_map.has_op_norm` with non-dependent types to help typeclass\nsearch.", "p": "mathlib"}, {"name": "continuous_linear_map.flip_multilinear_apply_apply", "description": "", "p": "mathlib"}, {"name": "multilinear_map.norm_image_sub_le_of_bound", "description": " If `f` satisfies a boundedness property around `0`, one can deduce a bound on `f m\u2081 - f m\u2082`\nusing the multilinearity. Here, we give a usable but not very precise version. See\n`norm_image_sub_le_of_bound'` for a more precise but less usable version. The bound is\n`\u2016f m - f m'\u2016 \u2264 C * card \u03b9 * \u2016m - m'\u2016 * (max \u2016m\u2016 \u2016m'\u2016) ^ (card \u03b9 - 1)`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_map_cons_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_uncurry_right", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_right_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_restrict_scalars", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.norm_comp_continuous_multilinear_map_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_mk_pi_algebra_of_empty", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_fin_finset_symm_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_fin1_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_left_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_right_equiv_apply'", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.bounds_bdd_below", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.has_continuous_const_smul", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry0_curry0", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry_right_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.restr", "description": " Given a continuous multilinear map `f` on `n` variables (parameterized by `fin n`) and a subset\n`s` of `k` of these variables, one gets a new continuous multilinear map on `fin k` by varying\nthese variables, and fixing the other ones equal to a given value `z`. It is denoted by\n`f.restr s hk z`, where `hk` is a proof that the cardinality of `s` is `k`. The implicit\nidentification between `fin k` and `s` that we use is the canonical (increasing) bijection.", "p": "mathlib"}, {"name": "continuous_linear_map.flip_multilinear", "description": " Flip arguments in `f : G \u2192L[\ud835\udd5c] continuous_multilinear_map \ud835\udd5c E G'` to get\n`continuous_multilinear_map \ud835\udd5c E (G \u2192L[\ud835\udd5c] G')`", "p": "mathlib"}, {"name": "continuous_linear_map.uncurry_left_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_fin_finset_symm_apply_const", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.ratio_le_op_norm", "description": "", "p": "mathlib"}, {"name": "multilinear_map.coe_mk_continuous", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.bound", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.restrict_scalars\u2097\u1d62", "description": "`continuous_multilinear_map.restrict_scalars` as a `linear_isometry`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_fin_finset_symm_apply_piecewise_const", "description": "", "p": "mathlib"}, {"name": "multilinear_map.norm_image_sub_le_of_bound'", "description": " If `f` satisfies a boundedness property around `0`, one can deduce a bound on `f m\u2081 - f m\u2082`\nusing the multilinearity. Here, we give a precise but hard to use version. See\n`norm_image_sub_le_of_bound` for a less precise but more usable version. The bound reads\n`\u2016f m - f m'\u2016 \u2264\n  C * \u2016m 1 - m' 1\u2016 * max \u2016m 2\u2016 \u2016m' 2\u2016 * max \u2016m 3\u2016 \u2016m' 3\u2016 * ... * max \u2016m n\u2016 \u2016m' n\u2016 + ...`,\nwhere the other terms in the sum are the same products where `1` is replaced by any `i`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry_curry_right", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_mk_pi_algebra_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.comp_continuous_linear_map_equivL_symm", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.comp_continuous_linear_mapL", "description": " `continuous_multilinear_map.comp_continuous_linear_map` as a bundled continuous linear map.\nThis implementation fixes `f : \u03a0 i, E i \u2192L[\ud835\udd5c] E\u2081 i`.\n\nTODO: Actually, the map is multilinear in `f` but an attempt to formalize this failed because of\nissues with class instances.", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_mk_pi_algebra_fin_succ_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.unit_le_op_norm", "description": "The image of the unit ball under a continuous multilinear map is bounded.", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous_norm_le'", "description": " If a continuous multilinear map is constructed from a multilinear map via the constructor\n`mk_continuous`, then its norm is bounded by the bound given to the constructor if it is\nnonnegative.", "p": "mathlib"}, {"name": "continuous_multilinear_map.normed_space'", "description": " An alias of `continuous_multilinear_map.normed_space` with non-dependent types to help typeclass\nsearch.", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry0_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_fin_finset_apply_const", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.le_op_norm_mul_prod_of_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_sum_equiv", "description": " Linear isometric equivalence between the space of continuous multilinear maps with variables\nindexed by `\u03b9 \u2295 \u03b9'` and the space of continuous multilinear maps with variables indexed by `\u03b9`\ntaking values in the space of continuous multilinear maps with variables indexed by `\u03b9'`.\n\nThe forward and inverse functions are `continuous_multilinear_map.curry_sum`\nand `continuous_multilinear_map.uncurry_sum`. Use this definition only if you need\nsome properties of `linear_isometry_equiv`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_comp_continuous_linear_isometry_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_mk_pi_algebra_fin_le_of_pos", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_left_equiv", "description": " The space of continuous multilinear maps on `\u03a0(i : fin (n+1)), E i` is canonically isomorphic to\nthe space of continuous linear maps from `E 0` to the space of continuous multilinear maps on\n`\u03a0(i : fin n), E i.succ `, by separating the first variable. We register this isomorphism in\n`continuous_multilinear_curry_left_equiv \ud835\udd5c E E\u2082`. The algebraic version (without topology) is given\nin `multilinear_curry_left_equiv \ud835\udd5c E E\u2082`.\n\nThe direct and inverse maps are given by `f.uncurry_left` and `f.curry_left`. Use these\nunless you need the full framework of linear isometric equivs.", "p": "mathlib"}, {"name": "continuous_multilinear_map.fin0_apply_norm", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_comp_continuous_linear_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry_right", "description": " Given a continuous linear map `f` from continuous multilinear maps on `n` variables to\ncontinuous linear maps on `E 0`, construct the corresponding continuous multilinear map on `n+1`\nvariables obtained by concatenating the variables, given by `m \u21a6 f (init m) (m (last n))`.", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous_multilinear", "description": " Given a map `f : multilinear_map \ud835\udd5c E (multilinear_map \ud835\udd5c E' G)` and an estimate\n`H : \u2200 m m', \u2016f m m'\u2016 \u2264 C * \u220f i, \u2016m i\u2016 * \u220f i, \u2016m' i\u2016`, upgrade all `multilinear_map`s in the type to\n`continuous_multilinear_map`s.", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry0_norm", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_comp_continuous_linear_mapL_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry0_uncurry0", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.prodL", "description": "`continuous_multilinear_map.prod` as a `linear_isometry_equiv`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_map_snoc_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.tsum_eval", "description": "", "p": "mathlib"}, {"name": "multilinear_map.exists_bound_of_continuous", "description": " If a multilinear map in finitely many variables on normed spaces is continuous, then it\nsatisfies the inequality `\u2016f m\u2016 \u2264 C * \u220f i, \u2016m i\u2016`, for some `C` which can be chosen to be\npositive.", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry0", "description": " Associating to an element `x` of a vector space `E\u2082` the continuous multilinear map in `0`\nvariables taking the (unique) value `x`", "p": "mathlib"}, {"name": "continuous_multilinear_map.op_norm_nonneg", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.curry_uncurry_left", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.continuous_restrict_scalars", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.mk_pi_field_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.has_sum_eval", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.uncurry_sum_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.mk_pi_field_eq_iff", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_right_equiv", "description": "The space of continuous multilinear maps on `\u03a0(i : fin (n+1)), Ei i` is canonically isomorphic to\nthe space of continuous multilinear maps on `\u03a0(i : fin n), Ei i.cast_succ` with values in the space\nof continuous linear maps on `Ei (last n)`, by separating the last variable. We register this\nisomorphism as a continuous linear equiv in `continuous_multilinear_curry_right_equiv \ud835\udd5c Ei G`.\nThe algebraic version (without topology) is given in `multilinear_curry_right_equiv \ud835\udd5c Ei G`.\n\nThe direct and inverse maps are given by `f.uncurry_right` and `f.curry_right`. Use these\nunless you need the full framework of linear isometric equivs.", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous_multilinear_norm_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.curry_sum", "description": " A continuous multilinear map with variables indexed by `\u03b9 \u2295 \u03b9'` defines a continuous multilinear\nmap with variables indexed by `\u03b9` taking values in the space of continuous multilinear maps with\nvariables indexed by `\u03b9'`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_pi", "description": "", "p": "mathlib"}, {"name": "multilinear_map.restr_norm_le", "description": " Given a multilinear map in `n` variables, if one restricts it to `k` variables putting `z` on\nthe other coordinates, then the resulting restricted function satisfies an inequality\n`\u2016f.restr v\u2016 \u2264 C * \u2016z\u2016^(n-k) * \u03a0 \u2016v i\u2016` if the original function satisfies `\u2016f v\u2016 \u2264 C * \u03a0 \u2016v i\u2016`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.op_norm_neg", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_fin1_symm_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.mk_pi_field_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.mk_pi_field_apply_one_eq_self", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.op_norm_le_bound", "description": "If one controls the norm of every `f x`, then one controls the norm of `f`.", "p": "mathlib"}, {"name": "continuous_multilinear_map.continuous_eval_left", "description": "", "p": "mathlib"}, {"name": "linear_isometry.norm_comp_continuous_multilinear_map", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.op_norm_add_le", "description": "The operator norm satisfies the triangle inequality.", "p": "mathlib"}, {"name": "continuous_multilinear_curry_fin0_symm_apply", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_mk_pi_algebra_fin_zero", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_curry_fin0", "description": " The continuous linear isomorphism between elements of a normed space, and continuous multilinear\nmaps in `0` variables with values in this normed space.\n\nThe direct and inverse maps are `uncurry0` and `curry0`. Use these unless you need the full\nframework of linear isometric equivs.", "p": "mathlib"}, {"name": "multilinear_map.mk_continuous_norm_le", "description": " If a continuous multilinear map is constructed from a multilinear map via the constructor\n`mk_continuous`, then its norm is bounded by the bound given to the constructor if it is\nnonnegative.", "p": "mathlib"}, {"name": "continuous_multilinear_map.nnnorm_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_of_subsingleton_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.nnnorm_of_subsingleton_le", "description": "", "p": "mathlib"}, {"name": "continuous_multilinear_map.norm_const_of_is_empty", "description": "", "p": "mathlib"}, {"name": "continuous_map.compact_convergence_filter_basis", "description": "A filter basis for the neighbourhood filter of a point in the compact-convergence topology.", "p": "mathlib"}, {"name": "continuous_map.has_basis_compact_convergence_uniformity_aux", "description": "", "p": "mathlib"}, {"name": "continuous_map.compact_convergence_uniformity", "description": "The filter on `C(\u03b1, \u03b2) \u00d7 C(\u03b1, \u03b2)` which underlies the uniform space structure on `C(\u03b1, \u03b2)`.", "p": "mathlib"}, {"name": "continuous_map.compact_conv_nhd_mono", "description": "", "p": "mathlib"}, {"name": "continuous_map.self_mem_compact_conv_nhd", "description": "", "p": "mathlib"}, {"name": "continuous_map.has_basis_compact_convergence_uniformity_of_compact", "description": "", "p": "mathlib"}, {"name": "continuous_map.tendsto_iff_tendsto_uniformly", "description": " Convergence in the compact-open topology is the same as uniform convergence for sequences of\ncontinuous functions on a compact space.", "p": "mathlib"}, {"name": "continuous_map.compact_conv_nhd_subset_inter", "description": "", "p": "mathlib"}, {"name": "continuous_map.Inter_compact_open_gen_subset_compact_conv_nhd", "description": " The point `f` in `compact_conv_nhd K V f` is also an interior point wrt the compact-open\ntopology.\n\nSince `compact_conv_nhd K V f` are a neighbourhood basis at `f` for each `f`, it follows that\nthe compact-open topology is at least as fine as the topology of compact convergence.", "p": "mathlib"}, {"name": "continuous_map.has_basis_compact_convergence_uniformity", "description": "", "p": "mathlib"}, {"name": "continuous_map.compact_conv_nhd_subset_compact_open", "description": " Any point of `compact_open.gen K U` is also an interior point wrt the topology of compact\nconvergence.\n\nThe topology of compact convergence is thus at least as fine as the compact-open topology.", "p": "mathlib"}, {"name": "continuous_map.tendsto_iff_tendsto_locally_uniformly", "description": " Convergence in the compact-open topology is the same as locally uniform convergence on a locally\ncompact space.\n\nFor non-T2 spaces, the assumption `locally_compact_space \u03b1` is stronger than we need and in fact\nthe `\u2190` direction is true unconditionally. See `tendsto_locally_uniformly_of_tendsto` and\n`tendsto_of_tendsto_locally_uniformly` for versions requiring weaker hypotheses.", "p": "mathlib"}, {"name": "continuous_map.mem_compact_convergence_entourage_iff", "description": "", "p": "mathlib"}, {"name": "continuous_map.compact_convergence_uniform_space", "description": "Note that we ensure the induced topology is definitionally the compact-open topology.", "p": "mathlib"}, {"name": "continuous_map.tendsto_iff_forall_compact_tendsto_uniformly_on", "description": "", "p": "mathlib"}, {"name": "continuous_map.compact_conv_nhd", "description": " Given `K \u2286 \u03b1`, `V \u2286 \u03b2 \u00d7 \u03b2`, and `f : C(\u03b1, \u03b2)`, we define `compact_conv_nhd K V f` to be the set\nof `g : C(\u03b1, \u03b2)` that are `V`-close to `f` on `K`.", "p": "mathlib"}, {"name": "continuous_map.compact_conv_nhd_mem_comp", "description": "", "p": "mathlib"}, {"name": "continuous_map.nhds_compact_convergence", "description": "", "p": "mathlib"}, {"name": "continuous_map.tendsto_iff_forall_compact_tendsto_uniformly_on'", "description": " This is an auxiliary lemma and is unlikely to be of direct use outside of this file. See\n`tendsto_iff_forall_compact_tendsto_uniformly_on` below for the useful version where the topology\nis picked up via typeclass inference.", "p": "mathlib"}, {"name": "continuous_map.mem_compact_convergence_uniformity", "description": "An intermediate lemma. Usually `mem_compact_convergence_entourage_iff` is more useful.", "p": "mathlib"}, {"name": "continuous_map.compact_conv_nhd_nhd_basis", "description": " A key property of `compact_conv_nhd`. It allows us to apply\n`topological_space.nhds_mk_of_nhds_filter_basis` below.", "p": "mathlib"}, {"name": "continuous_map.mem_compact_convergence_nhd_filter", "description": "", "p": "mathlib"}, {"name": "continuous_map.tendsto_of_tendsto_locally_uniformly", "description": "Locally uniform convergence implies convergence in the compact-open topology.", "p": "mathlib"}, {"name": "continuous_map.compact_conv_nhd_compact_entourage_nonempty", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.compact_convergence_uniformity", "description": "", "p": "mathlib"}, {"name": "continuous_map.tendsto_locally_uniformly_of_tendsto", "description": " If every point has a compact neighbourhood, then convergence in the compact-open topology\nimplies locally uniform convergence.\n\nSee also `tendsto_iff_tendsto_locally_uniformly`, especially for T2 spaces.", "p": "mathlib"}, {"name": "continuous_map.compact_conv_nhd_filter_is_basis", "description": "", "p": "mathlib"}, {"name": "continuous_map.has_basis_nhds_compact_convergence", "description": "", "p": "mathlib"}, {"name": "continuous_map.compact_open_eq_compact_convergence", "description": "The compact-open topology is equal to the compact-convergence topology.", "p": "mathlib"}, {"name": "continuous_map.compact_convergence_topology", "description": " The compact-convergence topology. In fact, see `compact_open_eq_compact_convergence` this is\nthe same as the compact-open topology. This definition is thus an auxiliary convenience definition\nand is unlikely to be of direct use.", "p": "mathlib"}, {"name": "cstar_ring.norm_self_mul_star", "description": "", "p": "mathlib"}, {"name": "cstar_ring.to_normed_star_group", "description": "In a C*-ring, star preserves the norm.", "p": "mathlib"}, {"name": "coe_star\u2097\u1d62", "description": "", "p": "mathlib"}, {"name": "cstar_ring.norm_unitary_smul", "description": "", "p": "mathlib"}, {"name": "cstar_ring.norm_coe_unitary", "description": "", "p": "mathlib"}, {"name": "cstar_ring.norm_mem_unitary_mul", "description": "", "p": "mathlib"}, {"name": "star_subalgebra.to_cstar_ring", "description": "", "p": "mathlib"}, {"name": "cstar_ring.star_mul_self_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "cstar_ring.norm_coe_unitary_mul", "description": "", "p": "mathlib"}, {"name": "pi.cstar_ring", "description": "", "p": "mathlib"}, {"name": "cstar_ring.norm_of_mem_unitary", "description": "", "p": "mathlib"}, {"name": "normed_star_group", "description": "A normed star group is a normed group with a compatible `star` which is isometric.", "p": "mathlib"}, {"name": "normed_star_group.norm_star", "description": "A normed star group is a normed group with a compatible `star` which is isometric.", "p": "mathlib"}, {"name": "cstar_ring.norm_star_mul_self'", "description": "", "p": "mathlib"}, {"name": "cstar_ring.mul_star_self_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "star_isometry", "description": "The `star` map in a normed star group is an isometry", "p": "mathlib"}, {"name": "normed_star_group.to_has_continuous_star", "description": "", "p": "mathlib"}, {"name": "ring_hom_isometric.star_ring_end", "description": "", "p": "mathlib"}, {"name": "real.cstar_ring", "description": "", "p": "mathlib"}, {"name": "cstar_ring.nnnorm_self_mul_star", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint.nnnorm_pow_two_pow", "description": "", "p": "mathlib"}, {"name": "star_normed_add_group_hom", "description": "The `star` map in a normed star group is a normed group homomorphism.", "p": "mathlib"}, {"name": "cstar_ring.norm_mul_coe_unitary", "description": "", "p": "mathlib"}, {"name": "pi.cstar_ring'", "description": "", "p": "mathlib"}, {"name": "pi.star_ring'", "description": " This instance exists to short circuit type class resolution because of problems with\ninference involving \u03a0-types.", "p": "mathlib"}, {"name": "cstar_ring.norm_one", "description": "", "p": "mathlib"}, {"name": "cstar_ring.norm_mul_mem_unitary", "description": "", "p": "mathlib"}, {"name": "star_subalgebra.to_normed_algebra", "description": "", "p": "mathlib"}, {"name": "cstar_ring.nnnorm_star_mul_self", "description": "", "p": "mathlib"}, {"name": "star\u2097\u1d62_apply", "description": "", "p": "mathlib"}, {"name": "self_adjoint.nnnorm_pow_two_pow", "description": "", "p": "mathlib"}, {"name": "prod.cstar_ring", "description": "", "p": "mathlib"}, {"name": "cstar_ring.star_mul_self_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "cstar_ring", "description": " A C*-ring is a normed star ring that satifies the stronger condition `\u2016x\u22c6 * x\u2016 = \u2016x\u2016^2`\nfor every `x`.", "p": "mathlib"}, {"name": "cstar_ring.norm_star_mul_self", "description": " A C*-ring is a normed star ring that satifies the stronger condition `\u2016x\u22c6 * x\u2016 = \u2016x\u2016^2`\nfor every `x`.", "p": "mathlib"}, {"name": "cstar_ring.mul_star_self_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "star\u2097\u1d62_to_continuous_linear_equiv", "description": "", "p": "mathlib"}, {"name": "cstar_ring.norm_one_class", "description": "", "p": "mathlib"}, {"name": "nnnorm_star", "description": "", "p": "mathlib"}, {"name": "star\u2097\u1d62", "description": "`star` bundled as a linear isometric equivalence", "p": "mathlib"}, {"name": "equiv.finite_iff", "description": "", "p": "mathlib"}, {"name": "equiv.infinite_iff", "description": "", "p": "mathlib"}, {"name": "finite_iff_exists_equiv_fin", "description": "", "p": "mathlib"}, {"name": "finite.of_equiv", "description": "", "p": "mathlib"}, {"name": "function.bijective.finite_iff", "description": "", "p": "mathlib"}, {"name": "finite.exists_equiv_fin", "description": "", "p": "mathlib"}, {"name": "finite", "description": " A type is `finite` if it is in bijective correspondence to some\n`fin n`.\n\nWhile this could be defined as `nonempty (fintype \u03b1)`, it is defined\nin this way to allow there to be `finite` instances for propositions.", "p": "mathlib"}, {"name": "finite.intro", "description": " A type is `finite` if it is in bijective correspondence to some\n`fin n`.\n\nWhile this could be defined as `nonempty (fintype \u03b1)`, it is defined\nin this way to allow there to be `finite` instances for propositions.", "p": "mathlib"}, {"name": "finite.of_not_infinite", "description": "**Alias** of the forward direction of `not_infinite_iff_finite`.", "p": "mathlib"}, {"name": "not_finite_iff_infinite", "description": "", "p": "mathlib"}, {"name": "plift.finite", "description": "", "p": "mathlib"}, {"name": "not_finite", "description": "", "p": "mathlib"}, {"name": "finite.not_infinite", "description": "**Alias** of the reverse direction of `not_infinite_iff_finite`.", "p": "mathlib"}, {"name": "plift.infinite", "description": "", "p": "mathlib"}, {"name": "finite_or_infinite", "description": "", "p": "mathlib"}, {"name": "infinite.false", "description": "", "p": "mathlib"}, {"name": "infinite", "description": " A type is said to be infinite if it is not finite. Note that `infinite \u03b1` is equivalent to\n`is_empty (fintype \u03b1)` or `is_empty (finite \u03b1)`.", "p": "mathlib"}, {"name": "infinite.not_finite", "description": " A type is said to be infinite if it is not finite. Note that `infinite \u03b1` is equivalent to\n`is_empty (fintype \u03b1)` or `is_empty (finite \u03b1)`.", "p": "mathlib"}, {"name": "ulift.infinite", "description": "", "p": "mathlib"}, {"name": "finite.of_bijective", "description": "", "p": "mathlib"}, {"name": "ulift.finite", "description": "", "p": "mathlib"}, {"name": "finite.false", "description": "", "p": "mathlib"}, {"name": "not_infinite_iff_finite", "description": "", "p": "mathlib"}, {"name": "is_dedekind_domain.is_principal_ideal_ring_localization_over_prime", "description": " Let `p` be a prime in the Dedekind domain `R` and `S` be an integral extension of `R`,\nthen the localization `S\u209a` of `S` at `p` is a PID.", "p": "mathlib"}, {"name": "ideal.is_principal.of_finite_maximals_of_is_unit", "description": " An invertible ideal in a commutative ring with finitely many maximal ideals is principal.\n\nhttps://math.stackexchange.com/a/95857", "p": "mathlib"}, {"name": "is_localization.over_prime.mem_normalized_factors_of_is_prime", "description": " If `p` is a prime in the Dedekind domain `R`, `S` an extension of `R` and `S\u209a` the localization\nof `S` at `p`, then all primes in `S\u209a` are factors of the image of `p` in `S\u209a`.", "p": "mathlib"}, {"name": "fractional_ideal.is_principal_of_unit_of_comap_mul_span_singleton_eq_top", "description": "", "p": "mathlib"}, {"name": "is_principal_ideal_ring.of_finite_primes", "description": "A Dedekind domain is a PID if its set of primes is finite.", "p": "mathlib"}, {"name": "ideal.eq_span_singleton_of_mem_of_not_mem_sq_of_not_mem_prime_ne", "description": " Let `P` be a prime ideal, `x \u2208 P \\ P\u00b2` and `x \u2209 Q` for all prime ideals `Q \u2260 P`.\nThen `P` is generated by `x`.", "p": "mathlib"}, {"name": "fractional_ideal.is_principal.of_finite_maximals_of_inv", "description": "An invertible fractional ideal of a commutative ring with finitely many maximal ideals is principal.\n\nhttps://math.stackexchange.com/a/95857", "p": "mathlib"}, {"name": "self_adjoint.coe_zpow", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint_smul_of_mem_skew_adjoint", "description": " Scalar multiplication of a skew-adjoint element by a skew-adjoint element produces a\nself-adjoint element.", "p": "mathlib"}, {"name": "is_self_adjoint.conjugate'", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint.inv", "description": "", "p": "mathlib"}, {"name": "self_adjoint.has_qsmul", "description": "", "p": "mathlib"}, {"name": "self_adjoint.nat.has_pow", "description": "", "p": "mathlib"}, {"name": "self_adjoint.has_nat_cast", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint.is_star_normal", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint_zero", "description": "", "p": "mathlib"}, {"name": "comm_monoid.is_star_normal", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint", "description": "An element is self-adjoint if it is equal to its star.", "p": "mathlib"}, {"name": "is_self_adjoint.star_eq", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint.neg", "description": "", "p": "mathlib"}, {"name": "self_adjoint.coe_rat_smul", "description": "", "p": "mathlib"}, {"name": "has_trivial_star.is_star_normal", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint.star_mul_self", "description": "", "p": "mathlib"}, {"name": "skew_adjoint.inhabited", "description": "", "p": "mathlib"}, {"name": "self_adjoint.coe_mul", "description": "", "p": "ma