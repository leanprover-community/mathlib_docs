iff", "description": "", "p": "mathlib"}, {"name": "ideal.rel_iso_of_surjective", "description": "Correspondence theorem", "p": "mathlib"}, {"name": "ideal.is_prime.multiset_prod_le", "description": "", "p": "mathlib"}, {"name": "submodule.annihilator_supr", "description": "", "p": "mathlib"}, {"name": "submodule.smul_bot", "description": "", "p": "mathlib"}, {"name": "ring_hom.ker", "description": "Kernel of a ring homomorphism as an ideal of the domain.", "p": "mathlib"}, {"name": "ring_hom.ker_ne_top", "description": "", "p": "mathlib"}, {"name": "ideal.map_is_prime_of_equiv", "description": "", "p": "mathlib"}, {"name": "ideal.radical_eq_iff", "description": "An ideal is radical iff it is equal to its radical.", "p": "mathlib"}, {"name": "ideal.comap_injective_of_surjective", "description": "", "p": "mathlib"}, {"name": "ideal.map_eq_submodule_map", "description": "", "p": "mathlib"}, {"name": "ideal.is_radical", "description": "An ideal is radical if it contains its radical.", "p": "mathlib"}, {"name": "ideal.map_id", "description": "", "p": "mathlib"}, {"name": "ideal.comap_ne_top", "description": "", "p": "mathlib"}, {"name": "submodule.smul_induction_on'", "description": "Dependent version of `submodule.smul_induction_on`.", "p": "mathlib"}, {"name": "ideal.radical_eq_Inf", "description": "", "p": "mathlib"}, {"name": "ideal.prod_eq_bot", "description": "A product of ideals in an integral domain is zero if and only if one of the terms is zero.", "p": "mathlib"}, {"name": "ideal.map_map", "description": "", "p": "mathlib"}, {"name": "ideal.is_prime.is_primary", "description": "", "p": "mathlib"}, {"name": "ideal.radical_mul", "description": "", "p": "mathlib"}, {"name": "ideal.comap_of_equiv", "description": "If `f : R \u2243+* S` is a ring isomorphism and `I : ideal R`, then `comap f.symm (comap f) = I`.", "p": "mathlib"}, {"name": "ideal.span_mul_span", "description": "", "p": "mathlib"}, {"name": "ideal.comap_comap", "description": "", "p": "mathlib"}, {"n