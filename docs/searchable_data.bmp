": "", "p": "mathlib"}, {"name": "measure_theory.snorm_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.mono'", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_congr_norm_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.of_measure_le_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_add_le'", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_trim", "description": "", "p": "mathlib"}, {"name": "measure_theory.zero_mem_\u2112p'", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.smul_of_top_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_map_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_mono_nnnorm", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p_norm_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.smul_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.ae_strongly_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_indicator_ge_of_bdd_below", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p_finset_sum'", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_smul_measure_of_ne_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_le_snorm_mul_snorm_of_nnnorm", "description": " H\u00f6lder's inequality, as an inequality on the `\u2112p` seminorm of an elementwise operation\n`\u03bb x, b (f x) (g x)`.", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_const_smul_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_bdd_liminf_at_top_of_snorm_bdd", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p_congr_norm", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_const'", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_const_lt_top_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p", "description": " The property that `f:\u03b1\u2192E` is ae strongly measurable and `(\u222b \u2016f a\u2016^p \u2202\u03bc)^(1/p)` is finite\nif `p < \u221e`, or `ess_sup f < \u221e` if `p = \u221e`.", "p": "mathlib"}, {"name": "measure_theory.snorm'_add_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.smul_of_top_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_measure_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_mono_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_mono_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_measure_zero_of_exponent_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_zero'", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.congr_norm", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_sum_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_const_smul_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_le_nnreal_smul_snorm_of_ae_le_mul", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_const", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_le_of_ae_bound", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_one_eq_lintegral_nnnorm", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.of_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_congr_nnnorm_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_measure_zero_of_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_le_snorm_top_mul_snorm", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_lt_top_of_ae_nnnorm_bound", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_zero_of_snorm'_eq_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_const_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p_finset_sum", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.restrict", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_le_add_measure_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_lt_top_of_ae_bound", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_congr_norm_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_mono_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.re", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_add_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_map_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.pow_mul_meas_ge_le_snorm", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p_neg_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_sub_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p_of_mem_\u2112p_trim", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_exponent_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp_add_const_of_one_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.const_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_trim", "description": "", "p": "mathlib"}, {"name": "measure_theory.coe_nnnorm_ae_le_snorm_ess_sup", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp_add_const", "description": " A constant for the inequality `\u2016f + g\u2016_{L^p} \u2264 C * (\u2016f\u2016_{L^p} + \u2016g\u2016_{L^p})`. It is equal to `1`\nfor `p \u2265 1` or `p = 0`, and `2^(1/p-1)` in the more tricky interval `(0, 1)`.", "p": "mathlib"}, {"name": "measure_theory.snorm'_const'", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_Lp_half", "description": " Technical lemma to control the addition of functions in `L^p` even for `p < 1`: Given `\u03b4 > 0`,\nthere exists `\u03b7` such that two functions bounded by `\u03b7` in `L^p` have a sum bounded by `\u03b4`. One\ncould take `\u03b7 = \u03b4 / 2` for `p \u2265 1`, but the point of the lemma is that it works also for `p < 1`.", "p": "mathlib"}, {"name": "measure_theory.snorm_norm_rpow", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_measure_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.norm", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_const_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_zero'", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_le_snorm_ess_sup", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_lt_top_iff_lintegral_rpow_nnnorm_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_le_nnreal_smul_snorm'_of_ae_le_mul", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_one_smul_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_norm", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_sum_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_const_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_ess_sup_mono_nnnorm_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.ae_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.sub", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.snorm_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.of_nnnorm_le_mul", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_smul_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_le_snorm'_mul_snorm'", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.mem_\u2112p_of_exponent_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.right_of_add_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_le_of_ae_nnnorm_bound", "description": "", "p": "mathlib"}, {"name": "measure_theory.mem_\u2112p.add", "description": "", "p": "mathlib"}, {"name": "measure_theory.Lp_add_const_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm'_mono_nnnorm_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.snorm_const", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.and_kind.has_reflect", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.has_lt.lt.decidable_rel", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.proof.to_format", "description": "Debugging printer for proof objects.", "p": "mathlib"}, {"name": "tactic.itauto.and_kind.cmp", "description": "A comparator for `and_kind`. (There should really be a derive handler for this.)", "p": "mathlib"}, {"name": "tactic.itauto.and_kind.sides", "description": "Given the contents of an `and` variant, return the two conjuncts.", "p": "mathlib"}, {"name": "tactic.itauto.prop.and", "description": "Constructor for `p \u2227 q`.", "p": "mathlib"}, {"name": "tactic.itauto.context.has_to_format", "description": "", "p": "mathlib"}, {"name": "tactic_doc.tactic.itauto", "description": " A decision procedure for intuitionistic propositional logic. Unlike `finish` and `tauto!` this\ntactic never uses the law of excluded middle (without the `!` option), and the proof search is\ntailored for this use case. (`itauto!` will work as a classical SAT solver, but the algorithm is\nnot very good in this situation.)\n\n```lean\nexample (p : Prop) : \u00ac (p \u2194 \u00ac p) := by itauto\n```\n\n`itauto [a, b]` will additionally attempt case analysis on `a` and `b` assuming that it can derive\n`decidable a` and `decidable b`. `itauto *` will case on all decidable propositions that it can\nfind among the atomic propositions, and `itauto! *` will case on all propositional atoms.\n*Warning:* This can blow up the proof search, so it should be used sparingly.", "p": "mathlib"}, {"name": "tactic.itauto.prop.decidable_eq", "description": "", "p": "mathlib"}, {"name": "tactic.itauto", "description": " A decision procedure for intuitionistic propositional logic.\n\n* `use_dec` will add `a \u2228 \u00ac a` to the context for every decidable atomic proposition `a`.\n* `use_classical` will allow `a \u2228 \u00ac a` to be added even if the proposition is not decidable,\n  using classical logic.\n* `extra_dec` will add `a \u2228 \u00ac a` to the context for specified (not necessarily atomic)\n  propositions `a`.", "p": "mathlib"}, {"name": "tactic.itauto.is_ok", "description": "Convert a value-with-success to an optional value.", "p": "mathlib"}, {"name": "tactic.itauto.search", "description": " The search phase, which deals with the level 3 rules, which are rules that are not validity\npreserving and so require proof search. One obvious one is the or-introduction rule: we prove\n`A \u2228 B` by proving `A` or `B`, and we might have to try one and backtrack.\n\nThere are two rules dealing with implication in this category: `p, p \u2192 C \u22a2 B` where `p` is an\natom (which is safe if we can find it but often requires the right search to expose the `p`\nassumption), and `(A\u2081 \u2192 A\u2082) \u2192 C \u22a2 B`. We decompose the double implication into two subgoals: one to\nprove `A\u2081 \u2192 A\u2082`, which can be written `A\u2082 \u2192 C, A\u2081 \u22a2 A\u2082` (where we used `A\u2081` to simplify\n`(A\u2081 \u2192 A\u2082) \u2192 C`), and one to use the consequent, `C \u22a2 B`. The search here is that there are\npotentially many implications to split like this, and we have to try all of them if we want to be\ncomplete.", "p": "mathlib"}, {"name": "tactic.itauto.when_ok", "description": "Skip the continuation and return a failed proof if the boolean is false.", "p": "mathlib"}, {"name": "tactic.itauto.reify", "description": " Reify an `expr` into a `prop`, allocating anything non-propositional as an atom in the\n`atoms` list.", "p": "mathlib"}, {"name": "tactic.itauto.proof.has_to_format", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.reify_atom", "description": " Reifies an atomic or otherwise unrecognized proposition. If it is defeq to a proposition we\nhave already allocated, we reuse it, otherwise we name it with a new index.", "p": "mathlib"}, {"name": "tactic.itauto.context", "description": "The context during proof search is a map from propositions to proof values.", "p": "mathlib"}, {"name": "tactic.itauto.prop", "description": "A reified inductive type for propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.prop.var", "description": "A reified inductive type for propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.prop.true", "description": "A reified inductive type for propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.prop.false", "description": "A reified inductive type for propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.prop.and'", "description": "A reified inductive type for propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.prop.or", "description": "A reified inductive type for propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.prop.imp", "description": "A reified inductive type for propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.exfalso", "description": "A variant on `proof.exfalso'` that performs opportunistic simplification.", "p": "mathlib"}, {"name": "tactic.itauto.prop.eq", "description": "Constructor for `p = q`.", "p": "mathlib"}, {"name": "tactic.itauto.map_proof", "description": "Map a function over the proof (regardless of whether the proof is successful or not).", "p": "mathlib"}, {"name": "tactic.itauto.proof.has_reflect", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.context.with_add", "description": " Add `A` to the context `\u0393` with proof `p`. This version of `context.add` takes a continuation\nand a target proposition `B`, so that in the case that `\u22a5` is found we can skip the continuation\nand just prove `B` outright.", "p": "mathlib"}, {"name": "tactic.itauto.prop.inhabited", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.proof.or_elim", "description": "A variant on `proof.or_elim` that performs opportunistic simplification.", "p": "mathlib"}, {"name": "tactic.itauto.prop.has_lt", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.context.add", "description": " Insert a proposition and its proof into the context, as in `have : A := p`. This will eagerly\napply all level 1 rules on the spot, which are rules that don't split the goal and are validity\npreserving: specifically, we drop `\u22a4` and `A \u2192 \u22a4` hypotheses, close the goal if we find a `\u22a5`\nhypothesis, split all conjunctions, and also simplify `\u22a5 \u2192 A` (drop), `\u22a4 \u2192 A` (simplify to `A`),\n`A \u2227 B \u2192 C` (curry to `A \u2192 B \u2192 C`) and `A \u2228 B \u2192 C` (rewrite to `(A \u2192 C) \u2227 (B \u2192 C)` and split).", "p": "mathlib"}, {"name": "tactic.itauto.apply_proof", "description": " Once we have a proof object, we have to apply it to the goal. (Some of these cases are a bit\nannoying because `applyc` gets the arguments wrong sometimes so we have to use `to_expr` instead.)", "p": "mathlib"}, {"name": "tactic.interactive.itauto", "description": " A decision procedure for intuitionistic propositional logic. Unlike `finish` and `tauto!` this\ntactic never uses the law of excluded middle (without the `!` option), and the proof search is\ntailored for this use case. (`itauto!` will work as a classical SAT solver, but the algorithm is\nnot very good in this situation.)\n\n```lean\nexample (p : Prop) : \u00ac (p \u2194 \u00ac p) := by itauto\n```\n\n`itauto [a, b]` will additionally attempt case analysis on `a` and `b` assuming that it can derive\n`decidable a` and `decidable b`. `itauto *` will case on all decidable propositions that it can\nfind among the atomic propositions, and `itauto! *` will case on all propositional atoms.\n*Warning:* This can blow up the proof search, so it should be used sparingly.", "p": "mathlib"}, {"name": "tactic.itauto.prove", "description": " The main prover. This receives a context of proven or assumed lemmas and a target proposition,\nand returns a proof or `none` (with state for the fresh variable generator).\nThe intuitionistic logic rules are separated into three groups:\n\n* level 1: No splitting, validity preserving: apply whenever you can.\n  Left rules in `context.add`, right rules in `prove`\n* level 2: Splitting rules, validity preserving: apply after level 1 rules. Done in `prove`\n* level 3: Splitting rules, not validity preserving: apply only if nothing else applies.\n  Done in `search`\n\nThe level 1 rules on the right of the turnstile are `\u0393 \u22a2 \u22a4` and `\u0393 \u22a2 A \u2192 B`, these are easy to\nhandle. The rule `\u0393 \u22a2 A \u2227 B` is a level 2 rule, also handled here. If none of these apply, we try\nthe level 2 rule `A \u2228 B \u22a2 C` by searching the context and splitting all ors we find. Finally, if\nwe don't make any more progress, we go to the search phase.", "p": "mathlib"}, {"name": "tactic.itauto.proof.app", "description": " A variant on `proof.app'` that performs opportunistic simplification.\n(This doesn't do full normalization because we don't want the proof size to blow up.)", "p": "mathlib"}, {"name": "tactic.itauto.prop.has_to_format", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.proof.inhabited", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.context.to_format", "description": "Debug printer for the context.", "p": "mathlib"}, {"name": "tactic.itauto.prop.cmp", "description": "A comparator for propositions. (There should really be a derive handler for this.)", "p": "mathlib"}, {"name": "tactic.itauto.prop.not", "description": "Constructor for `\u00ac p`.", "p": "mathlib"}, {"name": "tactic.itauto.prop.xor", "description": "Constructor for `xor p q`.", "p": "mathlib"}, {"name": "tactic.itauto.fresh_name", "description": "Get a new name in the pattern `h0, h1, h2, ...`", "p": "mathlib"}, {"name": "tactic.itauto.prop.iff", "description": "Constructor for `p \u2194 q`.", "p": "mathlib"}, {"name": "tactic.itauto.and_kind.decidable_eq", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.and_kind.inhabited", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.prop.has_reflect", "description": "", "p": "mathlib"}, {"name": "tactic.itauto.and_kind", "description": " Different propositional constructors that are variants of \"and\" for the purposes of the\ntheorem prover.", "p": "mathlib"}, {"name": "tactic.itauto.and_kind.and", "description": " Different propositional constructors that are variants of \"and\" for the purposes of the\ntheorem prover.", "p": "mathlib"}, {"name": "tactic.itauto.and_kind.iff", "description": " Different propositional constructors that are variants of \"and\" for the purposes of the\ntheorem prover.", "p": "mathlib"}, {"name": "tactic.itauto.and_kind.eq", "description": " Different propositional constructors that are variants of \"and\" for the purposes of the\ntheorem prover.", "p": "mathlib"}, {"name": "tactic.itauto.prop.to_format", "description": "Debugging printer for propositions.", "p": "mathlib"}, {"name": "tactic.itauto.proof", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.sorry", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.hyp", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.triv", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.exfalso'", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.intro", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.and_left", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.and_right", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.and_intro", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.curry", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.curry\u2082", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.app'", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.or_imp_left", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.or_imp_right", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.or_inl", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.or_inr", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.or_elim'", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.decidable_elim", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.em", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "tactic.itauto.proof.imp_imp_simp", "description": "A reified inductive proof type for intuitionistic propositional logic.", "p": "mathlib"}, {"name": "not_ring_char_dvd_of_invertible", "description": "", "p": "mathlib"}, {"name": "invertible_of_pos", "description": "", "p": "mathlib"}, {"name": "invertible_two", "description": "", "p": "mathlib"}, {"name": "invertible_of_ring_char_not_dvd", "description": " A natural number `t` is invertible in a field `K` if the charactistic of `K` does not divide\n`t`.", "p": "mathlib"}, {"name": "invertible_three", "description": "", "p": "mathlib"}, {"name": "invertible_of_char_p_not_dvd", "description": " A natural number `t` is invertible in a field `K` of charactistic `p` if `p` does not divide\n`t`.", "p": "mathlib"}, {"name": "invertible_succ", "description": "", "p": "mathlib"}, {"name": "SemiNormedGroup.concrete_category", "description": "", "p": "mathlib"}, {"name": "SemiNormedGroup.coe_id", "description": "", "p": "mathlib"}, {"name": "SemiNormedGroup.coe_of", "description": "", "p": "mathlib"}, {"name": "SemiNormedGroup\u2081.coe_id", "description": "", "p": "mathlib"}, {"name": "SemiNormedGroup.bundled_hom", "description": "", "p": "mathlib"}, {"name": "SemiNorme