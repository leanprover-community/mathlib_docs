}, {"name": "category_theory.symmetric_category.to_braided_category", "description": "A symmetric monoidal category is a braided monoidal category for which the braiding is symmetric.\n\nSee <https://stacks.math.columbia.edu/tag/0FFW>.", "p": "mathlib"}, {"name": "category_theory.symmetric_category.symmetry'", "description": "A symmetric monoidal category is a braided monoidal category for which the braiding is symmetric.\n\nSee <https://stacks.math.columbia.edu/tag/0FFW>.", "p": "mathlib"}, {"name": "category_theory.braided_functor.to_lax_braided_functor_to_lax_monoidal_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.tensor_\u03bc_natural", "description": "", "p": "mathlib"}, {"name": "category_theory.tensor_monoidal", "description": "The tensor product functor from `C \u00d7 C` to `C` as a monoidal functor.", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.mk_iso", "description": "Interpret a natural isomorphism of the underlyling lax monoidal functors as an\nisomorphism of the lax braided monoidal functors.", "p": "mathlib"}, {"name": "category_theory.symmetric_category.symmetry_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_category.braiding_naturality", "description": "", "p": "mathlib"}, {"name": "category_theory.braiding_left_unitor_aux\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.tensor_monoidal_to_lax_monoidal_functor_\u03b5", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_functor.comp", "description": "The composition of braided monoidal functors.", "p": "mathlib"}, {"name": "category_theory.braided_category_of_fully_faithful", "description": "Pull back a braiding along a fully faithful monoidal functor.", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.id_to_lax_monoidal_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.tensor_\u03bc_def\u2081", "description": "", "p": "mathlib"}, {"name": "category_theory.braiding_right_unitor_aux\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.tensor_associativity_aux", "description": "", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.comp_to_lax_monoidal_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.left_unitor_monoidal", "description": "", "p": "mathlib"}, {"name": "category_theory.tensor_\u03bc_def\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_functor.id", "description": "The identity braided monoidal functor.", "p": "mathlib"}, {"name": "category_theory.braided_functor.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.comp", "description": "The composition of lax braided monoidal functors.", "p": "mathlib"}, {"name": "category_theory.braided_category_of_faithful", "description": "Verifying the axioms for a braiding by checking that the candidate braiding is sent to a braiding\nby a faithful monoidal functor.", "p": "mathlib"}, {"name": "category_theory.braided_functor", "description": "A braided functor between braided monoidal categories is a monoidal functor\nwhich preserves the braiding.", "p": "mathlib"}, {"name": "category_theory.braided_functor.to_monoidal_functor", "description": "A braided functor between braided monoidal categories is a monoidal functor\nwhich preserves the braiding.", "p": "mathlib"}, {"name": "category_theory.braided_functor.braided'", "description": "A braided functor between braided monoidal categories is a monoidal functor\nwhich preserves the braiding.", "p": "mathlib"}, {"name": "category_theory.tensor_associativity", "description": "", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.braided", "description": "", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.comp_to_nat_trans", "description": "", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_functor.to_lax_braided_functor", "description": "Turn a braided functor into a lax braided functor.", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.category_lax_braided_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_category.hexagon_forward_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_functor.mk_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.braiding_right_unitor_aux\u2081", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_functor.comp_to_nat_trans", "description": "", "p": "mathlib"}, {"name": "category_theory.right_unitor_monoidal", "description": "", "p": "mathlib"}, {"name": "category_theory.associator_monoidal_aux", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_category.hexagon_forward", "description": "", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor", "description": "A lax braided functor between braided monoidal categories is a lax monoidal functor\nwhich preserves the braiding.", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.to_lax_monoidal_functor", "description": "A lax braided functor between braided monoidal categories is a lax monoidal functor\nwhich preserves the braiding.", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.braided'", "description": "A lax braided functor between braided monoidal categories is a lax monoidal functor\nwhich preserves the braiding.", "p": "mathlib"}, {"name": "category_theory.braided_functor.mk_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.tensor_monoidal_to_lax_monoidal_functor_to_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_category", "description": "A braided monoidal category is a monoidal category equipped with a braiding isomorphism\n`\u03b2_ X Y : X \u2297 Y \u2245 Y \u2297 X`\nwhich is natural in both arguments,\nand also satisfies the two hexagon identities.", "p": "mathlib"}, {"name": "category_theory.braided_category.braiding", "description": "A braided monoidal category is a monoidal category equipped with a braiding isomorphism\n`\u03b2_ X Y : X \u2297 Y \u2245 Y \u2297 X`\nwhich is natural in both arguments,\nand also satisfies the two hexagon identities.", "p": "mathlib"}, {"name": "category_theory.braided_category.braiding_naturality'", "description": "A braided monoidal category is a monoidal category equipped with a braiding isomorphism\n`\u03b2_ X Y : X \u2297 Y \u2245 Y \u2297 X`\nwhich is natural in both arguments,\nand also satisfies the two hexagon identities.", "p": "mathlib"}, {"name": "category_theory.braided_category.hexagon_forward'", "description": "A braided monoidal category is a monoidal category equipped with a braiding isomorphism\n`\u03b2_ X Y : X \u2297 Y \u2245 Y \u2297 X`\nwhich is natural in both arguments,\nand also satisfies the two hexagon identities.", "p": "mathlib"}, {"name": "category_theory.braided_category.hexagon_reverse'", "description": "A braided monoidal category is a monoidal category equipped with a braiding isomorphism\n`\u03b2_ X Y : X \u2297 Y \u2245 Y \u2297 X`\nwhich is natural in both arguments,\nand also satisfies the two hexagon identities.", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.id", "description": "The identity lax braided monoidal functor.", "p": "mathlib"}, {"name": "category_theory.braided_functor.id_to_monoidal_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.tensor_right_unitality", "description": "", "p": "mathlib"}, {"name": "category_theory.braided_functor.mk_iso", "description": "Interpret a natural isomorphism of the underlyling monoidal functors as an\nisomorphism of the braided monoidal functors.", "p": "mathlib"}, {"name": "category_theory.braided_functor.braided", "description": "", "p": "mathlib"}, {"name": "category_theory.associator_monoidal", "description": "", "p": "mathlib"}, {"name": "category_theory.lax_braided_functor.mk_iso_hom", "description": "", "p": "mathlib"}, {"name": "algebra.adjoin.power_basis'_dim", "description": "", "p": "mathlib"}, {"name": "minpoly.equiv_adjoin_symm_apply", "description": "", "p": "mathlib"}, {"name": "minpoly.is_integrally_closed_dvd_iff", "description": "", "p": "mathlib"}, {"name": "minpoly.ker_eval", "description": "", "p": "mathlib"}, {"name": "algebra.adjoin.power_basis'_gen", "description": "", "p": "mathlib"}, {"name": "minpoly.to_adjoin.injective", "description": "", "p": "mathlib"}, {"name": "power_basis.of_gen_mem_adjoin'_gen", "description": "", "p": "mathlib"}, {"name": "minpoly.equiv_adjoin", "description": "The algebra isomorphism `adjoin_root (minpoly R x) \u2243\u2090[R] adjoin R x`", "p": "mathlib"}, {"name": "minpoly.equiv_adjoin_apply", "description": "", "p": "mathlib"}, {"name": "minpoly.is_integrally_closed_eq_field_fractions'", "description": " For integrally closed domains, the minimal polynomial over the ring is the same as the minimal\npolynomial over the fraction field. Compared to `minpoly.is_integrally_closed_eq_field_fractions`,\nthis version is useful if the element is in a ring that is already a `K`-algebra.", "p": "mathlib"}, {"name": "minpoly.is_integrally_closed.minpoly.unique", "description": " The minimal polynomial of an element `x` is uniquely characterized by its defining property:\nif there is another monic polynomial of minimal degree that has `x` as a root, then this polynomial\nis equal to the minimal polynomial of `x`. See also `minpoly.unique` which relaxes the\nassumptions on `S` in exchange for stronger assumptions on `R`.", "p": "mathlib"}, {"name": "algebra.adjoin.power_basis'", "description": " The `power_basis` of `adjoin R {x}` given by `x`. See `algebra.adjoin.power_basis` for a version\nover a field.", "p": "mathlib"}, {"name": "minpoly.is_integrally_closed_dvd", "description": "For integrally closed rings, the minimal polynomial divides any polynomial that has the\n integral element as root. See also `minpoly.dvd` which relaxes the assumptions on `S`\n in exchange for stronger assumptions on `R`.", "p": "mathlib"}, {"name": "minpoly.is_integrally_closed_eq_field_fractions", "description": " For integrally closed domains, the minimal polynomial over the ring is the same as the minimal\npolynomial over the fraction field. See `minpoly.is_integrally_closed_eq_field_fractions'` if\n`S` is already a `K`-algebra.", "p": "mathlib"}, {"name": "minpoly.is_integrally_closed.degree_le_of_ne_zero", "description": " If an element `x` is a root of a nonzero polynomial `p`, then the degree of `p` is at least the\ndegree of the minimal polynomial of `x`. See also `minpoly.degree_le_of_ne_zero` which relaxes the\nassumptions on `S` in exchange for stronger assumptions on `R`.", "p": "mathlib"}, {"name": "power_basis.of_gen_mem_adjoin'", "description": "The power basis given by `x` if `B.gen \u2208 adjoin R {x}`.", "p": "mathlib"}, {"name": "minpoly.prime_of_is_integrally_closed", "description": "", "p": "mathlib"}, {"name": "power_basis.of_gen_mem_adjoin'_dim", "description": "", "p": "mathlib"}, {"name": "alg_equiv.smul_def", "description": "", "p": "mathlib"}, {"name": "alg_equiv.to_add_equiv", "description": "", "p": "mathlib"}, {"name": "alg_equiv.of_alg_hom_coe_alg_hom", "description": "", "p": "mathlib"}, {"name": "alg_equiv.coe_alg_hom_of_alg_hom", "description": "", "p": "mathlib"}, {"name": "alg_equiv.aut_one", "description": "", "p": "mathlib"}, {"name": "mul_semiring_action.to_alg_equiv", "description": " Each element of the group defines a algebra equivalence.\n\nThis is a stronger version of `mul_semiring_action.to_ring_equiv` and\n`distrib_mul_action.to_linear_equiv`.", "p": "mathlib"}, {"name": "alg_equiv.to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "alg_equiv.arrow_congr_trans", "description": "", "p": "mathlib"}, {"name": "alg_equiv.map_finsupp_sum", "description": "", "p": "mathlib"}, {"name": "