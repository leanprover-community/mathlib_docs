ame": "model_with_corners.mdifferentiable_on_symm", "description": "", "p": "mathlib"}, {"name": "const_smul_mfderiv", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at.has_fderiv_at", "description": "**Alias** of the forward direction of `has_mfderiv_at_iff_has_fderiv_at`.", "p": "mathlib"}, {"name": "mdifferentiable.neg", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_within_at_iff", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at.continuous_within_at", "description": "", "p": "mathlib"}, {"name": "unique_diff_within_at.unique_mdiff_within_at", "description": "**Alias** of the reverse direction of `unique_mdiff_within_at_iff_unique_diff_within_at`.", "p": "mathlib"}, {"name": "mdifferentiable_within_at_inter", "description": "", "p": "mathlib"}, {"name": "differentiable_within_at.mdifferentiable_within_at", "description": "**Alias** of the reverse direction of `mdifferentiable_within_at_iff_differentiable_within_at`.", "p": "mathlib"}, {"name": "mdifferentiable_within_at.congr_mono", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at_const", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at_iff_of_mem_source", "description": " One can reformulate differentiability within a set at a point as continuity within this set at\nthis point, and differentiability in any chart containing that point.", "p": "mathlib"}, {"name": "continuous_linear_map.mfderiv_within_eq", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_on", "description": "Predicate ensuring that, at all points of a set, a function can have at most one derivative.", "p": "mathlib"}, {"name": "mdifferentiable_on.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at.mfderiv_within_congr_mono", "description": "", "p": "mathlib"}, {"name": "mfderiv", "description": " Let `f` be a function between two smooth manifolds. Then `mfderiv I I' f x` is the derivative of\n`f` at `x`, as a continuous linear map from the tangent space at `x` to the tangent space at\n`f x`.", "p": "mathlib"}, {"name": "mdifferentiable_at_iff_differentiable_at", "description": "For maps between vector spaces, `mdifferentiable_at` and `differentiable_at` coincide", "p": "mathlib"}, {"name": "mdifferentiable_within_at_snd", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_within_at.inter", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.mfderiv_eq", "description": "", "p": "mathlib"}, {"name": "model_with_corners.mdifferentiable_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.has_mfderiv_at", "description": "", "p": "mathlib"}, {"name": "mfderiv_within_univ", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.mdifferentiable_at", "description": "", "p": "mathlib"}, {"name": "model_with_corners.has_mfderiv_within_at_symm", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.mul", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.has_mfderiv_within_at", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.mfderiv", "description": " The derivative of a differentiable local homeomorphism, as a continuous linear equivalence\nbetween the tangent spaces at `x` and `e x`.", "p": "mathlib"}, {"name": "mdifferentiable_within_at.congr", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at_id", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.mul", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_const", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_within_at.eq", "description": "`unique_mdiff_within_at` achieves its goal: it implies the uniqueness of the derivative.", "p": "mathlib"}, {"name": "mdifferentiable_on.continuous_on", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.congr_mono", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.mdifferentiable_within_at", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.continuous_within_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at_id", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.mdifferentiable_within_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.sub", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_on.eq", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.has_mfderiv_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on.comp", "description": "", "p": "mathlib"}, {"name": "tangent_map_within_subset", "description": "", "p": "mathlib"}, {"name": "mfderiv_sub", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at_neg", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at.comp", "description": "", "p": "mathlib"}, {"name": "mfderiv_const", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on_atlas_symm", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.mdifferentiable_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.differentiable_at", "description": "**Alias** of the forward direction of `mdifferentiable_at_iff_differentiable_at`.", "p": "mathlib"}, {"name": "mdifferentiable_on_const", "description": "", "p": "mathlib"}, {"name": "tangent_map_within_congr", "description": "", "p": "mathlib"}, {"name": "tangent_map_within_proj", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at.sub", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at.mdifferentiable_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at_atlas", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at", "description": " `mdifferentiable_at I I' f x` indicates that the function `f` between manifolds\nhas a derivative at the point `x`.\nThis is a generalization of `differentiable_at` to manifolds.\n\nWe require continuity in the definition, as otherwise points close to `x` could be sent by\n`f` outside of the chart domain around `f x`. Then the chart could do anything to the image points,\nand in particular by coincidence `written_in_ext_chart_at I I' x f` could be differentiable, while\nthis would not mean anything relevant.", "p": "mathlib"}, {"name": "tangent_map_chart", "description": " The derivative of the chart at a base point is the chart of the tangent bundle, composed with\nthe identification between the tangent bundle of the model space and the product space.", "p": "mathlib"}, {"name": "mdifferentiable_within_at.prod_mk", "description": "", "p": "mathlib"}, {"name": "mfderiv_fst", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.congr_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at.has_mfderiv_within_at", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at", "description": " `has_mfderiv_within_at I I' f s x f'` indicates that the function `f` between manifolds\nhas, at the point `x` and within the set `s`, the derivative `f'`. Here, `f'` is a continuous linear\nmap from the tangent space at `x` to the tangent space at `f x`.\n\nThis is a generalization of `has_fderiv_within_at` to manifolds (as indicated by the prefix `m`).\nThe order of arguments is changed as the type of the derivative `f'` depends on the choice of `x`.\n\nWe require continuity in the definition, as otherwise points close to `x` in `s` could be sent by\n`f` outside of the chart domain around `f x`. Then the chart could do anything to the image points,\nand in particular by coincidence `written_in_ext_chart_at I I' x f` could be differentiable, while\nthis would not mean anything relevant.", "p": "mathlib"}, {"name": "has_mfderiv_at.comp", "description": "The chain rule.", "p": "mathlib"}, {"name": "tangent_map_within_eq_tangent_map", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.add", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at_snd", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at.mdifferentiable_at", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_on.unique_mdiff_on_preimage", "description": " If a set has the unique differential property, then its image under a local\ndiffeomorphism also has the unique differential property.", "p": "mathlib"}, {"name": "has_mfderiv_at.congr_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable", "description": "Prop registering if a local homeomorphism is a local diffeomorphism on its source", "p": "mathlib"}, {"name": "continuous_linear_map.has_mfderiv_within_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.prod_mk", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on.prod_mk", "description": "", "p": "mathlib"}, {"name": "model_with_corners.mdifferentiable_within_at", "description": "", "p": "mathlib"}, {"name": "tangent_map_within_comp_at", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_on_iff_unique_diff_on", "description": "", "p": "mathlib"}, {"name": "tangent_map_comp_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at_const", "description": "", "p": "mathlib"}, {"name": "unique_diff_on.unique_mdiff_on", "description": "**Alias** of the reverse direction of `unique_mdiff_on_iff_unique_diff_on`.", "p": "mathlib"}, {"name": "tangent_map_prod_snd", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.mdifferentiable_on", "description": "", "p": "mathlib"}, {"name": "tangent_map_proj", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_id", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.mfderiv_within_eq", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_within_at.unique_diff_within_at", "description": "**Alias** of the forward direction of `unique_mdiff_within_at_iff_unique_diff_within_at`.", "p": "mathlib"}, {"name": "mdifferentiable_at.sub", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at_const", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.mdifferentiable_at_symm", "description": "", "p": "mathlib"}, {"name": "mfderiv_comp_of_eq", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_on.unique_diff_on_inter_preimage", "description": " When considering functions between manifolds, this statement shows up often. It entails\nthe unique differential of the pullback in extended charts of the set where the function can\nbe read in the charts.", "p": "mathlib"}, {"name": "mfderiv_within_eq_fderiv_within", "description": "For maps between vector spaces, `mfderiv_within` and `fderiv_within` coincide", "p": "mathlib"}, {"name": "mfderiv_add", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.union", "description": "", "p": "mathlib"}, {"name": "tangent_map", "description": "The derivative, as a map between the tangent bundles", "p": "mathlib"}, {"name": "mdifferentiable_iff_differentiable", "description": "For maps between vector spaces, `mdifferentiable` and `differentiable` coincide", "p": "mathlib"}, {"name": "mfderiv_within_inter", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.add", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on_univ", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at_iff_has_fderiv_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at_iff_lift_prop_within_at", "description": "", "p": "mathlib"}, {"name": "tangent_map_within_id", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on_id", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at.has_mfderiv_within_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at.differentiable_within_at", "description": "**Alias** of the forward direction of `mdifferentiable_within_at_iff_differentiable_within_at`.", "p": "mathlib"}, {"name": "unique_mdiff_on.unique_diff_on_target_inter", "description": " If a set in a manifold has the unique derivative property, then its pullback by any extended\nchart, in the vector space, also has the unique derivative property.", "p": "mathlib"}, {"name": "filter.eventually_eq.mfderiv_within_eq", "description": "", "p": "mathlib"}, {"name": "mfderiv_within_comp", "description": "", "p": "mathlib"}, {"name": "tangent_map_comp", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.ker_mfderiv_eq_bot", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on_atlas", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_on.inter", "description": "", "p": "mathlib"}, {"name": "mfderiv_neg", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on_ext_chart_at", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.mdifferentiable_within_at", "description": "", "p": "mathlib"}, {"name": "differentiable_within_at_local_invariant_prop", "description": " Being differentiable in the model space is a local property, invariant under smooth maps.\nTherefore, it will lift nicely to manifolds.", "p": "mathlib"}, {"name": "has_mfderiv_at.neg", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at_inter'", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at_inter", "description": "", "p": "mathlib"}, {"name": "mfderiv_id", "description": "", "p": "mathlib"}, {"name": "written_in_ext_chart_model_space", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.range_mfderiv_eq_top", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on", "description": " `mdifferentiable_on I I' f s` indicates that the function `f` between manifolds\nhas a derivative within `s` at all points of `s`.\nThis is a generalization of `differentiable_on` to manifolds.", "p": "mathlib"}, {"name": "has_mfderiv_within_at_univ", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.nhds_within", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at_fst", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on.mono", "description": "", "p": "mathlib"}, {"name": "tangent_map_within_univ", "description": "", "p": "mathlib"}, {"name": "mfderiv_within_zero_of_not_mdifferentiable_within_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at_iff_of_mem_source", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at_iff_lift_prop_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.mul", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.comp_symm_deriv", "description": "", "p": "mathlib"}, {"name": "model_with_corners.has_mfderiv_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on_snd", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at_atlas_symm", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.const_smul", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on.differentiable_on", "description": "**Alias** of the forward direction of `mdifferentiable_on_iff_differentiable_on`.", "p": "mathlib"}, {"name": "mdifferentiable", "description": " `mdifferentiable I I' f` indicates that the function `f` between manifolds\nhas a derivative everywhere.\nThis is a generalization of `differentiable` to manifolds.", "p": "mathlib"}, {"name": "tangent_map_chart_symm", "description": " The derivative of the inverse of the chart at a base point is the inverse of the chart of the\ntangent bundle, composed with the identification between the tangent bundle of the model space and\nthe product space.", "p": "mathlib"}, {"name": "mdifferentiable_at_ext_chart_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.differentiable", "description": "**Alias** of the forward direction of `mdifferentiable_iff_differentiable`.", "p": "mathlib"}, {"name": "unique_mdiff_within_at", "description": " Predicate ensuring that, at a point and within a set, a function can have at most one\nderivative. This is expressed using the preferred chart at the considered point.", "p": "mathlib"}, {"name": "tangent_map_within_prod_snd", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at_fst", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "mfderiv_prod_right", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.continuous_at", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.mfderiv_surjective", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at.mul'", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at_id", "description": "", "p": "mathlib"}, {"name": "differentiable_on.mdifferentiable_on", "description": "**Alias** of the reverse direction of `mdifferentiable_on_iff_differentiable_on`.", "p": "mathlib"}, {"name": "has_mfderiv_within_at.has_mfderiv_at", "description": "", "p": "mathlib"}, {"name": "written_in_ext_chart_comp", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_on.tangent_bundle_proj_preimage", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at", "description": " `has_mfderiv_at I I' f x f'` indicates that the function `f` between manifolds\nhas, at the point `x`, the derivative `f'`. Here, `f'` is a continuous linear\nmap from the tangent space at `x` to the tangent space at `f x`.\n\nWe require continuity in the definition, as otherwise points close to `x` `s` could be sent by\n`f` outside of the chart domain around `f x`. Then the chart could do anything to the image points,\nand in particular by coincidence `written_in_ext_chart_at I I' x f` could be differentiable, while\nthis would not mean anything relevant.", "p": "mathlib"}, {"name": "mdifferentiable_within_at_iff", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.mdifferentiable_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_of_mem_atlas", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at.const_smul", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.mdifferentiable", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at.congr_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_on_univ", "description": "", "p": "mathlib"}, {"name": "differentiable.mdifferentiable", "description": "**Alias** of the reverse direction of `mdifferentiable_iff_differentiable`.", "p": "mathlib"}, {"name": "differentiable_within_at_prop", "description": " Property in the model space of a model with corners of being differentiable within at set at a\npoint, when read in the model vector space. This property will be lifted to manifolds to define\ndifferentiable functions between manifolds.", "p": "mathlib"}, {"name": "mdifferentiable_within_at_iff_differentiable_within_at", "description": " For maps between vector spaces, `mdifferentiable_within_at` and `fdifferentiable_within_at`\ncoincide", "p": "mathlib"}, {"name": "mfderiv_zero_of_not_mdifferentiable_at", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on_iff_differentiable_on", "description": "For maps between vector spaces, `mdifferentiable_on` and `differentiable_on` coincide", "p": "mathlib"}, {"name": "mdifferentiable_on.mul", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on.congr_mono", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.symm", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at.add", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.mono", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_chart", "description": "", "p": "mathlib"}, {"name": "model_with_corners.has_mfderiv_within_at", "description": "", "p": "mathlib"}, {"name": "mfderiv_within", "description": " Let `f` be a function between two smooth manifolds. Then `mfderiv_within I I' f s x` is the\nderivative of `f` at `x` within `s`, as a continuous linear map from the tangent space at `x` to the\ntangent space at `f x`.", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.mfderiv_bijective", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at_ext_chart_at", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.comp", "description": "", "p": "mathlib"}, {"name": "mfderiv_congr", "description": " A congruence lemma for `mfderiv`, (ab)using the fact that `tangent_space I' (f x)` is\ndefinitionally equal to `E'`.", "p": "mathlib"}, {"name": "unique_mdiff_within_at.inter'", "description": "", "p": "mathlib"}, {"name": "mfderiv_within_fst", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.const_smul", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.prod_mk", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.mdifferentiable_within_at", "description": "", "p": "mathlib"}, {"name": "mfderiv_within_snd", "description": "", "p": "mathlib"}, {"name": "has_fderiv_within_at.has_mfderiv_within_at", "description": "**Alias** of the reverse direction of `has_mfderiv_within_at_iff_has_fderiv_within_at`.", "p": "mathlib"}, {"name": "has_mfderiv_at.comp_has_mfderiv_within_at", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.trans", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at_iff_has_fderiv_within_at", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at_snd", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.mfderiv_within", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.mdifferentiable_on", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at.mfderiv_within", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at_neg", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at.mul", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at", "description": " `mdifferentiable_within_at I I' f s x` indicates that the function `f` between manifolds\nhas a derivative at the point `x` within the set `s`.\nThis is a generalization of `differentiable_within_at` to manifolds.\n\nWe require continuity in the definition, as otherwise points close to `x` in `s` could be sent by\n`f` outside of the chart domain around `f x`. Then the chart could do anything to the image points,\nand in particular by coincidence `written_in_ext_chart_at I I' x f` could be differentiable, while\nthis would not mean anything relevant.", "p": "mathlib"}, {"name": "mdifferentiable_within_at.mono", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.mdifferentiable.symm_comp_deriv", "description": "", "p": "mathlib"}, {"name": "tangent_map_id", "description": "", "p": "mathlib"}, {"name": "model_with_corners.mdifferentiable", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on_fst", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at.continuous_at", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.has_mfderiv_at", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at_unique", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at_inter'", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.comp", "description": "", "p": "mathlib"}, {"name": "mfderiv_congr_point", "description": " A congruence lemma for `mfderiv`, (ab)using the fact that `tangent_space I' (f x)` is\ndefinitionally equal to `E'`.", "p": "mathlib"}, {"name": "model_with_corners.mdifferentiable_on", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.comp", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_snd", "description": "", "p": "mathlib"}, {"name": "mfderiv_prod_left", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_on.unique_diff_on", "description": "**Alias** of the forward direction of `unique_mdiff_on_iff_unique_diff_on`.", "p": "mathlib"}, {"name": "unique_mdiff_on.smooth_bundle_preimage", "description": " In a smooth fiber bundle, the preimage under the projection of a set with\nunique differential in the basis also has unique differential.", "p": "mathlib"}, {"name": "mdifferentiable_within_at_const", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_on_of_locally_mdifferentiable_on", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at_id", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_within_at_univ", "description": "", "p": "mathlib"}, {"name": "tangent_map_prod_fst", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.congr_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_within_at_iff_unique_diff_within_at", "description": "", "p": "mathlib"}, {"name": "mfderiv_within_congr", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_within_at.mul'", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_within_at_fst", "description": "", "p": "mathlib"}, {"name": "mdifferentiable.continuous", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.mfderiv_eq", "description": "", "p": "mathlib"}, {"name": "mfderiv_within_id", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_fst", "description": "", "p": "mathlib"}, {"name": "differentiable_at.mdifferentiable_at", "description": "**Alias** of the reverse direction of `mdifferentiable_at_iff_differentiable_at`.", "p": "mathlib"}, {"name": "tangent_map_within", "description": "The derivative within a set, as a map between the tangent bundles", "p": "mathlib"}, {"name": "mdifferentiable_within_at.mul", "description": "", "p": "mathlib"}, {"name": "mdifferentiable_at.mfderiv", "description": "", "p": "mathlib"}, {"name": "unique_mdiff_within_at.mono", "description": "", "p": "mathlib"}, {"name": "has_mfderiv_at_ext_chart_at", "description": "", "p": "mathlib"}, {"name": "mfderiv_eq_fderiv", "description