_mod", "description": "", "p": "mathlib"}, {"name": "nat.modeq.decidable", "description": "", "p": "mathlib"}, {"name": "nat.modeq.comm", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.add_comm_group", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_zsmul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.inhabited", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.has_nsmul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.has_add", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.has_neg", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.has_smul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_nsmul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.mdifferentiable", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.mdifferentiable_at", "description": "", "p": "mathlib"}, {"name": "smooth_section", "description": "Bundled smooth sections of a vector bundle.", "p": "mathlib"}, {"name": "cont_mdiff_section.mdifferentiable'", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_fn_mk", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.cont_mdiff", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_zero", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_injective", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.has_zero", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_sub", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.smooth", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_add_hom", "description": "The additive morphism from smooth sections to dependent maps.", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_add", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_smul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.has_sub", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.has_zsmul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_inj", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section", "description": "Bundled `n` times continuously differentiable sections of a vector bundle.", "p": "mathlib"}, {"name": "cont_mdiff_section.to_fun", "description": "Bundled `n` times continuously differentiable sections of a vector bundle.", "p": "mathlib"}, {"name": "cont_mdiff_section.cont_mdiff_to_fun", "description": "Bundled `n` times continuously differentiable sections of a vector bundle.", "p": "mathlib"}, {"name": "cont_mdiff_section.ext", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.module", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_section.coe_neg", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_map_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_map_id", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_nat_trans_id", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_functor_preserves_zero_morphisms", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_lift", "description": "Lift a morphism `P \u27f6 Q` to `P\u207a \u27f6 Q` when `Q` is a sheaf.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_map_to_plus", "description": "`(P \u27f6 P\u207a)\u207a = P\u207a \u27f6 P\u207a\u207a`", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.iso_to_plus_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.to_plus_nat_trans_app", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_hom_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_map", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_functor_map", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.to_plus_naturality", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_functor_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_functor_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_pullback", "description": "A helper definition used to define the morphisms for `plus`.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.to_plus_nat_trans", "description": "The natural transformation from the identity functor to `plus`.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_lift_unique", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_nat_trans_app", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_nat_trans_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.to_plus_naturality_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_pullback_app", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.iso_to_plus", "description": "The natural isomorphism between `P` and `P\u207a` when `P` is a sheaf.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_nat_trans_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.to_plus_plus_lift_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.iso_to_plus_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram", "description": "The diagram whose colimit defines the values of `plus`.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.to_plus", "description": " The canonical map from `P` to `J.plus.obj P`.\nSee `to_plus` for a functorial version.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_map_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_map_plus_lift", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_functor", "description": "The plus construction, a functor sending `P` to `J.plus_obj P`.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_functor_map", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_map", "description": "An auxiliary definition used in `plus` below.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_nat_trans", "description": " A natural transformation `P \u27f6 Q` induces a natural transformation\nbetween diagrams whose colimits define the values of `plus`.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_functor", "description": "`J.diagram P`, as a functor in `P`.", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.is_iso_to_plus_of_is_sheaf", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.to_plus_plus_lift", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.diagram_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck_topology.plus_obj", "description": " The plus construction, associating a presheaf to any presheaf.\nSee `plus_functor` below for a functorial version.", "p": "mathlib"}, {"name": "is_antichain.top_mem_iff", "description": "", "p": "mathlib"}, {"name": "is_antichain.mono", "description": "", "p": "mathlib"}, {"name": "is_antichain_insert_of_symmetric", "description": "", "p": "mathlib"}, {"name": "is_antichain.image_iso_iff", "descrip