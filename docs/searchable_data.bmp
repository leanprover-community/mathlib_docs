 `f : R \u2243+** S`,  where `J = f(I)`.", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_comm_mk_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_map_comp_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient.lift\u2090_comp", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_map_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_equiv_symm_mk", "description": "", "p": "mathlib"}, {"name": "ring_hom.quotient_ker_equiv_of_surjective", "description": "The **first isomorphism theorem** for commutative rings.", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_comm\u2090", "description": "The natural algebra isomorphism `(A / I) / J' \u2192 (A / J) / I'`,\n where `J'` (resp. `I'`) is the projection of `J` in `A / I` (resp. `I` in `A / J`).", "p": "mathlib"}, {"name": "ideal.quotient.algebra_map_eq", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_left_to_quot_sup", "description": "The obvious ring hom `R/I \u2192 R/(I \u2294 J)`", "p": "mathlib"}, {"name": "double_quot.coe_quot_left_to_quot_sup\u2090", "description": "", "p": "mathlib"}, {"name": "double_quot.lift_sup_quot_quot_mk", "description": "The ring homomorphism `R/(I \u2294 J) \u2192 (R/I)/J' `induced by `quot_quot_mk`", "p": "mathlib"}, {"name": "double_quot.coe_quot_quot_equiv_quot_sup\u2090_symm", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_map_mk\u2090", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_of_le_quot_quot_mk", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_of_le_symm_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient.alg_map_eq", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_ker_alg_equiv_of_right_inverse", "description": "The **first isomorphism** theorem for algebras, computable version.", "p": "mathlib"}, {"name": "ideal.quotient_map_injective", "description": "If we take `J = I.comap f` then `quotient_map` is injective automatically.", "p": "mathlib"}, {"name": "ideal.quotient.mk\u2090_ker", "description": "The kernel of `A \u2192\u2090[R\u2081] I.quotient` is `I`.", "p": "mathlib"}, {"name": "ideal.mem_quotient_iff_mem", "description": "See also `ideal.mem_quotient_iff_mem_sup` if the assumption `I \u2264 J` is not available.", "p": "mathlib"}, {"name": "double_quot.coe_quot_quot_equiv_quot_of_le\u2090", "description": "", "p": "mathlib"}, {"name": "ideal.quotient.lift\u2090", "description": "`ideal.quotient.lift` as an `alg_hom`.", "p": "mathlib"}, {"name": "double_quot.quot_quot_to_quot_sup\u2090_to_ring_hom", "description": "", "p": "mathlib"}, {"name": "double_quot.coe_quot_quot_mk\u2090", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_comm_comp_quot_quot_mk\u2090", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_mk\u2090_to_ring_hom", "description": "", "p": "mathlib"}, {"name": "ideal.quotient.algebra", "description": "The `R\u2081`-algebra structure on `A/I` for an `R\u2081`-algebra `A`", "p": "mathlib"}, {"name": "double_quot.ker_quot_quot_mk", "description": "The kernel of `quot_quot_mk`", "p": "mathlib"}, {"name": "ideal.ker_lift_alg_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_ker_alg_equiv_of_right_inverse_symm.apply", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_map_injective'", "description": "`H` and `h` are kept as separate hypothesis since H is used in constructing the quotient map.", "p": "mathlib"}, {"name": "double_quot.quot_left_to_quot_sup\u2090", "description": "The natural algebra homomorphism `A / I \u2192 A / (I \u2294 J)`.", "p": "mathlib"}, {"name": "ring_hom.ker_lift", "description": " The induced map from the quotient by the kernel to the codomain.\n\nThis is an isomorphism if `f` has a right inverse (`quotient_ker_equiv_of_right_inverse`) /\nis surjective (`quotient_ker_equiv_of_surjective`).", "p": "mathlib"}, {"name": "ideal.quotient_equiv_alg_of_eq_symm", "description": "", "p": "mathlib"}, {"name": "ideal.quotient.mk\u2090_to_ring_hom", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_map_comp_mk\u2090", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_comm_algebra_map", "description": "", "p": "mathlib"}, {"name": "ring_hom.quotient_ker_equiv_of_right_inverse", "description": "The **first isomorphism theorem** for commutative rings, computable version.", "p": "mathlib"}, {"name": "ideal.comap_map_mk", "description": "", "p": "mathlib"}, {"name": "ideal.ker_lift_alg_injective", "description": "The induced algebra morphism from the quotient by the kernel is injective.", "p": "mathlib"}, {"name": "ideal.quotient.mk\u2090_eq_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_map_algebra_map", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_of_le_symm_comp_mk", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_to_quot_sup", "description": "The ring homomorphism `(R/I)/J' -> R/(I \u2294 J)` induced by `quot_left_to_quot_sup` where `J'`\n is the image of `J` in `R/I`", "p": "mathlib"}, {"name": "ideal.bot_quotient_is_maximal_iff", "description": "", "p": "mathlib"}, {"name": "double_quot.lift_sup_quot_quot_mk\u2090", "description": "The injective algebra homomorphism `A / (I \u2294 J) \u2192 (A / I) / J'`induced by `quot_quot_mk`,\n where `J'` is the projection `J` in `A / I`.", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_sup_quot_quot_algebra_map", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_sup_quot_quot_mk", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_of_le_symm_comp_mk\u2090", "description": "", "p": "mathlib"}, {"name": "ring_hom.ker_lift_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient.mk_comp_algebra_map", "description": "", "p": "mathlib"}, {"name": "double_quot.coe_quot_quot_to_quot_sup\u2090", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_equiv_alg", "description": " The algebra equiv `A/I \u2243\u2090[R] B/J` induced by an algebra equiv `f : A \u2243\u2090[R] B`,\nwhere`J = f(I)`.", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_sup\u2090_to_ring_equiv", "description": "", "p": "mathlib"}, {"name": "ideal.ker_lift_alg", "description": " The induced algebras morphism from the quotient by the kernel to the codomain.\n\nThis is an isomorphism if `f` has a right inverse (`quotient_ker_alg_equiv_of_right_inverse`) /\nis surjective (`quotient_ker_alg_equiv_of_surjective`).", "p": "mathlib"}, {"name": "ideal.quotient.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_sup\u2090", "description": "`quot_quot_to_quot_add` and `lift_sup_quot_quot_mk` are inverse isomorphisms. In the case where\n   `I \u2264 J`, this is the Third Isomorphism Theorem (see `quot_quot_equiv_quot_of_le`).", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_of_le", "description": "**The Third Isomorphism theorem** for rings. See `quot_quot_equiv_quot_sup` for a version\n   that does not assume an inclusion of ideals.", "p": "mathlib"}, {"name": "ideal.map_quotient_self", "description": "", "p": "mathlib"}, {"name": "ideal.mem_quotient_iff_mem_sup", "description": "See also `ideal.mem_quotient_iff_mem` in case `I \u2264 J`.", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_sup", "description": "`quot_quot_to_quot_add` and `lift_sup_double_qot_mk` are inverse isomorphisms. In the case where\n   `I \u2264 J`, this is the Third Isomorphism Theorem (see `quot_quot_equiv_quot_of_le`)", "p": "mathlib"}, {"name": "ideal.quotient_algebra", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_equiv_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_ker_alg_equiv_of_right_inverse.apply", "description": "", "p": "mathlib"}, {"name": "ideal.ker_quotient_lift", "description": "", "p": "mathlib"}, {"name": "ideal.map_mk_eq_bot_of_le", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_comm", "description": "The obvious isomorphism `(R/I)/J' \u2192 (R/J)/I' `", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_of_le\u2090", "description": "The **third isomoprhism theorem** for rings. See `quot_quot_equiv_quot_sup` for version\n   that does not assume an inclusion of ideals.", "p": "mathlib"}, {"name": "double_quot.quot_left_to_quot_sup\u2090_to_ring_hom", "description": "", "p": "mathlib"}, {"name": "ring_hom.lift_injective_of_ker_le_ideal", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_quot_of_le\u2090_to_ring_equiv", "description": "", "p": "mathlib"}, {"name": "ideal.quotient.mk\u2090_surjective", "description": "The canonical morphism `A \u2192\u2090[R\u2081] I.quotient` is surjective.", "p": "mathlib"}, {"name": "ideal.quotient_map_surjective", "description": "", "p": "mathlib"}, {"name": "double_quot.coe_quot_quot_equiv_quot_of_le\u2090_symm", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_comm_symm\u2090", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_comm_symm", "description": "", "p": "mathlib"}, {"name": "ideal.ker_lift_alg_to_ring_hom", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_comm_comp_quot_quot_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient.mk\u2090", "description": " The canonical morphism `A \u2192\u2090[R\u2081] A \u29f8 I` as morphism of `R\u2081`-algebras, for `I` an ideal of\n`A`, where `A` is an `R\u2081`-algebra.", "p": "mathlib"}, {"name": "ideal.ker_lift.map_smul", "description": "", "p": "mathlib"}, {"name": "ideal.mk_ker", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_equiv_comm_quot_quot_mk", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_equiv_apply", "description": "", "p": "mathlib"}, {"name": "ideal.quotient_ker_alg_equiv_of_surjective", "description": "The **first isomorphism theorem** for algebras.", "p": "mathlib"}, {"name": "double_quot.coe_quot_quot_equiv_quot_sup\u2090", "description": "", "p": "mathlib"}, {"name": "ring_hom.quotient_ker_equiv_of_right_inverse.apply", "description": "", "p": "mathlib"}, {"name": "double_quot.quot_quot_mk\u2090", "description": "The composition of the algebra homomorphisms `A \u2192 (A / I)` and `(A / I) \u2192 (A / I) / J'`,\n where `J'` is the projection `J` in `A / I`.", "p": "mathlib"}, {"name": "ideal.quotient_map", "description": "The ring hom `R/I \u2192+* S/J` induced by a ring hom `f : R \u2192+* S` with `I \u2264 f\u207b\u00b9(J)`", "p": "mathlib"}, {"name": "double_quot.lift_sup_quot_quot_mk\u2090_to_ring_hom", "description": "", "p": "mathlib"}, {"name": "ideal.quotient.alg_hom_ext", "description": "", "p": "mathlib"}, {"name": "holor.add_group", "description": "", "p": "mathlib"}, {"name": "holor.mul", "description": "The tensor product of two holors.", "p": "mathlib"}, {"name": "holor.cprank_max_sum", "description": "", "p": "mathlib"}, {"name": "holor_index.assoc_left", "description": "", "p": "mathlib"}, {"name": "holor", "description": "Holor (indexed collections of tensor coefficients)", "p": "mathlib"}, {"name": "holor_index.drop_drop", "description": "", "p": "mathlib"}, {"name": "holor.slice_add", "description": "", "p": "mathlib"}, {"name": "holor_index.cast_type", "description": "", "p": "mathlib"}, {"name": "holor.has_add", "description": "", "p": "mathlib"}, {"name": "holor.has_smul", "description": "", "p": "mathlib"}, {"name": "holor.cast_type", "description": "", "p": "mathlib"}, {"name": "holor.cprank_upper_bound", "description": "", "p": "mathlib"}, {"name": "holor_index.drop_take", "description": "", "p": "mathlib"}, {"name": "holor.slice_zero", "description": "", "p": "mathlib"}, {"name": "holor.mul_left_distrib", "description": "", "p": "mathlib"}, {"name": "holor.holor_index_cons_decomp", "description": "", "p": "m