ion", "description": "", "p": "mathlib"}, {"name": "first_order.language.Lhom.is_expansion_on", "description": " A language homomorphism is an expansion on a structure if it commutes with the interpretation of\nall symbols on that structure.", "p": "mathlib"}, {"name": "first_order.language.Lhom.is_expansion_on.map_on_function", "description": " A language homomorphism is an expansion on a structure if it commutes with the interpretation of\nall symbols on that structure.", "p": "mathlib"}, {"name": "first_order.language.Lhom.is_expansion_on.map_on_relation", "description": " A language homomorphism is an expansion on a structure if it commutes with the interpretation of\nall symbols on that structure.", "p": "mathlib"}, {"name": "first_order.language.Lhom.comp", "description": "The composition of two language homomorphisms.", "p": "mathlib"}, {"name": "first_order.language.Lhom_with_constants", "description": "The language map adding constants.", "p": "mathlib"}, {"name": "first_order.language.is_relational_constants_on", "description": "", "p": "mathlib"}, {"name": "first_order.language.Lhom.sum_elim", "description": "A language map defined on two factors of a sum.", "p": "mathlib"}, {"name": "first_order.language.Lhom.sum_inr_on_relation", "description": "", "p": "mathlib"}, {"name": "first_order.language.Lequiv.refl_to_Lhom", "description": "", "p": "mathlib"}, {"name": "first_order.language.Lhom.sum_map_on_function", "description": "", "p": "mathlib"}, {"name": "first_order.language.Lhom.of_is_empty", "description": "The inclusion of an empty language into any other language.", "p": "mathlib"}, {"name": "first_order.language.Lequiv.symm_inv_Lhom", "description": "", "p": "mathlib"}, {"name": "first_order.language.Lhom.sum_elim_on_relation", "description": "", "p": "mathlib"}, {"name": "first_order.language.add_empty_constants_is_expansion_on'", "description": "", "p": "mathlib"}, {"name": "first_order.language.Lhom.id_is_expansion_on", "description": "", "p": "