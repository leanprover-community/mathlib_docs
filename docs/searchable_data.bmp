sqrt_of_multiplicity_odd", "description": "", "p": "mathlib"}, {"name": "irrational_nat_div_iff", "description": "", "p": "mathlib"}, {"name": "irrational.ne_rat", "description": "", "p": "mathlib"}, {"name": "irrational.sub_rat", "description": "", "p": "mathlib"}, {"name": "irrational_mul_int_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_mul_self", "description": "", "p": "mathlib"}, {"name": "rat.not_irrational", "description": "", "p": "mathlib"}, {"name": "irrational.int_sub", "description": "", "p": "mathlib"}, {"name": "irrational.div_cases", "description": "", "p": "mathlib"}, {"name": "irrational.decidable", "description": "", "p": "mathlib"}, {"name": "exists_irrational_btwn", "description": "There is an irrational number `r` between any two reals `x < r < y`.", "p": "mathlib"}, {"name": "nat.prime.irrational_sqrt", "description": "", "p": "mathlib"}, {"name": "irrational.add_cases", "description": "If `x + y` is irrational, then at least one of `x` and `y` is irrational.", "p": "mathlib"}, {"name": "irrational.div_rat", "description": "", "p": "mathlib"}, {"name": "irrational.ne_nat", "description": "", "p": "mathlib"}, {"name": "irrational_sub_rat_iff", "description": "", "p": "mathlib"}, {"name": "irrational.mul_nat", "description": "", "p": "mathlib"}, {"name": "irrational.ne_int", "description": "", "p": "mathlib"}, {"name": "irrational.sub_nat", "description": "", "p": "mathlib"}, {"name": "irrational.of_pow", "description": "", "p": "mathlib"}, {"name": "irrational.int_div", "description": "", "p": "mathlib"}, {"name": "irrational_inv_iff", "description": "", "p": "mathlib"}, {"name": "irrational.rat_sub", "description": "", "p": "mathlib"}, {"name": "irrational.of_mul_nat", "description": "", "p": "mathlib"}, {"name": "irrational.of_div_nat", "description": "", "p": "mathlib"}, {"name": "irrational.of_int_div", "description": "", "p": "mathlib"}, {"name": "irrational.of_nat_mul", "description": "", "p": "mathlib"}, {"name": "irrational.of_add_int", "description": "", "p": "mathlib"}, {"name": "irrational_rat_div_iff", "description": "", "p": "mathlib"}, {"name": "irrational.add_int", "description": "", "p": "mathlib"}, {"name": "irrational.of_one_div", "description": "", "p": "mathlib"}, {"name": "irrational.ne_zero", "description": "", "p": "mathlib"}, {"name": "irrational.add_rat", "description": "", "p": "mathlib"}, {"name": "irrational.of_rat_sub", "description": "", "p": "mathlib"}, {"name": "irrational_div_int_iff", "description": "", "p": "mathlib"}, {"name": "irrational_nat_add_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_div_rat", "description": "", "p": "mathlib"}, {"name": "irrational.int_add", "description": "", "p": "mathlib"}, {"name": "irrational_mul_nat_iff", "description": "", "p": "mathlib"}, {"name": "irrational.rat_mul", "description": "", "p": "mathlib"}, {"name": "irrational_nrt_of_notint_nrt", "description": " If `x^n`, `n > 0`, is integer and is not the `n`-th power of an integer, then\n`x` is irrational.", "p": "mathlib"}, {"name": "irrational.of_sub_int", "description": "", "p": "mathlib"}, {"name": "irrational_iff_ne_rational", "description": "", "p": "mathlib"}, {"name": "irrational_rat_add_iff", "description": "", "p": "mathlib"}, {"name": "irrational.div_nat", "description": "", "p": "mathlib"}, {"name": "irrational.of_rat_add", "description": "", "p": "mathlib"}, {"name": "irrational_div_nat_iff", "description": "", "p": "mathlib"}, {"name": "irrational_nrt_of_n_not_dvd_multiplicity", "description": " If `x^n = m` is an integer and `n` does not divide the `multiplicity p m`, then `x`\nis irrational.", "p": "mathlib"}, {"name": "irrational_mul_rat_iff", "description": "", "p": "mathlib"}, {"name": "irrational_int_add_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_inv", "description": "", "p": "mathlib"}, {"name": "irrational.of_rat_mul", "description": "", "p": "mathlib"}, {"name": "irrational_add_rat_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_mul_rat", "description": "", "p": "mathlib"}, {"name": "int.not_irrational", "description": "", "p": "mathlib"}, {"name": "irrational.sub_int", "description": "", "p": "mathlib"}, {"name": "irrational_int_sub_iff", "description": "", "p": "mathlib"}, {"name": "irrational_add_nat_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_rat_div", "description": "", "p": "mathlib"}, {"name": "irrational.rat_div", "description": "", "p": "mathlib"}, {"name": "irrational.of_nat_add", "description": "", "p": "mathlib"}, {"name": "irrational_add_int_iff", "description": "", "p": "mathlib"}, {"name": "irrational.int_mul", "description": "", "p": "mathlib"}, {"name": "irrational.neg", "description": "", "p": "mathlib"}, {"name": "irrational.of_mul_int", "description": "", "p": "mathlib"}, {"name": "irrational_div_rat_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_neg", "description": "", "p": "mathlib"}, {"name": "irrational_rat_mul_iff", "description": "", "p": "mathlib"}, {"name": "irrational.inv", "description": "", "p": "mathlib"}, {"name": "irrational.of_add_rat", "description": "", "p": "mathlib"}, {"name": "irrational.nat_div", "description": "", "p": "mathlib"}, {"name": "irrational.div_int", "description": "", "p": "mathlib"}, {"name": "irrational.nat_add", "description": "", "p": "mathlib"}, {"name": "irrational.mul_rat", "description": "", "p": "mathlib"}, {"name": "irrational_int_div_iff", "description": "", "p": "mathlib"}, {"name": "irrational_int_mul_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_int_add", "description": "", "p": "mathlib"}, {"name": "irrational.rat_add", "description": "", "p": "mathlib"}, {"name": "irrational_neg_iff", "description": "", "p": "mathlib"}, {"name": "irrational_sub_nat_iff", "description": "", "p": "mathlib"}, {"name": "irrational.mul_int", "description": "", "p": "mathlib"}, {"name": "irrational.of_int_sub", "description": "", "p": "mathlib"}, {"name": "irrational.of_div_int", "description": "", "p": "mathlib"}, {"name": "irrational_nat_sub_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_sub_nat", "description": "", "p": "mathlib"}, {"name": "irrational.of_nat_sub", "description": "", "p": "mathlib"}, {"name": "irrational.of_int_mul", "description": "", "p": "mathlib"}, {"name": "one_lt_nat_degree_of_irrational_root", "description": "", "p": "mathlib"}, {"name": "irrational_sqrt_two", "description": "**Irrationality of the Square Root of 2**", "p": "mathlib"}, {"name": "irrational.ne_one", "description": "", "p": "mathlib"}, {"name": "irrational.mul_cases", "description": "", "p": "mathlib"}, {"name": "transcendental.irrational", "description": "A transcendental real number is irrational.", "p": "mathlib"}, {"name": "irrational", "description": "A real number is irrational if it is not equal to any rational number.", "p": "mathlib"}, {"name": "irrational_sqrt_rat_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_zpow", "description": "", "p": "mathlib"}, {"name": "nat.not_irrational", "description": "", "p": "mathlib"}, {"name": "irrational.of_add_nat", "description": "", "p": "mathlib"}, {"name": "irrational_nat_mul_iff", "description": "", "p": "mathlib"}, {"name": "irrational_rat_sub_iff", "description": "", "p": "mathlib"}, {"name": "irrational.of_nat_div", "description": "", "p": "mathlib"}, {"name": "irrational.nat_mul", "description": "", "p": "mathlib"}, {"name": "irrational.nat_sub", "description": "", "p": "mathlib"}, {"name": "interval_integral.deriv_within_integral_of_tendsto_ae_right", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has a finite\nlimit `c` almost surely as `x` tends to `b` from the right or from the left, then the right\n(resp., left) derivative of `u \u21a6 \u222b x in a..u, f x` at `b` equals `c`.", "p": "mathlib"}, {"name": "interval_integral.measure_integral_sub_linear_is_o_of_tendsto_ae_of_le", "description": " Fundamental theorem of calculus-1, local version for any measure.\nLet filters `l` and `l'` be related by `[FTC_filter a l l']`; let `\u03bc` be a locally finite measure.\nIf `f` has a finite limit `c` at `l' \u2293 \u03bc.ae`, then\n`\u222b x in u..v, f x \u2202\u03bc = \u03bc (Ioc u v) \u2022 c + o(\u03bc(Ioc u v))` as both `u` and `v` tend to `l`.\n\nSee also `measure_integral_sub_linear_is_o_of_tendsto_ae_of_le'` for a version that also works,\ne.g., for `l = l' = at_top`.", "p": "mathlib"}, {"name": "interval_integral.measure_integral_sub_linear_is_o_of_tendsto_ae", "description": " Fundamental theorem of calculus-1, local version for any measure.\nLet filters `l` and `l'` be related by `[FTC_filter a l l']`; let `\u03bc` be a locally finite measure.\nIf `f` has a finite limit `c` at `l' \u2293 \u03bc.ae`, then\n`\u222b x in u..v, f x \u2202\u03bc = \u222b x in u..v, c \u2202\u03bc + o(\u222b x in u..v, 1 \u2202\u03bc)` as both `u` and `v` tend to `l`.\n\nSee also `measure_integral_sub_linear_is_o_of_tendsto_ae'` for a version that also works, e.g., for\n`l = l' = at_top`.\n\nWe use integrals of constants instead of measures because this way it is easier to formulate\na statement that works in both cases `u \u2264 v` and `v \u2264 u`.", "p": "mathlib"}, {"name": "interval_integral.unique_diff_within_at_Ici_Iic_univ", "description": " An auxiliary tactic closing goals `unique_diff_within_at \u211d s a` where\n`s \u2208 {Iic a, Ici a, univ}`.", "p": "mathlib"}, {"name": "interval_integral.integral_sub_linear_is_o_of_tendsto_ae", "description": " Fundamental theorem of calculus-1, local version. If `f` has a finite limit `c` almost surely at\n`l'`, where `(l, l')` is an `FTC_filter` pair around `a`, then\n`\u222b x in u..v, f x \u2202\u03bc = (v - u) \u2022 c + o (v - u)` as both `u` and `v` tend to `l`.", "p": "mathlib"}, {"name": "interval_integral.measure_integral_sub_integral_sub_linear_is_o_of_tendsto_ae_right", "description": " Fundamental theorem of calculus-1, strict derivative in right endpoint for a locally finite\nmeasure.\n\nLet `f` be a measurable function integrable on `a..b`. Let `(lb, lb')` be a pair of `FTC_filter`s\naround `b`. Suppose that `f` has a finite limit `c` at `lb' \u2293 \u03bc.ae`.\n\nThen `\u222b x in a..v, f x \u2202\u03bc - \u222b x in a..u, f x \u2202\u03bc = \u222b x in u..v, c \u2202\u03bc + o(\u222b x in u..v, (1:\u211d) \u2202\u03bc)`\nas `u` and `v` tend to `lb`.", "p": "mathlib"}, {"name": "interval_integral.integrable_on_deriv_right_of_nonneg", "description": "When the right derivative of a function is nonnegative, then it is automatically integrable.", "p": "mathlib"}, {"name": "interval_integral.sub_le_integral_of_has_deriv_right_of_le", "description": " Hard part of FTC-2 for integrable derivatives, real-valued functions: one has\n`g b - g a \u2264 \u222b y in a..b, g' y` when `g'` is integrable.\nAuxiliary lemma in the proof of `integral_eq_sub_of_has_deriv_right_of_le`.\nWe give the slightly more general version that `g b - g a \u2264 \u222b y in a..b, \u03c6 y` when `g' \u2264 \u03c6` and\n`\u03c6` is integrable (even if `g'` is not known to be integrable).\nVersion assuming that `g` is differentiable on `(a, b)`.", "p": "mathlib"}, {"name": "interval_integral.integral_deriv_eq_sub'", "description": "", "p": "mathlib"}, {"name": "interval_integral.integral_le_sub_of_has_deriv_right_of_le", "description": "Auxiliary lemma in the proof of `integral_eq_sub_of_has_deriv_right_of_le`.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.nhds_right", "description": "", "p": "mathlib"}, {"name": "interval_integral.integral_deriv_comp_smul_deriv", "description": "", "p": "mathlib"}, {"name": "interval_integral.integral_sub_integral_sub_linear_is_o_of_tendsto_ae_right", "description": " Fundamental theorem of calculus-1, strict differentiability at filter in both endpoints.\nIf `f` is a measurable function integrable on `a..b`, `(lb, lb')` is an `FTC_filter` pair\naround `b`, and `f` has a finite limit `c` almost surely at `lb'`, then\n`(\u222b x in a..v, f x) - \u222b x in a..u, f x = (v - u) \u2022 c + o(\u2016v - u\u2016)` as `u` and `v` tend to `lb`.\n\nThis lemma could've been formulated using `has_strict_deriv_at_filter` if we had this definition.", "p": "mathlib"}, {"name": "interval_integral.integral_has_deriv_at_left", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` is continuous\nat `a`, then `u \u21a6 \u222b x in u..b, f x` has derivative `-f a` at `a`.", "p": "mathlib"}, {"name": "interval_integral.deriv_integral_right", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` is continuous\nat `b`, then the derivative of `u \u21a6 \u222b x in a..u, f x` at `b` equals `f b`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_deriv_within_at_left", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` is continuous\nfrom the left or from the right at `a`, then `u \u21a6 \u222b x in u..b, f x` has left (resp., right)\nderivative `-f a` at `a`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_strict_deriv_at_right", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` is continuous\nat `b`, then `u \u21a6 \u222b x in a..u, f x` has derivative `f b` at `b` in the sense of strict\ndifferentiability.", "p": "mathlib"}, {"name": "interval_integral.measure_integral_sub_integral_sub_linear_is_o_of_tendsto_ae_left", "description": " Fundamental theorem of calculus-1, strict derivative in left endpoint for a locally finite\nmeasure.\n\nLet `f` be a measurable function integrable on `a..b`. Let `(la, la')` be a pair of `FTC_filter`s\naround `a`. Suppose that `f` has a finite limit `c` at `la' \u2293 \u03bc.ae`.\n\nThen `\u222b x in v..b, f x \u2202\u03bc - \u222b x in u..b, f x \u2202\u03bc = -\u222b x in u..v, c \u2202\u03bc + o(\u222b x in u..v, (1:\u211d) \u2202\u03bc)`\nas `u` and `v` tend to `la`.", "p": "mathlib"}, {"name": "interval_integral.integral_eq_sub_of_has_deriv_right", "description": "Fundamental theorem of calculus-2: If `f : \u211d \u2192 E` is continuous on `[a, b]` and\n has a right derivative at `f' x` for all `x` in `[a, b)`, and `f'` is integrable on `[a, b]` then\n `\u222b y in a..b, f' y` equals `f b - f a`.", "p": "mathlib"}, {"name": "interval_integral.integral_comp_mul_deriv'''", "description": "Change of variables, general form for scalar functions. If `f` is continuous on `[a, b]` and has\ncontinuous right-derivative `f'` in `(a, b)`, `g` is continuous on `f '' (a, b)` and integrable on\n`f '' [a, b]`, and `(g \u2218 f) x * f' x` is integrable on `[a, b]`, then we can substitute `u = f x`\nto get `\u222b x in a..b, (g \u2218 f) x * f' x = \u222b u in f a..f b, g u`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_deriv_within_at_right", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` is continuous\nfrom the left or from the right at `b`, then `u \u21a6 \u222b x in a..u, f x` has left (resp., right)\nderivative `f b` at `b`.", "p": "mathlib"}, {"name": "interval_integral.differentiable_on_integral_of_continuous", "description": "The integral of a continuous function is differentiable on a real set `s`.", "p": "mathlib"}, {"name": "interval_integral.measure_integral_sub_linear_is_o_of_tendsto_ae_of_ge", "description": " Fundamental theorem of calculus-1, local version for any measure.\nLet filters `l` and `l'` be related by `[FTC_filter a l l']`; let `\u03bc` be a locally finite measure.\nIf `f` has a finite limit `c` at `l' \u2293 \u03bc.ae`, then\n`\u222b x in u..v, f x \u2202\u03bc = -\u03bc (Ioc v u) \u2022 c + o(\u03bc(Ioc v u))` as both `u` and `v` tend to `l`.\n\nSee also `measure_integral_sub_linear_is_o_of_tendsto_ae_of_ge'` for a version that also works,\ne.g., for `l = l' = at_top`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_deriv_at_right", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` is continuous\nat `b`, then `u \u21a6 \u222b x in a..u, f x` has derivative `f b` at `b`.", "p": "mathlib"}, {"name": "interval_integral.integral_sub_integral_sub_linear_is_o_of_tendsto_ae_left", "description": " Fundamental theorem of calculus-1, strict differentiability at filter in both endpoints.\nIf `f` is a measurable function integrable on `a..b`, `(la, la')` is an `FTC_filter` pair\naround `a`, and `f` has a finite limit `c` almost surely at `la'`, then\n`(\u222b x in v..b, f x) - \u222b x in u..b, f x = -(v - u) \u2022 c + o(\u2016v - u\u2016)` as `u` and `v` tend to `la`.\n\nThis lemma could've been formulated using `has_strict_deriv_at_filter` if we had this definition.", "p": "mathlib"}, {"name": "interval_integral.integral_comp_smul_deriv", "description": "Change of variables, most common version. If `f` is has continuous derivative `f'` on `[a, b]`,\nand `g` is continuous, then we can substitute `u = f x` to get\n`\u222b x in a..b, f' x \u2022 (g \u2218 f) x = \u222b u in f a..f b, g u`.", "p": "mathlib"}, {"name": "interval_integral.integral_eq_sub_of_has_deriv_right_of_le_real", "description": "Auxiliary lemma in the proof of `integral_eq_sub_of_has_deriv_right_of_le`: real version", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.nhds_within_singleton", "description": "", "p": "mathlib"}, {"name": "interval_integral.integral_has_strict_fderiv_at_of_tendsto_ae", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has finite\nlimits `ca` and `cb` almost surely as `x` tends to `a` and `b`, respectively, then\n`(u, v) \u21a6 \u222b x in u..v, f x` has derivative `(u, v) \u21a6 v \u2022 cb - u \u2022 ca` at `(a, b)`\nin the sense of strict differentiability.", "p": "mathlib"}, {"name": "interval_integral.integral_deriv_comp_smul_deriv'", "description": "", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.nhds_univ", "description": "", "p": "mathlib"}, {"name": "interval_integral.fderiv_within_integral_of_tendsto_ae", "description": " Let `f` be a measurable function integrable on `a..b`. Choose `s \u2208 {Iic a, Ici a, univ}`\nand `t \u2208 {Iic b, Ici b, univ}`. Suppose that `f` tends to `ca` and `cb` almost surely at the filters\n`la` and `lb` from the table below. Then `fderiv_within \u211d (\u03bb p, \u222b x in p.1..p.2, f x) (s \u00d7\u02e2 t)`\nis equal to `(u, v) \u21a6 u \u2022 cb - v \u2022 ca`.\n\n| `s`     | `la`     | `t`     | `lb`     |\n| ------- | ----     | ---     | ----     |\n| `Iic a` | `\ud835\udcdd[\u2264] a` | `Iic b` | `\ud835\udcdd[\u2264] b` |\n| `Ici a` | `\ud835\udcdd[>] a` | `Ici b` | `\ud835\udcdd[>] b` |\n| `{a}`   | `\u22a5`      | `{b}`   | `\u22a5`      |\n| `univ`  | `\ud835\udcdd a`    | `univ`  | `\ud835\udcdd b`    |", "p": "mathlib"}, {"name": "interval_integral.sub_le_integral_of_has_deriv_right_of_le_Ico", "description": " Hard part of FTC-2 for integrable derivatives, real-valued functions: one has\n`g b - g a \u2264 \u222b y in a..b, g' y` when `g'` is integrable.\nAuxiliary lemma in the proof of `integral_eq_sub_of_has_deriv_right_of_le`.\nWe give the slightly more general version that `g b - g a \u2264 \u222b y in a..b, \u03c6 y` when `g' \u2264 \u03c6` and\n`\u03c6` is integrable (even if `g'` is not known to be integrable).\nVersion assuming that `g` is differentiable on `[a, b)`.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter", "description": " An auxiliary typeclass for the Fundamental theorem of calculus, part 1. It is used to formulate\ntheorems that work simultaneously for left and right one-sided derivatives of `\u222b x in u..v, f x`.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.to_tendsto_Ixx_class", "description": " An auxiliary typeclass for the Fundamental theorem of calculus, part 1. It is used to formulate\ntheorems that work simultaneously for left and right one-sided derivatives of `\u222b x in u..v, f x`.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.pure_le", "description": " An auxiliary typeclass for the Fundamental theorem of calculus, part 1. It is used to formulate\ntheorems that work simultaneously for left and right one-sided derivatives of `\u222b x in u..v, f x`.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.le_nhds", "description": " An auxiliary typeclass for the Fundamental theorem of calculus, part 1. It is used to formulate\ntheorems that work simultaneously for left and right one-sided derivatives of `\u222b x in u..v, f x`.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.meas_gen", "description": " An auxiliary typeclass for the Fundamental theorem of calculus, part 1. It is used to formulate\ntheorems that work simultaneously for left and right one-sided derivatives of `\u222b x in u..v, f x`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_fderiv_at", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` is continuous\nat `a` and `b`, then `(u, v) \u21a6 \u222b x in u..v, f x` has derivative `(u, v) \u21a6 v \u2022 cb - u \u2022 ca`\nat `(a, b)`.", "p": "mathlib"}, {"name": "interval_integral.integrable_on_deriv_of_nonneg", "description": " When the derivative of a function is nonnegative, then it is automatically integrable,\nIoc version.", "p": "mathlib"}, {"name": "continuous.deriv_integral", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is continuous, then the derivative\nof `u \u21a6 \u222b x in a..u, f x` at `b` is `f b`.", "p": "mathlib"}, {"name": "interval_integral.deriv_integral_of_tendsto_ae_left", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` has a finite\nlimit `c` almost surely at `a`, then the derivative of `u \u21a6 \u222b x in u..b, f x` at `a` equals `-c`.", "p": "mathlib"}, {"name": "interval_integral.integral_eq_sub_of_has_deriv_right_of_le", "description": "**Fundamental theorem of calculus-2**: If `f : \u211d \u2192 E` is continuous on `[a, b]` (where `a \u2264 b`)\n and has a right derivative at `f' x` for all `x` in `(a, b)`, and `f'` is integrable on `[a, b]`,\n then `\u222b y in a..b, f' y` equals `f b - f a`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_strict_deriv_at_of_tendsto_ae_left", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has a finite\nlimit `c` almost surely at `a`, then `u \u21a6 \u222b x in u..b, f x` has derivative `-c` at `a` in the sense\nof strict differentiability.", "p": "mathlib"}, {"name": "interval_integral.deriv_within_integral_right", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` is continuous\non the right or on the left at `b`, then the right (resp., left) derivative of\n`u \u21a6 \u222b x in a..u, f x` at `b` equals `f b`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_fderiv_within_at", "description": " Let `f` be a measurable function integrable on `a..b`. The function `(u, v) \u21a6 \u222b x in u..v, f x`\nhas derivative `(u, v) \u21a6 v \u2022 f b - u \u2022 f a` within `s \u00d7 t` at `(a, b)`, where\n`s \u2208 {Iic a, {a}, Ici a, univ}` and `t \u2208 {Iic b, {b}, Ici b, univ}` provided that `f` tends to\n`f a` and `f b` at the filters `la` and `lb` from the following table. In most cases this assumption\nis definitionally equal `continuous_at f _` or `continuous_within_at f _ _`.\n\n| `s`     | `la`     | `t`     | `lb`     |\n| ------- | ----     | ---     | ----     |\n| `Iic a` | `\ud835\udcdd[\u2264] a` | `Iic b` | `\ud835\udcdd[\u2264] b` |\n| `Ici a` | `\ud835\udcdd[>] a` | `Ici b` | `\ud835\udcdd[>] b` |\n| `{a}`   | `\u22a5`      | `{b}`   | `\u22a5`      |\n| `univ`  | `\ud835\udcdd a`    | `univ`  | `\ud835\udcdd b`    |", "p": "mathlib"}, {"name": "interval_integral.integral_eq_sub_of_has_deriv_at", "description": "Fundamental theorem of calculus-2: If `f : \u211d \u2192 E` has a derivative at `f' x` for all `x` in\n `[a, b]` and `f'` is integrable on `[a, b]`, then `\u222b y in a..b, f' y` equals `f b - f a`.", "p": "mathlib"}, {"name": "interval_integral.integral_comp_smul_deriv''", "description": "Change of variables for continuous integrands. If `f` is continuous on `[a, b]` and has\ncontinuous right-derivative `f'` in `(a, b)`, and `g` is continuous on `f '' [a, b]` then we can\nsubstitute `u = f x` to get `\u222b x in a..b, f' x \u2022 (g \u2218 f) x = \u222b u in f a..f b, g u`.", "p": "mathlib"}, {"name": "interval_integral.integral_deriv_eq_sub", "description": "Fundamental theorem of calculus-2: If `f : \u211d \u2192 E` is differentiable at every `x` in `[a, b]` and\n its derivative is integrable on `[a, b]`, then `\u222b y in a..b, deriv f y` equals `f b - f a`.", "p": "mathlib"}, {"name": "interval_integral.integral_sub_integral_sub_linear_is_o_of_tendsto_ae", "description": " Fundamental theorem of calculus-1, strict differentiability at filter in both endpoints.\nIf `f` is a measurable function integrable on `a..b`, `(la, la')` is an `FTC_filter` pair around\n`a`, and `(lb, lb')` is an `FTC_filter` pair around `b`, and `f` has finite limits `ca` and `cb`\nalmost surely at `la'` and `lb'`, respectively, then\n`(\u222b x in va..vb, f x) - \u222b x in ua..ub, f x = (vb - ub) \u2022 cb - (va - ua) \u2022 ca +\n  o(\u2016va - ua\u2016 + \u2016vb - ub\u2016)` as `ua` and `va` tend to `la` while `ub` and `vb` tend to `lb`.\n\nThis lemma could've been formulated using `has_strict_fderiv_at_filter` if we had this\ndefinition.", "p": "mathlib"}, {"name": "interval_integral.measure_integral_sub_linear_is_o_of_tendsto_ae_of_ge'", "description": " Fundamental theorem of calculus-1, local version for any measure.\nLet filters `l` and `l'` be related by `tendsto_Ixx_class Ioc`.\nIf `f` has a finite limit `c` at `l \u2293 \u03bc.ae`, where `\u03bc` is a measure\nfinite at `l`, then `\u222b x in u..v, f x \u2202\u03bc = -\u03bc (Ioc v u) \u2022 c + o(\u03bc(Ioc v u))` as both\n`u` and `v` tend to `l` so that `v \u2264 u`.\n\nSee also `measure_integral_sub_linear_is_o_of_tendsto_ae_of_ge` for a version assuming\n`[FTC_filter a l l']` and `[is_locally_finite_measure \u03bc]`. If `l` is one of `\ud835\udcdd[\u2265] a`,\n`\ud835\udcdd[\u2264] a`, `\ud835\udcdd a`, then it's easier to apply the non-primed version.\nThe primed version also works, e.g., for `l = l' = at_top`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_strict_deriv_at_left", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` is continuous\nat `a`, then `u \u21a6 \u222b x in u..b, f x` has derivative `-f a` at `a` in the sense of strict\ndifferentiability.", "p": "mathlib"}, {"name": "interval_integral.integral_eq_sub_of_has_deriv_at_of_tendsto", "description": "", "p": "mathlib"}, {"name": "interval_integral.integral_comp_smul_deriv'''", "description": "Change of variables, general form. If `f` is continuous on `[a, b]` and has\nright-derivative `f'` in `(a, b)`, `g` is continuous on `f '' (a, b)` and integrable on\n`f '' [a, b]`, and `f' x \u2022 (g \u2218 f) x` is integrable on `[a, b]`,\nthen we can substitute `u = f x` to get `\u222b x in a..b, f' x \u2022 (g \u2218 f) x = \u222b u in f a..f b, g u`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_deriv_within_at_of_tendsto_ae_right", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has a finite\nlimit `c` almost surely as `x` tends to `b` from the right or from the left,\nthen `u \u21a6 \u222b x in a..u, f x` has right (resp., left) derivative `c` at `b`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_deriv_at_of_tendsto_ae_right", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has a finite\nlimit `c` almost surely at `b`, then `u \u21a6 \u222b x in a..u, f x` has derivative `c` at `b`.", "p": "mathlib"}, {"name": "interval_integral.deriv_within_integral_of_tendsto_ae_left", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has a finite\nlimit `c` almost surely as `x` tends to `a` from the right or from the left, then the right\n(resp., left) derivative of `u \u21a6 \u222b x in u..b, f x` at `a` equals `-c`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_deriv_within_at_of_tendsto_ae_left", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has a finite\nlimit `c` almost surely as `x` tends to `a` from the right or from the left,\nthen `u \u21a6 \u222b x in u..b, f x` has right (resp., left) derivative `-c` at `a`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_deriv_at_of_tendsto_ae_left", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has a finite\nlimit `c` almost surely at `a`, then `u \u21a6 \u222b x in u..b, f x` has derivative `-c` at `a`.", "p": "mathlib"}, {"name": "interval_integral.integral_eq_sub_of_has_deriv_at_of_le", "description": "Fundamental theorem of calculus-2: If `f : \u211d \u2192 E` is continuous on `[a, b]` (where `a \u2264 b`) and\n has a derivative at `f' x` for all `x` in `(a, b)`, and `f'` is integrable on `[a, b]`, then\n `\u222b y in a..b, f' y` equals `f b - f a`.", "p": "mathlib"}, {"name": "interval_integral.measure_integral_sub_integral_sub_linear_is_o_of_tendsto_ae", "description": " Fundamental theorem of calculus-1, strict derivative in both limits for a locally finite\nmeasure.\n\nLet `f` be a measurable function integrable on `a..b`. Let `(la, la')` be a pair of `FTC_filter`s\naround `a`; let `(lb, lb')` be a pair of `FTC_filter`s around `b`. Suppose that `f` has finite\nlimits `ca` and `cb` at `la' \u2293 \u03bc.ae` and `lb' \u2293 \u03bc.ae`, respectively.\nThen `\u222b x in va..vb, f x \u2202\u03bc - \u222b x in ua..ub, f x \u2202\u03bc =\n  \u222b x in ub..vb, cb \u2202\u03bc - \u222b x in ua..va, ca \u2202\u03bc +\n    o(\u2016\u222b x in ua..va, (1:\u211d) \u2202\u03bc\u2016 + \u2016\u222b x in ub..vb, (1:\u211d) \u2202\u03bc\u2016)`\nas `ua` and `va` tend to `la` while `ub` and `vb` tend to `lb`.", "p": "mathlib"}, {"name": "continuous.integral_has_strict_deriv_at", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is continuous, then `u \u21a6 \u222b x in a..u, f x`\nhas derivative `f b` at `b` in the sense of strict differentiability.", "p": "mathlib"}, {"name": "interval_integral.integral_comp_mul_deriv", "description": "Change of variables, most common version. If `f` is has continuous derivative `f'` on `[a, b]`,\nand `g` is continuous, then we can substitute `u = f x` to get\n`\u222b x in a..b, (g \u2218 f) x * f' x = \u222b u in f a..f b, g u`.", "p": "mathlib"}, {"name": "interval_integral.integral_comp_mul_deriv''", "description": "Change of variables for continuous integrands. If `f` is continuous on `[a, b]` and has\ncontinuous right-derivative `f'` in `(a, b)`, and `g` is continuous on `f '' [a, b]` then we can\nsubstitute `u = f x` to get `\u222b x in a..b, (g \u2218 f) x * f' x = \u222b u in f a..f b, g u`.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.nhds_Icc", "description": "", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.finite_at_inner", "description": "", "p": "mathlib"}, {"name": "interval_integral.deriv_integral_left", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` is continuous\nat `a`, then the derivative of `u \u21a6 \u222b x in u..b, f x` at `a` equals `-f a`.", "p": "mathlib"}, {"name": "interval_integral.deriv_within_integral_left", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` is continuous\non the right or on the left at `a`, then the right (resp., left) derivative of\n`u \u21a6 \u222b x in u..b, f x` at `a` equals `-f a`.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.nhds_uIcc", "description": "", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.nhds", "description": "", "p": "mathlib"}, {"name": "interval_integral.integral_has_fderiv_at_of_tendsto_ae", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has finite\nlimits `ca` and `cb` almost surely as `x` tends to `a` and `b`, respectively, then\n`(u, v) \u21a6 \u222b x in u..v, f x` has derivative `(u, v) \u21a6 v \u2022 cb - u \u2022 ca` at `(a, b)`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_fderiv_within_at_of_tendsto_ae", "description": " Let `f` be a measurable function integrable on `a..b`. The function `(u, v) \u21a6 \u222b x in u..v, f x`\nhas derivative `(u, v) \u21a6 v \u2022 cb - u \u2022 ca` within `s \u00d7 t` at `(a, b)`, where\n`s \u2208 {Iic a, {a}, Ici a, univ}` and `t \u2208 {Iic b, {b}, Ici b, univ}` provided that `f` tends to `ca`\nand `cb` almost surely at the filters `la` and `lb` from the following table.\n\n| `s`     | `la`     | `t`     | `lb`     |\n| ------- | ----     | ---     | ----     |\n| `Iic a` | `\ud835\udcdd[\u2264] a` | `Iic b` | `\ud835\udcdd[\u2264] b` |\n| `Ici a` | `\ud835\udcdd[>] a` | `Ici b` | `\ud835\udcdd[>] b` |\n| `{a}`   | `\u22a5`      | `{b}`   | `\u22a5`      |\n| `univ`  | `\ud835\udcdd a`    | `univ`  | `\ud835\udcdd b`    |", "p": "mathlib"}, {"name": "interval_integral.integral_has_strict_fderiv_at", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` is continuous\nat `a` and `b`, then `(u, v) \u21a6 \u222b x in u..v, f x` has derivative `(u, v) \u21a6 v \u2022 cb - u \u2022 ca`\nat `(a, b)` in the sense of strict differentiability.", "p": "mathlib"}, {"name": "interval_integral.integral_comp_smul_deriv'", "description": "Change of variables. If `f` is has continuous derivative `f'` on `[a, b]`,\nand `g` is continuous on `f '' [a, b]`, then we can substitute `u = f x` to get\n`\u222b x in a..b, f' x \u2022 (g \u2218 f) x = \u222b u in f a..f b, g u`.\nCompared to `interval_integral.integral_comp_smul_deriv` we only require that `g` is continuous on\n`f '' [a, b]`.", "p": "mathlib"}, {"name": "interval_integral.integral_deriv_comp_mul_deriv", "description": "", "p": "mathlib"}, {"name": "interval_integral.integral_deriv_comp_mul_deriv'", "description": "", "p": "mathlib"}, {"name": "interval_integral.integral_mul_deriv_eq_deriv_mul", "description": "", "p": "mathlib"}, {"name": "interval_integral.interval_integrable_deriv_of_nonneg", "description": " When the derivative of a function is nonnegative, then it is automatically integrable,\ninterval version.", "p": "mathlib"}, {"name": "interval_integral.integral_deriv_mul_eq_sub", "description": "", "p": "mathlib"}, {"name": "interval_integral.measure_integral_sub_linear_is_o_of_tendsto_ae_of_le'", "description": " Fundamental theorem of calculus-1, local version for any measure.\nLet filters `l` and `l'` be related by `tendsto_Ixx_class Ioc`.\nIf `f` has a finite limit `c` at `l \u2293 \u03bc.ae`, where `\u03bc` is a measure\nfinite at `l`, then `\u222b x in u..v, f x \u2202\u03bc = \u03bc (Ioc u v) \u2022 c + o(\u03bc(Ioc u v))` as both\n`u` and `v` tend to `l` so that `u \u2264 v`.\n\nSee also `measure_integral_sub_linear_is_o_of_tendsto_ae_of_le` for a version assuming\n`[FTC_filter a l l']` and `[is_locally_finite_measure \u03bc]`. If `l` is one of `\ud835\udcdd[\u2265] a`,\n`\ud835\udcdd[\u2264] a`, `\ud835\udcdd a`, then it's easier to apply the non-primed version.\nThe primed version also works, e.g., for `l = l' = at_top`.", "p": "mathlib"}, {"name": "interval_integral.measure_integral_sub_linear_is_o_of_tendsto_ae'", "description": " Fundamental theorem of calculus-1, local version for any measure.\nLet filters `l` and `l'` be related by `tendsto_Ixx_class Ioc`.\nIf `f` has a finite limit `c` at `l' \u2293 \u03bc.ae`, where `\u03bc` is a measure\nfinite at `l'`, then `\u222b x in u..v, f x \u2202\u03bc = \u222b x in u..v, c \u2202\u03bc + o(\u222b x in u..v, 1 \u2202\u03bc)` as both\n`u` and `v` tend to `l`.\n\nSee also `measure_integral_sub_linear_is_o_of_tendsto_ae` for a version assuming\n`[FTC_filter a l l']` and `[is_locally_finite_measure \u03bc]`. If `l` is one of `\ud835\udcdd[\u2265] a`,\n`\ud835\udcdd[\u2264] a`, `\ud835\udcdd a`, then it's easier to apply the non-primed version.\nThe primed version also works, e.g., for `l = l' = at_top`.\n\nWe use integrals of constants instead of measures because this way it is easier to formulate\na statement that works in both cases `u \u2264 v` and `v \u2264 u`.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.nhds_left", "description": "", "p": "mathlib"}, {"name": "interval_integral.fderiv_integral", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` is continuous\nat `a` and `b`, then `fderiv` derivative of `(u, v) \u21a6 \u222b x in u..v, f x` at `(a, b)` equals `(u, v) \u21a6\nv \u2022 cb - u \u2022 ca`.", "p": "mathlib"}, {"name": "interval_integral.integral_comp_mul_deriv'", "description": "Change of variables. If `f` is has continuous derivative `f'` on `[a, b]`,\nand `g` is continuous on `f '' [a, b]`, then we can substitute `u = f x` to get\n`\u222b x in a..b, (g \u2218 f) x * f' x = \u222b u in f a..f b, g u`.\nCompared to `interval_integral.integral_comp_mul_deriv` we only require that `g` is continuous on\n`f '' [a, b]`.", "p": "mathlib"}, {"name": "interval_integral.deriv_integral_of_tendsto_ae_right", "description": " Fundamental theorem of calculus: if `f : \u211d \u2192 E` is integrable on `a..b` and `f` has a finite\nlimit `c` almost surely at `b`, then the derivative of `u \u21a6 \u222b x in a..u, f x` at `b` equals `c`.", "p": "mathlib"}, {"name": "interval_integral.integral_has_strict_deriv_at_of_tendsto_ae_right", "description": " **First Fundamental Theorem of Calculus**: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has\na finite limit `c` almost surely at `b`, then `u \u21a6 \u222b x in a..u, f x` has derivative `c` at `b` in\nthe sense of strict differentiability.", "p": "mathlib"}, {"name": "interval_integral.FTC_filter.pure", "description": "", "p": "mathlib"}, {"name": "interval_integral.fderiv_integral_of_tendsto_ae", "description": " Fundamental theorem of calculus-1: if `f : \u211d \u2192 E` is integrable on `a..b` and `f x` has finite\nlimits `ca` and `cb` almost surely as `x` tends to `a` and `b`, respectively, then `fderiv`\nderivative of `(u, v) \u21a6 \u222b x in u..v, f x` at `(a, b)` equals `(u, v) \u21a6 v \u2022 cb - u \u2022 ca`.", "p": "mathlib"}, {"name": "distrib_mul_action.to_add_monoid_End_apply", "description": "", "p": "mathlib"}, {"name": "smul_add", "description": "", "p": "mathlib"}, {"name": "distrib_mul_action.to_add_monoid_hom", "description": "Each element of the monoid defines a additive monoid homomorphism.", "p": "mathlib"}, {"name": "is_scalar_tower.op_right", "description": "", "p": "mathlib"}, {"name": "vadd_add_vadd", "description": "", "p": "mathlib"}, {"name": "mul_distrib_mul_action.ext", "description": "", "p": "mathlib"}, {"name": "to_add_vadd", "description": "", "p": "mathlib"}, {"name": "distrib_mul_action.ext", "description": "", "p": "mathlib"}, {"name": "function.End.apply_mul_action", "description": " The tautological action by `function.End \u03b1` on `\u03b1`.\n\nThis is generalized to bundled endomorphisms by:\n* `equiv.perm.apply_mul_action`\n* `add_monoid.End.apply_distrib_mul_action`\n* `add_aut.apply_distrib_mul_action`\n* `mul_aut.apply_mul_distrib_mul_action`\n* `ring_hom.apply_distrib_mul_action`\n* `linear_equiv.apply_distrib_mul_action`\n* `linear_map.apply_module`\n* `ring_hom.apply_mul_semiring_action`\n* `alg_equiv.apply_mul_semiring_action`", "p": "mathlib"}, {"name": "mul_distrib_mul_action.ext_iff", "description": "", "p": "mathlib"}, {"name": "has_smul.comp.smul", "description": " Auxiliary definition for `has_smul.comp`, `mul_action.comp_hom`,\n`distrib_mul_action.comp_hom`, `module.comp_hom`, etc.", "p": "mathlib"}, {"name": "function.injective.distrib_smul", "description": " Pullback a distributive scalar multiplication along an injective additive monoid\nhomomorphism.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "commute.smul_left", "description": "", "p": "mathlib"}, {"name": "vadd_assoc_class", "description": " An instance of `vadd_assoc_class M N \u03b1` states that the additive action of `M` on `\u03b1` is\ndetermined by the additive actions of `M` on `N` and `N` on `\u03b1`.", "p": "mathlib"}, {"name": "vadd_assoc_class.vadd_assoc", "description": " An instance of `vadd_assoc_class M N \u03b1` states that the additive action of `M` on `\u03b1` is\ndetermined by the additive actions of `M` on `N` and `N` on `\u03b1`.", "p": "mathlib"}, {"name": "function.surjective.mul_distrib_mul_action", "description": " Pushforward a multiplicative distributive multiplicative action along a surjective monoid\nhomomorphism.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "function.surjective.mul_action_left", "description": " Push forward the action of `R` on `M` along a compatible surjective map `f : R \u2192* S`.\n\nSee also `function.surjective.distrib_mul_action_left` and `function.surjective.module_left`.", "p": "mathlib"}, {"name": "function.surjective.distrib_mul_action", "description": " Pushforward a distributive multiplicative action along a surjective additive monoid\nhomomorphism.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "smul_zero_class.comp_fun", "description": " Compose a `smul_zero_class` with a function, with scalar multiplication `f r' \u2022 m`.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "vadd_left_injective'", "description": "", "p": "mathlib"}, {"name": "function.surjective.add_action", "description": "Pushforward an additive action along a surjective map respecting `+\u1d65`.", "p": "mathlib"}, {"name": "smul_zero_class", "description": "Typeclass for scalar multiplication that preserves `0` on the right.", "p": "mathlib"}, {"name": "smul_zero_class.to_has_smul", "description": "Typeclass for scalar multiplication that preserves `0` on the right.", "p": "mathlib"}, {"name": "smul_zero_class.smul_zero", "description": "Typeclass for scalar multiplication that preserves `0` on the right.", "p": "mathlib"}, {"name": "distrib_mul_action.to_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "smul_comm_class.op_left", "description": "", "p": "mathlib"}, {"name": "distrib_mul_action.to_add_monoid_End", "description": "Each element of the monoid defines an additive monoid homomorphism.", "p": "mathlib"}, {"name": "smul_smul_smul_comm", "description": "", "p": "mathlib"}, {"name": "smul_mul'", "description": "", "p": "mathlib"}, {"name": "additive.vadd_comm_class", "description": "", "p": "mathlib"}, {"name": "add_monoid.nat_smul_comm_class", "description": "", "p": "mathlib"}, {"name": "function.End.monoid", "description": "", "p": "mathlib"}, {"name": "add_group.int_smul_comm_class'", "description": "", "p": "mathlib"}, {"name": "mul_action.surjective_smul", "description": "", "p": "mathlib"}, {"name": "function.injective.mul_action", "description": " Pullback a multiplicative action along an injective map respecting `\u2022`.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "add_action.exists_vadd_eq", "description": "", "p": "mathlib"}, {"name": "smul_one_hom_apply", "description": "", "p": "mathlib"}, {"name": "vadd_comm_class", "description": "A typeclass mixin saying that two additive actions on the same space commute.", "p": "mathlib"}, {"name": "vadd_comm_class.vadd_comm", "description": "A typeclass mixin saying that two additive actions on the same space commute.", "p": "mathlib"}, {"name": "is_scalar_tower.left", "description": "", "p": "mathlib"}, {"name": "to_mul_smul", "description": "", "p": "mathlib"}, {"name": "additive.add_action_is_pretransitive", "description": "", "p": "mathlib"}, {"name": "vadd_assoc", "description": "", "p": "mathlib"}, {"name": "has_smul.comp", "description": " An action of `M` on `\u03b1` and a function `N \u2192 M` induces an action of `N` on `\u03b1`.\n\nSee note [reducible non-instances]. Since this is reducible, we make sure to go via\n`has_smul.comp.smul` to prevent typeclass inference unfolding too far.", "p": "mathlib"}, {"name": "vadd_zero_hom_apply", "description": "", "p": "mathlib"}, {"name": "distrib_mul_action", "description": "Typeclass for multiplicative actions on additive structures. This generalizes group modules.", "p": "mathlib"}, {"name": "distrib_mul_action.to_mul_action", "description": "Typeclass for multiplicative actions on additive structures. This generalizes group modules.", "p": "mathlib"}, {"name": "distrib_mul_action.smul_zero", "description": "Typeclass for multiplicative actions on additive structures. This generalizes group modules.", "p": "mathlib"}, {"name": "distrib_mul_action.smul_add", "description": "Typeclass for multiplicative actions on additive structures. This generalizes group modules.", "p": "mathlib"}, {"name": "distrib_smul.to_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "mul_distrib_mul_action.to_monoid_End_apply", "description": "", "p": "mathlib"}, {"name": "mul_action.to_fun_apply", "description": "", "p": "mathlib"}, {"name": "multiplicative.smul_comm_class", "description": "", "p": "mathlib"}, {"name": "distrib_mul_action.ext_iff", "description": "", "p": "mathlib"}, {"name": "mul_action.is_pretransitive", "description": "`M` acts pretransitively on `\u03b1` if for any `x y` there is `g` such that `g \u2022 x = y`.\n A transitive action should furthermore have `\u03b1` nonempty.", "p": "mathlib"}, {"name": "mul_action.is_pretransitive.exists_smul_eq", "description": "`M` acts pretransitively on `\u03b1` if for any `x y` there is `g` such that `g \u2022 x = y`.\n A transitive action should furthermore have `\u03b1` nonempty.", "p": "mathlib"}, {"name": "add_monoid.End.apply_has_faithful_smul", "description": "`add_monoid.End.apply_distrib_mul_action` is faithful.", "p": "mathlib"}, {"name": "smul_mul_smul", "description": " Note that the `is_scalar_tower M \u03b1 \u03b1` and `smul_comm_class M \u03b1 \u03b1` typeclass arguments are\nusually satisfied by `algebra M \u03b1`.", "p": "mathlib"}, {"name": "function.End", "description": " The monoid of endomorphisms.\n\nNote that this is generalized by `category_theory.End` to categories other than `Type u`.", "p": "mathlib"}, {"name": "smul_smul", "description": "", "p": "mathlib"}, {"name": "vadd_zero_hom", "description": "If the additive action of `M` on `N` is compatible with addition on `N`, then\n`\u03bb x, x +\u1d65 0` is an additive monoid homomorphism from `M` to `N`.", "p": "mathlib"}, {"name": "monoid.to_mul_action", "description": " The regular action of a monoid on itself by left multiplication.\n\nThis is promoted to a module by `semiring.to_module`.", "p": "mathlib"}, {"name": "distrib_smul.to_add_monoid_hom", "description": "Each element of the scalars defines a additive monoid homomorphism.", "p": "mathlib"}, {"name": "vadd_zero_add", "description": "", "p": "mathlib"}, {"name": "of_mul_vadd", "description": "", "p": "mathlib"}, {"name": "vadd_zero_vadd", "description": "", "p": "mathlib"}, {"name": "has_vadd.comp", "description": "An additive action of `M` on `\u03b1` and a function `N \u2192 M` induces\n an additive action of `N` on `\u03b1`", "p": "mathlib"}, {"name": "function.End.apply_has_faithful_smul", "description": "`function.End.apply_mul_action` is faithful.", "p": "mathlib"}, {"name": "is_scalar_tower.op_left", "description": "", "p": "mathlib"}, {"name": "add_action.ext", "description": "", "p": "mathlib"}, {"name": "smul_comm_class.of_mul_smul_one", "description": "", "p": "mathlib"}, {"name": "mul_action.ext", "description": "", "p": "mathlib"}, {"name": "smul_assoc", "description": "", "p": "mathlib"}, {"name": "vadd_comm_class_self", "description": "", "p": "mathlib"}, {"name": "add_action.surjective_vadd", "description": "", "p": "mathlib"}, {"name": "add_group.int_smul_comm_class", "description": "", "p": "mathlib"}, {"name": "library_note.bundled maps over different rings", "description": "Frequently, we find ourselves wanting to express a bilinear map `M \u2192\u2097[R] N \u2192\u2097[R] P` or an\nequivalence between maps `(M \u2192\u2097[R] N) \u2243\u2097[R] (M' \u2192\u2097[R] N')` where the maps have an associated ring\n`R`. Unfortunately, using definitions like these requires that `R` satisfy `comm_semiring R`, and\nnot just `semiring R`. Using `M \u2192\u2097[R] N \u2192+ P` and `(M \u2192\u2097[R] N) \u2243+ (M' \u2192\u2097[R] N')` avoids this\nproblem, but throws away structure that is useful for when we _do_ have a commutative (semi)ring.\n\nTo avoid making this compromise, we instead state these definitions as `M \u2192\u2097[R] N \u2192\u2097[S] P` or\n`(M \u2192\u2097[R] N) \u2243\u2097[S] (M' \u2192\u2097[R] N')` and require `smul_comm_class S R` on the appropriate modules. When\nthe caller has `comm_semiring R`, they can set `S = R` and `smul_comm_class_self` will populate the\ninstance. If the caller only has `semiring R` they can still set either `R = \u2115` or `S = \u2115`, and\n`add_comm_monoid.nat_smul_comm_class` or `add_comm_monoid.nat_smul_comm_class'` will populate\nthe typeclass, which is still sufficient to recover a `\u2243+` or `\u2192+` structure.\n\nAn example of where this is used is `linear_map.prod_equiv`.", "p": "mathlib"}, {"name": "smul_zero_class.to_zero_hom", "description": "Each element of the scalars defines a zero-preserving map.", "p": "mathlib"}, {"name": "smul_one_smul", "description": "", "p": "mathlib"}, {"name": "mul_action.to_End_hom", "description": " The monoid hom representing a monoid action.\n\nWhen `M` is a group, see `mul_action.to_perm_hom`.", "p": "mathlib"}, {"name": "function.surjective.distrib_smul_left", "description": " Push forward the multiplication of `R` on `M` along a compatible surjective map `f : R \u2192 S`.\n\nSee also `function.surjective.distrib_mul_action_left`.", "p": "mathlib"}, {"name": "mul_action.to_fun", "description": "Embedding of `\u03b1` into functions `M \u2192 \u03b1` induced by a multiplicative action of `M` on `\u03b1`.", "p": "mathlib"}, {"name": "is_central_vadd", "description": " A typeclass indicating that the right (aka `add_opposite`) and left actions by `M` on `\u03b1` are\nequal, that is that `M` acts centrally on `\u03b1`. This can be thought of as a version of commutativity\nfor `+\u1d65`.", "p": "mathlib"}, {"name": "is_central_vadd.op_vadd_eq_vadd", "description": " A typeclass indicating that the right (aka `add_opposite`) and left actions by `M` on `\u03b1` are\nequal, that is that `M` acts centrally on `\u03b1`. This can be thought of as a version of commutativity\nfor `+\u1d65`.", "p": "mathlib"}, {"name": "add_monoid.to_add_action", "description": " The regular action of a monoid on itself by left addition.\n\nThis is promoted to an `add_torsor` by `add_group_is_add_torsor`.", "p": "mathlib"}, {"name": "add_action.is_pretransitive", "description": "`M` acts pretransitively on `\u03b1` if for any `x y` there is `g` such that `g +\u1d65 x = y`.\n A transitive action should furthermore have `\u03b1` nonempty.", "p": "mathlib"}, {"name": "add_action.is_pretransitive.exists_vadd_eq", "description": "`M` acts pretransitively on `\u03b1` if for any `x y` there is `g` such that `g +\u1d65 x = y`.\n A transitive action should furthermore have `\u03b1` nonempty.", "p": "mathlib"}, {"name": "mul_distrib_mul_action.to_monoid_End", "description": "Each element of the monoid defines a monoid homomorphism.", "p": "mathlib"}, {"name": "semigroup.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "has_vadd.comp.vadd_comm_class'", "description": "This cannot be an instance because it can cause infinite loops whenever\nthe `has_vadd` arguments are still metavariables.", "p": "mathlib"}, {"name": "has_vadd.comp.vadd", "description": "Auxiliary definition for `has_vadd.comp`, `add_action.comp_hom`, etc.", "p": "mathlib"}, {"name": "smul_comm_class.symm", "description": " Commutativity of actions is a symmetric relation. This lemma can't be an instance because this\nwould cause a loop in the instance search graph.", "p": "mathlib"}, {"name": "comp_smul_left", "description": "`has_smul` version of `comp_mul_left`", "p": "mathlib"}, {"name": "add_action.to_fun_apply", "description": "", "p": "mathlib"}, {"name": "vadd_comm_class.symm", "description": " Commutativity of additive actions is a symmetric relation. This lemma can't be an instance\nbecause this would cause a loop in the instance search graph.", "p": "mathlib"}, {"name": "vadd_assoc_class.of_vadd_zero_add", "description": "", "p": "mathlib"}, {"name": "mul_distrib_mul_action", "description": " Typeclass for multiplicative actions on multiplicative structures. This generalizes\nconjugation actions.", "p": "mathlib"}, {"name": "mul_distrib_mul_action.to_mul_action", "description": " Typeclass for multiplicative actions on multiplicative structures. This generalizes\nconjugation actions.", "p": "mathlib"}, {"name": "mul_distrib_mul_action.smul_mul", "description": " Typeclass for multiplicative actions on multiplicative structures. This generalizes\nconjugation actions.", "p": "mathlib"}, {"name": "mul_distrib_mul_action.smul_one", "description": " Typeclass for multiplicative actions on multiplicative structures. This generalizes\nconjugation actions.", "p": "mathlib"}, {"name": "multiplicative.add_action_is_pretransitive", "description": "", "p": "mathlib"}, {"name": "has_faithful_smul", "description": "Typeclass for faithful actions.", "p": "mathlib"}, {"name": "has_faithful_smul.eq_of_smul_eq_smul", "description": "Typeclass for faithful actions.", "p": "mathlib"}, {"name": "vadd_eq_add", "description": "", "p": "mathlib"}, {"name": "add_action.regular.is_pretransitive", "description": "The regular action of a group on itself is transitive.", "p": "mathlib"}, {"name": "has_smul.comp.smul_comm_class'", "description": "This cannot be an instance because it can cause infinite loops whenever the `has_smul` arguments\nare still metavariables.", "p": "mathlib"}, {"name": "is_central_scalar.unop_smul_eq_smul", "description": "", "p": "mathlib"}, {"name": "one_smul", "description": "", "p": "mathlib"}, {"name": "function.surjective.mul_action", "description": " Pushforward a multiplicative action along a surjective map respecting `\u2022`.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "function.injective.distrib_mul_action", "description": " Pullback a distributive multiplicative action along an injective additive monoid\nhomomorphism.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "add_vadd_zero", "description": "", "p": "mathlib"}, {"name": "mul_action.regular.is_pretransitive", "description": "The regular action of a group on itself is transitive.", "p": "mathlib"}, {"name": "add_vadd_comm", "description": "", "p": "mathlib"}, {"name": "mul_action", "description": "Typeclass for multiplicative actions by monoids. This generalizes group actions.", "p": "mathlib"}, {"name": "mul_action.to_has_smul", "description": "Typeclass for multiplicative actions by monoids. This generalizes group actions.", "p": "mathlib"}, {"name": "mul_action.one_smul", "description": "Typeclass for multiplicative actions by monoids. This generalizes group actions.", "p": "mathlib"}, {"name": "mul_action.mul_smul", "description": "Typeclass for multiplicative actions by monoids. This generalizes group actions.", "p": "mathlib"}, {"name": "smul_div'", "description": "", "p": "mathlib"}, {"name": "additive.has_vadd", "description": "", "p": "mathlib"}, {"name": "distrib_smul.ext", "description": "", "p": "mathlib"}, {"name": "function.injective.add_action", "description": "Pullback an additive action along an injective map respecting `+\u1d65`.", "p": "mathlib"}, {"name": "mul_action.comp_hom", "description": " A multiplicative action of `M` on `\u03b1` and a monoid homomorphism `N \u2192 M` induce\na multiplicative action of `N` on `\u03b1`.\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "add_action.of_End_hom", "description": " The additive action induced by a hom to `additive (function.End \u03b1)`\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "has_smul.comp.is_scalar_tower", "description": " Given a tower of scalar actions `M \u2192 \u03b1 \u2192 \u03b2`, if we use `has_smul.comp`\nto pull back both of `M`'s actions by a map `g : N \u2192 M`, then we obtain a new\ntower of scalar actions `N \u2192 \u03b1 \u2192 \u03b2`.\n\nThis cannot be an instance because it can cause infinite loops whenever the `has_smul` arguments\nare still metavariables.", "p": "mathlib"}, {"name": "one_smul_eq_id", "description": "`has_smul` version of `one_mul_eq_id`", "p": "mathlib"}, {"name": "function.surjective.distrib_mul_action_left", "description": " Push forward the action of `R` on `M` along a compatible surjective map `f : R \u2192* S`.\n\nSee also `function.surjective.mul_action_left` and `function.surjective.module_left`.", "p": "mathlib"}, {"name": "smul_neg", "description": "", "p": "mathlib"}, {"name": "smul_comm_class.op_right", "description": "", "p": "mathlib"}, {"name": "function.End.inhabited", "description": "", "p": "mathlib"}, {"name": "mul_smul_one", "description": "", "p": "mathlib"}, {"name": "add_semigroup.vadd_assoc_class", "description": "", "p": "mathlib"}, {"name": "distrib_mul_action.comp_hom", "description": " Compose a `distrib_mul_action` with a `monoid_hom`, with action `f r' \u2022 m`.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "add_action", "description": "Type class for additive monoid actions.", "p": "mathlib"}, {"name": "add_action.to_has_vadd", "description": "Type class for additive monoid actions.", "p": "mathlib"}, {"name": "add_action.zero_vadd", "description": "Type class for additive monoid actions.", "p": "mathlib"}, {"name": "add_action.add_vadd", "description": "Type class for additive monoid actions.", "p": "mathlib"}, {"name": "add_commute.vadd_left", "description": "", "p": "mathlib"}, {"name": "zero_vadd_eq_id", "description": "`has_vadd` version of `zero_add_eq_id`", "p": "mathlib"}, {"name": "ite_smul", "description": "", "p": "mathlib"}, {"name": "has_smul.comp.smul_comm_class", "description": "This cannot be an instance because it can cause infinite loops whenever the `has_smul` arguments\nare still metavariables.", "p": "mathlib"}, {"name": "zero_hom.smul_zero_class", "description": " Pushforward a zero-preserving scalar multiplication along a zero-preserving map.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "smul_left_injective'", "description": "", "p": "mathlib"}, {"name": "has_vadd.comp.vadd_assoc_class", "description": "Given a tower of additive actions `M \u2192 \u03b1 \u2192 \u03b2`, if we use\n`has_smul.comp` to pull back both of `M`'s actions by a map `g : N \u2192 M`, then we obtain a new tower\nof scalar actions `N \u2192 \u03b1 \u2192 \u03b2`.\n\nThis cannot be an instance because it can cause infinite loops whenever the `has_smul` arguments\nare still metavariables.", "p": "mathlib"}, {"name": "smul_one_hom", "description": " If the multiplicative action of `M` on `N` is compatible with multiplication on `N`, then\n`\u03bb x, x \u2022 1` is a monoid homomorphism from `M` to `N`.", "p": "mathlib"}, {"name": "distrib_smul.comp_fun", "description": " Compose a `distrib_smul` with a function, with scalar multiplication `f r' \u2022 m`.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "add_action.to_End_hom", "description": " The additive monoid hom representing an additive monoid action.\n\nWhen `M` is a group, see `add_action.to_perm_hom`.", "p": "mathlib"}, {"name": "smul_eq_mul", "description": "", "p": "mathlib"}, {"name": "function.injective.smul_zero_class", "description": " Pullback a zero-preserving scalar multiplication along an injective zero-preserving map.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "vadd_assoc_class.left", "description": "", "p": "mathlib"}, {"name": "comp_vadd_left", "description": "`has_vadd` version of `comp_add_left`", "p": "mathlib"}, {"name": "function.injective.mul_distrib_mul_action", "description": " Pullback a multiplicative distributive multiplicative action along an injective monoid\nhomomorphism.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "smul_mul_assoc", "description": "Note that the `is_scalar_tower \u03b1 \u03b2 \u03b2` typeclass argument is usually satisfied by `algebra \u03b1 \u03b2`.", "p": "mathlib"}, {"name": "add_monoid.nat_smul_comm_class'", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.smul_def", "description": "", "p": "mathlib"}, {"name": "vadd_vadd_vadd_comm", "description": "", "p": "mathlib"}, {"name": "vadd_comm_class.op_left", "description": "", "p": "mathlib"}, {"name": "has_mul.to_has_smul", "description": "See also `monoid.to_mul_action` and `mul_zero_class.to_smul_with_zero`.", "p": "mathlib"}, {"name": "mul_action.ext_iff", "description": "", "p": "mathlib"}, {"name": "mul_distrib_mul_action.comp_hom", "description": " Compose a `mul_distrib_mul_action` with a `monoid_hom`, with action `f r' \u2022 m`.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "has_add.to_has_vadd", "description": "See also `add_monoid.to_add_action`", "p": "mathlib"}, {"name": "has_faithful_vadd", "description": "Typeclass for faithful actions.", "p": "mathlib"}, {"name": "has_faithful_vadd.eq_of_vadd_eq_vadd", "description": "Typeclass for faithful actions.", "p": "mathlib"}, {"name": "has_vadd.comp.vadd_comm_class", "description": "This cannot be an instance because it can cause infinite loops whenever\nthe `has_vadd` arguments are still metavariables.", "p": "mathlib"}, {"name": "add_monoid.End.apply_distrib_mul_action", "description": " The tautological action by `add_monoid.End \u03b1` on `\u03b1`.\n\nThis generalizes `function.End.apply_mul_action`.", "p": "mathlib"}, {"name": "vadd_vadd", "description": "", "p": "mathlib"}, {"name": "smul_sub", "description": "", "p": "mathlib"}, {"name": "multiplicative.has_smul", "description": "", "p": "mathlib"}, {"name": "add_action.to_fun", "description": "Embedding of `\u03b1` into functions `M \u2192 \u03b1` induced by an additive action of `M` on `\u03b1`.", "p": "mathlib"}, {"name": "function.surjective.smul_zero_class_left", "description": " Push forward the multiplication of `R` on `M` along a compatible surjective map `f : R \u2192 S`.\n\nSee also `function.surjective.distrib_mul_action_left`.", "p": "mathlib"}, {"name": "smul_ite", "description": "", "p": "mathlib"}, {"name": "add_action.function_End", "description": "The tautological additive action by `additive (function.End \u03b1)` on `\u03b1`.", "p": "mathlib"}, {"name": "add_action.comp_hom", "description": " An additive action of `M` on `\u03b1` and an additive monoid homomorphism `N \u2192 M` induce\nan additive action of `N` on `\u03b1`.\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "smul_inv'", "description": "", "p": "mathlib"}, {"name": "is_central_scalar", "description": " A typeclass indicating that the right (aka `mul_opposite`) and left actions by `M` on `\u03b1` are\nequal, that is that `M` acts centrally on `\u03b1`. This can be thought of as a version of commutativity\nfor `\u2022`.", "p": "mathlib"}, {"name": "is_central_scalar.op_smul_eq_smul", "description": " A typeclass indicating that the right (aka `mul_opposite`) and left actions by `M` on `\u03b1` are\nequal, that is that `M` acts centrally on `\u03b1`. This can be thought of as a version of commutativity\nfor `\u2022`.", "p": "mathlib"}, {"name": "distrib_smul", "description": " Typeclass for scalar multiplication that preserves `0` and `+` on the right.\n\nThis is exactly `distrib_mul_action` without the `mul_action` part.", "p": "mathlib"}, {"name": "distrib_smul.to_smul_zero_class", "description": " Typeclass for scalar multiplication that preserves `0` and `+` on the right.\n\nThis is exactly `distrib_mul_action` without the `mul_action` part.", "p": "mathlib"}, {"name": "distrib_smul.smul_add", "description": " Typeclass for scalar multiplication that preserves `0` and `+` on the right.\n\nThis is exactly `distrib_mul_action` without the `mul_action` part.", "p": "mathlib"}, {"name": "of_add_smul", "description": "", "p": "mathlib"}, {"name": "function.surjective.distrib_smul", "description": " Pushforward a distributive scalar multiplication along a surjective additive monoid\nhomomorphism.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "smul_comm_class_self", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower", "description": " An instance of `is_scalar_tower M N \u03b1` states that the multiplicative\naction of `M` on `\u03b1` is determined by the multiplicative actions of `M` on `N`\nand `N` on `\u03b1`.", "p": "mathlib"}, {"name": "is_scalar_tower.smul_assoc", "description": " An instance of `is_scalar_tower M N \u03b1` states that the multiplicative\naction of `M` on `\u03b1` is determined by the multiplicative actions of `M` on `N`\nand `N` on `\u03b1`.", "p": "mathlib"}, {"name": "vadd_add_assoc", "description": "", "p": "mathlib"}, {"name": "add_commute.vadd_right", "description": "", "p": "mathlib"}, {"name": "vadd_comm_class.op_right", "description": "", "p": "mathlib"}, {"name": "mul_action.exists_smul_eq", "description": "", "p": "mathlib"}, {"name": "vadd_ite", "description": "", "p": "mathlib"}, {"name": "smul_zero", "description": "", "p": "mathlib"}, {"name": "commute.smul_right", "description": "", "p": "mathlib"}, {"name": "add_action.ext_iff", "description": "", "p": "mathlib"}, {"name": "mul_action.of_End_hom", "description": " The monoid action induced by a monoid hom to `function.End \u03b1`\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "function.End.smul_def", "description": "", "p": "mathlib"}, {"name": "additive.add_action", "description": "", "p": "mathlib"}, {"name": "zero_vadd", "description": "", "p": "mathlib"}, {"name": "multiplicative.mul_action", "description": "", "p": "mathlib"}, {"name": "mul_distrib_mul_action.to_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "mul_distrib_mul_action.to_monoid_hom", "description": "Scalar multiplication by `r` as a `monoid_hom`.", "p": "mathlib"}, {"name": "vadd_assoc_class.op_right", "description": "", "p": "mathlib"}, {"name": "ite_vadd", "description": "", "p": "mathlib"}, {"name": "vadd_assoc_class.op_left", "description": "", "p": "mathlib"}, {"name": "vadd_comm_class.of_add_vadd_zero", "description": "", "p": "mathlib"}, {"name": "is_central_vadd.unop_vadd_eq_vadd", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.of_smul_one_mul", "description": "", "p": "mathlib"}, {"name": "function.surjective.add_action_left", "description": "Push forward the action of `R` on `M` along a compatible\nsurjective map `f : R \u2192+ S`.", "p": "mathlib"}, {"name": "smul_zero_class.to_zero_hom_apply", "description": "", "p": "mathlib"}, {"name": "smul_comm_class", "description": "A typeclass mixin saying that two multiplicative actions on the same space commute.", "p": "mathlib"}, {"name": "smul_comm_class.smul_comm", "description": "A typeclass mixin saying that two multiplicative actions on the same space commute.", "p": "mathlib"}, {"name": "distrib_mul_action.to_distrib_smul", "description": "", "p": "mathlib"}, {"name": "distrib_smul.ext_iff", "description": "", "p": "mathlib"}, {"name": "mul_smul_comm", "description": "Note that the `smul_comm_class \u03b1 \u03b2 \u03b2` typeclass argument is usually satisfied by `algebra \u03b1 \u03b2`.", "p": "mathlib"}, {"name": "smul_one_mul", "description": "", "p": "mathlib"}, {"name": "module.to_mul_action_with_zero", "description": "A module over a semiring automatically inherits a `mul_action_with_zero` structure.", "p": "mathlib"}, {"name": "module.of_core", "description": " Define `module` without proving `zero_smul` and `smul_zero` by using an auxiliary\nstructure `module.core`, when the underlying space is an `add_comm_group`.", "p": "mathlib"}, {"name": "nat_smul_eq_nsmul", "description": " Convert back any exotic `\u2115`-smul to the canonical instance. This should not be needed since in\nmathlib all `add_comm_monoid`s should normally have exactly one `\u2115`-module structure by design.", "p": "mathlib"}, {"name": "map_rat_smul", "description": "", "p": "mathlib"}, {"name": "inv_nat_cast_smul_eq", "description": " If `E` is a vector space over two division semirings `R` and `S`, then scalar multiplications\nagree on inverses of natural numbers in `R` and `S`.", "p": "mathlib"}, {"name": "no_zero_smul_divisors", "description": " `no_zero_smul_divisors R M` states that a scalar multiple is `0` only if either argument is `0`.\nThis a version of saying that `M` is torsion free, without assuming `R` is zero-divisor free.\n\nThe main application of `no_zero_smul_divisors R M`, when `M` is a module,\nis the result `smul_eq_zero`: a scalar multiple is `0` iff either argument is `0`.\n\nIt is a generalization of the `no_zero_divisors` class to heterogeneous multiplication.", "p": "mathlib"}, {"name": "no_zero_smul_divisors.eq_zero_or_eq_zero_of_smul_eq_zero", "description": " `no_zero_smul_divisors R M` states that a scalar multiple is `0` only if either argument is `0`.\nThis a version of saying that `M` is torsion free, without assuming `R` is zero-divisor free.\n\nThe main application of `no_zero_smul_divisors R M`, when `M` is a module,\nis the result `smul_eq_zero`: a scalar multiple is `0` iff either argument is `0`.\n\nIt is a generalization of the `no_zero_divisors` class to heterogeneous multiplication.", "p": "mathlib"}, {"name": "neg_one_smul", "description": "", "p": "mathlib"}, {"name": "is_scalar_tower.rat", "description": "", "p": "mathlib"}, {"name": "smul_add_hom", "description": " A convenience alias for `module.to_add_monoid_End` as an `add_monoid_hom`, usually to allow the\nuse of `add_monoid_hom.flip`.", "p": "mathlib"}, {"name": "module.nontrivial", "description": "A semiring is `nontrivial` provided that there exists a nontrivial module over this semiring.", "p": "mathlib"}, {"name": "nat.no_zero_smul_divisors", "description": "", "p": "mathlib"}, {"name": "convex.combo_self", "description": "", "p": "mathlib"}, {"name": "ring_hom.to_module", "description": "A ring homomorphism `f : R \u2192+* M` defines a module structure by `r \u2022 x = f r * x`.", "p": "mathlib"}, {"name": "units.neg_smul", "description": "", "p": "mathlib"}, {"name": "module.ext", "description": "", "p": "mathlib"}, {"name": "module.comp_hom", "description": " Compose a `module` with a `ring_hom`, with action `f s \u2022 m`.\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "two_smul'", "description": "", "p": "mathlib"}, {"name": "subsingleton_rat_module", "description": "There can be at most one `module \u211a E` structure on an additive commutative group.", "p": "mathlib"}, {"name": "inv_int_cast_smul_eq", "description": " If `E` is a vector space over two division rings `R` and `S`, then scalar multiplications\nagree on inverses of integer numbers in `R` and `S`.", "p": "mathlib"}, {"name": "add_comm_monoid.nat_is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "module.eq_zero_of_zero_eq_one", "description": "", "p": "mathlib"}, {"name": "rat_module.no_zero_smul_divisors", "description": "", "p": "mathlib"}, {"name": "add_comm_group.int_is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "add_comm_group.int_module", "description": "", "p": "mathlib"}, {"name": "module.to_add_monoid_End_apply_apply", "description": "", "p": "mathlib"}, {"name": "neg_smul_neg", "description": "", "p": "mathlib"}, {"name": "convex.combo_eq_smul_sub_add", "description": "", "p": "mathlib"}, {"name": "map_inv_nat_cast_smul", "description": "", "p": "mathlib"}, {"name": "module.subsingleton", "description": " A module over a `subsingleton` semiring is a `subsingleton`. We cannot register this\nas an instance because Lean has no way to guess `R`.", "p": "mathlib"}, {"name": "function.surjective.module_left", "description": " Push forward the action of `R` on `M` along a compatible surjective map `f : R \u2192+* S`.\n\nSee also `function.surjective.mul_action_left` and `function.surjective.distrib_mul_action_left`.", "p": "mathlib"}, {"name": "semiring.to_opposite_module", "description": "Like `semiring.to_module`, but multiplies on the right.", "p": "mathlib"}, {"name": "ring_hom.apply_distrib_mul_action", "description": " The tautological action by `R \u2192+* R` on `R`.\n\nThis generalizes `function.End.apply_mul_action`.", "p": "mathlib"}, {"name": "add_comm_group.int_module.unique", "description": " All `\u2124`-module structures are equal. Not an instance since in mathlib all `add_comm_group`\nshould normally have exactly one `\u2124`-module structure by design.", "p": "mathlib"}, {"name": "ring_hom.apply_has_faithful_smul", "description": "`ring_hom.apply_distrib_mul_action` is faithful.", "p": "mathlib"}, {"name": "sub_smul", "description": "", "p": "mathlib"}, {"name": "add_smul", "description": "", "p": "mathlib"}, {"name": "module.to_add_monoid_End", "description": " `(\u2022)` as an `add_monoid_hom`.\n\nThis is a stronger version of `distrib_mul_action.to_add_monoid_End`", "p": "mathlib"}, {"name": "module", "description": "A module is a generalization of vector spaces to a scalar semiring.\n It consists of a scalar semiring `R` and an additive monoid of \"vectors\" `M`,\n connected by a \"scalar multiplication\" operation `r \u2022 x : M`\n (where `r : R` and `x : M`) with some natural associativity and\n distributivity axioms similar to those on a ring.", "p": "mathlib"}, {"name": "module.to_distrib_mul_action", "description": "A module is a generalization of vector spaces to a scalar semiring.\n It consists of a scalar semiring `R` and an additive monoid of \"vectors\" `M`,\n connected by a \"scalar multiplication\" operation `r \u2022 x : M`\n (where `r : R` and `x : M`) with some natural associativity and\n distributivity axioms similar to those on a ring.", "p": "mathlib"}, {"name": "module.add_smul", "description": "A module is a generalization of vector spaces to a scalar semiring.\n It consists of a scalar semiring `R` and an additive monoid of \"vectors\" `M`,\n connected by a \"scalar multiplication\" operation `r \u2022 x : M`\n (where `r : R` and `x : M`) with some natural associativity and\n distributivity axioms similar to those on a ring.", "p": "mathlib"}, {"name": "module.zero_smul", "description": "A module is a generalization of vector spaces to a scalar semiring.\n It consists of a scalar semiring `R` and an additive monoid of \"vectors\" `M`,\n connected by a \"scalar multiplication\" operation `r \u2022 x : M`\n (where `r : R` and `x : M`) with some natural associativity and\n distributivity axioms similar to those on a ring.", "p": "mathlib"}, {"name": "map_inv_int_cast_smul", "description": "", "p": "mathlib"}, {"name": "neg_eq_self", "description": "", "p": "mathlib"}, {"name": "inv_of_two_smul_add_inv_of_two_smul", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.nat_cast_def", "description": "", "p": "mathlib"}, {"name": "smul_eq_zero", "description": "", "p": "mathlib"}, {"name": "smul_ne_zero", "description": "", "p": "mathlib"}, {"name": "smul_comm_class.rat", "description": "", "p": "mathlib"}, {"name": "add_comm_monoid.nat_module.unique", "description": " All `\u2115`-module structures are equal. Not an instance since in mathlib all `add_comm_monoid`\nshould normally have exactly one `\u2115`-module structure by design.", "p": "mathlib"}, {"name": "group_with_zero.to_no_zero_smul_divisors", "description": "This instance applies to `division_semiring`s, in particular `nnreal` and `nnrat`.", "p": "mathlib"}, {"name": "map_rat_cast_smul", "description": "", "p": "mathlib"}, {"name": "ring_hom.smul_def", "description": "", "p": "mathlib"}, {"name": "function.injective.no_zero_smul_divisors", "description": "Pullback a `no_zero_smul_divisors` instance along an injective function.", "p": "mathlib"}, {"name": "smul_comm_class.rat'", "description": "", "p": "mathlib"}, {"name": "no_zero_divisors.to_no_zero_smul_divisors", "description": "", "p": "mathlib"}, {"name": "int.smul_one_eq_coe", "description": "", "p": "mathlib"}, {"name": "map_nat_cast_smul", "description": "", "p": "mathlib"}, {"name": "smul_left_injective", "description": "", "p": "mathlib"}, {"name": "smul_add_hom_apply", "description": "", "p": "mathlib"}, {"name": "inv_int_cast_smul_comm", "description": " If `E` is a vector space over a division ring `R` and has a monoid action by `\u03b1`, then that\naction commutes by scalar multiplication of inverses of integers in `R`", "p": "mathlib"}, {"name": "inv_nat_cast_smul_comm", "description": " If `E` is a vector space over a division ring `R` and has a monoid action by `\u03b1`, then that\naction commutes by scalar multiplication of inverses of natural numbers in `R`.", "p": "mathlib"}, {"name": "module.ext'", "description": "A variant of `module.ext` that's convenient for term-mode.", "p": "mathlib"}, {"name": "add_comm_monoid.nat_module", "description": "", "p": "mathlib"}, {"name": "function.surjective.module", "description": "Pushforward a `module` structure along a surjective additive monoid homomorphism.", "p": "mathlib"}, {"name": "smul_add_one_sub_smul", "description": "", "p": "mathlib"}, {"name": "neg_smul", "description": "", "p": "mathlib"}, {"name": "smul_right_inj", "description": "", "p": "mathlib"}, {"name": "module.core", "description": " A structure containing most informations as in a module, except the fields `zero_smul`\nand `smul_zero`. As these fields can be deduced from the other ones when `M` is an `add_comm_group`,\nthis provides a way to construct a module structure by checking less properties, in\n`module.of_core`.", "p": "mathlib"}, {"name": "module.core.to_has_smul", "description": " A structure containing most informations as in a module, except the fields `zero_smul`\nand `smul_zero`. As these fields can be deduced from the other ones when `M` is an `add_comm_group`,\nthis provides a way to construct a module structure by checking less properties, in\n`module.of_core`.", "p": "mathlib"}, {"name": "module.core.smul_add", "description": " A structure containing most informations as in a module, except the fields `zero_smul`\nand `smul_zero`. As these fields can be deduced from the other ones when `M` is an `add_comm_group`,\nthis provides a way to construct a module structure by checking less properties, in\n`module.of_core`.", "p": "mathlib"}, {"name": "module.core.add_smul", "description": " A structure containing most informations as in a module, except the fields `zero_smul`\nand `smul_zero`. As these fields can be deduced from the other ones when `M` is an `add_comm_group`,\nthis provides a way to construct a module structure by checking less properties, in\n`module.of_core`.", "p": "mathlib"}, {"name": "module.core.mul_smul", "description": " A structure containing most informations as in a module, except the fields `zero_smul`\nand `smul_zero`. As these fields can be deduced from the other ones when `M` is an `add_comm_group`,\nthis provides a way to construct a module structure by checking less properties, in\n`module.of_core`.", "p": "mathlib"}, {"name": "module.core.one_smul", "description": " A structure containing most informations as in a module, except the fields `zero_smul`\nand `smul_zero`. As these fields can be deduced from the other ones when `M` is an `add_comm_group`,\nthis provides a way to construct a module structure by checking less properties, in\n`module.of_core`.", "p": "mathlib"}, {"name": "rat_cast_smul_eq", "description": " If `E` is a vector space over two division rings `R` and `S`, then scalar multiplications\nagree on rational numbers in `R` and `S`.", "p": "mathlib"}, {"name": "neg_ne_self", "description": "", "p": "mathlib"}, {"name": "semiring.to_module", "description": "", "p": "mathlib"}, {"name": "add_monoid.End.int_cast_def", "description": "", "p": "mathlib"}, {"name": "nsmul_eq_smul_cast", "description": "`nsmul` is equal to any other module structure via a cast.", "p": "mathlib"}, {"name": "module.add_comm_monoid_to_add_comm_group", "description": " An `add_comm_monoid` that is a `module` over a `ring` carries a natural `add_comm_group`\nstructure.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "self_ne_neg", "description": "", "p": "mathlib"}, {"name": "smul_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "two_nsmul_eq_zero", "description": "", "p": "mathlib"}, {"name": "char_zero.of_module", "description": " If `M` is an `R`-module with one and `M` has characteristic zero, then `R` has characteristic\nzero as well. Usually `M` is an `R`-algebra.", "p": "mathlib"}, {"name": "module.ext_iff", "description": "", "p": "mathlib"}, {"name": "two_smul", "description": "", "p": "mathlib"}, {"name": "self_eq_neg", "description": "", "p": "mathlib"}, {"name": "function.injective.module", "description": " Pullback a `module` structure along an injective additive monoid homomorphism.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "smul_right_injective", "description": "", "p": "mathlib"}, {"name": "int_smul_eq_zsmul", "description": " Convert back any exotic `\u2124`-smul to the canonical instance. This should not be needed since in\nmathlib all `add_comm_group`s should normally have exactly one `\u2124`-module structure by design.", "p": "mathlib"}, {"name": "zsmul_eq_smul_cast", "description": "`zsmul` is equal to any other module structure via a cast.", "p": "mathlib"}, {"name": "map_int_cast_smul", "description": "", "p": "mathlib"}, {"name": "nat.smul_one_eq_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.equiv_of_nat_iso", "description": "Naturally isomorphic endofunctors give equivalent categories of coalgebras.\nFurthermore, they are equivalent as categories over `C`, that is,\nwe have `equiv_of_nat_iso h \u22d9 forget = forget`.", "p": "mathlib"}, {"name": "category_theory.endofunctor.adjunction.algebra.to_coalgebra_of", "description": " Given an adjunction `F \u22a3 G`, the functor that associates to an algebra over `F` a\ncoalgebra over `G` defined via adjunction applied to the structure map.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.iso_of_iso", "description": "A coalgebra morphism with an underlying isomorphism hom in `C` is a coalgebra isomorphism.", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.forget_reflects_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_id_inv_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.iso_mk_hom_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.hom", "description": "A morphism between algebras of endofunctor `F`", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.hom.f", "description": "A morphism between algebras of endofunctor `F`", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.hom.h'", "description": "A morphism between algebras of endofunctor `F`", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.comp_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_comp_hom_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.forget_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.hom.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.functor_of_nat_trans_eq", "description": "If `\u03b1` and `\u03b2` are two equal natural transformations, then the functors of algebras induced by them\nare isomorphic.\nWe define it like this as opposed to using `eq_to_iso` so that the components are nicer to prove\nlemmas about.", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.functor_of_nat_trans_comp_hom_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.comp_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans", "description": "From a natural transformation `\u03b1 : F \u2192 G` we get a functor from\ncoalgebras of `F` to coalgebras of `G`.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_id", "description": "The identity transformation induces the identity endofunctor on the category of coalgebras.", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.id_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.hom.h_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.functor_of_nat_trans", "description": "From a natural transformation `\u03b1 : G \u2192 F` we get a functor from\nalgebras of `F` to algebras of `G`.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.id_eq_id", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra", "description": "A coalgebra of an endofunctor; `str` stands for \"structure morphism\"", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.V", "description": "A coalgebra of an endofunctor; `str` stands for \"structure morphism\"", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.str", "description": "A coalgebra of an endofunctor; `str` stands for \"structure morphism\"", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.iso_mk_inv_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.adjunction.algebra.hom_equiv_naturality_str", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.hom.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_eq", "description": "If `\u03b1` and `\u03b2` are two equal natural transformations, then the functors of coalgebras induced by\nthem are isomorphic.\nWe define it like this as opposed to using `eq_to_iso` so that the components are nicer to prove\nlemmas about.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.category_theory.category_struct", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.functor_of_nat_trans_id_inv_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.hom.comp", "description": "The composition of morphisms between algebras of endofunctor `F`", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.forget_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.forget", "description": "The forgetful functor from the category of algebras, forgetting the algebraic structure.", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.category_theory.category", "description": "Algebras of an endofunctor `F` form a category", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_obj_str", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.epi_of_epi", "description": "An algebra morphism with an underlying epimorphism hom in `C` is an algebra epimorphism.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.hom.h_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.forget_map", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_comp", "description": "A composition of natural transformations gives the composition of corresponding functors.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.iso_mk_hom_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra", "description": "An algebra of an endofunctor; `str` stands for \"structure morphism\"", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.A", "description": "An algebra of an endofunctor; `str` stands for \"structure morphism\"", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.str", "description": "An algebra of an endofunctor; `str` stands for \"structure morphism\"", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.iso_mk", "description": "To construct an isomorphism of coalgebras, it suffices to give an isomorphism of the Vs which\ncommutes with the structure morphisms.", "p": "mathlib"}, {"name": "category_theory.endofunctor.adjunction.alg_coalg_equiv.unit_iso", "description": " Given an adjunction, assigning to an algebra over the left adjoint a coalgebra over its right\nadjoint and going back is isomorphic to the identity functor.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.forget_reflects_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.equiv_of_nat_iso_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.functor_of_nat_trans_obj_str", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.forget_faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.iso_mk", "description": "To construct an isomorphism of algebras, it suffices to give an isomorphism of the As which\ncommutes with the structure morphisms.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.forget_faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.category_theory.category_struct", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.initial.left_inv'", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.epi_of_epi", "description": "An algebra morphism with an underlying epimorphism hom in `C` is an algebra epimorphism.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.hom.comp", "description": "The composition of morphisms between algebras of endofunctor `F`", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.hom.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.mono_of_mono", "description": "An algebra morphism with an underlying monomorphism hom in `C` is an algebra monomorphism.", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.hom.id", "description": "The identity morphism of an algebra of endofunctor `F`", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.category_theory.category", "description": "Coalgebras of an endofunctor `F` form a category", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.hom.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.equiv_of_nat_iso_counit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_comp_inv_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.equiv_of_nat_iso", "description": "Naturally isomorphic endofunctors give equivalent categories of algebras.\nFurthermore, they are equivalent as categories over `C`, that is,\nwe have `equiv_of_nat_iso h \u22d9 forget = forget`.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.hom.ext_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.equiv_of_nat_iso_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.equiv_of_nat_iso_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.hom.h", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_eq_inv_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_eq_hom_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.functor_of_nat_trans_obj_V", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.initial.left_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.initial.str_is_iso", "description": "The structure map of the inital algebra is an isomorphism,\nhence endofunctors preserve their initial algebras", "p": "mathlib"}, {"name": "category_theory.endofunctor.algebra.iso_of_iso", "description": "An algebra morphism with an underlying isomorphism hom in `C` is an algebra isomorphism.", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.hom.id", "description": "The identity morphism of an algebra of endofunctor `F`", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.equiv_of_nat_iso_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.endofunctor.coalgebra.hom", "description": "A morphism 