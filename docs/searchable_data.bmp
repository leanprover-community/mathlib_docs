ear_ordered_add_comm_monoid.add", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid.add_assoc", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid.zero", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid.zero_add", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid.add_zero", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid.nsmul", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid.nsmul_zero'", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid.nsmul_succ'", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid.add_comm", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid.add_le_add_left", "description": "A linearly ordered additive commutative monoid.", "p": "mathlib"}, {"name": "has_add.to_covariant_class_left", "description": "", "p": "mathlib"}, {"name": "ordered_comm_monoid", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.mul", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.mul_assoc", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.one", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.one_mul", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.mul_one", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.npow", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.npow_zero'", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.npow_succ'", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.mul_comm", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.le", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.lt", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.le_refl", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.le_trans", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.lt_iff_le_not_le", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.le_antisymm", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "ordered_comm_monoid.mul_le_mul_left", "description": " An ordered commutative monoid is a commutative monoid\nwith a partial order such that `a \u2264 b \u2192 c * a \u2264 c * b` (multiplication is monotone)", "p": "mathlib"}, {"name": "linear_ordered_add_comm_monoid_with_top.to_has_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.least_ge", "description": "`least_ge f r n` is the stopping time corresponding to the first time `f \u2265 r`.", "p": "mathlib"}, {"name": "measure_theory.borel_cantelli.martingale_part_process_ae_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.bdd_above_iff_exists_tendsto_aux", "description": "", "p": "mathlib"}, {"name": "measure_theory.tendsto_sum_indicator_at_top_iff", "description": " An a.e. monotone adapted process `f` with uniformly bounded differences converges to `+\u221e` if\nand only if its predictable part also converges to `+\u221e`.", "p": "mathlib"}, {"name": "measure_theory.ae_mem_limsup_at_top_iff", "description": " **L\u00e9vy's generalization of the Borel-Cantelli lemma**: given a sequence of sets `s` and a\nfiltration `\u2131` such that for all `n`, `s n` is `\u2131 n`-measurable, `at_top.limsup s` is almost\neverywhere equal to the set for which `\u2211 k, \u2119(s (k + 1) | \u2131 k) = \u221e`.", "p": "mathlib"}, {"name": "measure_theory.borel_cantelli.predictable_part_process_ae_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.martingale.ae_not_tendsto_at_top_at_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.adapted.is_stopping_time_least_ge", "description": "", "p": "mathlib"}, {"name": "measure_theory.borel_cantelli.adapted_process", "description": "", "p": "mathlib"}, {"name": "measure_theory.least_ge_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.borel_cantelli.integrable_process", "description": "", "p": "mathlib"}, {"name": "measure_theory.least_ge_eq_min", "description": "", "p": "mathlib"}, {"name": "measure_theory.least_ge_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.exists_tendsto_of_abs_bdd_above_aux", "description": "This lemma is superceded by `submartingale.bdd_above_iff_exists_tendsto`.", "p": "mathlib"}, {"name": "measure_theory.tendsto_sum_indicator_at_top_iff'", "description": "", "p": "mathlib"}, {"name": "measure_theory.martingale.ae_not_tendsto_at_top_at_bot", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.stopped_value_least_ge_snorm_le'", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.bdd_above_iff_exists_tendsto", "description": " One sided martingale bound: If `f` is a submartingale which has uniformly bounded differences,\nthen for almost every `\u03c9`, `f n \u03c9` is bounded above (in `n`) if and only if it converges.", "p": "mathlib"}, {"name": "measure_theory.stopped_value_stopped_value_least_ge", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.stopped_value_least_ge_snorm_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.submartingale.stopped_value_least_ge", "description": "", "p": "mathlib"}, {"name": "measure_theory.borel_cantelli.process_difference_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.norm_stopped_value_least_ge_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.borel_cantelli.process_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.borel_cantelli.process", "description": " Auxiliary definition required to prove L\u00e9vy's generalization of the Borel-Cantelli lemmas for\nwhich we will take the martingale part.", "p": "mathlib"}, {"name": "measure_theory.martingale.bdd_above_range_iff_bdd_below_range", "description": "", "p": "mathlib"}, {"name": "category_theory.pullback_is_sheaf_of_cover_preserving", "description": "If `G` is cover-preserving and compatible-preserving,\nthen `G.op \u22d9 _` pulls sheaves back to sheaves.\n\nThis result is basically <https://stacks.math.columbia.edu/tag/00WW>.", "p": "mathlib"}, {"name": "category_theory.pullback_sheaf", "description": "The pullback of a sheaf along a cover-preserving and compatible-preserving functor.", "p": "mathlib"}, {"name": "category_theory.sites.pullback_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.sites.pullback_map_val", "description": "", "p": "mathlib"}, {"name": "category_theory.cover_preserving", "description": "A functor `G : (C, J) \u2964 (D, K)` between sites is *cover-preserving*\nif for all covering sieves `R` in `C`, `R.pushforward_functor G` is a covering sieve in `D`.", "p": "mathlib"}, {"name": "category_theory.cover_preserving.cover_preserve", "description": "A functor `G : (C, J) \u2964 (D, K)` between sites is *cover-preserving*\nif for all covering sieves `R` in `C`, `R.pushforward_functor G` is a covering sieve in `D`.", "p": "mathlib"}, {"name": "category_theory.cover_preserving.comp", "description": "The composition of two cover-preserving functors is cover-preserving.", "p": "mathlib"}, {"name": "category_theory.compatible_preserving.apply_map", "description": "", "p": "mathlib"}, {"name": "category_theory.compatible_preserving_of_downwards_closed", "description": "", "p": "mathlib"}, {"name": "category_theory.compatible_preserving_of_flat", "description": "", "p": "mathlib"}, {"name": "category_theory.sites.pullback", "description": "The induced functor from `Sheaf K A \u2964 Sheaf J A` given by `G.op \u22d9 _`\nif `G` is cover-preserving and compatible-preserving.", "p": "mathlib"}, {"name": "category_theory.presieve.family_of_elements.compatible.functor_pushforward", "description": "`compatible_preserving` functors indeed preserve compatible families.", "p": "mathlib"}, {"name": "category_theory.compatible_preserving", "description": "A functor `G : (C, J) \u2964 (D, K)` between sites is called compatible preserving if for each\ncompatible family of elements at `C` and valued in `G.op \u22d9 \u2131`, and each commuting diagram\n`f\u2081 \u226b G.map g\u2081 = f\u2082 \u226b G.map g\u2082`, `x g\u2081` and `x g\u2082` coincide when restricted via `f\u1d62`.\nThis is actually stronger than merely preserving compatible families because of the definition of\n`functor_pushforward` used.", "p": "mathlib"}, {"name": "category_theory.compatible_preserving.compatible", "description": "A functor `G : (C, J) \u2964 (D, K)` between sites is called compatible preserving if for each\ncompatible family of elements at `C` and valued in `G.op \u22d9 \u2131`, and each commuting diagram\n`f\u2081 \u226b G.map g\u2081 = f\u2082 \u226b G.map g\u2082`, `x g\u2081` and `x g\u2082` coincide when restricted via `f\u1d62`.\nThis is actually stronger than merely preserving compatible families because of the definition of\n`functor_pushforward` used.", "p": "mathlib"}, {"name": "category_theory.id_cover_preserving", "description": "The identity functor on a site is cover-preserving.", "p": "mathlib"}, {"name": "emetric.nonempty_compacts.complete_space", "description": " In a complete space, the type of nonempty compact subsets is complete. This follows\nfrom the same statement for closed subsets", "p": "mathlib"}, {"name": "emetric.closeds.compact_space", "description": "In a compact space, the type of closed subsets is compact.", "p": "mathlib"}, {"name": "emetric.continuous_inf_edist_Hausdorff_edist", "description": "The edistance to a closed set depends continuously on the point and the set", "p": "mathlib"}, {"name": "emetric.closeds.edist_eq", "description": "By definition, the edistance on `closeds \u03b1` is given by the Hausdorff edistance", "p": "mathlib"}, {"name": "metric.nonempty_compacts.metric_space", "description": " `nonempty_compacts \u03b1` inherits a metric space structure, as the Hausdorff\nedistance between two such sets is finite.", "p": "mathlib"}, {"name": "emetric.nonempty_compacts.emetric_space", "description": " In an emetric space, the type of non-empty compact subsets is an emetric space,\nwhere the edistance is the Hausdorff edistance", "p": "mathlib"}, {"name": "emetric.closeds.complete_space", "description": " In a complete space, the type of closed subsets is complete for the\nHausdorff edistance.", "p": "mathlib"}, {"name": "emetric.nonempty_compacts.to_closeds.uniform_embedding", "description": "`nonempty_compacts.to_closeds` is a uniform embedding (as it is an isometry)", "p": "mathlib"}, {"name": "emetric.closeds.emetric_space", "description": " In emetric spaces, the Hausdorff edistance defines an emetric space structure\non the type of closed subsets", "p": "mathlib"}, {"name": "emetric.nonempty_compacts.second_countable_topology", "description": "In a second countable space, the type of nonempty compact subsets is second countable", "p": "mathlib"}, {"name": "emetric.nonempty_compacts.compact_space", "description": " In a compact space, the type of nonempty compact subsets is compact. This follows from\nthe same statement for closed subsets", "p": "mathlib"}, {"name": "metric.uniform_continuous_inf_dist_Hausdorff_dist", "description": "", "p": "mathlib"}, {"name": "emetric.is_closed_subsets_of_is_closed", "description": "Subsets of a given closed subset form a closed set", "p": "mathlib"}, {"name": "metric.nonempty_compacts.dist_eq", "description": "The distance on `nonempty_compacts \u03b1` is the Hausdorff distance, by construction", "p": "mathlib"}, {"name": "emetric.nonempty_compacts.is_closed_in_closeds", "description": "The range of `nonempty_compacts.to_closeds` is closed in a complete space", "p": "mathlib"}, {"name": "metric.lipschitz_inf_dist", "description": "", "p": "mathlib"}, {"name": "metric.lipschitz_inf_dist_set", "description": "", "p": "mathlib"}, {"name": "ring.dimension_le_one.localization", "description": " Localizing a domain of Krull dimension `\u2264 1` gives another ring of Krull dimension `\u2264 1`.\n\nNote that the same proof can/should be generalized to preserving any Krull dimension,\nonce we have a suitable definition.", "p": "mathlib"}, {"name": "is_localization.is_dedekind_domain", "description": "The localization of a Dedekind domain is a Dedekind domain.", "p": "mathlib"}, {"name": "is_dedekind_domain.is_dedekind_domain_dvr", "description": " Dedekind domains, in the sense of Noetherian integrally closed domains of Krull dimension \u2264 1,\nare also Dedekind domains in the sense of Noetherian domains where the localization at every\nnonzero prime ideal is a DVR.", "p": "mathlib"}, {"name": "is_localization.at_prime.discrete_valuation_ring_of_dedekind_domain", "description": "In a Dedekind domain, the localization at every nonzero prime ideal is a DVR.", "p": "mathlib"}, {"name": "is_dedekind_domain_dvr", "description": "A Dedekind domain is an integral domain that is Noetherian, and the\nlocalization at every nonzero prime is a discrete valuation ring.\n\nThis is equivalent to `is_dedekind_domain`.\nTODO: prove the equivalence.", "p": "mathlib"}, {"name": "is_dedekind_domain_dvr.is_noetherian_ring", "description": "A Dedekind domain is an integral domain that is Noetherian, and the\nlocalization at every nonzero prime is a discrete valuation ring.\n\nThis is equivalent to `is_dedekind_domain`.\nTODO: prove the equivalence.", "p": "mathlib"}, {"name": "is_dedekind_domain_dvr.is_dvr_at_nonzero_prime", "description": "A Dedekind domain is an integral domain that is Noetherian, and the\nlocalization at every nonzero prime is a discrete valuation ring.\n\nThis is equivalent to `is_dedekind_domain`.\nTODO: prove the equivalence.", "p": "mathlib"}, {"name": "is_localization.at_prime.is_dedekind_domain", "description": "The localization of a Dedekind domain at every nonzero prime ideal is a Dedekind domain.", "p": "mathlib"}, {"name": "is_localization.at_prime.not_is_field", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_univ_iff", "description": "", "p": "mathlib"}, {"name": "topological_space.finite.to_noetherian_space", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space.Union", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space_iff_of_homeomorph", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space_of_surjective", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space.discrete", "description": "", "p": "mathlib"}, {"name": "topological_space.cofinite_topology.noetherian_space", "description": "", "p": "mathlib"}, {"name": "topological_space.inducing.noetherian_space", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space.is_compact", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space", "description": "Type class for noetherian spaces. It is defined to be spaces whose open sets satisfies ACC.", "p": "mathlib"}, {"name": "topological_space.noetherian_space.well_founded", "description": "Type class for noetherian spaces. It is defined to be spaces whose open sets satisfies ACC.", "p": "mathlib"}, {"name": "topological_space.noetherian_space.finite_irreducible_components", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space.finite", "description": "Spaces that are both Noetherian and Hausdorff is finite.", "p": "mathlib"}, {"name": "topological_space.noetherian_space.range", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space_tfae", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space.set", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space.compact_space", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space.exists_finset_irreducible", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space_set_iff", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space_iff_opens", "description": "", "p": "mathlib"}, {"name": "topological_space.noetherian_space_iff", "description": "", "p": "mathlib"}, {"name": "multiset.nodup.le_nsmul_iff_le", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_subset", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_eq_self", "description": "", "p": "mathlib"}, {"name": "multiset.le_dedup_self", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_singleton", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_cons_of_mem", "description": "", "p": "mathlib"}, {"name": "multiset.subset_dedup'", "description": "", "p": "mathlib"}, {"name": "multiset.nodup_dedup", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_bind_dedup", "description": "", "p": "mathlib"}, {"name": "multiset.mem_dedup", "description": "", "p": "mathlib"}, {"name": "multiset.count_dedup", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_cons_of_not_mem", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_ext", "description": "", "p": "mathlib"}, {"name": "multiset.subset_dedup", "description": "", "p": "mathlib"}, {"name": "multiset.coe_dedup", "description": "", "p": "mathlib"}, {"name": "multiset.nodup.dedup", "description": "**Alias** of the reverse direction of `multiset.dedup_eq_self`.", "p": "mathlib"}, {"name": "multiset.dedup_eq_zero", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_idempotent", "description": "", "p": "mathlib"}, {"name": "multiset.le_dedup", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_nsmul", "description": "", "p": "mathlib"}, {"name": "multiset.dedup", "description": "`dedup s` removes duplicates from `s`, yielding a `nodup` multiset.", "p": "mathlib"}, {"name": "multiset.dedup_zero", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_le", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_subset'", "description": "", "p": "mathlib"}, {"name": "multiset.nodup.le_dedup_iff_le", "description": "", "p": "mathlib"}, {"name": "multiset.dedup_map_dedup_eq", "description": "", "p": "mathlib"}, {"name": "le_cinfi_mul_cinfi", "description": "", "p": "mathlib"}, {"name": "mul_csupr_le", "description": "", "p": "mathlib"}, {"name": "le_add_cinfi", "description": "", "p": "mathlib"}, {"name": "le_cinfi_add", "description": "", "p": "mathlib"}, {"name": "csupr_mul_csupr_le", "description": "", "p": "mathlib"}, {"name": "le_cinfi_mul", "description": "", "p": "mathlib"}, {"name": "add_csupr_le", "description": "", "p": "mathlib"}, {"name": "csupr_mul_le", "description": "", "p": "mathlib"}, {"name": "le_cinfi_add_cinfi", "description": "", "p": "mathlib"}, {"name": "csupr_add_le", "description": "", "p": "mathlib"}, {"name": "csupr_add_csupr_le", "description": "", "p": "mathlib"}, {"name": "le_mul_cinfi", "description": "", "p": "mathlib"}, {"name": "tree.height_le_num_nodes", "description": "", "p": "mathlib"}, {"name": "tree.of_rbnode", "description": "Makes a `tree \u03b1` out of a red-black tree.", "p": "mathlib"}, {"name": "tree.left_node_right_eq_self", "description": "", "p": "mathlib"}, {"name": "tree.decidable_eq", "description": "", "p": "mathlib"}, {"name": "tree.unit_rec_on", "description": "Recursion on `tree unit`; allows for a better `induction` which does not have to worry\n about the element of type `\u03b1 = unit`", "p": "mathlib"}, {"name": "tree.left", "description": "The left child of the tree, or `nil` if the tree is `nil`", "p": "mathlib"}, {"name": "tree.map", "description": " Apply a function to each value in the tree.  This is the `map` function for the `tree` functor.\nTODO: implement `traversable tree`.", "p": "mathlib"}, {"name": "tree.has_reflect", "description": "", "p": "mathlib"}, {"name": "tree.repr", "description": "Construct a string representation of a tree. Provides a `has_repr` instance.", "p": "mathlib"}, {"name": "tree.num_leaves", "description": "The number of leaves of a binary tree", "p": "mathlib"}, {"name": "tree.get", "description": " Retrieves an element uniquely determined by a `pos_num` from the tree,\ntaking the following path to get to the element:\n- `bit0` - go to left child\n- `bit1` - go to right child\n- `pos_num.one` - retrieve from here", "p": "mathlib"}, {"name": "tree.index_of", "description": " Finds the index of an element in the tree assuming the tree has been\nconstructed according to the provided decidable order on its elements.\nIf it hasn't, the result will be incorrect. If it has, but the element\nis not in the tree, returns none.", "p": "mathlib"}, {"name": "tree.inhabited", "description": "", "p": "mathlib"}, {"name": "tree.num_nodes", "description": "The number of internal nodes (i.e. not including leaves) of a binary tree", "p": "mathlib"}, {"name": "tree.height", "description": "The height - length of the longest path from the root - of a binary tree", "p": "mathlib"}, {"name": "tree.right", "description": "The right child of the tree, or `nil` if the tree is `nil`", "p": "mathlib"}, {"name": "tree.num_leaves_pos", "description": "", "p": "mathlib"}, {"name": "tree.has_repr", "description": "", "p": "mathlib"}, {"name": "tree.get_or_else", "description": " Retrieves an element from the tree, or the provided default value\nif the index is invalid. See `tree.get`.", "p": "mathlib"}, {"name": "tree.num_leaves_eq_num_nodes_succ", "description": "", "p": "mathlib"}, {"name": "tree", "description": "A binary tree with values stored in non-leaf nodes.", "p": "mathlib"}, {"name": "tree.nil", "description": "A binary tree with values stored in non-leaf nodes.", "p": "mathlib"}, {"name": "tree.node", "description": "A binary tree with values stored in non-leaf nodes.", "p": "mathlib"}, {"name": "alg_hom.card", "description": "", "p": "mathlib"}, {"name": "field.exists_primitive_element_of_finite_top", "description": "**Primitive element theorem** assuming E is finite.", "p": "mathlib"}, {"name": "field.exists_primitive_element_of_finite_bot", "description": "Primitive element theorem for finite dimensional extension of a finite field.", "p": "mathlib"}, {"name": "field.exists_primitive_element", "description": "Primitive element theorem: a finite separable field extension `E` of `F` has a\n primitive element, i.e. there is an `\u03b1 \u2208 E` such that `F\u27ee\u03b1\u27ef = (\u22a4 : subalgebra F E)`.", "p": "mathlib"}, {"name": "field.primitive_element_inf_aux_exists_c", "description": "", "p": "mathlib"}, {"name": "field.power_basis_of_finite_of_separable", "description": " Alternative phrasing of primitive element theorem:\na finite separable field extension has a basis `1, \u03b1, \u03b1^2, ..., \u03b1^n`.\n\nSee also `exists_primitive_element`.", "p": "mathlib"}, {"name": "field.primitive_element_inf_aux", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_search.dir_pair.inhabited", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_search.explain_search_result", "description": "Trace a human-readable explanation in Lean code of a proof generated by rewrite search.\nEmit it as `\"Try this: <code>\"` with each successive line of code indented.", "p": "mathlib"}, {"name": "tactic.rewrite_search.using_conv.explain_rewrites", "description": "Explain a list of rewrites using `conv_x` tactics.", "p": "mathlib"}, {"name": "tactic.rewrite_search.dir_pair.has_to_string", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_search.proof_unit.rewrites", "description": "Construct a list of rewrites from a proof unit.", "p": "mathlib"}, {"name": "tactic.rewrite_search.dir_pair.get", "description": "Get one side of the pair, picking the side according to the direction.", "p": "mathlib"}, {"name": "tactic.rewrite_search.dir_pair.set", "description": "Set one side of the pair, picking the side according to the direction.", "p": "mathlib"}, {"name": "tactic.rewrite_search.using_conv.splice_result.inhabited", "description": "", "p": "mathlib"}, {"name": "tactic.rewrite_search.using_conv.splice_result", "description": "A data structure for the result of a splice operation.\nobstructed:  There was more of the addr to be added left, but we hit a rw\ncontained:   The added addr was already contained, and did not terminate at an existing rw\nnew:         The added addr terminated at an existing rw or we could create a new one for it", "p": "mathlib"}, {"name": "tactic.rewrite_search.using_conv.splice_result.obstructed", "description": "A data structure for the result of a splice operation.\nobstructed:  There was more of the addr to be added left, but we hit a rw\ncontained:   The added addr was already contained, and did not terminate at an existing rw\nnew:         The added addr terminated at an existing rw or we could create a new one for it", "p": "mathlib"}, {"name": "tactic.rewrite_search.using_conv.splice_result.contained", "description": "A data structure for the result of a splice operation.\nobstructed:  There was more of the addr to be added left, but we hit a rw\ncontained:   The added addr was already contained, and did not terminate at an existing rw\nnew:         The added addr terminated at an existing rw or we could create a new one for it", "p": "mathlib"}, {"name": "tactic.rewrite_search.using_conv.splice_result.new", "description": "A data structure for the result of a splice operation.\nobstructed:  There was more of the addr to be added left, but we hit a rw\ncontained:   The added addr was already contained, and did not terminate at an existing rw\nnew:         The added addr terminated at an existing rw or we could create a new one for it", "p": "mathlib"}, {"name": "tactic.rewrite_search.dir_pair", "description": "A `dir_pair` is a pair of items designed to be accessed according to\n`dir`, a \"direction\" defined in the `expr_lens` library.", "p": "mathlib"}, {"name": "tactic.rewrite_search.dir_pair.l", "description": "A `dir_pair` is a pair of items designed to be accessed according to\n`dir`, a \"direction\" defined in the `expr_lens` library.", "p": "mathlib"}, {"name": "tactic.rewrite_search.dir_pair.r", "description": "A `dir_pair` is a pair of items designed to be accessed according to\n`dir`, a \"direction\" defined in the `expr_lens` library.", "p": "mathlib"}, {"name": "tactic.rewrite_search.proof_unit.explain", "description": "Construct an explanation string from a proof unit.", "p": "mathlib"}, {"name": "tactic.rewrite_search.dir_pair.to_list", "description": "Convert the pair to a list of its elements.", "p": "mathlib"}, {"name": "tactic.rewrite_search.dir_pair.to_string", "description": "Convert the pair to a readable string format.", "p": "mathlib"}, {"name": "is_adic_complete.henselian_ring", "description": "A ring `R` that is `I`-adically complete is Henselian at `I`.", "p": "mathlib"}, {"name": "local_ring.maximal_ideal.henselian_ring", "description": "", "p": "mathlib"}, {"name": "henselian_ring", "description": " A ring `R` is *Henselian* at an ideal `I` if the following condition holds:\nfor every polynomial `f` over `R`, with a *simple* root `a\u2080` over the quotient ring `R/I`,\nthere exists a lift `a : R` of `a\u2080` that is a root of `f`.\n\n(Here, saying that a root `b` of a polynomial `g` is *simple* means that `g.derivative.eval b` is a\nunit. Warning: if `R/I` is not a field then it is not enough to assume that `g` has a factorization\ninto monic linear factors in which `X - b` shows up only once; for example `1` is not a simple root\nof `X^2-1` over `\u2124/4\u2124`.)", "p": "mathlib"}, {"name": "henselian_ring.jac", "description": " A ring `R` is *Henselian* at an ideal `I` if the following condition holds:\nfor every polynomial `f` over `R`, with a *simple* root `a\u2080` over the quotient ring `R/I`,\nthere exists a lift `a : R` of `a\u2080` that is a root of `f`.\n\n(Here, saying that a root `b` of a polynomial `g` is *simple* means that `g.derivative.eval b` is a\nunit. Warning: if `R/I` is not a field then it is not enough to assume that `g` has a factorization\ninto monic linear factors in which `X - b` shows up only once; for example `1` is not a simple root\nof `X^2-1` over `\u2124/4\u2124`.)", "p": "mathlib"}, {"name": "henselian_ring.is_henselian", "description": " A ring `R` is *Henselian* at an ideal `I` if the following condition holds:\nfor every polynomial `f` over `R`, with a *simple* root `a\u2080` over the quotient ring `R/I`,\nthere exists a lift `a : R` of `a\u2080` that is a root of `f`.\n\n(Here, saying that a root `b` of a polynomial `g` is *simple* means that `g.derivative.eval b` is a\nunit. Warning: if `R/I` is not a field then it is not enough to assume that `g` has a factorization\ninto monic linear factors in which `X - b` shows up only once; for example `1` is not a simple root\nof `X^2-1` over `\u2124/4\u2124`.)", "p": "mathlib"}, {"name": "is_local_ring_hom_of_le_jacobson_bot", "description": "", "p": "mathlib"}, {"name": "henselian_local_ring.tfae", "description": "", "p": "mathlib"}, {"name": "field.henselian", "description": "", "p": "mathlib"}, {"name": "henselian_local_ring", "description": " A local ring `R` is *Henselian* if the following condition holds:\nfor every polynomial `f` over `R`, with a *simple* root `a\u2080` over the residue field,\nthere exists a lift `a : R` of `a\u2080` that is a root of `f`.\n(Recall that a root `b` of a polynomial `g` is *simple* if it is not a double root, so if\n`g.derivative.eval b \u2260 0`.)\n\nIn other words, `R` is local Henselian if it is Henselian at the ideal `I`,\nin the sense of `henselian_ring`.", "p": "mathlib"}, {"name": "henselian_local_ring.to_local_ring", "description": " A local ring `R` is *Henselian* if the following condition holds:\nfor every polynomial `f` over `R`, with a *simple* root `a\u2080` over the residue field,\nthere exists a lift `a : R` of `a\u2080` that is a root of `f`.\n(Recall that a root `b` of a polynomial `g` is *simple* if it is not a double root, so if\n`g.derivative.eval b \u2260 0`.)\n\nIn other words, `R` is local Henselian if it is Henselian at the ideal `I`,\nin the sense of `henselian_ring`.", "p": "mathlib"}, {"name": "henselian_local_ring.is_henselian", "description": " A local ring `R` is *Henselian* if the following condition holds:\nfor every polynomial `f` over `R`, with a *simple* root `a\u2080` over the residue field,\nthere exists a lift `a : R` of `a\u2080` that is a root of `f`.\n(Recall that a root `b` of a polynomial `g` is *simple* if it is not a double root, so if\n`g.derivative.eval b \u2260 0`.)\n\nIn other words, `R` is local Henselian if it is Henselian at the ideal `I`,\nin the sense of `henselian_ring`.", "p": "mathlib"}, {"name": "rat.repr", "description": " String representation of a rational numbers, used in `has_repr`, `has_to_string`, and\n`has_to_format` instances.", "p": "mathlib"}, {"name": "rat", "description": "`rat`, or `\u211a`, is the type of rational numbers. It is defined\n as the set of pairs \u27e8n, d\u27e9 of integers such that `d` is positive and `n` and\n `d` are coprime. This representation is preferred to the quotient\n because without periodic reduction, the numerator and denominator can grow\n exponentially (for example, adding 1/2 to itself repeatedly).", "p": "mathlib"}, {"name": "rat.num", "description": "`rat`, or `\u211a`, is the type of rational numbers. It is defined\n as the set of pairs \u27e8n, d\u27e9 of integers such that `d` is positive and `n` and\n `d` are coprime. This representation is preferred to the quotient\n because without periodic reduction, the numerator and denominator can grow\n exponentially (for example, adding 1/2 to itself repeatedly).", "p": "mathlib"}, {"name": "rat.denom", "description": "`rat`, or `\u211a`, is the type of rational numbers. It is defined\n as the set of pairs \u27e8n, d\u27e9 of integers such that `d` is positive and `n` and\n `d` are coprime. This representation is preferred to the quotient\n because without periodic reduction, the numerator and denominator can grow\n exponentially (for example, adding 1/2 to itself repeatedly).", "p": "mathlib"}, {"name": "rat.pos", "description": "`rat`, or `\u211a`, is the type of rational numbers. It is defined\n as the set of pairs \u27e8n, d\u27e9 of integers such that `d` is positive and `n` and\n `d` are coprime. This representation is preferred to the quotient\n because without periodic reduction, the numerator and denominator can grow\n exponentially (for example, adding 1/2 to itself repeatedly).", "p": "mathlib"}, {"name": "rat.cop", "description": "`rat`, or `\u211a`, is the type of rational numbers. It is defined\n as the set of pairs \u27e8n, d\u27e9 of integers such that `d` is positive and `n` and\n `d` are coprime. This representation is preferred to the quotient\n because without periodic reduction, the numerator and denominator can grow\n exponentially (for example, adding 1/2 to itself repeatedly).", "p": "mathlib"}, {"name": "rat.ext", "description": "", "p": "mathlib"}, {"name": "rat.has_to_string", "description": "", "p": "mathlib"}, {"name": "rat.has_repr", "description": "", "p": "mathlib"}, {"name": "rat.ext_iff", "description": "", "p": "mathlib"}, {"name": "rat.has_to_format", "description": "", "p": "mathlib"}, {"name": "mem_intrinsic_frontier", "description": "", "p": "mathlib"}, {"name": "intrinsic_frontier_subset_frontier", "description": "", "p": "mathlib"}, {"name": "is_closed.intrinsic_closure", "description": "", "p": "mathlib"}, {"name": "intrinsic_frontier_subset_intrinsic_closure", "description": "", "p": "mathlib"}, {"name": "intrinsic_closure", "description": "The intrinsic closure of a set is its closure considered as a set in its affine span.", "p": "mathlib"}, {"name": "intrinsic_interior", "description": "The intrinsic interior of a set is its interior considered as a set in its affine span.", "p": "mathlib"}, {"name": "set.nonempty.intrinsic_interior", "description": "The intrinsic interior of a nonempty convex set is nonempty.", "p": "mathlib"}, {"name": "intrinsic_closure_diff_intrinsic_interior", "description": "", "p": "mathlib"}, {"name": "affine_span_intrinsic_closure", "description": "", "p": "mathlib"}, {"name": "intrinsic_closure_diff_intrinsic_frontier", "description": "", "p": "mathlib"}, {"name": "intrinsic_interior_singleton", "description": "", "p": "mathlib"}, {"name": "affine_isometry.image_intrinsic_closure", "description": "", "p": "mathlib"}, {"name": "affine_isometry.image_intrinsic_interior", "description": "", "p": "mathlib"}, {"name": "affine_isometry.image_intrinsic_frontier", "description": "", "p": "mathlib"}, {"name": "intrinsic_frontier_union_intrinsic_interior", "description": "", "p": "mathlib"}, {"name": "intrinsic_frontier_singleton", "description": "", "p": "mathlib"}, {"name": "set.nonempty.intrinsic_closure", "description": "**Alias** of the reverse direction of `intrinsic_closure_nonempty`.", "p": "mathlib"}, {"name": "intrinsic_interior_empty", "des