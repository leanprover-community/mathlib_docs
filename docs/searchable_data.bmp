: "mathlib"}, {"name": "category_theory.iso.inv_eq_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.trans_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.cancel_iso_inv_left", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.epi_of_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.inv_eq_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.refl_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.comp_inv_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.inv_hom_id_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.eq_inv_of_hom_inv_id", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.trans_symm", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso_of_hom_comp_eq_id", "description": "", "p": "mathlib"}, {"name": "category_theory.as_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.eq_comp_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.inv_ext'", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.mono_of_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_iso", "description": "A functor `F : C \u2964 D` sends isomorphisms `i : X \u2245 Y` to isomorphisms `F.obj X \u2245 F.obj Y`", "p": "mathlib"}, {"name": "category_theory.is_iso.id", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.self_symm_id_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.hom_eq_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.inv_hom_id", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.inv_eq_of_hom_inv_id", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.comp_inv_eq_id", "description": "", "p": "mathlib"}, {"name": "category_theory.inv_comp_eq_id", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.inv_comp_eq_id", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.trans_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_inv_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.symm_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.iso", "description": "An isomorphism (a.k.a. an invertible morphism) between two objects of a category.\nThe inverse morphism is bundled.\n\nSee also `category_theory.core` for the category with the same objects and isomorphisms playing\nthe role of morphisms.\n\nSee <https://stacks.math.columbia.edu/tag/0017>.", "p": "mathlib"}, {"name": "category_theory.iso.hom", "description": "An isomorphism (a.k.a. an invertible morphism) between two objects of a category.\nThe inverse morphism is bundled.\n\nSee also `category_theory.core` for the category with the same objects and isomorphisms playing\nthe role of morphisms.\n\nSee <https://stacks.math.columbia.edu/tag/0017>.", "p": "mathlib"}, {"name": "category_theory.iso.inv", "description": "An isomorphism (a.k.a. an invertible morphism) between two objects of a category.\nThe inverse morphism is bundled.\n\nSee also `category_theory.core` for the category with the same objects and isomorphisms playing\nthe role of morphisms.\n\nSee <https://stacks.math.columbia.edu/tag/0017>.", "p": "mathlib"}, {"name": "category_theory.iso.hom_inv_id'", "description": "An isomorphism (a.k.a. an invertible morphism) between two objects of a category.\nThe inverse morphism is bundled.\n\nSee also `category_theory.core` for the category with the same objects and isomorphisms playing\nthe role of morphisms.\n\nSee <https://stacks.math.columbia.edu/tag/0017>.", "p": "mathlib"}, {"name": "category_theory.iso.inv_hom_id'", "description": "An isomorphism (a.k.a. an invertible morphism) between two objects of a category.\nThe inverse morphism is bundled.\n\nSee also `category_theory.core` for the category with the same objects and isomorphisms playing\nthe role of morphisms.\n\nSee <https://stacks.math.columbia.edu/tag/0017>.", "p": "mathlib"}, {"name": "category_theory.iso.cancel_iso_hom_right_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.symm_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.comp_hom_eq_id", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.cancel_iso_hom_right", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_iso_trans", "description": "", "p": "mathlib"}, {"name": "category_theory.comp_hom_eq_id", "description": "", "p": "mathlib"}, {"name": "category_theory.eq_of_inv_eq_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.inv_eq_of_inv_hom_id", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_iso_symm", "description": "", "p": "mathlib"}, {"name": "category_theory.comp_inv_eq_id", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.hom_comp_eq_id", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.of_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.iso.inv_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.eq_inv_of_inv_hom_id", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_hom_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.comp_inv_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.of_is_iso_comp_left", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.symm", "description": "Inverse isomorphism.", "p": "mathlib"}, {"name": "category_theory.iso.symm_self_id", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.inv_is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.symm_symm_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.as_iso", "description": "Reinterpret a morphism `f` with an `is_iso f` instance as an `iso`.", "p": "mathlib"}, {"name": "category_theory.iso.trans_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.eq_comp_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso", "description": "`is_iso` typeclass expressing that a morphism is invertible.", "p": "mathlib"}, {"name": "category_theory.is_iso.out", "description": "`is_iso` typeclass expressing that a morphism is invertible.", "p": "mathlib"}, {"name": "category_theory.iso.cancel_iso_hom_left", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.inv_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.as_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.trans_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.hom_inv_id", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.inv_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.of_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.hom_inv_id_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.trans", "description": "Composition of two isomorphisms", "p": "mathlib"}, {"name": "category_theory.is_iso.iso.inv_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.inv_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.iso.cancel_iso_inv_right", "description": "", "p": "mathlib"}, {"name": "category_theory.is_iso.inv_hom_id_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.inv", "description": "The inverse of a morphism `f` when we have `[is_iso f]`.", "p": "mathlib"}, {"name": "monoid_hom.noncomm_pi_coprod_mul_single", "description": "", "p": "mathlib"}, {"name": "subgroup.commute_subtype_of_commute", "description": "", "p": "mathlib"}, {"name": "add_subgroup.noncomm_pi_coprod", "description": "The canonical homomorphism from a family of additive subgroups where elements from\ndifferent subgroups commute", "p": "mathlib"}, {"name": "monoid_hom.noncomm_pi_coprod", "description": "The canonical homomorphism from a family of monoids.", "p": "mathlib"}, {"name": "add_monoid_hom.noncomm_pi_coprod_range", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.independent_range_of_coprime_order", "description": "", "p": "mathlib"}, {"name": "subgroup.independent_of_coprime_order", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.noncomm_pi_coprod", "description": "The canonical homomorphism from a family of additive monoids.\n\nSee also `linear_map.lsum` for a linear version without the commutativity assumption.", "p": "mathlib"}, {"name": "monoid_hom.noncomm_pi_coprod_equiv", "description": "The universal property of `noncomm_pi_coprod`", "p": "mathlib"}, {"name": "monoid_hom.injective_noncomm_pi_coprod_of_independent", "description": "", "p": "mathlib"}, {"name": "subgroup.noncomm_pi_coprod_range", "description": "", "p": "mathlib"}, {"name": "add_subgroup.noncomm_pi_coprod_range", "description": "", "p": "mathlib"}, {"name": "monoid_hom.noncomm_pi_coprod_range", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.noncomm_pi_coprod_equiv", "description": "The universal property of `noncomm_pi_coprod`", "p": "mathlib"}, {"name": "add_subgroup.injective_noncomm_pi_coprod_of_independent", "description": "", "p": "mathlib"}, {"name": "subgroup.noncomm_pi_coprod", "description": " The canonical homomorphism from a family of subgroups where elements from different subgroups\ncommute", "p": "mathlib"}, {"name": "add_monoid_hom.noncomm_pi_coprod_single", "description": "", "p": "mathlib"}, {"name": "add_subgroup.eq_zero_of_noncomm_sum_eq_zero_of_independent", "description": "`finset.noncomm_sum` is \u201cinjective\u201d in `f` if `f` maps into independent subgroups.\nThis generalizes (one direction of) `add_subgroup.disjoint_iff_add_eq_zero`.", "p": "mathlib"}, {"name": "add_subgroup.noncomm_pi_coprod_single", "description": "", "p": "mathlib"}, {"name": "subgroup.injective_noncomm_pi_coprod_of_independent", "description": "", "p": "mathlib"}, {"name": "subgroup.noncomm_pi_coprod_mul_single", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.noncomm_pi_coprod_mrange", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.injective_noncomm_pi_coprod_of_independent", "description": "", "p": "mathlib"}, {"name": "monoid_hom.independent_range_of_coprime_order", "description": "", "p": "mathlib"}, {"name": "subgroup.eq_one_of_noncomm_prod_eq_one_of_independent", "description": " `finset.noncomm_prod` is \u201cinjective\u201d in `f` if `f` maps into independent subgroups.  This\ngeneralizes (one direction of) `subgroup.disjoint_iff_mul_eq_one`.", "p": "mathlib"}, {"name": "add_subgroup.commute_subtype_of_commute", "description": "", "p": "mathlib"}, {"name": "add_subgroup.independent_of_coprime_order", "description": "", "p": "mathlib"}, {"name": "monoid_hom.noncomm_pi_coprod_mrange", "description": "", "p": "mathlib"}, {"name": "valuation.self_le_supp_comap", "description": "", "p": "mathlib"}, {"name": "valuation.comap_on_quot_eq", "description": "", "p": "mathlib"}, {"name": "valuation.on_quot_val", "description": " If `hJ : J \u2286 supp v` then `on_quot_val hJ` is the induced function on R/J as a function.\nNote: it's just the function; the valuation is `on_quot hJ`.", "p": "mathlib"}, {"name": "add_valuation.supp_quot_supp", "description": "", "p": "mathlib"}, {"name": "add_valuation.supp_quot", "description": "The quotient valuation on R/J has support supp(v)/J if J \u2286 supp v.", "p": "mathlib"}, {"name": "add_valuation.on_quot", "description": "The extension of valuation v on R to valuation on R/J if J \u2286 supp v", "p": "mathlib"}, {"name": "add_valuation.comap_supp", "description": "", "p": "mathlib"}, {"name": "add_valuation.self_le_supp_comap", "description": "", "p": "mathlib"}, {"name": "valuation.on_quot", "description": "The extension of valuation v on R to valuation on R/J if J \u2286 supp v", "p": "mathlib"}, {"name": "add_valuation.comap_on_quot_eq", "description": "", "p": "mathlib"}, {"name": "valuation.on_quot_comap_eq", "description": "", "p": "mathlib"}, {"name": "add_valuation.on_quot_val", "description": " If `hJ : J \u2286 supp v` then `on_quot_val hJ` is the induced function on R/J as a function.\nNote: it's just the function; the valuation is `on_quot hJ`.", "p": "mathlib"}, {"name": "valuation.supp_quot", "description": "The quotient valuation on R/J has support supp(v)/J if J \u2286 supp v.", "p": "mathlib"}, {"name": "add_valuation.on_quot_comap_eq", "description": "", "p": "mathlib"}, {"name": "valuation.supp_quot_supp", "description": "", "p": "mathlib"}, {"name": "mul_finprod_cond_ne", "description": "", "p": "mathlib"}, {"name": "finprod_mem_mul_diff'", "description": " A more general version of `finprod_mem_mul_diff` that requires `t \u2229 mul_support f` rather than\n`t` to be finite.", "p": "mathlib"}, {"name": "finsum_eq_sum_of_support_subset", "description": "", "p": "mathlib"}, {"name": "finsum_mem_add_diff", "description": "Given a finite set `t` and a subset `s` of `t`, the sum of `f i` over `i \u2208 s` plus\nthe sum of `f i` over `t \\ s` equals the sum of `f i` over `i \u2208 t`.", "p": "mathlib"}, {"name": "finprod_mul_distrib", "description": " If the multiplicative supports of `f` and `g` are finite, then the product of `f i * g i` equals\nthe product of `f i` multiplied by the product of `g i`.", "p": "mathlib"}, {"name": "finsum_mem_insert'", "description": "A more general version of `finsum_mem_insert` that requires `s \u2229 support f` rather\nthan `s` to be finite.", "p": "mathlib"}, {"name": "sum_finsum_comm", "description": "", "p": "mathlib"}, {"name": "finprod_comp", "description": "See also `finprod_eq_of_bijective`, `fintype.prod_bijective` and `finset.prod_bij`.", "p": "mathlib"}, {"name": "single_le_finsum", "description": "", "p": "mathlib"}, {"name": "finprod_mem_eq_one_of_forall_eq_one", "description": "", "p": "mathlib"}, {"name": "finprod_unique", "description": "", "p": "mathlib"}, {"name": "finsum_mem_eq_sum_of_inter_support_eq", "description": "", "p": "mathlib"}, {"name": "finprod_mem_singleton", "description": "The product of `f i` over `i \u2208 {a}` equals `f a`.", "p": "mathlib"}, {"name": "add_monoid_hom.map_finsum_Prop", "description": "", "p": "mathlib"}, {"name": "finprod_dmem", "description": "", "p": "mathlib"}, {"name": "finprod_eq_prod_of_fintype", "description": "", "p": "mathlib"}, {"name": "finsum_nonneg", "description": "", "p": "mathlib"}, {"name": "finprod_mem_coe_finset", "description": "", "p": "mathlib"}, {"name": "finprod_mem_div_distrib", "description": " Given a finite set `s`, the product of `f i / g i` over `i \u2208 s` equals the product of `f i`\nover `i \u2208 s` divided by the product of `g i` over `i \u2208 s`.", "p": "mathlib"}, {"name": "finsum_of_infinite_support", "description": "", "p": "mathlib"}, {"name": "monoid_hom.map_finprod_of_injective", "description": "", "p": "mathlib"}, {"name": "finsum_dmem", "description": "", "p": "mathlib"}, {"name": "finprod_mem_eq_finite_to_finset_prod", "description": "", "p": "mathlib"}, {"name": "finprod_mem_of_eq_on_one", "description": "If a function `f` equals `1` on a set `s`, then the product of `f i` over `i \u2208 s` equals `1`.", "p": "mathlib"}, {"name": "finprod_nonneg", "description": "", "p": "mathlib"}, {"name": "finsum_mem_sUnion", "description": "If `t` is a finite set of pairwise disjoint finite sets, then the sum of `f a` over\n`a \u2208 \u22c3\u2080 t` is the sum over `s \u2208 t` of the sums of `f a` over `a \u2208 s`.", "p": "mathlib"}, {"name": "add_monoid_hom.map_finsum", "description": "", "p": "mathlib"}, {"name": "finsum_eq_sum_plift_of_support_subset", "description": "", "p": "mathlib"}, {"name": "nonempty_of_finprod_mem_ne_one", "description": "A set `s` is nonempty if the product of some function over `s` is not equal to `1`.", "p": "mathlib"}, {"name": "finprod_eq_one_of_forall_eq_one", "description": "", "p": "mathlib"}, {"name": "finprod_emb_domain", "description": "", "p": "mathlib"}, {"name": "finsum_mem_add_diff'", "description": "A more general version of `finsum_mem_add_diff` that requires `t \u2229 support f` rather\nthan `t` to be finite.", "p": "mathlib"}, {"name": "finsum_mem_eq_zero_of_forall_eq_zero", "description": "", "p": "mathlib"}, {"name": "finprod_mem_pair", "description": "The product of `f i` over `i \u2208 {a, b}`, `a \u2260 b`, is equal to `f a * f b`.", "p": "mathlib"}, {"name": "finprod_mem_congr", "description": "", "p": "mathlib"}, {"name": "monoid_hom.map_finprod_of_preimage_one", "description": "", "p": "mathlib"}, {"name": "finprod_eq_of_bijective", "description": "See `finprod_comp`, `fintype.prod_bijective` and `finset.prod_bij`.", "p": "mathlib"}, {"name": "finsum_true", "description": "", "p": "mathlib"}, {"name": "finsum_mem_image", "description": "The sum of `f y` over `y \u2208 g '' s` equals the sum of `f (g i)` over `s` provided that\n`g` is injective on `s`.", "p": "mathlib"}, {"name": "finprod_mem_inv_distrib", "description": "", "p": "mathlib"}, {"name": "finsum_eq_sum_of_support_to_finset_subset", "description": "", "p": "mathlib"}, {"name": "finprod_comp_equiv", "description": "", "p": "mathlib"}, {"name": "finsum_mem_insert", "description": "Given a finite set `s` and an element `a \u2209 s`, the sum of `f i` over `i \u2208 insert a s`\nequals `f a` plus the sum of `f i` over `i \u2208 s`.", "p": "mathlib"}, {"name": "finsum_cond_eq_left", "description": "", "p": "mathlib"}, {"name": "finsum_mem_inter_add_diff", "description": "", "p": "mathlib"}, {"name": "finsum_mem_eq_finite_to_finset_sum", "description": "", "p": "mathlib"}, {"name": "finsum_eq_single", "description": "", "p": "mathlib"}, {"name": "finsum_set_coe_eq_finsum_mem", "description": "", "p": "mathlib"}, {"name": "finsum_false", "description": "", "p": "mathlib"}, {"name": "finsum_eq_finset_sum_of_support_subset", "description": "", "p": "mathlib"}, {"name": "prod_finprod_comm", "description": "", "p": "mathlib"}, {"name": "finsum_curry\u2083", "description": "", "p": "mathlib"}, {"name": "finprod_curry", "description": "", "p": "mathlib"}, {"name": "finprod_cond_eq_left", "description": "", "p": "mathlib"}, {"name": "finsum_mem_image'", "description": "The sum of `f y` over `y \u2208 g '' s` equals the sum of `f (g i)` over `s` provided that\n`g` is injective on `s \u2229 support (f \u2218 g)`.", "p": "mathlib"}, {"name": "monoid_hom.map_finprod_mem'", "description": " A more general version of `monoid_hom.map_finprod_mem` that requires `s \u2229 mul_support f` rather\nthan `s` to be finite.", "p": "mathlib"}, {"name": "finset.mul_support_of_fiberwise_prod_subset_image", "description": "", "p": "mathlib"}, {"name": "finsum_mem_singleton", "description": "The sum of `f i` over `i \u2208 {a}` equals `f a`.", "p": "mathlib"}, {"name": "finprod_mem_mul_support", "description": "", "p": "mathlib"}, {"name": "finsum_zero", "description": "", "p": "mathlib"}, {"name": "finsum_eq_if", "description": "", "p": "mathlib"}, {"name": "finsum_mem_eq_of_bij_on", "description": "See also `finset.sum_bij`.", "p": "mathlib"}, {"name": "finprod_curry\u2083", "description": "", "p": "mathlib"}, {"name": "finprod_mem_union''", "description": " A more general version of `finprod_mem_union'` that requires `s \u2229 mul_support f` and\n`t \u2229 mul_support f` rather than `s` and `t` to be disjoint", "p": "mathlib"}, {"name": "finsum_add_distrib", "description": "If the additive supports of `f` and `g` are finite, then the sum of `f i + g i`\nequals the sum of `f i` plus the sum of `g i`.", "p": "mathlib"}, {"name": "finprod_set_coe_eq_finprod_mem", "description": "", "p": "mathlib"}, {"name": "finprod_mem_comm", "description": " If `s : set \u03b1` and `t : set \u03b2` are finite sets, then taking the product over `s` commutes with\ntaking the product over `t`.", "p": "mathlib"}, {"name": "finprod_mem_def", "description": "", "p": "mathlib"}, {"name": "finsum_mem_support", "description": "", "p": "mathlib"}, {"name": "finprod_eq_zero", "description": "", "p": "mathlib"}, {"name": "finsum_mem_union''", "description": "A more general version of `finsum_mem_union'` that requires `s \u2229 support f` and\n`t \u2229 support f` rather than `s` and `t` to be disjoint", "p": "mathlib"}, {"name": "finprod_mem_one", "description": "The product of the constant function `1` over any set equals `1`.", "p": "mathlib"}, {"name": "finsum_eq_sum_plift_of_support_to_finset_subset", "description": "", "p": "mathlib"}, {"name": "finsum_mem_eq_sum_filter", "description": "", "p": "mathlib"}, {"name": "finsum_mem_finset_product", "description": "See also `finsum_mem_finset_product'`.", "p": "mathlib"}, {"name": "finprod_mem_union_inter'", "description": " A more general version of `finprod_mem_union_inter` that requires `s \u2229 mul_support f` and\n`t \u2229 mul_support f` rather than `s` and `t` to be finite.", "p": "mathlib"}, {"name": "finprod_eq_single", "description": "", "p": "mathlib"}, {"name": "finsum_subtype_eq_finsum_cond", "description": "", "p": "mathlib"}, {"name": "finprod_false", "description": "", "p": "mathlib"}, {"name": "finsum_mem_eq_zero_of_infinite", "description": "", "p": "mathlib"}, {"name": "finsum_sum_comm", "description": "", "p": "mathlib"}, {"name": "finprod_true", "description": "", "p": "mathlib"}, {"name": "finprod_mem_eq_to_finset_prod", "description": "", "p": "mathlib"}, {"name": "finsum_congr_Prop", "description": "", "p": "mathlib"}, {"name": "finsum_nsmul", "description": "", "p": "mathlib"}, {"name": "finprod_mem_inter_mul_support_eq'", "description": "", "p": "mathlib"}, {"name": "finsum_mem_neg_distrib", "description": "", "p": "mathlib"}, {"name": "finsum_unique", "description": "", "p": "mathlib"}, {"name": "finsum_eq_of_bijective", "description": "See `finsum_comp`, `fintype.sum_bijective` and `finset.sum_bij`.", "p": "mathlib"}, {"name": "finprod_emb_domain'", "description": "", "p": "mathlib"}, {"name": "finsum_mem_insert_zero", "description": "If `f a = 0`, then the sum of `f i` over `i \u2208 insert a s` equals the sum of `f i`\nover `i \u2208 s`.", "p": "mathlib"}, {"name": "finsum_smul", "description": "", "p": "mathlib"}, {"name": "finsum_eq_sum_of_fintype", "description": "", "p": "mathlib"}, {"name": "finprod_mem_insert_one", "description": " If `f a = 1`, then the product of `f i` over `i \u2208 insert a s` equals the product of `f i` over\n`i \u2208 s`.", "p": "mathlib"}, {"name": "finsum_congr", "description": "", "p": "mathlib"}, {"name": "monoid_hom.map_finprod_plift", "description": "", "p": "mathlib"}, {"name": "monoid_hom.map_finprod", "description": "", "p": "mathlib"}, {"name": "finprod_mem_univ", "description": "", "p": "mathlib"}, {"name": "finprod_congr", "description": "", "p": "mathlib"}, {"name": "finprod_mem_eq_prod_of_inter_mul_support_eq", "description": "", "p": "mathlib"}, {"name": "finsum_curry", "description": "", "p": "mathlib"}, {"name": "finsum_mul", "description": "", "p": "mathlib"}, {"name": "finprod_mem_eq_prod_filter", "description": "", "p": "mathlib"}, {"name": "finsum_emb_domain'", "description": "", "p": "mathlib"}, {"name": "finprod_mem_eq_one_of_infinite", "description": "", "p": "mathlib"}, {"name": "finprod", "description": " Product of `f x` as `x` ranges over the elements of the multiplicative support of `f`, if it's\nfinite. One otherwise.", "p": "mathlib"}, {"name": "finsum_mem_pair", "description": "The sum of `f i` over `i \u2208 {a, b}`, `a \u2260 b`, is equal to `f a + f b`.", "p": "mathlib"}, {"name": "finsum_mem_range", "description": "The sum of `f y` over `y \u2208 set.range g` equals the sum of `f (g i)` over all `i`\nprovided that `g` is injective.", "p": "mathlib"}, {"name": "finprod_cond_eq_right", "description": "", "p": "mathlib"}, {"name": "finprod_mem_union'", "description": " A more general version of `finprod_mem_union` that requires `s \u2229 mul_support f` and\n`t \u2229 mul_support f` rather than `s` and `t` to be finite.", "p": "mathlib"}, {"name": "finsum_mem_eq_sum_of_subset", "description": "", "p": "mathlib"}, {"name": "finsum_mem_insert_of_eq_zero_if_not_mem", "description": "If `f a = 0` when `a \u2209 s`, then the sum of `f i` over `i \u2208 insert a s` equals the sum\nof `f i` over `i \u2208 s`.", "p": "mathlib"}, {"name": "finprod_mem_empty", "description": "The product of any function over an empty set is `1`.", "p": "mathlib"}, {"name": "finprod_one", "description": "", "p": "mathlib"}, {"name": "finprod_induction", "description": " To prove a property of a finite product, it suffices to prove that the property is\nmultiplicative and holds on the factors.", "p": "mathlib"}, {"name": "nonempty_of_finsum_mem_ne_zero", "description": "A set `s` is nonempty if the sum of some function over `s` is not equal to `0`.", "p": "mathlib"}, {"name": "finsum_cond_ne", "description": "", "p": "mathlib"}, {"name": "finsum_mem_def", "description": "", "p": "mathlib"}, {"name": "finsum_mem_Union", "description": "Given a family of pairwise disjoint finite sets `t i` indexed by a finite type, the\nsum of `f a` over the union `\u22c3 i, t i` is equal to the sum over all indexes `i` of the sums of `f a`\nover `a \u2208 t i`.", "p": "mathlib"}, {"name": "add_finsum_cond_ne", "description": "", "p": "mathlib"}, {"name": "finsum_induction", "description": "To prove a property of a finite sum, it suffices to prove that the property is\nadditive and holds on the summands.", "p": "mathlib"}, {"name": "finprod_mem_dvd", "description": " If the multiplicative support of `f` is finite, then for every `x` in the domain of `f`, `f x`\ndivides `finprod f`.", "p": "mathlib"}, {"name": "finsum_eq_zero_of_forall_eq_zero", "description": "", "p": "mathlib"}, {"name": "finprod_mem_inter_mul_support_eq", "description": "", "p": "mathlib"}, {"name": "finprod_mem_inter_mul_diff'", "description": "", "p": "mathlib"}, {"name": "finprod_mem_sUnion", "description": " If `t` is a finite set of pairwise disjoint finite sets, then the product of `f a`\nover `a \u2208 \u22c3\u2080 t` is the product over `s \u2208 t` of the products of `f a` over `a \u2208 s`.", "p": "mathlib"}, {"name": "finprod_mem_bUnion", "description": " Given a family of sets `t : \u03b9 \u2192 set \u03b1`, a finite set `I` in the index type such that all sets\n`t i`, `i \u2208 I`, are finite, if all `t i`, `i \u2208 I`, are pairwise disjoint, then the product of `f a`\nover `a \u2208 \u22c3 i \u2208 I, t i` is equal to the product over `i \u2208 I` of the products of `f a` over\n`a \u2208 t i`.", "p": "mathlib"}, {"name": "finsum_cond_eq_sum_of_cond_iff", "description": "", "p": "mathlib"}, {"name": "finsum_mem_eq_to_finset_sum", "description": "", "p": "mathlib"}, {"name": "finprod_mem_eq_of_bij_on", "description": "See also `finset.prod_bij`.", "p": "mathlib"}, {"name": "monoid_hom.map_finprod_mem", "description": " Given a monoid homomorphism `g : M \u2192* N` and a function `f : \u03b1 \u2192 M`, the value of `g` at the\nproduct of `f i` over `i \u2208 s` equals the product of `g (f i)` over `s`.", "p": "mathlib"}, {"name": "finsum_mem_empty", "description": "The sum of any function over an empty set is `0`.", "p": "mathlib"}, {"name": "single_le_finprod", "description": "", "p": "mathlib"}, {"name": "finsum_mem_sub_distrib", "description": "Given a finite set `s`, the sum of `f i / g i` over `i \u2208 s` equals the sum of `f i`\nover `i \u2208 s` minus the sum of `g i` over `i \u2208 s`.", "p": "mathlib"}, {"name": "finprod_eq_mul_indicator_apply", "description": "", "p": "mathlib"}, {"name": "finprod_mem_image", "description": " The product of `f y` over `y \u2208 g '' s` equals the product of `f (g i)` over `s` provided that\n`g` is injective on `s`.", "p": "mathlib"}, {"name": "finsum_mem_union_inter'", "description": "A more general version of `finsum_mem_union_inter` that requires `s \u2229 support f` and\n`t \u2229 support f` rather than `s` and `t` to be finite.", "p": "mathlib"}, {"name": "finprod_mem_finset_eq_prod", "description": "", "p": "mathlib"}, {"name": "finsum_eq_sum", "description": "", "p": "mathlib"}, {"name": "finsum_eq_dif", "description": "", "p": "mathlib"}, {"name": "finsum_sub_distrib", "description": "If the additive supports of `f` and `g` are finite, then the sum of `f i - g i`\nequals the sum of `f i` minus the sum of `g i`.", "p": "mathlib"}, {"name": "finprod_mem_insert", "description": " Given a finite set `s` and an element `a \u2209 s`, the product of `f i` over `i \u2208 insert a s` equals\n`f a` times the product of `f i` over `i \u2208 s`.", "p": "mathlib"}, {"name": "finprod_mem_union", "description": " Given two finite disjoint sets `s` and `t`, the product of `f i` over `i \u2208 s \u222a t` equals the\nproduct of `f i` over `i \u2208 s` times the product of `f i` over `i \u2208 t`.", "p": "mathlib"}, {"name": "finsum_mem_union_inter", "description": "Given finite sets `s` and `t`, the sum of `f i` over `i \u2208 s \u222a t` plus the sum of\n`f i` over `i \u2208 s \u2229 t` equals the sum of `f i` over `i \u2208 s` plus the sum of `f i` over `i \u2208 t`.", "p": "mathlib"}, {"name": "finprod_eq_if", "description": "", "p": "mathlib"}, {"name": "mul_equiv.map_finprod", "description": "", "p": "mathlib"}, {"name": "finsum_emb_domain", "description": "", "p": "mathlib"}, {"name": "exists_ne_one_of_finprod_mem_ne_one", "description": " If the product of `f i` over `i \u2208 s` is not equal to `1`, then there is some `x \u2208 s` such that\n`f x \u2260 1`.", "p": "mathlib"}, {"name": "finsum_mem_congr", "description": "", "p": "mathlib"}, {"name": "finprod_mem_eq_prod_of_subset", "description": "", "p": "mathlib"}, {"name": "finprod_inv_distrib", "description": "", "p": "mathlib"}, {"name": "finsum_mem_zero", "description": "The product of the constant function `0` over any set equals `0`.", "p": "mathlib"}, {"name": "finprod_eq_prod_of_mul_support_to_finset_subset", "description": "", "p": "mathlib"}, {"name": "finprod_mem_inter_mul_support", "description": "", "p": "mathlib"}, {"name": "finprod_of_is_empty", "description": "", "p": "mathlib"}, {"name": "finprod_eq_prod_of_mul_support_subset", "description": "", "p": "mathlib"}, {"name": "finprod_mem_range", "description": " The product of `f y` over `y \u2208 set.range g` equals the product of `f (g i)` over all `i`\nprovided that `g` is injective.", "p": "mathlib"}, {"name": "finsum_mem_inter_add_diff'", "description": "", "p": "mathlib"}, {"name": "finsum_eq_indicator_apply", "description": "", "p": "mathlib"}, {"name": "finprod_div_distrib", "description": " If the multiplicative supports of `f` and `g` are finite, then the product of `f i / g i`\nequals the product of `f i` divided by the product of `g i`.", "p": "mathlib"}, {"name": "add_monoid_hom.map_finsum_of_injective", "description": "", "p": "mathlib"}, {"name": "finsum_mem_union'", "description": "A more general version of `finsum_mem_union` that requires `s \u2229 support f` and\n`t \u2229 support f` rather than `s` and `t` to be finite.", "p": "mathlib"}, {"name": "finprod_mem_mul_distrib", "description": " Given a finite set `s`, the product of `f i * g i` over `i \u2208 s` equals the product of `f i`\nover `i \u2208 s` times the product of `g i` over `i \u2208 s`.", "p": "mathlib"}, {"name": "finprod_prod_comm", "description": "", "p": "mathlib"}, {"name": "finprod_cond_eq_prod_of_cond_iff", "description": "", "p": "mathlib"}, {"name": "finprod_of_infinite_mul_support", "description": "", "p": "mathlib"}, {"name": "finsum_mem_range'", "description": "The sum of `f y` over `y \u2208 set.range g` equals the sum of `f (g i)` over all `i`\nprovided that `g` is injective on `support (f \u2218 g)`.", "p": "mathlib"}, {"name": "finprod_mem_insert'", "description": " A more general version of `finprod_mem_insert` that requires `s \u2229 mul_support f` rather than `s`\nto be finite.", "p": "mathlib"}, {"name": "finprod_eq_prod_plift_of_mul_support_to_finset_subset", "description": "", "p": "mathlib"}, {"name": "finprod_mem_Union", "description": " Given a family of pairwise disjoint finite sets `t i` indexed by a finite type, the product of\n`f a` over the union `\u22c3 i, t i` is equal to the product over all indexes `i` of the products of\n`f a` over `a \u2208 t i`.", "p": "mathlib"}, {"name": "finprod_mem_mul_distrib'", "description": " A more general version of `finprod_mem_mul_distrib` that only requires `s \u2229 mul_support f` and\n`s \u2229 mul_support g` rather than `s` to be finite.", "p": "mathlib"}, {"name": "finprod_eq_finset_prod_of_mul_support_subset", "description": "", "p": "mathlib"}, {"name": "finsum_mem_add_distrib'", "description": "A more general version of `finsum_mem_add_distrib` that only requires `s \u2229 support f`\nand `s \u2229 support g` rather than `s` to be finite.", "p": "mathlib"}, {"name": "exists_ne_zero_of_finsum_mem_ne_zero", "description": "If the product of `f i` over `i \u2208 s` is not equal to `0`, then there is some `x \u2208 s`\nsuch that `f x \u2260 0`.", "p": "mathlib"}, {"name": "finsum_mem_univ", "description": "", "p": "mathlib"}, {"name": "finprod_eq_prod_plift_of_mul_support_subset", "description": "", "p": "mathlib"}, {"name": "finprod_mem_induction", "description": " To prove a property of a finite product, it suffices to prove that the property is\nmultiplicative and holds on factors.", "p": "mathlib"}, {"name": "finsum", "description": " Sum of `f x` as `x` ranges over the elements of the support of `f`, if it's finite. Zero\notherwise.", "p": "mathlib"}, {"name": "finprod_mem_mul_diff", "description": " Given a finite set `t` and a subset `s` of `t`, the product of `f i` over `i \u2208 s`\ntimes the product of `f i` over `t \\ s` equals the product of `f i` over `i \u2208 t`.", "p": "mathlib"}, {"name": "finsum_mem_comm", "description": "If `s : set \u03b1` and `t : set \u03b2` are finite sets, then summing over `s` commutes with\nsumming over `t`.", "p": "mathlib"}, {"name": "finprod_mem_image'", "description": " The product of `f y` over `y \u2208 g '' s` equals the product of `f (g i)` over `s`\nprovided that `g` is injective on `s \u2229 mul_support (f \u2218 g)`.", "p": "mathlib"}, {"name": "finsum_mem_eq_sum", "description": "", "p": "mathlib"}, {"name": "finsum_comp_equiv", "description": "", "p": "mathlib"}, {"name": "finset.support_of_fiberwise_sum_subset_image", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_finsum_of_preimage_zero", "description": "", "p": "mathlib"}, {"name": "finsum_mem_coe_finset", "description": "", "p": "mathlib"}, {"name": "finsum_of_is_empty", "description": "", "p": "mathlib"}, {"name": "finsum_mem_bUnion", "description": "Given a family of sets `t : \u03b9 \u2192 set \u03b1`, a finite set `I` in the index type such that\nall sets `t i`, `i \u2208 I`, are finite, if all `t i`, `i \u2208 I`, are pairwise disjoint, then the sum of\n`f a` over `a \u2208 \u22c3 i \u2208 I, t i` is equal to the sum over `i \u2208 I` of the sums of `f a` over\n`a \u2208 t i`.", "p": "mathlib"}, {"name": "finsum_mem_finset_eq_sum", "description": "", "p": "mathlib"}, {"name": "mul_equiv.map_finprod_mem", "description": "", "p": "mathlib"}, {"name": "finprod_cond_ne", "description": "", "p": "mathlib"}, {"name": "finsum_mem_inter_support", "description": "", "p": "mathlib"}, {"name": "finprod_mem_insert_of_eq_one_if_not_mem", "description": " If `f a = 1` when `a \u2209 s`, then the product of `f i` over `i \u2208 insert a s` equals the product of\n`f i` over `i \u2208 s`.", "p": "mathlib"}, {"name": "finprod_mem_union_inter", "description": " Given finite sets `s` and `t`, the product of `f i` over `i \u2208 s \u222a t` times the product of\n`f i` over `i \u2208 s \u2229 t` equals the product of `f i` over `i \u2208 s` times the product of `f i`\nover `i \u2208 t`.", "p": "mathlib"}, {"name": "finprod_def", "description": "", "p": "mathlib"}, {"name": "finsum_mem_of_eq_on_zero", "description": "If a function `f` equals `0` on a set `s`, then the product of `f i` over `i \u2208 s`\nequals `0`.", "p": "mathlib"}, {"name": "finsum_neg_distrib", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_finsum_plift", "description": "", "p": "mathlib"}, {"name": "finsum_mem_inter_support_eq", "description": "", "p": "mathlib"}, {"name": "finprod_eq_prod", "description": "", "p": "mathlib"}, {"name": "add_equiv.map_finsum", "description": "", "p": "mathlib"}, {"name": "finprod_congr_Prop", "description": "", "p": "mathlib"}, {"name": "finprod_eq_dif", "description": "", "p": "mathlib"}, {"name": "finsum_mem_inter_support_eq'", "description": "", "p": "mathlib"}, {"name": "finprod_pow", "description": "", "p": "mathlib"}, {"name": "finsum_mem_finset_product'", "description": "Note that `b \u2208 (s.filter (\u03bb ab, prod.fst ab = a)).image prod.snd` iff `(a, b) \u2208 s` so\nwe can simplify the right hand side of this lemma. However the form stated here is more useful for\niterating this lemma, e.g., if we have `f : \u03b1 \u00d7 \u03b2 \u00d7 \u03b3 \u2192 M`.", "p": "mathlib"}, {"name": "finsum_mem_union", "description": "Given two finite disjoint sets `s` and `t`, the sum of `f i` over `i \u2208 s \u222a t` equals\nthe sum of `f i` over `i \u2208 s` plus the sum of `f i` over `i \u2208 t`.", "p": "mathlib"}, {"name": "monoid_hom.map_finprod_Prop", "description": "", "p": "mathlib"}, {"name": "finsum_def", "description": "", "p": "mathlib"}, {"name": "finsum_mem_add_distrib", "description": "Given a finite set `s`, the sum of `f i + g i` over `i \u2208 s` equals the sum of `f i`\nover `i \u2208 s` plus the sum of `g i` over `i \u2208 s`.", "p": "mathlib"}, {"name": "finsum_mem_induction", "description": "To prove a property of a finite sum, it suffices to prove that the property is\nadditive and holds on summands.", "p": "mathlib"}, {"name": "finprod_mem_finset_product\u2083", "description": "", "p": "mathlib"}, {"name": "finprod_mem_eq_prod", "description": "", "p": "mathlib"}, {"name": "finsum_comp", "description": "See also `finsum_eq_of_bijective`, `fintype.sum_bijective` and `finset.sum_bij`.", "p": "mathlib"}, {"name": "finsum_mem_finset_product\u2083", "description": "", "p": "mathlib"}, {"name": "finprod_mem_range'", "description": " The product of `f y` over `y \u2208 set.range g` equals the product of `f (g i)` over all `i`\nprovided that `g` is injective on `mul_support (f \u2218 g)`.", "p": "mathlib"}, {"name": "add_monoid_hom.map_finsum_mem'", "description": "A more general version of `add_monoid_hom.map_finsum_mem` that requires\n`s \u2229 support f` rather than `s` to be finite.", "p": "mathlib"}, {"name": "finprod_cond_nonneg", "description": "", "p": "mathlib"}, {"name": "finsum_cond_eq_right", "description": "", "p": "mathlib"}, {"name": "smul_finsum", "description": "", "p": "mathlib"}, {"name": "add_equiv.map_finsum_mem", "description": "", "p": "mathlib"}, {"name": "one_le_finprod'", "description": "", "p": "mathlib"}, {"name": "finprod_mem_inter_mul_diff", "description": "", "p": "mathlib"}, {"name": "mul_finsum", "description": "", "p": "mathlib"}, {"name": "finprod_subtype_eq_finprod_cond", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_finsum_mem", "description": "Given an additive monoid homomorphism `g : M \u2192* N` and a function `f : \u03b1 \u2192 M`, the\nvalue of `g` at the sum of `f i` over `i \u2208 s` equals the sum of `g (f i)` over `s`.", "p": "mathlib"}, {"name": "finprod_mem_finset_product", "description": "See also `finprod_mem_finset_product'`.", "p": "mathlib"}, {"name": "finprod_mem_finset_product'", "description": " Note that `b \u2208 (s.filter (\u03bb ab, prod.fst ab = a)).image prod.snd` iff `(a, b) \u2208 s` so we can\nsimplify the right hand side of this lemma. However the form stated here is more useful for\niterating this lemma, e.g., if we have `f : \u03b1 \u00d7 \u03b2 \u00d7 \u03b3 \u2192 M`.", "p": "mathlib"}, {"name": "clifford_algebra.involute_involutive", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse_comp_reverse", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.involute_mem_even_odd_iff", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.even_odd_comap_reverse", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.involute_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse_involute_commute", "description": " `clifford_algebra.reverse` and `clifford_algebra.inverse` commute. Note that the composition\nis sometimes referred to as the \"clifford conjugate\".", "p": "mathlib"}, {"name": "clifford_algebra.involute", "description": "Grade involution, inverting the sign of each basis vector.", "p": "mathlib"}, {"name": "clifford_algebra.involute_involute", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse_\u03b9", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.submodule_map_involute_eq_comap", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.involute_prod_map_\u03b9", "description": " Taking the involute of the product a list of $n$ vectors lifted via `\u03b9` is equivalent to\npremultiplying by ${-1}^n$.", "p": "mathlib"}, {"name": "clifford_algebra.submodule_map_reverse_eq_comap", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.involute_comp_involute", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.submodule_map_mul_reverse", "description": "Like `submodule.map_mul`, but with the multiplication reversed.", "p": "mathlib"}, {"name": "clifford_algebra.involute_eq_of_mem_odd", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.involute_equiv_apply", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.involute_eq_of_mem_even", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.\u03b9_range_comap_involute", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.submodule_comap_mul_reverse", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.even_odd_map_involute", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.involute_equiv", "description": "`clifford_algebra.involute` as an `alg_equiv`.", "p": "mathlib"}, {"name": "clifford_algebra.reverse_equiv", "description": "`clifford_algebra.reverse` as a `linear_equiv`.", "p": "mathlib"}, {"name": "clifford_algebra.reverse_prod_map_\u03b9", "description": " Taking the reverse of the product a list of $n$ vectors lifted via `\u03b9` is equivalent to\ntaking the product of the reverse of that list.", "p": "mathlib"}, {"name": "clifford_algebra.reverse_mem_even_odd_iff", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse.map_one", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.involute_\u03b9", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse.map_mul", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.\u03b9_range_map_involute", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse.commutes", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.submodule_comap_pow_reverse", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.\u03b9_range_map_reverse", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.even_odd_comap_involute", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse_involutive", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse", "description": " Grade reversion, inverting the multiplication order of basis vectors.\nAlso called *transpose* in some literature.", "p": "mathlib"}, {"name": "clifford_algebra.reverse_reverse", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse_involute", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.submodule_map_pow_reverse", "description": "Like `submodule.map_pow`", "p": "mathlib"}, {"name": "clifford_algebra.even_odd_map_reverse", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse_equiv_apply", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.\u03b9_range_comap_reverse", "description": "", "p": "mathlib"}, {"name": "clifford_algebra.reverse_comp_involute", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.lt_map_of_int_lt_translation_number", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.translate_zpow", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.sup_apply", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.map_sub_nat", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.le_map_of_map_zero", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.map_sub_int", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.tendsto_translation_number\u2080'", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.tendsto_translation_number\u2080", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.translation_number_pow", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.map_map_zero_le", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.le_translation_number_of_add_le", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.ext", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.map_lt_of_translation_number_lt_int", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.le_ceil_map_map_zero", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.tendsto_translation_number'", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.translation_number_eq_int_iff", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.transnum_aux_seq_def", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.transnum_aux_seq_zero", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.floor_sub_le_translation_number", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.inf_apply", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.monotone", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.units_coe", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.translate_iterate", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.semiconj_of_bijective_of_translation_number_eq", "description": " If two lifts of circle homeomorphisms have the same translation number, then they are\nsemiconjugate by a `circle_deg1_lift`. This version uses assumptions `bijective f\u2081` and\n`bijective f\u2082` to assume that `f\u2081` and `f\u2082` are homeomorphisms.", "p": "mathlib"}, {"name": "circle_deg1_lift.mul_apply", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.dist_pow_map_zero_mul_translation_number_le", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.map_map_zero_lt", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.dist_map_zero_lt_of_semiconj_by", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.lattice", "description": "Monotone circle maps form a lattice with respect to the pointwise order", "p": "mathlib"}, {"name": "circle_deg1_lift.iterate_pos_eq_iff", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.map_lt_of_translation_number_lt_nat", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.units_inv_apply_apply", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.pow_monotone", "description": "", "p": "mathlib"}, {"name": "circle_deg1_lift.translation_number_eq_of_semiconj", "description": "", "p": "mathlib"}, {"name": "circle_de