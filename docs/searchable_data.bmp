[{"name": "elliptic_curve.coe_inv_base_change_\u0394'", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change", "description": "The Weierstrass curve over `R` base changed to `A`.", "p": "mathlib"}, {"name": "weierstrass_curve.nonsingular_of_\u0394_ne_zero", "description": "A Weierstrass curve is nonsingular at every point if its discriminant is non-zero.", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_self", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.ext_iff", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_b\u2084", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.two_torsion_polynomial_disc_ne_zero", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.equation", "description": "The proposition that an affine point $(x, y)$ lies in `W`. In other words, $W(x, y) = 0$.", "p": "mathlib"}, {"name": "weierstrass_curve.equation_iff", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.smul_basis_mul_C", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.basis_apply", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.variable_change", "description": " The elliptic curve over `R` induced by an admissible linear change of variables\n$(X, Y) \\mapsto (u^2X + r, u^3Y + u^2sX + t)$ for some $u \\in R^\\times$ and some $r, s, t \\in R$.\nWhen `R` is a field, any two Weierstrass equations isomorphic to `E` are related by this.", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.algebra", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.smul_basis_eq_zero", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.Y_ideal", "description": "The ideal $\\langle Y - y(X) \\rangle$ of $R[W]$ for some $y(X) \\in R[X]$.", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.coe_basis", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.c_relation", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_a\u2083", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_a\u2081", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.j", "description": "The j-invariant `j` of an elliptic curve, which is invariant under isomorphisms over `R`.", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.X_class", "description": "The class of the element $X - x$ in $R[W]$ for some $x \\in R$.", "p": "mathlib"}, {"name": "weierstrass_curve.nonsingular_iff'", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.b_relation", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_c\u2084", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.polynomial_Y", "description": " The partial derivative $W_Y(X, Y)$ of $W(X, Y)$ with respect to $Y$.\n\nTODO: define this in terms of `polynomial.derivative`.", "p": "mathlib"}, {"name": "weierstrass_curve", "description": "A Weierstrass curve $Y^2 + a_1XY + a_3Y = X^3 + a_2X^2 + a_4X + a_6$ with parameters $a_i$.", "p": "mathlib"}, {"name": "weierstrass_curve.a\u2081", "description": "A Weierstrass curve $Y^2 + a_1XY + a_3Y = X^3 + a_2X^2 + a_4X + a_6$ with parameters $a_i$.", "p": "mathlib"}, {"name": "weierstrass_curve.a\u2082", "description": "A Weierstrass curve $Y^2 + a_1XY + a_3Y = X^3 + a_2X^2 + a_4X + a_6$ with parameters $a_i$.", "p": "mathlib"}, {"name": "weierstrass_curve.a\u2083", "description": "A Weierstrass curve $Y^2 + a_1XY + a_3Y = X^3 + a_2X^2 + a_4X + a_6$ with parameters $a_i$.", "p": "mathlib"}, {"name": "weierstrass_curve.a\u2084", "description": "A Weierstrass curve $Y^2 + a_1XY + a_3Y = X^3 + a_2X^2 + a_4X + a_6$ with parameters $a_i$.", "p": "mathlib"}, {"name": "weierstrass_curve.a\u2086", "description": "A Weierstrass curve $Y^2 + a_1XY + a_3Y = X^3 + a_2X^2 + a_4X + a_6$ with parameters $a_i$.", "p": "mathlib"}, {"name": "weierstrass_curve.inhabited", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.polynomial_eq", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.variable_change_j", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.basis", "description": " The basis $\\{1, Y\\}$ for the coordinate ring $R[W]$ over the polynomial ring $R[X]$.\n\nGiven a Weierstrass curve `W`, write `W^.coordinate_ring.basis` for this basis.", "p": "mathlib"}, {"name": "weierstrass_curve.two_torsion_polynomial_disc_is_unit", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_a\u2083", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.b\u2088", "description": "The `b\u2088` coefficient of a Weierstrass curve.", "p": "mathlib"}, {"name": "elliptic_curve.ext_iff", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.nat_degree_norm_ne_one", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.XY_ideal", "description": "The ideal $\\langle X - x, Y - y(X) \\rangle$ of $R[W]$ for some $x \\in R$ and $y(X) \\in R[X]$.", "p": "mathlib"}, {"name": "weierstrass_curve.c\u2086", "description": "The `c\u2086` coefficient of a Weierstrass curve.", "p": "mathlib"}, {"name": "weierstrass_curve.equation_iff_variable_change", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.X_ideal", "description": "The ideal $\\langle X - x \\rangle$ of $R[W]$ for some $x \\in R$.", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_a\u2084", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.variable_change_to_weierstrass_curve", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.eval_polynomial_zero", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.nonsingular_iff_base_change_of_base_change", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.Y_class_ne_zero", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.two_torsion_polynomial_disc_ne_zero", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.b\u2086", "description": "The `b\u2086` coefficient of a Weierstrass curve.", "p": "mathlib"}, {"name": "weierstrass_curve.nonsingular_iff_variable_change", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.equation_iff_base_change", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.is_domain", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_a\u2082", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring", "description": " The coordinate ring $R[W] := R[X, Y] / \\langle W(X, Y) \\rangle$ of `W`.\n\nNote that `derive comm_ring` generates a reducible instance of `comm_ring` for `coordinate_ring`.\nIn certain circumstances this might be extremely slow, because all instances in its definition are\nunified exponentially many times. In this case, one solution is to manually add the local attribute\n`local attribute [irreducible] coordinate_ring.comm_ring` to block this type-level unification.\n\nTODO Lean 4: verify if the new def-eq cache (lean4#1102) fixed this issue.\n\nSee Zulip thread:\nhttps://leanprover.zulipchat.com/#narrow/stream/116395-maths/topic/.E2.9C.94.20class_group.2Emk", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_a\u2086", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_b\u2082", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.coe_base_change_\u0394'", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.basis_zero", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.coe_inv_variable_change_\u0394'", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.equation_zero", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.quotient_XY_ideal_equiv", "description": " The $R$-algebra isomorphism from $R[W] / \\langle X - x, Y - y(X) \\rangle$ to $R$ obtained by\nevaluation at $y(X)$ and at $x$ provided that $W(x, y(x)) = 0$.", "p": "mathlib"}, {"name": "weierstrass_curve.b\u2082", "description": "The `b\u2082` coefficient of a Weierstrass curve.", "p": "mathlib"}, {"name": "weierstrass_curve.eval_polynomial", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change", "description": " The Weierstrass curve over `R` induced by an admissible linear change of variables\n$(X, Y) \\mapsto (u^2X + r, u^3Y + u^2sX + t)$ for some $u \\in R^\\times$ and some $r, s, t \\in R$.", "p": "mathlib"}, {"name": "weierstrass_curve.nonsingular_zero", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_a\u2086", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.subsingleton", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.norm_smul_basis", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.eval_polynomial_X_zero", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.nonsingular", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.smul", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.nonsingular_iff", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.ext", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.b\u2084", "description": "The `b\u2084` coefficient of a Weierstrass curve.", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.coe_norm_smul_basis", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.is_domain_of_field", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_a\u2084", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.degree_polynomial", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_\u0394", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.nat_degree_polynomial", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.polynomial_ne_zero", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.degree_norm_ne_one", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_c\u2086", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_b\u2082", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.base_change_j", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.polynomial", "description": " The polynomial $W(X, Y) := Y^2 + a_1XY + a_3Y - (X^3 + a_2X^2 + a_4X + a_6)$ associated to a\nWeierstrass curve `W` over `R`. For ease of polynomial manipulation, this is represented as a term\nof type `R[X][X]`, where the inner variable represents $X$ and the outer variable represents $Y$.\nFor clarity, the alternative notations `Y` and `R[X][Y]` are provided in the `polynomial_polynomial`\nlocale to represent the outer variable and the bivariate polynomial ring `R[X][X]` respectively.", "p": "mathlib"}, {"name": "weierstrass_curve.irreducible_polynomial", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.nonsingular_zero_of_\u0394_ne_zero", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_\u0394", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_a\u2082", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.variable_change_\u0394'", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.base_change_to_weierstrass_curve", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_a\u2081", "description": "", "p": "mathlib"}, {"name": "elliptic_curve", "description": " An elliptic curve over a commutative ring. Note that this definition is only mathematically\naccurate for certain rings whose Picard group has trivial 12-torsion, such as a field or a PID.", "p": "mathlib"}, {"name": "elliptic_curve.to_weierstrass_curve", "description": " An elliptic curve over a commutative ring. Note that this definition is only mathematically\naccurate for certain rings whose Picard group has trivial 12-torsion, such as a field or a PID.", "p": "mathlib"}, {"name": "elliptic_curve.\u0394'", "description": " An elliptic curve over a commutative ring. Note that this definition is only mathematically\naccurate for certain rings whose Picard group has trivial 12-torsion, such as a field or a PID.", "p": "mathlib"}, {"name": "elliptic_curve.coe_\u0394'", "description": " An elliptic curve over a commutative ring. Note that this definition is only mathematically\naccurate for certain rings whose Picard group has trivial 12-torsion, such as a field or a PID.", "p": "mathlib"}, {"name": "elliptic_curve.coe_variable_change_\u0394'", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.nonsingular", "description": " The proposition that an affine point $(x, y)$ on `W` is nonsingular.\nIn other words, either $W_X(x, y) \\ne 0$ or $W_Y(x, y) \\ne 0$.", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.basis_one", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.equation_iff'", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.two_torsion_polynomial_disc", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.inhabited", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_b\u2088", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.function_field", "description": "The function field $R(W) := \\mathrm{Frac}(R[W])$ of `W`.", "p": "mathlib"}, {"name": "weierstrass_curve.monic_polynomial", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_b\u2086", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.variable_change_b\u2088", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.Y_class", "description": "The class of the element $Y - y(X)$ in $R[W]$ for some $y(X) \\in R[X]$.", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.inhabited", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.base_change_\u0394'", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.eval_polynomial_Y_zero", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.ext", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.smul_basis_mul_Y", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.algebra'", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_base_change", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.\u0394", "description": " The discriminant `\u0394` of a Weierstrass curve. If `R` is a field, then this polynomial vanishes\nif and only if the cubic curve cut out by this equation is singular. Sometimes only defined up to\nsign in the literature; we choose the sign used by the LMFDB. For more discussion, see\n[the LMFDB page on discriminants](https://www.lmfdb.org/knowledge/show/ec.discriminant).", "p": "mathlib"}, {"name": "weierstrass_curve.two_torsion_polynomial", "description": " A cubic polynomial whose discriminant is a multiple of the Weierstrass curve discriminant. If\n`W` is an elliptic curve over a field `R` of characteristic different from 2, then its roots over a\nsplitting field of `R` are precisely the $X$-coordinates of the non-zero 2-torsion points of `W`.", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_b\u2084", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.equation_iff_base_change_of_base_change", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_c\u2084", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.c\u2084", "description": "The `c\u2084` coefficient of a Weierstrass curve.", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_c\u2086", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.base_change_b\u2086", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.X_class_ne_zero", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.eval_polynomial_Y", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.degree_norm_smul_basis", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.eval_polynomial_X", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.nonsingular_iff_base_change", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.comm_ring", "description": "", "p": "mathlib"}, {"name": "weierstrass_curve.coordinate_ring.exists_smul_basis_eq", "description": "", "p": "mathlib"}, {"name": "elliptic_curve.base_change", "description": "The elliptic curve over `R` base changed to `A`.", "p": "mathlib"}, {"name": "weierstrass_curve.polynomial_X", "description": " The partial derivative $W_X(X, Y)$ of $W(X, Y)$ with respect to $X$.\n\nTODO: define this in terms of `polynomial.derivative`.", "p": "mathlib"}, {"name": "continuous_map.nullhomotopic_of_constant", "description": "", "p": "mathlib"}, {"name": "homeomorph.contractible_space", "description": "", "p": "mathlib"}, {"name": "continuous_map.homotopy_equiv.contractible_space", "description": "", "p": "mathlib"}, {"name": "continuous_map.nullhomotopic", "description": "A map is nullhomotopic if it is homotopic to a constant map.", "p": "mathlib"}, {"name": "contractible_space", "description": "A contractible space is one that is homotopy equivalent to `unit`.", "p": "mathlib"}, {"name": "contractible_space.hequiv_unit", "description": "A contractible space is one that is homotopy equivalent to `unit`.", "p": "mathlib"}, {"name": "continuous_map.nullhomotopic.comp_right", "description": "", "p": "mathlib"}, {"name": "id_nullhomotopic", "description": "", "p": "mathlib"}, {"name": "homeomorph.contractible_space_iff", "description": "", "p": "mathlib"}, {"name": "continuous_map.homotopy_equiv.contractible_space_iff", "description": "", "p": "mathlib"}, {"name": "contractible_iff_id_nullhomotopic", "description": "", "p": "mathlib"}, {"name": "continuous_map.nullhomotopic.comp_left", "description": "", "p": "mathlib"}, {"name": "contractible_space.path_connected_space", "description": "", "p": "mathlib"}, {"name": "matrix.inv_of_from_blocks\u2081\u2081_eq", "description": "", "p": "mathlib"}, {"name": "matrix.pos_semidef.from_blocks\u2081\u2081", "description": "", "p": "mathlib"}, {"name": "matrix.from_blocks_eq_of_invertible\u2082\u2082", "description": " LDU decomposition of a block matrix with an invertible bottom-right corner, using the\nSchur complement.", "p": "mathlib"}, {"name": "matrix.is_unit_from_blocks_zero\u2081\u2082", "description": " A lower block-triangular matrix is invertible iff both elements of its diagonal are.\n\nThis is a propositional form of  `matrix.from_blocks_zero\u2081\u2082_invertible_equiv` forms an `iff`.", "p": "mathlib"}, {"name": "matrix.from_blocks\u2081\u2081_invertible", "description": " A block matrix is invertible if the top left corner and the corresponding schur complement\nis.", "p": "mathlib"}, {"name": "matrix.inv_of_from_blocks\u2082\u2082_eq", "description": "", "p": "mathlib"}, {"name": "matrix.det_one_sub_mul_comm", "description": "", "p": "mathlib"}, {"name": "matrix.from_blocks_zero\u2081\u2082_invertible", "description": "A lower-block-triangular matrix is invertible if its diagonal is.", "p": "mathlib"}, {"name": "matrix.is_unit_from_blocks_zero\u2082\u2081", "description": " An upper block-triangular matrix is invertible iff both elements of its diagonal are.\n\nThis is a propositional form of `matrix.from_blocks_zero\u2082\u2081_invertible_equiv`.", "p": "mathlib"}, {"name": "matrix.pos_semidef.from_blocks\u2082\u2082", "description": "", "p": "mathlib"}, {"name": "matrix.invertible_of_from_blocks_zero\u2082\u2081_invertible", "description": " Both diagonal entries of an invertible upper-block-triangular matrix are invertible (by reading\noff the diagonal entries of the inverse).", "p": "mathlib"}, {"name": "matrix.det_from_blocks\u2081\u2081", "description": " Determinant of a 2\u00d72 block matrix, expanded around an invertible top left element in terms of\nthe Schur complement.", "p": "mathlib"}, {"name": "matrix.is_hermitian.from_blocks\u2081\u2081", "description": "", "p": "mathlib"}, {"name": "matrix.from_blocks_eq_of_invertible\u2081\u2081", "description": " LDU decomposition of a block matrix with an invertible top-left corner, using the\nSchur complement.", "p": "mathlib"}, {"name": "matrix.is_unit_from_blocks_iff_of_invertible\u2082\u2082", "description": " If the bottom-left element of a block matrix is invertible, then the whole matrix is invertible\niff the corresponding schur complement is.", "p": "mathlib"}, {"name": "matrix.det_one_add_mul_comm", "description": " The **Weinstein\u2013Aronszajn identity**. Note the `1` on the LHS is of shape m\u00d7m, while the `1` on\nthe RHS is of shape n\u00d7n.", "p": "mathlib"}, {"name": "matrix.invertible_of_from_blocks\u2081\u2081_invertible", "description": " If a block matrix is invertible and so is its bottom left element, then so is the corresponding\nSchur complement.", "p": "mathlib"}, {"name": "matrix.is_hermitian.from_blocks\u2082\u2082", "description": "", "p": "mathlib"}, {"name": "matrix.schur_complement_eq\u2082\u2082", "description": "", "p": "mathlib"}, {"name": "matrix.inv_from_blocks_zero\u2081\u2082_of_is_unit_iff", "description": " An expression for the inverse of a lower block-triangular matrix, when either both elements of\ndiagonal are invertible, or both are not.", "p": "mathlib"}, {"name": "matrix.invertible_of_from_blocks_zero\u2081\u2082_invertible", "description": " Both diagonal entries of an invertible lower-block-triangular matrix are invertible (by reading\noff the diagonal entries of the inverse).", "p": "mathlib"}, {"name": "matrix.inv_from_blocks_zero\u2082\u2081_of_is_unit_iff", "description": " An expression for the inverse of an upper block-triangular matrix, when either both elements of\ndiagonal are invertible, or both are not.", "p": "mathlib"}, {"name": "matrix.det_mul_add_one_comm", "description": "Alternate statement of the **Weinstein\u2013Aronszajn identity**", "p": "mathlib"}, {"name": "matrix.invertible_of_from_blocks\u2082\u2082_invertible", "description": " If a block matrix is invertible and so is its bottom left element, then so is the corresponding\nSchur complement.", "p": "mathlib"}, {"name": "matrix.invertible_equiv_from_blocks\u2082\u2082_invertible", "description": " `matrix.invertible_of_from_blocks\u2082\u2082_invertible` and `matrix.from_blocks\u2082\u2082_invertible` as an\nequivalence.", "p": "mathlib"}, {"name": "matrix.from_blocks_zero\u2082\u2081_invertible_equiv", "description": " `invertible_of_from_blocks_zero\u2082\u2081_invertible` and `from_blocks_zero\u2082\u2081_invertible` form\nan equivalence.", "p": "mathlib"}, {"name": "matrix.inv_of_from_blocks_zero\u2082\u2081_eq", "description": "", "p": "mathlib"}, {"name": "matrix.det_from_blocks_one\u2081\u2081", "description": "", "p": "mathlib"}, {"name": "matrix.inv_of_from_blocks_zero\u2081\u2082_eq", "description": "", "p": "mathlib"}, {"name": "matrix.invertible_equiv_from_blocks\u2081\u2081_invertible", "description": " `matrix.invertible_of_from_blocks\u2081\u2081_invertible` and `matrix.from_blocks\u2081\u2081_invertible` as an\nequivalence.", "p": "mathlib"}, {"name": "matrix.det_from_blocks_one\u2082\u2082", "description": "", "p": "mathlib"}, {"name": "matrix.is_unit_from_blocks_iff_of_invertible\u2081\u2081", "description": " If the top-right element of a block matrix is invertible, then the whole matrix is invertible\niff the corresponding schur complement is.", "p": "mathlib"}, {"name": "matrix.from_blocks\u2082\u2082_invertible", "description": " A block matrix is invertible if the bottom right corner and the corresponding schur complement\nis.", "p": "mathlib"}, {"name": "matrix.det_from_blocks\u2082\u2082", "description": " Determinant of a 2\u00d72 block matrix, expanded around an invertible bottom right element in terms\nof the Schur complement.", "p": "mathlib"}, {"name": "matrix.from_blocks_zero\u2081\u2082_invertible_equiv", "description": " `invertible_of_from_blocks_zero\u2081\u2082_invertible` and `from_blocks_zero\u2081\u2082_invertible` form\nan equivalence.", "p": "mathlib"}, {"name": "matrix.schur_complement_eq\u2081\u2081", "description": "", "p": "mathlib"}, {"name": "matrix.det_one_add_col_mul_row", "description": " A special case of the **Matrix determinant lemma** for when `A = I`.\n\nTODO: show this more generally.", "p": "mathlib"}, {"name": "matrix.from_blocks_zero\u2082\u2081_invertible", "description": "An upper-block-triangular matrix is invertible if its diagonal is.", "p": "mathlib"}, {"name": "concave_on.left_le_of_le_right'", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.add_convex_on", "description": "", "p": "mathlib"}, {"name": "linear_order.strict_concave_on_of_lt", "description": " For a function on a convex set in a linearly ordered space (where the order and the algebraic\nstructures aren't necessarily compatible), in order to prove that it is strictly concave it suffices\nto verify the inequality `a \u2022 f x + b \u2022 f y < f (a \u2022 x + b \u2022 y)` for `x < y` and positive `a`, `b`.\nThe main use case is `E = \ud835\udd5c` however one can apply it, e.g., to `\ud835\udd5c^n` with lexicographic order.", "p": "mathlib"}, {"name": "strict_convex_on_iff_div", "description": "", "p": "mathlib"}, {"name": "convex_on.comp_concave_on", "description": "", "p": "mathlib"}, {"name": "concave_on.lt_right_of_left_lt'", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.add_concave_on", "description": "", "p": "mathlib"}, {"name": "concave_on.sub", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.concave_on", "description": "", "p": "mathlib"}, {"name": "concave_on.open_segment_subset_strict_hypograph", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.lt_on_open_segment'", "description": " A strictly concave function on an open segment is strictly lower-bounded by the min of its\nendpoints.", "p": "mathlib"}, {"name": "convex_on.neg", "description": "**Alias** of the reverse direction of `neg_concave_on_iff`.", "p": "mathlib"}, {"name": "strict_concave_on.translate_right", "description": "Right translation preserves strict concavity.", "p": "mathlib"}, {"name": "convex_on.translate_left", "description": "Left translation preserves convexity.", "p": "mathlib"}, {"name": "concave_on.translate_right", "description": "Right translation preserves concavity.", "p": "mathlib"}, {"name": "convex_on_id", "description": "", "p": "mathlib"}, {"name": "concave_on.lt_right_of_left_lt", "description": "", "p": "mathlib"}, {"name": "concave_on.comp", "description": "", "p": "mathlib"}, {"name": "convex_on.comp_affine_map", "description": "If a function is convex on `s`, it remains convex when precomposed by an affine map.", "p": "mathlib"}, {"name": "convex_on_iff_pairwise_pos", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.comp_strict_concave_on", "description": "", "p": "mathlib"}, {"name": "neg_concave_on_iff", "description": "A function `-f` is concave iff `f` is convex.", "p": "mathlib"}, {"name": "concave_on.ge_on_segment'", "description": "A concave function on a segment is lower-bounded by the min of its endpoints.", "p": "mathlib"}, {"name": "concave_on.convex_gt", "description": "", "p": "mathlib"}, {"name": "convex_on.sub", "description": "", "p": "mathlib"}, {"name": "concave_on_iff_div", "description": "", "p": "mathlib"}, {"name": "convex_on.lt_right_of_left_lt", "description": "", "p": "mathlib"}, {"name": "strict_concave_on", "description": "Strict concavity of functions", "p": "mathlib"}, {"name": "concave_on.left_lt_of_lt_right", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.lt_on_open_segment", "description": " A strictly convex function on an open segment is strictly upper-bounded by the max of its\nendpoints.", "p": "mathlib"}, {"name": "linear_order.concave_on_of_lt", "description": " For a function on a convex set in a linearly ordered space (where the order and the algebraic\nstructures aren't necessarily compatible), in order to prove that it is concave it suffices to\nverify the inequality `a \u2022 f x + b \u2022 f y \u2264 f (a \u2022 x + b \u2022 y)` for `x < y` and positive `a`, `b`. The\nmain use case is `E = \u211d` however one can apply it, e.g., to `\u211d^n` with lexicographic order.", "p": "mathlib"}, {"name": "strict_convex_on.dual", "description": "", "p": "mathlib"}, {"name": "concave_on_iff_pairwise_pos", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.sup", "description": "The pointwise maximum of strictly convex functions is strictly convex.", "p": "mathlib"}, {"name": "concave_on.dual", "description": "", "p": "mathlib"}, {"name": "concave_on.convex_ge", "description": "", "p": "mathlib"}, {"name": "convex_on.le_on_segment", "description": "A convex function on a segment is upper-bounded by the max of its endpoints.", "p": "mathlib"}, {"name": "neg_strict_convex_on_iff", "description": "A function `-f` is strictly convex iff `f` is strictly concave.", "p": "mathlib"}, {"name": "convex_on.dual", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.convex_lt", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.translate_right", "description": "Right translation preserves strict convexity.", "p": "mathlib"}, {"name": "strict_convex_on.subset", "description": "", "p": "mathlib"}, {"name": "convex_on.open_segment_subset_strict_epigraph", "description": "", "p": "mathlib"}, {"name": "concave_on_iff_convex_hypograph", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.comp_strict_convex_on", "description": "", "p": "mathlib"}, {"name": "strict_convex_on", "description": "Strict convexity of functions", "p": "mathlib"}, {"name": "neg_convex_on_iff", "description": "A function `-f` is convex iff `f` is concave.", "p": "mathlib"}, {"name": "strict_concave_on_iff_div", "description": "", "p": "mathlib"}, {"name": "concave_on.convex_strict_hypograph", "description": "", "p": "mathlib"}, {"name": "convex_on_const", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.convex_on", "description": "", "p": "mathlib"}, {"name": "concave_on.add", "description": "", "p": "mathlib"}, {"name": "concave_on.subset", "description": "", "p": "mathlib"}, {"name": "linear_map.convex_on", "description": "A linear map is convex.", "p": "mathlib"}, {"name": "concave_on.left_le_of_le_right''", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.translate_left", "description": "Left translation preserves strict concavity.", "p": "mathlib"}, {"name": "concave_on.right_le_of_le_left", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.inf", "description": "The pointwise minimum of strictly concave functions is strictly concave.", "p": "mathlib"}, {"name": "strict_concave_on.neg", "description": "**Alias** of the reverse direction of `neg_strict_convex_on_iff`.", "p": "mathlib"}, {"name": "concave_on_iff_forall_pos", "description": "", "p": "mathlib"}, {"name": "linear_map.concave_on", "description": "A linear map is concave.", "p": "mathlib"}, {"name": "convex_on.comp_linear_map", "description": "If `g` is convex on `s`, so is `(f \u2218 g)` on `f \u207b\u00b9' s` for a linear `f`.", "p": "mathlib"}, {"name": "convex_on.add_strict_convex_on", "description": "", "p": "mathlib"}, {"name": "convex_on.le_left_of_right_le'", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.lt_on_open_segment", "description": " A strictly concave function on an open segment is strictly lower-bounded by the min of its\nendpoints.", "p": "mathlib"}, {"name": "convex_on_iff_div", "description": "", "p": "mathlib"}, {"name": "concave_on.convex_hypograph", "description": "", "p": "mathlib"}, {"name": "convex_on.comp", "description": "", "p": "mathlib"}, {"name": "concave_on.ge_on_segment", "description": "A concave function on a segment is lower-bounded by the min of its endpoints.", "p": "mathlib"}, {"name": "strict_concave_on.comp", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.translate_left", "description": "Left translation preserves strict convexity.", "p": "mathlib"}, {"name": "strict_convex_on.sub", "description": "", "p": "mathlib"}, {"name": "convex_on_of_convex_epigraph", "description": "", "p": "mathlib"}, {"name": "convex_on.le_right_of_left_le'", "description": "", "p": "mathlib"}, {"name": "convex_on.add", "description": "", "p": "mathlib"}, {"name": "concave_on_const", "description": "", "p": "mathlib"}, {"name": "convex_on.lt_left_of_right_lt'", "description": "", "p": "mathlib"}, {"name": "concave_on.add_strict_concave_on", "description": "", "p": "mathlib"}, {"name": "concave_on_id", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.comp", "description": "", "p": "mathlib"}, {"name": "concave_on.neg", "description": "**Alias** of the reverse direction of `neg_convex_on_iff`.", "p": "mathlib"}, {"name": "concave_on.right_le_of_le_left''", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.sub_convex_on", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.dual", "description": "", "p": "mathlib"}, {"name": "linear_order.strict_convex_on_of_lt", "description": " For a function on a convex set in a linearly ordered space (where the order and the algebraic\nstructures aren't necessarily compatible), in order to prove that it is strictly convex, it suffices\nto verify the inequality `f (a \u2022 x + b \u2022 y) < a \u2022 f x + b \u2022 f y` for `x < y` and positive `a`, `b`.\nThe main use case is `E = \ud835\udd5c` however one can apply it, e.g., to `\ud835\udd5c^n` with lexicographic order.", "p": "mathlib"}, {"name": "strict_concave_on.sub", "description": "", "p": "mathlib"}, {"name": "concave_on.left_le_of_le_right", "description": "", "p": "mathlib"}, {"name": "convex_on.le_left_of_right_le", "description": "", "p": "mathlib"}, {"name": "concave_on.left_lt_of_lt_right'", "description": "", "p": "mathlib"}, {"name": "linear_order.convex_on_of_lt", "description": " For a function on a convex set in a linearly ordered space (where the order and the algebraic\nstructures aren't necessarily compatible), in order to prove that it is convex, it suffices to\nverify the inequality `f (a \u2022 x + b \u2022 y) \u2264 a \u2022 f x + b \u2022 f y` only for `x < y` and positive `a`,\n`b`. The main use case is `E = \ud835\udd5c` however one can apply it, e.g., to `\ud835\udd5c^n` with lexicographic order.", "p": "mathlib"}, {"name": "concave_on_of_convex_hypograph", "description": "", "p": "mathlib"}, {"name": "concave_on.comp_convex_on", "description": "", "p": "mathlib"}, {"name": "convex_on.le_right_of_left_le''", "description": "", "p": "mathlib"}, {"name": "convex_on.lt_left_of_right_lt", "description": "", "p": "mathlib"}, {"name": "convex_on.le_right_of_left_le", "description": "", "p": "mathlib"}, {"name": "convex_on.convex_strict_epigraph", "description": "", "p": "mathlib"}, {"name": "concave_on.smul", "description": "", "p": "mathlib"}, {"name": "convex_on.convex_lt", "description": "", "p": "mathlib"}, {"name": "convex_on.le_on_segment'", "description": "A convex function on a segment is upper-bounded by the max of its endpoints.", "p": "mathlib"}, {"name": "concave_on", "description": "Concavity of functions", "p": "mathlib"}, {"name": "convex_on.translate_right", "description": "Right translation preserves convexity.", "p": "mathlib"}, {"name": "convex_on.le_left_of_right_le''", "description": "", "p": "mathlib"}, {"name": "concave_on.comp_linear_map", "description": "If `g` is concave on `s`, so is `(g \u2218 f)` on `f \u207b\u00b9' s` for a linear `f`.", "p": "mathlib"}, {"name": "concave_on.sub_strict_convex_on", "description": "", "p": "mathlib"}, {"name": "concave_on.inf", "description": "The pointwise minimum of concave functions is concave.", "p": "mathlib"}, {"name": "convex_on_iff_forall_pos", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.lt_on_open_segment'", "description": " A strictly convex function on an open segment is strictly upper-bounded by the max of its\nendpoints.", "p": "mathlib"}, {"name": "convex_on.lt_right_of_left_lt'", "description": "", "p": "mathlib"}, {"name": "convex_on.sub_strict_concave_on", "description": "", "p": "mathlib"}, {"name": "convex_on.subset", "description": "", "p": "mathlib"}, {"name": "concave_on.right_le_of_le_left'", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.convex_gt", "description": "", "p": "mathlib"}, {"name": "convex_on.convex_le", "description": "", "p": "mathlib"}, {"name": "concave_on.translate_left", "description": "Left translation preserves concavity.", "p": "mathlib"}, {"name": "convex_on.smul", "description": "", "p": "mathlib"}, {"name": "convex_on.sup", "description": "The pointwise maximum of convex functions is convex.", "p": "mathlib"}, {"name": "strict_convex_on.sub_concave_on", "description": "", "p": "mathlib"}, {"name": "concave_on.comp_affine_map", "description": "If a function is concave on `s`, it remains concave when precomposed by an affine map.", "p": "mathlib"}, {"name": "strict_convex_on.neg", "description": "**Alias** of the reverse direction of `neg_strict_concave_on_iff`.", "p": "mathlib"}, {"name": "convex_on", "description": "Convexity of functions", "p": "mathlib"}, {"name": "neg_strict_concave_on_iff", "description": "A function `-f` is strictly concave iff `f` is strictly convex.", "p": "mathlib"}, {"name": "strict_concave_on.add", "description": "", "p": "mathlib"}, {"name": "convex_on_iff_convex_epigraph", "description": "", "p": "mathlib"}, {"name": "strict_convex_on.add", "description": "", "p": "mathlib"}, {"name": "strict_concave_on.subset", "description": "", "p": "mathlib"}, {"name": "convex_on.convex_epigraph", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.adjoin_equiv_ring_of_integers'_apply", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.sub_one_integral_power_basis'_gen", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.integral_power_basis", "description": " The integral `power_basis` of `\ud835\udcde K` given by a primitive root of unity, where `K` is a `p ^ k`\ncyclotomic extension of `\u211a`.", "p": "mathlib"}, {"name": "is_cyclotomic_extension.rat.cyclotomic_ring_is_integral_closure_of_prime_pow", "description": " The integral closure of `\u2124` inside `cyclotomic_field (p ^ k) \u211a` is\n`cyclotomic_ring (p ^ k) \u2124 \u211a`.", "p": "mathlib"}, {"name": "is_primitive_root.sub_one_integral_power_basis", "description": " The integral `power_basis` of `\ud835\udcde K` given by `\u03b6 - 1`, where `K` is a `p ^ k` cyclotomic\nextension of `\u211a`.", "p": "mathlib"}, {"name": "is_primitive_root.integral_power_basis_dim", "description": "", "p": "mathlib"}, {"name": "is_cyclotomic_extension.rat.discr_prime_pow_ne_two'", "description": "The discriminant of the power basis given by `\u03b6 - 1`.", "p": "mathlib"}, {"name": "is_primitive_root.adjoin_equiv_ring_of_integers_apply", "description": "", "p": "mathlib"}, {"name": "is_cyclotomic_extension.ring_of_integers", "description": "The ring of integers of a `p ^ k`-th cyclotomic extension of `\u211a` is a cyclotomic extension.", "p": "mathlib"}, {"name": "is_primitive_root.adjoin_equiv_ring_of_integers'", "description": " The algebra isomorphism `adjoin \u2124 {\u03b6} \u2243\u2090[\u2124] (\ud835\udcde K)`, where `\u03b6` is a primitive `p`-th root of\nunity and `K` is a `p`-th cyclotomic extension of `\u211a`.", "p": "mathlib"}, {"name": "is_cyclotomic_extension.rat.cyclotomic_ring_is_integral_closure_of_prime", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.sub_one_integral_power_basis'", "description": " The integral `power_basis` of `\ud835\udcde K` given by `\u03b6 - 1`, where `K` is a `p`-th cyclotomic\nextension of `\u211a`.", "p": "mathlib"}, {"name": "is_primitive_root.integral_power_basis'_gen", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.integral_power_basis_gen", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.power_basis_int'_dim", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.adjoin_equiv_ring_of_integers_symm_apply", "description": "", "p": "mathlib"}, {"name": "is_cyclotomic_extension.ring_of_integers'", "description": "The ring of integers of a `p`-th cyclotomic extension of `\u211a` is a cyclotomic extension.", "p": "mathlib"}, {"name": "is_primitive_root.sub_one_integral_power_basis_gen", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.adjoin_equiv_ring_of_integers", "description": " The algebra isomorphism `adjoin \u2124 {\u03b6} \u2243\u2090[\u2124] (\ud835\udcde K)`, where `\u03b6` is a primitive `p ^ k`-th root of\nunity and `K` is a `p ^ k`-th cyclotomic extension of `\u211a`.", "p": "mathlib"}, {"name": "is_cyclotomic_extension.rat.is_integral_closure_adjoin_singleton_of_prime_pow", "description": " If `K` is a `p ^ k`-th cyclotomic extension of `\u211a`, then `(adjoin \u2124 {\u03b6})` is the\nintegral closure of `\u2124` in `K`.", "p": "mathlib"}, {"name": "is_cyclotomic_extension.rat.discr_prime_pow'", "description": " The discriminant of the power basis given by `\u03b6 - 1`. Beware that in the cases `p ^ k = 1` and\n`p ^ k = 2` the formula uses `1 / 2 = 0` and `0 - 1 = 0`. It is useful only to have a uniform\nresult. See also `is_cyclotomic_extension.rat.discr_prime_pow_eq_unit_mul_pow'`.", "p": "mathlib"}, {"name": "is_cyclotomic_extension.rat.is_integral_closure_adjoin_singleton_of_prime", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.integral_power_basis'", "description": " The integral `power_basis` of `\ud835\udcde K` given by a primitive root of unity, where `K` is a `p`-th\ncyclotomic extension of `\u211a`.", "p": "mathlib"}, {"name": "is_cyclotomic_extension.rat.discr_prime_pow_eq_unit_mul_pow'", "description": " If `p` is a prime and `is_cyclotomic_extension {p ^ k} K L`, then there are `u : \u2124\u02e3` and\n`n : \u2115` such that the discriminant of the power basis given by `\u03b6 - 1` is `u * p ^ n`. Often this is\nenough and less cumbersome to use than `is_cyclotomic_extension.rat.discr_prime_pow'`.", "p": "mathlib"}, {"name": "is_cyclotomic_extension.rat.discr_odd_prime'", "description": "", "p": "mathlib"}, {"name": "is_primitive_root.adjoin_equiv_ring_of_integers'_symm_apply", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_iff", "description": "One can reformulate smoothness as continuity and smoothness in any extended chart.", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_of_mem_source", "description": " One can reformulate smoothness within a set at a point as continuity within this set at this\npoint, and smoothness in any chart containing that point.", "p": "mathlib"}, {"name": "smooth_on.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_iff_target", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.clm_prod_map", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.of_le", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_source_of_mem_source", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_iff", "description": " One can reformulate smoothness on a set as continuity on this set, and smoothness in any\nextended chart.", "p": "mathlib"}, {"name": "smooth_within_at_zero", "description": "", "p": "mathlib"}, {"name": "smooth_within_at_one", "description": "", "p": "mathlib"}, {"name": "smooth_iff_target", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_nat", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.continuous_within_at", "description": "", "p": "mathlib"}, {"name": "smooth_at.smul", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at_prop_mono_of_mem", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.clm_apply", "description": "", "p": "mathlib"}, {"name": "smooth_on_pi_space", "description": "", "p": "mathlib"}, {"name": "smooth_at.cont_mdiff_at", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.cont_diff_on", "description": "**Alias** of the forward direction of `cont_mdiff_on_iff_cont_diff_on`.", "p": "mathlib"}, {"name": "cont_mdiff.prod_map", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at_prop_self_target", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_target", "description": " One can reformulate smoothness within a set at a point as continuity within this set at this\npoint, and smoothness in the corresponding extended chart in the target.", "p": "mathlib"}, {"name": "smooth_one", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_model", "description": "", "p": "mathlib"}, {"name": "smooth_on.comp'", "description": "The composition of `C^\u221e` functions is `C^\u221e`.", "p": "mathlib"}, {"name": "cont_mdiff_on.smul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_zero", "description": "", "p": "mathlib"}, {"name": "smooth_at", "description": "Abbreviation for `cont_mdiff_at I I' \u22a4 f x`. See also documentation for `smooth`.", "p": "mathlib"}, {"name": "cont_mdiff_on_ext_chart_at_symm", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_ext_chart_at", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.prod_mk", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.of_succ", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_iff_target", "description": " One can reformulate smoothness on a set as continuity on this set, and smoothness in any\nextended chart in the target.", "p": "mathlib"}, {"name": "cont_mdiff_within_at_id", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_congr", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.prod_mk", "description": "", "p": "mathlib"}, {"name": "smooth_at_zero", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.comp", "description": "The composition of `C^n` functions within domains at points is `C^n`.", "p": "mathlib"}, {"name": "smooth_on.prod_map", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.cont_mdiff_within_at", "description": "", "p": "mathlib"}, {"name": "smooth_at.prod_map", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "smooth_at_snd", "description": "", "p": "mathlib"}, {"name": "smooth_on.comp_smooth", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_inter", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.cont_mdiff_at", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_cont_mdiff_on_nhds", "description": " A function is `C^n` within a set at a point, for `n : \u2115`, if and only if it is `C^n` on\na neighborhood of this point.", "p": "mathlib"}, {"name": "smooth_within_at_fst", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.continuous_on", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.smooth_within_at", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at_prop", "description": " Property in the model space of a model with corners of being `C^n` within at set at a point,\nwhen read in the model vector space. This property will be lifted to manifolds to define smooth\nfunctions between manifolds.", "p": "mathlib"}, {"name": "cont_mdiff_within_at_congr_nhds", "description": "", "p": "mathlib"}, {"name": "cont_diff_at.cont_mdiff_at", "description": "**Alias** of the reverse direction of `cont_mdiff_at_iff_cont_diff_at`.", "p": "mathlib"}, {"name": "cont_mdiff_at_const", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_target_of_mem_source", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_fst", "description": "", "p": "mathlib"}, {"name": "smooth_at_iff_target", "description": "", "p": "mathlib"}, {"name": "smooth_on_one", "description": "", "p": "mathlib"}, {"name": "smooth_within_at.comp", "description": "The composition of `C^\u221e` functions within domains at points is `C^\u221e`.", "p": "mathlib"}, {"name": "cont_mdiff_within_at.comp'", "description": "The composition of `C^n` functions within domains at points is `C^n`.", "p": "mathlib"}, {"name": "cont_mdiff_at.prod_map'", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_const", "description": "", "p": "mathlib"}, {"name": "smooth_pi_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.of_succ", "description": "", "p": "mathlib"}, {"name": "smooth.snd", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.fst", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.continuous_at", "description": "", "p": "mathlib"}, {"name": "smooth_at.comp", "description": "The composition of `C^\u221e` functions at points is `C^\u221e`.", "p": "mathlib"}, {"name": "cont_mdiff_const", "description": "", "p": "mathlib"}, {"name": "smooth_at_const", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_iff_cont_diff_on", "description": "", "p": "mathlib"}, {"name": "smooth_on_iff", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at_prop_id", "description": "", "p": "mathlib"}, {"name": "smooth_within_at_snd", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.continuous", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.clm_comp", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.prod_map", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.cont_mdiff_on", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_iff_target_of_mem_source", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.of_succ", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_zero", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_image", "description": "An alternative formulation of `cont_mdiff_within_at_iff_of_mem_maximal_atlas`\n if the set if `s` lies in `e.source`.", "p": "mathlib"}, {"name": "cont_mdiff_within_at_top", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_snd", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at", "description": " A function is `n` times continuously differentiable at a point in a manifold if\nit is continuous and it is `n` times continuously differentiable around this point, when\nread in the preferred chart at this point.", "p": "mathlib"}, {"name": "smooth_on.smul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at", "description": " A function is `n` times continuously differentiable within a set at a point in a manifold if\nit is continuous and it is `n` times continuously differentiable in this set around this point, when\nread in the preferred chart at this point.", "p": "mathlib"}, {"name": "cont_mdiff_at_prod_iff", "description": "", "p": "mathlib"}, {"name": "smooth_within_at_univ", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.prod_map'", "description": " The product map of two `C^n` functions within a set at a point is `C^n`\nwithin the product set at the product point.", "p": "mathlib"}, {"name": "cont_mdiff_at_symm_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_inclusion", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_iff_of_mem_source", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_iff_source_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.smul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.clm_apply", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_fst", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.cont_mdiff_within_at_iff", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.cont_diff_within_at", "description": "**Alias** of the forward direction of `cont_mdiff_within_at_iff_cont_diff_within_at`.", "p": "mathlib"}, {"name": "smooth_on.prod_mk", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_snd", "description": "", "p": "mathlib"}, {"name": "smooth", "description": " Abbreviation for `cont_mdiff I I' \u22a4 f`.\nShort note to work with these abbreviations: a lemma of the form `cont_mdiff_foo.bar` will\napply fine to an assumption `smooth_foo` using dot notation or normal notation.\nIf the consequence `bar` of the lemma involves `cont_diff`, it is still better to restate\nthe lemma replacing `cont_diff` with `smooth` both in the assumption and in the conclusion,\nto make it possible to use `smooth` consistently.\nThis also applies to `smooth_at`, `smooth_on` and `smooth_within_at`.", "p": "mathlib"}, {"name": "cont_mdiff_iff_target", "description": " One can reformulate smoothness as continuity and smoothness in any extended chart in the\ntarget.", "p": "mathlib"}, {"name": "cont_mdiff_within_at.fst", "description": "", "p": "mathlib"}, {"name": "cont_mdiff", "description": " A function is `n` times continuously differentiable in a manifold if it is continuous\nand, for any pair of points, it is `n` times continuously differentiable in the charts\naround these points.", "p": "mathlib"}, {"name": "cont_mdiff_on.smooth_on", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_extend_symm", "description": "", "p": "mathlib"}, {"name": "smooth_inclusion", "description": "", "p": "mathlib"}, {"name": "smooth_within_at.comp'", "description": "The composition of `C^\u221e` functions within domains at points is `C^\u221e`.", "p": "mathlib"}, {"name": "smooth.smooth_at", "description": "", "p": "mathlib"}, {"name": "smooth.cont_mdiff", "description": "", "p": "mathlib"}, {"name": "smooth.smul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.prod_mk", "description": "", "p": "mathlib"}, {"name": "smooth_smul", "description": "On any vector space, multiplication by a scalar is a smooth operation.", "p": "mathlib"}, {"name": "smooth_zero", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_of_support", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.clm_prod_map", "description": "", "p": "mathlib"}, {"name": "smooth_prod_iff", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at_prop_self", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_one", "description": "", "p": "mathlib"}, {"name": "is_local_structomorph_on_cont_diff_groupoid_iff", "description": " Let `M` and `M'` be smooth manifolds with the same model-with-corners, `I`.  Then `f : M \u2192 M'`\nis a local structomorphism for `I`, if and only if it is manifold-smooth on the domain of definition\nin both directions.", "p": "mathlib"}, {"name": "smooth.comp", "description": "The composition of `C^\u221e` functions is `C^\u221e`.", "p": "mathlib"}, {"name": "cont_diff.cont_mdiff", "description": "**Alias** of the reverse direction of `cont_mdiff_iff_cont_diff`.", "p": "mathlib"}, {"name": "smooth.prod_map", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.of_succ", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_pi_space", "description": "", "p": "mathlib"}, {"name": "cont_diff_at.comp_cont_mdiff_at", "description": "", "p": "mathlib"}, {"name": "smooth_on_univ", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on", "description": " A function is `n` times continuously differentiable in a set of a manifold if it is continuous\nand, for any pair of points, it is `n` times continuously differentiable on this set in the charts\naround these points.", "p": "mathlib"}, {"name": "continuous_linear_map.cont_mdiff", "description": "", "p": "mathlib"}, {"name": "smooth.fst", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_pi_space", "description": "", "p": "mathlib"}, {"name": "smooth_on.smooth_at", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.congr_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_one", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.congr", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_fst", "description": "", "p": "mathlib"}, {"name": "smooth_at_fst", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.smooth_at", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_iff_source_of_mem_source", "description": "", "p": "mathlib"}, {"name": "smooth_id", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.of_le", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.smooth", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at_local_invariant_prop", "description": " Being `C\u207f` in the model space is a local property, invariant under smooth maps. Therefore,\nit will lift nicely to manifolds.", "p": "mathlib"}, {"name": "is_local_structomorph_on_cont_diff_groupoid_iff_aux", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_pi_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_id", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_cont_diff_within_at", "description": "", "p": "mathlib"}, {"name": "smooth_at_pi_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_iff", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.snd", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_prod_iff", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_snd", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.clm_prod_map", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_id", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_top", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_iff_cont_diff", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.cont_mdiff_at", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.smul", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.mono", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_iff_cont_mdiff_on_nhds", "description": " A function is `C^n` at a point, for `n : \u2115`, if and only if it is `C^n` on\na neighborhood of this point.", "p": "mathlib"}, {"name": "cont_mdiff.comp", "description": "The composition of `C^n` functions is `C^n`.", "p": "mathlib"}, {"name": "smooth_snd", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_zero", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_ext_chart_at'", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.mono_of_mem", "description": "", "p": "mathlib"}, {"name": "smooth_on.cont_mdiff_on", "description": "", "p": "mathlib"}, {"name": "smooth_on_zero", "description": "", "p": "mathlib"}, {"name": "smooth_within_at.prod_mk", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.clm_comp", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.comp'", "description": "The composition of `C^n` functions on domains is `C^n`.", "p": "mathlib"}, {"name": "cont_mdiff_on_chart", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.comp_cont_mdiff", "description": "", "p": "mathlib"}, {"name": "smooth_on_const", "description": "", "p": "mathlib"}, {"name": "smooth_within_at_pi_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_fst", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.mono", "description": "", "p": "mathlib"}, {"name": "smooth_at.comp_smooth_within_at", "description": " `g \u2218 f` is `C^\u221e` within `s` at `x` if `g` is `C^\u221e` at `f x` and\n`f` is `C^\u221e` within `s` at `x`.", "p": "mathlib"}, {"name": "cont_mdiff_at.comp_of_eq", "description": "See note [comp_of_eq lemmas]", "p": "mathlib"}, {"name": "smooth_within_at_const", "description": "", "p": "mathlib"}, {"name": "smooth_within_at.smooth_at", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_of_mem_source'", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.comp", "description": "The composition of `C^n` functions at points is `C^n`.", "p": "mathlib"}, {"name": "cont_mdiff_on.clm_comp", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_iff_cont_mdiff_at_nhds", "description": " Note: This does not hold for `n = \u221e`. `f` being `C^\u221e` at `x` means that for every `n`, `f` is\n`C^n` on some neighborhood of `x`, but this neighborhood can depend on `n`.", "p": "mathlib"}, {"name": "cont_mdiff_on_id", "description": "", "p": "mathlib"}, {"name": "smooth.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.comp_cont_mdiff_on", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at.cont_mdiff_within_at", "description": "**Alias** of the reverse direction of `cont_mdiff_within_at_iff_cont_diff_within_at`.", "p": "mathlib"}, {"name": "cont_mdiff_on.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "smooth_on_iff_target", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.comp_cont_mdiff_within_at", "description": " `g \u2218 f` is `C^n` within `s` at `x` if `g` is `C^n` at `f x` and\n`f` is `C^n` within `s` at `x`.", "p": "mathlib"}, {"name": "cont_mdiff_of_locally_cont_mdiff_on", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.congr_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "smooth_at_prod_iff", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_chart_symm", "description": "", "p": "mathlib"}, {"name": "smooth_at.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.snd", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at_prop_self_source", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff_source_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_one", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.clm_comp", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.congr", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.fst", "description": "", "p": "mathlib"}, {"name": "smooth_within_at.prod_mk_space", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_of_mem_maximal_atlas", "description": "An atlas member is `C^n` for any `n`.", "p": "mathlib"}, {"name": "cont_mdiff_on_top", "description": "", "p": "mathlib"}, {"name": "smooth_within_at.prod_map", "description": "", "p": "mathlib"}, {"name": "cont_diff.comp_cont_mdiff", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.cont_diff_at", "description": "**Alias** of the forward direction of `cont_mdiff_at_iff_cont_diff_at`.", "p": "mathlib"}, {"name": "cont_mdiff_at_top", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.of_le", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.prod_mk", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.cont_mdiff_at", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_congr", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_iff_of_subset_source", "description": "If the set where you want `f` to be smooth lies entirely in a single chart, and `f` maps it\n into a single chart, the smoothness of `f` on that set can be expressed by purely looking in\n these charts.\n Note: this lemma uses `ext_chart_at I x '' s` instead of `(ext_chart_at I x).symm \u207b\u00b9' s` to ensure\n that this set lies in `(ext_chart_at I x).target`.", "p": "mathlib"}, {"name": "cont_mdiff_on.comp", "description": "The composition of `C^n` functions on domains is `C^n`.", "p": "mathlib"}, {"name": "cont_mdiff_snd", "description": "", "p": "mathlib"}, {"name": "smooth_within_at_iff_target", "description": "", "p": "mathlib"}, {"name": "smooth.prod_mk", "description": "", "p": "mathlib"}, {"name": "smooth_at_one", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_zero", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_one", "description": "", "p": "mathlib"}, {"name": "smooth_at_id", "description": "", "p": "mathlib"}, {"name": "smooth_on_snd", "description": "", "p": "mathlib"}, {"name": "smooth_fst", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_iff_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_inter'", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_ext_chart_at", "description": "", "p": "mathlib"}, {"name": "smooth_on_id", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.of_le", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.comp_of_eq", "description": "See note [comp_of_eq lemmas]", "p": "mathlib"}, {"name": "cont_mdiff_on_of_locally_cont_mdiff_on", "description": "Being `C^n` is a local property.", "p": "mathlib"}, {"name": "cont_mdiff_on_model_symm", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.cont_mdiff_at_iff", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.smul", "description": "", "p": "mathlib"}, {"name": "smooth_on_fst", "description": "", "p": "mathlib"}, {"name": "smooth_const", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_of_mem_cont_diff_groupoid", "description": "An element of `cont_diff_groupoid \u22a4 I` is `C^n` for any `n`.", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff", "description": " One can reformulate smoothness within a set at a point as continuity within this set at this\npoint, and smoothness in the corresponding extended chart.", "p": "mathlib"}, {"name": "cont_mdiff_within_at_univ", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at.comp_cont_mdiff_within_at", "description": "", "p": "mathlib"}, {"name": "smooth_at.prod_mk", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_const", "description": "", "p": "mathlib"}, {"name": "cont_mdiff.cont_diff", "description": "**Alias** of the forward direction of `cont_mdiff_iff_cont_diff`.", "p": "mathlib"}, {"name": "cont_mdiff_within_at_iff'", "description": " One can reformulate smoothness within a set at a point as continuity within this set at this\npoint, and smoothness in the corresponding extended chart. This form states smoothness of `f`\nwritten in such a way that the set is restricted to lie within the domain/codomain of the\ncorresponding charts.\nEven though this expression is more complicated than the one in `cont_mdiff_within_at_iff`, it is\na smaller set, but their germs at `ext_chart_at I x x` are equal. It is sometimes useful to rewrite\nusing this in the goal.", "p": "mathlib"}, {"name": "cont_mdiff_at.prod_map", "description": "", "p": "mathlib"}, {"name": "smooth_at.snd", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_pi_space", "description": "", "p": "mathlib"}, {"name": "smooth_at.smooth_within_at", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_symm_of_mem_maximal_atlas", "description": "The inverse of an atlas member is `C^n` for any `n`.", "p": "mathlib"}, {"name": "smooth_prod_assoc", "description": "", "p": "mathlib"}, {"name": "smooth_within_at_iff", "description": "", "p": "mathlib"}, {"name": "smooth_on.comp", "description": "The composition of `C^\u221e` functions on domains is `C^\u221e`.", "p": "mathlib"}, {"name": "cont_mdiff.snd", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on_univ", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.clm_apply", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at_prod_iff", "description": "", "p": "mathlib"}, {"name": "smooth.comp_smooth_on", "description": "", "p": "mathlib"}, {"name": "smooth_at.fst", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_on.prod_map", "description": "", "p": "mathlib"}, {"name": "smooth_within_at.cont_mdiff_within_at", "description": "", "p": "mathlib"}, {"name": "smooth_on", "description": "Abbreviation for `cont_mdiff_on I I' \u22a4 f s`. See also documentation for `smooth`.", "p": "mathlib"}, {"name": "smooth_within_at_id", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at.clm_prod_map", "description": "", "p": "mathlib"}, {"name": "cont_diff_on.cont_mdiff_on", "description": "**Alias** of the reverse direction of `cont_mdiff_on_iff_cont_diff_on`.", "p": "mathlib"}, {"name": "cont_mdiff_at_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_iff_cont_diff_at", "description": "", "p": "mathlib"}, {"name": "smooth.smooth_on", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_within_at.clm_apply", "description": "", "p": "mathlib"}, {"name": "cont_mdiff_at_extend", "description": "", "p": "mathlib"}, {"name": "smooth_within_at.smul", "description": "", "p": "mathlib"}, {"name": "smooth_within_at", "description": "Abbreviation for `cont_mdiff_within_at I I' \u22a4 f s x`. See also documentation for `smooth`.", "p": "mathlib"}, {"name": "smooth_iff", "description": "", "p": "mathlib"}, {"name": "continuous_at.comp_upper_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at_sum", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at.mono", "description": "", "p": "mathlib"}, {"name": "continuous_at_iff_lower_upper_semicontinuous_at", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_iff_is_closed_preimage", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_sum", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_on.add", "description": " The sum of two lower semicontinuous functions is lower semicontinuous. Formulated with\n`[has_continuous_add]`. The primed version of the lemma uses an explicit continuity assumption on\naddition, for application to `ereal`.", "p": "mathlib"}, {"name": "lower_semicontinuous_on.lower_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous.add'", "description": " The sum of two upper semicontinuous functions is upper semicontinuous. Formulated with an\nexplicit continuity assumption on addition, for application to `ereal`. The unprimed version of\nthe lemma uses `[has_continuous_add]`.", "p": "mathlib"}, {"name": "upper_semicontinuous_iff_is_open_preimage", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_at.lower_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "is_closed.lower_semicontinuous_at_indicator", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_within_at_infi", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_iff_is_open_preimage", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_at", "description": " A real function `f` is upper semicontinuous at `x` if, for any `\u03b5 > 0`, for all `x'` close\nenough to `x`, then `f x'` is at most `f x + \u03b5`. We formulate this in a general preordered space,\nusing an arbitrary `y > f x` instead of `f x + \u03b5`.", "p": "mathlib"}, {"name": "lower_semicontinuous_const", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous.upper_semicontinuous_on", "description": "", "p": "mathlib"}, {"name": "continuous_at.comp_upper_semicontinuous_at_antitone", "description": "", "p": "mathlib"}, {"name": "continuous_within_at.upper_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_at.add", "description": " The sum of two upper semicontinuous functions is upper semicontinuous. Formulated with\n`[has_continuous_add]`. The primed version of the lemma uses an explicit continuity assumption on\naddition, for application to `ereal`.", "p": "mathlib"}, {"name": "lower_semicontinuous_on_csupr", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous.is_open_preimage", "description": "", "p": "mathlib"}, {"name": "continuous_within_at.lower_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "is_closed.lower_semicontinuous_on_indicator", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_on_sum", "description": "", "p": "mathlib"}, {"name": "continuous.lower_semicontinuous", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_at_const", "description": "", "p": "mathlib"}, {"name": "continuous.comp_lower_semicontinuous_antitone", "description": "", "p": "mathlib"}, {"name": "continuous_at.comp_upper_semicontinuous_at", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_within_at.add", "description": " The sum of two upper semicontinuous functions is upper semicontinuous. Formulated with\n`[has_continuous_add]`. The primed version of the lemma uses an explicit continuity assumption on\naddition, for application to `ereal`.", "p": "mathlib"}, {"name": "lower_semicontinuous_on_univ_iff", "description": "", "p": "mathlib"}, {"name": "continuous.comp_upper_semicontinuous_antitone", "description": "", "p": "mathlib"}, {"name": "continuous.comp_upper_semicontinuous", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at_const", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_within_at_univ_iff", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous.lower_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_at_const", "description": "", "p": "mathlib"}, {"name": "is_closed.upper_semicontinuous_within_at_indicator", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_at_sum", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_on.add'", "description": " The sum of two upper semicontinuous functions is upper semicontinuous. Formulated with an\nexplicit continuity assumption on addition, for application to `ereal`. The unprimed version of\nthe lemma uses `[has_continuous_add]`.", "p": "mathlib"}, {"name": "lower_semicontinuous.is_closed_preimage", "description": "", "p": "mathlib"}, {"name": "is_closed.lower_semicontinuous_indicator", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_on_cinfi", "description": "", "p": "mathlib"}, {"name": "is_open.lower_semicontinuous_indicator", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous", "description": " A real function `f` is upper semicontinuous if, for any `\u03b5 > 0`, for any `x`, for all `x'`\nclose enough to `x`, then `f x'` is at most `f x + \u03b5`. We formulate this in a general preordered\nspace, using an arbitrary `y > f x` instead of `f x + \u03b5`.", "p": "mathlib"}, {"name": "is_closed.upper_semicontinuous_indicator", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_binfi", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_within_at.mono", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_at.upper_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at", "description": " A real function `f` is lower semicontinuous at `x` within a set `s` if, for any `\u03b5 > 0`, for all\n`x'` close enough to `x` in  `s`, then `f x'` is at least `f x - \u03b5`. We formulate this in a general\npreordered space, using an arbitrary `y < f x` instead of `f x - \u03b5`.", "p": "mathlib"}, {"name": "upper_semicontinuous_at_binfi", "description": "", "p": "mathlib"}, {"name": "continuous_at.comp_lower_semicontinuous_at", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_at.add", "description": " The sum of two lower semicontinuous functions is lower semicontinuous. Formulated with\n`[has_continuous_add]`. The primed version of the lemma uses an explicit continuity assumption on\naddition, for application to `ereal`.", "p": "mathlib"}, {"name": "continuous_iff_lower_upper_semicontinuous", "description": "", "p": "mathlib"}, {"name": "continuous.comp_upper_semicontinuous_on_antitone", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at_csupr", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_on.upper_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_at", "description": " A real function `f` is lower semicontinuous at `x` if, for any `\u03b5 > 0`, for all `x'` close\nenough to `x`, then `f x'` is at least `f x - \u03b5`. We formulate this in a general preordered space,\nusing an arbitrary `y < f x` instead of `f x - \u03b5`.", "p": "mathlib"}, {"name": "is_open.upper_semicontinuous_on_indicator", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_on_binfi", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_at_sum", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_at_infi", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous", "description": " A real function `f` is lower semicontinuous if, for any `\u03b5 > 0`, for any `x`, for all `x'` close\nenough to `x`, then `f x'` is at least `f x - \u03b5`. We formulate this in a general preordered space,\nusing an arbitrary `y < f x` instead of `f x - \u03b5`.", "p": "mathlib"}, {"name": "upper_semicontinuous_within_at_binfi", "description": "", "p": "mathlib"}, {"name": "is_closed.upper_semicontinuous_on_indicator", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_on_supr", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_at.add'", "description": " The sum of two upper semicontinuous functions is upper semicontinuous. Formulated with an\nexplicit continuity assumption on addition, for application to `ereal`. The unprimed version of\nthe lemma uses `[has_continuous_add]`.", "p": "mathlib"}, {"name": "continuous.comp_upper_semicontinuous_on", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous.add", "description": " The sum of two lower semicontinuous functions is lower semicontinuous. Formulated with\n`[has_continuous_add]`. The primed version of the lemma uses an explicit continuity assumption on\naddition, for application to `ereal`.", "p": "mathlib"}, {"name": "lower_semicontinuous_sum", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_at_csupr", "description": "", "p": "mathlib"}, {"name": "is_open.lower_semicontinuous_within_at_indicator", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_within_at_const", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous.lower_semicontinuous_at", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_at_supr", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_on_tsum", "description": "", "p": "mathlib"}, {"name": "continuous_at.upper_semicontinuous_at", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_on_const", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_within_at_cinfi", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous.upper_semicontinuous_at", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_csupr", "description": "", "p": "mathlib"}, {"name": "continuous_at.comp_lower_semicontinuous_within_at_antitone", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at_supr", "description": "", "p": "mathlib"}, {"name": "continuous_at.comp_upper_semicontinuous_within_at_antitone", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_on.add", "description": " The sum of two upper semicontinuous functions is upper semicontinuous. Formulated with\n`[has_continuous_add]`. The primed version of the lemma uses an explicit continuity assumption on\naddition, for application to `ereal`.", "p": "mathlib"}, {"name": "upper_semicontinuous_infi", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at_bsupr", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_within_at", "description": " A real function `f` is upper semicontinuous at `x` within a set `s` if, for any `\u03b5 > 0`, for all\n`x'` close enough to `x` in  `s`, then `f x'` is at most `f x + \u03b5`. We formulate this in a general\npreordered space, using an arbitrary `y > f x` instead of `f x + \u03b5`.", "p": "mathlib"}, {"name": "upper_semicontinuous_iff_is_closed_preimage", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous.is_open_preimage", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_at_bsupr", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous.add", "description": " The sum of two upper semicontinuous functions is upper semicontinuous. Formulated with\n`[has_continuous_add]`. The primed version of the lemma uses an explicit continuity assumption on\naddition, for application to `ereal`.", "p": "mathlib"}, {"name": "upper_semicontinuous_within_at.add'", "description": " The sum of two upper semicontinuous functions is upper semicontinuous. Formulated with an\nexplicit continuity assumption on addition, for application to `ereal`. The unprimed version of\nthe lemma uses `[has_continuous_add]`.", "p": "mathlib"}, {"name": "lower_semicontinuous_at.add'", "description": " The sum of two lower semicontinuous functions is lower semicontinuous. Formulated with an\nexplicit continuity assumption on addition, for application to `ereal`. The unprimed version of\nthe lemma uses `[has_continuous_add]`.", "p": "mathlib"}, {"name": "upper_semicontinuous.upper_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_on_const", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_on_univ_iff", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_on_bsupr", "description": "", "p": "mathlib"}, {"name": "continuous_on.lower_semicontinuous_on", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at.add'", "description": " The sum of two lower semicontinuous functions is lower semicontinuous. Formulated with an\nexplicit continuity assumption on addition, for application to `ereal`. The unprimed version of\nthe lemma uses `[has_continuous_add]`.", "p": "mathlib"}, {"name": "continuous.comp_lower_semicontinuous_on_antitone", "description": "", "p": "mathlib"}, {"name": "continuous_at.comp_lower_semicontinuous_within_at", "description": "", "p": "mathlib"}, {"name": "continuous_at.lower_semicontinuous_at", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at.add", "description": " The sum of two lower semicontinuous functions is lower semicontinuous. Formulated with\n`[has_continuous_add]`. The primed version of the lemma uses an explicit continuity assumption on\naddition, for application to `ereal`.", "p": "mathlib"}, {"name": "continuous_at.comp_lower_semicontinuous_at_antitone", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_at_cinfi", "description": "", "p": "mathlib"}, {"name": "is_open.upper_semicontinuous_at_indicator", "description": "", "p": "mathlib"}, {"name": "is_open.upper_semicontinuous_within_at_indicator", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous.lower_semicontinuous_on", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_cinfi", "description": "", "p": "mathlib"}, {"name": "continuous_on_iff_lower_upper_semicontinuous_on", "description": "", "p": "mathlib"}, {"name": "is_closed.lower_semicontinuous_within_at_indicator", "description": "", "p": "mathlib"}, {"name": "is_open.lower_semicontinuous_on_indicator", "description": "", "p": "mathlib"}, {"name": "is_open.lower_semicontinuous_at_indicator", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_on", "description": " A real function `f` is lower semicontinuous on a set `s` if, for any `\u03b5 > 0`, for any `x \u2208 s`,\nfor all `x'` close enough to `x` in `s`, then `f x'` is at least `f x - \u03b5`. We formulate this in\na general preordered space, using an arbitrary `y < f x` instead of `f x - \u03b5`.", "p": "mathlib"}, {"name": "upper_semicontinuous_on", "description": " A real function `f` is upper semicontinuous on a set `s` if, for any `\u03b5 > 0`, for any `x \u2208 s`,\nfor all `x'` close enough to `x` in `s`, then `f x'` is at most `f x + \u03b5`. We formulate this in a\ngeneral preordered space, using an arbitrary `y > f x` instead of `f x + \u03b5`.", "p": "mathlib"}, {"name": "lower_semicontinuous_on.mono", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous.is_closed_preimage", "description": "", "p": "mathlib"}, {"name": "continuous_on.upper_semicontinuous_on", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at_univ_iff", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_on.add'", "description": " The sum of two lower semicontinuous functions is lower semicontinuous. Formulated with an\nexplicit continuity assumption on addition, for application to `ereal`. The unprimed version of\nthe lemma uses `[has_continuous_add]`.", "p": "mathlib"}, {"name": "lower_semicontinuous_bsupr", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_tsum", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_within_at_tsum", "description": "", "p": "mathlib"}, {"name": "continuous.upper_semicontinuous", "description": "", "p": "mathlib"}, {"name": "upper_semicontinuous_const", "description": "", "p": "mathlib"}, {"name": "lower_semicontinuous_at_tsum", "description": "", "p": "mathlib"}, {"name": "is_closed.upper_semicontinuous_at_indicator", "description": "", "p": "mathlib"}, {"name": "continuous_within_at_iff_lower_upper_semicontinuous_within_at", "description": "", "p": "mathlib"}, {