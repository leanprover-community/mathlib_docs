ad.algebra.id_f", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.adj_counit", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.counit", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_functor_of_monad_hom_comp_hom_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.iso_mk_hom_f", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_functor_of_monad_hom_obj_a", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.comp_eq_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.counit_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.left_adjoint_forget", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.adj_unit", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra.EilenbergMoore", "description": "The category of Eilenberg-Moore algebras for a monad.\n   cf Definition 5.2.4 in [Riehl][riehl2017].", "p": "mathlib"}, {"name": "category_theory.monad.algebra.iso_mk_hom_f", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra", "description": "An Eilenberg-Moore coalgebra for a comonad `T`.", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.A", "description": "An Eilenberg-Moore coalgebra for a comonad `T`.", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.a", "description": "An Eilenberg-Moore coalgebra for a comonad `T`.", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.counit'", "description": "An Eilenberg-Moore coalgebra for a comonad `T`.", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.coassoc'", "description": "An Eilenberg-Moore coalgebra for a comonad `T`.", "p": "mathlib"}, {"name": "category_theory.monad.algebra.category_theory.category_struct", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra.hom.ext_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra.hom.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.hom.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.iso_mk", "description": "To construct an isomorphism of coalgebras, it suffices to give an isomorphism of the carriers which\ncommutes with the structure morphisms.", "p": "mathlib"}, {"name": "category_theory.monad.algebra_equiv_of_iso_monads_comp_forget", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.EilenbergMoore", "description": "The category of Eilenberg-Moore coalgebras for a comonad.", "p": "mathlib"}, {"name": "category_theory.comonad.forget.category_theory.is_left_adjoint", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.hom.id", "description": "The identity homomorphism for an Eilenberg\u2013Moore coalgebra.", "p": "mathlib"}, {"name": "category_theory.monad.forget.category_theory.is_right_adjoint", "description": "", "p": "mathlib"}, {"name": "category_theory.comonad.forget_reflects_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_epi_of_epi", "description": "Given an algebra morphism whose carrier part is an epimorphism, we get an algebra epimorphism.", "p": "mathlib"}, {"name": "category_theory.comonad.cofree", "description": " The cofree functor from the Eilenberg-Moore category, constructing a coalgebra for any\nobject.", "p": "mathlib"}, {"name": "category_theory.comonad.algebra_epi_of_epi", "description": "Given a coalgebra morphism whose carrier part is an epimorphism, we get an algebra epimorphism.", "p": "mathlib"}, {"name": "category_theory.monad.algebra_iso_of_iso", "description": "Given an algebra morphism whose carrier part is an isomorphism, we get an algebra isomorphism.", "p": "mathlib"}, {"name": "category_theory.monad.algebra_functor_of_monad_hom_obj_A", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.forget_faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra.iso_mk", "description": "To construct an isomorphism of algebras, it suffices to give an isomorphism of the carriers which\ncommutes with the structure morphisms.", "p": "mathlib"}, {"name": "category_theory.comonad.coalgebra.coassoc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.monad.algebra_functor_of_monad_hom_eq", "description": "If `f` and `g` are two equal morphisms of monads, then the functors of algebras induced by them\nare isomorphic.\nWe define it like this as opposed to using `eq_to_iso` so that the components are nicer to prove\nlemmas about.", "p": "mathlib"}, {"name": "category_theory.monad.algebra.iso_mk_inv_f", "description": "", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist", "description": " The Hausdorff edistance between two sets is the smallest `r` such that each set\nis contained in the `r`-neighborhood of the other one", "p": "mathlib"}, {"name": "emetric.inf_edist_closure_pos_iff_not_mem_closure", "description": "", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_nonneg", "description": "The Hausdorff distance is nonnegative", "p": "mathlib"}, {"name": "metric.inf_edist_ne_top", "description": "In a metric space, the minimal edistance to a nonempty set is finite", "p": "mathlib"}, {"name": "emetric.inf_edist_pos_iff_not_mem_closure", "description": " The infimum edistance of a point to a set is positive if and only if the point is not in the\nclosure of the set.", "p": "mathlib"}, {"name": "metric.closure_subset_cthickening", "description": "The closed thickening of a set contains the closure of the set.", "p": "mathlib"}, {"name": "metric.inf_dist", "description": "The minimal distance of a point to a set", "p": "mathlib"}, {"name": "metric.ediam_cthickening_le", "description": "", "p": "mathlib"}, {"name": "metric.thickening_empty", "description": "The (open) thickening of the empty set is empty.", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_le_of_inf_dist", "description": " Bounding the Hausdorff distance by bounding the distance of any point\nin each set to the other set", "p": "mathlib"}, {"name": "metric.inf_dist_le_inf_dist_add_dist", "description": " The minimal distance from `x` to `s` is bounded by the distance from `y` to `s`, modulo\nthe distance between `x` and `y`", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_self_zero", "description": "The Hausdorff distance between a set and itself is zero", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_empty", "description": " The Hausdorff distance to the empty set vanishes (if you want to have the more reasonable\nvalue \u221e instead, use `Hausdorff_edist`, which takes values in \u211d\u22650\u221e)", "p": "mathlib"}, {"name": "emetric.inf_edist_singleton", "description": "The edist to a singleton is the edistance to the single point of this singleton", "p": "mathlib"}, {"name": "metric.lipschitz_inf_nndist_pt", "description": "The minimal distance to a set (as `\u211d\u22650`) is Lipschitz in point with constant 1", "p": "mathlib"}, {"name": "emetric.disjoint_closed_ball_of_lt_inf_edist", "description": "", "p": "mathlib"}, {"name": "metric.diam_thickening_le", "description": "", "p": "mathlib"}, {"name": "metric.bounded.thickening", "description": "", "p": "mathlib"}, {"name": "metric.lipschitz_inf_dist_pt", "description": "The minimal distance to a set is Lipschitz in point with constant 1", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_closure", "description": "The Hausdorff distance between two sets and their closures coincide", "p": "mathlib"}, {"name": "is_closed.cthickening_eq_bUnion_closed_ball", "description": "", "p": "mathlib"}, {"name": "metric.ediam_thickening_le", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_empty", "description": "", "p": "mathlib"}, {"name": "is_closed.mem_iff_inf_dist_zero", "description": "Given a closed set `s`, a point belongs to `s` iff its infimum distance to this set vanishes", "p": "mathlib"}, {"name": "is_compact.exists_inf_dist_eq_dist", "description": "", "p": "mathlib"}, {"name": "metric.mem_cthickening_iff", "description": "", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_closure\u2081", "description": "Replacing a set by its closure does not change the Hausdorff edistance.", "p": "mathlib"}, {"name": "metric.exists_mem_closure_inf_dist_eq_dist", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_lt_iff", "description": "The edist to a set is `< r` iff there exists a point in the set at edistance `< r`", "p": "mathlib"}, {"name": "emetric.inf_edist_le_inf_edist_add_edist", "description": " The edist of `x` to `s` is bounded by the sum of the edist of `y` to `s` and\nthe edist from `x` to `y`", "p": "mathlib"}, {"name": "metric.cthickening_eq_preimage_inf_edist", "description": "", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_self", "description": "The Hausdorff edistance of a set to itself vanishes", "p": "mathlib"}, {"name": "metric.cthickening_subset_thickening'", "description": " The closed thickening `cthickening \u03b4\u2081 E` is contained in the open thickening `thickening \u03b4\u2082 E`\nif the radius of the latter is positive and larger.", "p": "mathlib"}, {"name": "emetric.continuous_inf_edist", "description": "The edist to a set depends continuously on the point", "p": "mathlib"}, {"name": "metric.thickening_eq_preimage_inf_edist", "description": "The (open) thickening equals the preimage of an open interval under `inf_edist`.", "p": "mathlib"}, {"name": "metric.self_subset_cthickening", "description": "A set is contained in its own closed thickening.", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_self_closure", "description": "The Hausdorff distance between a set and its closure vanish", "p": "mathlib"}, {"name": "metric.cthickening", "description": " The closed `\u03b4`-thickening `cthickening \u03b4 E` of a subset `E` in a pseudo emetric space consists\nof those points that are at infimum distance at most `\u03b4` from `E`.", "p": "mathlib"}, {"name": "metric.inf_edist_le_inf_edist_cthickening_add", "description": "For the equality, see `inf_edist_cthickening`.", "p": "mathlib"}, {"name": "metric.inf_dist_le_dist_of_mem", "description": "The minimal distance to a set is bounded by the distance to any point in this set", "p": "mathlib"}, {"name": "emetric.inf_edist_anti", "description": "The edist is antitone with respect to inclusion.", "p": "mathlib"}, {"name": "metric.ball_inf_dist_subset_compl", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_smul", "description": "", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_self_closure", "description": "The Hausdorff edistance between a set and its closure vanishes", "p": "mathlib"}, {"name": "metric.has_basis_nhds_set_cthickening", "description": "", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_image", "description": "The Hausdorff edistance is invariant under eisometries", "p": "mathlib"}, {"name": "metric.frontier_thickening_disjoint", "description": "", "p": "mathlib"}, {"name": "metric.has_basis_nhds_set_thickening", "description": "", "p": "mathlib"}, {"name": "metric.cthickening_zero", "description": "The closed thickening with radius zero is the closure of the set.", "p": "mathlib"}, {"name": "metric.mem_thickening_iff_inf_edist_lt", "description": "", "p": "mathlib"}, {"name": "metric.inf_dist_le_Hausdorff_dist_of_mem", "description": "The distance to a set is controlled by the Hausdorff distance", "p": "mathlib"}, {"name": "metric.dist_le_inf_dist_add_diam", "description": "", "p": "mathlib"}, {"name": "emetric.mem_iff_inf_edist_zero_of_closed", "description": "Given a closed set `s`, a point belongs to `s` iff its infimum edistance to this set vanishes", "p": "mathlib"}, {"name": "metric.frontier_thickening_subset", "description": "The frontier of the (open) thickening of a set is contained in an `inf_edist` level set.", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_closure\u2082", "description": "Replacing a set by its closure does not change the Hausdorff edistance.", "p": "mathlib"}, {"name": "metric.mem_cthickening_of_edist_le", "description": "", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_closure", "description": "The Hausdorff edistance between sets or their closures is the same", "p": "mathlib"}, {"name": "metric.thickening_cthickening_subset", "description": "For the equality, see `thickening_cthickening`.", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_comm", "description": "The Haudorff edistances of `s` to `t` and of `t` to `s` coincide", "p": "mathlib"}, {"name": "is_closed.Hausdorff_dist_zero_iff_eq", "description": "Two closed sets are at zero Hausdorff distance if and only if they coincide", "p": "mathlib"}, {"name": "disjoint.exists_thickenings", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_image", "description": "The infimum edistance is invariant under isometries", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_le_ediam", "description": "The Hausdorff distance is controlled by the diameter of the union", "p": "mathlib"}, {"name": "emetric.inf_edist_le_Hausdorff_edist_of_mem", "description": "The distance to a set is controlled by the Hausdorff distance", "p": "mathlib"}, {"name": "emetric.empty_or_nonempty_of_Hausdorff_edist_ne_top", "description": "", "p": "mathlib"}, {"name": "metric.thickening_eq_bUnion_ball", "description": " The (open) `\u03b4`-thickening `thickening \u03b4 E` of a subset `E` in a metric space equals the\nunion of balls of radius `\u03b4` centered at points of `E`.", "p": "mathlib"}, {"name": "metric.closed_ball_subset_cthickening_singleton", "description": "", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_triangle", "description": "The Hausdorff distance satisfies the triangular inequality", "p": "mathlib"}, {"name": "metric.inf_dist_image", "description": "The infimum distance is invariant under isometries", "p": "mathlib"}, {"name": "metric.continuous_inf_nndist_pt", "description": "The minimal distance to a set (as `\u211d\u22650`) is continuous in point", "p": "mathlib"}, {"name": "metric.thickening_mono", "description": " The (open) thickening `thickening \u03b4 E` of a fixed subset `E` is an increasing function of the\nthickening radius `\u03b4`.", "p": "mathlib"}, {"name": "is_compact.exists_cthickening_subset_open", "description": "", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_closure\u2081", "description": "Replacing a set by its closure does not change the Hausdorff distance.", "p": "mathlib"}, {"name": "metric.closure_thickening_subset_cthickening", "description": "", "p": "mathlib"}, {"name": "metric.thickening_closure", "description": "", "p": "mathlib"}, {"name": "metric.thickening_of_nonpos", "description": "", "p": "mathlib"}, {"name": "metric.bounded.cthickening", "description": "", "p": "mathlib"}, {"name": "metric.thickening_union", "description": "", "p": "mathlib"}, {"name": "metric.inf_dist_le_inf_dist_add_Hausdorff_dist", "description": " The infimum distance to `s` and `t` are the same, up to the Hausdorff distance\nbetween `s` and `t`", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_zero_iff_closure_eq_closure", "description": "Two sets are at zero Hausdorff edistance if and only if they have the same closure", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_empty", "description": "The Haudorff edistance to the empty set is infinite", "p": "mathlib"}, {"name": "emetric.mem_closure_iff_inf_edist_zero", "description": "A point belongs to the closure of `s` iff its infimum edistance to this set vanishes", "p": "mathlib"}, {"name": "metric.continuous_inf_dist_pt", "description": "The minimal distance to a set is continuous in point", "p": "mathlib"}, {"name": "emetric.exists_pos_forall_lt_edist", "description": "", "p": "mathlib"}, {"name": "metric.cthickening_eq_Inter_cthickening", "description": "", "p": "mathlib"}, {"name": "metric.disjoint_closed_ball_of_lt_inf_dist", "description": "", "p": "mathlib"}, {"name": "metric.cthickening_eq_Inter_thickening", "description": "", "p": "mathlib"}, {"name": "emetric.nonempty_of_Hausdorff_edist_ne_top", "description": "If a set is at finite Hausdorff edistance of a nonempty set, it is nonempty", "p": "mathlib"}, {"name": "metric.mem_thickening_iff", "description": " A point in a metric space belongs to the (open) `\u03b4`-thickening of a subset `E` if and only if\nit is at distance less than `\u03b4` from some point of `E`.", "p": "mathlib"}, {"name": "metric.cthickening_max_zero", "description": "", "p": "mathlib"}, {"name": "metric.diam_cthickening_le", "description": "", "p": "mathlib"}, {"name": "metric.inf_edist_le_inf_edist_thickening_add", "description": "For the equality, see `inf_edist_thickening`.", "p": "mathlib"}, {"name": "metric.self_subset_thickening", "description": "A set is contained in its own (open) thickening.", "p": "mathlib"}, {"name": "metric.cthickening_subset_of_subset", "description": " The closed thickening `cthickening \u03b4 E` with a fixed thickening radius `\u03b4` is\nan increasing function of the subset `E`.", "p": "mathlib"}, {"name": "metric.thickening", "description": " The (open) `\u03b4`-thickening `thickening \u03b4 E` of a subset `E` in a pseudo emetric space consists\nof those points that are at distance less than `\u03b4` from some point of `E`.", "p": "mathlib"}, {"name": "emetric.exists_edist_lt_of_Hausdorff_edist_lt", "description": " If the Hausdorff distance is `<r`, then any point in one of the sets has\na corresponding point at distance `<r` in the other set", "p": "mathlib"}, {"name": "metric.inf_dist_eq_infi", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist", "description": "The minimal edistance of a point to a set", "p": "mathlib"}, {"name": "is_closed.exists_inf_dist_eq_dist", "description": "", "p": "mathlib"}, {"name": "is_compact.cthickening_eq_bUnion_closed_ball", "description": " The closed thickening of a compact set `E` is the union of the balls `closed_ball x \u03b4` over\n`x \u2208 E`.\n\nSee also `metric.cthickening_eq_bUnion_closed_ball`.", "p": "mathlib"}, {"name": "metric.thickening_singleton", "description": "", "p": "mathlib"}, {"name": "emetric.le_inf_edist", "description": "", "p": "mathlib"}, {"name": "metric.closure_subset_thickening", "description": "The (open) thickening of a set contains the closure of the set.", "p": "mathlib"}, {"name": "metric.cthickening_mem_nhds_set", "description": "", "p": "mathlib"}, {"name": "metric.thickening_subset_of_subset", "description": " The (open) thickening `thickening \u03b4 E` with a fixed thickening radius `\u03b4` is\nan increasing function of the subset `E`.", "p": "mathlib"}, {"name": "metric.frontier_cthickening_subset", "description": "The frontier of the closed thickening of a set is contained in an `inf_edist` level set.", "p": "mathlib"}, {"name": "disjoint.exists_cthickenings", "description": "", "p": "mathlib"}, {"name": "metric.uniform_continuous_inf_nndist_pt", "description": "The minimal distance to a set (as `\u211d\u22650`) is uniformly continuous in point", "p": "mathlib"}, {"name": "metric.thickening_subset_cthickening_of_le", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_le_edist_of_mem", "description": "The edist to a set is bounded above by the edist to any of its points", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_le_of_mem_dist", "description": " Bounding the Hausdorff distance by exhibiting, for any point in each set,\nanother point in the other set at controlled distance", "p": "mathlib"}, {"name": "metric.mem_cthickening_of_dist_le", "description": "", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_comm", "description": "The Hausdorff distance from `s` to `t` and from `t` to `s` coincide", "p": "mathlib"}, {"name": "emetric.inf_edist_zero_of_mem", "description": "If a point `x` belongs to `s`, then its edist to `s` vanishes", "p": "mathlib"}, {"name": "metric.cthickening_mono", "description": " The closed thickening `cthickening \u03b4 E` of a fixed subset `E` is an increasing function of\nthe thickening radius `\u03b4`.", "p": "mathlib"}, {"name": "metric.closure_eq_Inter_thickening'", "description": " The closure of a set equals the intersection of its open thickenings of positive radii\naccumulating at zero.", "p": "mathlib"}, {"name": "metric.not_mem_of_dist_lt_inf_dist", "description": "", "p": "mathlib"}, {"name": "metric.cthickening_thickening_subset", "description": "For the equality, see `cthickening_thickening`.", "p": "mathlib"}, {"name": "metric.cthickening_eq_Inter_cthickening'", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_union", "description": "The edist to a union is the minimum of the edists", "p": "mathlib"}, {"name": "metric.cthickening_of_nonpos", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_le_inf_edist_add_Hausdorff_edist", "description": " The distance from `x` to `s` or `t` is controlled in terms of the Hausdorff distance\nbetween `s` and `t`", "p": "mathlib"}, {"name": "metric.mem_closure_iff_inf_dist_zero", "description": "A point belongs to the closure of `s` iff its infimum distance to this set vanishes", "p": "mathlib"}, {"name": "metric.Hausdorff_edist_ne_top_of_nonempty_of_bounded", "description": " If two sets are nonempty and bounded in a metric space, they are at finite Hausdorff\nedistance.", "p": "mathlib"}, {"name": "metric.inf_nndist", "description": "The minimal distance of a point to a set as a `\u211d\u22650`", "p": "mathlib"}, {"name": "metric.inf_dist_inter_closed_ball_of_mem", "description": "", "p": "mathlib"}, {"name": "metric.cthickening_closure", "description": "", "p": "mathlib"}, {"name": "metric.is_open_thickening", "description": "The (open) thickening is an open set.", "p": "mathlib"}, {"name": "is_open.exists_Union_is_closed", "description": "", "p": "mathlib"}, {"name": "metric.thickening_Union", "description": "", "p": "mathlib"}, {"name": "metric.closed_ball_subset_cthickening", "description": " The closed ball of radius `\u03b4` centered at a point of `E` is included in the closed\nthickening of `E`.", "p": "mathlib"}, {"name": "metric.inf_dist_zero_of_mem", "description": "The minimal distance of a point to a set containing it vanishes", "p": "mathlib"}, {"name": "metric.disjoint_ball_inf_dist", "description": "", "p": "mathlib"}, {"name": "metric.inf_dist_nonneg", "description": "the minimal distance is always nonnegative", "p": "mathlib"}, {"name": "metric.cthickening_subset_Union_closed_ball_of_lt", "description": "", "p": "mathlib"}, {"name": "metric.exists_dist_lt_of_Hausdorff_dist_lt'", "description": " If the Hausdorff distance is `<r`, then any point in one of the sets is at distance\n`<r` of a point in the other set", "p": "mathlib"}, {"name": "metric.ball_inf_dist_compl_subset", "description": "", "p": "mathlib"}, {"name": "metric.cthickening_empty", "description": "The closed thickening of the empty set is empty.", "p": "mathlib"}, {"name": "metric.closure_eq_Inter_cthickening'", "description": " The closure of a set equals the intersection of its closed thickenings of positive radii\naccumulating at zero.", "p": "mathlib"}, {"name": "is_compact.exists_thickening_subset_open", "description": "", "p": "mathlib"}, {"name": "metric.thickening_subset_cthickening", "description": " The open thickening `thickening \u03b4 E` is contained in the closed thickening `cthickening \u03b4 E`\nwith the same radius.", "p": "mathlib"}, {"name": "metric.frontier_cthickening_disjoint", "description": "", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_closure\u2082", "description": "Replacing a set by its closure does not change the Hausdorff distance.", "p": "mathlib"}, {"name": "emetric.inf_edist_closure", "description": "The edist to a set and to its closure coincide", "p": "mathlib"}, {"name": "metric.cthickening_subset_thickening", "description": "", "p": "mathlib"}, {"name": "metric.inf_dist_eq_closure", "description": "The minimal distance to a set and its closure coincide", "p": "mathlib"}, {"name": "emetric.edist_le_inf_edist_add_ediam", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_vadd", "description": "", "p": "mathlib"}, {"name": "emetric.exists_real_pos_lt_inf_edist_of_not_mem_closure", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_le_edist_add_inf_edist", "description": "", "p": "mathlib"}, {"name": "metric.is_closed_cthickening", "description": "The closed thickening is a closed set.", "p": "mathlib"}, {"name": "metric.inf_dist_zero_of_mem_closure", "description": " If a point belongs to the closure of `s`, then its infimum distance to `s` equals zero.\nThe converse is true provided that `s` is nonempty, see `mem_closure_iff_inf_dist_zero`.", "p": "mathlib"}, {"name": "metric.thickening_mem_nhds_set", "description": "", "p": "mathlib"}, {"name": "metric.exists_dist_lt_of_Hausdorff_dist_lt", "description": " If the Hausdorff distance is `<r`, then any point in one of the sets is at distance\n`<r` of a point in the other set", "p": "mathlib"}, {"name": "metric.cthickening_eq_Inter_thickening'", "description": "", "p": "mathlib"}, {"name": "metric.cthickening_eq_bUnion_closed_ball", "description": "", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_zero_iff_eq_of_closed", "description": "Two closed sets are at zero Hausdorff edistance if and only if they coincide", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_zero_iff_closure_eq_closure", "description": "Two sets are at zero Hausdorff distance if and only if they have the same closures", "p": "mathlib"}, {"name": "is_compact.exists_inf_edist_eq_edist", "description": "", "p": "mathlib"}, {"name": "metric.uniform_continuous_inf_dist_pt", "description": "The minimal distance to a set is uniformly continuous in point", "p": "mathlib"}, {"name": "metric.Hausdorff_dist", "description": " The Hausdorff distance between two sets is the smallest nonnegative `r` such that each set is\nincluded in the `r`-neighborhood of the other. If there is no such `r`, it is defined to\nbe `0`, arbitrarily", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_image", "description": "The Hausdorff distance is invariant under isometries", "p": "mathlib"}, {"name": "metric.cthickening_eq_Inter_thickening''", "description": "", "p": "mathlib"}, {"name": "metric.cthickening_singleton", "description": "", "p": "mathlib"}, {"name": "emetric.inf_edist_Union", "description": "", "p": "mathlib"}, {"name": "metric.thickening_subset_interior_cthickening", "description": "", "p": "mathlib"}, {"name": "metric.cthickening_cthickening_subset", "description": "For the equality, see `cthickening_cthickening`.", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_triangle'", "description": "The Hausdorff distance satisfies the triangular inequality", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_def", "description": "", "p": "mathlib"}, {"name": "metric.coe_inf_nndist", "description": "", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_empty'", "description": " The Hausdorff distance to the empty set vanishes (if you want to have the more reasonable\nvalue \u221e instead, use `Hausdorff_edist`, which takes values in \u211d\u22650\u221e)", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_le_diam", "description": "The Hausdorff distance is controlled by the diameter of the union", "p": "mathlib"}, {"name": "metric.closure_eq_Inter_cthickening", "description": "The closure of a set equals the intersection of its closed thickenings of positive radii.", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_le_of_mem_edist", "description": " Bounding the Hausdorff edistance by exhibiting, for any point in each set,\nanother point in the other set at controlled distance", "p": "mathlib"}, {"name": "metric.inf_dist_empty", "description": " the minimal distance to the empty set is 0 (if you want to have the more reasonable\nvalue \u221e instead, use `inf_edist`, which takes values in \u211d\u22650\u221e)", "p": "mathlib"}, {"name": "metric.Hausdorff_dist_triangle", "description": "The Hausdorff distance satisfies the triangular inequality", "p": "mathlib"}, {"name": "metric.mem_thickening_iff_exists_edist_lt", "description": "", "p": "mathlib"}, {"name": "metric.closure_eq_Inter_thickening", "description": "The closure of a set equals the intersection of its (open) thickenings of positive radii.", "p": "mathlib"}, {"name": "metric.inf_dist_lt_iff", "description": "The minimal distance to a set is `< r` iff there exists a point in this set at distance `< r`", "p": "mathlib"}, {"name": "is_closed.not_mem_iff_inf_dist_pos", "description": "Given a closed set `s`, a point belongs to `s` iff its infimum distance to this set vanishes", "p": "mathlib"}, {"name": "metric.inf_dist_singleton", "description": "The minimal distance to a singleton is the distance to the unique point in this singleton", "p": "mathlib"}, {"name": "metric.cthickening_union", "description": "", "p": "mathlib"}, {"name": "metric.ball_subset_thickening", "description": "", "p": "mathlib"}, {"name": "emetric.Hausdorff_edist_le_of_inf_edist", "description": " Bounding the Hausdorff edistance by bounding the edistance of any point\nin each set to the other set", "p": "mathlib"}, {"name": "metric.thickening_thickening_subset", "description": "For the equality, see `thickening_thickening`.", "p": "mathlib"}, {"name": "metric.inf_dist_le_inf_dist_of_subset", "description": "The minimal distance is monotonous with respect to inclusion", "p": "mathlib"}, {"name": "first_order.language.substructure.cg_iff_Structure_cg", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.fg.of_map_embedding", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.cg_iff_countable", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.cg.sup", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.fg", "description": "A substructure of `M` is finitely generated if it is the closure of a finite subset of `M`.", "p": "mathlib"}, {"name": "first_order.language.Structure.fg_def", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.cg_closure_singleton", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.cg_iff_countable", "description": "", "p": "mathlib"}, {"name": "first_order.language.equiv.fg_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.cg.range", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.cg_of_fg", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.fg_closure", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.fg.map_of_surjective", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.fg_def", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.cg", "description": "A substructure of `M` is countably generated if it is the closure of a countable subset of `M`.", "p": "mathlib"}, {"name": "first_order.language.substructure.cg_bot", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.cg_def", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.cg.map", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.fg_iff", "description": "An equivalent expression of `Structure.fg` in terms of `set.finite` instead of `finset`.", "p": "mathlib"}, {"name": "first_order.language.substructure.fg.map", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.cg_iff_empty_or_exists_nat_generating_family", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.fg.sup", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.cg.map_of_surjective", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.cg", "description": "A structure is countably generated if it is the closure of a countable subset.", "p": "mathlib"}, {"name": "first_order.language.Structure.cg.out", "description": "A structure is countably generated if it is the closure of a countable subset.", "p": "mathlib"}, {"name": "first_order.language.substructure.fg.cg", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.fg_closure_singleton", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.cg.of_map_embedding", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.cg_closure", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.fg_iff_Structure_fg", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.cg_def", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.fg.range", "description": "", "p": "mathlib"}, {"name": "first_order.language.Structure.fg", "description": "A structure is finitely generated if it is the closure of a finite subset.", "p": "mathlib"}, {"name": "first_order.language.Structure.fg.out", "description": "A structure is finitely generated if it is the closure of a finite subset.", "p": "mathlib"}, {"name": "first_order.language.Structure.cg_iff", "description": "An equivalent expression of `Structure.cg`.", "p": "mathlib"}, {"name": "first_order.language.Structure.fg.cg", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.fg_bot", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.fg_iff_exists_fin_generating_family", "description": "", "p": "mathlib"}, {"name": "first_order.language.equiv.cg_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.zero_kernel_fork", "description": "The morphism from the zero object determines a cone on a kernel diagram", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_map_comp_cokernel_comparison_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.iso_of_\u03c0", "description": "Every cokernel cofork `s` is isomorphic (actually, equal) to `cofork.of_\u03c0 (cofork.\u03c0 s) _`.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.is_colimit_cocone_zero_cocone", "description": "The morphism to the zero object is a cokernel of an epimorphism", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork", "description": "A cokernel cofork is just a cofork where the second morphism is a zero morphism.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_is_iso_comp_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_iso_of_eq_trans", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.map_lift_kernel_comparison", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.equalizer_as_kernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_not_epi_of_nonzero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_comp_mono", "description": "When `g` is a monomorphism, the kernel of `f \u226b g` is isomorphic to the kernel of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.is_cokernel.of_iso_comp", "description": "If `i` is an isomorphism such that `i.hom \u226b l = f`, then any cokernel of `f` is a cokernel of\n   `l`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel.map_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.\u03c0_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_kernels", "description": "`has_kernels` represents the existence of kernels for every morphism.", "p": "mathlib"}, {"name": "category_theory.limits.has_kernels.has_limit", "description": "`has_kernels` represents the existence of kernels for every morphism.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_zero_iso_source", "description": "The kernel of a zero morphism is isomorphic to the source.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_image_\u03b9", "description": "The cokernel of the image inclusion of a morphism `f` is isomorphic to the cokernel of `f`.\n\n(This result requires that the factorisation through the image is an epimorphism.\nThis holds in any category with equalizers.)", "p": "mathlib"}, {"name": "category_theory.limits.is_cokernel_of_comp", "description": "Every cokernel of `g \u226b f` is also a cokernel of `f`, as long as `f \u226b c.\u03c0` vanishes.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_iso_of_eq_hom_comp_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_comp_is_iso", "description": "When `g` is an isomorphism, the cokernel of `f \u226b g` is isomorphic to the cokernel of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.is_kernel_of_comp", "description": "Every kernel of `f \u226b g` is also a kernel of `f`, as long as `c.\u03b9 \u226b f` vanishes.", "p": "mathlib"}, {"name": "category_theory.limits.is_cokernel_epi_comp", "description": "Every cokernel of `f` induces a cokernel of `g \u226b f` if `g` is epi.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_iso_of_eq_hom_comp_\u03b9_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_image_\u03b9_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.condition", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.zero_cokernel_of_zero_cancel", "description": "If `f \u226b g = 0` implies `g = 0` for all `g`, then `0 : Y \u27f6 0` is a cokernel of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork.condition", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork.of_\u03b9", "description": "A morphism `\u03b9` satisfying `\u03b9 \u226b f = 0` determines a kernel fork over `f`.", "p": "mathlib"}, {"name": "category_theory.limits.eq_zero_of_epi_kernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.desc", "description": "Given any morphism `k : Y \u27f6 W` such that `f \u226b k = 0`, `k` factors through `cokernel.\u03c0 f`\n   via `cokernel.desc : cokernel f \u27f6 W`.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_map_comp_cokernel_comparison", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.of_mono", "description": "The kernel of a monomorphism is isomorphic to the zero object", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.map_desc", "description": "Given a commutative diagram\n    X --f--> Y --g--> Z\n    |        |        |\n    |        |        |\n    v        v        v\n    X' -f'-> Y' -g'-> Z'\nwith horizontal arrows composing to zero,\nthen we obtain a commutative square\n   cokernel f ---> Z\n   |               |\n   | cokernel.map  |\n   |               |\n   v               v\n   cokernel f' --> Z'", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.desc_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_cokernel_epi_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_is_iso_comp", "description": "When `f` is an isomorphism, the kernel of `f \u226b g` is isomorphic to the kernel of `g`.", "p": "mathlib"}, {"name": "category_theory.limits.is_kernel.iso_kernel", "description": "If `s` is any limit kernel cone over `f` and if  `i` is an isomorphism such that\n   `i.hom \u226b s.\u03b9  = l`, then `l` is a kernel of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork.\u03b9_of_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.lift_comp_kernel_iso_of_eq_inv_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_iso_of_eq_inv_comp_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.lift", "description": "Given any morphism `k : W \u27f6 X` satisfying `k \u226b f = 0`, `k` factors through `kernel.\u03b9 f`\n   via `kernel.lift : W \u27f6 kernel f`.", "p": "mathlib"}, {"name": "category_theory.limits.\u03c0_comp_cokernel_iso_of_eq_hom_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.condition_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_iso_of_eq", "description": "If two morphisms are known to be equal, then their kernels are isomorphic.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_zero_iso_target", "description": "The cokernel of a zero morphism is isomorphic to the target.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_zero_iso_source_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.of_\u03c0_congr", "description": "If `\u03c0 = \u03c0'`, then `cokernel_cofork.of_\u03c0 \u03c0 _` and `cokernel_cofork.of_\u03c0 \u03c0' _` are isomorphic.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.map_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel", "description": "The cokernel of a morphism, expressed as the coequalizer with the 0 morphism.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.desc_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_is_kernel", "description": "The kernel built from `kernel.\u03b9 f` is limiting.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_comp_is_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_limit_aux", "description": "This is a slightly more convenient method to verify that a kernel fork is a limit cone. It\n   only asks for a proof of facts that carry any mathematical content", "p": "mathlib"}, {"name": "category_theory.limits.kernel.lift'", "description": "Any morphism `k : W \u27f6 X` satisfying `k \u226b f = 0` induces a morphism `l : W \u27f6 kernel f` such that\n   `l \u226b kernel.\u03b9 f = k`.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork.of_\u03c0", "description": "A morphism `\u03c0` satisfying `f \u226b \u03c0 = 0` determines a cokernel cofork on `f`.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_epi_comp", "description": "When `f` is an epimorphism, the cokernel of `f \u226b g` is isomorphic to the cokernel of `g`.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.of_iso_comp", "description": "If `i` is an isomorphism such that `i.hom \u226b l = f`, then the cokernel of `f` is a cokernel of\n   `l`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_comparison", "description": "The comparison morphism for the kernel of `f`.\nThis is an isomorphism iff `G` preserves the kernel of `f`; see\n`category_theory/limits/preserves/shapes/kernels.lean`", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.map", "description": "A commuting square induces a morphism of cokernels.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_comp_mono_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.\u03c0_of_epi", "description": "The cokernel morphism of an epimorphism is a zero morphism", "p": "mathlib"}, {"name": "category_theory.limits.lift_comp_kernel_iso_of_eq_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork.is_limit.lift'", "description": "If `s` is a limit kernel fork and `k : W \u27f6 X` satisfies ``k \u226b f = 0`, then there is some\n   `l : W \u27f6 s.X` such that `l \u226b fork.\u03b9 s = k`.", "p": "mathlib"}, {"name": "category_theory.limits.of_\u03b9_congr", "description": "If `\u03b9 = \u03b9'`, then `fork.of_\u03b9 \u03b9 _` and `fork.of_\u03b9 \u03b9' _` are isomorphic.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_not_iso_of_nonzero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_zero_iso_source_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_kernel", "description": "A morphism `f` has a kernel if the functor `parallel_pair f 0` has a limit.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork.\u03c0_eq_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.\u03c0_comp_cokernel_iso_of_eq_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_is_cokernel", "description": "The cokernel built from `cokernel.\u03c0 f` is colimiting.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_iso_of_eq_trans", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.\u03c0_comp_cokernel_comparison", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.of_cokernel_of_epi", "description": "The kernel of the cokernel of an epimorphism is an isomorphism", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.map_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork.is_limit.of_\u03b9", "description": "This is a more convenient formulation to show that a `kernel_fork` constructed using\n`kernel_fork.of_\u03b9` is a limit cone.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_not_iso_of_nonzero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel", "description": "The kernel of a morphism, expressed as the equalizer with the 0 morphism.", "p": "mathlib"}, {"name": "category_theory.limits.kernel.of_comp_iso", "description": "If `i` is an isomorphism such that `l \u226b i.hom = f`, then the kernel of `f` is a kernel of `l`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel.map_iso", "description": "A commuting square of isomorphisms induces an isomorphism of kernels.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_epi_comp_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_iso_of_eq_hom_comp_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.\u03b9_zero_is_iso", "description": "Every kernel of the zero morphism is an isomorphism", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.zero_cokernel_cofork", "description": "The morphism to the zero object determines a cocone on a cokernel diagram", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_comparison_map_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_comparison_comp_\u03b9_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_kernels_of_has_equalizers", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.iso_of_\u03b9", "description": "Every kernel fork `s` is isomorphic (actually, equal) to `fork.of_\u03b9 (fork.\u03b9 s) _`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_iso_of_eq_inv_comp_\u03b9_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.map", "description": "A commuting square induces a morphism of kernels.", "p": "mathlib"}, {"name": "category_theory.limits.is_kernel_comp_mono", "description": "Every kernel of `f` induces a kernel of `f \u226b g` if `g` is mono.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork.\u03c0_of_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_zero_iso_target_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_cokernels_of_has_coequalizers", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_epi_comp_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.\u03c0_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.\u03c0_comp_cokernel_iso_of_eq_inv_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.comp_nat_iso", "description": "If `F` is an equivalence, then applying `F` to a diagram indexing a (co)kernel of `f` yields\n   the diagram indexing the (co)kernel of `F.map f`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel.condition", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_image_\u03b9_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_comparison", "description": "The comparison morphism for the cokernel of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.has_cokernel", "description": "A morphism `f` has a cokernel if the functor `parallel_pair f 0` has a colimit.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_iso_of_eq", "description": "If two morphisms are known to be equal, then their cokernels are isomorphic.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork.condition_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_comparison_map_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_kernel_iso_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_iso_of_eq_hom_comp_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.cokernel_iso", "description": "If `i` is an isomorphism such that `cokernel.\u03c0 f \u226b i.hom = l`, then `l` is a cokernel of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.lift_comp_kernel_iso_of_eq_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.eq_zero_of_mono_cokernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_iso_of_eq_refl", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.desc'", "description": "Any morphism `k : Y \u27f6 W` satisfying `f \u226b k = 0` induces `l : cokernel f \u27f6 W` such that\n   `cokernel.\u03c0 f \u226b l = k`.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_comp_is_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork.condition_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_iso_of_eq_inv_comp_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_kernel.of_comp_iso", "description": "If `i` is an isomorphism such that `l \u226b i.hom = f`, then any kernel of `f` is a kernel of `l`.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_zero_iso_target_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork.is_colimit.of_\u03c0", "description": "This is a more convenient formulation to show that a `cokernel_cofork` constructed using\n`cokernel_cofork.of_\u03c0` is a limit cone.", "p": "mathlib"}, {"name": "category_theory.limits.is_kernel_comp_mono_lift", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.of_kernel_of_mono", "description": "The cokernel of the kernel of a monomorphism is an isomorphism", "p": "mathlib"}, {"name": "category_theory.limits.coequalizer_as_cokernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.iso_kernel", "description": "If `i` is an isomorphism such that `i.hom \u226b kernel.\u03b9 f = l`, then `l` is a kernel of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.is_cokernel.cokernel_iso", "description": "If `s` is any colimit cokernel cocone over `f` and `i` is an isomorphism such that\n   `s.\u03c0 \u226b i.hom = l`, then `l` is a cokernel of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_not_mono_of_nonzero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork", "description": "A kernel fork is just a fork where the second morphism is a zero morphism.", "p": "mathlib"}, {"name": "category_theory.limits.kernel.is_limit_cone_zero_cone", "description": "The map from the zero object is a kernel of a monomorphism", "p": "mathlib"}, {"name": "category_theory.limits.kernel.lift_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.map_lift_kernel_comparison_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.\u03c0", "description": "The map from the target of `f` to `cokernel f`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork.app_one", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_comparison_comp_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_comparison_comp_kernel_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork.is_colimit.desc'", "description": "If `s` is a colimit cokernel cofork, then every `k : Y \u27f6 W` satisfying `f \u226b k = 0` induces\n   `l : s.X \u27f6 W` such that `cofork.\u03c0 s \u226b l = k`.", "p": "mathlib"}, {"name": "category_theory.limits.is_cokernel_epi_comp_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.\u03b9", "description": "The map from `kernel f` into the source of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.map_iso", "description": "A commuting square of isomorphisms induces an isomorphism of cokernels.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_comp_mono_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_kernel_comp_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_cokernel_comp_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork.condition", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.lift_zero", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.\u03b9_of_mono", "description": "The kernel morphism of a monomorphism is a zero morphism", "p": "mathlib"}, {"name": "category_theory.limits.lift_comp_kernel_iso_of_eq_hom_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.\u03c0_zero_is_iso", "description": "The cokernel of the zero morphism is an isomorphism", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.condition_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_comparison_comp_kernel_map_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_iso_of_eq_refl", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.lift_\u03b9_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.lift_map", "description": "Given a commutative diagram\n    X --f--> Y --g--> Z\n    |        |        |\n    |        |        |\n    v        v        v\n    X' -f'-> Y' -g'-> Z'\nwith horizontal arrows composing to zero,\nthen we obtain a commutative square\n   X ---> kernel g\n   |         |\n   |         | kernel.map\n   |         |\n   v         v\n   X' --> kernel g'", "p": "mathlib"}, {"name": "category_theory.limits.kernel.\u03b9_of_zero", "description": "The kernel morphism of a zero morphism is an isomorphism", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_iso_of_eq_inv_comp_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_cokernels", "description": "`has_cokernels` represents the existence of cokernels for every morphism.", "p": "mathlib"}, {"name": "category_theory.limits.has_cokernels.has_colimit", "description": "`has_cokernels` represents the existence of cokernels for every morphism.", "p": "mathlib"}, {"name": "category_theory.limits.\u03c0_comp_cokernel_comparison_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.mono_factorisation.kernel_\u03b9_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.of_epi", "description": "The cokernel of an epimorphism is isomorphic to the zero object", "p": "mathlib"}, {"name": "category_theory.limits.kernel_is_iso_comp_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_colimit_aux", "description": "This is a slightly more convenient method to verify that a cokernel cofork is a colimit cocone.\nIt only asks for a proof of facts that carry any mathematical content", "p": "mathlib"}, {"name": "category_theory.limits.cokernel.\u03c0_of_zero", "description": "The cokernel of a zero morphism is an isomorphism", "p": "mathlib"}, {"name": "category_theory.limits.kernel.map_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel.lift_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.zero_kernel_of_cancel_zero", "description": "If `g \u226b f = 0` implies `g = 0` for all `g`, then `0 : 0 \u27f6 X` is a kernel of `f`.", "p": "mathlib"}, {"name": "category_theory.limits.\u03c0_comp_cokernel_iso_of_eq_inv", "description": "", "p": "mathlib"}, {"name": "pell.is_fundamental.mul_inv_x_pos", "description": " If we multiply a positive solution with the inverse of a fundamental solution,\nthe `x`-coordinate stays positive.", "p": "mathlib"}, {"name": "pell.is_fundamental.eq_pow_of_nonneg", "description": "Any nonnegative solution is a power with nonnegative exponent of a fundamental solution.", "p": "mathlib"}, {"name": "pell.exists_of_not_is_square", "description": " If `d` is a positive integer that is not a square, then there is a nontrivial solution\nto the Pell equation `x^2 - d*y^2 = 1`.", "p": "mathlib"}, {"name": "pell.is_fundamental.exists_of_not_is_square", "description": "If `d` is positive and not a square, then a fundamental solution exists.", "p": "mathlib"}, {"name": "pell.solution\u2081.eq_one_or_neg_one_iff_y_eq_zero", "description": "A solution is `1` or `-1` if and only if `y = 0`.", "p": "mathlib"}, {"name": "pell.solution\u2081.exists_pos_of_not_is_square", "description": " If `d` is a positive integer that is not a square, then there exists a solution\nto the Pell equation `x^2 - d*y^2 = 1` with `x > 1` and `y > 0`.", "p": "mathlib"}, {"name": "pell.solution\u2081.prop", "description": "The proof that `a` is a solution to the Pell equation `x^2 - d*y^2 = 1`", "p": "mathlib"}, {"name": "pell.solution\u2081.prop_x", "description": "An alternative form of the equation, suitable for rewriting `x^2`.", "p": "mathlib"}, {"name": "pell.solution\u2081.x", "description": "The `x` component of a solution to the Pell equation `x^2 - d*y^2 = 1`", "p": "mathlib"}, {"name": "pell.solution\u2081.y_pow_succ_pos", "description": " If `(x, y)` is a solution with `x` and `y` positive, then all its powers with positive\nnatural exponents have positive `y`.", "p": "mathlib"}, {"name": "pell.solution\u2081.d_pos_of_one_lt_x", "description": "If a solution has `x > 1`, then `d` is positive.", "p": "mathlib"}, {"name": "pell.is_fundamental.x_le_x", "description": " The `x`-coordinate of a fundamental solution is a lower bound for the `x`-coordinate\nof any positive solution.", "p": "mathlib"}, {"name": "pell.solution\u2081", "description": " `pell.solution\u2081 d` is the type of solutions to the Pell equation `x^2 - d*y^2 = 1`.\nWe define this in terms of elements of `\u2124\u221ad` of norm one.", "p": "mathlib"}, {"name": "pell.solution\u2081.y_inv", "description": "", "p": "mathlib"}, {"name": "pell.solution\u2081.mk", "description": "Construct a solution from `x`, `y` and a proof that the equation is satisfied.", "p": "mathlib"}, {"name": "pell.solution\u2081.y_ne_zero_of_one_lt_x", "description": "A solution with `x > 1` must have `y \u2260 0`.", "p": "mathlib"}, {"name": "pell.exists_unique_pos_generator", "description": " When `d` is positive and not a square, then the group of solutions to the Pell equation\n`x^2 - d*y^2 = 1` has a unique positive generator (up to sign).", "p": "mathlib"}, {"name": "pell.solution\u2081.y_neg", "description": "", "p": "mathlib"}, {"name": "pell.solution\u2081.y_mul", "description": "", "p": "mathlib"}, {"name": "pell.solution\u2081.comm_group", "description": "", "p": "mathlib"}, {"name": "pell.is_fundamental.y_le_y", "description": " The `y`-coordinate of a fundamental solution is a lower bound for the `y`-coordinate\nof any positive solution.", "p": "mathlib"}, {"name": "pell.solution\u2081.zsqrtd.has_coe", "description": "", "p": "mathlib"}, {"name": "pell.is_fundamental.zpow_y_lt_iff_lt", "description": "If `a` is a fundamental solution, then `(a^m).y < (a^n).y` if and only if `m < n`.", "p": "mathlib"}, {"name": "pell.solution\u2081.x_neg", "description": "", "p": "mathlib"}, {"name": "pell.is_fundamental.mul_inv_y_nonneg", "description": " If we multiply a positive solution with the inverse of a fundamental solution,\nthe `y`-coordinate remains nonnegative.", "p": "mathlib"}, {"name": "pell.solution\u2081.has_distrib_neg", "description": "", "p": "mathlib"}, {"name": "pell.is_fundamental", "description": " We define a solution to be *fundamental* if it has `x > 1` and `y > 0`\nand its `x` is the smallest possible among solutions with `x > 1`.", "p": "mathlib"}, {"name": "pell.solution\u2081.y", "description": "The `y` component of a solution to the Pell equation `x^2 - d*y^2 = 1`", "p": "mathlib"}, {"name": "pell.pos_generator_iff_fundamental", "description": " A positive solution is a generator (up to sign) of the group of all solutions to the\nPell equation `x^2 - d*y^2 = 1` if and only if it is a fundamental solution.", "p": "mathlib"}, {"name": "pell.is_fundamental.subsingleton", "description": "If there is a fundamental solution, it is unique.", "p": "mathlib"}, {"name": "pell.is_fundamental.mul_inv_x_lt_x", "description": " If we multiply a positive solution with the inverse of a fundamental solution,\nthe `x`-coordinate decreases.", "p": "mathlib"}, {"name": "pell.solution\u2081.exists_pos_variant", "description": " If `a` is any solution, then one of `a`, `a\u207b\u00b9`, `-a`, `-a\u207b\u00b9` has\npositive `x` and nonnegative `y`.", "p": "mathlib"}, {"name": "pell.solution\u2081.y_mul_pos", "description": "The set of solutions with `x` and `y` positive is closed under multiplication.", "p": "mathlib"}, {"name": "pell.solution\u2081.eq_one_of_x_eq_one", "description": "A solution with `x = 1` is trivial.", "p": "mathlib"}, {"name": "pell.solution\u2081.x_pow_pos", "description": " If `(x, y)` is a solution with `x` positive, then all its powers with natural exponents\nhave positive `x`.", "p": "mathlib"}, {"name": "pell.solution\u2081.coe_mk", "description": "", "p": "mathlib"}, {"name": "pell.exists_iff_not_is_square", "description": " If `d` is a positive integer, then there is a nontrivial solution\nto the Pell equation `x^2 - d*y^2 = 1` if and only if `d` is not a square.", "p": "mathlib"}, {"name": "pell.solution\u2081.x_one", "description": "", "p": "mathlib"}, {"name": "pell.solution\u2081.y_zpow_pos", "description": " If `(x, y)` is a solution with `x` and `y` positive, then all its powers with positive\nexponents have positive `y`.", "p": "mathlib"}, {"name": "pell.solution\u2081.x_ne_zero", "description": "A solution has `x \u2260 0`.", "p": "mathlib"}, {"name": "pell.is_pell_solution_iff_mem_unitary", "description": " An element of `\u2124\u221ad` has norm one (i.e., `a.re^2 - d*a.im^2 = 1`) if and only if\nit is contained in the submonoid of unitary elements.\n\nTODO: merge this result with `pell.is_pell_iff_mem_unitary`.", "p": "mathlib"}, {"name": "pell.solution\u2081.y_mk", "description": "", "p": "mathlib"}, {"name": "pell.solution\u2081.x_mul", "description": "", "p": "mathlib"}, {"name": "pell.solution\u2081.x_mul_pos", "description": "The set of solutions with `x > 0` is closed under multiplication.", "p": "mathlib"}, {"name": "pell.is_fundamental.x_pos", "description": "A fundamental solution has positive `x`.", "p": "mathlib"}, {"name": "pell.is_fundamental.y_strict_mono", "description": " The map sending an integer `n` to the `y`-coordinate of `a^n` for a fundamental\nsolution `a` is stritcly increasing.", "p": "mathlib"}, {"name": "pell.solution\u2081.x_inv", "description": "", "p": "mathlib"}, {"name": "pell.solution\u2081.d_nonsquare_of_one_lt_x", "description": "If a solution has `x > 1`, then `d` is not a square.", "p": "mathlib"}, {"name": "pell.is_fundamental.d_nonsquare", "description": "If a fundamental solution exists, then `d` must be a non-square.", "p": "mathlib"}, {"name": "pell.solution\u2081.ext", "description": "Two solutions are equal if their `x` and `y` components are equal.", "p": "mathlib"}, {"name": "pell.is_fundamental.x_mul_y_le_y_mul_x", "description": "", "p": "mathlib"}, {"name": "pell.solution\u2081.exists_nontrivial_of_not_is_square", "description": " If `d` is a positive integer that is not a square, then there exists a nontrivial solution\nto the Pell equation `x^2 - d*y^2 = 1`.", "p": "mathlib"}, {"name": "pell.solution\u2081.prop_y", "description": "An alternative form of the equation, suitable for rewriting `d * y^2`.", "p": "mathlib"}, {"name": "pell.solution\u2081.inhabited", "description": "", "p": "mathlib"}, {"name": "pell.solution\u2081.x_mk", "description": "", "p": "mathlib"}, {"name": "pell.is_fundamental.zpow_eq_one_iff", "description": "The `n`th power of a fundamental solution is trivial if and only if `n = 0`.", "p": "mathlib"}, {"name": "pell.solution\u2081.sign_y_zpow_eq_sign_of_x_pos_of_y_pos", "description": " If `(x, y)` is a solution with `x` and `y` positive, then the `y` component of any power\nhas the same sign as the exponent.", "p": "mathlib"}, {"name": "pell.is_fundamental.zpow_ne_neg_zpow", "description": " A power of a fundamental solution is never equal to the negative of a power of this\nfundamental solution.", "p": "mathlib"}, {"name": "pell.solution\u2081.x_zpow_pos", "description": "If `(x, y)` is a solution with `x` positive, then all its powers have positive `x`.", "p": "mathlib"}, {"name": "pell.is_fundamental.d_pos", "description": "If a fundamental solution exists, then `d` must be positive.", "p": "mathlib"}, {"name": "pell.is_fundamental.eq_zpow_or_neg_zpow", "description": "Every solution is, up to a sign, a power of a given fundamental solution.", "p": "mathlib"}, {"name": "pell.solution\u2081.eq_zero_of_d_neg", "description": "When `d` is negative, then `x` or `y` must be zero in a solution.", "p": "mathlib"}, {"name": "pell.solution\u2081.y_one", "description": "", "p": "mathlib"}, {"name": "cardinal.empty_Theory_categorical", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.ex", "description": "", "p": "mathlib"}, {"name": "first_order.language.complete_theory.is_maximal", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.realize_iff", "description": "", "p": "mathlib"}, {"name": "cardinal.categorical", "description": "A theory is `\u03ba`-categorical if all models of size `\u03ba` are isomorphic.", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable.mono", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable_empty", "description": "", "p": "mathlib"}, {"name": "first_order.language.formula.sup_semantically_equivalent_not_inf_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable_Union_iff_is_satisfiable_Union_finset", "description": "", "p": "mathlib"}, {"name": "first_order.language.formula.imp_semantically_equivalent_not_sup", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.trans", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.semantically_equivalent_all_lift_at", "description": "", "p": "mathlib"}, {"name": "first_order.language.complete_theory.is_complete", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.sup_semantically_equivalent_not_inf_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.models_sentence_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.is_qf.induction_on_sup_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.formula.inf_semantically_equivalent_not_sup_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.semantically_equivalent_not_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.exists_elementarily_equivalent_card_eq", "description": " A consequence of the L\u00f6wenheim\u2013Skolem Theorem: If `\u03ba` is a cardinal greater than the\ncardinalities of `L` and an infinite `L`-structure `M`, then there is a structure of cardinality `\u03ba`\nelementarily equivalent to `M`.", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable_union_distinct_constants_theory_of_card_le", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.model.is_satisfiable", "description": "", "p": "mathlib"}, {"name": "cardinal.categorical.is_complete", "description": "The \u0141o\u015b\u2013Vaught Test : a criterion for categorical theories to be complete.", "p": "mathlib"}, {"name": "first_order.language.exists_elementary_embedding_card_eq_of_le", "description": " A version of The Downward L\u00f6wenheim\u2013Skolem theorem where the structure `N` elementarily embeds\ninto `M`, but is not by type a substructure of `M`, and thus can be chosen to belong to the universe\nof the cardinal `\u03ba`.", "p": "mathlib"}, {"name": "first_order.language.complete_theory.is_satisfiable", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_maximal.mem_or_not_mem", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_complete", "description": "A theory is complete when it is satisfiable and models each sentence or its negation.", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable", "description": "A theory is satisfiable if a structure models it.", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.all", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable_on_Theory_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.ex_semantically_equivalent_not_all_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.inf_semantically_equivalent_not_sup_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.refl", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.semantically_equivalent_to_prenex", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_maximal.mem_iff_models", "description": "", "p": "mathlib"}, {"name": "first_order.language.formula.semantically_equivalent_not_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.exists_model_card_eq", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.models_formula_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_maximal", "description": "A theory is maximal when it is satisfiable and contains each sentence or its negation.\n Maximal theories are complete.", "p": "mathlib"}, {"name": "first_order.language.Theory.is_finitely_satisfiable", "description": "A theory is finitely satisfiable if all of its finite subtheories are satisfiable.", "p": "mathlib"}, {"name": "cardinal.empty_infinite_Theory_is_complete", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_maximal.is_complete", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_maximal.mem_of_models", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.realize_bd_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent", "description": " Two (bounded) formulas are semantically equivalent over a theory `T` when they have the same\ninterpretation in every model of `T`. (This is also known as logical equivalence, which also has a\nproof-theoretic definition.)", "p": "mathlib"}, {"name": "first_order.language.complete_theory.mem_or_not_mem", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent_setoid", "description": "Semantic equivalence forms an equivalence relation on formulas.", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable_directed_union_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.is_refl", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_complete.realize_sentence_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable_iff_is_finitely_satisfiable", "description": " The Compactness Theorem of first-order logic: A theory is satisfiable if and only if it is\nfinitely satisfiable.", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.is_qf.induction_on_inf_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.all_semantically_equivalent_not_ex_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.symm", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.models_bounded_formula", "description": "A theory models a (bounded) formula when any of its nonempty models realizes that formula on all\n inputs.", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable_of_is_satisfiable_on_Theory", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.induction_on_all_ex", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.induction_on_exists_not", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable.is_finitely_satisfiable", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_complete.models_not_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.exists_large_model_of_infinite_model", "description": "Any theory with an infinite model has arbitrarily large models.", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.imp", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.semantically_equivalent.not", "description": "", "p": "mathlib"}, {"name": "first_order.language.exists_elementary_embedding_card_eq_of_ge", "description": " The Upward L\u00f6wenheim\u2013Skolem Theorem: If `\u03ba` is a cardinal greater than the cardinalities of `L`\nand an infinite `L`-structure `M`, then `M` has an elementary extension of cardinality `\u03ba`.", "p": "mathlib"}, {"name": "first_order.language.Theory.models_bounded_formula.realize_sentence", "description": "", "p": "mathlib"}, {"name": "first_order.language.bounded_formula.imp_semantically_equivalent_not_sup", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.is_satisfiable_union_distinct_constants_theory_of_infinite", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.models_sentence_of_mem", "description": "", "p": "mathlib"}, {"name": "first_order.language.exists_elementary_embedding_card_eq", "description": " The L\u00f6wenheim\u2013Skolem Theorem: If `\u03ba` is a cardinal greater than the cardinalities of `L`\nand an infinite `L`-structure `M`, then there is an elementary embedding in the appropriate\ndirection between then `M` and a structure of cardinality `\u03ba`.", "p": "mathlib"}, {"name": "first_order.language.Theory.models_iff_not_satisfiable", "description": "", "p": "mathlib"}, {"name": "function.right_inverse.comp_eq_id", "description": "", "p": "mathlib"}, {"name": "function.extend_injective", "description": "", "p": "mathlib"}, {"name": "function.injective.surjective_comp_right", "description": "", "p": "mathlib"}, {"name": "function.sometimes_spec", "description": "", "p": "mathlib"}, {"name": "function.injective2.left", "description": "A binary injective function is injective when only the left argument varies.", "p": "mathlib"}, {"name": "function.surjective.forall", "description": "", "p": "mathlib"}, {"name": "function.bijective_iff_exists_unique", "description": "", "p": "mathlib"}, {"name": "function.surjective.of_comp", "description": "", "p": "mathlib"}, {"name": "function.bijective.exists_unique", "description": "Shorthand for using projection notation with `function.bijective_iff_exists_unique`.", "p": "mathlib"}, {"name": "function.surj_inv_eq", "description": "", "p": "mathlib"}, {"name": "function.update_eq_iff", "description": "", "p": "mathlib"}, {"name": "function.injective.of_comp_iff", "description": "", "p": "mathlib"}, {"name": "function.left_inverse_surj_inv", "description": "", "p": "mathlib"}, {"name": "function.const_apply", "description": "", "p": "mathlib"}, {"name": "function.involutive.surjective", "description": "", "p": "mathlib"}, {"name": "function.surjective.comp_left", "description": "Composition by an surjective function on the left is itself surjective.", "p": "mathlib"}, {"name": "function.involutive.left_inverse", "description": "", "p": "mathlib"}, {"name": "function.update_eq_self", "description": "", "p": "mathlib"}, {"name": "function.inv_fun_eq", "description": "", "p": "mathlib"}, {"name": "function.left_inverse.right_inverse", "description": "", "p": "mathlib"}, {"name": "function.has_uncurry_induction", "description": "", "p": "mathlib"}, {"name": "function.inv_fun", "description": "The inverse of a function (which is a left inverse if `f` is injective\n and a right inverse if `f` is surjective).", "p": "mathlib"}, {"name": "function.injective2.right'", "description": "As a map from the right argument to a unary function, `f` is injective.", "p": "mathlib"}, {"name": "function.injective.apply_extend", "description": "", "p": "mathlib"}, {"name": "function.injective.decidable_eq", "description": " If the co-domain `\u03b2` of an injective function `f : \u03b1 \u2192 \u03b2` has decidable equality, then\nthe domain `\u03b1` also has decidable equality.", "p": "mathlib"}, {"name": "function.surjective_of_right_cancellable_Prop", "description": "", "p": "mathlib"}, {"name": "function.right_inverse_iff_comp", "description": "", "p": "mathlib"}, {"name": "function.forall_update_iff", "description": "", "p": "mathlib"}, {"name": "function.left_inverse_inv_fun", "description": "", "p": "mathlib"}, {"name": "function.injective2.uncurry", "description": "", "p": "mathlib"}, {"name": "function.update", "description": "Replacing the value of a function at a given point by a given value.", "p": "mathlib"}, {"name": "function.surjective.of_comp_iff'", "description": "", "p": "mathlib"}, {"name": "function.update_eq_self_iff", "description": "", "p": "mathlib"}, {"name": "eq_mp_bijective", "description": "", "p": "mathlib"}, {"name": "function.injective.eq_iff", "description": "", "p": "mathlib"}, {"name": "function.injective_of_partial_inv_right", "description": "", "p": "mathlib"}, {"name": "function.bijective.of_comp_iff", "description": "", "p": "mathlib"}, {"name": "function.surjective.has_right_inverse", "description": "", "p": "mathlib"}, {"name": "function.eq_update_self_iff", "description": "", "p": "mathlib"}, {"name": "function.inv_fun_eq_of_injective_of_right_inverse", "description": "", "p": "mathlib"}, {"name": "function.left_inverse.surjective", "description": "", "p": "mathlib"}, {"name": "function.injective2.left'", "description": "As a map from the left argument to a unary function, `f` is injective.", "p": "mathlib"}, {"name": "function.update_ne_self_iff", "description": "", "p": "mathlib"}, {"name": "function.involutive.comp_self", "description": "", "p": "mathlib"}, {"name": "function.update_same", "description": "", "p": "mathlib"}, {"name": "function.surjective.forall\u2082", "description": "", "p": "mathlib"}, {"name": "function.extend_apply'", "description": "", "p": "mathlib"}, {"name": "function.surj_inv", "description": "The inverse of a surjective function. (Unlike `inv_fun`, this does not require\n `\u03b1` to be inhabited.)", "p": "mathlib"}, {"name": "function.sometimes", "description": " `sometimes f` evaluates to some value of `f`, if it exists. This function is especially\ninteresting in the case where `\u03b1` is a proposition, in which case `f` is necessarily a\nconstant function, so that `sometimes f = f a` for all `a`.", "p": "mathlib"}, {"name": "function.injective.of_comp", "description": "", "p": "mathlib"}, {"name": "function.factors_through.apply_extend", "description": "", "p": "mathlib"}, {"name": "function.factors_through.extend_comp", "description": "", "p": "mathlib"}, {"name": "eq_mpr_bijective", "description": "", "p": "mathlib"}, {"name": "function.decidable_eq_pfun", "description": "", "p": "mathlib"}, {"name": "function.bicompr", "description": "Compose an unary function `f` with a binary function `g`.", "p": "mathlib"}, {"name": "function.injective2", "description": " The property of a binary function `f : \u03b1 \u2192 \u03b2 \u2192 \u03b3` being injective.\nMathematically this should be thought of as the corresponding function `\u03b1 \u00d7 \u03b2 \u2192 \u03b3` being injective.", "p": "mathlib"}, {"name": "bool.involutive_bnot", "description": "", "p": "mathlib"}, {"name": "function.bijective.comp_left", "description": "Composition by an bijective function on the left is itself bijective.", "p": "mathlib"}, {"name": "function.surjective_to_subsingleton", "description": "", "p": "mathlib"}, {"name": "function.update_comp_eq_of_forall_ne", "description": "Non-dependent version of `function.update_comp_eq_of_forall_ne'`", "p": "mathlib"}, {"name": "function.const_comp", "description": "", "p": "mathlib"}, {"name": "function.right_inverse_surj_inv", "description": "", "p": "mathlib"}, {"name": "function.ne_update_self_iff", "description": "", "p": "mathlib"}, {"name": "function.uncurry_bicompr", "description": "", "p": "mathlib"}, {"name": "function.has_uncurry_base", "description": "", "p": "mathlib"}, {"name": "function.sometimes_eq", "description": "", "p": "mathlib"}, {"name": "function.injective_of_partial_inv", "description": "", "p": "mathlib"}, {"name": "function.surjective_eval", "description": "", "p": "mathlib"}, {"name": "function.injective_surj_inv", "description": "", "p": "mathlib"}, {"name": "function.partial_inv", "description": "We can use choice to construct explicitly a partial inverse for\n a given injective function `f`.", "p": "mathlib"}, {"name": "function.surjective.forall\u2083", "description": "", "p": "mathlib"}, {"name": "function.curry_apply", "description": "", "p": "mathlib"}, {"name": "function.is_partial_inv", "description": "`g` is a partial inverse to `f` (an injective but not necessarily\n surjective function) if `g y = some x` implies `f x = y`, and `g y = none`\n implies that `y` is not in the range of `f`.", "p": "mathlib"}, {"name": "function.left_inverse_iff_comp", "description": "", "p": "mathlib"}, {"name": "function.involutive.injective", "description": "", "p": "mathlib"}, {"name": "function.inv_fun_surjective", "description": "", "p": "mathlib"}, {"name": "function.left_inverse.eq_rec_on_eq", "description": "", "p": "mathlib"}, {"name": "function.bijective.surjective", "description": "", "p": "mathlib"}, {"name": "inv_image.equivalence", "description": "", "p": "mathlib"}, {"name": "function.injective.comp_left", "description": "Composition by an injective function on the left is itself injective.", "p": "mathlib"}, {"name": "function.comp_apply", "description": "", "p": "mathlib"}, {"name": "function.update_comm", "description": "", "p": "mathlib"}, {"name": "function.update_idem", "description": "", "p": "mathlib"}, {"name": "function.surjective_iff_has_right_inverse", "description": "", "p": "mathlib"}, {"name": "function.surjective.exists\u2082", "description": "", "p": "mathlib"}, {"name": "function.uncurry_apply_pair", "description": "", "p": "mathlib"}, {"name": "function.bijective.comp_right", "description": "", "p": "mathlib"}, {"name": "function.extend_comp", "description": "", "p": "mathlib"}, {"name": "function.on_fun_apply", "description": "", "p": "mathlib"}, {"name": "function.not_surjective_Type", "description": "There is no surjection from `\u03b1 : Type u` into `Type u`. This theorem\n demonstrates why `Type : Type` would be inconsistent in Lean.", "p": "mathlib"}, {"name": "function.inv_fun_neg", "description": "", "p": "mathlib"}, {"name": "function.const_inj", "description": "", "p": "mathlib"}, {"name": "cast_bijective", "description": "", "p": "mathlib"}, {"name": "function.injective.ne", "description": "", "p": "mathlib"}, {"name": "function.hfunext", "description": "", "p": "mathlib"}, {"name": "function.const_def", "description": "", "p": "mathlib"}, {"name": "function.involutive", "description": "A function is involutive, if `f \u2218 f = id`.", "p": "mathlib"}, {"name": "function.eval_apply", "description": "", "p": "mathlib"}, {"name": "function.update_comp_eq_of_forall_ne'", "description": "", "p": "mathlib"}, {"name": "function.exists_update_iff", "description": "", "p": "mathlib"}, {"name": "function.partial_inv_left", "description": "", "p": "mathlib"}, {"name": "function.surjective.of_comp_iff", "description": "", "p": "mathlib"}, {"name": "function.surjective.exists", "description": "", "p": "mathlib"}, {"name": "function.injective_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "function.injective.factors_through", "description": "", "p": "mathlib"}, {"name": "function.update_noteq", "description": "", "p": "mathlib"}, {"name": "function.apply_update\u2082", "description": "", "p": "mathlib"}, {"name": "function.left_inverse.comp_eq_id", "description": "", "p": "mathlib"}, {"name": "function.injective.eq_iff'", "description": "", "p": "mathlib"}, {"name": "function.bijective.of_comp_iff'", "description": "", "p": "mathlib"}, {"name": "function.left_inverse.right_inverse_of_injective", "description": "", "p": "mathlib"}, {"name": "function.injective.dite", "description": "", "p": "mathlib"}, {"name": "function.injective_iff_has_left_inverse", "description": "", "p": "mathlib"}, {"name": "function.update_comp_eq_of_injective'", "description": "", "p": "mathlib"}, {"name": "set.piecewise", "description": "`s.piecewise f g` is the function equal to `f` on the set `s`, and to `g` on its complement.", "p": "mathlib"}, {"name": "function.uncurry_def", "description": "", "p": "mathlib"}, {"name": "function.eval", "description": "Evaluate a function at an argument. Useful if you want to talk about the partially applied\n `function.eval x : (\u03a0 x, \u03b2 x) \u2192 \u03b2 x`.", "p": "mathlib"}, {"name": "function.comp_update", "description": "", "p": "mathlib"}, {"name": "function.right_inverse.left_inverse_of_surjective", "description": "", "p": "mathlib"}, {"name": "function.factors_through_iff", "description": "", "p": "mathlib"}, {"name": "function.injective.ne_iff", "description": "", "p": "mathlib"}, {"name": "function.bijective.exists_unique_iff", "description": "", "p": "mathlib"}, {"name": "function.involutive.right_inverse", "description": "", "p": "mathlib"}, {"name": "set.separates_points", "description": " A set of functions \"separates points\"\nif for each pair of distinct points there is a function taking different values on them.", "p": "mathlib"}, {"name": "cast_inj", "description": "", "p": "mathlib"}, {"name": "function.comp_const", "description": "", "p": "mathlib"}, {"name": "function.apply_update", "description": "", "p": "mathlib"}, {"name": "function.left_inverse.right_inverse_of_surjective", "description": "", "p": "mathlib"}, {"name": "function.bijective.injective", "description": "", "p": "mathlib"}, {"name": "function.left_inverse.eq_rec_eq", "description": "", "p": "mathlib"}, {"name": "function.extend", "description": " `extend f g e'` extends a function `g : \u03b1 \u2192 \u03b3`\nalong a function `f : \u03b1 \u2192 \u03b2` to a function `\u03b2 \u2192 \u03b3`,\nby using the values of `g` on the range of `f`\nand the values of an auxiliary function `e' : \u03b2 \u2192 \u03b3` elsewhere.\n\nMostly useful when `f` is injective, more generally when `g.factors_through f`.", "p": "mathlib"}, {"name": "eq_rec_on_bijective", "description": "", "p": "mathlib"}, {"name": "function.extend_def", "description": "", "p": "mathlib"}, {"name": "function.involutive.bijective", "description": "", "p": "mathlib"}, {"name": "function.cantor_surjective", "description": " **Cantor's diagonal argument** implies that there are no surjective functions from `\u03b1`\nto `set \u03b1`.", "p": "mathlib"}, {"name": "function.involutive.ite_not", "description": "Involuting an `ite` of an involuted value `x : \u03b1` negates the `Prop` condition in the `ite`.", "p": "mathlib"}, {"name": "function.update_apply", "description": "On non-dependent functions, `function.update` can be expressed as an `ite`", "p": "mathlib"}, {"name": "function.right_inverse.comp", "description": "", "p": "mathlib"}, {"name": "function.injective.surjective_comp_right'", "description": "", "p": "mathlib"}, {"name": "function.id_def", "description": "", "p": "mathlib"}, {"name": "function.is_partial_inv_left", "description": "", "p": "mathlib"}, {"name": "function.injective.extend_apply", "description": "", "p": "mathlib"}, {"name": "function.left_inverse.cast_eq", "description": "", "p": "mathlib"}, {"name": "function.involutive.eq_iff", "description": "An involution commutes across an equality. Compare to `function.injective.eq_iff`.", "p": "mathlib"}, {"name": "function.right_inverse.left_inverse_of_injective", "description": "", "p": "mathlib"}, {"name": "function.surjective.injective_comp_right", "description": "", "p": "mathlib"}, {"name": "function.update_comp_eq_of_injective", "description": "Non-dependent version of `function.update_comp_eq_of_injective'`", "p": "mathlib"}, {"name": "function.left_inverse.eq_right_inverse", "description": "", "p": "mathlib"}, {"name": "function.surjective.exists\u2083", "description": "", "p": "mathlib"}, {"name": "function.update_injective", "description": "", "p": "mathlib"}, {"name": "function.uncurry_bicompl", "description": "", "p": "mathlib"}, {"name": "function.inv_fun_comp", "description": "", "p": "mathlib"}, {"name": "function.partial_inv_of_injective", "description": "", "p": "mathlib"}, {"name": "function.injective.of_comp_iff'", "description": "", "p": "mathlib"}, {"name": "function.left_inverse.comp", "description": "", "p": "mathlib"}, {"name": "eq_rec_inj", "description": "", "p": "mathlib"}, {"name": "function.injective2.eq_iff", "description": "", "p": "mathlib"}, {"name": "function.const_injective", "description": "", "p": "mathlib"}, {"name": "function.cantor_injective", "description": " **Cantor's diagonal argument** implies that there are no injective functions from `set \u03b1`\nto `\u03b1`.", "p": "mathlib"}, {"name": "function.factors_through", "description": "g factors through f : `f a = f b \u2192 g a = g b`", "p": "mathlib"}, {"name": "function.injective2.right", "description": "A binary injective function is injective when only the right argument varies.", "p": "mathlib"}, {"name": "function.funext_iff", "description": "", "p": "mathlib"}, {"name": "function.right_inverse_inv_fun", "description": "", "p": "mathlib"}, {"name": "function.bijective_iff_has_inverse", "description": "", "p": "mathlib"}, {"name": "function.has_uncurry", "description": " Records a way to turn an element of `\u03b1` into a function from `\u03b2` to `\u03b3`. The most generic use\nis to recursively uncurry. For instance `f : \u03b1 \u2192 \u03b2 \u2192 \u03b3 \u2192 \u03b4` will be turned into\n`\u21bff : \u03b1 \u00d7 \u03b2 \u00d7 \u03b3 \u2192 \u03b4`. One can also add instances for bundled maps.", "p": "mathlib"}, {"name": "function.has_uncurry.uncurry", "description": " Records a way to turn an element of `\u03b1` into a function from `\u03b2` to `\u03b3`. The most generic use\nis to recursively uncurry. For instance `f : \u03b1 \u2192 \u03b2 \u2192 \u03b3 \u2192 \u03b4` will be turned into\n`\u21bff : \u03b1 \u00d7 \u03b2 \u00d7 \u03b3 \u2192 \u03b4`. One can also add instances for bundled maps.", "p": "mathlib"}, {"name": "function.ne_iff", "description": "", "p": "mathlib"}, {"name": "function.involutive_iff_iter_2_eq_id", "description": "", "p": "mathlib"}, {"name": "function.eq_update_iff", "description": "", "p": "mathlib"}, {"name": "function.right_inverse.injective", "description": "", "p": "mathlib"}, {"name": "is_symm_op.flip_eq", "description": "", "p": "mathlib"}, {"name": "function.injective.ne_iff'", "description": "", "p": "mathlib"}, {"name": "function.factors_through.extend_apply", "description": "", "p": "mathlib"}, {"name": "function.bicompl", "description": " Compose a binary function `f` with a pair of unary functions `g` and `h`.\nIf both arguments of `f` have the same type and `g = h`, then `bicompl f g g = f on g`.", "p": "mathlib"}, {"name": "function.right_inverse.left_inverse", "description": "", "p": "mathlib"}, {"name": "function.surjective.right_cancellable", "description": "", "p": "mathlib"}, {"name": "function.injective.has_left_inverse", "description": "", "p": "mathlib"}, {"name": "multiset.zero_bind", "description": "", "p": "mathlib"}, {"name": "multiset.sigma_singleton", "description": "", "p": "mathlib"}, {"name": "multiset.sigma", "description": "`sigma s t` is the dependent version of `product`. It is the sum of\n `(a, b)` as `a` ranges over `s` and `b` ranges over `t a`.", "p": "mathlib"}, {"name": "multiset.add_product", "description": "", "p": "mathlib"}, {"name": "multiset.prod_bind", "description": "", "p": "mathlib"}, {"name": "multiset.rel_bind", "description": "", "p": "mathlib"}, {"name": "multiset.bind_zero", "description": "", "p": "mathlib"}, {"name": "multiset.singleton_join", "description": "", "p": "mathlib"}, {"name": "multiset.coe_bind", "description": "", "p": "mathlib"}, {"name": "multiset.bind_map", "description": "", "p": "mathlib"}, {"name": "multiset.join_zero", "description": "", "p": "mathlib"}, {"name": "multiset.card_sigma", "description": "", "p": "mathlib"}, {"name": "multiset.card_bind", "description": "", "p": "mathlib"}, {"name": "multiset.zero_product", "description": "", "p": "mathlib"}, {"name": "multiset.product_add", "description": "", "p": "mathlib"}, {"name": "multiset.product", "description": "The multiplicity of `(a, b)` in `s \u00d7\u02e2 t` is\n the product of the multiplicity of `a` in `s` and `b` in `t`.", "p": "mathlib"}, {"name": "multiset.bind_map_comm", "description": "", "p": "mathlib"}, {"name": "multiset.zero_sigma", "description": "", "p": "mathlib"}, {"name": "multiset.rel_join", "description": "", "p": "mathlib"}, {"name": "multiset.bind_add", "description": "", "p": "mathlib"}, {"name": "multiset.sigma_add", "description": "", "p": "mathlib"}, {"name": "multiset.add_sigma", "description": "", "p": "mathlib"}, {"name": "multiset.attach_bind_coe", "description": "", "p": "mathlib"}, {"name": "multiset.card_join", "description": "", "p": "mathlib"}, {"name": "multiset.cons_bind", "description": "", "p": "mathlib"}, {"name": "multiset.join_cons", "description": "", "p": "mathlib"}, {"name": "multiset.coe_product", "description": "", "p": "mathlib"}, {"name": "multiset.bind", "description": " `s.bind f` is the monad bind operation, defined as `(s.map f).join`. It is the union of `f a` as\n`a` ranges over `s`.", "p": "mathlib"}, {"name": "multiset.card_product", "description": "", "p": "mathlib"}, {"name": "multiset.count_bind", "description": "", "p": "mathlib"}, {"name": "multiset.cons_product", "description": "", "p": "mathlib"}, {"name": "multiset.mem_join", "description": "", "p": "mathlib"}, {"name": "multiset.add_bind", "description": "", "p": "mathlib"}, {"name": "multiset.mem_sigma", "description": "", "p": "mathlib"}, {"name": "multiset.mem_product", "description": "", "p": "mathlib"}, {"name": "multiset.join_add", "description": "", "p": "mathlib"}, {"name": "multiset.bind_congr", "description": "", "p": "mathlib"}, {"name": "multiset.product_cons", "description": "", "p": "mathlib"}, {"name": "multiset.count_sum", "description": "", "p": "mathlib"}, {"name": "multiset.bind_assoc", "description": "", "p": "mathlib"}, {"name": "multiset.bind_bind", "description": "", "p": "mathlib"}, {"name": "multiset.bind_singleton", "description": "", "p": "mathlib"}, {"name": "multiset.singleton_bind", "description": "", "p": "mathlib"}, {"name": "multiset.product_zero", "description": "", "p": "mathlib"}, {"name": "multiset.bind_cons", "description": "", "p": "mathlib"}, {"name": "multiset.join", "description": "`join S`, where `S` is a multiset of multisets, is the lift of the list join\n operation, that is, the union of all the sets.\n    join {{1, 2}, {1, 2}, {0, 1}} = {0, 1, 1, 1, 2, 2}", "p": "mathlib"}, {"name": "multiset.coe_join", "description": "", "p": "mathlib"}, {"name": "multiset.sum_bind", "description": "", "p": "mathlib"}, {"name": "multiset.product_singleton", "description": "", "p": "mathlib"}, {"name": "multiset.map_bind", "description": "", "p": "mathlib"}, {"name": "multiset.coe_sigma", "description": "", "p": "mathlib"}, {"name": "multiset.le_bind", "description": "", "p": "mathlib"}, {"name": "multiset.cons_sigma", "description": "", "p": "mathlib"}, {"name": "multiset.bind_hcongr", "description": "", "p": "mathlib"}, {"name": "multiset.mem_bind", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_space.to_GH_space_rep", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_space.complete_space", "description": "The Gromov-Hausdorff space is complete.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_space.metric_space", "description": "The Gromov-Hausdorff distance defines a genuine distance on the Gromov-Hausdorff space.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_dist_le_nonempty_compacts_dist", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_space.rep", "description": "A metric space representative of any abstract point in `GH_space`", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_dist_le_Hausdorff_dist", "description": " The Gromov-Hausdorff distance between two spaces is bounded by the Hausdorff distance\nof isometric copies of the spaces, in any metric space.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.eq_to_GH_space", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.Hausdorff_dist_optimal", "description": " The optimal coupling constructed above realizes exactly the Gromov-Hausdorff distance,\nessentially by design.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.isometry_rel.setoid", "description": "setoid instance identifying two isometric nonempty compact subspaces of \u2113^\u221e(\u211d)", "p": "mathlib"}, {"name": "Gromov_Hausdorff.aux_gluing_struct", "description": " Auxiliary structure used to glue metric spaces below, recording an isometric embedding\nof a type `A` in another metric space.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.aux_gluing_struct.space", "description": " Auxiliary structure used to glue metric spaces below, recording an isometric embedding\nof a type `A` in another metric space.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.aux_gluing_struct.metric", "description": " Auxiliary structure used to glue metric spaces below, recording an isometric embedding\nof a type `A` in another metric space.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.aux_gluing_struct.embed", "description": " Auxiliary structure used to glue metric spaces below, recording an isometric embedding\nof a type `A` in another metric space.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.aux_gluing_struct.isom", "description": " Auxiliary structure used to glue metric spaces below, recording an isometric embedding\nof a type `A` in another metric space.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.dist_GH_dist", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.to_GH_space_lipschitz", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.aux_gluing", "description": " Auxiliary sequence of metric spaces, containing copies of `X 0`, ..., `X n`, where each\n`X i` is glued to `X (i+1)` in an optimal way. The space at step `n+1` is obtained from the space\nat step `n` by adding `X (n+1)`, glued in an optimal way to the `X n` already sitting there.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_dist_le_of_approx_subsets", "description": " If there are subsets which are `\u03b5\u2081`-dense and `\u03b5\u2083`-dense in two spaces, and\nisometric up to `\u03b5\u2082`, then the Gromov-Hausdorff distance between the spaces is bounded by\n`\u03b5\u2081 + \u03b5\u2082/2 + \u03b5\u2083`.", "p": "mathlib"}, {"name": "topological_space.nonempty_compacts.to_GH_space", "description": " In particular, nonempty compacts of a metric space map to `GH_space`. We register this\nin the topological_space namespace to take advantage of the notation `p.to_GH_space`.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.totally_bounded", "description": " Compactness criterion: a closed set of compact metric spaces is compact if the spaces have\na uniformly bounded diameter, and for all `\u03b5` the number of balls of radius `\u03b5` required\nto cover the spaces is uniformly bounded. This is an equivalence, but we only prove the\ninteresting direction that these conditions imply compactness.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_space.inhabited", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.rep_GH_space_metric_space", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_space.topological_space.second_countable_topology", "description": "The Gromov-Hausdorff space is second countable.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_space", "description": "The Gromov-Hausdorff space", "p": "mathlib"}, {"name": "Gromov_Hausdorff.to_GH_space_eq_to_GH_space_iff_isometry_equiv", "description": " Two nonempty compact spaces have the same image in `GH_space` if and only if they are\nisometric.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.to_GH_space_continuous", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_dist_eq_Hausdorff_dist", "description": " The Gromov-Hausdorff distance can also be realized by a coupling in `\u2113^\u221e(\u211d)`, by embedding\nthe optimal coupling through its Kuratowski embedding.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.rep_GH_space_nonempty", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_space.has_dist", "description": " Distance on `GH_space`: the distance between two nonempty compact spaces is the infimum\nHausdorff distance between isometric copies of the two spaces in a metric space. For the definition,\nwe only consider embeddings in `\u2113^\u221e(\u211d)`, but we will prove below that it works for all spaces.", "p": "mathlib"}, {"name": "Gromov_Hausdorff.rep_GH_space_compact_space", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.aux_gluing_struct.inhabited", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.eq_to_GH_space_iff", "description": "", "p": "mathlib"}, {"name": "Gromov_Hausdorff.to_GH_space", "description": "Map any nonempty compact type to `GH_space`", "p": "mathlib"}, {"name": "Gromov_Hausdorff.GH_dist", "description": " The Gromov-Hausdorff distance between two nonempty compact metric spaces, equal by definition to\nthe distance of the equivalence classes of these spaces in the Gromov-Hausdorff space.", "p": "mathlib"}, {"name": "charmatrix_apply_eq", "description": "", "p": "mathlib"}, {"name": "matrix.charpoly", "description": "The characteristic polynomial of a matrix `M` is given by $\\det (t I - M)$.", "p": "mathlib"}, {"name": "matrix.charpoly_reindex", "description": "", "p": "mathlib"}, {"name": "charmatrix_reindex", "description": "", "p": "mathlib"}, {"name": "mat_poly_equiv_charmatrix", "description": "", "p": "mathlib"}, {"name": "charmatrix_apply", "description": "", "p": "mathlib"}, {"name": "charmatrix", "description": "The \"characteristic matrix\" of `M : matrix n n R` is the matrix of polynomials $t I - M$.\nThe determinant of this matrix is the characteristic polynomial.", "p": "mathlib"}, {"name": "charmatrix_apply_ne", "description": "", "p": "mathlib"}, {"name": "matrix.aeval_self_charpoly", "description": "The **Cayley-Hamilton Theorem**, that the characteristic polynomial of a matrix,\napplied to the matrix itself, is zero.\n\nThis holds over any commutative ring.\n\nSee `linear_map.aeval_self_charpoly` for the equivalent statement about endomorphisms.", "p": "mathlib"}, {"name": "inv_eq_of_aeval_div_X_ne_zero", "description": "", "p": "mathlib"}, {"name": "alg_hom.bijective", "description": "", "p": "mathlib"}, {"name": "polynomial_smul_apply'", "description": "", "p": "mathlib"}, {"name": "is_algebraic_iff_not_injective", "description": "", "p": "mathlib"}, {"name": "is_algebraic_nat", "description": "", "p": "mathlib"}, {"name": "subalgebra.is_algebraic", "description": "A subalgebra is algebraic if all its elements are algebraic.", "p": "mathlib"}, {"name": "algebra.is_integral_of_finite", "description": "A field extension is integral if it is finite.", "p": "mathlib"}, {"name": "subalgebra.inv_mem_of_algebraic", "description": "", "p": "mathlib"}, {"name": "algebra.is_algebraic", "description": "An algebra is algebraic if all its elements are algebraic.", "p": "mathlib"}, {"name": "is_algebraic_of_mem_root_set", "description": "", "p": "mathlib"}, {"name": "is_algebraic_algebra_map", "description": "An element of `R` is algebraic, when viewed as an element of the `R`-algebra `A`.", "p": "mathlib"}, {"name": "subalgebra.is_algebraic_iff", "description": "A subalgebra is algebraic if and only if it is algebraic as an algebra.", "p": "mathlib"}, {"name": "alg_equiv.is_algebraic", "description": "Transfer `algebra.is_algebraic` across an `alg_equiv`.", "p": "mathlib"}, {"name": "transcendental.pow", "description": "", "p": "mathlib"}, {"name": "algebra.is_algebraic_of_larger_base", "description": "If A is an algebraic algebra over K, then A is algebraic over L when L is an extension of K", "p": "mathlib"}, {"name": "is_algebraic_of_larger_base", "description": "If x is a algebraic over K, then x is algebraic over L when L is an extension of K", "p": "mathlib"}, {"name": "polynomial_smul_apply", "description": "", "p": "mathlib"}, {"name": "polynomial.algebra_map_pi_self_eq_eval", "description": "", "p": "mathlib"}, {"name": "alg_equiv.is_algebraic_iff", "description": "", "p": "mathlib"}, {"name": "algebra.is_algebraic_trans", "description": " If L is an algebraic field extension of K and A is an algebraic algebra over L,\nthen A is algebraic over K.", "p": "mathlib"}, {"name": "subalgebra.is_field_of_algebraic", "description": "In an algebraic extension L/K, an intermediate subalgebra is a field.", "p": "mathlib"}, {"name": "is_algebraic_int", "description": "", "p": "mathlib"}, {"name": "is_integral.is_algebraic", "description": "An integral element of an algebra is algebraic.", "p": "mathlib"}, {"name": "is_algebraic_one", "description": "", "p": "mathlib"}, {"name": "inv_eq_of_root_of_coeff_zero_ne_zero", "description": "", "p": "mathlib"}, {"name": "is_algebraic", "description": " An element of an R-algebra is algebraic over R if it is a root of a nonzero polynomial\nwith coefficients in R.", "p": "mathlib"}, {"name": "is_algebraic_of_pow", "description": "", "p": "mathlib"}, {"name": "algebra.is_algebraic.alg_hom_bijective", "description": "", "p": "mathlib"}, {"name": "polynomial.algebra_map_pi_eq_aeval", "description": "", "p": "mathlib"}, {"name": "algebra.is_algebraic_of_larger_base_of_injective", "description": "If A is an algebraic algebra over R, then A is algebraic over S when S is an extension of R,\n and the map from `R` to `S` is injective.", "p": "mathlib"}, {"name": "is_algebraic_algebra_map_iff", "description": "", "p": "mathlib"}, {"name": "algebra.is_algebraic_of_finite", "description": "A field extension is algebraic if it is finite.", "p": "mathlib"}, {"name": "algebra.is_algebraic_iff", "description": "An algebra is algebraic if and only if it is algebraic as a subalgebra.", "p": "mathlib"}, {"name": "algebra.is_algebraic.alg_equiv_equiv_alg_hom_apply", "description": "", "p": "mathlib"}, {"name": "algebra.is_algebraic.alg_equiv_equiv_alg_hom_symm_apply", "description": "", "p": "mathlib"}, {"name": "polynomial.has_smul_pi'", "description": " This is not an instance as it forms a diamond with `pi.has_smul`.\n\nSee the `instance_diamonds` test for details.", "p": "mathlib"}, {"name": "transcendental", "description": "An element of an R-algebra is transcendental over R if it is not algebraic over R.", "p": "mathlib"}, {"name": "subalgebra.inv_mem_of_root_of_coeff_zero_ne_zero", "description": "", "p": "mathlib"}, {"name": "is_algebraic_of_larger_base_of_injective", "description": "If x is algebraic over R, then x is algebraic over S when S is an extension of R,\n and the map from `R` to `S` is injective.", "p": "mathlib"}, {"name": "algebra.is_algebraic_iff_is_integral", "description": "", "p": "mathlib"}, {"name": "alg_equiv_equiv_alg_hom", "description": "Bijection between algebra equivalences and algebra homomorphisms", "p": "mathlib"}, {"name": "is_integral_closure.exists_smul_eq_mul", "description": " A fraction `(a : S) / (b : S)` can be reduced to `(c : S) / (d : R)`,\nif `S` is the integral closure of `R` in an algebraic extension `L` of `R`.", "p": "mathlib"}, {"name": "is_algebraic_rat", "description": "", "p": "mathlib"}, {"name": "is_algebraic_zero", "description": "", "p": "mathlib"}, {"name": "algebra.is_algebraic.alg_equiv_equiv_alg_hom", "description": "Bijection between algebra equivalences and algebra homomorphisms", "p": "mathlib"}, {"name": "is_transcendental_of_subsingleton", "description": "", "p": "mathlib"}, {"name": "is_algebraic_iff_is_integral", "description": "An element of an algebra over a field is algebraic if and only if it is integral.", "p": "mathlib"}, {"name": "is_algebraic_algebra_map_of_is_algebraic", "description": "", "p": "mathlib"}, {"name": "is_algebraic_alg_hom_of_is_algebraic", "description": "This is slightly more general than `is_algebraic_algebra_map_of_is_algebraic` in that it\n allows noncommutative intermediate rings `A`.", "p": "mathlib"}, {"name": "polynomial.algebra_pi", "description": "This is not an instance for the same reasons as `polynomial.has_smul_pi'`.", "p": "mathlib"}, {"name": "polynomial.has_smul_pi", "description": " This is not an instance as it forms a diamond with `pi.has_smul`.\n\nSee the `instance_diamonds` test for details.", "p": "mathlib"}, {"name": "exists_integral_multiple", "description": "", "p": "mathlib"}, {"name": "double_centralizer.ext_iff", "description": "", "p": "mathlib"}, {"name": "double_centralizer.nnnorm_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.star_add_monoid", "description": "", "p": "mathlib"}, {"name": "double_centralizer.to_prod_hom", "description": "The canonical map `double_centralizer.to_prod` as an additive group homomorphism.", "p": "mathlib"}, {"name": "double_centralizer.is_central_scalar", "description": "", "p": "mathlib"}, {"name": "double_centralizer.smul_comm_class", "description": "", "p": "mathlib"}, {"name": "double_centralizer.coe_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.nnnorm_fst_eq_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.star_ring", "description": "", "p": "mathlib"}, {"name": "double_centralizer.nnnorm_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.smul_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.sub_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.sub_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_one", "description": "", "p": "mathlib"}, {"name": "double_centralizer.complete_space", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_star", "description": " The star operation on `a : \ud835\udcdc(\ud835\udd5c, A)` is given by\n`(star a).to_prod = (star \u2218 a.snd \u2218 star, star \u2218 a.fst \u2218 star)`.", "p": "mathlib"}, {"name": "double_centralizer.range_to_prod_mul_opposite", "description": "", "p": "mathlib"}, {"name": "double_centralizer.norm_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.star_module", "description": "", "p": "mathlib"}, {"name": "double_centralizer.coe_hom", "description": " The coercion of an algebra into its multiplier algebra as a non-unital star algebra\nhomomorphism.", "p": "mathlib"}, {"name": "double_centralizer.smul_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.algebra_map_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.mul_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "double_centralizer.coe_hom_apply", "description": "", "p": "mathlib"}, {"name": "double_centralizer.int_cast_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.mul_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.nat_cast_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.algebra_map_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.star_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.normed_space", "description": "", "p": "mathlib"}, {"name": "double_centralizer.to_prod_mul_opposite_hom", "description": "The canonical map `double_centralizer.to_prod_mul_opposite` as a ring homomorphism.", "p": "mathlib"}, {"name": "double_centralizer.norm_def", "description": "", "p": "mathlib"}, {"name": "double_centralizer.add_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.ext", "description": "", "p": "mathlib"}, {"name": "double_centralizer.nnnorm_def'", "description": "", "p": "mathlib"}, {"name": "double_centralizer.to_prod_mul_opposite_hom_apply", "description": "", "p": "mathlib"}, {"name": "double_centralizer.pow_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_mul", "description": "", "p": "mathlib"}, {"name": "double_centralizer.pow_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.zero_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_int_cast", "description": "", "p": "mathlib"}, {"name": "double_centralizer.neg_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.inhabited", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_add", "description": "", "p": "mathlib"}, {"name": "double_centralizer.sub_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.to_prod_mul_opposite", "description": " The natural injection from `double_centralizer.to_prod` except the second coordinate inherits\n`mul_opposite.op`. The ring structure on `\ud835\udcdc(\ud835\udd5c, A)` is the pullback under this map.", "p": "mathlib"}, {"name": "double_centralizer.algebra", "description": "", "p": "mathlib"}, {"name": "double_centralizer.add_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.zero_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.neg_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.one_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.smul_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.coe_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.nat.has_pow", "description": "", "p": "mathlib"}, {"name": "double_centralizer.add_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_smul", "description": "", "p": "mathlib"}, {"name": "double_centralizer.norm_fst_eq_snd", "description": " For `a : \ud835\udcdc(\ud835\udd5c, A)`, the norms of `a.fst` and `a.snd` coincide, and hence these\nalso coincide with `\u2016a\u2016` which is `max (\u2016a.fst\u2016) (\u2016a.snd\u2016)`.", "p": "mathlib"}, {"name": "double_centralizer.normed_ring", "description": " The normed group structure is inherited as the pullback under the ring monomoprhism\n`double_centralizer.to_prod_mul_opposite_hom : \ud835\udcdc(\ud835\udd5c, A) \u2192+* (A \u2192L[\ud835\udd5c] A) \u00d7 (A \u2192L[\ud835\udd5c] A)\u1d50\u1d52\u1d56`.", "p": "mathlib"}, {"name": "double_centralizer.neg_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.int_cast_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.to_prod_hom_apply", "description": "", "p": "mathlib"}, {"name": "double_centralizer.range_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.norm_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.int_cast_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.pow_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_nat_cast", "description": "", "p": "mathlib"}, {"name": "double_centralizer.module", "description": " The module structure is inherited as the pullback under the additive group monomorphism\n`double_centralizer.to_prod : \ud835\udcdc(\ud835\udd5c, A) \u2192+ (A \u2192L[\ud835\udd5c] A) \u00d7 (A \u2192L[\ud835\udd5c] A)`", "p": "mathlib"}, {"name": "double_centralizer.one_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_neg", "description": "", "p": "mathlib"}, {"name": "double_centralizer", "description": " The type of *double centralizers*, also known as the *multiplier algebra* and denoted by\n`\ud835\udcdc(\ud835\udd5c, A)`, of a non-unital normed algebra.\n\nIf `x : \ud835\udcdc(\ud835\udd5c, A)`, then `x.fst` and `x.snd` are what is usually referred to as $L$ and $R$.", "p": "mathlib"}, {"name": "double_centralizer.to_prod", "description": " The type of *double centralizers*, also known as the *multiplier algebra* and denoted by\n`\ud835\udcdc(\ud835\udd5c, A)`, of a non-unital normed algebra.\n\nIf `x : \ud835\udcdc(\ud835\udd5c, A)`, then `x.fst` and `x.snd` are what is usually referred to as $L$ and $R$.", "p": "mathlib"}, {"name": "double_centralizer.central", "description": " The type of *double centralizers*, also known as the *multiplier algebra* and denoted by\n`\ud835\udcdc(\ud835\udd5c, A)`, of a non-unital normed algebra.\n\nIf `x : \ud835\udcdc(\ud835\udd5c, A)`, then `x.fst` and `x.snd` are what is usually referred to as $L$ and $R$.", "p": "mathlib"}, {"name": "double_centralizer.ring", "description": " The ring structure is inherited as the pullback under the injective map\n`double_centralizer.to_prod_mul_opposite : \ud835\udcdc(\ud835\udd5c, A) \u2192 (A \u2192L[\ud835\udd5c] A) \u00d7 (A \u2192L[\ud835\udd5c] A)\u1d50\u1d52\u1d56`", "p": "mathlib"}, {"name": "double_centralizer.algebra_map_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.zero_fst", "description": "", "p": "mathlib"}, {"name": "double_centralizer.normed_algebra", "description": "", "p": "mathlib"}, {"name": "double_centralizer.to_prod_mul_opposite_injective", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_coe_t", "description": " The natural coercion of `A` into `\ud835\udcdc(\ud835\udd5c, A)` given by sending `a : A` to the pair of linear\nmaps `L\u2090 R\u2090 : A \u2192L[\ud835\udd5c] A` given by left- and right-multiplication by `a`, respectively.\n\nWarning: if `A = \ud835\udd5c`, then this is a coercion which is not definitionally equal to the\n`algebra_map \ud835\udd5c \ud835\udcdc(\ud835\udd5c, \ud835\udd5c)` coercion, but these are propositionally equal. See\n`double_centralizer.coe_eq_algebra_map` below.", "p": "mathlib"}, {"name": "double_centralizer.nat_cast_to_prod", "description": "", "p": "mathlib"}, {"name": "double_centralizer.nnnorm_def", "description": "", "p": "mathlib"}, {"name": "double_centralizer.coe_eq_algebra_map", "description": "", "p": "mathlib"}, {"name": "double_centralizer.norm_def'", "description": "", "p": "mathlib"}, {"name": "double_centralizer.uniform_embedding_to_prod_mul_opposite", "description": "", "p": "mathlib"}, {"name": "double_centralizer.star_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_zero", "description": "", "p": "mathlib"}, {"name": "double_centralizer.has_sub", "description": "", "p": "mathlib"}, {"name": "double_centralizer.cstar_ring", "description": "", "p": "mathlib"}, {"name": "double_centralizer.nat_cast_snd", "description": "", "p": "mathlib"}, {"name": "double_centralizer.one_fst", "description": "", "p": "mathlib"}, {"name": "finsupp.lift_add_hom_symm_apply_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_sum_index", "description": "", "p": "mathlib"}, {"name": "mul_equiv.map_finsupp_prod", "description": "Deprecated, use `_root_.map_finsupp_prod` instead.", "p": "mathlib"}, {"name": "add_submonoid_class.finsupp_sum_mem", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_hom_add_index", "description": "", "p": "mathlib"}, {"name": "finsupp.multiset_sum_sum_index", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_zero_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_ite_self_eq", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_of_support_subset", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_emb_domain", "description": "", "p": "mathlib"}, {"name": "finsupp.prod", "description": "`prod f g` is the product of `g a (f a)` over the support of `f`.", "p": "mathlib"}, {"name": "add_monoid_hom.coe_finsupp_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_neg_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_neg_index", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_fintype", "description": "", "p": "mathlib"}, {"name": "finsupp.lift_add_hom_apply_single", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_congr", "description": "", "p": "mathlib"}, {"name": "map_finsupp_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.coe_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.mul_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_inv", "description": "", "p": "mathlib"}, {"name": "finsupp.mul_prod_erase", "description": " Taking a product over `f : \u03b1 \u2192\u2080 M` is the same as multiplying the value on a single element\n`y \u2208 f.support` by the product over `erase y f`.", "p": "mathlib"}, {"name": "finsupp.sum_fintype", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_hom_add_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_univ_single", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_sub_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_add_index'", "description": "Taking the sum under `h` is an additive homomorphism of finsupps,\nif `h` is an additive homomorphism.\nThis is a more specific version of `finsupp.sum_add_index` with simpler hypotheses.", "p": "mathlib"}, {"name": "finsupp.prod_emb_domain", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_comm", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_ite_eq", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_apply'", "description": "", "p": "mathlib"}, {"name": "finsupp.coe_finset_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_indicator_index", "description": "", "p": "mathlib"}, {"name": "finsupp.lift_add_hom_comp_single", "description": "", "p": "mathlib"}, {"name": "finsupp.on_finset_prod", "description": " If `g` maps a second argument of 0 to 1, then multiplying it over the\nresult of `on_finset` is the same as multiplying it over the original\n`finset`.", "p": "mathlib"}, {"name": "finsupp.lift_add_hom_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.support_sum", "description": "", "p": "mathlib"}, {"name": "monoid_hom.coe_finsupp_prod", "description": "", "p": "mathlib"}, {"name": "ring_hom.map_finsupp_prod", "description": "Deprecated, use `_root_.map_finsupp_prod` instead.", "p": "mathlib"}, {"name": "finsupp.sum_add_index_of_disjoint", "description": "For disjoint `f1` and `f2`, and function `g`, the sum of the sums of `g`\nover `f1` and `f2` equals the sum of `g` over `f1 + f2`", "p": "mathlib"}, {"name": "submonoid_class.finsupp_prod_mem", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_single", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_map_range_index", "description": "", "p": "mathlib"}, {"name": "finsupp.lift_add_hom_symm_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_sum_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_add_index", "description": "Taking the product under `h` is an additive homomorphism of finsupps,\nif `h` is an additive homomorphism on the support.\nThis is a more general version of `finsupp.sum_add_index'`; the latter has simpler hypotheses.", "p": "mathlib"}, {"name": "map_finsupp_prod", "description": "", "p": "mathlib"}, {"name": "monoid_hom.finsupp_prod_apply", "description": "", "p": "mathlib"}, {"name": "ring_hom.map_finsupp_sum", "description": "Deprecated, use `_root_.map_finsupp_sum` instead.", "p": "mathlib"}, {"name": "finsupp.prod_map_range_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_indicator_index", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_finset_sum_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_add_index", "description": " Taking the product under `h` is an additive-to-multiplicative homomorphism of finsupps,\nif `h` is an additive-to-multiplicative homomorphism on the support.\nThis is a more general version of `finsupp.prod_add_index'`; the latter has simpler hypotheses.", "p": "mathlib"}, {"name": "finsupp.prod_dvd_prod_of_subset_of_dvd", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_ite_eq'", "description": "A restatement of `prod_ite_eq` with the equality test reversed.", "p": "mathlib"}, {"name": "finsupp.indicator_eq_sum_single", "description": "", "p": "mathlib"}, {"name": "finsupp.single_multiset_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.add_sum_erase", "description": " Taking a sum over over `f : \u03b1 \u2192\u2080 M` is the same as adding the value on a\nsingle element `y \u2208 f.support` to the sum over `erase y f`.", "p": "mathlib"}, {"name": "finsupp.sum_neg", "description": "", "p": "mathlib"}, {"name": "finsupp.comp_lift_add_hom", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_single_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_finset_sum_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_add", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_ite_self_eq'", "description": "", "p": "mathlib"}, {"name": "finsupp.single_finset_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_sum_index'", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_mul", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_add_index_of_disjoint", "description": " For disjoint `f1` and `f2`, and function `g`, the product of the products of `g`\nover `f1` and `f2` equals the product of `g` over `f1 + f2`", "p": "mathlib"}, {"name": "finsupp.lift_add_hom", "description": " The canonical isomorphism between families of additive monoid homomorphisms `\u03b1 \u2192 (M \u2192+ N)`\nand monoid homomorphisms `(\u03b1 \u2192\u2080 M) \u2192+ N`.", "p": "mathlib"}, {"name": "finsupp.mul_prod_erase'", "description": " Generalization of `finsupp.mul_prod_erase`: if `g` maps a second argument of 0 to 1,\nthen its product over `f : \u03b1 \u2192\u2080 M` is the same as multiplying the value on any element\n`y : \u03b1` by the product over `erase y f`.", "p": "mathlib"}, {"name": "finsupp.sum_ite_eq", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_comm", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_add_index'", "description": " Taking the product under `h` is an additive-to-multiplicative homomorphism of finsupps,\nif `h` is an additive-to-multiplicative homomorphism.\nThis is a more specialized version of `finsupp.prod_add_index` with simpler hypotheses.", "p": "mathlib"}, {"name": "finsupp.support_finset_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_zero_index", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_congr", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_sub", "description": "", "p": "mathlib"}, {"name": "finsupp.multiset_map_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.prod_pow", "description": "", "p": "mathlib"}, {"name": "finsupp.single_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_zero", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.finsupp_sum_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_mul", "description": "", "p": "mathlib"}, {"name": "finsupp.finset_sum_apply", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_univ_single'", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_of_support_subset", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_finsupp_sum", "description": "Deprecated, use `_root_.map_finsupp_sum` instead.", "p": "mathlib"}, {"name": "finsupp.add_sum_erase'", "description": " Generalization of `finsupp.add_sum_erase`: if `g` maps a second argument of 0\nto 0, then its sum over `f : \u03b1 \u2192\u2080 M` is the same as adding the value on any element\n`y : \u03b1` to the sum over `erase y f`.", "p": "mathlib"}, {"name": "finsupp.sum", "description": "`sum f g` is the sum of `g a (f a)` over the support of `f`.", "p": "mathlib"}, {"name": "nat.prod_pow_pos_of_zero_not_mem_support", "description": "If `0 : \u2115` is not in the support of `f : \u2115 \u2192\u2080 \u2115` then `0 < \u220f x in f.support, x ^ (f x)`.", "p": "mathlib"}, {"name": "monoid_hom.map_finsupp_prod", "description": "Deprecated, use `_root_.map_finsupp_prod` instead.", "p": "mathlib"}, {"name": "finsupp.multiset_sum_sum", "description": "", "p": "mathlib"}, {"name": "finsupp.sum_single_index", "description": "", "p": "mathlib"}, {"name": "finset.sum_apply'", "description": "", "p": "mathlib"}, {"name": "add_equiv.map_finsupp_sum", "description": "Deprecated, use `_root_.map_finsupp_sum` instead.", "p": "mathlib"}, {"name": "finsupp.sum_ite_eq'", "description": "A restatement of `sum_ite_eq` with the equality test reversed.", "p": "mathlib"}, {"name": "finsupp.lift_add_hom_single_add_hom", "description": "", "p": "mathlib"}, {"name": "finsupp.on_finset_sum", "description": "If `g` maps a second argument of 0 to 0, summing it over the\nresult of `on_finset` is the same as summing it over the original\n`finset`.", "p": "mathlib"}, {"name": "finsupp.support_sum_eq_bUnion", "description": "", "p": "mathlib"}, {"name": "basis.ext_multilinear_fin", "description": " Two multilinear maps indexed by `fin n` are equal if they are equal when all arguments are\nbasis vectors.", "p": "mathlib"}, {"name": "basis.ext_multilinear", "description": " Two multilinear maps indexed by a `fintype` are equal if they are equal when all arguments\nare basis vectors. Unlike `basis.ext_multilinear_fin`, this only uses a single basis; a\ndependently-typed version would still be true, but the proof would need a dependently-typed\nversion of `dom_dom_congr`.", "p": "mathlib"}, {"name": "complex.Gamma_of_real", "description": "", "p": "mathlib"}, {"name": "real.Gamma_one", "description": "", "p": "mathlib"}, {"name": "complex.differentiable_at_Gamma_aux", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_eq_Gamma_aux", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_neg_nat_eq_zero", "description": "At `-n` for `n \u2208 \u2115`, the Gamma function is undefined; by convention we assign it the value 0.", "p": "mathlib"}, {"name": "real.Gamma_zero", "description": "At `0` the Gamma function is undefined; by convention we assign it the value `0`.", "p": "mathlib"}, {"name": "complex.Gamma_aux_recurrence1", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_nat_eq_factorial", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_eq_integral", "description": "", "p": "mathlib"}, {"name": "real.Gamma_add_one", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_zero", "description": "At `0` the Gamma function is undefined; by convention we assign it the value `0`.", "p": "mathlib"}, {"name": "complex.Gamma_integral", "description": " Euler's integral for the `\u0393` function (of a complex variable `s`), defined as\n`\u222b x in Ioi 0, exp (-x) * x ^ (s - 1)`.\n\nSee `complex.Gamma_integral_convergent` for a proof of the convergence of the integral for\n`0 < re s`.", "p": "mathlib"}, {"name": "complex.tendsto_partial_Gamma", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_integral_of_real", "description": "", "p": "mathlib"}, {"name": "real.Gamma_integral_convergent", "description": "The Euler integral for the `\u0393` function converges for positive real `s`.", "p": "mathlib"}, {"name": "complex.Gamma_integral_one", "description": "", "p": "mathlib"}, {"name": "real.Gamma", "description": "The `\u0393` function (of a real variable `s`).", "p": "mathlib"}, {"name": "complex.partial_Gamma_add_one", "description": "The recurrence relation for the indefinite version of the `\u0393` function.", "p": "mathlib"}, {"name": "complex.tendsto_self_mul_Gamma_nhds_zero", "description": "At `s = 0`, the Gamma function has a simple pole with residue 1.", "p": "mathlib"}, {"name": "real.Gamma_neg_nat_eq_zero", "description": "At `-n` for `n \u2208 \u2115`, the Gamma function is undefined; by convention we assign it the value `0`.", "p": "mathlib"}, {"name": "real.Gamma_nat_eq_factorial", "description": "", "p": "mathlib"}, {"name": "real.differentiable_at_Gamma", "description": "", "p": "mathlib"}, {"name": "real.Gamma_integrand_is_o", "description": "Asymptotic bound for the `\u0393` function integrand.", "p": "mathlib"}, {"name": "real.Gamma_pos_of_pos", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_integral_convergent", "description": " The integral defining the `\u0393` function converges for complex `s` with `0 < re s`.\n\nThis is proved by reduction to the real case.", "p": "mathlib"}, {"name": "complex.Gamma_aux_recurrence2", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_one", "description": "", "p": "mathlib"}, {"name": "real.Gamma_ne_zero", "description": " The Gamma function does not vanish on `\u211d` (except at non-positive integers, where the function\nis mathematically undefined and we set it to `0` by convention).", "p": "mathlib"}, {"name": "complex.Gamma_integral_add_one", "description": "The recurrence relation for the `\u0393` integral.", "p": "mathlib"}, {"name": "real.Gamma_eq_integral", "description": "", "p": "mathlib"}, {"name": "complex.has_deriv_at_Gamma_integral", "description": " The derivative of the `\u0393` integral, at any `s \u2208 \u2102` with `1 < re s`, is given by the Melllin\ntransform of `log t * exp (-t)`.", "p": "mathlib"}, {"name": "complex.Gamma_integral_conj", "description": "", "p": "mathlib"}, {"name": "complex.Gamma_add_one", "description": "The recurrence relation for the `\u0393` function.", "p": "mathlib"}, {"name": "complex.differentiable_at_Gamma", "description": "", "p": "mathlib"}, {"name": "complex.partial_Gamma", "description": "The indefinite version of the `\u0393` function, `\u0393(s, X) = \u222b x \u2208 0..X, exp(-x) x ^ (s - 1)`.", "p": "mathlib"}, {"name": "complex.Gamma_conj", "description": "", "p": "mathlib"}, {"name": "real.Gamma_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "complex.Gamma", "description": "The `\u0393` function (of a complex variable `s`).", "p": "mathlib"}, {"name": "complex.Gamma_integral_eq_mellin", "description": "Rewrite the Gamma integral as an example of a Mellin transform.", "p": "mathlib"}, {"name": "complex.Gamma_aux", "description": "The `n`th function in this family is `\u0393(s)` if `-n < s.re`, and junk otherwise.", "p": "mathlib"}, {"name": "algebraic_geometry.SheafedSpace.glue_data.V_pullback_cone_is_limit", "description": " The following diagram is a pullback, i.e. `V\u1d62\u2c7c` is the intersection of `U\u1d62` and `U\u2c7c` in `X`.\n\nV\u1d62\u2c7c \u27f6 U\u1d62\n |      |\n \u2193      \u2193\n U\u2c7c \u27f6 X", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03c0_\u03b9_inv_app_eq_id", "description": "`\u03b9_inv_app` is the inverse of `D.\u03b9 i` on `U`.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.opens_image_preimage_map", "description": "(Implementation). The map `\u0393(\ud835\udcaa_{U_i}, U) \u27f6 \u0393(\ud835\udcaa_{U_j}, \ud835\udda3.\u03b9 j \u207b\u00b9' (\ud835\udda3.\u03b9 i '' U))`", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data.V_pullback_cone_is_limit", "description": " The following diagram is a pullback, i.e. `V\u1d62\u2c7c` is the intersection of `U\u1d62` and `U\u2c7c` in `X`.\n\nV\u1d62\u2c7c \u27f6 U\u1d62\n |      |\n \u2193      \u2193\n U\u2c7c \u27f6 X", "p": "mathlib"}, {"name": "algebraic_geometry.SheafedSpace.glue_data", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A sheafed space `U i` for each `i : J`.\n3. A sheafed space `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 SheafedSpace C` rather than `J \u2192 J \u2192 SheafedSpace C` to\n  connect to the limits library easier.)\n4. An open immersion `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.", "p": "mathlib"}, {"name": "algebraic_geometry.SheafedSpace.glue_data.to_glue_data", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A sheafed space `U i` for each `i : J`.\n3. A sheafed space `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 SheafedSpace C` rather than `J \u2192 J \u2192 SheafedSpace C` to\n  connect to the limits library easier.)\n4. An open immersion `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.", "p": "mathlib"}, {"name": "algebraic_geometry.SheafedSpace.glue_data.f_open", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A sheafed space `U i` for each `i : J`.\n3. A sheafed space `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 SheafedSpace C` rather than `J \u2192 J \u2192 SheafedSpace C` to\n  connect to the limits library easier.)\n4. An open immersion `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.", "p": "mathlib"}, {"name": "algebraic_geometry.SheafedSpace.glue_data.\u03b9_is_open_immersion", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.diagram_over_open", "description": " (Implementation) Given an open subset of one of the spaces `U \u2286 U\u1d62`, the sheaf component of\nthe image `\u03b9 '' U` in the glued space is the limit of this diagram.", "p": "mathlib"}, {"name": "algebraic_geometry.SheafedSpace.glue_data.\u03b9_jointly_surjective", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data.\u03b9_is_open_immersion", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.opens_image_preimage_map_app'", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03b9_is_open_immersion", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03b9_inv_app_\u03c0_eq_map", "description": "The `eq_to_hom` given by `\u03b9_inv_app_\u03c0`.", "p": "mathlib"}, {"name": "algebraic_geometry.SheafedSpace.glue_data.\u03b9_iso_PresheafedSpace_inv", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.SheafedSpace.glue_data.to_PresheafedSpace_glue_data", "description": "The glue data of presheafed spaces associated to a family of glue data of sheafed spaces.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03b9_inv_app_\u03c0_app", "description": " (Implementation) We construct the map `\u0393(\ud835\udcaa_{U_i}, U) \u27f6 \u0393(\ud835\udcaa_V, U_V)` for each `V` in the gluing\ndiagram. We will lift these maps into `\u03b9_inv_app`.", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data.\u03b9_iso_SheafedSpace_inv", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data.\u03b9_jointly_surjective", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data.to_SheafedSpace_glue_data", "description": "The glue data of ringed spaces associated to a family of glue data of locally ringed spaces.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.diagram_over_open_\u03c0", "description": " (Implementation)\nThe projection from the limit of `diagram_over_open` to a component of `D.U j`.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03c0_\u03b9_inv_app_\u03c0", "description": "`\u03b9_inv_app` is the right inverse of `D.\u03b9 i` on `U`.", "p": "mathlib"}, {"name": "algebraic_geometry.SheafedSpace.glue_data.iso_PresheafedSpace", "description": "The gluing as sheafed spaces is isomorphic to the gluing as presheafed spaces.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.opens_image_preimage_map_app", "description": "The red and the blue arrows in ![this diagram](https://i.imgur.com/mBzV1Rx.png) commute.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.to_Top_glue_data", "description": "The glue data of topological spaces associated to a family of glue data of PresheafedSpaces.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03b9_image_preimage_eq", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03b9_inv_app", "description": " (Implementation) The natural map `\u0393(\ud835\udcaa_{U_i}, U) \u27f6 \u0393(\ud835\udcaa_X, \ud835\udda3.\u03b9 i '' U)`.\nThis forms the inverse of `(\ud835\udda3.\u03b9 i).c.app (op U)`.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03b9_jointly_surjective", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03b9_inv_app_\u03c0", "description": "`\u03b9_inv_app` is the left inverse of `D.\u03b9 i` on `U`.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.componentwise_diagram_\u03c0_is_iso", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.snd_inv_app_t_app_assoc", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data.algebraic_geometry.LocallyRingedSpace.forget_to_SheafedSpace.category_theory.limits.preserves_limit", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.\u03b9_open_embedding", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.snd_inv_app_t_app'", "description": "We can prove the `eq` along with the lemma. Thus this is bundled together here, and the\nlemma itself is separated below.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.snd_inv_app_t_app", "description": "The red and the blue arrows in ![this diagram](https://i.imgur.com/q6X1GJ9.png) commute.", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A locally ringed space `U i` for each `i : J`.\n3. A locally ringed space `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 LocallyRingedSpace` rather than `J \u2192 J \u2192 LocallyRingedSpace` to\n  connect to the limits library easier.)\n4. An open immersion `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data.to_glue_data", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A locally ringed space `U i` for each `i : J`.\n3. A locally ringed space `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 LocallyRingedSpace` rather than `J \u2192 J \u2192 LocallyRingedSpace` to\n  connect to the limits library easier.)\n4. An open immersion `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data.f_open", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A locally ringed space `U i` for each `i : J`.\n3. A locally ringed space `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 LocallyRingedSpace` rather than `J \u2192 J \u2192 LocallyRingedSpace` to\n  connect to the limits library easier.)\n4. An open immersion `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.f_inv_app_f_app", "description": "The red and the blue arrows in ![this diagram](https://i.imgur.com/0GiBUh6.png) commute.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A presheafed space `U i` for each `i : J`.\n3. A presheafed space `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 PresheafedSpace C` rather than `J \u2192 J \u2192 PresheafedSpace C` to\n  connect to the limits library easier.)\n4. An open immersion `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.to_glue_data", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A presheafed space `U i` for each `i : J`.\n3. A presheafed space `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 PresheafedSpace C` rather than `J \u2192 J \u2192 PresheafedSpace C` to\n  connect to the limits library easier.)\n4. An open immersion `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.f_open", "description": "A family of gluing data consists of\n1. An index type `J`\n2. A presheafed space `U i` for each `i : J`.\n3. A presheafed space `V i j` for each `i j : J`.\n  (Note that this is `J \u00d7 J \u2192 PresheafedSpace C` rather than `J \u2192 J \u2192 PresheafedSpace C` to\n  connect to the limits library easier.)\n4. An open immersion `f i j : V i j \u27f6 U i` for each `i j : \u03b9`.\n5. A transition map `t i j : V i j \u27f6 V j i` for each `i j : \u03b9`.\nsuch that\n6. `f i i` is an isomorphism.\n7. `t i i` is the identity.\n8. `V i j \u00d7[U i] V i k \u27f6 V i j \u27f6 V j i` factors through `V j k \u00d7[U j] V j i \u27f6 V j i` via some\n    `t' : V i j \u00d7[U i] V i k \u27f6 V j k \u00d7[U j] V j i`.\n9. `t' i j k \u226b t' j k i \u226b t' k i j = \ud835\udfd9 _`.\n\nWe can then glue the spaces `U i` together by identifying `V i j` with `V j i`, such\nthat the `U i`'s are open subspaces of the glued space.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.f_inv_app_f_app_assoc", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.V_pullback_cone_is_limit", "description": " The following diagram is a pullback, i.e. `V\u1d62\u2c7c` is the intersection of `U\u1d62` and `U\u2c7c` in `X`.\n\nV\u1d62\u2c7c \u27f6 U\u1d62\n |      |\n \u2193      \u2193\n U\u2c7c \u27f6 X", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.opens_image_preimage_map_app_assoc", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.LocallyRingedSpace.glue_data.iso_SheafedSpace", "description": "The gluing as locally ringed spaces is isomorphic to the gluing as ringed spaces.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.glue_data.pullback_base", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.not_mem_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.exists_Model_is_realized_in", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.subset", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.set_of_mem_eq_univ_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.set_of_subset_eq_univ_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.is_maximal", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.set_of_subset_eq_empty_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.Inter_set_of_subset", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.nonempty", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.nonempty_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type", "description": "A complete type over a given theory in a certain type of variables is a maximally\n consistent (with the theory) set of formulas in that type.", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.to_Theory", "description": "A complete type over a given theory in a certain type of variables is a maximally\n consistent (with the theory) set of formulas in that type.", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.subset'", "description": "A complete type over a given theory in a certain type of variables is a maximally\n consistent (with the theory) set of formulas in that type.", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.is_maximal'", "description": "A complete type over a given theory in a certain type of variables is a maximally\n consistent (with the theory) set of formulas in that type.", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.mem_or_not_mem", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.mem_type_of", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.compl_set_of_mem", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.type_of", "description": "The set of all formulas true at a tuple in a structure forms a complete type.", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.to_list_foldr_inf_mem", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.mem_of_models", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.formula_mem_type_of", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.complete_type.sentence.set_like", "description": "", "p": "mathlib"}, {"name": "first_order.language.Theory.realized_types", "description": "A complete type `p` is realized in a particular structure when there is some\n tuple `v` whose type is `p`.", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value_Ioo", "description": "", "p": "mathlib"}, {"name": "is_connected_Ioo", "description": "", "p": "mathlib"}, {"name": "continuous_on.surj_on_of_tendsto", "description": " If a function `f : \u03b1 \u2192 \u03b2` is continuous on a nonempty interval `s`, its restriction to `s`\ntends to `at_bot : filter \u03b2` along `at_bot : filter \u21a5s` and tends to `at_top : filter \u03b2` along\n`at_top : filter \u21a5s`, then the restriction of `f` to `s` is surjective. We formulate the\nconclusion as `surj_on f s univ`.", "p": "mathlib"}, {"name": "is_preconnected_Ioc", "description": "", "p": "mathlib"}, {"name": "is_closed.Icc_subset_of_forall_mem_nhds_within", "description": " A \"continuous induction principle\" for a closed interval: if a set `s` meets `[a, b]`\non a closed subset, contains `a`, and for any `x \u2208 s \u2229 [a, b)` the set `s` includes some open\nneighborhood of `x` within `(x, +\u221e)`, then `[a, b] \u2286 s`.", "p": "mathlib"}, {"name": "is_connected.Ioo_cInf_cSup_subset", "description": " A bounded connected subset of a conditionally complete linear order includes the open interval\n`(Inf s, Sup s)`.", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value_Ioi", "description": "", "p": "mathlib"}, {"name": "continuous_on.surj_on_Icc", "description": " **Intermediate value theorem**: if `f` is continuous on an order-connected set `s` and `a`,\n`b` are two points of this set, then `f` sends `s` to a superset of `Icc (f x) (f y)`.", "p": "mathlib"}, {"name": "is_preconnected.eq_univ_of_unbounded", "description": " If preconnected set in a linear order space is unbounded below and above, then it is the whole\nspace.", "p": "mathlib"}, {"name": "set_of_is_preconnected_eq_of_ordered", "description": " In a dense conditionally complete linear order, the set of preconnected sets is exactly\nthe set of the intervals `Icc`, `Ico`, `Ioc`, `Ioo`, `Ici`, `Ioi`, `Iic`, `Iio`, `(-\u221e, +\u221e)`,\nor `\u2205`. Though one can represent `\u2205` as `(Inf s, Inf s)`, we include it into the list of\npossible cases to improve readability.", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value_Ici", "description": "", "p": "mathlib"}, {"name": "intermediate_value_Ico'", "description": "", "p": "mathlib"}, {"name": "is_preconnected_iff_ord_connected", "description": "", "p": "mathlib"}, {"name": "is_preconnected_Iic", "description": "", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value_Iii", "description": "", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value_Ico", "description": "", "p": "mathlib"}, {"name": "intermediate_value_univ\u2082", "description": " Intermediate value theorem for two functions: if `f` and `g` are two continuous functions\non a preconnected space and `f a \u2264 g a` and `g b \u2264 f b`, then for some `x` we have `f x = g x`.", "p": "mathlib"}, {"name": "intermediate_value_Ioo", "description": "", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value_Iic", "description": "", "p": "mathlib"}, {"name": "is_preconnected.Ioi_cInf_subset", "description": "", "p": "mathlib"}, {"name": "is_preconnected.ord_connected", "description": "", "p": "mathlib"}, {"name": "is_connected_Iic", "description": "", "p": "mathlib"}, {"name": "is_preconnected_Ico", "description": "", "p": "mathlib"}, {"name": "intermediate_value_univ", "description": "**Intermediate Value Theorem** for continuous functions on connected spaces.", "p": "mathlib"}, {"name": "eq_Icc_cInf_cSup_of_connected_bdd_closed", "description": "", "p": "mathlib"}, {"name": "intermediate_value_uIcc", "description": "**Intermediate Value Theorem** for continuous functions on closed intervals, unordered case.", "p": "mathlib"}, {"name": "is_preconnected_uIcc", "description": "", "p": "mathlib"}, {"name": "ordered_connected_space", "description": "", "p": "mathlib"}, {"name": "continuous.surjective'", "description": "A continuous function which tendsto `at_bot` `at_top` and to `at_top` `at_bot` is surjective.", "p": "mathlib"}, {"name": "is_preconnected_Iio", "description": "", "p": "mathlib"}, {"name": "intermediate_value_Ioo'", "description": "", "p": "mathlib"}, {"name": "is_connected_Ico", "description": "", "p": "mathlib"}, {"name": "intermediate_value_Icc'", "description": " **Intermediate Value Theorem** for continuous functions on closed intervals, case\n`f a \u2265 t \u2265 f b`.", "p": "mathlib"}, {"name": "is_preconnected_Ici", "description": "", "p": "mathlib"}, {"name": "is_preconnected_Ioi", "description": "", "p": "mathlib"}, {"name": "is_preconnected_Icc", "description": "A closed interval in a densely ordered conditionally complete linear order is preconnected.", "p": "mathlib"}, {"name": "is_preconnected_Ioo", "description": "", "p": "mathlib"}, {"name": "is_preconnected.Icc_subset", "description": "If a preconnected set contains endpoints of an interval, then it includes the whole interval.", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value\u2082_eventually\u2082", "description": "", "p": "mathlib"}, {"name": "is_closed.Icc_subset_of_forall_exists_gt", "description": " A \"continuous induction principle\" for a closed interval: if a set `s` meets `[a, b]`\non a closed subset, contains `a`, and for any `a \u2264 x < y \u2264 b`, `x \u2208 s`, the set `s \u2229 (x, y]`\nis not empty, then `[a, b] \u2286 s`.", "p": "mathlib"}, {"name": "is_closed.mem_of_ge_of_forall_exists_gt", "description": " A \"continuous induction principle\" for a closed interval: if a set `s` meets `[a, b]`\non a closed subset, contains `a`, and the set `s \u2229 [a, b)` has no maximal point, then `b \u2208 s`.", "p": "mathlib"}, {"name": "is_connected_Ioi", "description": "", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value\u2082_eventually\u2081", "description": "", "p": "mathlib"}, {"name": "is_preconnected.mem_intervals", "description": " A preconnected set in a conditionally complete linear order is either one of the intervals\n`[Inf s, Sup s]`, `[Inf s, Sup s)`, `(Inf s, Sup s]`, `(Inf s, Sup s)`, `[Inf s, +\u221e)`,\n`(Inf s, +\u221e)`, `(-\u221e, Sup s]`, `(-\u221e, Sup s)`, `(-\u221e, +\u221e)`, or `\u2205`. The converse statement requires\n`\u03b1` to be densely ordererd.", "p": "mathlib"}, {"name": "mem_range_of_exists_le_of_exists_ge", "description": "**Intermediate Value Theorem** for continuous functions on connected spaces.", "p": "mathlib"}, {"name": "intermediate_value_univ\u2082_eventually\u2082", "description": "", "p": "mathlib"}, {"name": "is_connected.Icc_subset", "description": "If a preconnected set contains endpoints of an interval, then it includes the whole interval.", "p": "mathlib"}, {"name": "is_connected_Iio", "description": "", "p": "mathlib"}, {"name": "is_preconnected.Iio_cSup_subset", "description": "", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value\u2082", "description": " Intermediate value theorem for two functions: if `f` and `g` are two functions continuous\non a preconnected set `s` and for some `a b \u2208 s` we have `f a \u2264 g a` and `g b \u2264 f b`,\nthen for some `x \u2208 s` we have `f x = g x`.", "p": "mathlib"}, {"name": "intermediate_value_Ico", "description": "", "p": "mathlib"}, {"name": "continuous_on.surj_on_of_tendsto'", "description": " If a function `f : \u03b1 \u2192 \u03b2` is continuous on a nonempty interval `s`, its restriction to `s`\ntends to `at_top : filter \u03b2` along `at_bot : filter \u21a5s` and tends to `at_bot : filter \u03b2` along\n`at_top : filter \u21a5s`, then the restriction of `f` to `s` is surjective. We formulate the\nconclusion as `surj_on f s univ`.", "p": "mathlib"}, {"name": "is_connected_Ioc", "description": "", "p": "mathlib"}, {"name": "is_preconnected_Icc_aux", "description": "", "p": "mathlib"}, {"name": "set.ord_connected.is_preconnected", "description": "", "p": "mathlib"}, {"name": "continuous.surjective", "description": "A continuous function which tendsto `at_top` `at_top` and to `at_bot` `at_bot` is surjective.", "p": "mathlib"}, {"name": "intermediate_value_Icc", "description": " **Intermediate Value Theorem** for continuous functions on closed intervals, case\n`f a \u2264 t \u2264 f b`.", "p": "mathlib"}, {"name": "set_of_is_preconnected_subset_of_ordered", "description": " A preconnected set is either one of the intervals `Icc`, `Ico`, `Ioc`, `Ioo`, `Ici`, `Ioi`,\n`Iic`, `Iio`, or `univ`, or `\u2205`. The converse statement requires `\u03b1` to be densely ordered. Though\none can represent `\u2205` as `(Inf s, Inf s)`, we include it into the list of possible cases to improve\nreadability.", "p": "mathlib"}, {"name": "continuous_on.surj_on_uIcc", "description": " **Intermediate value theorem**: if `f` is continuous on an order-connected set `s` and `a`,\n`b` are two points of this set, then `f` sends `s` to a superset of `[f x, f y]`.", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value_Iio", "description": "", "p": "mathlib"}, {"name": "is_connected_Ici", "description": "", "p": "mathlib"}, {"name": "intermediate_value_Ioc'", "description": "", "p": "mathlib"}, {"name": "is_connected_Icc", "description": "", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value_Ioc", "description": "", "p": "mathlib"}, {"name": "intermediate_value_univ\u2082_eventually\u2081", "description": "", "p": "mathlib"}, {"name": "is_preconnected.intermediate_value", "description": "**Intermediate Value Theorem** for continuous functions on connected sets.", "p": "mathlib"}, {"name": "intermediate_value_Ioc", "description": "", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.add_eq_right_addition", "description": "", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.left_add", "description": "`f +\u2097 g` is the composite `X \u27f6 Y \u229e Y \u27f6 Y`, where the first map is `(f, g)` and the second map\n   is `(\ud835\udfd9 \ud835\udfd9)`.", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.add_eq_left_addition", "description": "", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.comp_add", "description": "", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.add_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.distrib", "description": "", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.is_unital_left_add", "description": "", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.right_add", "description": "`f +\u1d63 g` is the composite `X \u27f6 X \u229e X \u27f6 Y`, where the first map is `(\ud835\udfd9, \ud835\udfd9)` and the second map\n   is `(f g)`.", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.add_comm_monoid_hom_of_has_binary_biproducts", "description": "In a category with binary biproducts, the morphisms form a commutative monoid.", "p": "mathlib"}, {"name": "category_theory.semiadditive_of_binary_biproducts.is_unital_right_add", "description": "", "p": "mathlib"}, {"name": "buffer.nil", "description": "", "p": "core"}, {"name": "buffer.take", "description": "", "p": "core"}, {"name": "string.to_char_buffer", "description": "", "p": "core"}, {"name": "format.to_buffer", "description": "Convert a format object into a character buffer with the provided\n   formatting options.", "p": "core"}, {"name": "buffer.write", "description": "", "p": "core"}, {"name": "buffer.to_array", "description": "", "p": "core"}, {"name": "buffer.iterate", "description": "", "p": "core"}, {"name": "buffer.foreach", "description": "", "p": "core"}, {"name": "buffer.map", "description": "Map a function over the buffer.", "p": "core"}, {"name": "buffer.mmap", "description": "Monadically map a function over the buffer.", "p": "core"}, {"name": "buffer.read_eq_read'", "description": "", "p": "core"}, {"name": "buffer.pop_back", "description": "", "p": "core"}, {"name": "buffer.drop", "description": "", "p": "core"}, {"name": "buffer.has_to_tactic_format", "description": "", "p": "core"}, {"name": "buffer.lt_aux_2", "description": "", "p": "core"}, {"name": "buffer.reverse", "description": "", "p": "core"}, {"name": "buffer.has_append", "description": "", "p": "core"}, {"name": "buffer.take_right", "description": "", "p": "core"}, {"name": "buffer.write_eq_write'", "description": "", "p": "core"}, {"name": "buffer.append_list", "description": "", "p": "core"}, {"name": "buffer.append", "description": "", "p": "core"}, {"name": "buffer.has_repr", "description": "", "p": "core"}, {"name": "buffer.lt_aux_3", "description": "", "p": "core"}, {"name": "buffer.append_string", "description": "", "p": "core"}, {"name": "buffer.read'", "description": "", "p": "core"}, {"name": "buffer.write'", "description": "", "p": "core"}, {"name": "buffer.has_mem", "description": "", "p": "core"}, {"name": "buffer.rev_iterate", "description": "", "p": "core"}, {"name": "buffer.to_list", "description": "", "p": "core"}, {"name": "buffer.append_array", "description": "", "p": "core"}, {"name": "buffer.read", "description": "", "p": "core"}, {"name": "buffer.has_to_format", "description": "", "p": "core"}, {"name": "mk_buffer", "description": "", "p": "core"}, {"name": "char_buffer", "description": "", "p": "core"}, {"name": "buffer.lt_aux_1", "description": "", "p": "core"}, {"name": "buffer.to_string", "description": "", "p": "core"}, {"name": "buffer.mem", "description": "", "p": "core"}, {"name": "buffer", "description": "", "p": "core"}, {"name": "buffer.size", "description": "", "p": "core"}, {"name": "buffer.foldl", "description": "", "p": "core"}, {"name": "array.to_buffer", "description": "", "p": "core"}, {"name": "buffer.push_back", "description": "", "p": "core"}, {"name": "list.to_buffer", "description": "", "p": "core"}, {"name": "prod.semilattice_inf", "description": "", "p": "mathlib"}, {"name": "monotone.map_inf", "description": "", "p": "mathlib"}, {"name": "inf_eq_min", "description": "", "p": "mathlib"}, {"name": "antitone.map_sup", "description": "", "p": "mathlib"}, {"name": "inf_of_le_rig