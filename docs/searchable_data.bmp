Ioc_disjoint_Ioc", "description": "", "p": "mathlib"}, {"name": "Union_Ici_eq_Ici_infi", "description": "", "p": "mathlib"}, {"name": "set.Ici_disjoint_Iic", "description": "", "p": "mathlib"}, {"name": "set.Iic_disjoint_Ioi", "description": "", "p": "mathlib"}, {"name": "is_glb.bUnion_Ici_eq_Ioi", "description": "", "p": "mathlib"}, {"name": "set.Union_Ico_right", "description": "", "p": "mathlib"}, {"name": "Union_Ici_eq_Ioi_infi", "description": "", "p": "mathlib"}, {"name": "is_lub.Union_Iio_eq", "description": "", "p": "mathlib"}, {"name": "is_glb.Union_Ioi_eq", "description": "", "p": "mathlib"}, {"name": "set.Iic_disjoint_Ioc", "description": "", "p": "mathlib"}, {"name": "set.Union_Icc_left", "description": "", "p": "mathlib"}, {"name": "is_lub.bUnion_Iic_eq_Iio", "description": "", "p": "mathlib"}, {"name": "set.Ico_disjoint_Ico", "description": "", "p": "mathlib"}, {"name": "set.Ioc_disjoint_Ioc_same", "description": "", "p": "mathlib"}, {"name": "set.Union_Ioc_left", "description": "", "p": "mathlib"}, {"name": "set.Union_Ioo_left", "description": "", "p": "mathlib"}, {"name": "set.Union_Ico_left", "description": "", "p": "mathlib"}, {"name": "set.Union_Ioc_right", "description": "", "p": "mathlib"}, {"name": "quadratic_form.isometry.prod", "description": " An isometry between quadratic forms generated by `quadratic_form.prod` can be constructed\nfrom a pair of isometries between the left and right parts.", "p": "mathlib"}, {"name": "quadratic_form.pos_def_prod_iff", "description": "", "p": "mathlib"}, {"name": "quadratic_form.prod_apply", "description": "", "p": "mathlib"}, {"name": "quadratic_form.pi", "description": "Construct a quadratic form on a family of modules from the quadratic form on each module.", "p": "mathlib"}, {"name": "quadratic_form.pos_def_pi_iff", "description": "", "p": "mathlib"}, {"name": "quadratic_form.pos_def.prod", "description": "", "p": "mathlib"}, {"name": "quadratic_form.equivalent.prod", "description": "", "p": "mathlib"}, {"name": "quadratic_form.prod", "description": "Construct a quadratic form on a product of two modules from the quadratic form on each module.", "p": "mathlib"}, {"name": "quadratic_form.pi_apply", "description": "", "p": "mathlib"}, {"name": "quadratic_form.anisotropic_of_pi", "description": "If a family is anisotropic then its components must be. The converse is not true.", "p": "mathlib"}, {"name": "quadratic_form.nonneg_pi_iff", "description": "", "p": "mathlib"}, {"name": "quadratic_form.nonneg_prod_iff", "description": "", "p": "mathlib"}, {"name": "quadratic_form.equivalent.pi", "description": "", "p": "mathlib"}, {"name": "quadratic_form.anisotropic_of_prod", "description": "If a product is anisotropic then its components must be. The converse is not true.", "p": "mathlib"}, {"name": "quadratic_form.isometry.pi_to_linear_equiv", "description": "", "p": "mathlib"}, {"name": "quadratic_form.isometry.prod_to_linear_equiv", "description": "", "p": "mathlib"}, {"name": "quadratic_form.isometry.pi", "description": " An isometry between quadratic forms generated by `quadratic_form.prod` can be constructed\nfrom a pair of isometries between the left and right parts.", "p": "mathlib"}, {"name": "generalized_continued_fraction.continuants_aux_stable_of_terminated", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.convergents'_aux_stable_step_of_terminated", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.convergents'_aux_stable_of_terminated", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.denominators_stable_of_terminated", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.continuants_aux_stable_step_of_terminated", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.numerators_stable_of_terminated", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.convergents'_stable_of_terminated", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.continuants_stable_of_terminated", "description": "", "p": "mathlib"}, {"name": "generalized_continued_fraction.terminated_stable", "description": "If a gcf terminated at position `n`, it also terminated at `m \u2265 n`.", "p": "mathlib"}, {"name": "generalized_continued_fraction.convergents_stable_of_terminated", "description": "", "p": "mathlib"}, {"name": "set.uniform_equicontinuous.uniform_continuous_of_mem", "description": "", "p": "mathlib"}, {"name": "uniform_equicontinuous.closure", "description": " If a set of functions is uniformly equicontinuous, its closure for the product topology is also\nuniformly equicontinuous.", "p": "mathlib"}, {"name": "filter.tendsto.continuous_of_equicontinuous_at", "description": " If `\ud835\udcd5 : \u03b9 \u2192 X \u2192 \u03b1` tends to `f : X \u2192 \u03b1` *pointwise* along some nontrivial filter, and if the\nfamily `\ud835\udcd5` is equicontinuous, then the limit is continuous.", "p": "mathlib"}, {"name": "equicontinuous_iff_range", "description": " A family `\ud835\udcd5 : \u03b9 \u2192 X \u2192 \u03b1` is equicontinuous iff `range \ud835\udcd5` is equicontinuous,\ni.e the family `coe : range F \u2192 X \u2192 \u03b1` is equicontinuous.", "p": "mathlib"}, {"name": "set.equicontinuous.mono", "description": "", "p": "mathlib"}, {"name": "uniform_inducing.equicontinuous_at_iff", "description": " Given `u : \u03b1 \u2192 \u03b2` a uniform inducing map, a family `\ud835\udcd5 : \u03b9 \u2192 X \u2192 \u03b1` is equicontinuous at a point\n`x\u2080 : X` iff the family `\ud835\udcd5'`, obtained by precomposing each function of `\ud835\udcd5` by `u`, is\nequicontinuous at `x\u2080`.", "p": "mathlib"}, {"name": "uniform_equicontinuous_iff_uniform_continuous", "description": " A family `\ud835\udcd5 : \u03b9 \u2192 \u03b2 \u2192 \u03b1` is uniformly equicontinuous iff the function `swap \ud835\udcd5 : \u03b2 \u2192 \u03b9 \u2192 \u03b1` is\nuniformly continuous *when `\u03b9 \u2192 \u03b1` is equipped with the uniform structure of uniform convergence*.\nThis is very useful for developping the equicontinuity API, but it should not be used directly\nfor other purposes.", "p": "mathlib"}, {"name": "equicontinuous_at.closure'", "description": " A version of `equicontinuous_at.closure` applicable to subsets of types which embed continuously\ninto `X \u2192 \u03b1` with the product topology. It turns out we don't need any other condition on the\nembedding than continuity, but in practice this will mostly be applied to `fun_like` types where\nthe coercion is injective.", "p": "mathlib"}, {"name": "equicontinuous_iff_continuous", "description": " A family `\ud835\udcd5 : \u03b9 \u2192 X \u2192 \u03b1` is equicontinuous iff the function `swap \ud835\udcd5 : X \u2192 \u03b9 \u2192 \u03b1` is\ncontinuous *when `\u03b9 \u2192 \u03b1` is equipped with the topology of uniform convergence*. This is\nvery useful for developping the equicontinuity API, but it should not be used directly for other\npurposes.", "p": "mathlib"}, {"name": "uniform_equicontinuous.equicontinuous", "description": "Uniform equicontinuity implies equicontinuity.", "p": "mathlib"}, {"name": "filter.tendsto.uniform_continuous_of_uniform_equicontinuous", "description": " If `\ud835\udcd5 : \u03b9 \u2192 \u03b2 \u2192 \u03b1` tends to `f : \u03b2 \u2192 \u03b1` *pointwise* along some nontrivial filter, and if the\nfamily `\ud835\udcd5` is uniformly equicontinuous, then the limit is uniformly continuous.", "p": "mathlib"}, {"name": "filter.tendsto.continuous_at_of_equicontinuous_at", "description": " If `\ud835\udcd5 : \u03b9 \u2192 X \u2192 \u03b1` tends to `f : X \u2192 \u03b1` *pointwise* along some nontrivial filter, and if the\nfamily `\ud835\udcd5` is equicontinuous at some `x\u2080 : X`, then the limit is continuous at `x\u2080`.", "p": "mathlib"}, {"name": "set.equicontinuous.continuous_of_mem", "description": "", "p": "mathlib"}, {"name": "equicontinuous.comp", "description": "Taking sub-families preserves equicontinuity.", "p": "mathlib"}, {"name": "equicontinuous_at_iff_range", "description": " A family `\ud835\udcd5 : \u03b9 \u2192 X \u2192 \u03b1` is equicontinuous at `x\u2080` iff `range \ud835\udcd5` is equicontinuous at `x\u2080`,\ni.e the family `coe : range F \u2192 X \u2192 \u03b1` is equicontinuous at `x\u2080`.", "p": "mathlib"}, {"name": "set.equicontinuous_at.mono", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.uniform_equicontinuous_iff_right", "description": "", "p": "mathlib"}, {"name": "set.equicontinuous_at.continuous_at_of_mem", "description": "", "p": "mathlib"}, {"name": "equicontinuous.closure'", "description": " A version of `equicontinuous.closure` applicable to subsets of types which embed continuously\ninto `X \u2192 \u03b1` with the product topology. It turns out we don't need any other condition on the\nembedding than continuity, but in practice this will mostly be applied to `fun_like` types where\nthe coercion is injective.", "p": "mathlib"}, {"name": "equicontinuous_at_iff_pair", "description": " Reformulation of equicontinuity at `x\u2080` comparing two variables near `x\u2080` instead of comparing\nonly one with `x\u2080`.", "p": "mathlib"}, {"name": "equicontinuous.closure", "description": " If a set of functions is equicontinuous, its closure for the product topology is also\nequicontinuous.", "p": "mathlib"}, {"name": "set.equicontinuous", "description": " We say that a set `H : set (X \u2192 \u03b1)` of functions is equicontinuous if the family\n`coe : \u21a5H \u2192 (X \u2192 \u03b1)` is equicontinuous.", "p": "mathlib"}, {"name": "equicontinuous_at.closure", "description": " If a set of functions is equicontinuous at some `x\u2080`, its closure for the product topology is\nalso equicontinuous at `x\u2080`.", "p": "mathlib"}, {"name": "uniform_equicontinuous.uniform_continuous", "description": "Each function of a uniformly equicontinuous family is uniformly continuous.", "p": "mathlib"}, {"name": "equicontinuous", "description": " A family `F : \u03b9 \u2192 X \u2192 \u03b1` of functions from a topological space to a uniform space is\n*equicontinuous* on all of `X` if it is equicontinuous at each point of `X`.", "p": "mathlib"}, {"name": "uniform_inducing.equicontinuous_iff", "description": " Given `u : \u03b1 \u2192 \u03b2` a uniform inducing map, a family `\ud835\udcd5 : \u03b9 \u2192 X \u2192 \u03b1` is equicontinuous iff the\nfamily `\ud835\udcd5'`, obtained by precomposing each function of `\ud835\udcd5` by `u`, is equicontinuous.", "p": "mathlib"}, {"name": "set.uniform_equicontinuous.mono", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.equicontinuous_at_iff_left", "description": "", "p": "mathlib"}, {"name": "uniform_equicontinuous", "description": " A family `F : \u03b9 \u2192 \u03b2 \u2192 \u03b1` of functions between uniform spaces is *uniformly equicontinuous* if,\nfor all entourage `U \u2208 \ud835\udce4 \u03b1`, there is an entourage `V \u2208 \ud835\udce4 \u03b2` such that, whenever `x` and `y` are\n`V`-close, we have that, *for all `i : \u03b9`*, `F i x` is `U`-close to `F i x\u2080`.", "p": "mathlib"}, {"name": "filter.has_basis.equicontinuous_at_iff", "description": "", "p": "mathlib"}, {"name": "equicontinuous.continuous", "description": "Each function of an equicontinuous family is continuous.", "p": "mathlib"}, {"name": "uniform_equicontinuous_at_iff_range", "description": " A family `\ud835\udcd5 : \u03b9 \u2192 \u03b2 \u2192 \u03b1` is uniformly equicontinuous iff `range \ud835\udcd5` is uniformly equicontinuous,\ni.e the family `coe : range F \u2192 \u03b2 \u2192 \u03b1` is uniformly equicontinuous.", "p": "mathlib"}, {"name": "uniform_equicontinuous.comp", "description": "Taking sub-families preserves uniform equicontinuity.", "p": "mathlib"}, {"name": "uniform_equicontinuous.closure'", "description": " A version of `uniform_equicontinuous.closure` applicable to subsets of types which embed\ncontinuously into `\u03b2 \u2192 \u03b1` with the product topology. It turns out we don't need any other condition\non the embedding than continuity, but in practice this will mostly be applied to `fun_like` types\nwhere the coercion is injective.", "p": "mathlib"}, {"name": "equicontinuous_at.continuous_at", "description": "Each function of a family equicontinuous at `x\u2080` is continuous at `x\u2080`.", "p": "mathlib"}, {"name": "filter.has_basis.uniform_equicontinuous_iff_left", "description": "", "p": "mathlib"}, {"name": "equicontinuous_at_iff_continuous_at", "description": " A family `\ud835\udcd5 : \u03b9 \u2192 X \u2192 \u03b1` is equicontinuous at `x\u2080` iff the function `swap \ud835\udcd5 : X \u2192 \u03b9 \u2192 \u03b1` is\ncontinuous at `x\u2080` *when `\u03b9 \u2192 \u03b1` is equipped with the topology of uniform convergence*. This is\nvery useful for developping the equicontinuity API, but it should not be used directly for other\npurposes.", "p": "mathlib"}, {"name": "equicontinuous_at", "description": " A family `F : \u03b9 \u2192 X \u2192 \u03b1` of functions from a topological space to a uniform space is\n*equicontinuous at `x\u2080 : X`* if, for all entourage `U \u2208 \ud835\udce4 \u03b1`, there is a neighborhood `V` of `x\u2080`\nsuch that, for all `x \u2208 V` and for all `i : \u03b9`, `F i x` is `U`-close to `F i x\u2080`.", "p": "mathlib"}, {"name": "filter.has_basis.equicontinuous_at_iff_right", "description": "", "p": "mathlib"}, {"name": "uniform_inducing.uniform_equicontinuous_iff", "description": " Given `u : \u03b1 \u2192 \u03b3` a uniform inducing map, a family `\ud835\udcd5 : \u03b9 \u2192 \u03b2 \u2192 \u03b1` is uniformly equicontinuous\niff the family `\ud835\udcd5'`, obtained by precomposing each function of `\ud835\udcd5` by `u`, is uniformly\nequicontinuous.", "p": "mathlib"}, {"name": "equicontinuous_at.comp", "description": "Taking sub-families preserves equicontinuity at a point.", "p": "mathlib"}, {"name": "set.uniform_equicontinuous", "description": " We say that a set `H : set (X \u2192 \u03b1)` of functions is uniformly equicontinuous if the family\n`coe : \u21a5H \u2192 (X \u2192 \u03b1)` is uniformly equicontinuous.", "p": "mathlib"}, {"name": "set.equicontinuous_at", "description": " We say that a set `H : set (X \u2192 \u03b1)` of functions is equicontinuous at a point if the family\n`coe : \u21a5H \u2192 (X \u2192 \u03b1)` is equicontinuous at that point.", "p": "mathlib"}, {"name": "filter.has_basis.uniform_equicontinuous_iff", "description": "", "p": "mathlib"}, {"name": "semifield.to_comm_semiring", "description": "", "p": "mathlib"}, {"name": "division_semiring", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.add", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.add_assoc", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.zero", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.zero_add", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.add_zero", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.nsmul", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.nsmul_zero'", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.nsmul_succ'", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.add_comm", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.mul", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.left_distrib", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.right_distrib", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.zero_mul", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.mul_zero", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.mul_assoc", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.one", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.one_mul", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.mul_one", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.nat_cast", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.nat_cast_zero", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.nat_cast_succ", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.npow", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.npow_zero'", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.npow_succ'", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.inv", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.div", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.div_eq_mul_inv", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.zpow", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.zpow_zero'", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.zpow_succ'", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.zpow_neg'", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.exists_pair_ne", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.inv_zero", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_semiring.mul_inv_cancel", "description": "A `division_semiring` is a `semiring` with multiplicative inverses for nonzero elements.", "p": "mathlib"}, {"name": "division_ring.to_nontrivial", "description": "", "p": "mathlib"}, {"name": "is_field", "description": " A predicate to express that a (semi)ring is a (semi)field.\n\nThis is mainly useful because such a predicate does not contain data,\nand can therefore be easily transported along ring isomorphisms.\nAdditionaly, this is useful when trying to prove that\na particular ring structure extends to a (semi)field.", "p": "mathlib"}, {"name": "is_field.exists_pair_ne", "description": " A predicate to express that a (semi)ring is a (semi)field.\n\nThis is mainly useful because such a predicate does not contain data,\nand can therefore be easily transported along ring isomorphisms.\nAdditionaly, this is useful when trying to prove that\na particular ring structure extends to a (semi)field.", "p": "mathlib"}, {"name": "is_field.mul_comm", "description": " A predicate to express that a (semi)ring is a (semi)field.\n\nThis is mainly useful because such a predicate does not contain data,\nand can therefore be easily transported along ring isomorphisms.\nAdditionaly, this is useful when trying to prove that\na particular ring structure extends to a (semi)field.", "p": "mathlib"}, {"name": "is_field.mul_inv_cancel", "description": " A predicate to express that a (semi)ring is a (semi)field.\n\nThis is mainly useful because such a predicate does not contain data,\nand can therefore be easily transported along ring isomorphisms.\nAdditionaly, this is useful when trying to prove that\na particular ring structure extends to a (semi)field.", "p": "mathlib"}, {"name": "field.to_is_field", "description": "Transferring from `field` to `is_field`.", "p": "mathlib"}, {"name": "semifield.to_is_field", "description": "Transferring from `semifield` to `is_field`.", "p": "mathlib"}, {"name": "rat.smul_division_ring", "description": "", "p": "mathlib"}, {"name": "division_ring.to_div_inv_monoid", "description": "", "p": "mathlib"}, {"name": "rat.smul_one_eq_coe", "description": "", "p": "mathlib"}, {"name": "has_rat_cast", "description": "Type class for the canonical homomorphism `\u211a \u2192 K`.", "p": "mathlib"}, {"name": "has_rat_cast.rat_cast", "description": "Type class for the canonical homomorphism `\u211a \u2192 K`.", "p": "mathlib"}, {"name": "is_field.to_field", "description": "Transferring from `is_field` to `field`.", "p": "mathlib"}, {"name": "rat.cast_mk'", "description": "", "p": "mathlib"}, {"name": "division_ring", "description": " A `division_ring` is a `ring` with multiplicative inverses for nonzero elements.\n\nAn instance of `division_ring K` includes maps `rat_cast : \u211a \u2192 K` and `qsmul : \u211a \u2192 K \u2192 K`.\nIf the division ring has positive characteristic p, we define `rat_cast (1 / p) = 1 / 0 = 0`\nfor consistency with our division by zero convention.\nThe fields `rat_cast` and `qsmul` are needed to implement the\n`algebra_rat [division_ring K] : algebra \u211a K` instance, since we need to control the specific\ndefinitions for some special cases of `K` (in particular `K = \u211a` itself).\nSee also Note [forgetful inheritance].", "p": "mathlib"}, {"name": "division_ring.add", "description": " A `division_ring` is a `ring` with multiplicative inverses for nonzero elements.\n\nAn instance of `division_ring K` includes maps `rat_cast : \u211a \u2192 K` and `qsmul : \u211a \u2192 K \u2192 K`.\nIf the division ring has positive characteristic p, we define `rat_cast (1 / p) = 1 / 0 = 0`\nfor consistency with our division by zero convention.\nThe fields `rat_cast` and `qsmul` are needed to implement the\n`algebra_rat [division_ring K] : algebra \u211a K` instance, since we need to control the specific\ndefinitions for some special cases of `K` (in particular `K = \u211a` itself).\nSee also Note [forgetful inheritance].", "p": "mathlib"}, {"name": "division_ring.add_assoc", "description": " A `division_ring` is a `ring` with multiplicative inverses for nonzero elements.\n\nAn instance of `division_ring K` includes maps `rat_cast : \u211a \u2192 K` and `qsmul : \u211a \u2192 K \u2192 K`.\nIf the division ring has positive characteristic p, we define `rat_cast (1 / p) = 1 / 0 = 0`\nfor consistency with our division by zero convention.\nThe fields `rat_cast` and `qsmul` are needed to implement the\n`algebra_rat [division_ring K] : algebra \u211a K` instance, since we need to control the specific\ndefinitions for some special cases of `K` (in particular `K = \u211a` itself).\nSee also Note [forgetful inheritance].", "p": "mathlib"}, {"name": "division_ring.zero", "description": " A `division_ring` is a `ring` with multiplicative inverses for nonzero elements.\n\nAn instance of `division_ring K` includes maps `rat_cast : \u211a \u2192 K` and `qsmul : \u211a \u2192 K \u2192 K`.\nIf the division ring has positive characteristic p, we define `rat_cast (1 / p) = 1 / 0 = 0`\nfor consistency with our division by zero convention.\nThe fields `rat_cast` and `qsmul` are needed to implement the\n`algebra_rat [division_ring K] : algebra \u211a K` instance, since we need to control the specific\ndefinitions for some special cases of `K` (in particular `K = \u211a` itself).\nSee also Note [forgetful inheritance].", "p": "mathlib"}, {"name": "division_ring.zero_add", "description": " A `division_ring` is a `ring` with multiplicative inverses for nonzero elements.\n\nAn instance of `division_ring K` includes maps `rat_cast : \u211a \u2192 K` and `qsmul : \u211a \u2192 K \u2192 K`.\nIf the division ring has positive characteristic p, we define `rat_cast (1 / p) = 1 / 0 = 0`\nfor consistency with our division by zero convention.\nThe fields `rat_cast` and `qs