inals p \ud835\udc9f`.\n\n This proves the Rasiowa\u2013Sikorski lemma.", "p": "mathlib"}, {"name": "order.ideal.is_proper_iff", "description": "", "p": "mathlib"}, {"name": "order.ideal.mem_Inf", "description": "", "p": "mathlib"}, {"name": "order.ideal.principal_le_iff", "description": "", "p": "mathlib"}, {"name": "order.mem_ideal_of_cofinals", "description": "", "p": "mathlib"}, {"name": "order.ideal.order_bot", "description": "There is a bottom ideal when `P` has a bottom element.", "p": "mathlib"}, {"name": "order.ideal.is_proper.not_mem_of_compl_mem", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_maximal_iff_is_coatom", "description": "", "p": "mathlib"}, {"name": "order.ideal.complete_lattice", "description": "", "p": "mathlib"}, {"name": "order.ideal.sup_mem_iff", "description": "", "p": "mathlib"}, {"name": "order.ideal.mem_inf", "description": "", "p": "mathlib"}, {"name": "order.ideal.coe_ssubset_coe", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_proper.top_not_mem", "description": "", "p": "mathlib"}, {"name": "order.ideal.mem_principal", "description": "", "p": "mathlib"}, {"name": "order.ideal.ext", "description": "", "p": "mathlib"}, {"name": "is_coatom.is_proper", "description": "", "p": "mathlib"}, {"name": "order.ideal.coe_subset_coe", "description": "", "p": "mathlib"}, {"name": "order.ideal.is_maximal", "description": " An ideal is maximal if it is maximal in the collection of proper ideals.\n\nNote that `is_coatom` is less general because ideals only have a top element when `P` is directed\nand nonempty.", "p": "mathlib"}, {"name": "order.ideal.is_maximal.to_is_proper", "description": " An ideal is maximal if it is maximal in the collection of proper ideals.\n\nNote that `is_coatom` is less general because ideals only have a top element when `P` is directed\nand nonempty.", "p": "mathlib"}, {"name": "order.ideal.is_maximal.maximal_proper", "description": " An ideal is maximal if it is maximal in the collection of 