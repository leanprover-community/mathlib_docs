n": "", "p": "mathlib"}, {"name": "add_mem_closed_ball_iff_norm", "description": "", "p": "mathlib"}, {"name": "dist_sub_sub_le", "description": "", "p": "mathlib"}, {"name": "pi_nnnorm_lt_iff'", "description": "", "p": "mathlib"}, {"name": "mem_closed_ball_zero_iff", "description": "", "p": "mathlib"}, {"name": "tactic.positivity_norm", "description": "Extension for the `positivity` tactic: norms are nonnegative.", "p": "mathlib"}, {"name": "multiplicative.has_nnnorm", "description": "", "p": "mathlib"}, {"name": "norm_sub_sub_norm_sub_le_norm_sub", "description": "", "p": "mathlib"}, {"name": "nnnorm_le_nnnorm_add_nnnorm_div'", "description": "", "p": "mathlib"}, {"name": "dist_self_div_left", "description": "", "p": "mathlib"}, {"name": "norm_lt_of_mem_ball'", "description": "", "p": "mathlib"}, {"name": "real.norm_eq_abs", "description": "", "p": "mathlib"}, {"name": "group_norm.to_normed_group", "description": " Construct a normed group from a norm, i.e., registering the distance and the metric space\nstructure from the norm properties. Note that in most cases this instance creates bad definitional\nequalities (e.g., it does not take into account a possibly existing `uniform_space` instance on\n`E`).", "p": "mathlib"}, {"name": "nndist_eq_nnnorm_sub", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.op_one_is_bounded_under_le'", "description": " A helper lemma used to prove that the (scalar or usual) product of a function that tends to one\nand a bounded function tends to one. This lemma is formulated for any binary operation\n`op : E \u2192 F \u2192 G` with an estimate `\u2016op x y\u2016 \u2264 A * \u2016x\u2016 * \u2016y\u2016` for some constant A instead of\nmultiplication so that it can be applied to `(*)`, `flip (*)`, `(\u2022)`, and `flip (\u2022)`.", "p": "mathlib"}, {"name": "nnnorm_multiset_prod_le", "description": "", "p": "mathlib"}, {"name": "dist_div_div_le_of_le", "description": "", "p": "mathlib"}, {"name": "lipschitz_on_with.norm_sub_le", "description": "**Alias** of the forward direction of `lipschitz_on_with_iff_norm_div_le`.", "p": "mathlib"}, {"name": "norm_sub_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "add_subgroup.seminormed_add_group", "description": "A subgroup of a seminormed group is also a seminormed group,\nwith the restriction of the norm.", "p": "mathlib"}, {"name": "norm_multiset_sum_le", "description": "", "p": "mathlib"}, {"name": "prod.nnnorm_def'", "description": "", "p": "mathlib"}, {"name": "nndist_add_add_le", "description": "", "p": "mathlib"}, {"name": "lipschitz_with_one_nnnorm'", "description": "", "p": "mathlib"}, {"name": "real.norm_two", "description": "", "p": "mathlib"}, {"name": "nnnorm_zsmul_le", "description": "", "p": "mathlib"}, {"name": "dist_mul_mul_le", "description": "", "p": "mathlib"}, {"name": "norm_le_norm_add_norm_sub", "description": "", "p": "mathlib"}, {"name": "normed_comm_group.of_separation", "description": " Construct a `normed_comm_group` from a `seminormed_comm_group` satisfying\n`\u2200 x, \u2016x\u2016 = 0 \u2192 x = 1`. This avoids having to go back to the `(pseudo_)metric_space` level when\ndeclaring a `normed_comm_group` instance as a special case of a more general `seminormed_comm_group`\ninstance.", "p": "mathlib"}, {"name": "dist_self_sub_left", "description": "", "p": "mathlib"}, {"name": "isometry.norm_map_of_map_one", "description": "", "p": "mathlib"}, {"name": "multiplicative.normed_group", "description": "", "p": "mathlib"}, {"name": "seminormed_comm_group.to_has_lipschitz_mul", "description": "", "p": "mathlib"}, {"name": "edist_mul_mul_le", "description": "", "p": "mathlib"}, {"name": "submodule.seminormed_add_comm_group", "description": "A submodule of a seminormed group is also a seminormed group, with the restriction of the norm.", "p": "mathlib"}, {"name": "nnnorm_le_pi_nnnorm'", "description": "", "p": "mathlib"}, {"name": "isometry.norm_map_of_map_zero", "description": "", "p": "mathlib"}, {"name": "me