n": "", "p": "mathlib"}, {"name": "add_equiv.mk_coe'", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.inverse", "description": "The inverse of a bijective `add_monoid_hom` is an `add_monoid_hom`.", "p": "mathlib"}, {"name": "monoid_hom.to_mul_equiv", "description": " Given a pair of monoid homomorphisms `f`, `g` such that `g.comp f = id` and `f.comp g = id`,\nreturns an multiplicative equivalence with `to_fun = f` and `inv_fun = g`.  This constructor is\nuseful if the underlying type(s) have specialized `ext` lemmas for monoid homomorphisms.", "p": "mathlib"}, {"name": "add_equiv.Pi_subsingleton", "description": "A family indexed by a nonempty subsingleton type is\nequivalent to the element at the single index.", "p": "mathlib"}, {"name": "add_equiv.Pi_congr_right_refl", "description": "", "p": "mathlib"}, {"name": "add_equiv.ext", "description": "Two additive isomorphisms agree if they are defined by the same underlying function.", "p": "mathlib"}, {"name": "mul_equiv.apply_eq_iff_symm_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.arrow_congr", "description": "A multiplicative analogue of `equiv.arrow_congr`,\nwhere the equivalence between the targets is multiplicative.", "p": "mathlib"}, {"name": "mul_equiv.ext_iff", "description": "", "p": "mathlib"}, {"name": "add_equiv.coe_refl", "description": "", "p": "mathlib"}, {"name": "mul_equiv.coe_monoid_hom_trans", "description": "", "p": "mathlib"}, {"name": "mul_equiv.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "mul_equiv.map_one", "description": "A multiplicative isomorphism of monoids sends `1` to `1` (and is hence a monoid isomorphism).", "p": "mathlib"}, {"name": "monoid_hom.inverse", "description": "The inverse of a bijective `monoid_hom` is a `monoid_hom`.", "p": "mathlib"}, {"name": "add_equiv.trans", "description": "Transitivity of addition-preserving isomorphisms", "p": "mathlib"}, {"name": "equiv.inv_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.symm", "description": "The inverse of an isomorphism is an isomorphism.", "p": "mathlib"}, {"name": "add_equiv.eq_symm_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.self_comp_symm", "description": "", "p": "mathlib"}, {"name": "mul_equiv.Pi_congr_right_symm", "description": "", "p": "mathlib"}, {"name": "add_equiv.mk_coe", "description": "", "p": "mathlib"}, {"name": "add_equiv.to_equiv_eq_coe", "description": "", "p": "mathlib"}, {"name": "add_equiv.coe_add_monoid_hom_refl", "description": "", "p": "mathlib"}, {"name": "add_equiv.congr_arg", "description": "", "p": "mathlib"}, {"name": "add_equiv.map_neg", "description": "An additive equivalence of additive groups preserves negation.", "p": "mathlib"}, {"name": "equiv.inv", "description": "Inversion on a `group` or `group_with_zero` is a permutation of the underlying type.", "p": "mathlib"}, {"name": "mul_equiv.map_div", "description": "A multiplicative equivalence of groups preserves division.", "p": "mathlib"}, {"name": "mul_hom.to_mul_equiv_apply", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.to_add_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.of_bijective", "description": "A bijective `semigroup` homomorphism is an isomorphism", "p": "mathlib"}, {"name": "mul_equiv.to_equiv", "description": "The `equiv` underlying a `mul_equiv`.", "p": "mathlib"}, {"name": "add_equiv.bijective", "description": "", "p": "mathlib"}, {"name": "add_equiv.self_trans_symm", "description": "", "p": "mathlib"}, {"name": "mul_equiv.Pi_congr_right_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.coe_monoid_hom_refl", "description": "", "p": "mathlib"}, {"name": "mul_equiv.ext", "description": "Two multiplicative isomorphisms agree if they are defined by the\n   same underlying function.", "p": "mathlib"}, {"name": "add_equiv.apply_symm_apply", "description": "`e.symm` is a right inverse of `e`, written as `e (e.symm y) = y`.", "p": "mathlib"}, {"name": "mul_equiv.of_bijective_apply", "description": "", "p": "mathlib"}, {"name": "add_equiv_class", "description": " `add_equiv_class F A B` states that `F` is a type of addition-preserving morphisms.\nYou should extend this class when you extend `add_equiv`.", "p": "mathlib"}, {"name": "add_equiv_class.coe", "description": " `add_equiv_class F A B` states that `F` is a type of addition-preserving morphisms.\nYou should extend this class when you extend `add_equiv`.", "p": "mathlib"}, {"name": "add_equiv_class.inv", "description": " `add_equiv_class F A B` states that `F` is a type of addition-preserving morphisms.\nYou should extend this class when you extend `add_equiv`.", "p": "mathlib"}, {"name": "add_equiv_class.left_inv", "description": " `add_equiv_class F A B` states that `F` is a type of addition-preserving morphisms.\nYou should extend this class when you extend `add_equiv`.", "p": "mathlib"}, {"name": "add_equiv_class.right_inv", "description": " `add_equiv_class F A B` states that `F` is a type of addition-preserving morphisms.\nYou should extend this class when you extend `add_equiv`.", "p": "mathlib"}, {"name": "add_equiv_class.coe_injective'", "description": " `add_equiv_class F A B` states that `F` is a type of addition-preserving morphisms.\nYou should extend this class when you extend `add_equiv`.", "p": "mathlib"}, {"name": "add_equiv_class.map_add", "description": " `add_equiv_class F A B` states that `F` is a type of addition-preserving morphisms.\nYou should extend this class when you extend `add_equiv`.", "p": "mathlib"}, {"name": "mul_equiv.inhabited", "description": "", "p": "mathlib"}, {"name": "add_equiv.Pi_subsingleton_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.refl", "description": "The identity map is a multiplicative isomorphism.", "p": "mathlib"}, {"name": "mul_equiv.Pi_congr_right_trans", "description": "", "p": "mathlib"}, {"name": "mul_equiv.to_equiv_symm", "description": "", "p": "mathlib"}, {"name": "mul_equiv.symm_comp_eq", "description": "", "p": "mathlib"}, {"name": "equiv.neg_symm", "description": "", "p": "mathlib"}, {"name": "add_equiv.Pi_subsingleton_symm_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.arrow_congr_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.mul_equiv_of_unique", "description": "The `mul_equiv` between two monoids with a unique element.", "p": "mathlib"}, {"name": "mul_equiv.to_equiv_eq_coe", "description": "", "p": "mathlib"}, {"name": "mul_equiv_class.to_monoid_with_zero_hom_class", "description": "", "p": "mathlib"}, {"name": "mul_equiv.refl_apply", "description": "", "p": "mathlib"}, {"name": "add_equiv.symm_apply_apply", "description": "`e.symm` is a left inverse of `e`, written as `e.symm (e y) = y`.", "p": "mathlib"}, {"name": "add_equiv.to_equiv_symm", "description": "", "p": "mathlib"}, {"name": "mul_equiv_class.map_eq_one_iff", "description": "", "p": "mathlib"}, {"name": "add_equiv.Pi_congr_right_symm", "description": "", "p": "mathlib"}, {"name": "equiv.inv_symm", "description": "", "p": "mathlib"}, {"name": "mul_equiv.bijective", "description": "", "p": "mathlib"}, {"name": "add_equiv.coe_to_add_hom", "description": "", "p": "mathlib"}, {"name": "mul_equiv.map_inv", "description": "A multiplicative equivalence of groups preserves inversion.", "p": "mathlib"}, {"name": "mul_equiv.of_bijective_apply_symm_apply", "description": "", "p": "mathlib"}, {"name": "add_equiv.symm_mk", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.to_add_equiv_apply", "description": "", "p": "mathlib"}, {"name": "monoid_hom.to_mul_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.symm_apply_eq", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.inverse_apply", "description": "", "p": "mathlib"}, {"name": "add_equiv.symm_symm", "description": "", "p": "mathlib"}, {"name": "mul_equiv.apply_eq_iff_eq", "description": "", "p": "mathlib"}, {"name": "add_equiv.Pi_congr_right_trans", "description": "", "p": "mathlib"}, {"name": "mul_equiv.unique", "description": "There is a unique monoid homomorphism between two monoids with a unique element.", "p": "mathlib"}, {"name": "add_equiv.congr_fun", "description": "", "p": "mathlib"}, {"name": "add_equiv.coe_mk", "description": "", "p": "mathlib"}, {"name": "mul_equiv", "description": "`mul_equiv \u03b1 \u03b2` is the type of an equiv `\u03b1 \u2243 \u03b2` which preserves multiplication.", "p": "mathlib"}, {"name": "mul_equiv.to_fun", "description": "`mul_equiv \u03b1 \u03b2` is the type of an equiv `\u03b1 \u2243 \u03b2` which preserves multiplication.", "p": "mathlib"}, {"name": "mul_equiv.inv_fun", "description": "`mul_equiv \u03b1 \u03b2` is the type of an equiv `\u03b1 \u2243 \u03b2` which preserves multiplication.", "p": "mathlib"}, {"name": "mul_equiv.left_inv", "description": "`mul_equiv \u03b1 \u03b2` is the type of an equiv `\u03b1 \u2243 \u03b2` which preserves multiplication.", "p": "mathlib"}, {"name": "mul_equiv.right_inv", "description": "`mul_equiv \u03b1 \u03b2` is the type of an equiv `\u03b1 \u2243 \u03b2` which preserves multiplication.", "p": "mathlib"}, {"name": "mul_equiv.map_mul'", "description": "`mul_equiv \u03b1 \u03b2` is the type of an equiv `\u03b1 \u2243 \u03b2` which preserves multiplication.", "p": "mathlib"}, {"name": "mul_equiv.congr_fun", "description": "", "p": "mathlib"}, {"name": "add_equiv_class.add_hom_class", "description": "", "p": "mathlib"}, {"name": "mul_equiv.map_mul", "description": "A multiplicative isomorphism preserves multiplication.", "p": "mathlib"}, {"name": "monoid_hom.inverse_apply", "description": "", "p": "mathlib"}, {"name": "mul_equiv.congr_arg", "description": "", "p": "mathlib"}, {"name": "add_equiv.to_equiv_mk", "description": "", "p": "mathlib"}, {"name": "add_hom.to_add_equiv_apply", "description": "", "p": "mathlib"}, {"name": "add_equiv.Pi_congr_right_apply", "description": "", "p": "mathlib"}, {"name": "add_equiv.Pi_congr_right", "description": "A family of additive equivalences `\u03a0 j, (Ms j \u2243+ Ns j)`\ngenerates an additive equivalence between `\u03a0 j, Ms j` and `\u03a0 j, Ns j`.\n\nThis is the `add_equiv` version of `equiv.Pi_congr_right`, and the dependent version of\n`add_equiv.arrow_congr`.", "p": "mathlib"}, {"name": "add_equiv.surjective", "description": "", "p": "mathlib"}, {"name": "mul_equiv.simps.symm_apply", "description": "See Note [custom simps projection]", "p": "mathlib"}, {"name": "add_equiv.add_equiv_class", "description": "", "p": "mathlib"}, {"name": "mul_equiv_class.to_equiv_like", "description": "", "p": "mathlib"}, {"name": "add_equiv_class.map_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "mul_equiv.Pi_congr_right", "description": " A family of multiplicative equivalences `\u03a0 j, (Ms j \u2243* Ns j)` generates a\nmultiplicative equivalence between `\u03a0 j, Ms j` and `\u03a0 j, Ns j`.\n\nThis is the `mul_equiv` version of `equiv.Pi_congr_right`, and the dependent version of\n`mul_equiv.arrow_congr`.", "p": "mathlib"}, {"name": "frontier_eq_empty_iff", "description": "", "p": "mathlib"}, {"name": "totally_disconnected_space", "description": "A space is totally disconnected if all of its connected components are singletons.", "p": "mathlib"}, {"name": "totally_disconnected_space.is_totally_disconnected_univ", "description": "A space is totally disconnected if all of its connected components are singletons.", "p": "mathlib"}, {"name": "connected_component_in_mono", "description": "", "p": "mathlib"}, {"name": "prod.preconnected_space", "description": "", "p": "mathlib"}, {"name": "connected_components", "description": "The quotient of a space by its connected components", "p": "mathlib"}, {"name": "mem_connected_component_in", "description": "", "p": "mathlib"}, {"name": "is_preconnected.subset_of_closure_inter_subset", "description": " If a preconnected set `s` intersects an open set `u`, and limit points of `u` inside `s` are\ncontained in `u`, then the whole set `s` is contained in `u`.", "p": "mathlib"}, {"name": "is_connected_univ", "description": "", "p": "mathlib"}, {"name": "is_preconnected.Union_of_chain", "description": "The Union of connected sets indexed by a type with an archimedean successor (like `\u2115` or `\u2124`)\n such that any two neighboring sets meet is preconnected.", "p": "mathlib"}, {"name": "is_preconnected_sUnion", "description": "A union of a family of preconnected sets with a common point is preconnected as well.", "p": "mathlib"}, {"name": "is_preconnected.closure", "description": "The closure of a (pre)connected set is (pre)connected as well.", "p": "mathlib"}, {"name": "sigma.is_connected_iff", "description": "", "p": "mathlib"}, {"name": "totally_disconnected_space_iff_connected_component_subsingleton", "description": "A space is totally disconnected iff its connected components are subsingletons.", "p": "mathlib"}, {"name": "sum.totally_disconnected_space", "description": "", "p": "mathlib"}, {"name": "connected_component_disjoint", "description": "", "p": "mathlib"}, {"name": "is_connected_range", "description": "", "p": "mathlib"}, {"name": "locally_connected_space", "description": " A topological space is **locally connected** if each neighborhood filter admits a basis\nof connected *open* sets. Note that it is equivalent to each point having a basis of connected\n(non necessarily open) sets but in a non-trivial way, so we choose this definition and prove the\nequivalence later in `locally_connected_space_iff_connected_basis`.", "p": "mathlib"}, {"name": "locally_connected_space.open_connected_basis", "description": " A topological space is **locally connected** if each neighborhood filter admits a basis\nof connected *open* sets. Note that it is equivalent to each point having a basis of connected\n(non necessarily open) sets but in a non-trivial way, so we choose this definition and prove the\nequivalence later in `locally_connected_space_iff_connected_basis`.", "p": "mathlib"}, {"name": "is_connected.closure", "description": "", "p": "mathlib"}, {"name": "discrete_topology.to_locally_connected_space", "description": "A space with discrete topology is a locally connected space.", "p": "mathlib"}, {"name": "connected_components.coe_eq_coe", "description": "", "p": "mathlib"}, {"name": "sigma.totally_disconnected_space", "description": "", "p": "mathlib"}, {"name": "disjoint_or_subset_of_clopen", "description": "Preconnected sets are either contained in or disjoint to any given clopen set.", "p": "mathlib"}, {"name": "is_preconnected.sUnion_directed", "description": "The directed sUnion of a set S of preconnected subsets is preconnected.", "p": "mathlib"}, {"name": "is_connected.bUnion_of_chain", "description": "The Union of connected sets indexed by a subset of a type with an archimedean successor\n (like `\u2115` or `\u2124`) such that any two neighboring sets meet is preconnected.", "p": "mathlib"}, {"name": "is_preconnected.subset_connected_component_in", "description": "", "p": "mathlib"}, {"name": "is_connected_iff_sUnion_disjoint_open", "description": " A set `s` is connected if and only if\nfor every cover by a finite collection of open sets that are pairwise disjoint on `s`,\nit is contained in one of the members of the collection.", "p": "mathlib"}, {"name": "is_connected.subset_connected_component", "description": "", "p": "mathlib"}, {"name": "is_clopen.connected_component_subset", "description": "", "p": "mathlib"}, {"name": "sigma.is_preconnected_iff", "description": "", "p": "mathlib"}, {"name": "is_preconnected.constant_of_maps_to", "description": " Refinement of `is_preconnected.constant` only assuming the map factors through a\ndiscrete subset of the target.", "p": "mathlib"}, {"name": "pi.totally_disconnected_space", "description": "", "p": "mathlib"}, {"name": "sum.is_connected_iff", "description": "", "p": "mathlib"}, {"name": "irreducible_component_subset_connected_component", "description": "", "p": "mathlib"}, {"name": "nonempty_inter", "description": "", "p": "mathlib"}, {"name": "is_totally_separated", "description": " A set `s` is called totally separated if any two points of this set can be separated\nby two disjoint open sets covering `s`.", "p": "mathlib"}, {"name": "connected_component_subset_Inter_clopen", "description": " The connected component of a point is always a subset of the intersection of all its clopen\nneighbourhoods.", "p": "mathlib"}, {"name": "pi.connected_space", "description": "", "p": "mathlib"}, {"name": "is_preconnected_of_forall", "description": " If any point of a set is joined to a fixed point by a preconnected subset,\nthen the original set is preconnected as well.", "p": "mathlib"}, {"name": "is_connected", "description": "A connected set is one that is nonempty and where there is no non-trivial open partition.", "p": "mathlib"}, {"name": "is_preconnected.subset_connected_component", "description": "", "p": "mathlib"}, {"name": "preconnected_space_iff_connected_component", "description": "", "p": "mathlib"}, {"name": "is_preconnected.preimage_of_closed_map", "description": "", "p": "mathlib"}, {"name": "is_preconnected_iff_subset_of_disjoint", "description": " A set `s` is preconnected if and only if\nfor every cover by two open sets that are disjoint on `s`,\nit is contained in one of the two covering sets.", "p": "mathlib"}, {"name": "is_connected.prod", "description": "", "p": "mathlib"}, {"name": "is_totally_disconnected_of_totally_disconnected_space", "description": "", "p": "mathlib"}, {"name": "is_preconnected_iff_subset_of_fully_disjoint_closed", "description": " A closed set `s` is preconnected if and only if\nfor every cover by two closed sets that are disjoint,\nit is contained in one of the two covering sets.", "p": "mathlib"}, {"name": "connected_component_in", "description": " Given a set `F` in a topological space `\u03b1` and a point `x : \u03b1`, the connected\ncomponent of `x` in `F` is the connected component of `x` in the subtype `F` seen as\na set in `\u03b1`. This definition does not make sense if `x` is not in `F` so we return the\nempty set in this case.", "p": "mathlib"}, {"name": "preirreducible_space.preconnected_space", "description": "", "p": "mathlib"}, {"name": "continuous.connected_components_lift_unique", "description": "", "p": "mathlib"}, {"name": "connected_component_eq_iff_mem", "description": "", "p": "mathlib"}, {"name": "connected_component_nonempty", "description": "", "p": "mathlib"}, {"name": "connected_components.inhabited", "description": "", "p": "mathlib"}, {"name": "is_preconnected.Union_of_refl_trans_gen", "description": " Preconnectedness of the Union of a family of preconnected sets\nindexed by the vertices of a preconnected graph,\nwhere two vertices are joined when the corresponding sets intersect.", "p": "mathlib"}, {"name": "is_connected.Union_of_chain", "description": "The Union of connected sets indexed by a type with an archimedean successor (like `\u2115` or `\u2124`)\n such that any two neighboring sets meet is connected.", "p": "mathlib"}, {"name": "quotient_map.image_connected_component", "description": "", "p": "mathlib"}, {"name": "is_preconnected_of_forall_pair", "description": " If any two points of a set are contained in a preconnected subset,\nthen the original set is preconnected as well.", "p": "mathlib"}, {"name": "set.subsingleton.is_preconnected", "description": "", "p": "mathlib"}, {"name": "prod.connected_space", "description": "", "p": "mathlib"}, {"name": "connected_components.range_coe", "description": "", "p": "mathlib"}, {"name": "connected_components.coe_eq_coe'", "description": "", "p": "mathlib"}, {"name": "is_clopen_connected_component", "description": "", "p": "mathlib"}, {"name": "is_preconnected.constant", "description": " A preconnected set `s` has the property that every map to a\ndiscrete space that is continuous on `s` is constant on `s`", "p": "mathlib"}, {"name": "is_preconnected_connected_component_in", "description": "", "p": "mathlib"}, {"name": "is_totally_disconnected_of_image", "description": "", "p": "mathlib"}, {"name": "continuous.image_connected_component_eq_singleton", "description": "The image of a connected component in a totally disconnected space is a singleton.", "p": "mathlib"}, {"name": "connected_component_in_eq", "description": "", "p": "mathlib"}, {"name": "is_connected_iff_connected_space", "description": "", "p": "mathlib"}, {"name": "is_preirreducible.is_preconnected", "description": "", "p": "mathlib"}, {"name": "is_connected.is_preconnected", "description": "", "p": "mathlib"}, {"name": "connected_component_in_eq_image", "description": "", "p": "mathlib"}, {"name": "is_totally_separated_singleton", "description": "", "p": "mathlib"}, {"name": "dense_range.preconnected_space", "description": "", "p": "mathlib"}, {"name": "is_connected.preimage_of_open_map", "description": "", "p": "mathlib"}, {"name": "connected_components_preimage_image", "description": " The preimage of the image of a set under the quotient map to `connected_components \u03b1`\nis the union of the connected components of the elements in it.", "p": "mathlib"}, {"name": "preconnected_space_of_forall_constant", "description": "A `preconnected_space` version of `is_preconnected_of_forall_constant`", "p": "mathlib"}, {"name": "locally_connected_space_iff_connected_basis", "description": "", "p": "mathlib"}, {"name": "irreducible_space.connected_space", "description": "", "p": "mathlib"}, {"name": "is_connected.subset_closure", "description": "", "p": "mathlib"}, {"name": "is_preconnected.union", "description": "", "p": "mathlib"}, {"name": "subtype.totally_disconnected_space", "description": "", "p": "mathlib"}, {"name": "connected_component_in_subset", "description": "", "p": "mathlib"}, {"name": "is_preconnected.connected_component_in", "description": "", "p": "mathlib"}, {"name": "is_preconnected_of_forall_constant", "description": " If every map to `bool` (a discrete two-element space), that is\ncontinuous on a set `s`, is constant on s, then s is preconnected", "p": "mathlib"}, {"name": "is_preconnected.bUnion_of_chain", "description": "The Union of preconnected sets indexed by a subset of a type with an archimedean successor\n (like `\u2115` or `\u2124`) such that any two neighboring sets meet is preconnected.", "p": "mathlib"}, {"name": "is_connected.bUnion_of_refl_trans_gen", "description": " The bUnion of a family of preconnected sets is preconnected if the graph determined by\nwhether two sets intersect is preconnected.", "p": "mathlib"}, {"name": "connected_component_eq_singleton", "description": "", "p": "mathlib"}, {"name": "is_connected.nonempty", "description": "", "p": "mathlib"}, {"name": "is_preconnected.bUnion_of_refl_trans_gen", "description": " The bUnion of a family of preconnected sets is preconnected if the graph determined by\nwhether two sets intersect is preconnected.", "p": "mathlib"}, {"name": "is_preconnected.subset_left_of_subset_union", "description": "", "p": "mathlib"}, {"name": "totally_separated_space.totally_disconnected_space", "description": "", "p": "mathlib"}, {"name": "is_preconnected.subset_right_of_subset_union", "description": "", "p": "mathlib"}, {"name": "connected_components.totally_disconnected_space", "description": "", "p": "mathlib"}, {"name": "is_totally_disconnected", "description": " A set `s` is called totally disconnected if every subset `t \u2286 s` which is preconnected is\na subsingleton, ie either empty or a singleton.", "p": "mathlib"}, {"name": "is_preconnected.preimage_of_open_map", "description": "", "p": "mathlib"}, {"name": "is_connected.union", "description": "", "p": "mathlib"}, {"name": "locally_connected_space_iff_connected_component_in_open", "description": "", "p": "mathlib"}, {"name": "is_preconnected.union'", "description": "", "p": "mathlib"}, {"name": "is_irreducible.is_connected", "description": "", "p": "mathlib"}, {"name": "is_clopen.eq_univ", "description": "", "p": "mathlib"}, {"name": "is_clopen_iff", "description": "", "p": "mathlib"}, {"name": "connected_component_setoid", "description": "The setoid of connected components of a topological space", "p": "mathlib"}, {"name": "is_preconnected_iff_preconnected_space", "description": "", "p": "mathlib"}, {"name": "connected_components.coe_ne_coe", "description": "", "p": "mathlib"}, {"name": "pi.preconnected_space", "description": "", "p": "mathlib"}, {"name": "is_preconnected.image", "description": "The image of a (pre)connected set is (pre)connected as well.", "p": "mathlib"}, {"name": "is_preconnected_closed_iff", "description": "", "p": "mathlib"}, {"name": "is_preconnected.subsingleton", "description": "", "p": "mathlib"}, {"name": "nonempty_frontier_iff", "description": "", "p": "mathlib"}, {"name": "continuous.connected_components_lift", "description": "The lift to `connected_components \u03b1` of a continuous map from `\u03b1` to a totally disconnected space", "p": "mathlib"}, {"name": "locally_connected_space_iff_open_connected_basis", "description": "", "p": "mathlib"}, {"name": "is_preconnected_univ_pi", "description": "", "p": "mathlib"}, {"name": "is_preconnected.subset_or_subset", "description": "", "p": "mathlib"}, {"name": "locally_connected_space_of_connected_bases", "description": "", "p": "mathlib"}, {"name": "connected_space_iff_connected_component", "description": "", "p": "mathlib"}, {"name": "totally_disconnected_space_iff_connected_component_singleton", "description": "A space is totally disconnected iff its connected components are singletons.", "p": "mathlib"}, {"name": "preconnected_space.constant", "description": "A `preconnected_space` version of `is_preconnected.constant`", "p": "mathlib"}, {"name": "continuous.connected_components_lift_apply_coe", "description": "", "p": "mathlib"}, {"name": "locally_connected_space_iff_open_connected_subsets", "description": "", "p": "mathlib"}, {"name": "is_clopen.bUnion_connected_component_eq", "description": "A clopen set is the union of its connected components.", "p": "mathlib"}, {"name": "is_preconnected_connected_component", "description": "", "p": "mathlib"}, {"name": "preimage_connected_component_connected", "description": " The preimage of a connected component is preconnected if the function has connected fibers\nand a subset is closed iff the preimage is.", "p": "mathlib"}, {"name": "sum.is_preconnected_iff", "description": "", "p": "mathlib"}, {"name": "is_preconnected_iff_subset_of_disjoint_closed", "description": " A set `s` is preconnected if and only if\nfor every cover by two closed sets that are disjoint on `s`,\nit is contained in one of the two covering sets.", "p": "mathlib"}, {"name": "locally_connected_space_iff_connected_subsets", "description": "", "p": "mathlib"}, {"name": "is_totally_disconnected_empty", "description": "", "p": "mathlib"}, {"name": "is_preconnected.prod", "description": "", "p": "mathlib"}, {"name": "connected_components.surjective_coe", "description": "", "p": "mathlib"}, {"name": "connected_components.continuous_coe", "description": "", "p": "mathlib"}, {"name": "is_connected_connected_component", "description": "", "p": "mathlib"}, {"name": "connected_component_in_univ", "description": "", "p": "mathlib"}, {"name": "subtype.connected_space", "description": "", "p": "mathlib"}, {"name": "is_totally_disconnected_of_is_totally_separated", "description": "", "p": "mathlib"}, {"name": "connected_component_in_eq_empty", "description": "", "p": "mathlib"}, {"name": "is_connected_singleton", "description": "", "p": "mathlib"}, {"name": "continuous.image_connected_component_subset", "description": "", "p": "mathlib"}, {"name": "exists_clopen_of_totally_separated", "description": "", "p": "mathlib"}, {"name": "subtype.preconnected_space", "description": "", "p": "mathlib"}, {"name": "is_totally_disconnected_of_clopen_set", "description": "Let `X` be a topological space, and suppose that for all distinct `x,y \u2208 X`, there\n is some clopen set `U` such that `x \u2208 U` and `y \u2209 U`. Then `X` is totally disconnected.", "p": "mathlib"}, {"name": "preconnected_space.connected_component_eq_univ", "description": "", "p": "mathlib"}, {"name": "continuous.connected_components_lift_comp_coe", "description": "", "p": "mathlib"}, {"name": "totally_separated_space", "description": " A space is totally separated if any two points can be separated by two disjoint open sets\ncovering the whole space.", "p": "mathlib"}, {"name": "totally_separated_space.is_totally_separated_univ", "description": " A space is totally separated if any two points can be separated by two disjoint open sets\ncovering the whole space.", "p": "mathlib"}, {"name": "is_preconnected", "description": "A preconnected set is one where there is no non-trivial open partition.", "p": "mathlib"}, {"name": "preconnected_space", "description": "A preconnected space is one where there is no non-trivial open partition.", "p": "mathlib"}, {"name": "preconnected_space.is_preconnected_univ", "description": "A preconnected space is one where there is no non-trivial open partition.", "p": "mathlib"}, {"name": "is_connected.image", "description": "", "p": "mathlib"}, {"name": "is_preconnected_range", "description": "", "p": "mathlib"}, {"name": "is_connected_univ_pi", "description": "", "p": "mathlib"}, {"name": "totally_separated_space.of_discrete", "description": "", "p": "mathlib"}, {"name": "mem_connected_component", "description": "", "p": "mathlib"}, {"name": "prod.totally_disconnected_space", "description": "", "p": "mathlib"}, {"name": "continuous.connected_components_lift_continuous", "description": "", "p": "mathlib"}, {"name": "is_preconnected_empty", "description": "", "p": "mathlib"}, {"name": "continuous.connected_components_map", "description": "Functoriality of `connected_components`", "p": "mathlib"}, {"name": "connected_component_eq", "description": "", "p": "mathlib"}, {"name": "connected_components_lift_unique'", "description": "", "p": "mathlib"}, {"name": "connected_components.quotient_map_coe", "description": "", "p": "mathlib"}, {"name": "quotient_map.preimage_connected_component", "description": "", "p": "mathlib"}, {"name": "is_connected_connected_component_in_iff", "description": "", "p": "mathlib"}, {"name": "is_closed_connected_component", "description": "", "p": "mathlib"}, {"name": "connected_components_preimage_singleton", "description": " The preimage of a singleton in `connected_components` is the connected component\nof an element in the equivalence class.", "p": "mathlib"}, {"name": "continuous.image_eq_of_connected_component_eq", "description": "", "p": "mathlib"}, {"name": "continuous.connected_components_map_continuous", "description": "", "p": "mathlib"}, {"name": "is_open_connected_component", "description": "", "p": "mathlib"}, {"name": "continuous.maps_to_connected_component", "description": "", "p": "mathlib"}, {"name": "connected_component_in_nonempty_iff", "description": "", "p": "mathlib"}, {"name": "embedding.is_totally_disconnected", "description": "", "p": "mathlib"}, {"name": "is_open.connected_component_in", "description": "", "p": "mathlib"}, {"name": "connected_components.has_coe_t", "description": "", "p": "mathlib"}, {"name": "connected_space", "description": "A connected space is a nonempty one where there is no non-trivial open partition.", "p": "mathlib"}, {"name": "connected_space.to_preconnected_space", "description": "A connected space is a nonempty one where there is no non-trivial open partition.", "p": "mathlib"}, {"name": "connected_space.to_nonempty", "description": "A connected space is a nonempty one where there is no non-trivial open partition.", "p": "mathlib"}, {"name": "is_preconnected_Union", "description": "", "p": "mathlib"}, {"name": "connected_component", "description": " The connected component of a point is the maximal connected set\nthat contains this point.", "p": "mathlib"}, {"name": "is_connected.preimage_of_closed_map", "description": "", "p": "mathlib"}, {"name": "connected_component_in_mem_nhds", "description": "", "p": "mathlib"}, {"name": "is_preconnected_singleton", "description": "", "p": "mathlib"}, {"name": "is_connected.Union_of_refl_trans_gen", "description": "", "p": "mathlib"}, {"name": "is_preconnected.subset_closure", "description": " Theorem of bark and tree :\nif a set is within a (pre)connected set and its closure,\nthen it is (pre)connected as well.", "p": "mathlib"}, {"name": "inducing.is_preconnected_image", "description": "", "p": "mathlib"}, {"name": "is_totally_separated_empty", "description": "", "p": "mathlib"}, {"name": "is_totally_separated.is_totally_disconnected", "description": "**Alias** of `is_totally_disconnected_of_is_totally_separated`.", "p": "mathlib"}, {"name": "is_totally_disconnected_singleton", "description": "", "p": "mathlib"}, {"name": "connected_components.topological_space", "description": "", "p": "mathlib"}, {"name": "is_preconnected.subset_clopen", "description": "Preconnected sets are either contained in or disjoint to any given clopen set.", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex.obj_X", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_coface_map_complex_obj", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_coface_map_complex.obj", "description": "The alternating coface map complex, on objects", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex.obj", "description": "The alternating face map complex, on objects", "p": "mathlib"}, {"name": "algebraic_topology.map_alternating_face_map_complex", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.inclusion_of_Moore_complex", "description": " The inclusion map of the Moore complex in the alternating face map complex,\nas a natural transformation", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex_map_f", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_coface_map_complex.obj_d", "description": " The differential on the alternating coface map complex is the alternate\nsum of the coface maps", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex_obj_d", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex.d_squared", "description": "## The chain complex relation `d \u226b d`", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex.map_f", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.inclusion_of_Moore_complex_map_f", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex.\u03b5_app", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex.map", "description": "The alternating face map complex, on morphisms", "p": "mathlib"}, {"name": "algebraic_topology.alternating_coface_map_complex", "description": "The alternating coface map complex, as a functor", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex.\u03b5", "description": " The natural transformation which gives the augmentation of the alternating face map\ncomplex attached to an augmented simplicial object.", "p": "mathlib"}, {"name": "algebraic_topology.karoubi_alternating_face_map_complex_d", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_coface_map_complex.map", "description": "The alternating face map complex, on morphisms", "p": "mathlib"}, {"name": "algebraic_topology.alternating_coface_map_complex.d_eq_unop_d", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_coface_map_complex_map", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_coface_map_complex.d_squared", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex.obj_d", "description": " The differential on the alternating face map complex is the alternate\nsum of the face maps", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex_obj_X", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex", "description": "The alternating face map complex, as a functor", "p": "mathlib"}, {"name": "algebraic_topology.inclusion_of_Moore_complex_app", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.alternating_face_map_complex.obj_d_eq", "description": "", "p": "mathlib"}, {"name": "algebraic_topology.inclusion_of_Moore_complex_map", "description": "The inclusion map of the Moore complex in the alternating face map complex", "p": "mathlib"}, {"name": "witt_vector.verschiebung_fun_is_poly", "description": "`witt_vector.verschiebung` has polynomial structure given by `witt_vector.verschiebung_poly`.", "p": "mathlib"}, {"name": "witt_vector.aeval_verschiebung_poly", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_is_poly", "description": "`witt_vector.verschiebung` is a polynomial function.", "p": "mathlib"}, {"name": "witt_vector.verschiebung_fun_is_poly.comp\u2082_i", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_fun_is_poly.comp_i", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_coeff_add_one", "description": "", "p": "mathlib"}, {"name": "witt_vector.map_verschiebung", "description": "verschiebung is a natural transformation", "p": "mathlib"}, {"name": "witt_vector.ghost_component_zero_verschiebung", "description": "", "p": "mathlib"}, {"name": "witt_vector.ghost_component_verschiebung_fun", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_is_poly.comp_i", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_fun_coeff", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_coeff_zero", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_is_poly.comp\u2082_i", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_coeff_succ", "description": "", "p": "mathlib"}, {"name": "witt_vector.aeval_verschiebung_poly'", "description": "", "p": "mathlib"}, {"name": "witt_vector.bind\u2081_verschiebung_poly_witt_polynomial", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_fun", "description": "`verschiebung_fun x` shifts the coefficients of `x` up by one,\nby inserting 0 as the 0th coefficient.\n`x.coeff i` then becomes `(verchiebung_fun x).coeff (i + 1)`.\n\n`verschiebung_fun` is the underlying function of the additive monoid hom `witt_vector.verschiebung`.", "p": "mathlib"}, {"name": "witt_vector.ghost_component_verschiebung", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_fun_coeff_succ", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_fun_coeff_zero", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung", "description": "`verschiebung x` shifts the coefficients of `x` up by one, by inserting 0 as the 0th coefficient.\n`x.coeff i` then becomes `(verchiebung x).coeff (i + 1)`.\n\nThis is a additive monoid hom with underlying function `verschiebung_fun`.", "p": "mathlib"}, {"name": "witt_vector.ghost_component_zero_verschiebung_fun", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_poly_zero", "description": "", "p": "mathlib"}, {"name": "witt_vector.verschiebung_poly", "description": "The 0th Verschiebung polynomial is 0. For `n > 0`, the `n`th Verschiebung polynomial is the\nvariable `X (n-1)`.", "p": "mathlib"}, {"name": "tactic_doc.command.add_tactic_doc", "description": "A command used to add documentation for a tactic, command, hole command, or attribute.\n\nUsage: after defining an interactive tactic, command, or attribute,\nadd its documentation as follows.\n```lean\n/--\ndescribe what the command does here\n-/\nadd_tactic_doc\n{ name := \"display name of the tactic\",\n  category := cat,\n  decl_names := [`dcl_1, `dcl_2],\n  tags := [\"tag_1\", \"tag_2\"] }\n```\n\nThe argument to `add_tactic_doc` is a structure of type `tactic_doc_entry`.\n* `name` refers to the display name of the tactic; it is used as the header of the doc entry.\n* `cat` refers to the category of doc entry.\n  Options: `doc_category.tactic`, `doc_category.cmd`, `doc_category.hole_cmd`, `doc_category.attr`\n* `decl_names` is a list of the declarations associated with this doc. For instance,\n  the entry for `linarith` would set ``decl_names := [`tactic.interactive.linarith]``.\n  Some entries may cover multiple declarations.\n  It is only necessary to list the interactive versions of tactics.\n* `tags` is an optional list of strings used to categorize entries.\n* The doc string is the body of the entry. It can be formatted with markdown.\n  What you are reading now is the description of `add_tactic_doc`.\n\nIf only one related declaration is listed in `decl_names` and if this\ninvocation of `add_tactic_doc` does not have a doc string, the doc string of\nthat declaration will become the body of the tactic doc entry. If there are\nmultiple declarations, you can select the one to be used by passing a name to\nthe `inherit_description_from` field.\n\nIf you prefer a tactic to have a doc string that is different then the doc entry,\nyou should write the doc entry as a doc string for the `add_tactic_doc` invocation.\n\nNote that providing a badly formed `tactic_doc_entry` to the command can result in strange error\nmessages.", "p": "mathlib"}, {"name": "tactic_doc_entry.has_to_string", "description": "", "p": "mathlib"}, {"name": "tactic.add_library_note", "description": "If `note_name` and `note` are strings, `add_library_note note_name note` adds a declaration named\n`library_note.<note_name>` with `note` as the docstring and tags it with the `library_note`\nattribute.", "p": "mathlib"}, {"name": "doc_category.has_to_format", "description": "", "p": "mathlib"}, {"name": "tactic.get_library_notes", "description": " Collects all notes in the current environment.\nReturns a list of pairs `(note_id, note_content)`", "p": "mathlib"}, {"name": "mk_reflected_definition", "description": "`mk_reflected_definition name val` constructs a definition declaration by reflection.\n\nExample: ``mk_reflected_definition `foo 17`` constructs the definition\ndeclaration corresponding to `def foo : \u2115 := 17`", "p": "mathlib"}, {"name": "tactic_doc.tactic.simp", "description": "The `simp` tactic uses lemmas and hypotheses to simplify the main goal target or non-dependent hypotheses. It has many variants.\n\n`simp` simplifies the main goal target using lemmas tagged with the attribute `[simp]`.\n\n`simp [h\u2081 h\u2082 ... h\u2099]` simplifies the main goal target using the lemmas tagged with the attribute `[simp]` and the given `h\u1d62`'s, where the `h\u1d62`'s are expressions. If `h\u1d62` is preceded by left arrow (`\u2190` or `<-`), the simplification is performed in the reverse direction. If an `h\u1d62` is a defined constant `f`, then the equational lemmas associated with `f` are used. This provides a convenient way to unfold `f`.\n\n`simp [*]` simplifies the main goal target using the lemmas tagged with the attribute `[simp]` and all hypotheses.\n\n`simp *` is a shorthand for `simp [*]`.\n\n`simp only [h\u2081 h\u2082 ... h\u2099]` is like `simp [h\u2081 h\u2082 ... h\u2099]` but does not use `[simp]` lemmas\n\n`simp [-id_1, ... -id_n]` simplifies the main goal target using the lemmas tagged with the attribute `[simp]`, but removes the ones named `id\u1d62`.\n\n`simp at h\u2081 h\u2082 ... h\u2099` simplifies the non-dependent hypotheses `h\u2081 : T\u2081` ... `h\u2099 : T\u2099`. The tactic fails if the target or another hypothesis depends on one of them. The token `\u22a2` or `|-` can be added to the list to include the target.\n\n`simp at *` simplifies all the hypotheses and the target.\n\n`simp * at *` simplifies target and all (non-dependent propositional) hypotheses using the other hypotheses.\n\n`simp with attr\u2081 ... attr\u2099` simplifies the main goal target using the lemmas tagged with any of the attributes `[attr\u2081]`, ..., `[attr\u2099]` or `[simp]`.", "p": "mathlib"}, {"name": "tactic_doc_entry.has_reflect", "description": "", "p": "mathlib"}, {"name": "string.hash", "description": "A rudimentary hash function on strings.", "p": "mathlib"}, {"name": "tactic.copy_doc_string", "description": "`copy_doc_string fr to` copies the docstring from the declaration named `fr`\nto each declaration named in the list `to`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.cc (congruence closure)", "description": "The congruence closure tactic `cc` tries to solve the goal by chaining\nequalities from context and applying congruence (i.e. if `a = b`, then `f a = f b`).\nIt is a finishing tactic, i.e. it is meant to close\nthe current goal, not to make some inconclusive progress.\nA mostly trivial example would be:\n\n```lean\nexample (a b c : \u2115) (f : \u2115 \u2192 \u2115) (h: a = b) (h' : b = c) : f a = f c := by cc\n```\n\nAs an example requiring some thinking to do by hand, consider:\n\n```lean\nexample (f : \u2115 \u2192 \u2115) (x : \u2115)\n  (H1 : f (f (f x)) = x) (H2 : f (f (f (f (f x)))) = x) :\n  f x = x :=\nby cc\n```\n\nThe tactic works by building an equality matching graph. It's a graph where\nthe vertices are terms and they are linked by edges if they are known to\nbe equal. Once you've added all the equalities in your context, you take\nthe transitive closure of the graph and, for each connected component\n(i.e. equivalence class) you can elect a term that will represent the\nwhole class and store proofs that the other elements are equal to it.\nYou then take the transitive closure of these equalities under the\ncongruence lemmas.\n\nThe `cc` implementation in Lean does a few more tricks: for example it\nderives `a=b` from `nat.succ a = nat.succ b`, and `nat.succ a !=\nnat.zero` for any `a`.\n\n* The starting reference point is Nelson, Oppen, [Fast decision procedures based on congruence\nclosure](http://www.cs.colorado.edu/~bec/courses/csci5535-s09/reading/nelson-oppen-congruence.pdf),\nJournal of the ACM (1980)\n\n* The congruence lemmas for dependent type theory as used in Lean are described in\n[Congruence closure in intensional type theory](https://leanprover.github.io/papers/congr.pdf)\n(de Moura, Selsam IJCAR 2016).", "p": "mathlib"}, {"name": "tactic_doc_entry.to_json", "description": "Turns a `tactic_doc_entry` into a JSON representation.", "p": "mathlib"}, {"name": "tactic_doc.command.library_note", "description": "At various places in mathlib, we leave implementation notes that are referenced from many other\nfiles. To keep track of these notes, we use the command `library_note`. This makes it easy to\nretrieve a list of all notes, e.g. for documentation output.\n\nThese notes can be referenced in mathlib with the syntax `Note [note id]`.\nOften, these references will be made in code comments (`--`) that won't be displayed in docs.\nIf such a reference is made in a doc string or module doc, it will be linked to the corresponding\nnote in the doc display.\n\nSyntax:\n```lean\n/--\nnote message\n-/\nlibrary_note \"note id\"\n```\n\nAn example from `meta.expr`:\n\n```lean\n/--\nSome declarations work with open expressions, i.e. an expr that has free variables.\nTerms will free variables are not well-typed, and one should not use them in tactics like\n`infer_type` or `unify`. You can still do syntactic analysis/manipulation on them.\nThe reason for working with open types is for performance: instantiating variables requires\niterating through the expression. In one performance test `pi_binders` was more than 6x\nquicker than `mk_local_pis` (when applied to the type of all imported declarations 100x).\n-/\nlibrary_note \"open expressions\"\n```\n\nThis note can be referenced near a usage of `pi_binders`:\n\n\n```lean\n-- See Note [open expressions]\n/-- behavior of f -/\ndef f := pi_binders ...\n```", "p": "mathlib"}, {"name": "tactic_doc_entry", "description": "The information used to generate a tactic doc entry", "p": "mathlib"}, {"name": "tactic_doc_entry.name", "description": "The information used to generate a tactic doc entry", "p": "mathlib"}, {"name": "tactic_doc_entry.category", "description": "The information used to generate a tactic doc entry", "p": "mathlib"}, {"name": "tactic_doc_entry.decl_names", "description": "The information used to generate a tactic doc entry", "p": "mathlib"}, {"name": "tactic_doc_entry.tags", "description": "The information used to generate a tactic doc entry", "p": "mathlib"}, {"name": "tactic_doc_entry.inherit_description_from", "description": "The information used to generate a tactic doc entry", "p": "mathlib"}, {"name": "library_note_attr", "description": " A user attribute `library_note` for tagging decls of type `string \u00d7 string` for use in note\noutput.", "p": "mathlib"}, {"name": "add_tactic_doc_command", "description": "A command used to add documentation for a tactic, command, hole command, or attribute.\n\nUsage: after defining an interactive tactic, command, or attribute,\nadd its documentation as follows.\n```lean\n/--\ndescribe what the command does here\n-/\nadd_tactic_doc\n{ name := \"display name of the tactic\",\n  category := cat,\n  decl_names := [`dcl_1, `dcl_2],\n  tags := [\"tag_1\", \"tag_2\"] }\n```\n\nThe argument to `add_tactic_doc` is a structure of type `tactic_doc_entry`.\n* `name` refers to the display name of the tactic; it is used as the header of the doc entry.\n* `cat` refers to the category of doc entry.\n  Options: `doc_category.tactic`, `doc_category.cmd`, `doc_category.hole_cmd`, `doc_category.attr`\n* `decl_names` is a list of the declarations associated with this doc. For instance,\n  the entry for `linarith` would set ``decl_names := [`tactic.interactive.linarith]``.\n  Some entries may cover multiple declarations.\n  It is only necessary to list the interactive versions of tactics.\n* `tags` is an optional list of strings used to categorize entries.\n* The doc string is the body of the entry. It can be formatted with markdown.\n  What you are reading now is the description of `add_tactic_doc`.\n\nIf only one related declaration is listed in `decl_names` and if this\ninvocation of `add_tactic_doc` does not have a doc string, the doc string of\nthat declaration will become the body of the tactic doc entry. If there are\nmultiple declarations, you can select the one to be used by passing a name to\nthe `inherit_description_from` field.\n\nIf you prefer a tactic to have a doc string that is different then the doc entry,\nyou should write the doc entry as a doc string for the `add_tactic_doc` invocation.\n\nNote that providing a badly formed `tactic_doc_entry` to the command can result in strange error\nmessages.", "p": "mathlib"}, {"name": "copy_doc_string_cmd", "description": "`copy_doc_string source \u2192 target_1 target_2 ... target_n` copies the doc string of the\ndeclaration named `source` to each of `target_1`, `target_2`, ..., `target_n`.", "p": "mathlib"}, {"name": "add_decl_doc_command", "description": "The `add_decl_doc` command is used to add a doc string to an existing declaration.\n\n```lean\ndef foo := 5\n\n/--\nDoc string for foo.\n-/\nadd_decl_doc foo\n```", "p": "mathlib"}, {"name": "tactic_doc.command.copy_doc_string", "description": "`copy_doc_string source \u2192 target_1 target_2 ... target_n` copies the doc string of the\ndeclaration named `source` to each of `target_1`, `target_2`, ..., `target_n`.", "p": "mathlib"}, {"name": "tactic_doc.command.add_decl_doc", "description": "The `add_decl_doc` command is used to add a doc string to an existing declaration.\n\n```lean\ndef foo := 5\n\n/--\nDoc string for foo.\n-/\nadd_decl_doc foo\n```", "p": "mathlib"}, {"name": "tactic_doc_entry_attr", "description": " A user attribute `tactic_doc` for tagging decls of type `tactic_doc_entry`\nfor use in doc output", "p": "mathlib"}, {"name": "tactic.add_tactic_doc", "description": " `add_tactic_doc tde` adds a declaration to the environment\nwith `tde` as its body and tags it with the `tactic_doc`\nattribute. If `tde.decl_names` has exactly one entry `` `decl`` and\nif `tde.description` is the empty string, `add_tactic_doc` uses the doc\nstring of `decl` as the description.", "p": "mathlib"}, {"name": "tactic_doc.tactic.conv", "description": "`conv {...}` allows the user to perform targeted rewriting on a goal or hypothesis,\nby focusing on particular subexpressions.\n\nSee <https://leanprover-community.github.io/extras/conv.html> for more details.\n\nInside `conv` blocks, mathlib currently additionally provides\n* `erw`,\n* `ring`, `ring2` and `ring_exp`,\n* `norm_num`,\n* `norm_cast`,\n* `apply_congr`, and\n* `conv` (within another `conv`).\n\n`apply_congr` applies congruence lemmas to step further inside expressions,\nand sometimes gives better results than the automatically generated\ncongruence lemmas used by `congr`.\n\nUsing `conv` inside a `conv` block allows the user to return to the previous\nstate of the outer `conv` block after it is finished. Thus you can continue\nediting an expression without having to start a new `conv` block and re-scoping\neverything. For example:\n```lean\nexample (a b c d : \u2115) (h\u2081 : b = c) (h\u2082 : a + c = a + d) : a + b = a + d :=\nby conv\n{ to_lhs,\n  conv\n  { congr, skip,\n    rw h\u2081 },\n  rw h\u2082, }\n```\nWithout `conv`, the above example would need to be proved using two successive\n`conv` blocks, each beginning with `to_lhs`.\n\nAlso, as a shorthand, `conv_lhs` and `conv_rhs` are provided, so that\n```lean\nexample : 0 + 0 = 0 :=\nbegin\n  conv_lhs { simp }\nend\n```\njust means\n```lean\nexample : 0 + 0 = 0 :=\nbegin\n  conv { to_lhs, simp }\nend\n```\nand likewise for `to_rhs`.", "p": "mathlib"}, {"name": "doc_category", "description": "The categories of tactic doc entry.", "p": "mathlib"}, {"name": "doc_category.tactic", "description": "The categories of tactic doc entry.", "p": "mathlib"}, {"name": "doc_category.cmd", "description": "The categories of tactic doc entry.", "p": "mathlib"}, {"name": "doc_category.hole_cmd", "description": "The categories of tactic doc entry.", "p": "mathlib"}, {"name": "doc_category.attr", "description": "The categories of tactic doc entry.", "p": "mathlib"}, {"name": "library_note", "description": "A command to add library notes. Syntax:\n```lean\n/--\nnote message\n-/\nlibrary_note \"note id\"\n```", "p": "mathlib"}, {"name": "tactic_doc.command.#html", "description": "Accepts terms with the type `component tactic_state string` or `html empty` and\nrenders them interactively.\nRequires a compatible version of the vscode extension to view the resulting widget.\n\n### Example:\n\n```lean\n/-- A simple counter that can be incremented or decremented with some buttons. -/\nmeta def counter_widget {\u03c0 \u03b1 : Type} : component \u03c0 \u03b1 :=\ncomponent.ignore_props $ component.mk_simple int int 0 (\u03bb _ x y, (x + y, none)) (\u03bb _ s,\n  h \"div\" [] [\n    button \"+\" (1 : int),\n    html.of_string $ to_string $ s,\n    button \"-\" (-1)\n  ]\n)\n\n#html counter_widget\n```", "p": "mathlib"}, {"name": "doc_category.decidable_eq", "description": "", "p": "mathlib"}, {"name": "doc_category.to_string", "description": "Format a `doc_category`", "p": "mathlib"}, {"name": "tactic.get_tactic_doc_entries", "description": "Collects everything in the environment tagged with the attribute `tactic_doc`.", "p": "mathlib"}, {"name": "name.last", "description": "Get the last component of a name, and convert it to a string.", "p": "mathlib"}, {"name": "doc_category.has_reflect", "description": "", "p": "mathlib"}, {"name": "mul_self_le_mul_self_of_le_of_neg_le", "description": "", "p": "mathlib"}, {"name": "one_lt_mul", "description": "**Alias** of `one_lt_mul_of_le_of_lt`.", "p": "mathlib"}, {"name": "monotone.mul_const", "description": "", "p": "mathlib"}, {"name": "mul_self_pos", "description": "", "p": "mathlib"}, {"name": "monotone.const_mul_of_nonpos", "description": "", "p": "mathlib"}, {"name": "strict_anti.const_mul_of_neg", "description": "", "p": "mathlib"}, {"name": "one_lt_mul_of_lt_of_le", "description": "", "p": "mathlib"}, {"name": "ordered_comm_semiring.to_comm_semiring", "description": "", "p": "mathlib"}, {"name": "lt_mul_left", "description": "", "p": "mathlib"}, {"name": "mul_lt_mul_of_neg_left", "description": "", "p": "mathlib"}, {"name": "le_neg_self_iff", "description": "", "p": "mathlib"}, {"name": "strict_mono.mul_const", "description": "", "p": "mathlib"}, {"name": "mul_pos_iff", "description": "", "p": "mathlib"}, {"name": "antitone.const_mul", "description": "", "p": "mathlib"}, {"name": "le_iff_exists_nonneg_add", "description": "", "p": "mathlib"}, {"name": "cmp_mul_pos_left", "description": "", "p": "mathlib"}, {"name": "add_le_mul_of_left_le_right", "description": "", "p": "mathlib"}, {"name": "linear_ordered_semiring", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.add", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.add_assoc", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.zero", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.zero_add", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.add_zero", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.nsmul", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.nsmul_zero'", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.nsmul_succ'", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.add_comm", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.mul", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.left_distrib", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.right_distrib", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.zero_mul", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.mul_zero", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.mul_assoc", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.one", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.one_mul", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.mul_one", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.nat_cast", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.nat_cast_zero", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.nat_cast_succ", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.npow", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.npow_zero'", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.npow_succ'", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.le", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.lt", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.le_refl", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.le_trans", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.lt_iff_le_not_le", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.le_antisymm", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.add_le_add_left", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.le_of_add_le_add_left", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.exists_pair_ne", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.zero_le_one", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.mul_lt_mul_of_pos_left", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.mul_lt_mul_of_pos_right", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.le_total", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.decidable_le", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.decidable_eq", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.decidable_lt", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.max", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.max_def", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.min", "description": " A `linear_ordered_semiring` is a nontrivial semiring with a linear order such that\naddition is monotone and multiplication by a positive number is strictly monotone.", "p": "mathlib"}, {"name": "linear_ordered_semiring.min_def", "de