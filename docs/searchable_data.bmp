p": "mathlib"}, {"name": "lift.subfield_with_hom", "description": " This structure is used to prove the existence of a homomorphism from any algebraic extension\ninto an algebraic closure", "p": "mathlib"}, {"name": "lift.subfield_with_hom.carrier", "description": " This structure is used to prove the existence of a homomorphism from any algebraic extension\ninto an algebraic closure", "p": "mathlib"}, {"name": "lift.subfield_with_hom.emb", "description": " This structure is used to prove the existence of a homomorphism from any algebraic extension\ninto an algebraic closure", "p": "mathlib"}, {"name": "is_alg_closed.splits_codomain", "description": " Every polynomial splits in the field extension `f : K \u2192+* k` if `k` is algebraically closed.\n\nSee also `is_alg_closed.splits_domain` for the case where `K` is algebraically closed.", "p": "mathlib"}, {"name": "lift.subfield_with_hom.maximal_subfield_with_hom_eq_top", "description": "", "p": "mathlib"}, {"name": "is_alg_closed.algebra_map_surjective_of_is_algebraic", "description": "", "p": "mathlib"}, {"name": "lift.subfield_with_hom.compat", "description": "", "p": "mathlib"}, {"name": "is_alg_closed.degree_eq_one_of_irreducible", "description": "", "p": "mathlib"}, {"name": "is_alg_closed.splits_domain", "description": " Every polynomial splits in the field extension `f : K \u2192+* k` if `K` is algebraically closed.\n\nSee also `is_alg_closed.splits_codomain` for the case where `k` is algebraically closed.", "p": "mathlib"}, {"name": "is_alg_closure.of_algebraic", "description": "If `J` is an algebraic extension of `K` and `L` is an algebraic closure of `J`, then it is\n also an algebraic closure of `K`.", "p": "mathlib"}, {"name": "is_alg_closed", "description": " Typeclass for algebraically closed fields.\n\nTo show `polynomial.splits p f` for an arbitrary ring homomorphism `f`,\nsee `is_alg_closed.splits_codomain` and `is_alg_closed.splits_domain`.", "p": "mathlib"}, {"name": "is_alg_closed.splits", "description": " Typeclass for algebraically closed fields.\n\nTo show `polynomial.splits p f` for an arbitrary ring homomorphism `f`,\nsee `is_alg_closed.splits_codomain` and `is_alg_closed.splits_domain`.", "p": "mathlib"}, {"name": "lift.subfield_with_hom.exists_maximal_subfield_with_hom", "description": "", "p": "mathlib"}, {"name": "is_alg_closed.exists_eq_mul_self", "description": "", "p": "mathlib"}, {"name": "is_alg_closure.separable", "description": "", "p": "mathlib"}, {"name": "is_alg_closed.perfect_ring", "description": "", "p": "mathlib"}, {"name": "is_alg_closure.equiv_of_algebraic", "description": "A (random) isomorphism between an algebraic closure of `K` and an algebraic closure\n of an algebraic extension of `K`", "p": "mathlib"}, {"name": "lift.subfield_with_hom.le_def", "description": "", "p": "mathlib"}, {"name": "is_alg_closed.algebra_map_surjective_of_is_integral", "description": "", "p": "mathlib"}, {"name": "lift.subfield_with_hom.maximal_subfield_with_hom_chain_bounded", "description": "", "p": "mathlib"}, {"name": "is_alg_closure.equiv_of_equiv_symm_algebra_map", "description": "", "p": "mathlib"}, {"name": "is_alg_closure.equiv_of_equiv_comp_algebra_map", "description": "", "p": "mathlib"}, {"name": "is_alg_closure.equiv_of_equiv_algebra_map", "description": "", "p": "mathlib"}, {"name": "is_alg_closed.exists_aeval_eq_zero_of_injective", "description": "", "p": "mathlib"}, {"name": "lift.subfield_with_hom.inhabited", "description": "", "p": "mathlib"}, {"name": "is_alg_closure", "description": "Typeclass for an extension being an algebraic closure.", "p": "mathlib"}, {"name": "is_alg_closure.alg_closed", "description": "Typeclass for an extension being an algebraic closure.", "p": "mathlib"}, {"name": "is_alg_closure.algebraic", "description": "Typeclass for an extension being an algebraic closure.", "p": "mathlib"}, {"name": "is_alg_closure.equiv", "description": "A (random) isomorphism between two algebraic closures of `R`.", "p": "mathlib"},