_map", "description": "", "p": "mathlib"}, {"name": "finset.inj_on_of_card_image_eq", "description": "", "p": "mathlib"}, {"name": "finset.card_def", "description": "", "p": "mathlib"}, {"name": "finset.exists_ne_map_eq_of_card_lt_of_maps_to", "description": "If there are more pigeons than pigeonholes, then there are two pigeons in the same pigeonhole.", "p": "mathlib"}, {"name": "finset.card_union_le", "description": "", "p": "mathlib"}, {"name": "finset.card_le_card_sdiff_add_card", "description": "", "p": "mathlib"}, {"name": "finset.card_congr", "description": "", "p": "mathlib"}, {"name": "multiset.card_to_finset", "description": "", "p": "mathlib"}, {"name": "finset.card_val", "description": "", "p": "mathlib"}, {"name": "finset.card_disj_union", "description": "", "p": "mathlib"}, {"name": "finset.eq_of_superset_of_card_ge", "description": "", "p": "mathlib"}, {"name": "list.to_finset_card_of_nodup", "description": "", "p": "mathlib"}, {"name": "finset.strong_downward_induction", "description": " Suppose that, given that `p t` can be defined on all supersets of `s` of cardinality less than\n`n`, one knows how to define `p s`. Then one can inductively define `p s` for all finsets `s` of\ncardinality less than `n`, starting from finsets of card `n` and iterating. This\ncan be used either to define data, or to prove properties.", "p": "mathlib"}, {"name": "finset.card_singleton", "description": "", "p": "mathlib"}, {"name": "finset.card_inter_add_card_union", "description": "", "p": "mathlib"}, {"name": "finset.card_eq_succ", "description": "", "p": "mathlib"}, {"name": "finset.exists_mem_ne", "description": "", "p": "mathlib"}, {"name": "finset.filter_card_eq", "description": "", "p": "mathlib"}, {"name": "finset.strong_induction", "description": " Suppose that, given objects defined on all strict subsets of any finset `s`, one knows how to\ndefine an object on `s`. Then one can inductively define an object on all finsets, starting from\nthe empty set and iterating. This can be used either to define data, or to prove properties.", "p": "mathlib"}, {"name": "finset.card_erase_lt_of_mem", "description": "", "p": "mathlib"}, {"name": "finset.card_image_iff", "description": "", "p": "mathlib"}, {"name": "neg_lt_of_abs_lt", "description": "", "p": "mathlib"}, {"name": "abs_sub_lt_iff", "description": "", "p": "mathlib"}, {"name": "abs_nonpos_iff", "description": "", "p": "mathlib"}, {"name": "abs_add_three", "description": "", "p": "mathlib"}, {"name": "abs_of_pos", "description": "", "p": "mathlib"}, {"name": "apply_abs_le_add_of_nonneg", "description": "", "p": "mathlib"}, {"name": "abs_sub_le", "description": "", "p": "mathlib"}, {"name": "apply_abs_le_mul_of_one_le'", "description": "", "p": "mathlib"}, {"name": "neg_le_abs_self", "description": "", "p": "mathlib"}, {"name": "abs_pos", "description": "", "p": "mathlib"}, {"name": "abs_eq_zero", "description": "", "p": "mathlib"}, {"name": "add_abs_nonneg", "description": "", "p": "mathlib"}, {"name": "abs_le'", "description": "", "p": "mathlib"}, {"name": "sub_le_of_abs_sub_le_left", "description": "", "p": "mathlib"}, {"name": "abs_le_max_abs_abs", "description": "", "p": "mathlib"}, {"name": "neg_le_of_abs_le", "description": "", "p": "mathlib"}, {"name": "abs_eq_max_neg", "description": "", "p": "mathlib"}, {"name": "abs_max_le_max_abs_abs", "description": "", "p": "mathlib"}, {"name": "max_sub_min_eq_abs'", "description": "", "p": "mathlib"}, {"name": "le_abs", "description": "", "p": "mathlib"}, {"name": "le_of_abs_le", "description": "", "p": "mathlib"}, {"name": "sub_lt_of_abs_sub_lt_right", "description": "", "p": "mathlib"}, {"name": "min_abs_abs_le_abs_max", "description": "", "p": "mathlib"}, {"name": "abs_lt", "description": "", "p": "mathlib"}, {"name": "abs_add", "description": "The **triangle inequality** in `linear_ordered_add_comm_group`s.", "p": "mathlib"}, {"name": "abs_nonneg", "description": "", "p": "mathlib"}, {"name": "min_abs_abs_le_abs_min", "description": "", "p": "mathlib"}, {"name": "abs_min_le_max_abs_abs", "description": "", "p": "mathlib"}, {"name": "abs_of_neg", "description": "", "p": "mathlib"}, {"name": "has_neg.to_has_abs", "description": "`abs a` is the absolute value of `a`", "p": "mathlib"}, {"name": "abs_eq_sup_inv", "description": "", "p": "mathlib"}, {"name": "lt_abs", "description": "", "p": "mathlib"}, {"name": "neg_abs_le_neg", "description": "", "p": "mathlib"}, {"name": "abs_neg", "description": "", "p": "mathlib"}, {"name": "sub_lt_of_abs_sub_lt_left", "description": "", "p": "mathlib"}, {"name": "has_inv.to_has_abs", "description": "`abs a` is the absolute value of `a`.", "p": "mathlib"}, {"name": "abs_eq", "description": "", "p": "mathlib"}, {"name": "abs_le_abs_of_nonpos", "description": "", "p": "mathlib"}, {"name": "abs_zero", "description": "", "p": "mathlib"}, {"name": "max_sub_min_eq_abs", "description": "", "p": "mathlib"}, {"name": "eq_or_eq_neg_of_abs_eq", "description": "", "p": "mathlib"}, {"name": "abs_choice", "description": "", "p": "mathlib"}, {"name": "abs_pos_of_neg", "description": "", "p": "mathlib"}, {"name": "le_abs_self", "description": "", "p": "mathlib"}, {"name": "abs_add'", "description": "", "p": "mathlib"}, {"name": "abs_of_nonneg", "description": "", "p": "mathlib"}, {"name": "sub_le_of_abs_sub_le_right", "description": "", "p": "mathlib"}, {"name": "abs_by_cases", "description": "", "p": "mathlib"}, {"name": "abs_abs", "description": "", "p": "mathlib"}, {"name": "abs_le_abs_of_nonneg", "description": "", "p": "mathlib"}, {"name": "abs_pos_of_pos", "description": "", "p": "mathlib"}, {"name": "eq_of_abs_sub_eq_zero", "description": "", "p": "mathlib"}, {"name": "dist_bdd_within_interval", "description": "", "p": "mathlib"}, {"name": "apply_abs_le_add_of_nonneg'", "description": "", "p": "mathlib"}, {"name": "abs_sub_comm", "description": "", "p": "mathlib"}, {"name": "apply_abs_le_mul_of_one_le", "description": "", "p": "mathlib"}, {"name": "abs_sub", "description": "", "p": "mathlib"}, {"name": "le_abs'", "description": "", "p": "mathlib"}, {"name": "abs_sub_le_iff", "description": "", "p": "mathlib"}, {"name": "abs_abs_sub_abs_le_abs_sub", "description": "", "p": "mathlib"}, {"name": "abs_eq_sup_neg", "description": "", "p": "mathlib"}, {"name": "abs_le_abs", "description": "", "p": "mathlib"}, {"name": "abs_sub_abs_le_abs_sub", "description": "", "p": "mathlib"}, {"name": "abs_eq_abs", "description": "", "p": "mathlib"}, {"name": "neg_abs_le_self", "description": "", "p": "mathlib"}, {"name": "abs_le", "description": "", "p": "mathlib"}, {"name": "lt_of_abs_lt", "description": "", "p": "mathlib"}, {"name": "eq_of_abs_sub_nonpos", "description": "", "p": "mathlib"}, {"name": "abs_of_nonpos", "description": "", "p": "mathlib"}, {"name": "multiset.range_disjoint_map_add", "description": "", "p": "mathlib"}, {"name": "multiset.self_mem_range_succ", "description": "", "p": "mathlib"}, {"name": "multiset.range_add_eq_union", "description": "", "p": "mathlib"}, {"name": "multiset.not_mem_range_self", "description": "", "p": "mathlib"}, {"name": "multiset.range", "description": "`range n` is the multiset lifted from the list `range n`,\n that is, the set `{0, 1, ..., n-1}`.", "p": "mathlib"}, {"name": "multiset.range_zero", "description": "", "p": "mathlib"}, {"name": "multiset.mem_range", "description": "", "p": "mathlib"}, {"name": "multiset.coe_range", "description": "", "p": "mathlib"}, {"name": "multiset.range_add", "description": "", "p": "mathlib"}, {"name": "multiset.range_succ", "description": "", "p": "mathlib"}, {"name": "multiset.card_range", "description": "", "p": "mathlib"}, {"name": "multiset.range_subset", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.op_map_id_obj", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.inf_le_left", "description": "The inclusion `U \u2293 V \u27f6 U` as a morphism in the category of open sets.", "p": "mathlib"}, {"name": "topological_space.open_nhds.inclusion_map_iso", "description": " `opens.map f` and `open_nhds.map f` form a commuting square (up to natural isomorphism)\nwith the inclusion functors into `opens X`.", "p": "mathlib"}, {"name": "topological_space.open_nhds.inhabited", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.map_obj", "description": "", "p": "mathlib"}, {"name": "is_open_map.adjunction_nhds", "description": "An open map `f : X \u27f6 Y` induces an adjunction between `open_nhds x` and `open_nhds (f x)`.", "p": "mathlib"}, {"name": "is_open_map.functor_nhds_map", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.order_top", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.open_nhds_category", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.inclusion_map_iso_inv", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.open_embedding", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.partial_order", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.map_id_obj'", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds", "description": "The type of open neighbourhoods of a point `x` in a (bundled) topological space.", "p": "mathlib"}, {"name": "topological_space.open_nhds.map", "description": "The preimage functor from neighborhoods of `f x` to neighborhoods of `x`.", "p": "mathlib"}, {"name": "topological_space.open_nhds.lattice", "description": "", "p": "mathlib"}, {"name": "is_open_map.functor_nhds", "description": "An open map `f : X \u27f6 Y` induces a functor `open_nhds x \u2964 open_nhds (f x)`.", "p": "mathlib"}, {"name": "topological_space.open_nhds.opens_nhds_hom_has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.inf_le_right", "description": "The inclusion `U \u2293 V \u27f6 V` as a morphism in the category of open sets.", "p": "mathlib"}, {"name": "is_open_map.functor_nhds_obj_obj", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.inclusion", "description": " The inclusion functor from open neighbourhoods of `x`\nto open sets in the ambient topological space.", "p": "mathlib"}, {"name": "topological_space.open_nhds.inclusion_map_iso_hom", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.map_id_obj", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.inclusion_obj", "description": "", "p": "mathlib"}, {"name": "topological_space.open_nhds.map_id_obj_unop", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.equivalence_self_of_has_finite_biproducts_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.iso_biproduct_embedding", "description": "Every object in `Mat_ C` is isomorphic to the biproduct of its summands.", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding_obj_X", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.equivalence_single_obj_inverse", "description": "Auxiliary definition for `category_theory.Mat.equivalence_single_obj`.", "p": "mathlib"}, {"name": "category_theory.Mat.equivalence_single_obj_inverse.category_theory.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.equivalence_single_obj_inverse.category_theory.ess_surj", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding_obj_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.equivalence_single_obj_inverse_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding_map", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.category_theory.preadditive", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.id_apply_self", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.id_apply_of_ne", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.hom.id", "description": "The identity matrix consists of identity morphisms on the diagonal, and zeros elsewhere.", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat_id_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.equivalence_self_of_has_finite_biproducts_aux", "description": "Natural isomorphism needed in the construction of `equivalence_self_of_has_finite_biproducts`.", "p": "mathlib"}, {"name": "category_theory.Mat.equivalence_single_obj_inverse_map", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.lift_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.id_def", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat_id", "description": "The identity functor induces the identity functor on matrix categories.", "p": "mathlib"}, {"name": "category_theory.Mat.id_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat_id_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat_comp_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.iso_biproduct_embedding_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.equivalence_single_obj_inverse.category_theory.full", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.hom.comp", "description": "Composition of matrices using matrix multiplication.", "p": "mathlib"}, {"name": "category_theory.Mat", "description": " A type synonym for `Fintype`, which we will equip with a category structure\nwhere the morphisms are matrices with components in `R`.", "p": "mathlib"}, {"name": "category_theory.Mat_.equivalence_self_of_has_finite_biproducts", "description": "A preadditive category that already has finite biproducts is equivalent to its additive envelope.\n\nNote that we only prove this for a large category;\notherwise there are universe issues that I haven't attempted to sort out.", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding_obj_F", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.quiver.hom.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat__obj_X", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat_comp", "description": "Composite functors induce composite functors on matrix categories.", "p": "mathlib"}, {"name": "category_theory.Mat_.comp_def", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat__map", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.has_finite_biproducts", "description": "We now prove that `Mat_ C` has finite biproducts.\n\nBe warned, however, that `Mat_ C` is not necessarily Krull-Schmidt,\nand so the internal indexing of a biproduct may have nothing to do with the external indexing,\neven though the construction we give uses a sigma type.\nSee however `iso_biproduct_embedding`.", "p": "mathlib"}, {"name": "category_theory.Mat_.iso_biproduct_embedding_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.category_theory.category", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding_lift_iso", "description": "An additive functor `C \u2964 D` factors through its lift to `Mat_ C \u2964 D`.", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding", "description": " The embedding of `C` into `Mat_ C` as one-by-one matrices.\n(We index the summands by `punit`.)", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding_lift_iso_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.additive_obj_iso_biproduct_naturality'", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.quiver.hom.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.id_apply_of_ne", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.lift", "description": " Any additive functor `C \u2964 D` to a category `D` with finite biproducts extends to\na functor `Mat_ C \u2964 D`.", "p": "mathlib"}, {"name": "category_theory.Mat_.hom", "description": "A morphism in `Mat_ C` is a dependently typed matrix of morphisms.", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat__obj_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.additive_obj_iso_biproduct", "description": "Every `M` is a direct sum of objects from `C`, and `F` preserves biproducts.", "p": "mathlib"}, {"name": "category_theory.Mat.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding_lift_iso_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat__obj_F", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.id_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.lift_additive", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.lift_map", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.id_def", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.additive_obj_iso_biproduct_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding.category_theory.full", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.category", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.add_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding.category_theory.functor.additive", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.lift_unique", "description": "`Mat_.lift F` is the unique additive functor `L : Mat_ C \u2964 D` such that `F \u2245 embedding C \u22d9 L`.", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat_", "description": "A functor induces a functor of matrix categories.", "p": "mathlib"}, {"name": "category_theory.Mat_.comp_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.equivalence_self_of_has_finite_biproducts_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.additive_obj_iso_biproduct_naturality'_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.comp_def", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.ext", "description": " Two additive functors `Mat_ C \u2964 D` are naturally isomorphic if\ntheir precompositions with `embedding C` are naturally isomorphic as functors `C \u2964 D`.", "p": "mathlib"}, {"name": "category_theory.Mat_.id_apply_self", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_", "description": "An object in `Mat_ C` is a finite tuple of objects in `C`.", "p": "mathlib"}, {"name": "category_theory.Mat_.\u03b9", "description": "An object in `Mat_ C` is a finite tuple of objects in `C`.", "p": "mathlib"}, {"name": "category_theory.Mat_.F", "description": "An object in `Mat_ C` is a finite tuple of objects in `C`.", "p": "mathlib"}, {"name": "category_theory.Mat_.X", "description": "An object in `Mat_ C` is a finite tuple of objects in `C`.", "p": "mathlib"}, {"name": "category_theory.Mat.category_theory.preadditive", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.comp_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.additive_obj_iso_biproduct_naturality_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.embedding.category_theory.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.additive_obj_iso_biproduct_naturality", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat_.additive_obj_iso_biproduct_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.Mat.equivalence_single_obj", "description": " The categorical equivalence between the category of matrices over a ring,\nand the category of matrices over that ring considered as a single-object category.", "p": "mathlib"}, {"name": "category_theory.functor.map_Mat_comp_inv_app", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.exists_is_basis_integral", "description": " If `L` is a finite extension of `K = Frac(A)`,\nthen `L` has a basis over `A` consisting of integral elements.", "p": "mathlib"}, {"name": "is_integral_closure.rank", "description": "", "p": "mathlib"}, {"name": "integral_closure.is_noetherian_ring", "description": "", "p": "mathlib"}, {"name": "is_integral_closure.is_dedekind_domain", "description": "", "p": "mathlib"}, {"name": "exists_integral_multiples", "description": " Send a set of `x`'es in a finite extension `L` of the fraction field of `R`\nto `(y : R) \u2022 x \u2208 integral_closure R L`.", "p": "mathlib"}, {"name": "is_integral_closure.is_noetherian", "description": "", "p": "mathlib"}, {"name": "integral_closure_le_span_dual_basis", "description": "", "p": "mathlib"}, {"name": "is_integral_closure.is_localization", "description": "", "p": "mathlib"}, {"name": "is_integral_closure.module_free", "description": "", "p": "mathlib"}, {"name": "is_integral_closure.is_noetherian_ring", "description": "", "p": "mathlib"}, {"name": "integral_closure.is_dedekind_domain_fraction_ring", "description": "", "p": "mathlib"}, {"name": "is_integral_closure.range_le_span_dual_basis", "description": "", "p": "mathlib"}, {"name": "integral_closure.is_dedekind_domain", "description": "", "p": "mathlib"}, {"name": "exp_neg_inv_glue", "description": " `exp_neg_inv_glue` is the real function given by `x \u21a6 exp (-1/x)` for `x > 0` and `0`\nfor `x \u2264 0`. It is a basic building block to construct smooth partitions of unity. Its main property\nis that it vanishes for `x \u2264 0`, it is positive for `x > 0`, and the junction between the two\nbehaviors is flat enough to retain smoothness. The fact that this function is `C^\u221e` is proved in\n`exp_neg_inv_glue.smooth`.", "p": "mathlib"}, {"name": "cont_diff_bump.nonneg_normed", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.lt_one_of_lt_one", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.sub", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "some_cont_diff_bump_base", "description": " In a space with `C^\u221e` bump functions, register some function that will be used as a basis\nto construct bump functions of arbitrary size around any point.", "p": "mathlib"}, {"name": "cont_diff_bump.neg", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.pos_denom", "description": "", "p": "mathlib"}, {"name": "exp_neg_inv_glue.P_aux", "description": " Our goal is to prove that `exp_neg_inv_glue` is `C^\u221e`. For this, we compute its successive\nderivatives for `x > 0`. The `n`-th derivative is of the form `P_aux n (x) exp(-1/x) / x^(2 n)`,\nwhere `P_aux n` is computed inductively.", "p": "mathlib"}, {"name": "cont_diff_bump.tsupport_eq", "description": "", "p": "mathlib"}, {"name": "exp_neg_inv_glue.f_aux_deriv_zero", "description": " Deduce from the limiting behavior at `0` of its derivative and general differentiability\nextension theorems that the auxiliary function `f_aux n` is differentiable at `0`,\nwith derivative `0`.", "p": "mathlib"}, {"name": "cont_diff_bump.pos_of_mem_ball", "description": "", "p": "mathlib"}, {"name": "exp_neg_inv_glue.cont_diff", "description": "The function `exp_neg_inv_glue` is smooth.", "p": "mathlib"}, {"name": "cont_diff_bump.one_of_mem_closed_ball", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.continuous_at", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.zero", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.normed_sub", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.one", "description": "", "p": "mathlib"}, {"name": "exp_neg_inv_glue.zero_of_nonpos", "description": "The function `exp_neg_inv_glue` vanishes on `(-\u221e, 0]`.", "p": "mathlib"}, {"name": "cont_diff_bump.zero_of_le_dist", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.integrable_normed", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.R_pos", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.eventually_eq_one", "description": "", "p": "mathlib"}, {"name": "has_cont_diff_bump_of_inner_product_space", "description": "Any inner product space has smooth bump functions.", "p": "mathlib"}, {"name": "cont_diff_bump.to_fun", "description": " The function defined by `f : cont_diff_bump c`. Use automatic coercion to\nfunction instead.", "p": "mathlib"}, {"name": "cont_diff_bump.integral_pos", "description": "", "p": "mathlib"}, {"name": "has_cont_diff_bump", "description": " A class registering that a real vector space admits bump functions. This will be instantiated\nfirst for inner product spaces, and then for finite-dimensional normed spaces.\nWe use a specific class instead of `nonempty (cont_diff_bump_base E)` for performance reasons.", "p": "mathlib"}, {"name": "has_cont_diff_bump.out", "description": " A class registering that a real vector space admits bump functions. This will be instantiated\nfirst for inner product spaces, and then for finite-dimensional normed spaces.\nWe use a specific class instead of `nonempty (cont_diff_bump_base E)` for performance reasons.", "p": "mathlib"}, {"name": "cont_diff_bump.inhabited", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.tendsto_support_normed_small_sets", "description": "", "p": "mathlib"}, {"name": "exp_neg_inv_glue.f_aux_limit", "description": " To get differentiability at `0` of the auxiliary functions, we need to know that their limit\nis `0`, to be able to apply general differentiability extension theorems. This limit is checked in\nthis lemma.", "p": "mathlib"}, {"name": "cont_diff_bump.def", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.integrable", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.nonneg'", "description": "A version of `cont_diff_bump.nonneg` with `x` explicit", "p": "mathlib"}, {"name": "cont_diff_bump.normed", "description": "A bump function normed so that `\u222b x, f.normed \u03bc x \u2202\u03bc = 1`.", "p": "mathlib"}, {"name": "exp_neg_inv_glue.pos_of_pos", "description": "The function `exp_neg_inv_glue` is positive on `(0, +\u221e)`.", "p": "mathlib"}, {"name": "exp_neg_inv_glue.f_aux_deriv_pos", "description": " For positive values, the derivative of the `n`-th auxiliary function `f_aux n`\nis the `n+1`-th auxiliary function.", "p": "mathlib"}, {"name": "exp_neg_inv_glue.f_aux", "description": "Formula for the `n`-th derivative of `exp_neg_inv_glue`, as an auxiliary function `f_aux`.", "p": "mathlib"}, {"name": "real.smooth_transition.nonneg", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition", "description": " An infinitely smooth function `f : \u211d \u2192 \u211d` such that `f x = 0` for `x \u2264 0`,\n`f x = 1` for `1 \u2264 x`, and `0 < f x < 1` for `0 < x < 1`.", "p": "mathlib"}, {"name": "cont_diff_bump.one_lt_R_div_r", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.tsupport_normed_eq", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump_base", "description": " The base function from which one will construct a family of bump functions. One could\nadd more properties if they are useful and satisfied in the examples of inner product spaces\nand finite dimensional vector spaces, notably derivative norm control in terms of `R - 1`.", "p": "mathlib"}, {"name": "cont_diff_bump_base.to_fun", "description": " The base function from which one will construct a family of bump functions. One could\nadd more properties if they are useful and satisfied in the examples of inner product spaces\nand finite dimensional vector spaces, notably derivative norm control in terms of `R - 1`.", "p": "mathlib"}, {"name": "cont_diff_bump_base.mem_Icc", "description": " The base function from which one will construct a family of bump functions. One could\nadd more properties if they are useful and satisfied in the examples of inner product spaces\nand finite dimensional vector spaces, notably derivative norm control in terms of `R - 1`.", "p": "mathlib"}, {"name": "cont_diff_bump_base.symmetric", "description": " The base function from which one will construct a family of bump functions. One could\nadd more properties if they are useful and satisfied in the examples of inner product spaces\nand finite dimensional vector spaces, notably derivative norm control in terms of `R - 1`.", "p": "mathlib"}, {"name": "cont_diff_bump_base.smooth", "description": " The base function from which one will construct a family of bump functions. One could\nadd more properties if they are useful and satisfied in the examples of inner product spaces\nand finite dimensional vector spaces, notably derivative norm control in terms of `R - 1`.", "p": "mathlib"}, {"name": "cont_diff_bump_base.eq_one", "description": " The base function from which one will construct a family of bump functions. One could\nadd more properties if they are useful and satisfied in the examples of inner product spaces\nand finite dimensional vector spaces, notably derivative norm control in terms of `R - 1`.", "p": "mathlib"}, {"name": "cont_diff_bump_base.support", "description": " The base function from which one will construct a family of bump functions. One could\nadd more properties if they are useful and satisfied in the examples of inner product spaces\nand finite dimensional vector spaces, notably derivative norm control in terms of `R - 1`.", "p": "mathlib"}, {"name": "cont_diff_bump.support_normed_eq", "description": "", "p": "mathlib"}, {"name": "exp_neg_inv_glue.f_aux_iterated_deriv", "description": " The successive derivatives of the auxiliary function `f_aux 0` are the\nfunctions `f_aux n`, by induction.", "p": "mathlib"}, {"name": "exp_neg_inv_glue.f_aux_deriv", "description": " For positive values, the derivative of the `n`-th auxiliary function `f_aux n`\n(given in this statement in unfolded form) is the `n+1`-th auxiliary function, since\nthe polynomial `P_aux (n+1)` was chosen precisely to ensure this.", "p": "mathlib"}, {"name": "cont_diff_bump.has_compact_support", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.cont_diff", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.cont_diff_at", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.normed_def", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.pos_of_pos", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.eventually_eq_one_of_mem_ball", "description": "", "p": "mathlib"}, {"name": "cont_diff.cont_diff_bump", "description": "", "p": "mathlib"}, {"name": "cont_diff_at.cont_diff_bump", "description": "`cont_diff_bump` is `\ud835\udc9e\u207f` in all its arguments.", "p": "mathlib"}, {"name": "exp_neg_inv_glue.nonneg", "description": "The function exp_neg_inv_glue` is nonnegative.", "p": "mathlib"}, {"name": "cont_diff_bump.continuous", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.cont_diff_at", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.le_one", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.normed_neg", "description": "", "p": "mathlib"}, {"name": "exp_neg_inv_glue.f_aux_has_deriv_at", "description": " At every point, the auxiliary function `f_aux n` has a derivative which is\nequal to `f_aux (n+1)`.", "p": "mathlib"}, {"name": "cont_diff_bump.nonneg", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.integral_normed_smul", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.cont_diff_normed", "description": "", "p": "mathlib"}, {"name": "exp_neg_inv_glue.f_aux_zero_eq", "description": "The `0`-th auxiliary function `f_aux 0` coincides with `exp_neg_inv_glue`, by definition.", "p": "mathlib"}, {"name": "real.smooth_transition.proj_Icc", "description": " Since `real.smooth_transition` is constant on $(-\u221e, 0]$ and $[1, \u221e)$, applying it to the\nprojection of `x : \u211d` to $[0, 1]$ gives the same result as applying it to `x`.", "p": "mathlib"}, {"name": "cont_diff_bump", "description": " `f : cont_diff_bump c`, where `c` is a point in a normed vector space, is a\nbundled smooth function such that\n\n- `f` is equal to `1` in `metric.closed_ball c f.r`;\n- `support f = metric.ball c f.R`;\n- `0 \u2264 f x \u2264 1` for all `x`.\n\nThe structure `cont_diff_bump` contains the data required to construct the function:\nreal numbers `r`, `R`, and proofs of `0 < r < R`. The function itself is available through\n`coe_fn` when the space is nice enough, i.e., satisfies the `has_cont_diff_bump` typeclass.", "p": "mathlib"}, {"name": "cont_diff_bump.r", "description": " `f : cont_diff_bump c`, where `c` is a point in a normed vector space, is a\nbundled smooth function such that\n\n- `f` is equal to `1` in `metric.closed_ball c f.r`;\n- `support f = metric.ball c f.R`;\n- `0 \u2264 f x \u2264 1` for all `x`.\n\nThe structure `cont_diff_bump` contains the data required to construct the function:\nreal numbers `r`, `R`, and proofs of `0 < r < R`. The function itself is available through\n`coe_fn` when the space is nice enough, i.e., satisfies the `has_cont_diff_bump` typeclass.", "p": "mathlib"}, {"name": "cont_diff_bump.R", "description": " `f : cont_diff_bump c`, where `c` is a point in a normed vector space, is a\nbundled smooth function such that\n\n- `f` is equal to `1` in `metric.closed_ball c f.r`;\n- `support f = metric.ball c f.R`;\n- `0 \u2264 f x \u2264 1` for all `x`.\n\nThe structure `cont_diff_bump` contains the data required to construct the function:\nreal numbers `r`, `R`, and proofs of `0 < r < R`. The function itself is available through\n`coe_fn` when the space is nice enough, i.e., satisfies the `has_cont_diff_bump` typeclass.", "p": "mathlib"}, {"name": "cont_diff_bump.r_pos", "description": " `f : cont_diff_bump c`, where `c` is a point in a normed vector space, is a\nbundled smooth function such that\n\n- `f` is equal to `1` in `metric.closed_ball c f.r`;\n- `support f = metric.ball c f.R`;\n- `0 \u2264 f x \u2264 1` for all `x`.\n\nThe structure `cont_diff_bump` contains the data required to construct the function:\nreal numbers `r`, `R`, and proofs of `0 < r < R`. The function itself is available through\n`coe_fn` when the space is nice enough, i.e., satisfies the `has_cont_diff_bump` typeclass.", "p": "mathlib"}, {"name": "cont_diff_bump.r_lt_R", "description": " `f : cont_diff_bump c`, where `c` is a point in a normed vector space, is a\nbundled smooth function such that\n\n- `f` is equal to `1` in `metric.closed_ball c f.r`;\n- `support f = metric.ball c f.R`;\n- `0 \u2264 f x \u2264 1` for all `x`.\n\nThe structure `cont_diff_bump` contains the data required to construct the function:\nreal numbers `r`, `R`, and proofs of `0 < r < R`. The function itself is available through\n`coe_fn` when the space is nice enough, i.e., satisfies the `has_cont_diff_bump` typeclass.", "p": "mathlib"}, {"name": "cont_diff_bump.support_eq", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.cont_diff_within_at", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.zero_of_nonpos", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.continuous_normed", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.integral_normed", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.continuous", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.has_compact_support_normed", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.le_one", "description": "", "p": "mathlib"}, {"name": "cont_diff_bump.cont_diff", "description": "", "p": "mathlib"}, {"name": "real.smooth_transition.one_of_one_le", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.\u0393_obj", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.base_is_iso_of_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_presheaf_map_f", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_presheaf_map_c", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.quiver.hom.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.comp", "description": "Composition of morphisms of `PresheafedSpace`s.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.to_restrict_top", "description": "The map to the restriction of a presheafed space along the canonical inclusion from the top\nsubspace.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.hom_inhabited", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace", "description": "A `PresheafedSpace C` is a topological space equipped with a presheaf of `C`s.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.carrier", "description": "A `PresheafedSpace C` is a topological space equipped with a presheaf of `C`s.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.presheaf", "description": "A `PresheafedSpace C` is a topological space equipped with a presheaf of `C`s.", "p": "mathlib"}, {"name": "category_theory.functor.map_presheaf_obj_presheaf", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.comp_c_app", "description": " Sometimes rewriting with `comp_c_app` doesn't work because of dependent type issues.\nIn that case, `erw comp_c_app_assoc` might make progress.\nThe lemma `comp_c_app_assoc` is also better suited for rewrites in the opposite direction.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.restrict_top_presheaf", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_presheaf", "description": "We can apply a functor `F : C \u2964 D` to the values of the presheaf in any `PresheafedSpace C`,\n   giving a functor `PresheafedSpace C \u2964 PresheafedSpace D`", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.sheaf_iso_of_iso_hom", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.\u0393_map", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.\u0393", "description": "The global sections, notated Gamma.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.topological_space", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.category_of_PresheafedSpaces", "description": "The category of PresheafedSpaces. Morphisms are pairs, a continuous map and a presheaf map\n   from the presheaf on the target to the pushforward of the presheaf on the source.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.of_restrict", "description": "The map from the restriction of a presheafed space.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.ext", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.const", "description": "The constant presheaf on `X` with value `Z`.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.sheaf_iso_of_iso", "description": "Isomorphic PresheafedSpaces have natural isomorphic presheaves.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.forget_obj", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.restrict_top_iso", "description": "The isomorphism from the restriction to the top subspace.", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.\u0393_map_op", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.comp_c", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpace.inhabited", "description": "", "p": "mathlib"}, {"name": "algebraic_geometry.PresheafedSpac