: "category_theory.cokernel_unop_unop", "description": "The cokernel of `g.unop` is the opposite of `kernel g`.", "p": "mathlib"}, {"name": "bifunctor.snd_comp_snd", "description": "", "p": "mathlib"}, {"name": "bifunctor.snd_comp_fst", "description": "", "p": "mathlib"}, {"name": "bifunctor.functor", "description": "", "p": "mathlib"}, {"name": "bifunctor.is_lawful_functor", "description": "", "p": "mathlib"}, {"name": "bifunctor.fst", "description": "Left map of a bifunctor.", "p": "mathlib"}, {"name": "bifunctor.snd_id", "description": "", "p": "mathlib"}, {"name": "is_lawful_bifunctor.bimap_id_id", "description": "", "p": "mathlib"}, {"name": "sum.is_lawful_bifunctor", "description": "", "p": "mathlib"}, {"name": "bifunctor", "description": "Lawless bifunctor. This typeclass only holds the data for the bimap.", "p": "mathlib"}, {"name": "bifunctor.bimap", "description": "Lawless bifunctor. This typeclass only holds the data for the bimap.", "p": "mathlib"}, {"name": "function.bicompr.bifunctor", "description": "", "p": "mathlib"}, {"name": "bifunctor.fst_snd", "description": "", "p": "mathlib"}, {"name": "bifunctor.fst_comp_snd", "description": "", "p": "mathlib"}, {"name": "sum.bifunctor", "description": "", "p": "mathlib"}, {"name": "bifunctor.id_snd", "description": "", "p": "mathlib"}, {"name": "is_lawful_bifunctor", "description": "Bifunctor. This typeclass asserts that a lawless `bifunctor` is lawful.", "p": "mathlib"}, {"name": "is_lawful_bifunctor.id_bimap", "description": "Bifunctor. This typeclass asserts that a lawless `bifunctor` is lawful.", "p": "mathlib"}, {"name": "is_lawful_bifunctor.bimap_bimap", "description": "Bifunctor. This typeclass asserts that a lawless `bifunctor` is lawful.", "p": "mathlib"}, {"name": "function.bicompr.is_lawful_bifunctor", "description": "", "p": "mathlib"}, {"name": "function.bicompl.is_lawful_bifunctor", "description": "", "p": "mathlib"}, {"name": "is_lawful_bifunctor.flip", "description": "", "p": "mathlib"}, {"na