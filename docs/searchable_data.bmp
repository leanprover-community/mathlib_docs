b"}, {"name": "function.antiperiodic.const_smul", "description": "", "p": "mathlib"}, {"name": "function.periodic.const_add", "description": "", "p": "mathlib"}, {"name": "function.periodic.const_smul", "description": "", "p": "mathlib"}, {"name": "function.periodic.add_period", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.smul", "description": "", "p": "mathlib"}, {"name": "function.periodic.smul", "description": "", "p": "mathlib"}, {"name": "function.periodic.nat_mul_sub_eq", "description": "", "p": "mathlib"}, {"name": "function.periodic.const_inv_mul", "description": "", "p": "mathlib"}, {"name": "function.periodic.div_const", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.int_odd_mul_antiperiodic", "description": "", "p": "mathlib"}, {"name": "function.periodic.add_antiperiod", "description": "", "p": "mathlib"}, {"name": "function.periodic.vadd", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.sub_eq", "description": "", "p": "mathlib"}, {"name": "function.periodic.eq", "description": "", "p": "mathlib"}, {"name": "finset.periodic_sum", "description": "", "p": "mathlib"}, {"name": "function.periodic_with_period_zero", "description": "", "p": "mathlib"}, {"name": "function.periodic.int_mul_sub_eq", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.nat_mul_eq_of_eq_zero", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.funext'", "description": "", "p": "mathlib"}, {"name": "function.periodic.const_inv_smul", "description": "", "p": "mathlib"}, {"name": "multiset.periodic_prod", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.neg_eq", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.nat_odd_mul_antiperiodic", "description": "", "p": "mathlib"}, {"name": "function.periodic.neg_nat_mul", "description": "", "p": "mathlib"}, {"name": "finset.periodic_prod", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.div", "description": "", "p": "mathlib"}, {"name": "function.periodic.sub_eq", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.sub_const", "description": "", "p": "mathlib"}, {"name": "function.periodic.sub_const", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.const_smul\u2080", "description": "", "p": "mathlib"}, {"name": "function.periodic.nat_mul", "description": "", "p": "mathlib"}, {"name": "function.periodic.sub_period", "description": "", "p": "mathlib"}, {"name": "function.periodic.div", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.mul_const", "description": "", "p": "mathlib"}, {"name": "function.periodic.const_sub", "description": "", "p": "mathlib"}, {"name": "function.antiperiodic.eq", "description": "", "p": "mathlib"}, {"name": "function.periodic.int_mul_eq", "description": "", "p": "mathlib"}, {"name": "function.periodic.lift", "description": "Lift a periodic function to a function from the quotient group.", "p": "mathlib"}, {"name": "function.antiperiodic.const_inv_mul", "description": "", "p": "mathlib"}, {"name": "function.periodic.const_inv_smul\u2080", "description": "", "p": "mathlib"}, {"name": "function.periodic.zsmul_sub_eq", "description": "", "p": "mathlib"}, {"name": "nat.bitwise_assoc_tac", "description": "Proving associativity of bitwise operations in general essentially boils down to a huge case\n   distinction, so it is shorter to use this tactic instead of proving it in the general case.", "p": "mathlib"}, {"name": "nat.lt_lxor_cases", "description": "", "p": "mathlib"}, {"name": "nat.test_bit_two_pow_self", "description": "", "p": "mathlib"}, {"name": "nat.zero_lxor", "description": "", "p": "mathlib"}, {"name": "nat.zero_test_bit", "description": "", "p": "mathlib"}, {"name": "nat.test_bit_two_pow", "description": "", "p": "mathlib"}, {"name": "nat.lxor_cancel_left", "description": "", "p": "mathlib"}, {"name": "nat.lor_assoc", "description": "", "p": "mathlib"}, {"name": "nat.lxor_ne_zero", "description": "", "p": "mathlib"}, {"name": "nat.lor_comm", "description": "", "p": "mathlib"}, {"name": "nat.bit_eq_zero", "description": "", "p": "mathlib"}, {"name": "nat.zero_land", "description": "", "p": "mathlib"}, {"name": "nat.land_zero", "description": "", "p": "mathlib"}, {"name": "nat.test_bit_eq_inth", "description": "The ith bit is the ith element of `n.bits`.", "p": "mathlib"}, {"name": "nat.bitwise_comm", "description": "If `f` is a commutative operation on bools such that `f ff ff = ff`, then `bitwise f` is also\n   commutative.", "p": "mathlib"}, {"name": "nat.test_bit_two_pow_of_ne", "description": "", "p": "mathlib"}, {"name": "nat.lor_zero", "description": "", "p": "mathlib"}, {"name": "nat.lxor_right_inj", "description": "", "p": "mathlib"}, {"name": "nat.bit_tt", "description": "", "p": "mathlib"}, {"name": "nat.lxor_left_inj", "description": "", "p": "mathlib"}, {"name": "nat.lxor_comm", "description": "", "p": "mathlib"}, {"name": "nat.lxor_assoc", "description": "", "p": "mathlib"}, {"name": "nat.land_assoc", "description": "", "p": "mathlib"}, {"name": "nat.lxor_trichotomy", "description": "", "p": "mathlib"}, {"name": "nat.lxor_self", "description": "", "p": "mathlib"}, {"name": "nat.lxor_zero", "description": "", "p": "mathlib"}, {"name": "nat.lxor_eq_zero", "description": "", "p": "mathlib"}, {"name": "nat.land_comm", "description": "", "p": "mathlib"}, {"name": "nat.lxor_cancel_right", "description": "", "p": "mathlib"}, {"name": "nat.zero_of_test_bit_eq_ff", "description": "", "p": "mathlib"}, {"name": "nat.eq_of_test_bit_eq", "description": "Bitwise extensionality: Two numbers agree if they agree at every bit position.", "p": "mathlib"}, {"name": "nat.lt_of_test_bit", "description": "", "p": "mathlib"}, {"name": "nat.lxor_right_injective", "description": "", "p": "mathlib"}, {"name": "nat.exists_most_significant_bit", "description": "", "p": "mathlib"}, {"name": "nat.bit_ff", "description": "", "p": "mathlib"}, {"name": "nat.zero_lor", "description": "", "p": "mathlib"}, {"name": "nat.lxor_left_injective", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_pp_pf_overlap", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul", "description": "Multiply two expressions.\n\n* `ps * 0 = 0`\n* `ps * (q + qs) = (ps * q) + (ps * qs)`", "p": "mathlib"}, {"name": "tactic.ring_exp.pow", "description": "Exponentiate two expressions.\n\n* `ps ^ 0 = 1`\n* `ps ^ (q + qs) = ps ^ q * ps ^ qs`", "p": "mathlib"}, {"name": "tactic.ring_exp.negate", "description": "Negate an expression by multiplying with `-1`.\n\nOnly works if there is a `ring` instance; otherwise it will `fail`.", "p": "mathlib"}, {"name": "tactic.ring_exp.simple_pf_var_one", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_pf_zero", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.orig", "description": "Return the original, non-normalized version of this `ex`.\n\nNote that arguments to another `ex` are always \"pre-normalized\":\ntheir `orig` and `pretty` are equal, and their `proof` is reflexivity.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_p_pf_succ", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.has_repr", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_p_pf_one", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.atom.eq", "description": "The `eq` operation on `atom`s works modulo definitional equality,\nignoring their `value`s.\nThe invariants on `atom` ensure indices are unique per value.\nThus, `eq` indicates equality as long as the `atom`s come from the same context.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_type", "description": "The values in `ex_type` are used as parameters to `ex` to control the expression's structure.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_type.base", "description": "The values in `ex_type` are used as parameters to `ex` to control the expression's structure.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_type.sum", "description": "The values in `ex_type` are used as parameters to `ex` to control the expression's structure.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_type.prod", "description": "The values in `ex_type` are used as parameters to `ex` to control the expression's structure.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_type.exp", "description": "The values in `ex_type` are used as parameters to `ex` to control the expression's structure.", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_pp_pf_prod_gt", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.add_pf_sum_lt", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.atom.has_repr", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.simple_pf_prod_neg_one", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_sum", "description": "Constructs `ex.sum` with the correct arguments.", "p": "mathlib"}, {"name": "tactic.ring_exp.none_or_proof_term", "description": "If all `ex_info` have trivial proofs, return a trivial proof.\nOtherwise, construct all proof terms.\n\nUseful in applications where trivial proofs combine to another trivial proof,\nmost importantly to pass to `mk_proof_or_refl`.", "p": "mathlib"}, {"name": "tactic.interactive.ring_exp_eq", "description": "Tactic for solving equations of *commutative* (semi)rings,\nallowing variables in the exponent.\nThis version of `ring_exp` fails if the target is not an equality.\n\nThe variant `ring_exp_eq!` will use a more aggressive reducibility setting\nto determine equality of atoms.", "p": "mathlib"}, {"name": "tactic.ring_exp.ring_exp_m", "description": "The `ring_exp_m` monad is used instead of `tactic` to store the context.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.proof", "description": "Return the normalisation proof of the given expression.\nIf the proof is `refl`, we give `none` instead,\nwhich helps to control the size of proof terms.\nTo get an actual term, use `ex.proof_term`,\nor use `mk_proof` with the correct set of arguments.", "p": "mathlib"}, {"name": "tactic.ring_exp.exp_congr", "description": "Congruence lemma for constructing `ex.exp`.", "p": "mathlib"}, {"name": "tactic.ring_exp.add_orig", "description": "A shortcut for adding the original terms of two expressions.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_type.inhabited", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.atom", "description": "The `atom` structure is used to represent atomic expressions:\nthose which `ring_exp` cannot parse any further.\n\nFor instance, `a + (a % b)` has `a` and `(a % b)` as atoms.\nThe `ring_exp_eq` tactic does not normalize the subexpressions in atoms,\nbut `ring_exp` does if `ring_exp_eq` was not sufficient.\n\nAtoms in fact represent equivalence classes of expressions,\nmodulo definitional equality.\nThe field `index : \u2115` should be a unique number for each class,\nwhile `value : expr` contains a representative of this class.\nThe function `resolve_atom` determines the appropriate atom\nfor a given expression.", "p": "mathlib"}, {"name": "tactic.ring_exp.atom.value", "description": "The `atom` structure is used to represent atomic expressions:\nthose which `ring_exp` cannot parse any further.\n\nFor instance, `a + (a % b)` has `a` and `(a % b)` as atoms.\nThe `ring_exp_eq` tactic does not normalize the subexpressions in atoms,\nbut `ring_exp` does if `ring_exp_eq` was not sufficient.\n\nAtoms in fact represent equivalence classes of expressions,\nmodulo definitional equality.\nThe field `index : \u2115` should be a unique number for each class,\nwhile `value : expr` contains a representative of this class.\nThe function `resolve_atom` determines the appropriate atom\nfor a given expression.", "p": "mathlib"}, {"name": "tactic.ring_exp.atom.index", "description": "The `atom` structure is used to represent atomic expressions:\nthose which `ring_exp` cannot parse any further.\n\nFor instance, `a + (a % b)` has `a` and `(a % b)` as atoms.\nThe `ring_exp_eq` tactic does not normalize the subexpressions in atoms,\nbut `ring_exp` does if `ring_exp_eq` was not sufficient.\n\nAtoms in fact represent equivalence classes of expressions,\nmodulo definitional equality.\nThe field `index : \u2115` should be a unique number for each class,\nwhile `value : expr` contains a representative of this class.\nThe function `resolve_atom` determines the appropriate atom\nfor a given expression.", "p": "mathlib"}, {"name": "tactic.ring_exp.overlap", "description": "Represents the way in which two products are equal except coefficient.\n\nThis type is used in the function `add_overlap`.\nIn order to deal with equations of the form `a * 2 + a = 3 * a`,\nthe `add` function will add up overlapping products,\nturning `a * 2 + a` into `a * 3`.\nWe need to distinguish `a * 2 + a` from `a * 2 + b` in order to do this,\nand the `overlap` type carries the information on how it overlaps.\n\nThe case `none` corresponds to non-overlapping products, e.g. `a * 2 + b`;\nthe case `nonzero` to overlapping products adding to non-zero, e.g. `a * 2 + a`\n(the `ex prod` field will then look like `a * 3` with a proof that `a * 2 + a = a * 3`);\nthe case `zero` to overlapping products adding to zero, e.g. `a * 2 + a * -2`.\nWe distinguish those two cases because in the second, the whole product reduces to `0`.\n\nA potential extension to the tactic would also do this for the base of exponents,\ne.g. to show `2^n * 2^n = 4^n`.", "p": "mathlib"}, {"name": "tactic.ring_exp.overlap.none", "description": "Represents the way in which two products are equal except coefficient.\n\nThis type is used in the function `add_overlap`.\nIn order to deal with equations of the form `a * 2 + a = 3 * a`,\nthe `add` function will add up overlapping products,\nturning `a * 2 + a` into `a * 3`.\nWe need to distinguish `a * 2 + a` from `a * 2 + b` in order to do this,\nand the `overlap` type carries the information on how it overlaps.\n\nThe case `none` corresponds to non-overlapping products, e.g. `a * 2 + b`;\nthe case `nonzero` to overlapping products adding to non-zero, e.g. `a * 2 + a`\n(the `ex prod` field will then look like `a * 3` with a proof that `a * 2 + a = a * 3`);\nthe case `zero` to overlapping products adding to zero, e.g. `a * 2 + a * -2`.\nWe distinguish those two cases because in the second, the whole product reduces to `0`.\n\nA potential extension to the tactic would also do this for the base of exponents,\ne.g. to show `2^n * 2^n = 4^n`.", "p": "mathlib"}, {"name": "tactic.ring_exp.overlap.nonzero", "description": "Represents the way in which two products are equal except coefficient.\n\nThis type is used in the function `add_overlap`.\nIn order to deal with equations of the form `a * 2 + a = 3 * a`,\nthe `add` function will add up overlapping products,\nturning `a * 2 + a` into `a * 3`.\nWe need to distinguish `a * 2 + a` from `a * 2 + b` in order to do this,\nand the `overlap` type carries the information on how it overlaps.\n\nThe case `none` corresponds to non-overlapping products, e.g. `a * 2 + b`;\nthe case `nonzero` to overlapping products adding to non-zero, e.g. `a * 2 + a`\n(the `ex prod` field will then look like `a * 3` with a proof that `a * 2 + a = a * 3`);\nthe case `zero` to overlapping products adding to zero, e.g. `a * 2 + a * -2`.\nWe distinguish those two cases because in the second, the whole product reduces to `0`.\n\nA potential extension to the tactic would also do this for the base of exponents,\ne.g. to show `2^n * 2^n = 4^n`.", "p": "mathlib"}, {"name": "tactic.ring_exp.overlap.zero", "description": "Represents the way in which two products are equal except coefficient.\n\nThis type is used in the function `add_overlap`.\nIn order to deal with equations of the form `a * 2 + a = 3 * a`,\nthe `add` function will add up overlapping products,\nturning `a * 2 + a` into `a * 3`.\nWe need to distinguish `a * 2 + a` from `a * 2 + b` in order to do this,\nand the `overlap` type carries the information on how it overlaps.\n\nThe case `none` corresponds to non-overlapping products, e.g. `a * 2 + b`;\nthe case `nonzero` to overlapping products adding to non-zero, e.g. `a * 2 + a`\n(the `ex prod` field will then look like `a * 3` with a proof that `a * 2 + a = a * 3`);\nthe case `zero` to overlapping products adding to zero, e.g. `a * 2 + a * -2`.\nWe distinguish those two cases because in the second, the whole product reduces to `0`.\n\nA potential extension to the tactic would also do this for the base of exponents,\ne.g. to show `2^n * 2^n = 4^n`.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_with_proof", "description": "Run `eval` on the expression and return the result together with normalization proof.\n\nSee also `eval_simple` if you want something that behaves like `norm_num`.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_p_pf_zero", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.eq", "description": "Equality test for expressions.\n\nSince equivalence of `atom`s is not the same as equality,\nwe cannot make a true `(=)` operator for `ex` either.", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_coeff_pf_mul_one", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mk_mul", "description": "Specialized version of `mk_app ``has_mul.mul`.\nShould be faster because it can use the cached instances.", "p": "mathlib"}, {"name": "tactic.ring_exp.add_pf_sum_overlap", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.coeff_has_repr", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.lift", "description": "Lift an operation in the `tactic` monad to the `ring_exp_m` monad.\n\nThis operation will not access the cache.", "p": "mathlib"}, {"name": "tactic.ring_exp.div_pf", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mk_app_csr", "description": "Specialized version of `mk_app` where the first two arguments are `{\u03b1}` `[comm_semiring \u03b1]`.\nShould be faster because it can use the cached instances.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.info", "description": "Return the proof information associated to the `ex`.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_info", "description": "Each `ex` stores information for its normalization proof.\n\nThe `orig` expression is the expression that was passed to `eval`.\n\nThe `pretty` expression is the normalised form that the `ex` represents.\n(I didn't call this something like `norm`, because there are already\ntoo many things called `norm` in mathematics!)\n\nThe field `proof` contains an optional proof term of type `%%orig = %%pretty`.\nThe value `none` for the proof indicates that everything reduces to reflexivity.\n(Which saves space in quite a lot of cases.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_info.orig", "description": "Each `ex` stores information for its normalization proof.\n\nThe `orig` expression is the expression that was passed to `eval`.\n\nThe `pretty` expression is the normalised form that the `ex` represents.\n(I didn't call this something like `norm`, because there are already\ntoo many things called `norm` in mathematics!)\n\nThe field `proof` contains an optional proof term of type `%%orig = %%pretty`.\nThe value `none` for the proof indicates that everything reduces to reflexivity.\n(Which saves space in quite a lot of cases.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_info.pretty", "description": "Each `ex` stores information for its normalization proof.\n\nThe `orig` expression is the expression that was passed to `eval`.\n\nThe `pretty` expression is the normalised form that the `ex` represents.\n(I didn't call this something like `norm`, because there are already\ntoo many things called `norm` in mathematics!)\n\nThe field `proof` contains an optional proof term of type `%%orig = %%pretty`.\nThe value `none` for the proof indicates that everything reduces to reflexivity.\n(Which saves space in quite a lot of cases.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_info.proof", "description": "Each `ex` stores information for its normalization proof.\n\nThe `orig` expression is the expression that was passed to `eval`.\n\nThe `pretty` expression is the normalised form that the `ex` represents.\n(I didn't call this something like `norm`, because there are already\ntoo many things called `norm` in mathematics!)\n\nThe field `proof` contains an optional proof term of type `%%orig = %%pretty`.\nThe value `none` for the proof indicates that everything reduces to reflexivity.\n(Which saves space in quite a lot of cases.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ring_exp_m.alternative", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_pf_c_c", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_pf_c_prod", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.prod_to_sum_pf", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mk_pow", "description": "Specialized version of `mk_app ``has_pow.pow`.\nShould be faster because it can use the cached instances.", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_pp", "description": "Multiply two expressions.\n\n* `x * y = (x * y)` (for `x`, `y` coefficients)\n* `x * (q * qs) = q * (qs * x)` (for `x` coefficient)\n* `(p * ps) * y = p * (ps * y)` (for `y` coefficient)\n* `(p_b^p_e * ps) * (p_b^q_e * qs) = p_b^(p_e + q_e) * (ps * qs)`\n    (if `p_e` and `q_e` are identical except coefficient)\n* `(p * ps) * (q * qs) = p * (ps * (q * qs))` (if `p.lt q`)\n* `(p * ps) * (q * qs) = q * ((p * ps) * qs)` (if not `p.lt q`)", "p": "mathlib"}, {"name": "tactic.ring_exp.exp_to_prod", "description": "Conversion from `ex exp` to `ex prod`.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_pp_pf_prod", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_one", "description": "Constructs `ex.coeff 1` with the correct arguments.\nThis is a special case for optimization purposes.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_pf_c_c", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.add_pf_sum_z", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_coeff_pf_one_mul", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_sum_b", "description": "Constructs `ex.sum_b` with the correct arguments.", "p": "mathlib"}, {"name": "tactic.ring_exp.mk_app_class", "description": "Specialized version of `mk_app` where the first two arguments are `{\u03b1}` `[some_class \u03b1]`.\nShould be faster because it can use the cached instances.", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_pf_sum", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_pp_pf_prod_lt", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_orig", "description": "A shortcut for exponentiating the original terms of two expressions.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval", "description": "Compute a normalized form (of type `ex`) from an expression (of type `expr`).\n\nThis is the main driver of the `ring_exp` tactic,\ncalling out to `add`, `mul`, `pow`, etc. to parse the `expr`.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_e_pf_exp", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_p_pf_sum", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.add_pf_sum_gt", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_type.decidable_eq", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.in_exponent", "description": "Change the context of the given computation,\nso that expressions are evaluated in the exponent ring,\ninstead of the base ring.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_p_pf_singleton", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_p", "description": "Multiply two expressions.\n\n* `0 * qs = 0`\n* `(p + ps) * qs = (p * qs) + (ps * qs)`", "p": "mathlib"}, {"name": "tactic.ring_exp.negate_pf", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mk_proof_or_refl", "description": "Use the proof terms as arguments to the given lemma.\nOften, we construct a proof term using congruence where reflexivity suffices.\nTo solve this, the following function tries to get away with reflexivity.", "p": "mathlib"}, {"name": "tactic.ring_exp.make_eval_info", "description": "Compute the `eval_info` for a given type `\u03b1`.", "p": "mathlib"}, {"name": "tactic.ring_exp.base_to_exp_pf", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.simple_pf_prod_one", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_pp_pf_c", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.repr", "description": "Convert an `ex` to a `string`.", "p": "mathlib"}, {"name": "tactic.ring_exp.sum_congr", "description": "Congruence lemma for constructing `ex.sum`.", "p": "mathlib"}, {"name": "tactic.ring_exp.simple_pf_exp_one", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.simple_pf_sum_zero", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.add", "description": "Add two expressions.\n\n* `0 + qs = 0`\n* `ps + 0 = 0`\n* `ps * x + ps * y = ps * (x + y)` (for `x`, `y` coefficients; uses `add_overlap`)\n* `(p + ps) + (q + qs) = p + (ps + (q + qs))` (if `p.lt q`)\n* `(p + ps) + (q + qs) = q + ((p + ps) + qs)` (if not `p.lt q`)", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_orig", "description": "A shortcut for multiplying the original terms of two expressions.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_pf_zero", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.base_to_exp", "description": "Conversion from `ex base` to `ex exp`.", "p": "mathlib"}, {"name": "tactic.ring_exp.run_ring_exp", "description": "Use `e` to build the context for running `mx`.", "p": "mathlib"}, {"name": "tactic.ring_exp.coeff.decidable_eq", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_coeff", "description": "Constructs `ex.coeff` with the correct arguments.\n\nThere are more efficient constructors for specific numerals:\nif `x = 0`, you should use `ex_zero`; if `x = 1`, use `ex_one`.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_base", "description": "Treat the expression atomically: as a coefficient or atom.\n\nHandles cases where `eval` cannot treat the expression as a known operation\nbecause it is just a number or single variable.", "p": "mathlib"}, {"name": "tactic.ring_exp.context", "description": "The `context` contains the full set of information needed for the `eval` function.\n\nThis structure has two copies of `eval_info`:\none is for the base (typically some semiring `\u03b1`) and another for the exponent (always `\u2115`).\nWhen evaluating an exponent, we put `info_e` in `info_b`.", "p": "mathlib"}, {"name": "tactic.ring_exp.context.info_b", "description": "The `context` contains the full set of information needed for the `eval` function.\n\nThis structure has two copies of `eval_info`:\none is for the base (typically some semiring `\u03b1`) and another for the exponent (always `\u2115`).\nWhen evaluating an exponent, we put `info_e` in `info_b`.", "p": "mathlib"}, {"name": "tactic.ring_exp.context.info_e", "description": "The `context` contains the full set of information needed for the `eval` function.\n\nThis structure has two copies of `eval_info`:\none is for the base (typically some semiring `\u03b1`) and another for the exponent (always `\u2115`).\nWhen evaluating an exponent, we put `info_e` in `info_b`.", "p": "mathlib"}, {"name": "tactic.ring_exp.context.transp", "description": "The `context` contains the full set of information needed for the `eval` function.\n\nThis structure has two copies of `eval_info`:\none is for the base (typically some semiring `\u03b1`) and another for the exponent (always `\u2115`).\nWhen evaluating an exponent, we put `info_e` in `info_b`.", "p": "mathlib"}, {"name": "tactic.ring_exp.add_pf_z_sum", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.\u03b1", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.univ", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.csr_instance", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.ha_instance", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.hm_instance", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.hp_instance", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.ring_instance", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.dr_instance", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.zero", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_info.one", "description": "Stores the information needed in the `eval` function and its dependencies,\nso they can (re)construct expressions.\n\nThe `eval_info` structure stores this information for one type,\nand the `context` combines the two types, one for bases and one for exponents.", "p": "mathlib"}, {"name": "tactic.ring_exp.normalize", "description": "Repeatedly apply `eval_simple` on (sub)expressions.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.set_info", "description": "Update the `ex_info` of the given expression.\n\nWe use this to combine intermediate normalisation proofs.\nSince `pretty` only depends on the subexpressions,\nwhich do not change, we do not set `pretty`.", "p": "mathlib"}, {"name": "tactic.ring_exp.rewrite", "description": " Given a proof that the expressions `ps_o` and `ps'.orig` are equal,\nshow that `ps_o` and `ps'.pretty` are equal.\n\nUseful to deal with aliases in `eval`. For instance, `nat.succ p` can be handled\nas an alias of `p + 1` as follows:\n```lean\n| ps_o@`(nat.succ %%p_o) := do\n  ps' \u2190 eval `(%%p_o + 1),\n  pf \u2190 lift $ mk_app ``nat.succ_eq_add_one [p_o],\n  rewrite ps_o ps' pf\n```", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_info.proof_term", "description": "Construct a normalization proof term or return the cached one.", "p": "mathlib"}, {"name": "tactic.ring_exp.atom.lt", "description": "We order `atom`s on the order of appearance in the main expression.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_var", "description": "Constructs `ex.var` with the correct arguments.", "p": "mathlib"}, {"name": "tactic.ring_exp.eval_simple", "description": "Run `eval` on the expression and simplify the result.\n\nReturns a simplified normalized expression, together with an equality proof.\n\nSee also `eval_with_proof` if you just want to check the equality of two expressions.", "p": "mathlib"}, {"name": "tactic.ring_exp.mk_proof", "description": "Use the proof terms as arguments to the given lemma.\nIf the lemma could reduce to reflexivity, consider using `mk_proof_or_refl.`", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_info.set", "description": "Update the `orig` and `proof` fields of the `ex_info`.\nIntended for use in `ex.set_info`.", "p": "mathlib"}, {"name": "tactic.ring_exp.atom_to_sum_pf", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.add_overlap_pf_zero", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_e", "description": "Exponentiate two expressions.\n\n* `(p ^ ps) ^ qs = p ^ (ps * qs)`", "p": "mathlib"}, {"name": "tactic.ring_exp.get_context", "description": "Access the instance cache.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.proof_term", "description": "Construct a normalization proof term or return the cached one.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_p_pf_cons", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.coeff", "description": "Coefficients in the expression are stored in a wrapper structure,\nallowing for easier modification of the data structures.\nThe modifications might be caching of the result of `expr.of_rat`,\nor using a different meta representation of numerals.", "p": "mathlib"}, {"name": "tactic.ring_exp.coeff.value", "description": "Coefficients in the expression are stored in a wrapper structure,\nallowing for easier modification of the data structures.\nThe modifications might be caching of the result of `expr.of_rat`,\nor using a different meta representation of numerals.", "p": "mathlib"}, {"name": "tactic.ring_exp.inverse", "description": "Invert an expression by simplifying, applying `has_inv.inv` and treating the result as an atom.\n\nOnly works if there is a `division_ring` instance; otherwise it will `fail`.", "p": "mathlib"}, {"name": "tactic.ring_exp.prod_congr", "description": "Congruence lemma for constructing `ex.prod`.", "p": "mathlib"}, {"name": "tactic.ring_exp.mk_add", "description": "Specialized version of `mk_app ``has_add.add`.\nShould be faster because it can use the cached instances.", "p": "mathlib"}, {"name": "tactic.ring_exp.coeff.inhabited", "description": "", "p": "mathlib"}, {"name": "tactic_doc.tactic.ring_exp", "description": "Tactic for evaluating expressions in *commutative* (semi)rings, allowing for variables in the\nexponent.\n\nThis tactic extends `ring`: it should solve every goal that `ring` can solve.\nAdditionally, it knows how to evaluate expressions with complicated exponents\n(where `ring` only understands constant exponents).\nThe variants `ring_exp!` and `ring_exp_eq!` use a more aggessive reducibility setting to determine\nequality of atoms.\n\nFor example:\n```lean\nexample (n : \u2115) (m : \u2124) : 2^(n+1) * m = 2 * 2^n * m := by ring_exp\nexample (a b : \u2124) (n : \u2115) : (a + b)^(n + 2) = (a^2 + b^2 + a * b + b * a) * (a + b)^n := by ring_exp\nexample (x y : \u2115) : x + id y = y + id x := by ring_exp!\n```", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_exp", "description": "Constructs `ex.exp` with the correct arguments.", "p": "mathlib"}, {"name": "tactic.ring_exp.atom_to_sum", "description": "A more efficient conversion from `atom` to `ex sum`.\n\nThe result should be the same as `ex_var p >>= base_to_exp >>= exp_to_prod >>= prod_to_sum`,\nexcept we need to calculate less intermediate steps.", "p": "mathlib"}, {"name": "tactic.ring_exp.inverse_pf", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_p_pf_zero", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.simple", "description": "Give a simpler, more human-readable representation of the normalized expression.\n\nNormalized expressions might have the form `a^1 * 1 + 0`,\nsince the dummy operations reduce special cases in pattern-matching.\nHumans prefer to read `a` instead.\nThis tactic gets rid of the dummy additions, multiplications and exponentiations.\n\nReturns a normalized expression `e'` and a proof that `e.pretty = e'`.", "p": "mathlib"}, {"name": "tactic.ring_exp.resolve_atom_aux", "description": "Performs a lookup of the atom `a` in the list of known atoms,\nor allocates a new one.\n\nIf `a` is not definitionally equal to any of the list's entries,\na new atom is appended to the list and returned.\nThe index of this atom is kept track of in the second inductive argument.\n\nThis function is mostly useful in `resolve_atom`,\nwhich updates the state with the new list of atoms.", "p": "mathlib"}, {"name": "conv.interactive.ring_exp", "description": "Normalises expressions in commutative (semi-)rings inside of a `conv` block using the tactic\n`ring_exp`.", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_coeff", "description": "Compute the product of two coefficients.\n\nThe returned value is of the form `ex.coeff _ (p * q)`,\nwith the proof of `expr.of_rat p * expr.of_rat q = expr.of_rat (p * q)`.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_zero", "description": "Constructs `ex.zero` with the correct arguments.", "p": "mathlib"}, {"name": "tactic.ring_exp.add_coeff", "description": "Compute the sum of two coefficients.\nNote that the result might not be a valid expression:\nif `p = -q`, then the result should be `ex.zero : ex sum` instead.\nThe caller must detect when this happens!\n\nThe returned value is of the form `ex.coeff _ (p + q)`,\nwith the proof of `expr.of_rat p + expr.of_rat q = expr.of_rat (p + q)`.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_pp", "description": "Exponentiate two expressions.\n\n* `1 ^ qs = 1`\n* `x ^ qs = x ^ qs` (for `x` coefficient)\n* `(p * ps) ^ qs = p ^ qs + ps ^ qs`", "p": "mathlib"}, {"name": "tactic.ring_exp.add_overlap", "description": "Given arguments `ps`, `qs` of the form `ps' * x` and `ps' * y` respectively\nreturn `ps + qs = ps' * (x + y)` (with `x` and `y` arbitrary coefficients).\nFor other arguments, return `overlap.none`.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_pp_pf_one", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.ring_exp", "description": "Tactic for evaluating expressions in *commutative* (semi)rings, allowing for variables in the\nexponent.\n\nThis tactic extends `ring`: it should solve every goal that `ring` can solve.\nAdditionally, it knows how to evaluate expressions with complicated exponents\n(where `ring` only understands constant exponents).\nThe variants `ring_exp!` and `ring_exp_eq!` use a more aggessive reducibility setting to determine\nequality of atoms.\n\nFor example:\n```lean\nexample (n : \u2115) (m : \u2124) : 2^(n+1) * m = 2 * 2^n * m := by ring_exp\nexample (a b : \u2124) (n : \u2115) : (a + b)^(n + 2) = (a^2 + b^2 + a * b + b * a) * (a + b)^n := by ring_exp\nexample (x y : \u2115) : x + id y = y + id x := by ring_exp!\n```", "p": "mathlib"}, {"name": "tactic.ring_exp.ring_exp_m.monad", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.add_pf_sum_overlap_zero", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.resolve_atom", "description": "Convert the expression to an atom:\neither look up a definitionally equal atom,\nor allocate it as a new atom.\n\nYou probably want to use `eval_base` if `eval` doesn't work\ninstead of directly calling `resolve_atom`,\nsince `eval_base` can also handle numerals.", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.lt", "description": "The ordering on expressions.\n\nAs for `ex.eq`, this is a linear order only in one context.", "p": "mathlib"}, {"name": "tactic.ring_exp.prod_to_sum", "description": "Conversion from `ex prod` to `ex sum`.", "p": "mathlib"}, {"name": "tactic.ring_exp.sub_pf", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_coeff", "description": "Compute the exponentiation of two coefficients.\n\nThe returned value is of the form `ex.coeff _ (p ^ q)`,\nwith the proof of `expr.of_rat p ^ expr.of_rat q = expr.of_rat (p ^ q)`.", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_p", "description": "Exponentiate two expressions.\n\n* `ps ^ 1 = ps`\n* `0 ^ qs = 0` (note that this is handled *after* `ps ^ 0 = 1`)\n* `(p + 0) ^ qs = p ^ qs`\n* `ps ^ (qs + 1) = ps * ps ^ qs` (note that this is handled *after* `p + 0 ^ qs = p ^ qs`)\n* `ps ^ qs = ps ^ qs` (otherwise)", "p": "mathlib"}, {"name": "tactic.ring_exp.add_overlap_pf", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex_prod", "description": "Constructs `ex.prod` with the correct arguments.", "p": "mathlib"}, {"name": "tactic.ring_exp.mul_pf_prod_c", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.exp_to_prod_pf", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex", "description": "The `ex` type is an abstract representation of an expression with `+`, `*` and `^`.\nThose operators are mapped to the `sum`, `prod` and `exp` constructors respectively.\n\nThe `zero` constructor is the base case for `ex sum`, e.g. `1 + 2` is represented\nby (something along the lines of) `sum 1 (sum 2 zero)`.\n\nThe `coeff` constructor is the base case for `ex prod`, and is used for numerals.\nThe code maintains the invariant that the coefficient is never `0`.\n\nThe `var` constructor is the base case for `ex exp`, and is used for atoms.\n\nThe `sum_b` constructor allows for addition in the base of an exponentiation;\nit serves a similar purpose as the parentheses in `(a + b)^c`.\nThe code maintains the invariant that the argument to `sum_b` is not `zero`\nor `sum _ zero`.\n\nAll of the constructors contain an `ex_info` field,\nused to carry around (arguments to) proof terms.\n\nWhile the `ex_type` parameter enforces some simplification invariants,\nthe following ones must be manually maintained at the risk of insufficient power:\n- the argument to `coeff` must be nonzero (to ensure `0 = 0 * 1`)\n- the argument to `sum_b` must be of the form `sum a (sum b bs)` (to ensure `(a + 0)^n = a^n`)\n- normalisation proofs of subexpressions must be `refl ps.pretty`\n- if we replace `sum` with `cons` and `zero` with `nil`, the resulting list is sorted\n  according to the `lt` relation defined further down; similarly for `prod` and `coeff`\n  (to ensure `a + b = b + a`).\n\nThe first two invariants could be encoded in a subtype of `ex`,\nbut aren't (yet) to spare some implementation burden.\nThe other invariants cannot be encoded because we need the `tactic` monad to check them.\n(For example, the correct equality check of `expr` is `is_def_eq : expr \u2192 expr \u2192 tactic unit`.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.zero", "description": "The `ex` type is an abstract representation of an expression with `+`, `*` and `^`.\nThose operators are mapped to the `sum`, `prod` and `exp` constructors respectively.\n\nThe `zero` constructor is the base case for `ex sum`, e.g. `1 + 2` is represented\nby (something along the lines of) `sum 1 (sum 2 zero)`.\n\nThe `coeff` constructor is the base case for `ex prod`, and is used for numerals.\nThe code maintains the invariant that the coefficient is never `0`.\n\nThe `var` constructor is the base case for `ex exp`, and is used for atoms.\n\nThe `sum_b` constructor allows for addition in the base of an exponentiation;\nit serves a similar purpose as the parentheses in `(a + b)^c`.\nThe code maintains the invariant that the argument to `sum_b` is not `zero`\nor `sum _ zero`.\n\nAll of the constructors contain an `ex_info` field,\nused to carry around (arguments to) proof terms.\n\nWhile the `ex_type` parameter enforces some simplification invariants,\nthe following ones must be manually maintained at the risk of insufficient power:\n- the argument to `coeff` must be nonzero (to ensure `0 = 0 * 1`)\n- the argument to `sum_b` must be of the form `sum a (sum b bs)` (to ensure `(a + 0)^n = a^n`)\n- normalisation proofs of subexpressions must be `refl ps.pretty`\n- if we replace `sum` with `cons` and `zero` with `nil`, the resulting list is sorted\n  according to the `lt` relation defined further down; similarly for `prod` and `coeff`\n  (to ensure `a + b = b + a`).\n\nThe first two invariants could be encoded in a subtype of `ex`,\nbut aren't (yet) to spare some implementation burden.\nThe other invariants cannot be encoded because we need the `tactic` monad to check them.\n(For example, the correct equality check of `expr` is `is_def_eq : expr \u2192 expr \u2192 tactic unit`.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.sum", "description": "The `ex` type is an abstract representation of an expression with `+`, `*` and `^`.\nThose operators are mapped to the `sum`, `prod` and `exp` constructors respectively.\n\nThe `zero` constructor is the base case for `ex sum`, e.g. `1 + 2` is represented\nby (something along the lines of) `sum 1 (sum 2 zero)`.\n\nThe `coeff` constructor is the base case for `ex prod`, and is used for numerals.\nThe code maintains the invariant that the coefficient is never `0`.\n\nThe `var` constructor is the base case for `ex exp`, and is used for atoms.\n\nThe `sum_b` constructor allows for addition in the base of an exponentiation;\nit serves a similar purpose as the parentheses in `(a + b)^c`.\nThe code maintains the invariant that the argument to `sum_b` is not `zero`\nor `sum _ zero`.\n\nAll of the constructors contain an `ex_info` field,\nused to carry around (arguments to) proof terms.\n\nWhile the `ex_type` parameter enforces some simplification invariants,\nthe following ones must be manually maintained at the risk of insufficient power:\n- the argument to `coeff` must be nonzero (to ensure `0 = 0 * 1`)\n- the argument to `sum_b` must be of the form `sum a (sum b bs)` (to ensure `(a + 0)^n = a^n`)\n- normalisation proofs of subexpressions must be `refl ps.pretty`\n- if we replace `sum` with `cons` and `zero` with `nil`, the resulting list is sorted\n  according to the `lt` relation defined further down; similarly for `prod` and `coeff`\n  (to ensure `a + b = b + a`).\n\nThe first two invariants could be encoded in a subtype of `ex`,\nbut aren't (yet) to spare some implementation burden.\nThe other invariants cannot be encoded because we need the `tactic` monad to check them.\n(For example, the correct equality check of `expr` is `is_def_eq : expr \u2192 expr \u2192 tactic unit`.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.coeff", "description": "The `ex` type is an abstract representation of an expression with `+`, `*` and `^`.\nThose operators are mapped to the `sum`, `prod` and `exp` constructors respectively.\n\nThe `zero` constructor is the base case for `ex sum`, e.g. `1 + 2` is represented\nby (something along the lines of) `sum 1 (sum 2 zero)`.\n\nThe `coeff` constructor is the base case for `ex prod`, and is used for numerals.\nThe code maintains the invariant that the coefficient is never `0`.\n\nThe `var` constructor is the base case for `ex exp`, and is used for atoms.\n\nThe `sum_b` constructor allows for addition in the base of an exponentiation;\nit serves a similar purpose as the parentheses in `(a + b)^c`.\nThe code maintains the invariant that the argument to `sum_b` is not `zero`\nor `sum _ zero`.\n\nAll of the constructors contain an `ex_info` field,\nused to carry around (arguments to) proof terms.\n\nWhile the `ex_type` parameter enforces some simplification invariants,\nthe following ones must be manually maintained at the risk of insufficient power:\n- the argument to `coeff` must be nonzero (to ensure `0 = 0 * 1`)\n- the argument to `sum_b` must be of the form `sum a (sum b bs)` (to ensure `(a + 0)^n = a^n`)\n- normalisation proofs of subexpressions must be `refl ps.pretty`\n- if we replace `sum` with `cons` and `zero` with `nil`, the resulting list is sorted\n  according to the `lt` relation defined further down; similarly for `prod` and `coeff`\n  (to ensure `a + b = b + a`).\n\nThe first two invariants could be encoded in a subtype of `ex`,\nbut aren't (yet) to spare some implementation burden.\nThe other invariants cannot be encoded because we need the `tactic` monad to check them.\n(For example, the correct equality check of `expr` is `is_def_eq : expr \u2192 expr \u2192 tactic unit`.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.prod", "description": "The `ex` type is an abstract representation of an expression with `+`, `*` and `^`.\nThose operators are mapped to the `sum`, `prod` and `exp` constructors respectively.\n\nThe `zero` constructor is the base case for `ex sum`, e.g. `1 + 2` is represented\nby (something along the lines of) `sum 1 (sum 2 zero)`.\n\nThe `coeff` constructor is the base case for `ex prod`, and is used for numerals.\nThe code maintains the invariant that the coefficient is never `0`.\n\nThe `var` constructor is the base case for `ex exp`, and is used for atoms.\n\nThe `sum_b` constructor allows for addition in the base of an exponentiation;\nit serves a similar purpose as the parentheses in `(a + b)^c`.\nThe code maintains the invariant that the argument to `sum_b` is not `zero`\nor `sum _ zero`.\n\nAll of the constructors contain an `ex_info` field,\nused to carry around (arguments to) proof terms.\n\nWhile the `ex_type` parameter enforces some simplification invariants,\nthe following ones must be manually maintained at the risk of insufficient power:\n- the argument to `coeff` must be nonzero (to ensure `0 = 0 * 1`)\n- the argument to `sum_b` must be of the form `sum a (sum b bs)` (to ensure `(a + 0)^n = a^n`)\n- normalisation proofs of subexpressions must be `refl ps.pretty`\n- if we replace `sum` with `cons` and `zero` with `nil`, the resulting list is sorted\n  according to the `lt` relation defined further down; similarly for `prod` and `coeff`\n  (to ensure `a + b = b + a`).\n\nThe first two invariants could be encoded in a subtype of `ex`,\nbut aren't (yet) to spare some implementation burden.\nThe other invariants cannot be encoded because we need the `tactic` monad to check them.\n(For example, the correct equality check of `expr` is `is_def_eq : expr \u2192 expr \u2192 tactic unit`.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.var", "description": "The `ex` type is an abstract representation of an expression with `+`, `*` and `^`.\nThose operators are mapped to the `sum`, `prod` and `exp` constructors respectively.\n\nThe `zero` constructor is the base case for `ex sum`, e.g. `1 + 2` is represented\nby (something along the lines of) `sum 1 (sum 2 zero)`.\n\nThe `coeff` constructor is the base case for `ex prod`, and is used for numerals.\nThe code maintains the invariant that the coefficient is never `0`.\n\nThe `var` constructor is the base case for `ex exp`, and is used for atoms.\n\nThe `sum_b` constructor allows for addition in the base of an exponentiation;\nit serves a similar purpose as the parentheses in `(a + b)^c`.\nThe code maintains the invariant that the argument to `sum_b` is not `zero`\nor `sum _ zero`.\n\nAll of the constructors contain an `ex_info` field,\nused to carry around (arguments to) proof terms.\n\nWhile the `ex_type` parameter enforces some simplification invariants,\nthe following ones must be manually maintained at the risk of insufficient power:\n- the argument to `coeff` must be nonzero (to ensure `0 = 0 * 1`)\n- the argument to `sum_b` must be of the form `sum a (sum b bs)` (to ensure `(a + 0)^n = a^n`)\n- normalisation proofs of subexpressions must be `refl ps.pretty`\n- if we replace `sum` with `cons` and `zero` with `nil`, the resulting list is sorted\n  according to the `lt` relation defined further down; similarly for `prod` and `coeff`\n  (to ensure `a + b = b + a`).\n\nThe first two invariants could be encoded in a subtype of `ex`,\nbut aren't (yet) to spare some implementation burden.\nThe other invariants cannot be encoded because we need the `tactic` monad to check them.\n(For example, the correct equality check of `expr` is `is_def_eq : expr \u2192 expr \u2192 tactic unit`.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.sum_b", "description": "The `ex` type is an abstract representation of an expression with `+`, `*` and `^`.\nThose operators are mapped to the `sum`, `prod` and `exp` constructors respectively.\n\nThe `zero` constructor is the base case for `ex sum`, e.g. `1 + 2` is represented\nby (something along the lines of) `sum 1 (sum 2 zero)`.\n\nThe `coeff` constructor is the base case for `ex prod`, and is used for numerals.\nThe code maintains the invariant that the coefficient is never `0`.\n\nThe `var` constructor is the base case for `ex exp`, and is used for atoms.\n\nThe `sum_b` constructor allows for addition in the base of an exponentiation;\nit serves a similar purpose as the parentheses in `(a + b)^c`.\nThe code maintains the invariant that the argument to `sum_b` is not `zero`\nor `sum _ zero`.\n\nAll of the constructors contain an `ex_info` field,\nused to carry around (arguments to) proof terms.\n\nWhile the `ex_type` parameter enforces some simplification invariants,\nthe following ones must be manually maintained at the risk of insufficient power:\n- the argument to `coeff` must be nonzero (to ensure `0 = 0 * 1`)\n- the argument to `sum_b` must be of the form `sum a (sum b bs)` (to ensure `(a + 0)^n = a^n`)\n- normalisation proofs of subexpressions must be `refl ps.pretty`\n- if we replace `sum` with `cons` and `zero` with `nil`, the resulting list is sorted\n  according to the `lt` relation defined further down; similarly for `prod` and `coeff`\n  (to ensure `a + b = b + a`).\n\nThe first two invariants could be encoded in a subtype of `ex`,\nbut aren't (yet) to spare some implementation burden.\nThe other invariants cannot be encoded because we need the `tactic` monad to check them.\n(For example, the correct equality check of `expr` is `is_def_eq : expr \u2192 expr \u2192 tactic unit`.)", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.exp", "description": "The `ex` type is an abstract representation of an expression with `+`, `*` and `^`.\nThose operators are mapped to the `sum`, `prod` and `exp` constructors respectively.\n\nThe `zero` constructor is the base case for `ex sum`, e.g. `1 + 2` is represented\nby (something along the lines of) `sum 1 (sum 2 zero)`.\n\nThe `coeff` constructor is the base case for `ex prod`, and is used for numerals.\nThe code maintains the invariant that the coefficient is never `0`.\n\nThe `var` constructor is the base case for `ex exp`, and is used for atoms.\n\nThe `sum_b` constructor allows for addition in the base of an exponentiation;\nit serves a similar purpose as the parentheses in `(a + b)^c`.\nThe code maintains the invariant that the argument to `sum_b` is not `zero`\nor `sum _ zero`.\n\nAll of the constructors contain an `ex_info` field,\nused to carry around (arguments to) proof terms.\n\nWhile the `ex_type` parameter enforces some simplification invariants,\nthe following ones must be manually maintained at the risk of insufficient power:\n- the argument to `coeff` must be nonzero (to ensure `0 = 0 * 1`)\n- the argument to `sum_b` must be of the form `sum a (sum b bs)` (to ensure `(a + 0)^n = a^n`)\n- normalisation proofs of subexpressions must be `refl ps.pretty`\n- if we replace `sum` with `cons` and `zero` with `nil`, the resulting list is sorted\n  according to the `lt` relation defined further down; similarly for `prod` and `coeff`\n  (to ensure `a + b = b + a`).\n\nThe first two invariants could be encoded in a subtype of `ex`,\nbut aren't (yet) to spare some implementation burden.\nThe other invariants cannot be encoded because we need the `tactic` monad to check them.\n(For example, the correct equality check of `expr` is `is_def_eq : expr \u2192 expr \u2192 tactic unit`.)", "p": "mathlib"}, {"name": "tactic.ring_exp.pow_pf_sum", "description": "", "p": "mathlib"}, {"name": "tactic.ring_exp.ex.pretty", "description": "Return the normalized version of this `ex`.", "p": "mathlib"}, {"name": "lie_module_hom.coe_linear_map_comp", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.inhabited", "description": "", "p": "mathlib"}, {"name": "lie_equiv.to_linear_equiv", "description": "Consider an equivalence of Lie algebras as a linear equivalence.", "p": "mathlib"}, {"name": "lie_ring_module", "description": " A Lie ring module is an additive group, together with an additive action of a\nLie ring on this group, such that the Lie bracket acts as the commutator of endomorphisms.\n(For representations of Lie *algebras* see `lie_module`.)", "p": "mathlib"}, {"name": "lie_ring_module.to_has_bracket", "description": " A Lie ring module is an additive group, together with an additive action of a\nLie ring on this group, such that the Lie bracket acts as the commutator of endomorphisms.\n(For representations of Lie *algebras* see `lie_module`.)", "p": "mathlib"}, {"name": "lie_ring_module.add_lie", "description": " A Lie ring module is an additive group, together with an additive action of a\nLie ring on this group, such that the Lie bracket acts as the commutator of endomorphisms.\n(For representations of Lie *algebras* see `lie_module`.)", "p": "mathlib"}, {"name": "lie_ring_module.lie_add", "description": " A Lie ring module is an additive group, together with an additive action of a\nLie ring on this group, such that the Lie bracket acts as the commutator of endomorphisms.\n(For representations of Lie *algebras* see `lie_module`.)", "p": "mathlib"}, {"name": "lie_ring_module.leibniz_lie", "description": " A Lie ring module is an additive group, together with an additive action of a\nLie ring on this group, such that the Lie bracket acts as the commutator of endomorphisms.\n(For representations of Lie *algebras* see `lie_module`.)", "p": "mathlib"}, {"name": "lie_module_hom.coe_add", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.comp_apply", "description": "", "p": "mathlib"}, {"name": "lie_hom.has_zero", "description": "The constant 0 map is a Lie algebra morphism.", "p": "mathlib"}, {"name": "nsmul_lie", "description": "", "p": "mathlib"}, {"name": "lie_equiv.trans", "description": "Lie algebra equivalences are transitive.", "p": "mathlib"}, {"name": "lie_equiv.has_one", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.self_trans_symm", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.map_neg", "description": "", "p": "mathlib"}, {"name": "lie_equiv.of_bijective", "description": "A bijective morphism of Lie algebras yields an equivalence of Lie algebras.", "p": "mathlib"}, {"name": "lie_equiv.coe_linear_equiv_injective", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.map_zero", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.has_one", "description": "The identity map is a Lie module morphism.", "p": "mathlib"}, {"name": "lie_hom.zero_apply", "description": "", "p": "mathlib"}, {"name": "lie_equiv.surjective", "description": "", "p": "mathlib"}, {"name": "lie_hom.ext", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.has_coe_to_linear_equiv", "description": "", "p": "mathlib"}, {"name": "lie_hom.mk_coe", "description": "", "p": "mathlib"}, {"name": "lie_hom.has_one", "description": "The identity map is a Lie algebra morphism.", "p": "mathlib"}, {"name": "neg_lie", "description": "", "p": "mathlib"}, {"name": "lie_module_hom", "description": " A morphism of Lie algebra modules is a linear map which commutes with the action of the Lie\nalgebra.", "p": "mathlib"}, {"name": "lie_module_hom.to_linear_map", "description": " A morphism of Lie algebra modules is a linear map which commutes with the action of the Lie\nalgebra.", "p": "mathlib"}, {"name": "lie_module_hom.map_lie'", "description": " A morphism of Lie algebra modules is a linear map which commutes with the action of the Lie\nalgebra.", "p": "mathlib"}, {"name": "lie_module_equiv.refl", "description": "Lie module equivalences are reflexive.", "p": "mathlib"}, {"name": "lie_equiv.apply_symm_apply", "description": "", "p": "mathlib"}, {"name": "lie_equiv.self_trans_symm", "description": "", "p": "mathlib"}, {"name": "lie_neg", "description": "", "p": "mathlib"}, {"name": "lie_equiv.symm_trans_self", "description": "", "p": "mathlib"}, {"name": "lie_hom.one_apply", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.map_smul", "description": "", "p": "mathlib"}, {"name": "lie_hom.inverse", "description": "The inverse of a bijective morphism is a morphism.", "p": "mathlib"}, {"name": "lie_equiv.of_bijective_to_lie_hom_to_linear_map_apply", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.coe_smul", "description": "", "p": "mathlib"}, {"name": "lie_hom.coe_to_linear_map", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.coe_zero", "description": "", "p": "mathlib"}, {"name": "lie_jacobi", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.sub_apply", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.smul_apply", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.map_lie\u2082", "description": "", "p": "mathlib"}, {"name": "lie_equiv.has_coe_to_lie_hom", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.ext", "description": "", "p": "mathlib"}, {"name": "lie_ring_self_module", "description": "", "p": "mathlib"}, {"name": "lie_zsmul", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.apply_symm_apply", "description": "", "p": "mathlib"}, {"name": "lie_equiv.to_linear_equiv_mk", "description": "", "p": "mathlib"}, {"name": "lie_hom.coe_linear_map_comp", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.coe_injective", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.coe_to_linear_map", "description": "", "p": "mathlib"}, {"name": "lie_equiv.inhabited", "description": "", "p": "mathlib"}, {"name": "lie_equiv.ext", "description": "", "p": "mathlib"}, {"name": "linear_map.lie_module", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.congr_fun", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.coe_to_lie_module_hom", "description": "", "p": "mathlib"}, {"name": "lie_lie", "description": "", "p": "mathlib"}, {"name": "lie_ring.int_lie_algebra", "description": "", "p": "mathlib"}, {"name": "lie_equiv.bijective", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.has_add", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.coe_comp", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.trans_apply", "description": "", "p": "mathlib"}, {"name": "lie_equiv.of_bijective_inv_fun", "description": "", "p": "mathlib"}, {"name": "lie_equiv.coe_to_lie_hom", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.has_one", "description": "", "p": "mathlib"}, {"name": "lie_hom.has_coe_to_fun", "description": "see Note [function coercion]", "p": "mathlib"}, {"name": "lie_hom.to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.inverse", "description": "The inverse of a bijective morphism of Lie modules is a morphism of Lie modules.", "p": "mathlib"}, {"name": "lie_module_hom.coe_zsmul", "description": "", "p": "mathlib"}, {"name": "lie_hom.coe_zero", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.add_comm_group", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.coe_to_linear_equiv", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.injective", "description": "", "p": "mathlib"}, {"name": "lie_hom.lie_apply", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.symm_symm", "description": "", "p": "mathlib"}, {"name": "lie_module", "description": " A Lie module is a module over a commutative ring, together with a linear action of a Lie\nalgebra on this module, such that the Lie bracket acts as the commutator of endomorphisms.", "p": "mathlib"}, {"name": "lie_module.smul_lie", "description": " A Lie module is a module over a commutative ring, together with a linear action of a Lie\nalgebra on this module, such that the Lie bracket acts as the commutator of endomorphisms.", "p": "mathlib"}, {"name": "lie_module.lie_smul", "description": " A Lie module is a module over a commutative ring, together with a linear action of a Lie\nalgebra on this module, such that the Lie bracket acts as the commutator of endomorphisms.", "p": "mathlib"}, {"name": "lie_module_equiv.one_apply", "description": "", "p": "mathlib"}, {"name": "lie_hom.map_neg", "description": "", "p": "mathlib"}, {"name": "smul_lie", "description": "", "p": "mathlib"}, {"name": "sub_lie", "description": "", "p": "mathlib"}, {"name": "linear_map.lie_ring_module", "description": "", "p": "mathlib"}, {"name": "zsmul_lie", "description": "", "p": "mathlib"}, {"name": "lie_hom.id_apply", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv", "description"