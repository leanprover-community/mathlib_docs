athlib"}, {"name": "add_order_of_dvd_of_mem_zmultiples", "description": "", "p": "mathlib"}, {"name": "is_of_fin_order_one", "description": "1 is of finite order in any monoid.", "p": "mathlib"}, {"name": "zmultiples_equiv_zmultiples_apply", "description": "", "p": "mathlib"}, {"name": "add_subgroup.nsmul_index_mem", "description": "", "p": "mathlib"}, {"name": "order_eq_card_zpowers", "description": "See also `nat.card_zpowers'`.", "p": "mathlib"}, {"name": "is_of_fin_order.of_mem_zpowers", "description": "", "p": "mathlib"}, {"name": "nsmul_coprime_apply", "description": "", "p": "mathlib"}, {"name": "zsmul_eq_mod_card", "description": "", "p": "mathlib"}, {"name": "order_of_pow_coprime", "description": "", "p": "mathlib"}, {"name": "mem_powers_iff_mem_zpowers", "description": "", "p": "mathlib"}, {"name": "exists_pow_eq_self_of_coprime", "description": "", "p": "mathlib"}, {"name": "is_of_fin_add_order.prod_mk", "description": "", "p": "mathlib"}, {"name": "add_order_of_nsmul_eq_zero", "description": "", "p": "mathlib"}, {"name": "add_inf_eq_bot_of_coprime", "description": "", "p": "mathlib"}, {"name": "pow_eq_mod_card", "description": "", "p": "mathlib"}, {"name": "add_order_of_dvd_iff_nsmul_eq_zero", "description": "", "p": "mathlib"}, {"name": "add_order_of_nsmul''", "description": "", "p": "mathlib"}, {"name": "order_of_inv", "description": "", "p": "mathlib"}, {"name": "monoid_hom.is_of_fin_order", "description": "The image of an element of finite order has finite order.", "p": "mathlib"}, {"name": "is_of_fin_add_order.fst", "description": "", "p": "mathlib"}, {"name": "add_order_of_fst_dvd_add_order_of", "description": "", "p": "mathlib"}, {"name": "add_commute.add_order_of_add_dvd_mul_add_order_of", "description": "", "p": "mathlib"}, {"name": "nsmul_eq_mod_add_order_of", "description": "", "p": "mathlib"}, {"name": "commute.order_of_mul_eq_mul_order_of_of_coprime", "description": "", "p": "mathlib"}, {"name": "order_of_of_add_eq_add_order_of", "description": "", "p": "mathlib"}, {"name": "add_commute.add_order_of_add_eq_right_of_forall_prime_mul_dvd", "description": "If each prime factor of\n  `add_order_of x` has higher multiplicity in `add_order_of y`, and `x` commutes with `y`,\n  then `x + y` has the same order as `y`.", "p": "mathlib"}, {"name": "order_of_dvd_card_univ", "description": "", "p": "mathlib"}, {"name": "add_monoid.order_of_eq_one_iff", "description": "", "p": "mathlib"}, {"name": "order_of_add_submonoid", "description": "", "p": "mathlib"}, {"name": "nsmul_eq_nsmul_iff_modeq", "description": "", "p": "mathlib"}, {"name": "exists_zsmul_eq_zero", "description": "", "p": "mathlib"}, {"name": "is_of_fin_order", "description": " `is_of_fin_order` is a predicate on an element `x` of a monoid to be of finite order, i.e. there\nexists `n \u2265 1` such that `x ^ n = 1`.", "p": "mathlib"}, {"name": "order_of_abs_ne_one", "description": "", "p": "mathlib"}, {"name": "fin_equiv_zpowers", "description": "The equivalence between `fin (order_of x)` and `subgroup.zpowers x`, sending `i` to `x ^ i`.", "p": "mathlib"}, {"name": "is_of_fin_order.zpow", "description": "", "p": "mathlib"}, {"name": "fin_equiv_zpowers_symm_apply", "description": "", "p": "mathlib"}, {"name": "commute.order_of_mul_eq_right_of_forall_prime_mul_dvd", "description": "If each prime factor of `order_of x` has higher multiplicity in `order_of y`, and `x` commutes\n with `y`, then `x * y` has the same order as `y`.", "p": "mathlib"}, {"name": "add_order_of_dvd_card_univ", "description": "", "p": "mathlib"}, {"name": "commute.order_of_mul_dvd_lcm", "description": "", "p": "mathlib"}, {"name": "add_commute.order_of_add_dvd_lcm", "description": "", "p": "mathlib"}, {"name": "order_of_pos", "description": "This is the same as `order_of_pos' but with one fewer explicit assumption since this is\n automatic in case of a finite cancellative monoid.", "p": "mathlib"}, {"name": "multiples_equiv_multiples", "description": "The equivalence between `submonoid.multiples` of two elements `a, b` of the same additive order,\n  mapping `i \u2022 a` to `i \u2022 b`.", "p": "mathlib"}, {"name": "order_of_dvd_nat_card", "description": "", "p": "mathlib"}, {"name": "pow_inj_mod", "description": "", "p": "mathlib"}, {"name": "zpow_eq_mod_order_of", "description": "", "p": "mathlib"}, {"name": "mem_powers_iff_mem_range_order_of", "description": "", "p": "mathlib"}, {"name": "order_of_pow_dvd", "description": "", "p": "mathlib"}, {"name": "fin_equiv_zmultiples_apply", "description": "", "p": "mathlib"}, {"name": "decidable_zpowers", "description": "", "p": "mathlib"}, {"name": "sum_card_add_order_of_eq_card_nsmul_eq_zero", "description": "", "p": "mathlib"}, {"name": "nsmul_coprime", "description": "If `gcd(|G|,n)=1` then the smul by `n` is a bijection", "p": "mathlib"}, {"name": "is_of_fin_add_order.of_mem_zmultiples", "description": "", "p": "mathlib"}, {"name": "zsmul_eq_zero_iff_modeq", "description": "", "p": "mathlib"}, {"name": "injective_zpow_iff_not_is_of_fin_order", "description": "", "p": "mathlib"}, {"name": "mem_multiples_iff_mem_range_add_order_of'", "description": "", "p": "mathlib"}, {"name": "is_of_fin_add_order_iff_nsmul_eq_zero", "description": "", "p": "mathlib"}, {"name": "mem_zpowers_iff_mem_range_order_of", "description": "", "p": "mathlib"}, {"name": "order_of_pow''", "description": "", "p": "mathlib"}, {"name": "exists_nsmul_eq_self_of_coprime", "description": "", "p": "mathlib"}, {"name": "add_order_of_le_card_univ", "description": "", "p": "mathlib"}, {"name": "infinite_not_is_of_fin_order", "description": "", "p": "mathlib"}, {"name": "add_order_of_pos", "description": "This is the same as `add_order_of_pos' but with one fewer explicit assumption since this is\n  automatic in case of a finite cancellative additive monoid.", "p": "mathlib"}, {"name": "add_order_of", "description": "`add_order_of a` is the order of the element `a`, i.e. the `n \u2265 1`, s.t. `n \u2022 a = 0` if it\nexists. Otherwise, i.e. if `a` is of infinite order, then `add_order_of a` is `0` by convention.", "p": "mathlib"}, {"name": "add_order_of_injective", "description": "", "p": "mathlib"}, {"name": "not_is_of_fin_add_order_of_injective_nsmul", "description": "See also\n`injective_nsmul_iff_not_is_of_fin_add_order`.", "p": "mathlib"}, {"name": "order_of_dvd_of_mem_zpowers", "description": "", "p": "mathlib"}, {"name": "multiples_equiv_multiples_apply", "description": "", "p": "mathlib"}, {"name": "zpow_eq_one_iff_modeq", "description": "", "p": "mathlib"}, {"name": "fin_equiv_powers_symm_apply", "description": "", "p": "mathlib"}, {"name": "is_of_fin_order_iff_coe", "description": "Elements of finite order are of finite order in submonoids.", "p": "mathlib"}, {"name": "zpowers_equiv_zpowers_apply", "description": "", "p": "mathlib"}, {"name": "zpowers_equiv_zpowers", "description": "The equivalence between `subgroup.zpowers` of two elements `x, y` of the same order, mapping\n `x ^ i` to `y ^ i`.", "p": "mathlib"}, {"name": "is_of_fin_add_order.add", "description": "Elements of finite additive order are closed under addition.", "p": "mathlib"}, {"name": "order_of_snd_dvd_order_of", "description": "", "p": "mathlib"}, {"name": "nsmul_coprime_zero", "description": "", "p": "mathlib"}, {"name": "nsmul_coprime_neg", "description": "", "p": "mathlib"}, {"name": "fin_equiv_zmultiples", "description": "The equivalence between `fin (add_order_of a)` and `subgroup.zmultiples a`, sending `i`\nto `i \u2022 a`.", "p": "mathlib"}, {"name": "nsmul_inj_iff_of_add_order_of_eq_zero", "description": "", "p": "mathlib"}, {"name": "order_of_dvd_iff_pow_eq_one", "description": "", "p": "mathlib"}, {"name": "exists_order_of_eq_prime_pow_iff", "description": "", "p": "mathlib"}, {"name": "add_order_of_snd_dvd_add_order_of", "description": "", "p": "mathlib"}, {"name": "sequentially_complete.set_seq_mono", "description": "", "p": "mathlib"}, {"name": "sequentially_complete.set_seq_aux", "description": "An auxiliary sequence of sets approximating a Cauchy filter.", "p": "mathlib"}, {"name": "is_complete_iff_ultrafilter", "description": "", "p": "mathlib"}, {"name": "is_closed.is_complete", "description": "", "p": "mathlib"}, {"name": "uniform_space.first_countable_topology", "description": "", "p": "mathlib"}, {"name": "sequentially_complete.set_seq", "description": " Given a Cauchy filter `f` and a sequence `U` of entourages, `set_seq` provides\nan antitone sequence of sets `s n \u2208 f` such that `s n \u00d7\u02e2 s n \u2286 U`.", "p": "mathlib"}, {"name": "totally_bounded_iff_filter", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.cauchy_seq_iff'", "description": "", "p": "mathlib"}, {"name": "complete_space", "description": "A complete space is defined here using uniformities. A uniform space\n is complete if every Cauchy filter converges.", "p": "mathlib"}, {"name": "complete_space.complete", "description": "A complete space is defined here using uniformities. A uniform space\n is complete if every Cauchy filter converges.", "p": "mathlib"}, {"name": "sequentially_complete.seq", "description": " A sequence of points such that `seq n \u2208 set_seq n`. Here `set_seq` is an antitone\nsequence of sets `set_seq n \u2208 f` with diameters controlled by a given sequence\nof entourages.", "p": "mathlib"}, {"name": "is_complete.union", "description": "", "p": "mathlib"}, {"name": "uniform_space.second_countable_of_separable", "description": " A separable uniform space with countably generated uniformity filter is second countable:\none obtains a countable basis by taking the balls centered at points in a dense subset,\nand with rational \"radii\" from a countable open symmetric antitone basis of `\ud835\udce4 \u03b1`. We do not\nregister this as an instance, as there is already an instance going in the other direction\nfrom second countable spaces to separable spaces, and we want to avoid loops.", "p": "mathlib"}, {"name": "sequentially_complete.le_nhds_of_seq_tendsto_nhds", "description": "If the sequence `sequentially_complete.seq` converges to `a`, then `f \u2264 \ud835\udcdd a`.", "p": "mathlib"}, {"name": "sequentially_complete.set_seq_sub_aux", "description": "", "p": "mathlib"}, {"name": "sequentially_complete.seq_mem", "description": "", "p": "mathlib"}, {"name": "cauchy_iff'", "description": "", "p": "mathlib"}, {"name": "cauchy_nhds", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.tendsto_lim", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.subseq_mem_entourage", "description": "", "p": "mathlib"}, {"name": "cauchy.map", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.cauchy_map", "description": "", "p": "mathlib"}, {"name": "is_complete_iff_cluster_pt", "description": "", "p": "mathlib"}, {"name": "totally_bounded_subset", "description": "", "p": "mathlib"}, {"name": "is_compact_iff_totally_bounded_is_complete", "description": "", "p": "mathlib"}, {"name": "cauchy.comap'", "description": "", "p": "mathlib"}, {"name": "cauchy", "description": "A filter `f` is Cauchy if for every entourage `r`, there exists an\n `s \u2208 f` such that `s \u00d7 s \u2286 r`. This is a generalization of Cauchy\n sequences, because if `a : \u2115 \u2192 \u03b1` then the filter of sets containing\n cofinitely many of the `a n` is Cauchy iff `a` is a Cauchy sequence.", "p": "mathlib"}, {"name": "cauchy_seq.nonempty", "description": "", "p": "mathlib"}, {"name": "complete_space.add_opposite", "description": "", "p": "mathlib"}, {"name": "totally_bounded.image", "description": "The image of a totally bounded set under a uniformly continuous map is totally bounded.", "p": "mathlib"}, {"name": "cauchy.ultrafilter_of", "description": "", "p": "mathlib"}, {"name": "cauchy_seq_iff_tendsto", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.comp_injective", "description": "", "p": "mathlib"}, {"name": "cauchy_seq_iff'", "description": "", "p": "mathlib"}, {"name": "cauchy.comap", "description": "", "p": "mathlib"}, {"name": "sequentially_complete.set_seq_mem", "description": "", "p": "mathlib"}, {"name": "cauchy_seq_const", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.subseq_subseq_mem", "description": "", "p": "mathlib"}, {"name": "sequentially_complete.set_seq_prod_subset", "description": "", "p": "mathlib"}, {"name": "totally_bounded_iff_ultrafilter", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.totally_bounded_iff", "description": "", "p": "mathlib"}, {"name": "totally_bounded_of_forall_symm", "description": "", "p": "mathlib"}, {"name": "cauchy.mono", "description": "", "p": "mathlib"}, {"name": "is_complete_iff_ultrafilter'", "description": "", "p": "mathlib"}, {"name": "ultrafilter.cauchy_of_totally_bounded", "description": "", "p": "mathlib"}, {"name": "le_nhds_iff_adhp_of_cauchy", "description": "", "p": "mathlib"}, {"name": "complete_space.prod", "description": "", "p": "mathlib"}, {"name": "cauchy_seq", "description": " Cauchy sequences. Usually defined on \u2115, but often it is also useful to say that a function\ndefined on \u211d is Cauchy at +\u221e to deduce convergence. Therefore, we define it in a type class that\nis general enough to cover both \u2115 and \u211d, which are the main motivating examples.", "p": "mathlib"}, {"name": "cauchy_seq.mem_entourage", "description": "", "p": "mathlib"}, {"name": "cauchy_iff", "description": "", "p": "mathlib"}, {"name": "le_nhds_of_cauchy_adhp_aux", "description": " The common part of the proofs of `le_nhds_of_cauchy_adhp` and\n`sequentially_complete.le_nhds_of_seq_tendsto_nhds`: if for any entourage `s`\none can choose a set `t \u2208 f` of diameter `s` such that it contains a point `y`\nwith `(x, y) \u2208 s`, then `f` converges to `x`.", "p": "mathlib"}, {"name": "cauchy_pure", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.tendsto_uniformity", "description": "", "p": "mathlib"}, {"name": "totally_bounded_iff_subset", "description": "", "p": "mathlib"}, {"name": "complete_space.mul_opposite", "description": "", "p": "mathlib"}, {"name": "complete_space_iff_is_complete_univ", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.prod", "description": "", "p": "mathlib"}, {"name": "cauchy.prod", "description": "", "p": "mathlib"}, {"name": "complete_of_compact", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.subseq_mem", "description": "", "p": "mathlib"}, {"name": "is_complete_Union_separated", "description": "", "p": "mathlib"}, {"name": "cauchy_seq_of_controlled", "description": "", "p": "mathlib"}, {"name": "complete_univ", "description": "", "p": "mathlib"}, {"name": "totally_bounded.closure", "description": "The closure of a totally bounded set is totally bounded.", "p": "mathlib"}, {"name": "is_compact.is_complete", "description": "", "p": "mathlib"}, {"name": "is_complete", "description": " A set `s` is called *complete*, if any Cauchy filter `f` such that `s \u2208 f`\nhas a limit in `s` (formally, it satisfies `f \u2264 \ud835\udcdd x` for some `x \u2208 s`).", "p": "mathlib"}, {"name": "cauchy_seq.comp_tendsto", "description": "", "p": "mathlib"}, {"name": "uniform_space.complete_of_convergent_controlled_sequences", "description": " A uniform space is complete provided that (a) its uniformity filter has a countable basis;\n(b) any sequence satisfying a \"controlled\" version of the Cauchy condition converges.", "p": "mathlib"}, {"name": "uniform_space.complete_of_cauchy_seq_tendsto", "description": " A sequentially complete uniform space with a countable basis of the uniformity filter is\ncomplete.", "p": "mathlib"}, {"name": "cauchy_seq_tendsto_of_is_complete", "description": "If `K` is a complete subset, then any cauchy sequence in `K` converges to a point in `K`", "p": "mathlib"}, {"name": "cauchy.le_nhds_Lim", "description": "", "p": "mathlib"}, {"name": "complete_space_iff_ultrafilter", "description": "", "p": "mathlib"}, {"name": "cauchy.mono'", "description": "", "p": "mathlib"}, {"name": "sequentially_complete.seq_pair_mem", "description": "", "p": "mathlib"}, {"name": "cauchy_map_iff'", "description": "", "p": "mathlib"}, {"name": "totally_bounded", "description": "A set `s` is totally bounded if for every entourage `d` there is a finite\n set of points `t` such that every element of `s` is `d`-near to some element of `t`.", "p": "mathlib"}, {"name": "cauchy_map_iff", "description": "", "p": "mathlib"}, {"name": "cauchy_seq_tendsto_of_complete", "description": "A Cauchy sequence in a complete space converges", "p": "mathlib"}, {"name": "cauchy_seq.prod_map", "description": "", "p": "mathlib"}, {"name": "le_nhds_of_cauchy_adhp", "description": " If `x` is an adherent (cluster) point for a Cauchy filter `f`, then it is a limit point\nfor `f`.", "p": "mathlib"}, {"name": "tendsto_nhds_of_cauchy_seq_of_subseq", "description": "If a Cauchy sequence has a convergent subsequence, then it converges.", "p": "mathlib"}, {"name": "cauchy_iff_exists_le_nhds", "description": "", "p": "mathlib"}, {"name": "is_compact_of_totally_bounded_is_closed", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.eventually_eventually", "description": "", "p": "mathlib"}, {"name": "cauchy_seq.totally_bounded_range", "description": "Every Cauchy sequence over `\u2115` is totally bounded.", "p": "mathlib"}, {"name": "function.bijective.cauchy_seq_comp_iff", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.cauchy_seq_iff", "description": "", "p": "mathlib"}, {"name": "is_compact.totally_bounded", "description": "", "p": "mathlib"}, {"name": "complete_space_of_is_complete_univ", "description": "If `univ` is complete, the space is a complete space", "p": "mathlib"}, {"name": "totally_bounded_empty", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.cauchy_iff", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.cauchy_seq", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.comp_cauchy_seq", "description": "", "p": "mathlib"}, {"name": "totally_bounded.exists_subset", "description": "", "p": "mathlib"}, {"name": "cauchy_map_iff_exists_tendsto", "description": "", "p": "mathlib"}, {"name": "cauchy_seq_iff", "description": "", "p": "mathlib"}, {"name": "sequentially_complete.seq_is_cauchy_seq", "description": "", "p": "mathlib"}, {"name": "deriv_sub_const", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.const_add", "description": "", "p": "mathlib"}, {"name": "deriv_within_neg", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.add_const", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter_neg", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter.sub_const", "description": "", "p": "mathlib"}, {"name": "deriv_add_const", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.add_const", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_neg", "description": "", "p": "mathlib"}, {"name": "deriv_const_add", "description": "", "p": "mathlib"}, {"name": "deriv_neg'", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at.const_sub", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.neg", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at.neg", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.sum", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_filter.add", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.neg", "description": "", "p": "mathlib"}, {"name": "deriv_neg", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at.add", "description": "", "p": "mathlib"}, {"name": "deriv_within_add_const", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.const_sub", "description": "", "p": "mathlib"}, {"name": "deriv_const_add'", "description": "", "p": "mathlib"}, {"name": "deriv_within_const_add", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.const_add", "description": "", "p": "mathlib"}, {"name": "deriv_sub"