e_of_injective_subset_range", "description": "", "p": "mathlib"}, {"name": "set.ncard_eq_one", "description": "", "p": "mathlib"}, {"name": "set.ncard_diff_singleton_add_one", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.neg", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.exists_eq_const", "description": "", "p": "mathlib"}, {"name": "locally_constant.mul_indicator_of_mem", "description": "", "p": "mathlib"}, {"name": "locally_constant.flip_unflip", "description": "", "p": "mathlib"}, {"name": "locally_constant.map_comp", "description": "", "p": "mathlib"}, {"name": "locally_constant.of_clopen_fiber_zero", "description": "", "p": "mathlib"}, {"name": "is_locally_constant", "description": "A function between topological spaces is locally constant if the preimage of any set is open.", "p": "mathlib"}, {"name": "is_locally_constant.eq_const", "description": "", "p": "mathlib"}, {"name": "locally_constant.ext_iff", "description": "", "p": "mathlib"}, {"name": "locally_constant.map", "description": "Push forward of locally constant maps under any map, by post-composition.", "p": "mathlib"}, {"name": "is_locally_constant.is_open_fiber", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.add", "description": "", "p": "mathlib"}, {"name": "locally_constant.apply_eq_of_is_preconnected", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.apply_eq_of_preconnected_space", "description": "", "p": "mathlib"}, {"name": "locally_constant.comap_id", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.of_discrete", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.eventually_eq", "description": "", "p": "mathlib"}, {"name": "locally_constant.indicator_of_mem", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.one", "description": "", "p": "mathlib"}, {"name": "locally_constant.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.comp_continuous", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.prod_mk", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.div", "description": "", "p": "mathlib"}, {"name": "locally_constant.locally_constant_eq_of_fiber_zero_eq", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.desc", "description": " If a composition of a function `f` followed by an injection `g` is locally\nconstant, then the locally constant property descends to `f`.", "p": "mathlib"}, {"name": "is_locally_constant.range_finite", "description": "", "p": "mathlib"}, {"name": "locally_constant.coe_const", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.zero", "description": "", "p": "mathlib"}, {"name": "locally_constant.congr_fun", "description": "", "p": "mathlib"}, {"name": "locally_constant.mul_indicator_apply", "description": "", "p": "mathlib"}, {"name": "locally_constant.indicator_apply_eq_if", "description": "", "p": "mathlib"}, {"name": "locally_constant.unflip", "description": " If \u03b1 is finite, this constructs a locally constant function to `\u03b1 \u2192 \u03b2` given a\nfamily of locally constant functions with values in \u03b2 indexed by \u03b1.", "p": "mathlib"}, {"name": "is_locally_constant.mul", "description": "", "p": "mathlib"}, {"name": "locally_constant.comap", "description": " Pull back of locally constant maps under any map, by pre-composition.\n\nThis definition only makes sense if `f` is continuous,\nin which case it sends locally constant functions to their precomposition with `f`.\nSee also `locally_constant.coe_comap`.", "p": "mathlib"}, {"name": "locally_constant.to_continuous_map_eq_coe", "description": "", "p": "mathlib"}, {"name": "locally_constant.congr_arg", "description": "", "p": "mathlib"}, {"name": "locally_constant.ext", "description": "", "p": "mathlib"}, {"name": "locally_constant.inhabited", "description": "", "p": "mathlib"}, {"name": "locally_constant.coe_desc", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.iff_continuous", "description": "", "p": "mathlib"}, {"name": "locally_constant.mul_indicator_apply_eq_if", "description": "", "p": "mathlib"}, {"name": "locally_constant.of_clopen_fiber_one", "description": "", "p": "mathlib"}, {"name": "locally_constant.indicator_of_not_mem", "description": "", "p": "mathlib"}, {"name": "locally_constant.indicator", "description": "Given a clopen set `U` and a locally constant function `f`,\n `locally_constant.indicator` returns the locally constant function that is `f` on `U` and `0`\n otherwise.", "p": "mathlib"}, {"name": "locally_constant.apply_eq_of_preconnected_space", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.exists_open", "description": "", "p": "mathlib"}, {"name": "locally_constant.mul_indicator", "description": "Given a clopen set `U` and a locally constant function `f`, `locally_constant.mul_indicator`\n returns the locally constant function that is `f` on `U` and `1` otherwise.", "p": "mathlib"}, {"name": "locally_constant.const", "description": "The constant locally constant function on `X` with value `y : Y`.", "p": "mathlib"}, {"name": "locally_constant.to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.tfae", "description": "", "p": "mathlib"}, {"name": "locally_constant.map_apply", "description": "", "p": "mathlib"}, {"name": "locally_constant.eq_const", "description": "", "p": "mathlib"}, {"name": "locally_constant.to_continuous_map", "description": "We can turn a locally-constant function into a bundled `continuous_map`.", "p": "mathlib"}, {"name": "locally_constant.indicator_apply", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.of_constant", "description": "", "p": "mathlib"}, {"name": "locally_constant.desc", "description": " If a locally constant function factors through an injection, then it factors through a locally\nconstant function.", "p": "mathlib"}, {"name": "locally_constant.comap_const", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.iff_is_const", "description": "", "p": "mathlib"}, {"name": "locally_constant", "description": "A (bundled) locally constant function from a topological space `X` to a type `Y`.", "p": "mathlib"}, {"name": "locally_constant.to_fun", "description": "A (bundled) locally constant function from a topological space `X` to a type `Y`.", "p": "mathlib"}, {"name": "locally_constant.is_locally_constant", "description": "A (bundled) locally constant function from a topological space `X` to a type `Y`.", "p": "mathlib"}, {"name": "locally_constant.unflip_flip", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.is_clopen_fiber", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.comp\u2082", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.inv", "description": "", "p": "mathlib"}, {"name": "locally_constant.mul_indicator_of_not_mem", "description": "", "p": "mathlib"}, {"name": "locally_constant.flip", "description": " Given a locally constant function to `\u03b1 \u2192 \u03b2`, construct a family of locally constant\nfunctions with values in \u03b2 indexed by \u03b1.", "p": "mathlib"}, {"name": "locally_constant.continuous_map.has_coe", "description": "As a shorthand, `locally_constant.to_continuous_map` is available as a coercion", "p": "mathlib"}, {"name": "is_locally_constant.const", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.iff_eventually_eq", "description": "", "p": "mathlib"}, {"name": "locally_constant.coe_comap", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.is_closed_fiber", "description": "", "p": "mathlib"}, {"name": "locally_constant.comap_comp", "description": "", "p": "mathlib"}, {"name": "locally_constant.coe_mk", "description": "", "p": "mathlib"}, {"name": "locally_constant.continuous", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.sub", "description": "", "p": "mathlib"}, {"name": "locally_constant.coe_inj", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.iff_exists_open", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.of_constant_on_preconnected_clopens", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.continuous", "description": "", "p": "mathlib"}, {"name": "locally_constant.range_finite", "description": "", "p": "mathlib"}, {"name": "locally_constant.to_continuous_map_injective", "description": "", "p": "mathlib"}, {"name": "locally_constant.coe_injective", "description": "", "p": "mathlib"}, {"name": "locally_constant.of_clopen", "description": "The locally constant function to `fin 2` associated to a clopen set.", "p": "mathlib"}, {"name": "is_locally_constant.of_constant_on_connected_components", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.comp", "description": "", "p": "mathlib"}, {"name": "locally_constant.map_id", "description": "", "p": "mathlib"}, {"name": "locally_constant.coe_continuous_map", "description": "", "p": "mathlib"}, {"name": "locally_constant.exists_eq_const", "description": "", "p": "mathlib"}, {"name": "is_locally_constant.apply_eq_of_is_preconnected", "description": "A locally constant function is constant on any preconnected set.", "p": "mathlib"}, {"name": "category_theory.sieve.id_mem_iff_eq_top", "description": "If the identity arrow is in a sieve, the sieve is maximal.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback", "description": "If `R` is a sieve, then the `category_theory.presieve.functor_pullback` of `R` is actually a sieve.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_pushforward_le", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.Inf_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pushforward", "description": "Given a presieve on `X`, we can define a presieve on `F(X)` (which is actually a sieve)\nby taking the sieve generated by the image via `F`.", "p": "mathlib"}, {"name": "category_theory.sieve.gi_generate", "description": "Show that there is a galois insertion (generate, set_over).", "p": "mathlib"}, {"name": "category_theory.sieve.sieve_of_subfunctor_functor_inclusion", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.nat_trans_of_le_app_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor", "description": "A sieve induces a presheaf.", "p": "mathlib"}, {"name": "category_theory.sieve.le_functor_pushforward_pullback", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.bind_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pushforward_extend_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_inter", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.arrows_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_map_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.nat_trans_of_le_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pushforward_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.Sup_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.le_generate", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.le_pullback_bind", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.cocone", "description": "Given a sieve `S` on `X : C`, its associated cocone `S.cocone` is defined to be\n   the natural cocone over the diagram defined above with cocone point `X`.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_bot", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_top", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.sieve_of_subfunctor", "description": "A natural transformation to a representable functor induces a sieve. This is the left inverse of\n`functor_inclusion`, shown in `sieve_of_functor_inclusion`.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pushforward_monotone", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.bind", "description": "Given a set of arrows `S` all with codomain `X`, and a set of arrows with codomain `Y` for each\n`f : Y \u27f6 X` in `S`, produce a set of arrows with codomain `X`:\n`{ g \u226b f | (f : Y \u27f6 X) \u2208 S, (g : Z \u27f6 Y) \u2208 R f }`.", "p": "mathlib"}, {"name": "category_theory.sieve.pullback", "description": "Given a morphism `h : Y \u27f6 X`, send a sieve S on X to a sieve on Y\n   as the inverse image of S with `_ \u226b h`.\n   That is, `sieve.pullback S h := (\u226b h) '\u207b\u00b9 S`.", "p": "mathlib"}, {"name": "category_theory.sieve.galois_coinsertion_of_mono", "description": "If `f` is a monomorphism, the pushforward-pullback adjunction on sieves is coreflective.", "p": "mathlib"}, {"name": "category_theory.sieve.galois_connection", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_union", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.bind_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.of_arrows_punit", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pushforward_bot", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.downward_closed", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.generate_of_contains_is_split_epi", "description": "If an arrow set contains a split epi, it generates the maximal sieve.", "p": "mathlib"}, {"name": "category_theory.sieve.pushforward", "description": "Push a sieve `R` on `Y` forward along an arrow `f : Y \u27f6 X`: `gf : Z \u27f6 X` is in the sieve if `gf`\nfactors through some `g : Z \u27f6 Y` which is in `R`.", "p": "mathlib"}, {"name": "category_theory.presieve.of_arrows_pullback", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.image_mem_functor_pushforward", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.pullback_singleton", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_inter", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.generate_top", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pushforward_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.singleton_eq_iff_domain", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.singleton", "description": "The singleton presieve.", "p": "mathlib"}, {"name": "category_theory.presieve.singleton.mk", "description": "The singleton presieve.", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_top", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.pullback_arrows", "description": "Pullback a set of arrows with given codomain along a fixed map, by taking the pullback in the\ncategory.\nThis is not the same as the arrow set of `sieve.pullback`, but there is a relation between them\nin `pullback_arrows_comm`.", "p": "mathlib"}, {"name": "category_theory.presieve.pullback_arrows.mk", "description": "Pullback a set of arrows with given codomain along a fixed map, by taking the pullback in the\ncategory.\nThis is not the same as the arrow set of `sieve.pullback`, but there is a relation between them\nin `pullback_arrows_comm`.", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pushforward_structure", "description": "An auxillary definition in order to fix the choice of the preimages between various definitions.", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pushforward_structure.preobj", "description": "An auxillary definition in order to fix the choice of the preimages between various definitions.", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pushforward_structure.premap", "description": "An auxillary definition in order to fix the choice of the preimages between various definitions.", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pushforward_structure.lift", "description": "An auxillary definition in order to fix the choice of the preimages between various definitions.", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pushforward_structure.cover", "description": "An auxillary definition in order to fix the choice of the preimages between various definitions.", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pushforward_structure.fac", "description": "An auxillary definition in order to fix the choice of the preimages between various definitions.", "p": "mathlib"}, {"name": "category_theory.sieve.inter_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.diagram", "description": "Given a sieve `S` on `X : C`, its associated diagram `S.diagram` is defined to be\n   the natural functor from the full subcategory of the over category `C/X` consisting\n   of arrows in `S` to `C`.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pushforward", "description": "The sieve generated by the image of `R` under `F`.", "p": "mathlib"}, {"name": "category_theory.sieve.sieve_of_subfunctor_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pullback", "description": "Given a presieve on `F(X)`, we can define a presieve on `X` by taking the preimage via `F`.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_inclusion_app", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.galois_insertion_of_is_split_epi", "description": "If `f` is a split epi, the pushforward-pullback adjunction on sieves is reflective.", "p": "mathlib"}, {"name": "category_theory.sieve.complete_lattice", "description": "Sieves on an object `X` form a complete lattice.\nWe generate this directly rather than using the galois insertion for nicer definitional properties.", "p": "mathlib"}, {"name": "category_theory.presieve.of_arrows_bind", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pushforward_monotone", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve", "description": "A set of arrows all with codomain `X`.", "p": "mathlib"}, {"name": "category_theory.sieve.pushforward_apply_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_arrows_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.generate", "description": "Generate the smallest sieve containing the given set of arrows.", "p": "mathlib"}, {"name": "category_theory.sieve.ess_surj_full_functor_galois_insertion", "description": "When `F` is essentially surjective and full, the galois connection is a galois insertion.", "p": "mathlib"}, {"name": "category_theory.sieve.generate_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_galois_connection", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.singleton_self", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.complete_lattice", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pushforward_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_inclusion_top_is_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pushforward_union", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.inter", "description": "The intersection of two sieves is a sieve.", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_eq_top_of_mem", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.image_mem_functor_pushforward", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.Inf", "description": "The infimum of a collection of sieves: the intersection of them all.", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_id", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_arrows", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.of_arrows", "description": "Construct the presieve given by the family of arrows indexed by `\u03b9`.", "p": "mathlib"}, {"name": "category_theory.presieve.of_arrows.mk", "description": "Construct the presieve given by the family of arrows indexed by `\u03b9`.", "p": "mathlib"}, {"name": "category_theory.presieve.get_functor_pushforward_structure", "description": "The fixed choice of a preimage.", "p": "mathlib"}, {"name": "category_theory.sieve.generate_of_singleton_is_split_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.Sup", "description": "The supremum of a collection of sieves: the union of them all.", "p": "mathlib"}, {"name": "category_theory.sieve.nat_trans_of_le", "description": "If a sieve S is contained in a sieve T, then we have a morphism of presheaves on their induced\npresheaves.", "p": "mathlib"}, {"name": "category_theory.sieve.ext_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.top_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_eq_top_iff_mem", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pushforward_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pushforward_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.le_pushforward_pullback", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_id", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.sets_iff_generate", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.bind", "description": "Given a presieve on `X`, and a sieve on each domain of an arrow in the presieve, we can bind to\nproduce a sieve on `X`.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_inclusion", "description": "The natural inclusion from the functor induced by a sieve to the yoneda embedding.", "p": "mathlib"}, {"name": "category_theory.sieve.generate_sieve", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_pushforward_le", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pullback_mem", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pushforward_union", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve", "description": "For an object `X` of a category `C`, a `sieve X` is a set of morphisms to `X` which is closed under\nleft-composition.", "p": "mathlib"}, {"name": "category_theory.sieve.arrows", "description": "For an object `X` of a category `C`, a `sieve X` is a set of morphisms to `X` which is closed under\nleft-composition.", "p": "mathlib"}, {"name": "category_theory.sieve.downward_closed'", "description": "For an object `X` of a category `C`, a `sieve X` is a set of morphisms to `X` which is closed under\nleft-composition.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pushforward_id", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pullback_monotone", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.pushforward_le_bind_of_mem", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_inclusion_is_mono", "description": "The presheaf induced by a sieve is a subobject of the yoneda embedding.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.union", "description": "The union of two sieves is a sieve.", "p": "mathlib"}, {"name": "category_theory.sieve.fully_faithful_functor_galois_coinsertion", "description": "When `F` is fully faithful, the galois connection is a galois coinsertion.", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pushforward_top", "description": "", "p": "mathlib"}, {"name": "category_theory.presieve.functor_pullback_id", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.functor_pullback_monotone", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.union_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.sieve.sieve_inhabited", "description": "The maximal sieve always exists.", "p": "mathlib"}, {"name": "mul_opposite.module", "description": "`mul_opposite.distrib_mul_action` extends to a `module`", "p": "mathlib"}, {"name": "mul_opposite.coe_op_linear_equiv", "description": "", "p": "mathlib"}, {"name": "mul_opposite.coe_op_linear_equiv_symm_to_linear_map", "description": "", "p": "mathlib"}, {"name": "mul_opposite.op_linear_equiv_to_add_equiv", "description": "", "p": "mathlib"}, {"name": "mul_opposite.coe_op_linear_equiv_symm", "description": "", "p": "mathlib"}, {"name": "mul_opposite.op_linear_equiv_symm_to_add_equiv", "description": "", "p": "mathlib"}, {"name": "mul_opposite.op_linear_equiv", "description": "The function `op` is a linear equivalence.", "p": "mathlib"}, {"name": "mul_opposite.coe_op_linear_equiv_to_linear_map", "description": "", "p": "mathlib"}, {"name": "filter.blimsup", "description": " The `blimsup` of a function `u` along a filter `f`, bounded by a predicate `p`, is the infimum\nof the `a` such that, eventually for `f`, `u x \u2264 a` whenever `p x` holds.", "p": "mathlib"}, {"name": "monotone.is_bounded_under_ge_comp", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_congr'", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_le_of_top", "description": "", "p": "mathlib"}, {"name": "filter.mono_bliminf", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under_le_abs", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.limsup_eq_infi_supr", "description": "", "p": "mathlib"}, {"name": "filter.liminf_eq", "description": "", "p": "mathlib"}, {"name": "filter.le_limsup_of_frequently_le", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded.is_bounded_under", "description": "", "p": "mathlib"}, {"name": "filter.liminf_eq_supr_infi", "description": " In a complete lattice, the liminf of a function is the infimum over sets `s` in the filter\nof the supremum of the function over `s`", "p": "mathlib"}, {"name": "filter.bliminf_congr'", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.is_bounded_under_le_at_bot", "description": "", "p": "mathlib"}, {"name": "filter.limsup_eq_infi_supr", "description": " In a complete lattice, the limsup of a function is the infimum over sets `s` in the filter\nof the supremum of the function over `s`", "p": "mathlib"}, {"name": "filter.is_bounded_under.mono", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_top", "description": "", "p": "mathlib"}, {"name": "filter.cofinite.liminf_set_eq", "description": " In other words, `liminf cofinite s` is the set of elements lying outside the family `s`\nfinitely often.", "p": "mathlib"}, {"name": "filter.is_bounded_under_le_neg", "description": "", "p": "mathlib"}, {"name": "filter.bliminf_eq", "description": "", "p": "mathlib"}, {"name": "filter.le_Limsup_of_le", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_monotone_filter", "description": "", "p": "mathlib"}, {"name": "filter.liminf_nat_add", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_eq_infi_bsupr", "description": "", "p": "mathlib"}, {"name": "filter.frequently_lt_of_Liminf_lt", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_true", "description": "", "p": "mathlib"}, {"name": "filter.sup_liminf", "description": "", "p": "mathlib"}, {"name": "filter.liminf_congr", "description": "", "p": "mathlib"}, {"name": "filter.bdd_below_range_of_tendsto_at_top_at_top", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under_le_sup", "description": "", "p": "mathlib"}, {"name": "filter.order_iso.apply_blimsup", "description": "", "p": "mathlib"}, {"name": "filter.liminf_le_liminf", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under.inf", "description": "", "p": "mathlib"}, {"name": "filter.complete_lattice_hom.apply_liminf_iterate", "description": " If `f : \u03b1 \u2192 \u03b1` is a morphism of complete lattices, then the liminf of its iterates of any\n`a : \u03b1` is a fixed point.", "p": "mathlib"}, {"name": "filter.exists_forall_mem_of_has_basis_mem_blimsup", "description": "", "p": "mathlib"}, {"name": "filter.order_iso.apply_bliminf", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_principal", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under.bdd_below_range", "description": "", "p": "mathlib"}, {"name": "filter.le_limsup_of_le", "description": "", "p": "mathlib"}, {"name": "filter.exists_forall_mem_of_has_basis_mem_blimsup'", "description": "", "p": "mathlib"}, {"name": "filter.liminf_eq_supr_infi_of_nat", "description": "", "p": "mathlib"}, {"name": "filter.is_cobounded_top", "description": "", "p": "mathlib"}, {"name": "filter.limsup_le_limsup", "description": "", "p": "mathlib"}, {"name": "filter.liminf_const_top", "description": "Same as limsup_const applied to `\u22a4` but without the `ne_bot f` assumption", "p": "mathlib"}, {"name": "filter.liminf_le_liminf_of_le", "description": "", "p": "mathlib"}, {"name": "filter.eventually_lt_of_lt_liminf", "description": "", "p": "mathlib"}, {"name": "filter.limsup_congr", "description": "", "p": "mathlib"}, {"name": "antitone.is_bounded_under_ge_comp", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_mono", "description": "", "p": "mathlib"}, {"name": "filter.Sup_hom.apply_blimsup_le", "description": "", "p": "mathlib"}, {"name": "filter.Liminf", "description": " The `Liminf` of a filter `f` is the supremum of the `a` such that, eventually for `f`,\nholds `x \u2265 a`.", "p": "mathlib"}, {"name": "filter.is_bounded.mono", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded", "description": " `f.is_bounded (\u227a)`: the filter `f` is eventually bounded w.r.t. the relation `\u227a`, i.e.\neventually, it is bounded by some uniform bound.\n`r` will be usually instantiated with `\u2264` or `\u2265`.", "p": "mathlib"}, {"name": "filter.is_bounded_under.sup", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_eq", "description": "", "p": "mathlib"}, {"name": "filter.is_cobounded.mono", "description": "", "p": "mathlib"}, {"name": "filter.bliminf_sup_le_and", "description": "", "p": "mathlib"}, {"name": "filter.liminf_le_of_frequently_le", "description": "", "p": "mathlib"}, {"name": "filter.cofinite.limsup_set_eq", "description": " In other words, `limsup cofinite s` is the set of elements lying inside the family `s`\ninfinitely often.", "p": "mathlib"}, {"name": "filter.frequently_lt_of_lt_Limsup", "description": "", "p": "mathlib"}, {"name": "filter.liminf_le_limsup", "description": "", "p": "mathlib"}, {"name": "order_iso.is_bounded_under_le_comp", "description": "", "p": "mathlib"}, {"name": "filter.limsup_le_limsup_of_le", "description": "", "p": "mathlib"}, {"name": "filter.is_cobounded", "description": " `is_cobounded (\u227a) f` states that the filter `f` does not tend to infinity w.r.t. `\u227a`. This is\nalso called frequently bounded. Will be usually instantiated with `\u2264` or `\u2265`.\n\nThere is a subtlety in this definition: we want `f.is_cobounded` to hold for any `f` in the case of\ncomplete lattices. This will be relevant to deduce theorems on complete lattices from their\nversions on conditionally complete lattices with additional assumptions. We have to be careful in\nthe edge case of the trivial filter containing the empty set: the other natural definition\n  `\u00ac \u2200 a, \u2200\u1da0 n in f, a \u2264 n`\nwould not work as well in this case.", "p": "mathlib"}, {"name": "filter.Limsup_eq_infi_Sup", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_default", "description": " Filters are automatically bounded or cobounded in complete lattices. To use the same statements\nin complete and conditionally complete lattices but let automation fill automatically the\nboundedness proofs in complete lattices, we use the tactic `is_bounded_default` in the statements,\nin the form `(hf : f.is_bounded (\u2265) . is_bounded_default)`.", "p": "mathlib"}, {"name": "filter.sdiff_limsup", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under_const", "description": "", "p": "mathlib"}, {"name": "filter.Liminf_le_of_le", "description": "", "p": "mathlib"}, {"name": "filter.liminf_eq_Sup_Inf", "description": "", "p": "mathlib"}, {"name": "antitone.is_bounded_under_le_comp", "description": "", "p": "mathlib"}, {"name": "filter.is_cobounded.mk", "description": " To check that a filter is frequently bounded, it suffices to have a witness\nwhich bounds `f` at some point for every admissible set.\n\nThis is only an implication, as the other direction is wrong for the trivial filter.", "p": "mathlib"}, {"name": "filter.is_bounded_ge_at_top", "description": "", "p": "mathlib"}, {"name": "filter.gt_mem_sets_of_Liminf_gt", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_sup_le_or", "description": "See also `filter.blimsup_or_eq_sup`.", "p": "mathlib"}, {"name": "filter.limsup_eq_Inf_Sup", "description": "", "p": "mathlib"}, {"name": "filter.limsup", "description": " The `limsup` of a function `u` along a filter `f` is the infimum of the `a` such that,\neventually for `f`, holds `u x \u2264 a`.", "p": "mathlib"}, {"name": "filter.has_basis.Liminf_eq_supr_Inf", "description": "", "p": "mathlib"}, {"name": "filter.complete_lattice_hom.apply_limsup_iterate", "description": " If `f : \u03b1 \u2192 \u03b1` is a morphism of complete lattices, then the limsup of its iterates of any\n`a : \u03b1` is a fixed point.", "p": "mathlib"}, {"name": "filter.liminf_le_of_le", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_false", "description": "", "p": "mathlib"}, {"name": "filter.liminf_le_of_frequently_le'", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_le_at_bot", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under_ge_inv", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under.bdd_above_range", "description": "", "p": "mathlib"}, {"name": "filter.Limsup_le_Limsup", "description": "", "p": "mathlib"}, {"name": "filter.bdd_above_range_of_tendsto_at_top_at_bot", "description": "", "p": "mathlib"}, {"name": "filter.mono_blimsup", "description": "", "p": "mathlib"}, {"name": "filter.Limsup_principal", "description": "", "p": "mathlib"}, {"name": "filter.limsup_sdiff", "description": "", "p": "mathlib"}, {"name": "filter.limsup_eq_infi_supr_of_nat", "description": "", "p": "mathlib"}, {"name": "filter.not_is_bounded_under_of_tendsto_at_top", "description": "", "p": "mathlib"}, {"name": "filter.Liminf_le_Liminf_of_le", "description": "", "p": "mathlib"}, {"name": "filter.frequently_lt_of_lt_limsup", "description": "", "p": "mathlib"}, {"name": "filter.le_liminf_of_le", "description": "", "p": "mathlib"}, {"name": "filter.Liminf_top", "description": "", "p": "mathlib"}, {"name": "filter.liminf_const", "description": "", "p": "mathlib"}, {"name": "filter.le_limsup_of_frequently_le'", "description": "", "p": "mathlib"}, {"name": "filter.mono_bliminf'", "description": "", "p": "mathlib"}, {"name": "filter.bliminf_or_eq_inf", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under_of", "description": "A bounded function `u` is in particular eventually bounded.", "p": "mathlib"}, {"name": "filter.is_bounded_under.mono_le", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_or_eq_sup", "description": "", "p": "mathlib"}, {"name": "order_iso.is_bounded_under_ge_comp", "description": "", "p": "mathlib"}, {"name": "filter.bliminf_true", "description": "", "p": "mathlib"}, {"name": "filter.eventually_lt_of_limsup_lt", "description": "", "p": "mathlib"}, {"name": "filter.Liminf_bot", "description": "", "p": "mathlib"}, {"name": "filter.Liminf_le_Limsup", "description": "", "p": "mathlib"}, {"name": "filter.blimsup_eq_infi_bsupr_of_nat", "description": "", "p": "mathlib"}, {"name": "filter.bliminf_antitone", "description": "", "p": "mathlib"}, {"name": "order_iso.liminf_apply", "description": "", "p": "mathlib"}, {"name": "filter.limsup_le_supr", "description": "", "p": "mathlib"}, {"name": "filter.liminf_eq_supr_infi_of_nat'", "description": "", "p": "mathlib"}, {"name": "filter.limsup_nat_add", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_sup", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under_le_inv", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under_ge_neg", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under.mono_ge", "description": "", "p": "mathlib"}, {"name": "filter.is_bounded_under.bdd_below_range_of_cofinite", "description": "", "p": "mathlib"}, {"name": "monotone.is_bounded_under_le_comp", "description": "", "p": "mathlib"}, {"name": "filter.has_basis.liminf_eq_supr_infi", "description": "", "p": "mathlib"}, {"name": "filter.cofinite.bliminf_set_eq", "description": "", "p": "mathlib"}, {"name": "filter.bliminf", "description": " The `bliminf` of a function `u` along a filter `f`, bounded by a predicate `p`, is the supremum\nof the `a` such that, eventually for `f`, `a \u2264 u x` whenever `p x` 