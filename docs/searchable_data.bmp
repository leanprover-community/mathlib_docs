athlib"}, {"name": "equiv.trans_to_local_equiv", "description": "", "p": "mathlib"}, {"name": "local_equiv.refl_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.is_image.preimage_eq", "description": "**Alias** of the forward direction of `local_equiv.is_image.iff_preimage_eq`.", "p": "mathlib"}, {"name": "local_equiv.trans_self_symm", "description": " Composition of a local equiv and its inverse is equivalent to the restriction of the identity\nto the source", "p": "mathlib"}, {"name": "equiv.to_local_equiv_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.copy_target", "description": "", "p": "mathlib"}, {"name": "equiv.symm_to_local_equiv", "description": "", "p": "mathlib"}, {"name": "local_equiv.ext", "description": "Two local equivs that have the same `source`, same `to_fun` and same `inv_fun`, coincide.", "p": "mathlib"}, {"name": "local_equiv.is_image.restr_symm_apply", "description": "", "p": "mathlib"}, {"name": "local_equiv.trans_source'", "description": "", "p": "mathlib"}, {"name": "local_equiv.map_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.symm_source", "description": "", "p": "mathlib"}, {"name": "local_equiv.symm_image_target_eq_source", "description": "", "p": "mathlib"}, {"name": "equiv.to_local_equiv_apply", "description": "", "p": "mathlib"}, {"name": "local_equiv.coe_trans", "description": "", "p": "mathlib"}, {"name": "local_equiv.trans_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.is_image", "description": " We say that `t : set \u03b2` is an image of `s : set \u03b1` under a local equivalence if\nany of the following equivalent conditions hold:\n\n* `e '' (e.source \u2229 s) = e.target \u2229 t`;\n* `e.source \u2229 e \u207b\u00b9 t = e.source \u2229 s`;\n* `\u2200 x \u2208 e.source, e x \u2208 t \u2194 x \u2208 s` (this one is used in the definition).", "p": "mathlib"}, {"name": "local_equiv.is_image.restr", "description": "Restrict a `local_equiv` to a pair of corresponding sets.", "p": "mathlib"}, {"name": "local_equiv.is_image.of_preimage_eq", "description": "**Alias** of the reverse direction of `local_equiv.is_image.iff_preimage_eq`.", "p": "mathlib"}, {"name": "local_equiv.symm_symm", "description": "", "p": "mathlib"}, {"name": "local_equiv.is_image.restr_apply", "description": "", "p": "mathlib"}, {"name": "local_equiv.pi_target", "description": "", "p": "mathlib"}, {"name": "equiv.trans_local_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "equiv.to_local_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "local_equiv.is_image.of_symm_preimage_eq", "description": "**Alias** of the reverse direction of `local_equiv.is_image.iff_symm_preimage_eq`.", "p": "mathlib"}, {"name": "local_equiv.piecewise_symm_apply", "description": "", "p": "mathlib"}, {"name": "local_equiv.eq_on_source.source_eq", "description": "Two equivalent local equivs have the same source", "p": "mathlib"}, {"name": "local_equiv.eq_on_source_setoid", "description": "`eq_on_source` is an equivalence relation", "p": "mathlib"}, {"name": "local_equiv.eq_on_source.eq_on", "description": "Two equivalent local equivs coincide on the source", "p": "mathlib"}, {"name": "local_equiv.trans_refl_restr", "description": "", "p": "mathlib"}, {"name": "local_equiv.symm_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.prod_coe_symm", "description": "", "p": "mathlib"}, {"name": "local_equiv.piecewise_apply", "description": "", "p": "mathlib"}, {"name": "local_equiv.image_source_eq_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.copy_symm_apply", "description": "", "p": "mathlib"}, {"name": "local_equiv.restr", "description": "Restricting a local equivalence to e.source \u2229 s", "p": "mathlib"}, {"name": "local_equiv.copy_source", "description": "", "p": "mathlib"}, {"name": "local_equiv.refl_source", "description": "", "p": "mathlib"}, {"name": "local_equiv.left_inv", "description": "", "p": "mathlib"}, {"name": "set.bij_on.to_local_equiv_apply", "description": "", "p": "mathlib"}, {"name": "equiv.to_local_equiv", "description": "Associating a local_equiv to an equiv", "p": "mathlib"}, {"name": "local_equiv.forall_mem_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.prod_source", "description": "", "p": "mathlib"}, {"name": "local_equiv.refl_prod_refl", "description": "", "p": "mathlib"}, {"name": "local_equiv.image_source_inter_eq'", "description": "", "p": "mathlib"}, {"name": "equiv.refl_to_local_equiv", "description": "", "p": "mathlib"}, {"name": "local_equiv.trans'", "description": " Composing two local equivs if the target of the first coincides with the source of the\nsecond.", "p": "mathlib"}, {"name": "local_equiv.pi_apply", "description": "", "p": "mathlib"}, {"name": "local_equiv.restr_univ", "description": "", "p": "mathlib"}, {"name": "local_equiv.surj_on", "description": "", "p": "mathlib"}, {"name": "local_equiv.coe_trans_symm", "description": "", "p": "mathlib"}, {"name": "local_equiv.trans_equiv", "description": " Postcompose a local equivalence with an equivalence.\nWe modify the source and target to have better definitional behavior.", "p": "mathlib"}, {"name": "tactic.interactive.mfld_set_tac", "description": " A very basic tactic to show that sets showing up in manifolds coincide or are included in\none another.", "p": "mathlib"}, {"name": "local_equiv.eq_on_source.target_eq", "description": "Two equivalent local equivs have the same target", "p": "mathlib"}, {"name": "local_equiv.copy", "description": "Create a copy of a `local_equiv` providing better definitional equalities.", "p": "mathlib"}, {"name": "local_equiv.inhabited", "description": "", "p": "mathlib"}, {"name": "local_equiv.eq_on_source_refl", "description": "", "p": "mathlib"}, {"name": "local_equiv.coe_symm_mk", "description": "", "p": "mathlib"}, {"name": "local_equiv", "description": " Local equivalence between subsets `source` and `target` of \u03b1 and \u03b2 respectively. The (global)\nmaps `to_fun : \u03b1 \u2192 \u03b2` and `inv_fun : \u03b2 \u2192 \u03b1` map `source` to `target` and conversely, and are inverse\nto each other there. The values of `to_fun` outside of `source` and of `inv_fun` outside of `target`\nare irrelevant.", "p": "mathlib"}, {"name": "local_equiv.to_fun", "description": " Local equivalence between subsets `source` and `target` of \u03b1 and \u03b2 respectively. The (global)\nmaps `to_fun : \u03b1 \u2192 \u03b2` and `inv_fun : \u03b2 \u2192 \u03b1` map `source` to `target` and conversely, and are inverse\nto each other there. The values of `to_fun` outside of `source` and of `inv_fun` outside of `target`\nare irrelevant.", "p": "mathlib"}, {"name": "local_equiv.inv_fun", "description": " Local equivalence between subsets `source` and `target` of \u03b1 and \u03b2 respectively. The (global)\nmaps `to_fun : \u03b1 \u2192 \u03b2` and `inv_fun : \u03b2 \u2192 \u03b1` map `source` to `target` and conversely, and are inverse\nto each other there. The values of `to_fun` outside of `source` and of `inv_fun` outside of `target`\nare irrelevant.", "p": "mathlib"}, {"name": "local_equiv.source", "description": " Local equivalence between subsets `source` and `target` of \u03b1 and \u03b2 respectively. The (global)\nmaps `to_fun : \u03b1 \u2192 \u03b2` and `inv_fun : \u03b2 \u2192 \u03b1` map `source` to `target` and conversely, and are inverse\nto each other there. The values of `to_fun` outside of `source` and of `inv_fun` outside of `target`\nare irrelevant.", "p": "mathlib"}, {"name": "local_equiv.target", "description": " Local equivalence between subsets `source` and `target` of \u03b1 and \u03b2 respectively. The (global)\nmaps `to_fun : \u03b1 \u2192 \u03b2` and `inv_fun : \u03b2 \u2192 \u03b1` map `source` to `target` and conversely, and are inverse\nto each other there. The values of `to_fun` outside of `source` and of `inv_fun` outside of `target`\nare irrelevant.", "p": "mathlib"}, {"name": "local_equiv.map_source'", "description": " Local equivalence between subsets `source` and `target` of \u03b1 and \u03b2 respectively. The (global)\nmaps `to_fun : \u03b1 \u2192 \u03b2` and `inv_fun : \u03b2 \u2192 \u03b1` map `source` to `target` and conversely, and are inverse\nto each other there. The values of `to_fun` outside of `source` and of `inv_fun` outside of `target`\nare irrelevant.", "p": "mathlib"}, {"name": "local_equiv.map_target'", "description": " Local equivalence between subsets `source` and `target` of \u03b1 and \u03b2 respectively. The (global)\nmaps `to_fun : \u03b1 \u2192 \u03b2` and `inv_fun : \u03b2 \u2192 \u03b1` map `source` to `target` and conversely, and are inverse\nto each other there. The values of `to_fun` outside of `source` and of `inv_fun` outside of `target`\nare irrelevant.", "p": "mathlib"}, {"name": "local_equiv.left_inv'", "description": " Local equivalence between subsets `source` and `target` of \u03b1 and \u03b2 respectively. The (global)\nmaps `to_fun : \u03b1 \u2192 \u03b2` and `inv_fun : \u03b2 \u2192 \u03b1` map `source` to `target` and conversely, and are inverse\nto each other there. The values of `to_fun` outside of `source` and of `inv_fun` outside of `target`\nare irrelevant.", "p": "mathlib"}, {"name": "local_equiv.right_inv'", "description": " Local equivalence between subsets `source` and `target` of \u03b1 and \u03b2 respectively. The (global)\nmaps `to_fun : \u03b1 \u2192 \u03b2` and `inv_fun : \u03b2 \u2192 \u03b1` map `source` to `target` and conversely, and are inverse\nto each other there. The values of `to_fun` outside of `source` and of `inv_fun` outside of `target`\nare irrelevant.", "p": "mathlib"}, {"name": "local_equiv.image_trans_source", "description": "", "p": "mathlib"}, {"name": "local_equiv.disjoint_union_target", "description": "", "p": "mathlib"}, {"name": "equiv.trans_local_equiv_eq_trans", "description": "", "p": "mathlib"}, {"name": "local_equiv.disjoint_union_apply", "description": "", "p": "mathlib"}, {"name": "set.bij_on.to_local_equiv", "description": " A bijection between two sets `s : set \u03b1` and `t : set \u03b2` provides a local equivalence\nbetween `\u03b1` and `\u03b2`.", "p": "mathlib"}, {"name": "local_equiv.piecewise_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.refl_coe", "description": "", "p": "mathlib"}, {"name": "local_equiv.image_eq_target_inter_inv_preimage", "description": "", "p": "mathlib"}, {"name": "local_equiv.source_inter_preimage_target_inter", "description": "", "p": "mathlib"}, {"name": "local_equiv.of_set_coe", "description": "", "p": "mathlib"}, {"name": "local_equiv.trans_target'", "description": "", "p": "mathlib"}, {"name": "local_equiv.trans", "description": " Composing two local equivs, by restricting to the maximal domain where their composition\nis well defined.", "p": "mathlib"}, {"name": "local_equiv.prod_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.trans_assoc", "description": "", "p": "mathlib"}, {"name": "mfld_cfg", "description": "Common `@[simps]` configuration options used for manifold-related declarations.", "p": "mathlib"}, {"name": "local_equiv.eq_on_source.restr", "description": "Restriction of local equivs respects equivalence", "p": "mathlib"}, {"name": "local_equiv.is_image.iff_symm_preimage_eq", "description": "", "p": "mathlib"}, {"name": "local_equiv.inv_image_trans_target", "description": "", "p": "mathlib"}, {"name": "local_equiv.trans_symm_eq_symm_trans_symm", "description": "", "p": "mathlib"}, {"name": "local_equiv.is_image.symm_maps_to", "description": "", "p": "mathlib"}, {"name": "local_equiv.is_image.union", "description": "", "p": "mathlib"}, {"name": "local_equiv.eq_on_source.trans'", "description": "Composition of local equivs respects equivalence", "p": "mathlib"}, {"name": "local_equiv.right_inv_on", "description": "", "p": "mathlib"}, {"name": "local_equiv.inv_fun_as_coe", "description": "", "p": "mathlib"}, {"name": "local_equiv