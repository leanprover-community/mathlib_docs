eq_coe_nat_iff", "description": "", "p": "core"}, {"name": "int.of_nat_eq_coe", "description": "", "p": "core"}, {"name": "int.coe_nat_sub", "description": "", "p": "core"}, {"name": "int.has_mod", "description": "", "p": "core"}, {"name": "int.neg_neg_of_nat_succ", "description": "", "p": "core"}, {"name": "int.sign", "description": "", "p": "core"}, {"name": "int.nat_mod", "description": "", "p": "core"}, {"name": "int.neg_inj", "description": "", "p": "core"}, {"name": "int.neg_succ_of_nat_coe", "description": "", "p": "core"}, {"name": "int.neg_succ_of_nat_eq", "description": "", "p": "core"}, {"name": "int.sign_mul_nat_abs", "description": "", "p": "core"}, {"name": "int.has_neg", "description": "", "p": "core"}, {"name": "int.neg_succ_of_nat_of_nat", "description": "", "p": "core"}, {"name": "int.neg_of_nat_mul_neg_succ_of_nat", "description": "", "p": "core"}, {"name": "int.sub_nat_nat_of_sub_eq_zero", "description": "", "p": "core"}, {"name": "int.sub_nat_nat_sub", "description": "", "p": "core"}, {"name": "int.neg", "description": "", "p": "core"}, {"name": "int.nat_abs_one", "description": "", "p": "core"}, {"name": "int.to_nat_sub", "description": "", "p": "core"}, {"name": "int.of_nat_one", "description": "", "p": "core"}, {"name": "int.of_nat_add", "description": "", "p": "core"}, {"name": "int.neg_succ_of_nat_mul_neg_of_nat", "description": "", "p": "core"}, {"name": "int.of_nat_add_neg_succ_of_nat", "description": "", "p": "core"}, {"name": "int.sub_nat_nat_of_sub_eq_succ", "description": "", "p": "core"}, {"name": "int.sub_nat_nat_of_lt", "description": "", "p": "core"}, {"name": "int.nat_abs", "description": "", "p": "core"}, {"name": "int.neg_of_nat_mul_of_nat", "description": "", "p": "core"}, {"name": "int.fdiv", "description": "", "p": "core"}, {"name": "int.of_nat_succ", "description": "", "p": "core"}, {"name": "int.to_nat", "description": "", "p": "core"}, {"name": "int.neg_of_nat_of_succ", "description": "", "p": "core"}, {"name": "int.decidable_eq", "description": "", "p": "core"}, {"name": "int.neg_zero", "description": "", "p": "core"}, {"name": "int.of_nat_eq_of_nat_iff", "description": "", "p": "core"}, {"name": "int.mul_comm", "description": "", "p": "core"}, {"name": "int.add_left_comm", "description": "", "p": "core"}, {"name": "int.sub_nat_self", "description": "", "p": "core"}, {"name": "int.neg_of_nat_eq_sub_nat_nat_zero", "description": "", "p": "core"}, {"name": "int.gcd", "description": "", "p": "core"}, {"name": "int.add_assoc_aux2", "description": "", "p": "core"}, {"name": "int.of_nat_add_of_nat", "description": "", "p": "core"}, {"name": "int.eq_zero_of_nat_abs_eq_zero", "description": "", "p": "core"}, {"name": "int.neg_of_nat_add", "description": "", "p": "core"}, {"name": "int.of_nat_mul_neg_of_nat", "description": "", "p": "core"}, {"name": "int.coe_nat_mul", "description": "", "p": "core"}, {"name": "int.sub", "description": "", "p": "core"}, {"name": "int.zero_ne_one", "description": "", "p": "core"}, {"name": "int.sub_eq_add_neg", "description": "", "p": "core"}, {"name": "int.nat_abs_zero", "description": "", "p": "core"}, {"name": "int.div", "description": "", "p": "core"}, {"name": "probability_theory.truncation_zero", "description": "", "p": "mathlib"}, {"name": "probability_theory.truncation_eq_self", "description": "", "p": "mathlib"}, {"name": "probability_theory.strong_law_Lp", "description": " *Strong law of large numbers*, L\u1d56 version: if `X n` is a sequence of independent\nidentically distributed real-valued random variables in L\u1d56, then `\u2211 i in range n, X i / n`\nconverges in L\u1d56 to `\ud835\udd3c[X 0]`.", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.integrable_truncation", "description": "", "p": "mathlib"}, {"name": "probability_theory.strong_law_aux7", "description": " `X\u1d62` satisfies the strong law of large numbers along all integers. This follows from the\ncorresponding fact along the sequences `c^n`, and the fact that any integer can be sandwiched\nbetween `c^n` and `c^(n+1)` with comparably small error if `c` is close enough to `1`\n(which is formalized in `tendsto_div_of_monotone_of_tendsto_div_floor_pow`).", "p": "mathlib"}, {"name": "probability_theory.strong_law_ae", "description": " *Strong law of large numbers*, almost sure version: if `X n` is a sequence of independent\nidentically distributed integrable real-valued random variables, then `\u2211 i in range n, X i / n`\nconverges almost surely to `\ud835\udd3c[X 0]`. We give here the strong version, due to Etemadi, that only\nrequires pairwise independence.", "p": "mathlib"}, {"name": "probability_theory.moment_truncation_eq_interval_integral", "description": "", "p": "mathlib"}, {"name": "probability_theory.strong_law_aux5", "description": " The truncated and non-truncated versions of `X\u1d62` have the same asymptotic behavior, as they\nalmost surely coincide at all but finitely many steps. This follows from a probability computation\nand Borel-Cantelli.", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.truncation", "description": "", "p": "mathlib"}, {"name": "probability_theory.truncation", "description": "Truncating a real-valued function to the interval `(-A, A]`.", "p": "mathlib"}, {"name": "probability_theory.abs_truncation_le_abs_self", "description": "", "p": "mathlib"}, {"name": "probability_theory.sum_prob_mem_Ioc_le", "description": "", "p": "mathlib"}, {"name": "probability_theory.strong_law_aux4", "description": "", "p": "mathlib"}, {"name": "probability_theory.strong_law_aux1", "description": "", "p": "mathlib"}, {"name": "probability_theory.ident_distrib.truncation", "description": "", "p": "mathlib"}, {"name": "probability_theory.strong_law_aux3", "description": " The expectation of the truncated version of `X\u1d62` behaves asymptotically like the whole\nexpectation. This follows from convergence and Cesaro averaging.", "p": "mathlib"}, {"name": "probability_theory.strong_law_aux2", "description": "", "p": "mathlib"}, {"name": "probability_theory.integral_truncation_eq_interval_integral", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_strongly_measurable.mem_\u2112p_truncation", "description": "", "p": "mathlib"}, {"name": "probability_theory.moment_truncation_eq_interval_integral_of_nonneg", "description": "", "p": "mathlib"}, {"name": "probability_theory.truncation_eq_of_nonneg", "description": "", "p": "mathlib"}, {"name": "probability_theory.tendsto_integral_truncation", "description": " If a function is integrable, then the integral of its truncated versions converges to the\nintegral of the whole function.", "p": "mathlib"}, {"name": "probability_theory.strong_law_aux6", "description": "", "p": "mathlib"}, {"name": "probability_theory.integral_truncation_le_integral_of_nonneg", "description": "", "p": "mathlib"}, {"name": "probability_theory.tsum_prob_mem_Ioi_lt_top", "description": "", "p": "mathlib"}, {"name": "probability_theory.truncation_nonneg", "description": "", "p": "mathlib"}, {"name": "probability_theory.integral_truncation_eq_interval_integral_of_nonneg", "description": "", "p": "mathlib"}, {"name": "probability_theory.abs_truncation_le_bound", "description": "", "p": "mathlib"}, {"name": "probability_theory.sum_variance_truncation_le", "description": "", "p": "mathlib"}, {"name": "laurent_series.power_series_part_coeff", "description": "", "p": "mathlib"}, {"name": "power_series.coe_bit1", "description": "", "p": "mathlib"}, {"name": "power_series.coe_X", "description": "", "p": "mathlib"}, {"name": "power_series.coe_bit0", "description": "", "p": "mathlib"}, {"name": "power_series.coe_zero", "description": "", "p": "mathlib"}, {"name": "laurent_series.power_series_part_eq_zero", "description": "", "p": "mathlib"}, {"name": "power_series.coe_add", "description": "", "p": "mathlib"}, {"name": "power_series.coe_pow", "description": "", "p": "mathlib"}, {"name": "laurent_series.algebra", "description": "", "p": "mathlib"}, {"name": "power_series.coe_sub", "description": "", "p": "mathlib"}, {"name": "laurent_series", "description": "A `laurent_series` is implemented as a `hahn_series` with value group `\u2124`.", "p": "mathlib"}, {"name": "laurent_series.single_order_mul_power_series_part", "description": "", "p": "mathlib"}, {"name": "laurent_series.has_coe", "description": "", "p": "mathlib"}, {"name": "power_series.coe_smul", "description": "", "p": "mathlib"}, {"name": "laurent_series.coeff_coe_power_series", "description": "", "p": "mathlib"}, {"name": "laurent_series.coe_power_series", "description": "", "p": "mathlib"}, {"name": "laurent_series.power_series_part", "description": "This is a power series that can be multiplied by an integer power of `X` to give our\n Laurent series. If the Laurent series is nonzero, `power_series_part` has a nonzero\n constant term.", "p": "mathlib"}, {"name": "power_series.coe_one", "description": "", "p": "mathlib"}, {"name": "laurent_series.is_fraction_ring", "description": "", "p": "mathlib"}, {"name": "laurent_series.of_power_series_localization", "description": "The localization map from power series to Laurent series.", "p": "mathlib"}, {"name": "power_series.coeff_coe", "description": "", "p": "mathlib"}, {"name": "power_series.coe_mul", "description": "", "p": "mathlib"}, {"name": "laurent_series.coe_algebra_map", "description": "", "p": "mathlib"}, {"name": "power_series.coe_neg", "description": "", "p": "mathlib"}, {"name": "laurent_series.of_power_series_power_series_part", "description": "", "p": "mathlib"}, {"name": "laurent_series.power_series_part_zero", "description": "", "p": "mathlib"}, {"name": "power_series.coe_C", "description": "", "p": "mathlib"}, {"name": "set_basis_of_linear_independent_of_card_eq_finrank", "description": "A linear independent set of `finrank K V` vectors forms a basis.", "p": "mathlib"}, {"name": "finite_dimensional.finrank_of_infinite_dimensional", "description": "", "p": "mathlib"}, {"name": "rank_eq_zero", "description": "", "p": "mathlib"}, {"name": "finrank_eq_zero", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.fintype_of_fintype", "description": "A finite dimensional vector space over a finite field is finite", "p": "mathlib"}, {"name": "finrank_zero_iff_forall_zero", "description": "", "p": "mathlib"}, {"name": "finset_basis_of_linear_independent_of_card_eq_finrank_repr_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_eq_bot_iff_range_eq_top", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.fin_basis_of_finrank_eq", "description": "An `n`-dimensional vector space has a basis indexed by `fin n`.", "p": "mathlib"}, {"name": "finite_dimensional.linear_equiv.quot_equiv_of_quot_equiv", "description": "Given the subspaces `p q`, if `p.quotient \u2243\u2097[K] q`, then `q.quotient \u2243\u2097[K] p`", "p": "mathlib"}, {"name": "finite_dimensional.basis_singleton_apply", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.fintype_card_le_finrank_of_linear_independent", "description": "", "p": "mathlib"}, {"name": "subalgebra.bot_eq_top_iff_finrank_eq_one", "description": "", "p": "mathlib"}, {"name": "linear_map.linear_equiv_of_injective", "description": " Given a linear map `f` between two vector spaces with the same dimension, if\n`ker f = \u22a5` then `linear_equiv_of_injective` is the induced isomorphism\nbetween the two vector spaces.", "p": "mathlib"}, {"name": "finite_dimensional.linear_equiv.quot_equiv_of_equiv", "description": "Given isomorphic subspaces `p q` of vector spaces `V` and `V\u2081` respectively,\n `p.quotient` is isomorphic to `q.quotient`.", "p": "mathlib"}, {"name": "submodule.finite_dimensional_supr", "description": " The submodule generated by a supremum of finite dimensional submodules, indexed by a finite\nsort is finite-dimensional.", "p": "mathlib"}, {"name": "linear_map.finite_dimensional_of_surjective", "description": "The image under an onto linear map of a finite-dimensional space is also finite-dimensional.", "p": "mathlib"}, {"name": "surjective_of_nonzero_of_finrank_eq_one", "description": "", "p": "mathlib"}, {"name": "linear_map.is_unit_iff_ker_eq_bot", "description": "", "p": "mathlib"}, {"name": "subalgebra.rank_eq_one_iff", "description": "", "p": "mathlib"}, {"name": "module.End.ker_pow_eq_ker_pow_finrank_of_le", "description": "", "p": "mathlib"}, {"name": "linear_map.linear_equiv_of_injective_apply", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.basis_singleton_repr_apply", "description": "", "p": "mathlib"}, {"name": "finrank_eq_one_iff_of_nonzero'", "description": "A module with a nonzero vector `v` has dimension 1 iff every vector is a multiple of `v`.", "p": "mathlib"}, {"name": "finite_dimensional_of_rank_eq_one", "description": "", "p": "mathlib"}, {"name": "coe_set_basis_of_linear_independent_of_card_eq_finrank", "description": "", "p": "mathlib"}, {"name": "field_of_finite_dimensional", "description": "An integral domain that is module-finite as an algebra over a field is a field.", "p": "mathlib"}, {"name": "finite_dimensional_of_rank_eq_zero", "description": "", "p": "mathlib"}, {"name": "submodule.eq_top_of_finrank_eq", "description": "", "p": "mathlib"}, {"name": "submodule.finrank_sup_add_finrank_inf_eq", "description": "The sum of the dimensions of s + t and s \u2229 t is the sum of the dimensions of s and t", "p": "mathlib"}, {"name": "finite_dimensional.finite_dimensional_quotient", "description": "A quotient of a finite-dimensional space is also finite-dimensional.", "p": "mathlib"}, {"name": "set.finrank_mono", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.submodule.map.finite_dimensional", "description": "Pushforwards of finite-dimensional submodules are finite-dimensional.", "p": "mathlib"}, {"name": "finite_dimensional", "description": " `finite_dimensional` vector spaces are defined to be finite modules.\nUse `finite_dimensional.of_fintype_basis` to prove finite dimension from another definition.", "p": "mathlib"}, {"name": "linear_map.injective_iff_surjective", "description": "On a finite-dimensional space, a linear map is injective if and only if it is surjective.", "p": "mathlib"}, {"name": "finite_dimensional.finite_dimensional_of_finrank", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finite_of_finite", "description": "", "p": "mathlib"}, {"name": "is_simple_module_of_finrank_eq_one", "description": "Any `K`-algebra module that is 1-dimensional over `K` is simple.", "p": "mathlib"}, {"name": "finrank_eq_zero_of_rank_eq_zero", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finite_dimensional_self", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.span_of_finite", "description": "The submodule generated by a finite set is finite-dimensional.", "p": "mathlib"}, {"name": "linear_map.mul_eq_one_of_mul_eq_one", "description": " In a finite-dimensional space, if linear maps are inverse to each other on one side then they\nare also inverse to each other on the other side.", "p": "mathlib"}, {"name": "finite_dimensional_bot", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finset_card_le_finrank_of_linear_independent", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.subalgebra_to_submodule", "description": "**Alias** of the reverse direction of `subalgebra.finite_dimensional_to_submodule`.", "p": "mathlib"}, {"name": "finite_dimensional.not_linear_independent_of_infinite", "description": "", "p": "mathlib"}, {"name": "submodule.finrank_le_one_iff_is_principal", "description": "", "p": "mathlib"}, {"name": "submodule.finrank_add_eq_of_is_compl", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.of_finite_basis", "description": " If a vector space has a basis indexed by elements of a finite set, then it is\nfinite-dimensional.", "p": "mathlib"}, {"name": "finite_dimensional.exists_nontrivial_relation_sum_zero_of_rank_succ_lt_card", "description": "If a finset has cardinality larger than `finrank + 1`,\nthen there is a nontrivial linear relation amongst its elements,\nsuch that the coefficients of the relation sum to zero.", "p": "mathlib"}, {"name": "complete_lattice.independent.subtype_ne_bot_le_finrank", "description": " If `p` is an independent family of subspaces of a finite-dimensional space `V`, then the\nnumber of nontrivial subspaces in the family `p` is bounded above by the dimension of `V`.\n\nNote that the `fintype` hypothesis required here can be provided by\n`complete_lattice.independent.fintype_ne_bot_of_finite_dimensional`.", "p": "mathlib"}, {"name": "finite_dimensional.basis_singleton_repr_symm_apply", "description": "", "p": "mathlib"}, {"name": "finset_basis_of_linear_independent_of_card_eq_finrank_repr_apply", "description": "", "p": "mathlib"}, {"name": "bot_eq_top_of_rank_eq_zero", "description": "", "p": "mathlib"}, {"name": "submodule.finite_dimensional_finset_sup", "description": " The submodule generated by a finite supremum of finite dimensional submodules is\nfinite-dimensional.\n\nNote that strictly this only needs `\u2200 i \u2208 s, finite_dimensional K (S i)`, but that doesn't\nwork well with typeclass search.", "p": "mathlib"}, {"name": "finite_dimensional.finite_dimensional_subalgebra", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.fintype_basis_index", "description": "If a vector space is `finite_dimensional`, all bases are indexed by a finite type", "p": "mathlib"}, {"name": "linear_map.injective_iff_surjective_of_finrank_eq_finrank", "description": "", "p": "mathlib"}, {"name": "subalgebra.bot_eq_top_iff_rank_eq_one", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.exists_relation_sum_zero_pos_coefficient_of_rank_succ_lt_card", "description": "A slight strengthening of `exists_nontrivial_relation_sum_zero_of_rank_succ_lt_card`\navailable when working over an ordered field:\nwe can ensure a positive coefficient, not just a nonzero coefficient.", "p": "mathlib"}, {"name": "submodule.finrank_strict_mono", "description": "", "p": "mathlib"}, {"name": "subalgebra.finite_dimensional_bot", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.of_injective", "description": "If the codomain of an injective linear map is finite dimensional, the domain must be as well.", "p": "mathlib"}, {"name": "linear_map.finrank_range_add_finrank_ker", "description": " rank-nullity theorem : the dimensions of the kernel and the range of a linear map add up to\nthe dimension of the source space.", "p": "mathlib"}, {"name": "linear_equiv.finite_dimensional", "description": "Finite dimensionality is preserved under linear equivalence.", "p": "mathlib"}, {"name": "finrank_eq_one_iff'", "description": "A module has dimension 1 iff there is some nonzero `v : V` so every vector is a multiple of `v`.", "p": "mathlib"}, {"name": "finite_dimensional.finrank_pos_iff", "description": "A finite dimensional space has positive `finrank` iff it is nontrivial.", "p": "mathlib"}, {"name": "subalgebra.is_simple_order_of_finrank", "description": "", "p": "mathlib"}, {"name": "linear_map.finite_dimensional_range", "description": "The range of a linear map defined on a finite-dimensional space is also finite-dimensional.", "p": "mathlib"}, {"name": "finset_basis_of_linear_independent_of_card_eq_finrank", "description": "A linear independent finset of `finrank K V` vectors forms a basis.", "p": "mathlib"}, {"name": "finite_dimensional.finite_dimensional_submodule", "description": "A subspace of a finite-dimensional space is also finite-dimensional.", "p": "mathlib"}, {"name": "finrank_eq_one_iff", "description": "A module has dimension 1 iff there is some `v : V` so `{v}` is a basis.", "p": "mathlib"}, {"name": "finite_dimensional.finrank_pos", "description": "A nontrivial finite dimensional space has positive `finrank`.", "p": "mathlib"}, {"name": "finite_dimensional.eq_of_le_of_finrank_eq", "description": " If a submodule is less than or equal to a finite-dimensional\nsubmodule with the same dimension, they are equal.", "p": "mathlib"}, {"name": "submodule.finite_dimensional_sup", "description": " The sup of two finite-dimensional submodules is\nfinite-dimensional.", "p": "mathlib"}, {"name": "module.End.exists_ker_pow_eq_ker_pow_succ", "description": "", "p": "mathlib"}, {"name": "linear_map.surjective_of_injective", "description": "On a finite-dimensional space, an injective linear map is surjective.", "p": "mathlib"}, {"name": "subalgebra.eq_bot_of_finrank_one", "description": "", "p": "mathlib"}, {"name": "finrank_span_singleton", "description": "", "p": "mathlib"}, {"name": "basis_of_linear_independent_of_card_eq_finrank", "description": "A linear independent family of `finrank K V` vectors forms a basis.", "p": "mathlib"}, {"name": "linear_equiv.coe_of_injective_endo", "description": "", "p": "mathlib"}, {"name": "submodule.eq_top_of_disjoint", "description": "", "p": "mathlib"}, {"name": "set_basis_of_linear_independent_of_card_eq_finrank_repr_symm_apply", "description": "", "p": "mathlib"}, {"name": "linear_independent.finite", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.cardinal_mk_le_finrank_of_linear_independent", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.exists_nontrivial_relation_of_rank_lt_card", "description": "If a finset has cardinality larger than the dimension of the space,\nthen there is a nontrivial linear relation amongst its elements.", "p": "mathlib"}, {"name": "finite_dimensional.finite_dimensional_iff_of_rank_eq_nsmul", "description": "", "p": "mathlib"}, {"name": "linear_map.ker_eq_bot_iff_range_eq_top_of_finrank_eq_finrank", "description": "", "p": "mathlib"}, {"name": "subalgebra.finrank_eq_one_iff", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.eq_top_of_finrank_eq", "description": " If a submodule has maximal dimension in a finite dimensional space, then it is equal to the\nwhole space.", "p": "mathlib"}, {"name": "linear_map.comp_eq_id_comm", "description": " In a finite-dimensional space, linear maps are inverse to each other on one side if and only if\nthey are inverse to each other on the other side.", "p": "mathlib"}, {"name": "finrank_le_one_iff", "description": "A finite dimensional module has dimension at most 1 iff\nthere is some `v : V` so every vector is a multiple of `v`.", "p": "mathlib"}, {"name": "submodule.finite_dimensional_of_le", "description": " A submodule contained in a finite-dimensional submodule is\nfinite-dimensional.", "p": "mathlib"}, {"name": "set_basis_of_linear_independent_of_card_eq_finrank_repr_apply", "description": "", "p": "mathlib"}, {"name": "submodule.finite_dimensional_inf_right", "description": " The inf of two submodules, the second finite-dimensional, is\nfinite-dimensional.", "p": "mathlib"}, {"name": "basis_of_linear_independent_of_card_eq_finrank_repr_apply", "description": "", "p": "mathlib"}, {"name": "coe_basis_of_linear_independent_of_card_eq_finrank", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.fin_basis", "description": "A finite dimensional vector space has a basis indexed by `fin (finrank K V)`.", "p": "mathlib"}, {"name": "submodule.finrank_quotient_add_finrank", "description": " In a finite-dimensional vector space, the dimensions of a submodule and of the corresponding\nquotient add up to the dimension of the space.", "p": "mathlib"}, {"name": "subalgebra.finite_dimensional_to_submodule", "description": "A `subalgebra` is `finite_dimensional` iff it is finite_dimensional as a submodule.", "p": "mathlib"}, {"name": "division_ring_of_finite_dimensional", "description": "A domain that is module-finite as an algebra over a field is a division ring.", "p": "mathlib"}, {"name": "finite_dimensional.span_singleton", "description": "The submodule generated by a single element is finite-dimensional.", "p": "mathlib"}, {"name": "submodule.finrank_lt_finrank_of_lt", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_injective_endo_right_inv", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.basis_singleton", "description": "In a vector space with dimension 1, each set {v} is a basis for `v \u2260 0`.", "p": "mathlib"}, {"name": "linear_map.mul_eq_one_comm", "description": " In a finite-dimensional space, linear maps are inverse to each other on one side if and only if\nthey are inverse to each other on the other side.", "p": "mathlib"}, {"name": "finite_dimensional.of_surjective", "description": "If the domain of a surjective linear map is finite dimensional, the codomain must be as well.", "p": "mathlib"}, {"name": "subalgebra.bot_eq_top_of_rank_eq_one", "description": "**Alias** of the reverse direction of `subalgebra.bot_eq_top_iff_rank_eq_one`.", "p": "mathlib"}, {"name": "finite_dimensional.finrank_eq_rank'", "description": " In a finite-dimensional space, its dimension (seen as a cardinal) coincides with its\n`finrank`. This is a copy of `finrank_eq_rank _ _` which creates easier typeclass searches.", "p": "mathlib"}, {"name": "finite_dimensional.finrank_zero_iff", "description": " A finite dimensional space has zero `finrank` iff it is a subsingleton.\nThis is the `finrank` version of `rank_zero_iff`.", "p": "mathlib"}, {"name": "submodule.fg_iff_finite_dimensional", "description": "A submodule is finitely generated if and only if it is finite-dimensional", "p": "mathlib"}, {"name": "subalgebra.bot_eq_top_of_finrank_eq_one", "description": "**Alias** of the reverse direction of `subalgebra.bot_eq_top_iff_finrank_eq_one`.", "p": "mathlib"}, {"name": "finite_dimensional.eq_of_le_of_finrank_le", "description": "", "p": "mathlib"}, {"name": "cardinal_lt_aleph_0_of_finite_dimensional", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finite_dimensional_pi'", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.range_basis_singleton", "description": "", "p": "mathlib"}, {"name": "linear_equiv.of_injective_endo_left_inv", "description": "", "p": "mathlib"}, {"name": "basis_of_linear_independent_of_card_eq_finrank_repr_symm_apply", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.basis.of_vector_space_index.fintype", "description": "If a vector space is `finite_dimensional`, `basis.of_vector_space` is indexed by\n a finite type.", "p": "mathlib"}, {"name": "span_eq_top_of_linear_independent_of_card_eq_finrank", "description": "", "p": "mathlib"}, {"name": "coe_finset_basis_of_linear_independent_of_card_eq_finrank", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.of_fintype_basis", "description": "If a vector space has a finite basis, then it is finite-dimensional.", "p": "mathlib"}, {"name": "finite_dimensional.basis_unique", "description": "A module with dimension 1 has a basis with one element.", "p": "mathlib"}, {"name": "finite_dimensional.finrank_eq_card_basis'", "description": " If a vector space is finite-dimensional, then the cardinality of any basis is equal to its\n`finrank`.", "p": "mathlib"}, {"name": "finite_dimensional_finsupp", "description": "", "p": "mathlib"}, {"name": "complete_lattice.independent.subtype_ne_bot_le_finrank_aux", "description": "", "p": "mathlib"}, {"name": "subalgebra.eq_bot_of_rank_le_one", "description": "", "p": "mathlib"}, {"name": "submodule.finrank_mono", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.span_finset", "description": "The submodule generated by a finset is finite-dimensional.", "p": "mathlib"}, {"name": "complete_lattice.independent.fintype_ne_bot_of_finite_dimensional", "description": " If `p` is an independent family of subspaces of a finite-dimensional space `V`, then the\nnumber of nontrivial subspaces in the family `p` is finite.", "p": "mathlib"}, {"name": "finite_dimensional.finite_dimensional_of_finrank_eq_succ", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.fact_finite_dimensional_of_finrank_eq_succ", "description": " We can infer `finite_dimensional K V` in the presence of `[fact (finrank K V = n + 1)]`. Declare\nthis as a local instance where needed.", "p": "mathlib"}, {"name": "finite_dimensional_of_rank_eq_nat", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finrank_pos_iff_exists_ne_zero", "description": "A finite dimensional space has positive `finrank` iff it has a nonzero element.", "p": "mathlib"}, {"name": "finite_dimensional.basis_unique.repr_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "cardinal_mk_eq_cardinal_mk_field_pow_rank", "description": "", "p": "mathlib"}, {"name": "submodule.finrank_lt", "description": " The dimension of a strict submodule is strictly bounded by the dimension of the ambient\nspace.", "p": "mathlib"}, {"name": "linear_map.is_unit_iff_range_eq_top", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.finite_dimensional_pi", "description": "", "p": "mathlib"}, {"name": "submodule.finite_dimensional_inf_left", "description": " The inf of two submodules, the first finite-dimensional, is\nfinite-dimensional.", "p": "mathlib"}, {"name": "finrank_eq_one_iff_of_nonzero", "description": "A vector space with a nonzero vector `v` has dimension 1 iff `v` spans.", "p": "mathlib"}, {"name": "module.finrank_le_one_iff_top_is_principal", "description": "", "p": "mathlib"}, {"name": "submodule.finrank_add_le_finrank_add_finrank", "description": "", "p": "mathlib"}, {"name": "basis_of_finrank_zero", "description": "If `\u03b9` is an empty type and `V` is zero-dimensional, there is a unique `\u03b9`-indexed basis.", "p": "mathlib"}, {"name": "finite_dimensional.lt_aleph_0_of_linear_independent", "description": "", "p": "mathlib"}, {"name": "finite_dimensional.of_subalgebra_to_submodule", "description": "**Alias** of the forward direction of `subalgebra.finite_dimensional_to_submodule`.", "p": "mathlib"}, {"name": "basis.unique", "description": "Given a basis of a division ring over itself indexed by a type `\u03b9`, then `\u03b9` is `unique`.", "p": "mathlib"}, {"name": "linear_equiv.of_injective_endo", "description": "The linear equivalence corresponging to an injective endomorphism.", "p": "mathlib"}, {"name": "module.End.ker_pow_le_ker_pow_finrank", "description": "", "p": "mathlib"}, {"name": "module.End.ker_pow_constant", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.lift", "description": " A universal property of the trivial square-zero extension, providing a unique\n`triv_sq_zero_ext R M \u2192\u2090[R] A` for every linear map `M \u2192\u2097[R] A` whose range has no non-zero\nproducts.\n\nThis isomorphism is named to match the very similar `complex.lift`.", "p": "mathlib"}, {"name": "triv_sq_zero_ext.has_sub", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_mul_inl", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.snd_smul", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.alg_hom_ext'", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_zero", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.fst_mul", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.add_monoid_with_one", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.ring", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.snd_hom", "description": "The canonical `R`-linear projection `triv_sq_zero_ext R M \u2192 M`.", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_pow", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inr_hom", "description": "The canonical `R`-linear inclusion `M \u2192 triv_sq_zero_ext R M`.", "p": "mathlib"}, {"name": "triv_sq_zero_ext.algebra_map_eq_inl'", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_sub", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_neg", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.ind", "description": " To show a property hold on all `triv_sq_zero_ext R M` it suffices to show it holds\non terms of the form `inl r + inr m`.\n\nThis can be used as `induction x using triv_sq_zero_ext.ind`.", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_one", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.snd_mk", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.fst_comp_inr", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.add_comm_group", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_fst_add_inr_snd_eq", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.fst_sum", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.fst", "description": "The canonical projection `triv_sq_zero_ext R M \u2192 R`.", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_smul", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.lift_apply", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_hom_apply", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.nat.has_pow", "description": " In the general non-commutative case, the power operator is\n\n$$\\begin{align}\n(r + m)^n &= r^n + r^{n-1}m + r^{n-2}mr + \\cdots + rmr^{n-2} + mr^{n-1} \\\\\n          & =r^n + \\sum_{i = 0}^{n - 1} r^{(n - 1) - i} m r^{i}\n\\end{align}$$\n\nIn the commutative case this becomes the simpler $(r + m)^n = r^n + nr^{n-1}m$.", "p": "mathlib"}, {"name": "triv_sq_zero_ext.module", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.snd_add", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inr_mul_inl", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext", "description": "\"Trivial Square-Zero Extension\".\n\nGiven a module `M` over a ring `R`, the trivial square-zero extension of `M` over `R` is defined\nto be the `R`-algebra `R \u00d7 M` with multiplication given by\n`(r\u2081 + m\u2081) * (r\u2082 + m\u2082) = r\u2081 r\u2082 + r\u2081 m\u2082 + r\u2082 m\u2081`.\n\nIt is a square-zero extension because `M^2 = 0`.", "p": "mathlib"}, {"name": "triv_sq_zero_ext.distrib_mul_action", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.has_mul", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_mul", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.fst_nat_cast", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.has_neg", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.lift_aux_inr_hom", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.algebra_map_eq_inl", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.snd_sum", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.snd_one", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.fst_inl", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.add_semigroup", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inr_mul_inr", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inl_nat_cast", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.lift_aux", "description": " There is an alg_hom from the trivial square zero extension to any `R`-algebra with a submodule\nwhose products are all zero.\n\nSee `triv_sq_zero_ext.lift` for this as an equiv.", "p": "mathlib"}, {"name": "triv_sq_zero_ext.non_assoc_ring", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.fst_neg", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.has_add", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.snd_neg", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.add_comm_semigroup", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.non_assoc_semiring", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.fst_smul", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.inr_zero", "description": "", "p": "mathlib"}, {"name": "triv_sq_zero_ext.fs