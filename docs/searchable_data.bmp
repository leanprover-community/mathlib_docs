l.rat_smul_eq_C_mul", "description": "", "p": "mathlib"}, {"name": "polynomial.forall_eq_iff_forall_eq", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff_injective", "description": "", "p": "mathlib"}, {"name": "polynomial.comm_ring", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_smul_index", "description": "", "p": "mathlib"}, {"name": "polynomial.X_mul", "description": "`X` commutes with everything, even when the coefficients are noncommutative.", "p": "mathlib"}, {"name": "polynomial.binomial_eq_binomial", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_sub", "description": "", "p": "mathlib"}, {"name": "polynomial.erase_same", "description": "", "p": "mathlib"}, {"name": "polynomial.of_finsupp_sub", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff_neg", "description": "", "p": "mathlib"}, {"name": "polynomial.monomial_zero_left", "description": "", "p": "mathlib"}, {"name": "polynomial.of_finsupp_mul", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff_monomial_succ", "description": "", "p": "mathlib"}, {"name": "polynomial.of_finsupp_sum", "description": "", "p": "mathlib"}, {"name": "polynomial.eq_zero_of_eq_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.support_C_mul_X'", "description": "", "p": "mathlib"}, {"name": "polynomial.C_injective", "description": "", "p": "mathlib"}, {"name": "polynomial.C_eq_nat_cast", "description": "", "p": "mathlib"}, {"name": "polynomial.support_C_mul_X_pow", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_iso", "description": " Ring isomorphism between `R[X]` and `add_monoid_algebra R \u2115`. This is just an\nimplementation detail, but it can be useful to transfer results from `finsupp` to polynomials.", "p": "mathlib"}, {"name": "polynomial.to_finsupp_one", "description": "", "p": "mathlib"}, {"name": "polynomial.has_sub", "description": "", "p": "mathlib"}, {"name": "polynomial.unique", "description": "", "p": "mathlib"}, {"name": "polynomial.semiring", "description": "", "p": "mathlib"}, {"name": "polynomial.support_trinomial'", "description": "", "p": "mathlib"}, {"name": "polynomial.of_finsupp_smul", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_iso_apply", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_monomial_eq", "description": "", "p": "mathlib"}, {"name": "polynomial.C_mul", "description": "", "p": "mathlib"}, {"name": "polynomial.C_ne_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.has_int_cast", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_C", "description": "", "p": "mathlib"}, {"name": "polynomial.monomial_add_erase", "description": "", "p": "mathlib"}, {"name": "polynomial.C_bit0", "description": "", "p": "mathlib"}, {"name": "polynomial.eta", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff", "description": "`coeff p n` (often denoted `p.coeff n`) is the coefficient of `X^n` in `p`.", "p": "mathlib"}, {"name": "polynomial.coeff_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.mul_eq_sum_sum", "description": "Expressing the product of two polynomials as a double sum.", "p": "mathlib"}, {"name": "polynomial.X", "description": "`X` is the polynomial variable (aka indeterminate).", "p": "mathlib"}, {"name": "polynomial.X_pow_mul", "description": "", "p": "mathlib"}, {"name": "polynomial.support_X", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_mul", "description": "", "p": "mathlib"}, {"name": "polynomial.nontrivial.of_polynomial_ne", "description": "", "p": "mathlib"}, {"name": "polynomial.C_mul_X_pow_eq_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_C_mul_X_pow_eq", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_inj", "description": "", "p": "mathlib"}, {"name": "polynomial.ext_iff", "description": "", "p": "mathlib"}, {"name": "polynomial.erase_ne", "description": "", "p": "mathlib"}, {"name": "polynomial.X_pow_mul_assoc", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_injective", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_eq_of_subset", "description": "", "p": "mathlib"}, {"name": "polynomial.C_pow", "description": "", "p": "mathlib"}, {"name": "polynomial.X_pow_eq_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.monomial_mul_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_monomial_index", "description": "", "p": "mathlib"}, {"name": "polynomial.support_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.monomial_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "polynomial.of_finsupp_add", "description": "", "p": "mathlib"}, {"name": "polynomial.erase_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.nontrivial_iff", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_X", "description": "", "p": "mathlib"}, {"name": "polynomial.of_finsupp_eq_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff_one_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.monomial_neg", "description": "", "p": "mathlib"}, {"name": "polynomial.monomial_injective", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_add", "description": "", "p": "mathlib"}, {"name": "polynomial.add_hom_ext'", "description": "", "p": "mathlib"}, {"name": "polynomial.card_support_eq_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff_update_same", "description": "", "p": "mathlib"}, {"name": "polynomial.erase", "description": "`erase p n` is the polynomial `p` in which the `X^n` term has been erased.", "p": "mathlib"}, {"name": "polynomial.to_finsupp_smul", "description": "", "p": "mathlib"}, {"name": "polynomial.add_hom_ext", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_sum", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_C_mul_X_pow", "description": "", "p": "mathlib"}, {"name": "polynomial.to_finsupp_eq_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.of_finsupp_inj", "description": "A more convenient spelling of `polynomial.of_finsupp.inj_eq` in terms of `iff`.", "p": "mathlib"}, {"name": "polynomial.monomial_mul_C", "description": "", "p": "mathlib"}, {"name": "polynomial.sum_X_index", "description": "", "p": "mathlib"}, {"name": "polynomial.ext", "description": "", "p": "mathlib"}, {"name": "polynomial.coeff_inj", "description": "", "p": "mathlib"}, {"name": "polynomial.smul_monomial", "description": "", "p": "mathlib"}, {"name": "polynomial.is_scalar_tower_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_singleton'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_sub'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_comp", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_bUnion", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_with_density_eq_set_lintegral_mul", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_with_density_eq_lintegral_mul", "description": " This is Exercise 1.2.1 from [tao2010]. It allows you to express integration of a measurable\nfunction with respect to `(\u03bc.with_density f)` as an integral with respect to `\u03bc`, called the base\nmeasure. `\u03bc` is often the Lebesgue measure, and in this circumstance `f` is the probability density\nfunction, and `(\u03bc.with_density f)` represents any continuous random variable as a\nprobability measure, such as the uniform distribution between 0 and 1, the Gaussian distribution,\nthe exponential distribution, the Beta distribution, or the Cauchy distribution (see Section 2.4\nof [wasserman2004]). Thus, this method shows how to one can calculate expectations, variances,\nand other moments as a function of the probability density function.", "p": "mathlib"}, {"name": "measure_theory.lintegral_add_left'", "description": "", "p": "mathlib"}, {"name": "is_finite_measure.lintegral_lt_top_of_bounded_to_ennreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_indicator", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_const_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_trim", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_lintegral_mul", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_mono'", "description": "", "p": "mathlib"}, {"name": "measure_theory.le_lintegral_add", "description": " The sum of the lower Lebesgue integrals of two functions is less than or equal to the integral\nof their sum. The other inequality needs one of these functions to be (a.e.-)measurable.", "p": "mathlib"}, {"name": "measure_theory.lintegral_pos_iff_support", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_with_density_eq_lintegral_mul\u2080", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_with_density_iff_ae_restrict", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_countable", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_eq_top_of_measure_eq_top_ne_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_one", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_finite_measure_with_density", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_indicator_const_comp", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.limsup_lintegral_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_add_right", "description": "", "p": "mathlib"}, {"name": "measurable_space.top.measurable_singleton_class", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_eq_top_of_lintegral_ne_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.supr_lintegral_measurable_le_eq_lintegral", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_smul_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_add_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_count", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_congr", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_infi", "description": "Monotone convergence theorem for nonincreasing sequences of functions", "p": "mathlib"}, {"name": "measure_theory.lintegral_count'", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_map", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_bUnion_finset", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_map_equiv", "description": " The `lintegral` transforms appropriately under a measurable equivalence `g : \u03b1 \u2243\u1d50 \u03b2`.\n(Compare `lintegral_map`, which applies to a wider class of functions `g : \u03b1 \u2192 \u03b2`, but requires\nmeasurability of the function being integrated.)", "p": "mathlib"}, {"name": "measure_theory.lintegral_map", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_mono_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_sum_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_eq_const", "description": "", "p": "mathlib"}, {"name": "measure_theory.restrict_dirac", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_absolutely_continuous", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_mul_const", "description": "", "p": "mathlib"}, {"name": "nnreal.count_const_le_le_of_tsum_le", "description": "Markov's inequality for counting measure with hypothesis using `tsum` in `\u211d\u22650`.", "p": "mathlib"}, {"name": "measure_theory.lintegral_supr_ae", "description": "Weaker version of the monotone convergence theorem", "p": "mathlib"}, {"name": "measure_theory.lintegral_add_right", "description": " If `f g : \u03b1 \u2192 \u211d\u22650\u221e` are two functions and one of them is (a.e.) measurable, then the Lebesgue\nintegral of `f + g` equals the sum of integrals. This lemma assumes that `g` is integrable, see also\n`measure_theory.lintegral_add_left` and primed versions of these lemmas.", "p": "mathlib"}, {"name": "measure_theory.lintegral_dirac'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_add_compl", "description": "", "p": "mathlib"}, {"name": "measure_theory.le_infi_lintegral", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_eq_supr_eapprox_lintegral", "description": "", "p": "mathlib"}, {"name": "measure_theory.meas_ge_le_lintegral_div", "description": "**Markov's inequality** also known as **Chebyshev's first inequality**.", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_max", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_eq_top_of_measure_eq_top_ne_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_rw\u2082", "description": "", "p": "mathlib"}, {"name": "measure_theory.le_infi\u2082_lintegral", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.lintegral_comp", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_indicator\u2080", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_infi_ae", "description": "Monotone convergence theorem for nonincreasing sequences of functions", "p": "mathlib"}, {"name": "measure_theory.mul_meas_ge_le_lintegral", "description": " **Markov's inequality** also known as **Chebyshev's first inequality**. For a version assuming\n`ae_measurable`, see `mul_meas_ge_le_lintegral\u2080`.", "p": "mathlib"}, {"name": "measure_theory.with_density_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.set_lintegral_comp_preimage_emb", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_measurable_with_density_ennreal_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_liminf_le'", "description": "Known as Fatou's lemma, version with `ae_measurable` functions", "p": "mathlib"}, {"name": "measure_theory.with_density_sum", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_Union_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_add_right'", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_apply", "description": "", "p": "mathlib"}, {"name": "measure_theory.tendsto_lintegral_of_dominated_convergence", "description": "Dominated convergence theorem for nonnegative functions", "p": "mathlib"}, {"name": "measure_theory.exists_measurable_le_lintegral_eq", "description": " For any function `f : \u03b1 \u2192 \u211d\u22650\u221e`, there exists a measurable function `g \u2264 f` with the same\nintegral.", "p": "mathlib"}, {"name": "measure_theory.lintegral_add_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_singleton", "description": "", "p": "mathlib"}, {"name": "measure_theory.restrict_dirac'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_liminf_le", "description": "Known as Fatou's lemma", "p": "mathlib"}, {"name": "ennreal.count_const_le_le_of_tsum_le", "description": "Markov's inequality for the counting measure with hypothesis using `tsum` in `\u211d\u22650\u221e`.", "p": "mathlib"}, {"name": "measure_theory.lintegral_const_mul'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_tsum", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_with_density_eq_lintegral_mul_non_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_fintype", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_strict_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_trim_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_const_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.with_density", "description": " Given a measure `\u03bc : measure \u03b1` and a function `f : \u03b1 \u2192 \u211d\u22650\u221e`, `\u03bc.with_density f` is the\nmeasure such that for a measurable set `s` we have `\u03bc.with_density f s = \u222b\u207b a in s, f a \u2202\u03bc`.", "p": "mathlib"}, {"name": "measure_theory.lintegral_mono_set", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_finset_sum", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_one", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_lt_top'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_insert", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_pos_set_lintegral_lt_of_measure_lt", "description": " If `f` has finite integral, then `\u222b\u207b x in s, f x \u2202\u03bc` is absolutely continuous in `s`: it tends\nto zero as `\u03bc s` tends to zero. This lemma states states this fact in terms of `\u03b5` and `\u03b4`.", "p": "mathlib"}, {"name": "measure_theory.lintegral_mono", "description": "", "p": "mathlib"}, {"name": "ennreal.tsum_const_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_absolutely_continuous_is_finite_measure", "description": "A sigma-finite measure is absolutely continuous with respect to some finite measure.", "p": "mathlib"}, {"name": "measure_theory.lintegral_Union", "description": "", "p": "mathlib"}, {"name": "measure_theory.univ_le_of_forall_fin_meas_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_finset", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.lintegral_comp_emb", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_congr_fun", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_const_mul''", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_le_of_forall_fin_meas_le'", "description": " If the Lebesgue integral of a function is bounded by some constant on all sets with finite\nmeasure in a sub-\u03c3-algebra and the measure is \u03c3-finite on that sub-\u03c3-algebra, then the integral\nover the whole space is bounded by that same constant.", "p": "mathlib"}, {"name": "measurable_embedding.lintegral_map", "description": " If `g : \u03b1 \u2192 \u03b2` is a measurable embedding and `f : \u03b2 \u2192 \u211d\u22650\u221e` is any function (not necessarily\nmeasurable), then `\u222b\u207b a, f a \u2202(map g \u03bc) = \u222b\u207b a, f (g a) \u2202\u03bc`. Compare with `lintegral_map` wich\napplies to any measurable `g : \u03b1 \u2192 \u03b2` but requires that `f` is measurable as well.", "p": "mathlib"}, {"name": "measure_theory.lintegral_eq_nnreal", "description": " `\u222b\u207b a in s, f a \u2202\u03bc` is defined as the supremum of integrals of simple functions\n`\u03c6 : \u03b1 \u2192\u209b \u211d\u22650\u221e` such that `\u03c6 \u2264 f`. This lemma says that it suffices to take\nfunctions `\u03c6 : \u03b1 \u2192\u209b \u211d\u22650`.", "p": "mathlib"}, {"name": "measure_theory.lintegral_supr'", "description": " Monotone convergence theorem -- sometimes called Beppo-Levi convergence. Version with\nae_measurable functions.", "p": "mathlib"}, {"name": "measure_theory.lintegral_nnnorm_eq_of_ae_nonneg", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_indicator_one", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_supr_directed_of_measurable", "description": "Monotone convergence for a supremum over a directed family and indexed by a countable type", "p": "mathlib"}, {"name": "measure_theory.simple_func.exists_lt_lintegral_simple_func_of_lt_lintegral", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_bUnion\u2080", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_lt_top_of_is_compact", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_dirac", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_with_density_eq_lintegral_mul_non_measurable\u2080", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_congr", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_pos_lintegral_lt_of_sigma_finite", "description": " In a sigma-finite measure space, there exists an integrable function which is\npositive everywhere (and with an arbitrarily small integral).", "p": "mathlib"}, {"name": "measure_theory.with_density_eq_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_eq_zero_iff'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_supr_directed", "description": "Monotone convergence for a supremum over a directed family and indexed by a countable type.", "p": "mathlib"}, {"name": "measure_theory.with_density_indicator_one", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_const_mul_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_lt_lintegral_simple_func_of_lt_lintegral", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_zero_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_with_density_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_mono_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_sub_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.tendsto_lintegral_filter_of_dominated_convergence", "description": "Dominated convergence theorem for filters with a countable basis", "p": "mathlib"}, {"name": "measure_theory.lintegral_add_left", "description": " If `f g : \u03b1 \u2192 \u211d\u22650\u221e` are two functions and one of them is (a.e.) measurable, then the Lebesgue\nintegral of `f + g` equals the sum of integrals. This lemma assumes that `f` is integrable, see also\n`measure_theory.lintegral_add_right` and primed versions of these lemmas.", "p": "mathlib"}, {"name": "measure_theory.lintegral_unique", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_apply_eq_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_countable'", "description": "", "p": "mathlib"}, {"name": "measure_theory.ae_eq_of_ae_le_of_lintegral_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_congr_ae", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_tendsto_of_tendsto_of_monotone", "description": "Monotone convergence theorem expressed with limits", "p": "mathlib"}, {"name": "measure_theory.lintegral_le_of_forall_fin_meas_le_of_measurable", "description": " If the Lebesgue integral of a function is bounded by some constant on all sets with finite\nmeasure in a sub-\u03c3-algebra and the measure is \u03c3-finite on that sub-\u03c3-algebra, then the integral\nover the whole space is bounded by that same constant. Version for a measurable function.\nSee `lintegral_le_of_forall_fin_meas_le'` for the more general `ae_measurable` version.", "p": "mathlib"}, {"name": "measure_theory.lintegral_map'", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.set_lintegral_comp_emb", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_tsum", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_of_real_mutually_singular", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_add_mul_meas_add_le_le_lintegral", "description": " A version of **Markov's inequality** for two functions. It doesn't follow from the standard\nMarkov's inequality because we only assume measurability of `g`, not `f`.", "p": "mathlib"}, {"name": "measure_theory.tendsto_set_lintegral_zero", "description": " If `f` has finite integral, then `\u222b\u207b x in s, f x \u2202\u03bc` is absolutely continuous in `s`: it tends\nto zero as `\u03bc s` tends to zero.", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_const", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_eq_top_of_set_lintegral_ne_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.tendsto_lintegral_of_dominated_convergence'", "description": " Dominated convergence theorem for nonnegative functions which are just almost everywhere\nmeasurable.", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_with_density_eq_set_lintegral_mul_non_measurable", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_measure_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_mono_nnreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_strict_mono_of_ae_le_of_ae_lt_on", "description": "", "p": "mathlib"}, {"name": "measure_theory.monotone_lintegral", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_dirac'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_of_real_le_lintegral_nnnorm", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_univ", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_le_of_forall_fin_meas_le", "description": " If the Lebesgue integral of a function is bounded by some constant on all sets with finite\nmeasure and the measure is \u03c3-finite, then the integral over the whole space is bounded by that same\nconstant.", "p": "mathlib"}, {"name": "measure_theory.supr_lintegral_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.exists_simple_func_forall_lintegral_sub_lt_of_pos", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_const_mul", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_one", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral", "description": "The **lower Lebesgue integral** of a function `f` with respect to a measure `\u03bc`.", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.set_lintegral_comp_preimage", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_strict_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.restrict_with_density", "description": "", "p": "mathlib"}, {"name": "measure_theory.with_density_smul'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_const", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_union", "description": "", "p": "mathlib"}, {"name": "measure_theory.set_lintegral_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_sub_le'", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_mul_const_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_with_density_eq_lintegral_mul\u2080'", "description": " The Lebesgue integral of `g` with respect to the measure `\u03bc.with_density f` coincides with\nthe integral of `f * g`. This version assumes that `g` is almost everywhere measurable. For a\nversion without conditions on `g` but requiring that `f` is almost everywhere finite, see\n`lintegral_with_density_eq_lintegral_mul_non_measurable`", "p": "mathlib"}, {"name": "measure_theory.lintegral_indicator_const", "description": "", "p": "mathlib"}, {"name": "measure_theory.lintegral_zero_fun", "description": "", "p": "mathlib"}, {"name": "measure_theory.li