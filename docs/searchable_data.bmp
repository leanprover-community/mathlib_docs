cription": "", "p": "mathlib"}, {"name": "discrete_quotient.proj_continuous", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.comap_comp", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.symm", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.proj_bot_bijective", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.ext_iff", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.proj_quotient_map", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.fiber_subset_of_le", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.proj_is_locally_constant", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.map_comp_proj", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.map_proj", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.proj", "description": "The projection from `X` to the given discrete quotient.", "p": "mathlib"}, {"name": "discrete_quotient.proj_surjective", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.is_clopen_preimage", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.proj_bot_injective", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.map_of_le", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.of_le", "description": "The map induced by a refinement of a discrete quotient.", "p": "mathlib"}, {"name": "discrete_quotient.trans", "description": "", "p": "mathlib"}, {"name": "locally_constant.discrete_quotient", "description": "Any locally constant function induces a discrete quotient.", "p": "mathlib"}, {"name": "discrete_quotient.topological_space", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.ext", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.of_le_refl", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.of_le_map", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.comap", "description": "Comap a discrete quotient along a continuous map.", "p": "mathlib"}, {"name": "discrete_quotient.le_comap.comp", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.is_closed_preimage", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.map_comp", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.inhabited", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.has_inf", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.discrete_topology", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.proj_bot_inj", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.of_le_comp_proj", "description": "", "p": "mathlib"}, {"name": "discrete_quotient.le_comap", "description": " Given `f : C(X, Y)`, `le_comap cont A B` is defined as `A \u2264 B.comap f`. Mathematically this\nmeans that `f` descends to a morphism `A \u2192 B`.", "p": "mathlib"}, {"name": "discrete_quotient.of_clopen", "description": "Construct a discrete quotient from a clopen set.", "p": "mathlib"}, {"name": "discrete_quotient.of_le_comp_map", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.map_id", "description": "`mono_over.map` preserves the identity (up to a natural isomorphism).", "p": "mathlib"}, {"name": "category_theory.mono_over.forget.category_theory.is_right_adjoint", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.lift_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.forget.category_theory.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.slice", "description": "Monomorphisms over an object `f : over A` in an over category\nare equivalent to monomorphisms over the source of `f`.", "p": "mathlib"}, {"name": "category_theory.mono_over.w", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.map_obj_left", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.reflective", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over", "description": "The category of monomorphisms into `X` as a full subcategory of the over category.\nThis isn't skeletal, so it's not a partial order.\n\nLater we define `subobject X` as the quotient of this by isomorphisms.", "p": "mathlib"}, {"name": "category_theory.mono_over.exists_iso_map", "description": "When `f : X \u27f6 Y` is a monomorphism, `exists f` agrees with `map f`.", "p": "mathlib"}, {"name": "category_theory.mono_over.map_pullback_adj", "description": "`map f` is left adjoint to `pullback f` when `f` is a monomorphism", "p": "mathlib"}, {"name": "category_theory.mono_over.full_map", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.congr_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.map", "description": "We can map monomorphisms over `X` to monomorphisms over `Y`\nby post-composition with a monomorphism `f : X \u27f6 Y`.", "p": "mathlib"}, {"name": "category_theory.mono_over.lift", "description": "Lift a functor between over categories to a functor between `mono_over` categories,\ngiven suitable evidence that morphisms are taken to monomorphisms.", "p": "mathlib"}, {"name": "category_theory.mono_over.lift_iso", "description": "Isomorphic functors `over Y \u2964 over X` lift to isomorphic functors `mono_over Y \u2964 mono_over X`.", "p": "mathlib"}, {"name": "category_theory.mono_over.congr_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.lift_map", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.congr_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.mk'", "description": "Construct a `mono_over X`.", "p": "mathlib"}, {"name": "category_theory.mono_over.exists", "description": "In the case where `f` is not a monomorphism but `C` has images,\nwe can still take the \"forward map\" under it, which agrees with `mono_over.map f`.", "p": "mathlib"}, {"name": "category_theory.mono_over.is_thin", "description": " The category of monomorphisms over X is a thin category,\nwhich makes defining its skeleton easy.", "p": "mathlib"}, {"name": "category_theory.mono_over.mk'_coe'", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.map_iso_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.hom_mk", "description": "Convenience constructor for a morphism in monomorphisms over `X`.", "p": "mathlib"}, {"name": "category_theory.mono_over.arrow", "description": "Convenience notation for the underlying arrow of a monomorphism over X.", "p": "mathlib"}, {"name": "category_theory.mono_over.lift_obj_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.iso_mk_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.iso_mk", "description": "Convenience constructor for an isomorphism in monomorphisms over `X`.", "p": "mathlib"}, {"name": "category_theory.mono_over.lift_obj_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.forget_obj_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.exists_pullback_adj", "description": "`exists` is adjoint to `pullback` when images exist", "p": "mathlib"}, {"name": "category_theory.mono_over.pullback_map_self", "description": "`mono_over.map f` followed by `mono_over.pullback f` is the identity.", "p": "mathlib"}, {"name": "category_theory.mono_over.congr_counit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.has_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.congr", "description": "An equivalence of categories `e` between `C` and `D` induces an equivalence between\n   `mono_over X` and `mono_over (e.functor.obj X)` whenever `X` is an object of `C`.", "p": "mathlib"}, {"name": "category_theory.mono_over.lift_id", "description": "`mono_over.lift` preserves the identity functor.", "p": "mathlib"}, {"name": "category_theory.mono_over.image_mono_over", "description": "The `mono_over Y` for the image inclusion for a morphism `f : X \u27f6 Y`.", "p": "mathlib"}, {"name": "category_theory.mono_over.lift_comp", "description": "`mono_over.lift` commutes with composition of functors.", "p": "mathlib"}, {"name": "category_theory.mono_over.image_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.mk'_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.forget", "description": "The inclusion from monomorphisms over X to morphisms over X.", "p": "mathlib"}, {"name": "category_theory.mono_over.mk'_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.image", "description": "Taking the image of a morphism gives a functor `over X \u2964 mono_over X`.", "p": "mathlib"}, {"name": "category_theory.mono_over.forget_image", "description": "Forgetting that a monomorphism over `X` is a monomorphism, then taking its image,\nis the identity functor.", "p": "mathlib"}, {"name": "category_theory.mono_over.category", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.map_iso", "description": "Isomorphic objects have equivalent `mono_over` categories.", "p": "mathlib"}, {"name": "category_theory.mono_over.pullback_comp", "description": "pullback commutes with composition (up to a natural isomorphism)", "p": "mathlib"}, {"name": "category_theory.mono_over.map_comp", "description": "`mono_over.map` commutes with composition (up to a natural isomorphism).", "p": "mathlib"}, {"name": "category_theory.mono_over.map_iso_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.faithful_exists", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.forget_obj_left", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.mono", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.pullback_obj_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.faithful_map", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.w_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.map_iso_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.map_obj_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.image_mono_over_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.pullback_obj_left", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.mk'_arrow_iso", "description": "If `f : mono_over X`, then `mk' f.arrow` is of course just `f`, but not definitionally, so we\n   package it as an isomorphism.", "p": "mathlib"}, {"name": "category_theory.mono_over.image_map", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.pullback_id", "description": "pullback preserves the identity (up to a natural isomorphism)", "p": "mathlib"}, {"name": "category_theory.mono_over.iso_mk_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.forget.category_theory.full", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.image_forget_adj", "description": "`mono_over.image : over X \u2964 mono_over X` is left adjoint to\n`mono_over.forget : mono_over X \u2964 over X`", "p": "mathlib"}, {"name": "category_theory.mono_over.map_iso_counit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.mono_over.pullback", "description": " When `C` has pullbacks, a morphism `f : X \u27f6 Y` induces a functor `mono_over Y \u2964 mono_over X`,\nby pulling back a monomorphism along `f`.", "p": "mathlib"}, {"name": "sub_mul_action.monoid", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.mem_one", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.has_mul", "description": "", "p": "mathlib"}, {"name": "sub_mul_action.subset_coe_pow", "description": "", "p": "mat