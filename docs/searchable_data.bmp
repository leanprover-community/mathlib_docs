: "mathlib"}, {"name": "lie_submodule.lie_span", "description": "The `lie_span` of a set `s \u2286 M` is the smallest Lie submodule of `M` that contains `s`.", "p": "mathlib"}, {"name": "lie_submodule.coe_lie_span_submodule_eq_iff", "description": "", "p": "mathlib"}, {"name": "lie_subalgebra.top_equiv", "description": " The natural equivalence between the 'top' Lie subalgebra and the enclosing Lie algebra.\n\nThis is the Lie subalgebra version of `submodule.top_equiv`.", "p": "mathlib"}, {"name": "lie_submodule.lie_ring_module", "description": "", "p": "mathlib"}, {"name": "lie_submodule.complete_lattice", "description": " The set of Lie submodules of a Lie module form a complete lattice.\n\nWe provide explicit values for the fields `bot`, `top`, `inf` to get more convenient definitions\nthan we would otherwise obtain from `complete_lattice_of_Inf`.", "p": "mathlib"}, {"name": "lie_ideal.incl_apply", "description": "", "p": "mathlib"}, {"name": "lie_ideal.lie_module", "description": "Transfer the `lie_module` instance from the coercion `lie_ideal \u2192 lie_subalgebra`.", "p": "mathlib"}, {"name": "lie_ideal.gc_map_comap", "description": "", "p": "mathlib"}, {"name": "submodule.exists_lie_submodule_coe_eq_iff", "description": "", "p": "mathlib"}, {"name": "lie_ideal.lie_ring_module", "description": "Transfer the `lie_module` instance from the coercion `lie_ideal \u2192 lie_subalgebra`.", "p": "mathlib"}, {"name": "lie_ideal.comap", "description": " A morphism of Lie algebras `f : L \u2192 L'` pulls back Lie ideals of `L'` to Lie ideals of `L`.\n\nNote that `f` makes `L'` into a Lie module over `L` (turning `f` into a morphism of Lie modules)\nand so this is a special case of `lie_submodule.comap` but we do not exploit this fact.", "p": "mathlib"}, {"name": "lie_submodule.module'", "description": "", "p": "mathlib"}, {"name": "lie_ideal.incl_range", "description": "", "p": "mathlib"}, {"name": "lie_submodule.comap_incl_eq_top", "description": "", "p": "mathlib"}, {"