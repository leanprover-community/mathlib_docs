ion": "", "p": "mathlib"}, {"name": "alg_equiv.map_matrix_trans", "description": "", "p": "mathlib"}, {"name": "matrix.submatrix_submatrix", "description": "", "p": "mathlib"}, {"name": "add_equiv.map_matrix", "description": " The `add_equiv` between spaces of matrices induced by an `add_equiv` between their\ncoefficients. This is `matrix.map` as an `add_equiv`.", "p": "mathlib"}, {"name": "matrix.mul_add", "description": "", "p": "mathlib"}, {"name": "matrix.submatrix_one_equiv", "description": "", "p": "mathlib"}, {"name": "matrix.add_monoid_hom_mul_right", "description": "Right multiplication by a matrix, as an `add_monoid_hom` from matrices to matrices.", "p": "mathlib"}, {"name": "matrix.bit1_apply", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_ring_hom_apply", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_neg", "description": "", "p": "mathlib"}, {"name": "is_smul_regular.matrix", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_injective", "description": "", "p": "mathlib"}, {"name": "matrix.conj_transpose_ring_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "matrix.transpose_ring_equiv_apply", "description": "", "p": "mathlib"}, {"name": "matrix.conj_transpose_nsmul", "description": "", "p": "mathlib"}, {"name": "add_equiv.map_matrix_refl", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_mul_diagonal'", "description": "", "p": "mathlib"}, {"name": "matrix.zero_dot_product", "description": "", "p": "mathlib"}, {"name": "matrix.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "matrix.submatrix", "description": " Given maps `(r_reindex : l \u2192 m)` and  `(c_reindex : o \u2192 n)` reindexing the rows and columns of\na matrix `M : matrix m n \u03b1`, the matrix `M.submatrix r_reindex c_reindex : matrix l o \u03b1` is defined\nby `(M.submatrix r_reindex c_reindex) i j = M (r_reindex i) (c_reindex j)` for `(i,j) : l \u00d7 o`.\nNote that the total number of row and columns does not have to be preserved.", "p": "mathlib"}, {"name": "matrix.of_apply", "description": "", "p": "mathlib"}, {"name": "matrix.map", "description": " `M.map f` is the matrix obtained by applying `f` to each entry of the matrix `M`.\n\nThis is available in bundled forms as:\n* `add_monoid_hom.map_matrix`\n* `linear_map.map_matrix`\n* `ring_hom.map_matrix`\n* `alg_hom.map_matrix`\n* `equiv.map_matrix`\n* `add_equiv.map_matrix`\n* `linear_equiv.map_matrix`\n* `ring_equiv.map_matrix`\n* `alg_equiv.map_matrix`", "p": "mathlib"}, {"name": "matrix.mul_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.map_matrix_apply", "description": "", "p": "mathlib"}, {"name": "matrix.conj_transpose_linear_equiv", "description": "`matrix.conj_transpose` as a `linear_map`", "p": "mathlib"}, {"name": "matrix.diag_list_sum", "description": "", "p": "mathlib"}, {"name": "matrix.submatrix_one_embedding", "description": "", "p": "mathlib"}, {"name": "matrix.reindex_symm", "description": "", "p": "mathlib"}, {"name": "matrix.add_comm_semigroup", "description": "", "p": "mathlib"}, {"name": "alg_equiv.map_matrix_symm", "description": "", "p": "mathlib"}, {"name": "matrix.map_zero", "description": "", "p": "mathlib"}, {"name": "matrix.conj_transpose_add_equiv", "description": "`matrix.conj_transpose` as an `add_equiv`", "p": "mathlib"}, {"name": "matrix.mul_mul_left", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_add_monoid_hom", "description": "`matrix.diagonal` as an `add_monoid_hom`.", "p": "mathlib"}, {"name": "matrix.col_vec_mul", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_matrix_apply", "description": "", "p": "mathlib"}, {"name": "matrix.map_map", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.map_matrix_id", "description": "", "p": "mathlib"}, {"name": "matrix.update_row_apply", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_pow", "description": "", "p": "mathlib"}, {"name": "matrix.conj_transpose_smul_s