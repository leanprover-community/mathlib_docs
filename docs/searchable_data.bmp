iption": "M\u00f6bius inversion for functions to a `comm_group_with_zero`.", "p": "mathlib"}, {"name": "nat.arithmetic_function.moebius_apply_one", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.add_monoid_with_one", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.one_one", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.nat_coe_one", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.card_distinct_factors_apply_prime", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.card_distinct_factors_apply", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.moebius", "description": "`\u03bc` is the M\u00f6bius function. If `n` is squarefree with an even number of distinct prime factors,\n `\u03bc n = 1`. If `n` is squarefree with an odd number of distinct prime factors, `\u03bc n = -1`.\n If `n` is not squarefree, `\u03bc n = 0`.", "p": "mathlib"}, {"name": "nat.arithmetic_function.coe_mul_zeta_apply", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.is_multiplicative.int_cast", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.moebius_apply_is_prime_pow_not_prime", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.smul_apply", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.one_apply", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.card_distinct_factors_apply_prime_pow", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.coe_zeta_mul_apply", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.coe_moebius_mul_coe_zeta", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.is_multiplicative.mul", "description": "", "p": "mathlib"}, {"name": "nat.arithmetic_function.is_multiplicative_one", "description": "", "p