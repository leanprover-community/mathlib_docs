list_sum", "description": "", "p": "mathlib"}, {"name": "free_monoid.to_list_one", "description": "", "p": "mathlib"}, {"name": "free_add_monoid.comp_lift", "description": "", "p": "mathlib"}, {"name": "free_monoid.prod_aux", "description": " A variant of `list.prod` that has `[x].prod = x` true definitionally.\n\nThe purpose is to make `free_monoid.lift_eval_of` true by `rfl`.", "p": "mathlib"}, {"name": "free_add_monoid.of_list_join", "description": "", "p": "mathlib"}, {"name": "free_add_monoid.to_list_add", "description": "", "p": "mathlib"}, {"name": "free_add_monoid.to_list", "description": "The identity equivalence between `free_add_monoid \u03b1` and `list \u03b1`.", "p": "mathlib"}, {"name": "free_monoid.cases_on", "description": " A version of `list.cases_on` for `free_monoid` using `1` and `free_monoid.of x * xs` instead of\n`[]` and `x :: xs`.", "p": "mathlib"}, {"name": "free_add_monoid.of_list_cons", "description": "", "p": "mathlib"}, {"name": "free_monoid.of_list_append", "description": "", "p": "mathlib"}, {"name": "free_monoid.of_list_nil", "description": "", "p": "mathlib"}, {"name": "free_add_monoid.hom_map_lift", "description": "", "p": "mathlib"}, {"name": "free_add_monoid.sum_aux_eq", "description": "", "p": "mathlib"}, {"name": "free_add_monoid.of_list", "description": "The identity equivalence between `list \u03b1` and `free_add_monoid \u03b1`.", "p": "mathlib"}, {"name": "free_add_monoid.lift_apply", "description": "", "p": "mathlib"}, {"name": "free_add_monoid.of_list_comp_to_list", "description": "", "p": "mathlib"}, {"name": "free_monoid.prod_aux_eq", "description": "", "p": "mathlib"}, {"name": "order_dual.cancel_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "div_zero", "description": "", "p": "mathlib"}, {"name": "lex.comm_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "group_with_zero.to_division_monoid", "description": "", "p": "mathlib"}, {"name": "mul_inv_mul_self", "description": " Multiplying `a` by its inverse and then by itself results in `a`\n(whether or not `a` is zero).", "p": "mathlib"}, {"name": "lex.cancel_comm_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "order_dual.comm_group_with_zero", "description": "", "p": "mathlib"}, {"name": "mul_inv_cancel_left\u2080", "description": "", "p": "mathlib"}, {"name": "mul_inv_cancel_right\u2080", "description": "", "p": "mathlib"}, {"name": "mul_self_div_self", "description": " Multiplying `a` by itself and then dividing by itself results in `a`, whether or not `a` is\nzero.", "p": "mathlib"}, {"name": "mul_right_eq_self\u2080", "description": "", "p": "mathlib"}, {"name": "eq_zero_of_mul_eq_self_right", "description": " An element of a `cancel_monoid_with_zero` fixed by right multiplication by an element other\nthan one must be zero.", "p": "mathlib"}, {"name": "lex.group_with_zero", "description": "", "p": "mathlib"}, {"name": "eq_of_zero_eq_one", "description": "", "p": "mathlib"}, {"name": "right_ne_zero_of_mul", "description": "", "p": "mathlib"}, {"name": "lex.comm_group_with_zero", "description": "", "p": "mathlib"}, {"name": "mul_right_surjective\u2080", "description": "", "p": "mathlib"}, {"name": "inv_ne_zero", "description": "", "p": "mathlib"}, {"name": "group_with_zero.to_cancel_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "mul_left_surjective\u2080", "description": "", "p": "mathlib"}, {"name": "ne_zero.mul", "description": "", "p": "mathlib"}, {"name": "order_dual.comm_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "mul_left_inj'", "description": "", "p": "mathlib"}, {"name": "mul_ne_zero", "description": "", "p": "mathlib"}, {"name": "cancel_monoid_with_zero.to_no_zero_divisors", "description": "", "p": "mathlib"}, {"name": "div_div_self", "description": " Dividing `a` by the result of dividing `a` by itself results in\n`a` (whether or not `a` is zero).", "p": "mathlib"}, {"name": "lex.monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "eq_zero_of_mul_self_eq_zero", "description": "", "p": "mathlib"}, {"name": "order_dual.mul_zero_class", "description": "", "p": "mathlib"}, {"name": "mul_self_mul_inv", "description": " Multiplying `a` by itself and then by its inverse results in `a`\n(whether or not `a` is zero).", "p": "mathlib"}, {"name": "order_dual.group_with_zero", "description": "", "p": "mathlib"}, {"name": "right_ne_zero_of_mul_eq_one", "description": "", "p": "mathlib"}, {"name": "lex.mul_zero_one_class", "description": "", "p": "mathlib"}, {"name": "left_ne_zero_of_mul", "description": "", "p": "mathlib"}, {"name": "zero_div", "description": "", "p": "mathlib"}, {"name": "zero_ne_one_or_forall_eq_0", "description": "In a monoid with zero, either zero and one are nonequal, or zero is the only element.", "p": "mathlib"}, {"name": "order_dual.semigroup_with_zero", "description": "", "p": "mathlib"}, {"name": "mul_eq_mul_left_iff", "description": "", "p": "mathlib"}, {"name": "inv_eq_zero", "description": "", "p": "mathlib"}, {"name": "mul_zero_eq_const", "description": "To match `mul_one_eq_id`.", "p": "mathlib"}, {"name": "order_dual.mul_zero_one_class", "description": "", "p": "mathlib"}, {"name": "mul_eq_right\u2080", "description": "", "p": "mathlib"}, {"name": "ne_zero_of_one_div_ne_zero", "description": "", "p": "mathlib"}, {"name": "mul_right_inj'", "description": "", "p": "mathlib"}, {"name": "one_div_ne_zero", "description": "", "p": "mathlib"}, {"name": "unique_of_zero_eq_one", "description": " In a monoid with zero, if zero equals one, then zero is the unique element.\n\nSomewhat arbitrarily, we define the default element to be `0`.\nAll other elements will be provably equal to it, but not necessarily definitionally equal.", "p": "mathlib"}, {"name": "order_dual.cancel_comm_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "left_eq_mul\u2080", "description": "", "p": "mathlib"}, {"name": "lex.mul_zero_class", "description": "", "p": "mathlib"}, {"name": "div_self_mul_self", "description": " Dividing `a` by itself and then multiplying by itself results in `a`, whether or not `a` is\nzero.", "p": "mathlib"}, {"name": "order_dual.no_zero_divisors", "description": "", "p": "mathlib"}, {"name": "eq_zero_of_zero_eq_one", "description": "In a monoid with zero, if zero equals one, then zero is the only element.", "p": "mathlib"}, {"name": "lex.semigroup_with_zero", "description": "", "p": "mathlib"}, {"name": "div_mul_eq_mul_div\u2080", "description": "", "p": "mathlib"}, {"name": "subsingleton_iff_zero_eq_one", "description": " In a monoid with zero, zero equals one if and only if all elements of that semiring\nare equal.", "p": "mathlib"}, {"name": "zero_mul_eq_const", "description": "To match `one_mul_eq_id`.", "p": "mathlib"}, {"name": "order_dual.monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "mul_eq_left\u2080", "description": "", "p": "mathlib"}, {"name": "right_eq_mul\u2080", "description": "", "p": "mathlib"}, {"name": "lex.cancel_monoid_with_zero", "description": "", "p": "mathlib"}, {"name": "eq_zero_of_mul_eq_self_left", "description": " An element of a `cancel_monoid_with_zero` fixed by left multiplication by an element other\nthan one must be zero.", "p": "mathlib"}, {"name": "inv_mul_cancel", "description": "", "p": "mathlib"}, {"name": "group_with_zero.mul_left_injective", "description": "", "p": "mathlib"}, {"name": "inv_mul_cancel_right\u2080", "description": "", "p": "mathlib"}, {"name": "lex.no_zero_divisors", "description": "", "p": "mathlib"}, {"name": "group_with_zero.mul_right_injective", "description": "", "p": "mathlib"}, {"name": "zero_eq_inv", "description": "", "p": "mathlib"}, {"name": "inv_mul_cancel_left\u2080", "description": "", "p": "mathlib"}, {"name": "mul_eq_mul_right_iff", "description": "", "p": "mathlib"}, {"name": "mul_eq_zero_of_ne_zero_imp_eq_zero", "description": "", "p": "mathlib"}, {"name": "mul_left_eq_self\u2080", "description": "", "p": "mathlib"}, {"name": "ne_zero_and_ne_zero_of_mul", "description": "", "p": "mathlib"}, {"name": "left_ne_zero_of_mul_eq_one", "description": "", "p": "mathlib"}, {"name": "div_self_mul_self'", "description": "", "p": "mathlib"}, {"name": "eq_zero_of_one_div_eq_zero", "description": "", "p": "mathlib"}, {"name": "subsingleton_of_zero_eq_one", "description": "**Alias** of the forward direction of `subsingleton_iff_zero_eq_one`.", "p": "mathlib"}, {"name": "inv_mul_mul_self", "description": " Multiplying `a\u207b\u00b9` by `a` twice results in `a` (whether or not `a`\nis zero).", "p": "mathlib"}, {"name": "category_theory.subobject.ind\u2082", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.pullback_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.lower\u2082", "description": "A ternary version of `subobject.lower`.", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_mk_refl", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject", "description": "The category of subobjects of `X : C`, defined as isomorphism classes of monomorphisms into `X`.", "p": "mathlib"}, {"name": "category_theory.comma.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.lower_equivalence_counit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.representative_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_comp_of_le", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.map_iso", "description": "Isomorphic objects have equivalent subobject lattices.", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_mk_le_mk_of_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_mk_comp_of_mk_le_mk_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.map_iso_to_order_iso_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le.mono", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.eq_of_comp_arrow_eq", "description": " Two morphisms into a subobject are equal exactly if\nthe morphisms into the ambient object are equal", "p": "mathlib"}, {"name": "category_theory.subobject.eq_of_comm", "description": "To show that two subobjects are equal, it suffices to exhibit an isomorphism commuting with\n   the arrows.", "p": "mathlib"}, {"name": "category_theory.subobject.map_id", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_comp_of_le_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_mk_eq_mk_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.lower_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.underlying_iso_arrow_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_refl", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.ind", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.underlying_iso_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.map_iso_to_order_iso", "description": " In fact, there's a type level bijection between the subobjects of isomorphic objects,\nwhich preserves the order.", "p": "mathlib"}, {"name": "category_theory.subobject.mk_le_of_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_eq_mk", "description": "An equality of subobjects gives an isomorphism of the corresponding objects.", "p": "mathlib"}, {"name": "category_theory.subobject.mk", "description": "Convenience constructor for a subobject.", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_mk.mono", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.representative_iso", "description": "Starting with `A : mono_over X`, we can take its equivalence class in `subobject X`\nthen pick an arbitrary representative using `representative.obj`.\nThis is isomorphic (in `mono_over X`) to the original `A`.", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_mk_comp_of_mk_le_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.arrow", "description": "The morphism in `C` from the arbitrarily chosen underlying object to the ambient object.", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_mk_comp_of_mk_le_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.representative_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.map_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_eq", "description": " An equality of subobjects gives an isomorphism of the corresponding objects.\n(One could use `underlying.map_iso (eq_to_iso h))` here, but this is more readable.)", "p": "mathlib"}, {"name": "category_theory.subobject.lower_equivalence_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.arrow_congr", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le.category_theory.mono", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_comp_of_le_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_comp_of_le_mk_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.equiv_mono_over", "description": " The category of subobjects is equivalent to the `mono_over` category. It is more convenient to\nuse the former due to the partial order instance, but oftentimes it is easier to define structures\non the latter.", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_mk_eq", "description": "An equality of subobjects gives an isomorphism of the corresponding objects.", "p": "mathlib"}, {"name": "category_theory.subobject.arrow_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.underlying_iso_hom_comp_eq_mk_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.lower", "description": " Any functor `mono_over X \u2964 mono_over Y` descends to a functor\n`subobject X \u2964 subobject Y`, because `mono_over Y` is thin.", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_mk_comp_of_mk_le", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.mk_le_mk_of_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.partial_order", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_mk_eq_mk_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.eq_mk_of_comm", "description": "To show that two subobjects are equal, it suffices to exhibit an isomorphism commuting with\n   the arrows.", "p": "mathlib"}, {"name": "category_theory.subobject.exists", "description": "The functor from subobjects of `X` to subobjects of `Y` given by\nsending the subobject `S` to its \"image\" under `f`, usually denoted $\\exists_f$.\nFor instance, when `C` is the category of types,\nviewing `subobject X` as `set X` this is just `set.image f`.\n\nThis functor is left adjoint to the `pullback f` functor (shown in `exists_pullback_adj`)\nprovided both are defined, and generalises the `map f` functor, again provided it is defined.", "p": "mathlib"}, {"name": "category_theory.subobject.lower_equivalence_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.pullback", "description": " When `C` has pullbacks, a morphism `f : X \u27f6 Y` induces a functor `subobject Y \u2964 subobject X`,\nby pulling back a monomorphism along `f`.", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_mk_comp_of_mk_le", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_eq_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.pullback.category_theory.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le", "description": "An inequality of subobjects is witnessed by some morphism between the corresponding objects.", "p": "mathlib"}, {"name": "category_theory.subobject.category", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_mk_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_mk_eq_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.lower_iso", "description": " Isomorphic functors become equal when lowered to `subobject`.\n(It's not as evil as usual to talk about equality between functors\nbecause the categories are thin and skeletal.)", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_eq_mk_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_comp_of_le_mk_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_eq_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_mk_eq_mk", "description": "An equality of subobjects gives an isomorphism of the corresponding objects.", "p": "mathlib"}, {"name": "category_theory.subobject.le_of_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.lift_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.underlying_iso_hom_comp_eq_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_arrow_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_mk.mono", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.underlying_as_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.mk_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_eq_mk_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.exists_iso_map", "description": "When `f : X \u27f6 Y` is a monomorphism, `exists f` agrees with `map f`.", "p": "mathlib"}, {"name": "category_theory.subobject.exists_pullback_adj", "description": "`exists f : subobject X \u2964 subobject Y` is\nleft adjoint to `pullback f : subobject Y \u2964 subobject X`.", "p": "mathlib"}, {"name": "category_theory.subobject.of_le", "description": "An inequality of subobjects is witnessed by some morphism between the corresponding objects.", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_mk_comp_of_mk_le_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_mk", "description": "An inequality of subobjects is witnessed by some morphism between the corresponding objects.", "p": "mathlib"}, {"name": "category_theory.subobject.map_iso_to_order_iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.map", "description": "We can map subobjects of `X` to subobjects of `Y`\nby post-composition with a monomorphism `f : X \u27f6 Y`.", "p": "mathlib"}, {"name": "category_theory.subobject.map_pullback", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_mk_comp_of_mk_le_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.iso_of_mk_eq_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_mk_comp", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.le_mk_of_comm", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.underlying", "description": "Use choice to pick a representative underlying object in `C` for any `subobject X`.\n\nPrefer to use the coercion `P : C` rather than explicitly writing `underlying.obj P`.", "p": "mathlib"}, {"name": "category_theory.subobject.underlying_iso", "description": "If we construct a `subobject Y` from an explicit `f : X \u27f6 Y` with `[mono f]`,\nthen pick an arbitrary choice of underlying object `(subobject.mk f : C)` back in `C`,\nit is isomorphic (in `C`) to the original `X`.", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_comp_of_le", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.map_pullback_adj", "description": " `map f : subobject X \u2964 subobject Y` is\nthe left adjoint of `pullback f : subobject Y \u2964 subobject X`.", "p": "mathlib"}, {"name": "category_theory.subobject.lower_adjunction", "description": " An adjunction between `mono_over A` and `mono_over B` gives an adjunction\nbetween `subobject A` and `subobject B`.", "p": "mathlib"}, {"name": "category_theory.subobject.mk_eq_of_comm", "description": "To show that two subobjects are equal, it suffices to exhibit an isomorphism commuting with\n   the arrows.", "p": "mathlib"}, {"name": "category_theory.comma.ext_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.lower_equivalence", "description": " An equivalence between `mono_over A` and `mono_over B` gives an equivalence\nbetween `subobject A` and `subobject B`.", "p": "mathlib"}, {"name": "category_theory.subobject.underlying_arrow", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.has_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_mk", "description": "An inequality of subobjects is witnessed by some morphism between the corresponding objects.", "p": "mathlib"}, {"name": "category_theory.subobject.of_mk_le_mk_comp_of_mk_le_mk_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.lower_equivalence_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.underlying_iso_arrow_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.underlying_arrow_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.lift", "description": "Declare a function on subobjects of `X` by specifying a function on monomorphisms with\n   codomain `X`.", "p": "mathlib"}, {"name": "category_theory.subobject.mk_eq_mk_of_comm", "description": "To show that two subobjects are equal, it suffices to exhibit an isomorphism commuting with\n   the arrows.", "p": "mathlib"}, {"name": "category_theory.subobject.pullback_map_self", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.pullback_id", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.representative", "description": "Use choice to pick a representative `mono_over X` for each `subobject X`.", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_comp_of_le_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.subobject.of_le_comp_of_le_assoc", "description": "", "p": "mathlib"}, {"name": "psigma.lex.no_min_order", "description": "", "p": "mathlib"}, {"name": "psigma.lex.preorder", "description": "", "p": "mathlib"}, {"name": "psigma.lex.partial_order", "description": "Dictionary / lexicographic partial_order for dependent pairs.", "p": "mathlib"}, {"name": "psigma.lex.no_min_order_of_nonempty", "description": "", "p": "mathlib"}, {"name": "psigma.lex.densely_ordered_of_no_min_order", "description": "", "p": "mathlib"}, {"name": "psigma.lex.densely_ordered", "description": "", "p": "mathlib"}, {"name": "psigma.lex.no_max_order", "description": "", "p": "mathlib"}, {"name": "psigma.lex.bounded_order", "description": "The lexicographical linear order on a sigma type.", "p": "mathlib"}, {"name": "psigma.lex.densely_ordered_of_no_max_order", "description": "", "p": "mathlib"}, {"name": "psigma.lex.has_le", "description": "The lexicographical `\u2264` on a sigma type.", "p": "mathlib"}, {"name": "psigma.lex.linear_order", "description": "Dictionary / lexicographic linear_order for pairs.", "p": "mathlib"}, {"name": "psigma.lex.has_lt", "description": "The lexicographical `<` on a sigma type.", "p": "mathlib"}, {"name": "psigma.lex.no_max_order_of_nonempty", "description": "", "p": "mathlib"}, {"name": "psigma.lex.order_bot", "description": "The lexicographical linear order on a sigma type.", "p": "mathlib"}, {"name": "psigma.lex.order_top", "description": "The lexicographical linear order on a sigma type.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.right_invariance", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_indep_chart_aux", "description": " If a property of a germ of function `g` on a pointed set `(s, x)` is invariant under the\nstructure groupoid (by composition in the source space and in the target space), then\nexpressing it in charted spaces does not depend on the element of the maximal atlas one uses\nboth in the source and in the target manifolds, provided they are defined around `x` and `g x`\nrespectively, and provided `g` is continuous within `s` at `x` (otherwise, the local behavior\nof `g` at `x` can not be captured with a chart in the target).", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_congr", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_at_of_lift_prop_within_at", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_iff", "description": "`lift_prop_within_at P f s x` is equivalent to a definition where we restrict the set we are\n considering to the domain of the charts at `x` and `f x`.", "p": "mathlib"}, {"name": "charted_space.lift_prop_within_at", "description": " Given a property of germs of functions and sets in the model space, then one defines\na corresponding property in a charted space, by requiring that it holds at the preferred chart at\nthis point. (When the property is local and invariant, it will in fact hold using any chart, see\n`lift_prop_within_at_indep_chart`). We require continuity in the lifted property, as otherwise one\nsingle chart might fail to capture the behavior of the function.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.congr_nhds_within'", "description": "", "p": "mathlib"}, {"name": "charted_space.lift_prop_at", "description": " Given a property of germs of functions and sets in the model space, then one defines\na corresponding property of a function at a point in a charted space, by requiring that it holds\nin the preferred chart.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_indep_chart_target_aux", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_of_locally_lift_prop_on", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_mono", "description": "", "p": "mathlib"}, {"name": "charted_space.lift_prop_at_iff", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_of_mem_groupoid", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_of_lift_prop", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.is_local_structomorph_within_at_iff", "description": "A slight reformulation of `is_local_structomorph_within_at` when `f` is a local homeomorph.\n This gives us an `e` that is defined on a subset of `f.source`.", "p": "mathlib"}, {"name": "structure_groupoid.lift_prop_within_at_self_source", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_at_congr_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_chart", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_symm_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.is_local_structomorph_within_at_source_iff", "description": "A slight reformulation of `is_local_structomorph_within_at` when `f` is a local homeomorph and\n the set we're considering is `f.source`.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_at_chart", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_of_lift_prop_at", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.congr_set", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_mono", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_congr_iff", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.congr'", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_id", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.is_local_structomorph_within_at", "description": " A function from a model space `H` to itself is a local structomorphism, with respect to a\nstructure groupoid `G` for `H`, relative to a set `s` in `H`, if for all points `x` in the set, the\nfunction agrees with a `G`-structomorphism on `s` in a neighbourhood of `x`.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_indep_chart", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_indep_chart_source", "description": "A version of `lift_prop_within_at_indep_chart`, only for the source.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_of_lift_prop_at_of_mem_nhds", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_at_chart_symm", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_inter", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_at_of_mem_groupoid", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_congr_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_indep_chart'", "description": "A version of `lift_prop_within_at_indep_chart`, that uses `lift_prop_within_at` on both sides.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.left_invariance", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.lift_prop_within_at_univ", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_congr_iff", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.lift_prop_within_at_self", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.lift_prop_on_univ", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_at_iff_comp_inclusion", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_indep_chart_source_aux", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_congr_iff_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop", "description": " Structure recording good behavior of a property of a triple `(f, s, x)` where `f` is a function,\n`s` a set and `x` a point. Good behavior here means locality and invariance under given groupoids\n(both in the source and in the target). Given such a good behavior, the lift of this property\nto charted spaces admitting these groupoids will inherit the good behavior.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.is_local", "description": " Structure recording good behavior of a property of a triple `(f, s, x)` where `f` is a function,\n`s` a set and `x` a point. Good behavior here means locality and invariance under given groupoids\n(both in the source and in the target). Given such a good behavior, the lift of this property\nto charted spaces admitting these groupoids will inherit the good behavior.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.right_invariance'", "description": " Structure recording good behavior of a property of a triple `(f, s, x)` where `f` is a function,\n`s` a set and `x` a point. Good behavior here means locality and invariance under given groupoids\n(both in the source and in the target). Given such a good behavior, the lift of this property\nto charted spaces admitting these groupoids will inherit the good behavior.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.congr_of_forall", "description": " Structure recording good behavior of a property of a triple `(f, s, x)` where `f` is a function,\n`s` a set and `x` a point. Good behavior here means locality and invariance under given groupoids\n(both in the source and in the target). Given such a good behavior, the lift of this property\nto charted spaces admitting these groupoids will inherit the good behavior.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.left_invariance'", "description": " Structure recording good behavior of a property of a triple `(f, s, x)` where `f` is a function,\n`s` a set and `x` a point. Good behavior here means locality and invariance under given groupoids\n(both in the source and in the target). Given such a good behavior, the lift of this property\nto charted spaces admitting these groupoids will inherit the good behavior.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.congr_iff_nhds_within", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_indep_chart_target_aux2", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_at_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.is_local_structomorph_within_at_local_invariant_prop", "description": " For a groupoid `G` which is `closed_under_restriction`, being a local structomorphism is a local\ninvariant property.", "p": "mathlib"}, {"name": "charted_space.lift_prop_on", "description": " Given a property of germs of functions and sets in the model space, then one defines\na corresponding property of functions on sets in a charted space, by requiring that it holds\naround each point of the set, in the preferred charts.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.is_local_nhds", "description": "", "p": "mathlib"}, {"name": "charted_space.lift_prop", "description": " Given a property of germs of functions and sets in the model space, then one defines\na corresponding property of a function in a charted space, by requiring that it holds\nin the preferred chart around every point.", "p": "mathlib"}, {"name": "charted_space.lift_prop_iff", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_mono_of_mem", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_at_symm_of_mem_maximal_atlas", "description": "", "p": "mathlib"}, {"name": "local_homeomorph.is_local_structomorph_within_at_iff'", "description": "A slight reformulation of `is_local_structomorph_within_at` when `f` is a local homeomorph and\n the set we're considering is a superset of `f.source`.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_inter'", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_chart_symm", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_on_of_locally_lift_prop_on", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_indep_chart_target", "description": "A version of `lift_prop_within_at_indep_chart`, only for the target.", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_inclusion", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.congr_nhds_within", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.congr_iff", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_at_congr_iff_of_eventually_eq", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.has_groupoid.comp", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.lift_prop_within_at_self_target", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_congr", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.lift_prop_within_at_indep_chart", "description": "", "p": "mathlib"}, {"name": "structure_groupoid.local_invariant_prop.congr", "description": "", "p": "mathlib"}, {"name": "category_theory.decomposed_to_map", "description": "", "p": "mathlib"}, {"name": "category_theory.decomposed_to.full", "description": "", "p": "mathlib"}, {"name": "category_theory.component.nonempty", "description": "Each connected component of the category is nonempty.", "p": "mathlib"}, {"name": "category_theory.decomposed_to", "description": "The forward direction of the equivalence between the decomposed category and the original.", "p": "mathlib"}, {"name": "category_theory.inclusion", "description": "The inclusion of each component into the decomposed category. This is just `sigma.incl` but having\nthis abbreviation helps guide typeclass search to get the right category instance on `decomposed J`.", "p": "mathlib"}, {"name": "category_theory.component.\u03b9.full", "description": "", "p": "mathlib"}, {"name": "category_theory.connected_components", "description": "This type indexes the connected components of the category `J`.", "p": "mathlib"}, {"name": "category_theory.decomposed_to.is_equivalence", "description": "", "p": "mathlib"}, {"name": "category_theory.decomposed_to.ess_surj", "description": "", "p": "mathlib"}, {"name": "category_theory.component.category", "description": "", "p": "mathlib"}, {"name": "category_theory.component.\u03b9.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.decomposed", "description": "The disjoint union of `J`s connected components, written explicitly as a sigma-type with the\ncategory structure.\nThis category is equivalent to `J`.", "p": "mathlib"}, {"name": "category_theory.decomposed_to.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.decomposed_to_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.component.\u03b9", "description": "The inclusion functor from a connected component to the whole category.", "p": "mathlib"}, {"name": "category_theory.decomposed_equiv_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.component.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.inclusion_comp_decomposed_to", "description": "", "p": "mathlib"}, {"name": "category_theory.decomposed_equiv", "description": "This gives that any category is equivalent to a disjoint union of connected categories.", "p": "mathlib"}, {"name": "category_theory.component.\u03b9_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.connected_components.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.component", "description": "Given an index for a connected component, produce the actual component as a full subcategory.", "p": "mathlib"}, {"name": "category_theory.component.\u03b9_map", "description": "", "p": "mathlib"}, {"name": "category_theory.component.is_connected", "description": "Each connected component of the category is connected.", "p": "mathlib"}, {"name": "measurable.lintegral_kernel_prod_right''", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.integral_kernel_prod_left''", "description": "", "p": "mathlib"}, {"name": "measurable.set_lintegral_kernel", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.measurable_kernel_prod_mk_left", "description": "", "p": "mathlib"}, {"name": "measurable.set_lintegral_kernel_prod_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.integral_kernel_prod_right'", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.measurable_kernel_prod_mk_left'", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.measurable_kernel_prod_mk_left_of_finite", "description": "This is an auxiliary lemma for `measurable_kernel_prod_mk_left`.", "p": "mathlib"}, {"name": "measurable.lintegral_kernel_prod_left'", "description": "", "p": "mathlib"}, {"name": "probability_theory.measurable_set_kernel_integrable", "description": "", "p": "mathlib"}, {"name": "measurable.lintegral_kernel_prod_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.integral_kernel_prod_left", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.integral_kernel_prod_right''", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.measurable_lintegral_indicator_const", "description": "Auxiliary lemma for `measurable.lintegral_kernel_prod_right`.", "p": "mathlib"}, {"name": "measurable.set_lintegral_kernel_prod_right", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.integral_kernel_prod_right", "description": "", "p": "mathlib"}, {"name": "measurable.lintegral_kernel", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.measurable_kernel_prod_mk_right", "description": "", "p": "mathlib"}, {"name": "measurable.lintegral_kernel_prod_right'", "description": "", "p": "mathlib"}, {"name": "measure_theory.strongly_measurable.integral_kernel_prod_left