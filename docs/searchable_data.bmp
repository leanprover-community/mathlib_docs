pace", "description": "", "p": "mathlib"}, {"name": "UniformSpace.coe_of", "description": "", "p": "mathlib"}, {"name": "UniformSpace.uniform_space", "description": "", "p": "mathlib"}, {"name": "UniformSpace.quiver.hom.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "CpltSepUniformSpace.category", "description": "The category instance on `CpltSepUniformSpace`.", "p": "mathlib"}, {"name": "UniformSpace.completion_functor", "description": "The functor turning uniform spaces into complete separated uniform spaces.", "p": "mathlib"}, {"name": "UniformSpace.concrete_category", "description": "", "p": "mathlib"}, {"name": "UniformSpace.uniform_continuous.category_theory.unbundled_hom", "description": "The information required to build morphisms for `UniformSpace`.", "p": "mathlib"}, {"name": "UniformSpace.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "UniformSpace.has_forget_to_Top", "description": "The forgetful functor from uniform spaces to topological spaces.", "p": "mathlib"}, {"name": "UniformSpace.adj", "description": "The completion functor is left adjoint to the forgetful functor.", "p": "mathlib"}, {"name": "UniformSpace.coe_comp", "description": "", "p": "mathlib"}, {"name": "CpltSepUniformSpace.coe_of", "description": "", "p": "mathlib"}, {"name": "UniformSpace.hom_ext", "description": "", "p": "mathlib"}, {"name": "UniformSpace.completion_hom", "description": "The inclusion of a uniform space into its completion.", "p": "mathlib"}, {"name": "CpltSepUniformSpace.complete_space", "description": "", "p": "mathlib"}, {"name": "UniformSpace.coe_id", "description": "", "p": "mathlib"}, {"name": "UniformSpace.of", "description": "Construct a bundled `UniformSpace` from the underlying type and the typeclass.", "p": "mathlib"}, {"name": "UniformSpace.extension_hom", "description": "The mate of a morphism from a `UniformSpace` to a `CpltSepUniformSpace`.", "p": "mathlib"}, {"name": "UniformSpace", "description": "A (bundled) uniform space.", "p": "mathlib"}, {"name": "UniformSpace.category_theory.forget\u2082.category_theory.reflective", "description": "", "p": "mathlib"}, {"name": "CpltSepUniformSpace.separated_space", "description": "", "p": "mathlib"}, {"name": "UniformSpace.category_theory.forget\u2082.category_theory.is_right_adjoint", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.mem_darts_reverse", "description": "", "p": "mathlib"}, {"name": "simple_graph.set_walk_length_zero_eq_of_ne", "description": "", "p": "mathlib"}, {"name": "simple_graph.card_set_walk_length_eq", "description": "", "p": "mathlib"}, {"name": "simple_graph.finset_walk_length", "description": " The `finset` of length-`n` walks from `u` to `v`.\nThis is used to give `{p : G.walk u v | p.length = n}` a `fintype` instance, and it\ncan also be useful as a recursive description of this set when `V` is finite.\n\nSee `simple_graph.coe_finset_walk_length_eq` for the relationship between this `finset` and\nthe set of length-`n` walks.", "p": "mathlib"}, {"name": "simple_graph.walk.rotate_edges", "description": "", "p": "mathlib"}, {"name": "simple_graph.connected_component.supp_inj", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.support_append", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.cons_is_cycle_iff", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.is_path.of_append_left", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.cons_is_path_iff", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.drop_until", "description": " Given a vertex in the support of a path, give the path from (and including) that vertex to\nthe end. In other words, drop vertices from the front of a path until (and not including)\nthat vertex.", "p": "mathlib"}, {"name": "simple_graph.reachable_is_equivalence", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.is_trail.map_le", "description": "**Alias** of the reverse direction of `simple_graph.walk.map_le_is_trail`.", "p": "mathlib"}, {"name": "simple_graph.walk.length_support", "description": "", "p": "mathlib"}, {"name": "simple_graph.preconnected.map", "description": "", "p": "mathlib"}, {"name": "simple_graph.path.singleton", "description": "The length-1 path between a pair of adjacent vertices.", "p": "mathlib"}, {"name": "simple_graph.walk.edges_transfer", "description": "", "p": "mathlib"}, {"name": "simple_graph.path.loop_eq", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.is_path.to_delete_edges", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.chain_adj_support", "description": "", "p": "mathlib"}, {"name": "simple_graph.path.singleton_coe", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.length_bypass_le", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.adj_get_vert_succ", "description": "", "p": "mathlib"}, {"name": "simple_graph.path.map_embedding", "description": "Given a graph embedding, map paths to paths.", "p": "mathlib"}, {"name": "simple_graph.walk.length_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.to_subgraph", "description": "The subgraph consisting of the vertices and edges of the walk.", "p": "mathlib"}, {"name": "simple_graph.walk.is_path.of_map_le", "description": "**Alias** of the forward direction of `simple_graph.walk.map_le_is_path`.", "p": "mathlib"}, {"name": "simple_graph.walk.darts_copy", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.support_concat", "description": "", "p": "mathlib"}, {"name": "simple_graph.iso.connected_component_equiv_symm", "description": "", "p": "mathlib"}, {"name": "simple_graph.walk.map_eq_of_eq", "description": " Unlike categories, for graphs vertex equality is an important notion, so needing to be able to\nto work with equality of graph homomorphisms is a necessary evil.", "p": "mathlib"}, {"name": "simple_graph.walk.cons'", "description": "Pattern to get `walk.cons` with the 