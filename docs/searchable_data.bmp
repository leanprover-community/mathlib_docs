iption": "", "p": "mathlib"}, {"name": "set.nonempty.sigma_snd", "description": "", "p": "mathlib"}, {"name": "set.sigma_subset_preimage_fst", "description": "", "p": "mathlib"}, {"name": "set.insert_sigma", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.approx_on_mem", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.nearest_pt", "description": " `nearest_pt e N x` is the nearest point to `x` among the points `e 0`, ..., `e N`. If more than\none point are at the same distance from `x`, then `nearest_pt e N x` returns the point with the\nleast possible index.", "p": "mathlib"}, {"name": "measure_theory.simple_func.edist_nearest_pt_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.nearest_pt_ind_succ", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.edist_approx_on_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.tendsto_nearest_pt", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.nearest_pt_ind", "description": " `nearest_pt_ind e N x` is the index `k` such that `e k` is the nearest point to `x` among the\npoints `e 0`, ..., `e N`. If more than one point are at the same distance from `x`, then\n`nearest_pt_ind e N x` returns the least of their indexes.", "p": "mathlib"}, {"name": "measure_theory.simple_func.approx_on_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.approx_on", "description": " Approximate a measurable function by a sequence of simple functions `F n` such that\n`F n x \u2208 s`.", "p": "mathlib"}, {"name": "measure_theory.simple_func.edist_approx_on_y0_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.tendsto_approx_on", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.edist_approx_on_mono", "description": "", "p": "mathlib"}, {"name": "measure_theory.simple_func.approx_on_comp", "description": "", "p": "mathlib"},