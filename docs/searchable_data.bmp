name": "category_theory.limits.types.quot.rel", "description": "The relation defining the quotient type which implements the colimit of a functor `F : J \u2964 Type u`.\nSee `category_theory.limits.types.quot`.", "p": "mathlib"}, {"name": "category_theory.limits.types.limit_equiv_sections_symm_apply'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit.\u03b9_map_apply'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit.map_\u03c0_apply'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.has_colimits_of_size", "description": "The category of types has all colimits.\n\nSee <https://stacks.math.columbia.edu/tag/002U>.", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit.w_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit.\u03b9_map_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit_equiv_sections_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.image", "description": "the image of a morphism in Type is just `set.range f`", "p": "mathlib"}, {"name": "category_theory.limits.types.filtered_colimit.is_colimit_eq_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.image.lift", "description": "the universal property for the image factorisation", "p": "mathlib"}, {"name": "category_theory.limits.types.jointly_surjective", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit.lift_\u03c0_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit.\u03b9_desc_apply'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit_equiv_quot", "description": "The equivalence between the abstract colimit of `F` in `Type u`\nand the \"concrete\" definition as a quotient.", "p": "mathlib"}, {"name": "category_theory.limits.types.jointly_surjective'", "description": "A variant of `jointly_surjective` for `x : colimit F`.", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit.\u03b9_desc_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.sort.category_theory.limits.has_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.sort.category_theory.limits.has_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.category_theory.limits.has_image", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit.mk", "description": "Construct a term of `limit F : Type u` from a family of terms `x : \u03a0 j, F.obj j`\nwhich are \"coherent\": `\u2200 (j j') (f : j \u27f6 j'), F.map f (x j) = x j'`.", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit_sound", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.quot", "description": "A quotient type implementing the colimit of a functor `F : J \u2964 Type u`,\nas pairs `\u27e8j, x\u27e9` where `x : F.obj j`, modulo the equivalence relation generated by\n`\u27e8j, x\u27e9 ~ \u27e8j', x'\u27e9` whenever there is a morphism `f : j \u27f6 j'` so `F.map f x = x'`.", "p": "mathlib"}, {"name": "category_theory.limits.types.sort.category_theory.limits.has_images", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit_ext_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit.w_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.filtered_colimit.rel_eq_eqv_gen_quot_rel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.filtered_colimit.rel_of_quot_rel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit_ext_iff'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.mono_factorisation", "description": "the factorisation of any morphism in Type through a mono.", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit_cocone", "description": "(internal implementation) the colimit cocone of a functor,\nimplemented as a quotient of a sigma type", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit_sound'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit.\u03c0_mk'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.is_limit_equiv_sections", "description": "The equivalence between a limiting cone of `F` in `Type u` and the \"concrete\" definition as the\nsections of `F`.", "p": "mathlib"}, {"name": "category_theory.limits.types.filtered_colimit.rel", "description": "An alternative relation on `\u03a3 j, F.obj j`,\nwhich generates the same equivalence relation as we use to define the colimit in `Type` above,\nbut that is more convenient when working with filtered colimits.\n\nElements in `F.obj j` and `F.obj j'` are equivalent if there is some `k : J` to the right\nwhere their images are equal.", "p": "mathlib"}, {"name": "category_theory.limits.types.limit_cone_is_limit", "description": "(internal implementation) the fact that the proposed limit cone is the limit", "p": "mathlib"}, {"name": "category_theory.limits.types.limit.w_apply'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit_ext'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit_equiv_quot_symm_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.is_image", "description": "the facorisation through a mono has the universal property of the image.", "p": "mathlib"}, {"name": "category_theory.limits.types.filtered_colimit.rel_equiv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit_cone", "description": "(internal implementation) the limit cone of a functor,\nimplemented as flat sections of a pi type", "p": "mathlib"}, {"name": "category_theory.limits.types.image.\u03b9.category_theory.mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.filtered_colimit.eqv_gen_quot_rel_of_rel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.image.\u03b9", "description": "the inclusion of `image f` into the target", "p": "mathlib"}, {"name": "category_theory.limits.types.image.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.has_limits_of_size", "description": "The category of types has all limits.\n\nSee <https://stacks.math.columbia.edu/tag/002U>.", "p": "mathlib"}, {"name": "category_theory.limits.types.limit.lift_\u03c0_apply'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.is_limit_equiv_sections_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.colimit_cocone_is_colimit", "description": "(internal implementation) the fact that the proposed colimit cocone is the colimit", "p": "mathlib"}, {"name": "category_theory.limits.types.sort.category_theory.limits.has_image_maps", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.types.limit_equiv_sections", "description": "The equivalence between the abstract limit of `F` in `Type u`\nand the \"concrete\" definition as the sections of `F`.", "p": "mathlib"}, {"name": "zeta_eq_tsum_one_div_nat_add_one_cpow", "description": " The Riemann zeta function agrees with the naive Dirichlet-series definition when the latter\nconverges. (Note that this is false without the assumption: when `re s \u2264 1` the sum is divergent,\nand we use a different definition to obtain the analytic continuation to all `s`.)", "p": "mathlib"}, {"name": "summable_exp_neg_pi_mul_nat_sq", "description": "The sum defining `zeta_kernel\u2081` is convergent.", "p": "mathlib"}, {"name": "is_O_zero_zeta_kernel\u2082", "description": "Precise but awkward-to-use bound for `zeta_kernel\u2082` for `t \u2192 0`.", "p": "mathlib"}, {"name": "zeta_kernel\u2082", "description": "Modified zeta kernel, whose Mellin transform is entire. -", "p": "mathlib"}, {"name": "riemann_zeta", "description": " The Riemann zeta function `\u03b6(s)`. We set this to be irreducible to hide messy implementation\ndetails.", "p": "mathlib"}, {"name": "differentiable_at_mellin_zeta_kernel\u2081", "description": "The Mellin transform of the first zeta kernel is holomorphic for `1 / 2 < re s`.", "p": "mathlib"}, {"name": "locally_integrable_zeta_kernel\u2081", "description": "Local integrability of `zeta_kernel\u2081`.", "p": "mathlib"}, {"name": "riemann_zeta_two", "description": "", "p": "mathlib"}, {"name": "completed_zeta_eq_mellin_of_one_lt_re", "description": "", "p": "mathlib"}, {"name": "differentiable_mellin_zeta_kernel\u2082", "description": "The Mellin transform of the second zeta kernel is entire.", "p": "mathlib"}, {"name": "integral_cpow_mul_exp_neg_pi_mul_sq", "description": " Auxiliary lemma for `mellin_zeta_kernel\u2081_eq_tsum`, computing the Mellin transform of an\nindividual term in the series.", "p": "mathlib"}, {"name": "differentiable_at_completed_zeta", "description": " The completed Riemann zeta function `\u039b(s)` is differentiable away from `s = 0` and `s = 1`\n(where it has simple poles).", "p": "mathlib"}, {"name": "differentiable_completed_zeta\u2080", "description": "The modified completed Riemann zeta function `\u039b(s) + 1 / s - 1 / (s - 1)` is entire.", "p": "mathlib"}, {"name": "riemann_hypothesis", "description": " A formal statement of the Riemann hypothesis \u2013 constructing a term of this type is worth a\nmillion dollars.", "p": "mathlib"}, {"name": "riemann_zeta_four", "description": "", "p": "mathlib"}, {"name": "zeta_kernel\u2081", "description": "Function whose Mellin transform is `\u03c0 ^ (-s) * \u0393(s) * zeta (2 * s)`, for `1 / 2 < Re s`.", "p": "mathlib"}, {"name": "riemann_zeta_neg_two_mul_nat_add_one", "description": "The trivial zeroes of the zeta function.", "p": "mathlib"}, {"name": "has_mellin_one_div_sqrt_sub_one_div_two_Ioc", "description": "Evaluate the Mellin transform of the \"fudge factor\" in `zeta_kernel\u2082`", "p": "mathlib"}, {"name": "is_O_at_top_zeta_kernel\u2082", "description": "Bound for `zeta_kernel\u2082` for large `t`.", "p": "mathlib"}, {"name": "riemann_zeta_one_sub", "description": " Riemann zeta functional equation, formulated for `\u03b6`: if `1 - s \u2209 \u2115`, then we have\n`\u03b6 (1 - s) = 2 ^ (1 - s) * \u03c0 ^ (-s) * \u0393 s * sin (\u03c0 * (1 - s) / 2) * \u03b6 s`.", "p": "mathlib"}, {"name": "is_O_zero_zeta_kernel\u2082_rpow", "description": "Weaker but more usable bound for `zeta_kernel\u2082` for `t \u2192 0`.", "p": "mathlib"}, {"name": "is_O_at_top_zeta_kernel\u2081", "description": "Bound for `zeta_kernel\u2081` for large `t`.", "p": "mathlib"}, {"name": "locally_integrable_zeta_kernel\u2082", "description": "Local integrability of `zeta_kernel\u2082`.", "p": "mathlib"}, {"name": "riemann_zeta_zero", "description": "We have `\u03b6(0) = -1 / 2`.", "p": "mathlib"}, {"name": "riemann_completed_zeta", "description": " The completed Riemann zeta function, `\u039b(s)`, which satisfies\n`\u039b(s) = \u03c0 ^ (-s / 2) \u0393(s / 2) \u03b6(s)` (up to a minor correction at `s = 0`).", "p": "mathlib"}, {"name": "completed_zeta_eq_tsum_of_one_lt_re", "description": "", "p": "mathlib"}, {"name": "differentiable_at_riemann_zeta", "description": "The Riemann zeta function is differentiable away from `s = 1`.", "p": "mathlib"}, {"name": "has_mellin_one_div_sqrt_Ioc", "description": "", "p": "mathlib"}, {"name": "riemann_zeta_neg_nat_eq_bernoulli", "description": "", "p": "mathlib"}, {"name": "mellin_zeta_kernel\u2081_eq_tsum", "description": "", "p": "mathlib"}, {"name": "riemann_zeta_two_mul_nat", "description": " Explicit formula for `\u03b6 (2 * k)`, for `k \u2208 \u2115` with `k \u2260 0`: we have\n`\u03b6 (2 * k) = (-1) ^ (k + 1) * 2 ^ (2 * k - 1) * \u03c0 ^ (2 * k) * bernoulli (2 * k) / (2 * k)!`.\nCompare `has_sum_zeta_nat` for a version formulated explicitly as a sum, and\n`riemann_zeta_neg_nat_eq_bernoulli` for values at negative integers (equivalent to the above via\nthe functional equation).", "p": "mathlib"}, {"name": "zeta_kernel\u2081_eq_jacobi_theta", "description": " Relate `zeta_kernel\u2081` to the Jacobi theta function on `\u210d`. (We don't use this as the definition\nof `zeta_kernel\u2081`, since the sum over `\u2115` rather than `\u2124` is more convenient for relating zeta to\nthe Dirichlet series for `re s > 1`.)", "p": "mathlib"}, {"name": "riemann_completed_zeta\u2080", "description": "The completed Riemann zeta function with its poles removed, `\u039b(s) + 1 / s - 1 / (s - 1)`.", "p": "mathlib"}, {"name": "is_O_zero_zeta_kernel\u2081", "description": "Bound for `zeta_kernel\u2081` for `t \u2192 0`.", "p": "mathlib"}, {"name": "mellin_zeta_kernel\u2082_eq_of_lt_re", "description": "", "p": "mathlib"}, {"name": "zeta_eq_tsum_one_div_nat_cpow", "description": " Alternate formulation of `zeta_eq_tsum_one_div_nat_add_one_cpow` without the `+ 1`, using the\nfact that for `s \u2260 0` we define `0 ^ s = 0`.", "p": "mathlib"}, {"name": "riemann_completed_zeta_one_sub", "description": " Riemann zeta functional equation, formulated for `\u039b`: for any complex `s` we have\n`\u039b (1 - s) = \u039b s`.", "p": "mathlib"}, {"name": "continuous_at_zeta_kernel\u2081", "description": "Continuity of `zeta_kernel\u2081`.", "p": "mathlib"}, {"name": "riemann_completed_zeta\u2080_one_sub", "description": " Riemann zeta functional equation, formulated for `\u039b\u2080`: for any complex `s` we have\n`\u039b\u2080(1 - s) = \u039b\u2080 s`.", "p": "mathlib"}, {"name": "zeta_nat_eq_tsum_of_gt_one", "description": " Special case of `zeta_eq_tsum_one_div_nat_cpow` when the argument is in `\u2115`, so the power\nfunction can be expressed using na\u00efve `pow` rather than `cpow`.", "p": "mathlib"}, {"name": "zeta_kernel\u2082_one_div", "description": "Functional equation for `zeta_kernel\u2082`.", "p": "mathlib"}, {"name": "is_metric_separated.symm", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.union_right_iff", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.empty_left", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.finset_Union_right", "description": "**Alias** of the reverse direction of `is_metric_separated.finset_Union_right_iff`.", "p": "mathlib"}, {"name": "is_metric_separated.mono", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.finset_Union_right_iff", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.union_left", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.union_left_iff", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.comm", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.union_right", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.mono_right", "description": "", "p": "mathlib"}, {"name": "is_metric_separated", "description": " Two sets in an (extended) metric space are called *metric separated* if the (extended) distance\nbetween `x \u2208 s` and `y \u2208 t` is bounded from below by a positive constant.", "p": "mathlib"}, {"name": "is_metric_separated.disjoint", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.finite_Union_left", "description": "**Alias** of the reverse direction of `is_metric_separated.finite_Union_left_iff`.", "p": "mathlib"}, {"name": "is_metric_separated.finset_Union_left", "description": "**Alias** of the reverse direction of `is_metric_separated.finset_Union_left_iff`.", "p": "mathlib"}, {"name": "is_metric_separated.finite_Union_right_iff", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.subset_compl_right", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.finite_Union_left_iff", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.mono_left", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.finset_Union_left_iff", "description": "", "p": "mathlib"}, {"name": "is_metric_separated.empty_right", "description": "", "p": "mathlib"}, {"name": "is_modular_lattice.to_is_lower_modular_lattice", "description": "", "p": "mathlib"}, {"name": "is_modular_lattice.is_modular_lattice_Iic", "description": "", "p": "mathlib"}, {"name": "is_weak_lower_modular_lattice", "description": " A weakly lower modular lattice is a lattice where `a` and `b` cover `a \u2293 b` if `a \u2294 b` covers\nboth `a` and `b`.", "p": "mathlib"}, {"name": "is_weak_lower_modular_lattice.inf_covby_of_covby_covby_sup", "description": " A weakly lower modular lattice is a lattice where `a` and `b` cover `a \u2293 b` if `a \u2294 b` covers\nboth `a` and `b`.", "p": "mathlib"}, {"name": "order_dual.is_weak_upper_modular_lattice", "description": "", "p": "mathlib"}, {"name": "inf_sup_assoc_of_le", "description": "", "p": "mathlib"}, {"name": "covby.inf_of_sup_of_sup_right", "description": "**Alias** of `inf_covby_of_covby_sup_of_covby_sup_right`.", "p": "mathlib"}, {"name": "covby.sup_of_inf_of_inf_left", "description": "**Alias** of `covby_sup_of_inf_covby_of_inf_covby_left`.", "p": "mathlib"}, {"name": "is_lower_modular_lattice", "description": " A lower modular lattice is a lattice where `a` and `b` both cover `a \u2293 b` if `a \u2294 b` covers\neither `a` or `b`.", "p": "mathlib"}, {"name": "is_lower_modular_lattice.inf_covby_of_covby_sup", "description": " A lower modular lattice is a lattice where `a` and `b` both cover `a \u2293 b` if `a \u2294 b` covers\neither `a` or `b`.", "p": "mathlib"}, {"name": "well_founded_lt_exact_sequence", "description": "A generalization of the theorem that if `N` is a submodule of `M` and\n `N` and `M / N` are both Artinian, then `M` is Artinian.", "p": "mathlib"}, {"name": "ord