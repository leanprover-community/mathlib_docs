, {"name": "smul_nonpos_of_nonpos_of_nonneg", "description": "", "p": "mathlib"}, {"name": "smul_pos_of_neg_of_neg", "description": "**Alias** of the reverse direction of `smul_pos_iff_of_neg`.", "p": "mathlib"}, {"name": "inv_smul_le_iff_of_neg", "description": "", "p": "mathlib"}, {"name": "order_iso.smul_left_dual", "description": "Left scalar multiplication as an order isomorphism.", "p": "mathlib"}, {"name": "smul_add_smul_lt_smul_add_smul", "description": "Binary strict **rearrangement inequality**.", "p": "mathlib"}, {"name": "smul_nonneg_of_nonpos_of_nonpos", "description": "", "p": "mathlib"}, {"name": "lower_bounds_smul_of_neg", "description": "", "p": "mathlib"}, {"name": "bdd_above_smul_iff_of_neg", "description": "", "p": "mathlib"}, {"name": "smul_lt_smul_iff_of_neg", "description": "", "p": "mathlib"}, {"name": "smul_min_of_nonpos", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat", "description": "The Grothendieck construction applied to a functor to `Type`\n(thought of as a functor to `Cat` by realising a type as a discrete category)\nis the same as the 'category of elements' construction.", "p": "mathlib"}, {"name": "category_theory.grothendieck.comp", "description": "Composition of morphisms in the Grothendieck category.", "p": "mathlib"}, {"name": "category_theory.grothendieck.id_fiber", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_functor_obj_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_inverse_2", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_inverse_map_fiber_down_down", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.hom.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck", "description": "The Grothendieck construction (often written as `\u222b F` in mathematics) for a functor `F : C \u2964 Cat`\ngives a category whose\n* objects `X` consist of `X.base : C` and `X.fiber : F.obj base`\n* morphisms `f : X \u27f6 Y` consist of\n  `base : X.base \u27f6 Y.base` and\n  `f.fiber : (F.map base).obj X.fiber \u27f6 Y.fiber`", "p": "mathlib"}, {"name": "category_theory.grothendieck.base", "description": "The Grothendieck construction (often written as `\u222b F` in mathematics) for a functor `F : C \u2964 Cat`\ngives a category whose\n* objects `X` consist of `X.base : C` and `X.fiber : F.obj base`\n* morphisms `f : X \u27f6 Y` consist of\n  `base : X.base \u27f6 Y.base` and\n  `f.fiber : (F.map base).obj X.fiber \u27f6 Y.fiber`", "p": "mathlib"}, {"name": "category_theory.grothendieck.fiber", "description": "The Grothendieck construction (often written as `\u222b F` in mathematics) for a functor `F : C \u2964 Cat`\ngives a category whose\n* objects `X` consist of `X.base : C` and `X.fiber : F.obj base`\n* morphisms `f : X \u27f6 Y` consist of\n  `base : X.base \u27f6 Y.base` and\n  `f.fiber : (F.map base).obj X.fiber \u27f6 Y.fiber`", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_functor_map_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.comp_base", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_functor_2", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.forget_map", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_functor_obj_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.forget_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_counit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_inverse_obj_fiber_as", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.id_fiber'", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.congr", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.forget", "description": "The forgetful functor from `grothendieck F` to the source category.", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_inverse_obj_base", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.hom", "description": "A morphism in the Grothendieck category `F : C \u2964 Cat` consists of\n`base : X.base \u27f6 Y.base` and `f.fiber : (F.map base).obj X.fiber \u27f6 Y.fiber`.", "p": "mathlib"}, {"name": "category_theory.grothendieck.hom.base", "description": "A morphism in the Grothendieck category `F : C \u2964 Cat` consists of\n`base : X.base \u27f6 Y.base` and `f.fiber : (F.map base).obj X.fiber \u27f6 Y.fiber`.", "p": "mathlib"}, {"name": "category_theory.grothendieck.hom.fiber", "description": "A morphism in the Grothendieck category `F : C \u2964 Cat` consists of\n`base : X.base \u27f6 Y.base` and `f.fiber : (F.map base).obj X.fiber \u27f6 Y.fiber`.", "p": "mathlib"}, {"name": "category_theory.grothendieck.id", "description": "The identity morphism in the Grothendieck category.", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_inverse", "description": "Auxiliary definition for `grothendieck_Type_to_Cat`, to speed up elaboration.", "p": "mathlib"}, {"name": "category_theory.grothendieck.category_theory.category", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_functor", "description": "Auxiliary definition for `grothendieck_Type_to_Cat`, to speed up elaboration.", "p": "mathlib"}, {"name": "category_theory.grothendieck.id_base", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.comp_fiber", "description": "", "p": "mathlib"}, {"name": "category_theory.grothendieck.grothendieck_Type_to_Cat_inverse_map_base", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.of_limit_cone_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.whisker_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.is_bilimit", "description": "Structure witnessing that a bicone is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.is_bilimit.is_limit", "description": "Structure witnessing that a bicone is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.is_bilimit.is_colimit", "description": "Structure witnessing that a bicone is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.symmetry'_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_iso", "description": " Given a pair of isomorphisms between the summands of a pair of binary biproducts,\nwe obtain an isomorphism between the binary biproducts.", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_coproducts_of_has_binary_biproducts", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_bicone_of_unique_bicone_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_to_subtype_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.hom_ext'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.matrix_equiv", "description": "Morphisms between direct sums are matrices.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct_unique_iso", "description": "A biproduct over a index type with exactly one term is just the object over that term.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.unique_up_to_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.from_subtype_\u03c0_subtype_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_biproducts_of_finite_biproducts", "description": "A category with finite biproducts has binary biproducts.\n\nThis is not an instance as typically in concrete categories there will be\nan alternative construction with nicer definitional properties.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_cocone_\u03b9_app_left", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biproduct_to_subtype_iso", "description": "The kernel of `biproduct.to_subtype f p` is `\u2a01 subtype.restrict p\u1d9c f`.", "p": "mathlib"}, {"name": "category_theory.limits.bicone_\u03b9_\u03c0_self", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_cone_\u03c0_app_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inr_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biprod_fst_iso", "description": "The kernel of `biprod.fst : X \u229e Y \u27f6 X` is `Y`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9.has_cokernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork_biproduct_from_subtype", "description": " The colimit cocone exhibiting `\u2a01 subtype.restrict p\u1d9c f` as the cokernel of\n`biproduct.from_subtype f p`", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_cokernel_cofork", "description": " A cokernel cofork for the cokernel of `biprod.inl`. It consists of the\nmorphism `biprod.snd`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.lift_map_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_bicone_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_biproduct.has_colimit_pair", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map", "description": " Given a collection of maps between corresponding summands of a pair of biproducts\nindexed by the same type, we obtain a map between the biproducts.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork_biproduct_from_subtype_is_colimit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.subsingleton_is_bilimit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.of_limit_cone", "description": "We can turn any limit cone over a discrete collection of objects into a bicone.", "p": "mathlib"}, {"name": "category_theory.is_iso_right_of_is_iso_biprod_map", "description": "If\n```lean\n(f 0)\n(0 g)\n```\nis invertible, then `g` is invertible.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inl_fst_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_cokernel_cofork_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct.is_limit", "description": "`binary_biproduct.bicone P Q` is a limit cone.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map'", "description": " An alternative to `biproduct.map` constructed via colimits.\nThis construction only exists in order to show it is equal to `biproduct.map`.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.binary_cofan_inl_to_cocone", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.fst_kernel_fork", "description": " A kernel fork for the kernel of `biprod.fst`. It consists of the\nmorphism `biprod.inr`.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.snd", "description": "The projection onto the second summand of a binary biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.iso_biprod_zero", "description": "If `Y` is a zero object, `X \u2245 X \u229e Y` for any `X`.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braid_natural_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.of_limit_cone_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.\u03b9_of_is_limit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_binary_bicone_inl", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.of_colimit_cocone_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_to_subtype", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.from_subtype_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.fst_kernel_fork_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_binary_bicone_is_bilimit", "description": "A bicone over a pair is a bilimit bicone if and only if the corresponding binary bicone is a\n   bilimit.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.lift", "description": "Given a collection of maps into the summands, we obtain a map into the biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.cone_point_unique_up_to_iso_hom", "description": "Auxiliary lemma for `biprod.unique_up_to_iso`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct_iso", "description": "The isomorphism between the specified limit and the specified colimit for\na functor with a bilimit.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.iso_coprod_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork_biproduct_to_subtype_is_limit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.lift", "description": " Given a pair of maps into the summands of a binary biproduct,\nwe obtain a map into the binary biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.lift_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_coproduct_of_has_biproduct", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braiding'_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biproduct_from_subtype_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.whisker_to_cocone", "description": " Taking the cocone of a whiskered bicone results in a cone isomorphic to one gained\nby whiskering the cocone and precomposing with a suitable isomorphism.", "p": "mathlib"}, {"name": "category_theory.limits.has_biproduct", "description": "`has_biproduct F` expresses the mere existence of a bicone which is\nsimultaneously a limit and a colimit of the diagram `F`.", "p": "mathlib"}, {"name": "category_theory.limits.has_biproduct.exists_biproduct", "description": "`has_biproduct F` expresses the mere existence of a bicone which is\nsimultaneously a limit and a colimit of the diagram `F`.", "p": "mathlib"}, {"name": "category_theory.indecomposable", "description": "An object is indecomposable if it cannot be written as the biproduct of two nonzero objects.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.is_kernel_snd_kernel_fork", "description": "The fork `biprod.snd_kernel_fork` is indeed a limit.", "p": "mathlib"}, {"name": "category_theory.limits.get_binary_biproduct_data", "description": "Use the axiom of choice to extract explicit `binary_biproduct_data F` from `has_binary_biproduct F`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.from_subtype.has_cokernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.fst.category_theory.is_split_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork_biproduct_to_subtype_cone", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.iso_prod_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.whisker_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.lift_\u03c0_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.epi_desc_of_epi_left", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braid_natural", "description": "The braiding isomorphism can be passed through a map by swapping the order.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.hom_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biproduct_from_subtype_iso", "description": "The cokernel of `biproduct.from_subtype f p` is `\u2a01 subtype.restrict p\u1d9c f`.", "p": "mathlib"}, {"name": "category_theory.limits.has_finite_biproducts", "description": " `has_finite_biproducts C` represents a choice of biproduct for every family of objects in `C`\nindexed by a finite type.", "p": "mathlib"}, {"name": "category_theory.limits.has_finite_biproducts.out", "description": " `has_finite_biproducts C` represents a choice of biproduct for every family of objects in `C`\nindexed by a finite type.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.whisker", "description": "Whisker a bicone with an equivalence between the indexing types.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_cone_\u03c0_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.iso_zero_biprod_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.iso_coprod", "description": "The canonical isomorphism between the chosen biproduct and the chosen coproduct.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.mono_lift_of_mono_right", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.is_limit_fst_kernel_fork", "description": "The fork defined in `binary_bicone.fst_kernel_fork` is indeed a kernel.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.fst_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr", "description": "The inclusion into the second summand of a binary biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct_data", "description": "A bicone over `P Q : C`, which is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct_data.bicone", "description": "A bicone over `P Q : C`, which is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct_data.is_bilimit", "description": "A bicone over `P Q : C`, which is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.is_limit", "description": "`biproduct.bicone F` is a limit cone.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.of_colimit_cocone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_fst_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_\u03c0_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.fst_kernel_fork_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_binary_bicone", "description": "Convert a `bicone` over a function on `walking_pair` to a binary_bicone.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_\u03c0", "description": " Note that as this lemma has a `if` in the statement, we include a `decidable_eq` argument.\nThis means you may not be able to `simp` using this lemma unless you `open_locale classical`.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.epi_desc_of_epi_right", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.unique_up_to_iso", "description": "Biproducts are unique up to isomorphism. This already follows because bilimits are limits,\n   but in the case of biproducts we can give an isomorphism with particularly nice definitional\n   properties, namely that `biproduct.lift b.\u03c0` and `biproduct.desc b.\u03b9` are inverses of each\n   other.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_cone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.iso_coproduct_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.is_limit_snd_kernel_fork", "description": "The fork defined in `binary_bicone.snd_kernel_fork` is indeed a kernel.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_eq_map'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.iso_coproduct_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_map_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone_\u03b9_\u03c0_ne", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.lift_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.bicone_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.from_subtype_to_subtype", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.unique_up_to_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_bicone_of_unique_is_bilimit_is_colimit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_bicone_of_unique", "description": "The limit bicone for the biproduct over an index type with exactly one term.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biproduct_\u03b9_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.is_colimit_inl_cokernel_cofork", "description": "The cofork defined in `binary_bicone.inl_cokernel_cofork` is indeed a cokernel.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.snd.category_theory.is_split_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.snd_kernel_fork", "description": " A kernel fork for the kernel of `biprod.snd`. It consists of the\nmorphism `biprod.inl`.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.of_colimit_cocone_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone_\u03b9_\u03c0_self_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.cone_point_unique_up_to_iso_inv", "description": "Auxiliary lemma for `biproduct.unique_up_to_iso`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biprod_fst_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_cocone", "description": "Extract the cocone from a bicone.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map", "description": " Given a pair of maps between the summands of a pair of binary biproducts,\nwe obtain a map between the binary biproducts.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_cofork_biproduct_from_subtype_cocone", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct.bicone_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_biproducts_of_shape_of_equiv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.is_bilimit.ext", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_fst_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biprod_inr_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_binary_bicone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.from_subtype", "description": " The canonical morphism from the biproduct over a restricted index type to the biproduct of\nthe full index type.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.is_colimit_inr_cokernel_cofork", "description": "The cofork defined in `binary_bicone.inr_cokernel_cofork` is indeed a cokernel.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.matrix_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.binary_fan_snd_to_cone", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_eq_map'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.to_subtype_from_subtype_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_to_subtype_subtype", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.components", "description": "Extract the matrix components from a morphism of biproducts.", "p": "mathlib"}, {"name": "category_theory.limits.iso_biprod_zero_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct.is_colimit", "description": "`binary_biproduct.bicone P Q` is a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_cone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03c0_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_finite_products_of_has_finite_biproducts", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.snd_kernel_fork", "description": " A kernel fork for the kernel of `binary_bicone.snd`. It consists of the morphism\n`binary_bicone.inl`.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.desc", "description": " Given a pair of maps out of the summands of a binary biproduct,\nwe obtain a map out of the binary biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_bicone", "description": "Convert a `binary_bicone` into a `bicone` over a pair.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_bicone_is_colimit", "description": "A binary bicone is a colimit cocone if and only if the corresponding bicone is a colimit\n   cocone.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_cone_\u03c0_app_left", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inr_cokernel_cofork", "description": " A cokernel cofork for the cokernel of `binary_bicone.inr`. It consists of the morphism\n`binary_bicone.fst`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_matrix_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biprod_snd_iso", "description": "The kernel of `biprod.snd : X \u229e Y \u27f6 Y` is `X`.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inr.category_theory.is_split_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.snd_kernel_fork_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braiding_map_braiding_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.from_subtype_\u03c0_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_\u03c0_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inr_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.iso_prod", "description": "The canonical isomorphism between the chosen biproduct and the chosen product.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_cocone_\u03b9_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_bicone", "description": "A bicone over `F : J \u2192 C`, which is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.limit_bicone.bicone", "description": "A bicone over `F : J \u2192 C`, which is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.limit_bicone.is_bilimit", "description": "A bicone over `F : J \u2192 C`, which is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03c0.has_kernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.unique_up_to_iso", "description": "Binary biproducts are unique up to isomorphism. This already follows because bilimits are\n   limits, but in the case of biproducts we can give an isomorphism with particularly nice\n   definitional properties, namely that `biprod.lift b.fst b.snd` and `biprod.desc b.inl b.inr`\n   are inverses of each other.", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct.bicone_inl", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.symmetry_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.bicone_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_cocone_\u03b9_app_right", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_biproduct", "description": "`has_binary_biproduct P Q` expresses the mere existence of a bicone which is\nsimultaneously a limit and a colimit of the diagram `pair P Q`.", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_biproduct.exists_binary_biproduct", "description": "`has_binary_biproduct P Q` expresses the mere existence of a bicone which is\nsimultaneously a limit and a colimit of the diagram `pair P Q`.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inl_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.\u03c0_of_is_colimit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_cone_\u03c0_app_right", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_cocone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_binary_bicone_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map'", "description": " An alternative to `biprod.map` constructed via colimits.\nThis construction only exists in order to show it is equal to `biprod.map`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.from_subtype_eq_lift", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_biproduct_unique", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_bicone_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inl.category_theory.is_split_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl.has_cokernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_biproduct.has_limit_pair", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biprod_inl_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.of_colimit_cocone", "description": "We can turn any colimit cocone over a discrete collection of objects into a bicone.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_binary_bicone_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr.has_cokernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.to_subtype_\u03c0_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braiding", "description": "The braiding isomorphism which swaps a binary biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.is_limit_from_subtype", "description": " The kernel of `biproduct.\u03c0 f i` is the inclusion from the biproduct which omits `i`\nfrom the index set `J` into the biproduct over `J`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biproduct_\u03c0_iso", "description": "The kernel of `biproduct.\u03c0 f i` is `\u2a01 subtype.restrict {i}\u1d9c f`.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_bicone_is_limit", "description": "A binary bicone is a limit cone if and only if the corresponding bicone is a limit cone.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_fork_biproduct_to_subtype", "description": " The limit cone exhibiting `\u2a01 subtype.restrict p\u1d9c f` as the kernel of\n`biproduct.to_subtype f p`", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.lift_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.matrix_components", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inl_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.hom_ext'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biprod_fst_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct.is_bilimit", "description": "`binary_biproduct.bicone P Q` is a limit bicone.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.unique_up_to_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.from_subtype_\u03c0_subtype", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.matrix_equiv_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_products_of_has_binary_biproducts", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_biproducts_of_shape", "description": "`C` has biproducts of shape `J` if we have\na limit and a colimit, with the same cone points,\nof every function `F : J \u2192 C`.", "p": "mathlib"}, {"name": "category_theory.limits.has_biproducts_of_shape.has_biproduct", "description": "`C` has biproducts of shape `J` if we have\na limit and a colimit, with the same cone points,\nof every function `F : J \u2192 C`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.from_subtype_to_subtype_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.whisker_is_bilimit_iff", "description": "Whiskering a bicone with an equivalence between types preserves being a bilimit bicone.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braiding_map_braiding", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.binary_cofan_inr_to_cocone", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biprod_inl_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.bicone", "description": "A bicone for `F` which is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braiding'_eq_braiding", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.fst_kernel_fork", "description": " A kernel fork for the kernel of `binary_bicone.fst`. It consists of the morphism\n`binary_bicone.inr`.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.fst", "description": "The projection onto the first summand of a binary biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braiding'", "description": "An alternative formula for the braiding isomorphism which swaps a binary biproduct,\nusing the fact that the biproduct is a coproduct.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_binary_bicone_is_limit", "description": "A bicone over a pair is a limit cone if and only if the corresponding binary bicone is a limit\n   cone.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.is_bilimit", "description": "Structure witnessing that a binary bicone is a limit cone and a limit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.is_bilimit.is_limit", "description": "Structure witnessing that a binary bicone is a limit cone and a limit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.is_bilimit.is_colimit", "description": "Structure witnessing that a binary bicone is a limit cone and a limit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.matrix_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.is_iso_inl_iff_id_eq_fst_comp_inl", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod", "description": "An arbitrary choice of biproduct of a pair of objects.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03c0", "description": "The projection onto a summand of a biproduct.", "p": "mathlib"}, {"name": "category_theory.is_iso_left_of_is_iso_biprod_map", "description": "If\n```lean\n(f 0)\n(0 g)\n```\nis invertible, then `f` is invertible.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inr_fst_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.to_subtype_from_subtype", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inr_cokernel_cofork_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.whisker_to_cone", "description": " Taking the cone of a whiskered bicone results in a cone isomorphic to one gained\nby whiskering the cone and postcomposing with a suitable isomorphism.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_binary_bicone_is_colimit", "description": "A bicone over a pair is a colimit cocone if and only if the corresponding binary bicone is a\n   colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.binary_fan_fst_to_cone", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_cokernel_cofork", "description": " A cokernel cofork for the cokernel of `biprod.inr`. It consists of the\nmorphism `biprod.fst`.", "p": "mathlib"}, {"name": "category_theory.limits.has_biproduct.mk", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_biproducts_of_shape_finite", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.iso_zero_biprod_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biprod_inr_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_map_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.to_subtype", "description": " The canonical morphism from a biproduct to the biproduct over a restriction of its index\ntype.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.is_cokernel_inr_cokernel_fork", "description": "The cofork `biprod.inr_cokernel_fork` is indeed a colimit.", "p": "mathlib"}, {"name": "category_theory.limits.get_biproduct_data", "description": "Use the axiom of choice to extract explicit `biproduct_data F` from `has_biproduct F`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inr_cokernel_cofork_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod_iso", "description": "The isomorphism between the specified binary product and the specified binary coproduct for\na pair for a binary biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.fst.has_kernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biproduct_to_subtype_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.iso_product_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl", "description": "The inclusion into the first summand of a binary biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.components_matrix", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_product_of_has_biproduct", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_biproducts", "description": "`has_binary_biproducts C` represents the existence of a bicone which is\nsimultaneously a limit and a colimit of the diagram `pair P Q`, for every `P Q : C`.", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_biproducts.has_binary_biproduct", "description": "`has_binary_biproducts C` represents the existence of a bicone which is\nsimultaneously a limit and a colimit of the diagram `pair P Q`, for every `P Q : C`.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biproduct_\u03c0_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.is_cokernel_inl_cokernel_fork", "description": "The cofork `biprod.inl_cokernel_fork` is indeed a colimit.", "p": "mathlib"}, {"name": "category_theory.limits.limit_bicone_of_unique_bicone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.to_subtype_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braiding_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct", "description": "`biproduct f` computes the biproduct of a family of elements `f`. (It is defined as an\n  abbreviation for `limit (discrete.functor f)`, so for most facts about `biproduct f`, you will\n  just use general facts about limits and colimits.)", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braiding'_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_binary_biproduct.mk", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_to_subtype_subtype_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.matrix_\u03c0_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_matrix", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_binary_bicone_inr", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.iso_product_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_desc_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_bicone_of_unique_bicone_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_\u03c0_ne", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_from_subtype", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.cone_point_unique_up_to_iso_inv", "description": "Auxiliary lemma for `biprod.unique_up_to_iso`.", "p": "mathlib"}, {"name": "category_theory.limits.biprod_iso_coprod_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.lift_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inl_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_\u03c0_self_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.iso_biprod_zero_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_zero_object_of_has_finite_biproducts", "description": "A category with finite biproducts has a zero object.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biproduct_\u03b9_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.snd.has_kernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.is_bilimit.ext_iff", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.is_bilimit", "description": "`biproduct.bicone F` is a bilimit bicone.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_cocone", "description": "Extract the cocone from a binary bicone.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.braiding_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_cone", "description": "Extract the cone from a bicone.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biproduct_from_subtype_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.lift_fst_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_cocone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_bicone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inl_cokernel_cofork_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.hom_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_iso", "description": " Given a collection of isomorphisms between corresponding summands of a pair of biproducts\nindexed by the same type, we obtain an isomorphism between the biproducts.", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct.bicone_inr", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.is_kernel_fst_kernel_fork", "description": "The fork `biprod.fst_kernel_fork` is indeed a limit.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.mono_lift_of_mono_left", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.to_subtype.has_kernel", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.cone_point_unique_up_to_iso_hom", "description": "Auxiliary lemma for `biproduct.unique_up_to_iso`.", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct.bicone_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_\u03c0_self", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.desc", "description": "Given a collection of maps out of the summands, we obtain a map out of the biproduct.", "p": "mathlib"}, {"name": "category_theory.limits.limit_bicone_of_unique_is_bilimit_is_limit", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_bicone_is_bilimit", "description": "A binary bicone is a bilimit bicone if and only if the corresponding bicone is a bilimit.", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.to_cone", "description": "Extract the cone from a binary bicone.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.of_limit_cone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.matrix", "description": "Convert a (dependently typed) matrix to a morphism of biproducts.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.to_subtype_eq_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_map_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.unique_up_to_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biproduct_\u03c0_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.\u03b9_from_subtype_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.snd_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.iso_prod_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.snd_kernel_fork_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.iso_zero_biprod", "description": "If `X` is a zero object, `Y \u2245 X \u229e Y` for any `Y`.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.whisker_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.symmetry'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone.to_cocone_\u03b9_app_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.bicone_\u03b9_\u03c0_ne_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biprod_inr_iso", "description": "The cokernel of `biprod.inr : Y \u27f6 X \u229e Y` is `X`.", "p": "mathlib"}, {"name": "category_theory.limits.binary_biproduct.bicone", "description": "A bicone for `P Q ` which is both a limit cone and a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biprod_snd_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.inr_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.iso_product", "description": "The canonical isomorphism between the chosen biproduct and the chosen product.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct_unique_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biproduct_\u03b9_iso", "description": "The cokernel of `biproduct.\u03b9 f i` is `\u2a01 subtype.restrict {i}\u1d9c f`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.is_colimit", "description": "`biproduct.bicone F` is a colimit cocone.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.iso_coproduct", "description": "The canonical isomorphism between the chosen biproduct and the chosen coproduct.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct_unique_iso_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_fst_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.symmetry", "description": "The braiding isomorphism is symmetric.", "p": "mathlib"}, {"name": "category_theory.limits.cokernel_biprod_inl_iso", "description": "The cokernel of `biprod.inl : X \u27f6 X \u229e Y` is `Y`.", "p": "mathlib"}, {"name": "category_theory.limits.bicone", "description": "A `c : bicone F` is:\n* an object `c.X` and\n* morphisms `\u03c0 j : X \u27f6 F j` and `\u03b9 j : F j \u27f6 X` for each `j`,\n* such that `\u03b9 j \u226b \u03c0 j'` is the identity when `j = j'` and zero otherwise.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.X", "description": "A `c : bicone F` is:\n* an object `c.X` and\n* morphisms `\u03c0 j : X \u27f6 F j` and `\u03b9 j : F j \u27f6 X` for each `j`,\n* such that `\u03b9 j \u226b \u03c0 j'` is the identity when `j = j'` and zero otherwise.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.\u03c0", "description": "A `c : bicone F` is:\n* an object `c.X` and\n* morphisms `\u03c0 j : X \u27f6 F j` and `\u03b9 j : F j \u27f6 X` for each `j`,\n* such that `\u03b9 j \u226b \u03c0 j'` is the identity when `j = j'` and zero otherwise.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.\u03b9", "description": "A `c : bicone F` is:\n* an object `c.X` and\n* morphisms `\u03c0 j : X \u27f6 F j` and `\u03b9 j : F j \u27f6 X` for each `j`,\n* such that `\u03b9 j \u226b \u03c0 j'` is the identity when `j = j'` and zero otherwise.", "p": "mathlib"}, {"name": "category_theory.limits.bicone.\u03b9_\u03c0", "description": "A `c : bicone F` is:\n* an object `c.X` and\n* morphisms `\u03c0 j : X \u27f6 F j` and `\u03b9 j : F j \u27f6 X` for each `j`,\n* such that `\u03b9 j \u226b \u03c0 j'` is the identity when `j = j'` and zero otherwise.", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.kernel_biproduct_to_subtype_iso_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.inl_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone", "description": "A binary bicone for a pair of objects `P Q : C` consists of the cone point `X`,\nmaps from `X` to both `P` and `Q`, and maps from both `P` and `Q` to `X`,\nso that `inl \u226b fst = \ud835\udfd9 P`, `inl \u226b snd = 0`, `inr \u226b fst = 0`, and `inr \u226b snd = \ud835\udfd9 Q`", "p": "mathlib"}, {"name": "category_theory.limits.binary_bicone.X", "description": "A binary bicone for a pair of objects `P Q : C` consists of the cone point `X`,\nmaps from `X` to both `P` and `Q`, and maps from both `P` and `Q` to `X`,\nso that `inl \u226b fst = \ud835\udfd9 P`, `inl \u226b snd = 0`, `inr \u226b fst = 0`, and `inr \u226b snd = \ud835\udfd9 Q`"