al.monic.is_regular", "description": "", "p": "mathlib"}, {"name": "polynomial.monic_zero_iff_subsingleton", "description": "", "p": "mathlib"}, {"name": "function.injective.monic_map_iff", "description": "", "p": "mathlib"}, {"name": "polynomial.monic.eq_one_of_map_eq_one", "description": "", "p": "mathlib"}, {"name": "polynomial.monic.degree_map", "description": "", "p": "mathlib"}, {"name": "polynomial.monic_of_is_unit_leading_coeff_inv_smul", "description": "", "p": "mathlib"}, {"name": "polynomial.monic.next_coeff_prod", "description": "", "p": "mathlib"}, {"name": "polynomial.monic_X_pow_sub_C", "description": "`X ^ n - a` is monic.", "p": "mathlib"}, {"name": "polynomial.monic.nat_degree_map", "description": "", "p": "mathlib"}, {"name": "polynomial.not_monic_zero", "description": "", "p": "mathlib"}, {"name": "polynomial.monic.not_dvd_of_degree_lt", "description": "", "p": "mathlib"}, {"name": "dilation.lipschitz", "description": "", "p": "mathlib"}, {"name": "dilation.injective", "description": "A dilation from an emetric space is injective", "p": "mathlib"}, {"name": "dilation.comp_continuous_iff", "description": "", "p": "mathlib"}, {"name": "dilation.tendsto_nhds_iff", "description": "", "p": "mathlib"}, {"name": "dilation.mul_def", "description": "", "p": "mathlib"}, {"name": "dilation.copy_to_fun", "description": "", "p": "mathlib"}, {"name": "dilation.id", "description": "The identity is a dilation", "p": "mathlib"}, {"name": "dilation.copy_eq_self", "description": "", "p": "mathlib"}, {"name": "dilation", "description": "A dilation is a map that uniformly scales the edistance between any two points.", "p": "mathlib"}, {"name": "dilation.to_fun", "description": "A dilation is a map that uniformly scales the edistance between any two points.", "p": "mathlib"}, {"name": "dilation.edist_eq'", "description": "A dilation is a map that uniformly scales the edistance between any two points.", "p": "mathlib"}, {"name": "dilation.cancel_left", "description": "", "p": "mathlib"}, {"name": "dilation.ext", "description": "", "p": "mathlib"}, {"name": "dilation.diam_image", "description": "A dilation scales the diameter by `ratio f` in pseudometric spaces.", "p": "mathlib"}, {"name": "dilation.comp_id", "description": "", "p": "mathlib"}, {"name": "dilation.antilipschitz", "description": "", "p": "mathlib"}, {"name": "dilation.coe_mk_of_dist_eq", "description": "", "p": "mathlib"}, {"name": "dilation.ratio", "description": " The ratio of a dilation `f`. If the ratio is undefined (i.e., the distance between any two\npoints in `\u03b1` is either zero or infinity), then we choose one as the ratio.", "p": "mathlib"}, {"name": "dilation.maps_to_closed_ball", "description": "A dilation maps closed balls to closed balls and scales the radius by `ratio f`.", "p": "mathlib"}, {"name": "dilation.maps_to_sphere", "description": "A dilation maps spheres to spheres and scales the radius by `ratio f`.", "p": "mathlib"}, {"name": "dilation.id_comp", "description": "", "p": "mathlib"}, {"name": "dilation.comp_continuous_on_iff", "description": "", "p": "mathlib"}, {"name": "dilation.coe_comp", "description": "", "p": "mathlib"}, {"name": "dilation.edist_eq", "description": "", "p": "mathlib"}, {"name": "dilation.dist_eq", "description": "", "p": "mathlib"}, {"name": "dilation.copy", "description": " Copy of a `dilation` with a new `to_fun` equal to the old one. Useful to fix definitional\nequalities.", "p": "mathlib"}, {"name": "dilation.mk_of_nndist_eq", "description": "Alternative `dilation` constructor when the distance hypothesis is over `nndist`", "p": "mathlib"}, {"name": "dilation.embedding", "description": "A dilation from a metric space is an embedding", "p": "mathlib"}, {"name": "dilation.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "dilation.coe_id", "description": "", "p": "mathlib"}, {"name": "dilation.ratio_pos", "description": "", "p": "mathlib"}, {"name": "dilation.maps_to_emetric_ball", "description": "A dilation maps balls to balls and scales the radius by `ratio f`.", "p": "mathlib"}, {"name": "dilation.to_continuous", "description": "A dilation is continuous.", "p": "mathlib"}, {"name": "dilation.ratio_ne_zero", "description": "", "p": "mathlib"}, {"name": "dilation.cancel_right", "description": "", "p": "mathlib"}, {"name": "dilation.congr_arg", "description": "", "p": "mathlib"}, {"name": "dilation.comp_assoc", "description": "", "p": "mathlib"}, {"name": "dilation.comp_apply", "description": "", "p": "mathlib"}, {"name": "dilation.uniform_embedding", "description": "A dilation from a metric space is a uniform embedding", "p": "mathlib"}, {"name": "dilation.coe_mul", "description": "", "p": "mathlib"}, {"name": "dilation.ediam_range", "description": "A dilation scales the diameter of the range by `ratio f`.", "p": "mathlib"}, {"name": "dilation.comp_ratio", "description": " Ratio of the composition `g.comp f` of two dilations is the product of their ratios. We assume\nthat the domain `\u03b1` of `f` is nontrivial, otherwise `ratio f = ratio (g.comp f) = 1` but `ratio g`\nmay have any value.", "p": "mathlib"}, {"name": "dilation.inhabited", "description": "", "p": "mathlib"}, {"name": "dilation.id_ratio", "description": "", "p": "mathlib"}, {"name": "dilation.ratio_unique", "description": " The `ratio` is equal to the distance ratio for any two points with nonzero finite distance.\n`dist` and `nndist` versions below", "p": "mathlib"}, {"name": "dilation.maps_to_emetric_closed_ball", "description": "A dilation maps closed balls to closed balls and scales the radius by `ratio f`.", "p": "mathlib"}, {"name": "dilation.mk_coe", "description": "", "p": "mathlib"}, {"name": "dilation.coe_mk_of_nndist_eq", "description": "", "p": "mathlib"}, {"name": "dilation.mk_coe_of_nndist_eq", "description": "", "p": "mathlib"}, {"name": "dilation.comp", "description": "The composition of dilations is a dilation", "p": "mathlib"}, {"name": "dilation.one_def", "description": "", "p": "mathlib"}, {"name": "dilation_class", "description": "`dilation_class F \u03b1 \u03b2 r` states that `F` is a type of `r`-dilations.\nYou should extend this typeclass when you extend `dilation`.", "p": "mathlib"}, {"name": "dilation_class.to_fun_like", "description": "`dilation_class F \u03b1 \u03b2 r` states that `F` is a type of `r`-dilations.\nYou should extend this typeclass when you extend `dilation`.", "p": "mathlib"}, {"name": "dilation_class.edist_eq'", "description": "`dilation_class F \u03b1 \u03b2 r` states that `F` is a type of `r`-dilations.\nYou should extend this typeclass when you extend `dilation`.", "p": "mathlib"}, {"name": "dilation.nndist_eq", "description": "", "p": "mathlib"}, {"name": "dilation.congr_fun", "description": "", "p": "mathlib"}, {"name": "dilation.to_dilation_class", "description": "", "p": "mathlib"}, {"name": "dilation.ediam_image", "description": "Dilations scale the diameter by `ratio f` in pseudoemetric spaces.", "p": "mathlib"}, {"name": "dilation.ratio_unique_of_nndist_ne_zero", "description": " The `ratio` is equal to the distance ratio for any two points\nwith nonzero finite distance; `nndist` version", "p": "mathlib"}, {"name": "dilation.diam_range", "description": "", "p": "mathlib"}, {"name": "dilation.coe_one", "description": "", "p": "mathlib"}, {"name": "dilation.coe_mk", "description": "", "p": "mathlib"}, {"name": "dilation.ratio_unique_of_dist_ne_zero", "description": " The `ratio` is equal to the distance ratio for any two points\nwith nonzero finite distance; `dist` version", "p": "mathlib"}, {"name": "dilation.ext_iff", "description": "", "p": "mathlib"}, {"name": "dilation.closed_embedding", "description": "A dilation from a complete emetric space is a closed embedding", "p": "mathlib"}, {"name": "dilation.uniform_inducing", "description": "A dilation from a metric space is a uniform inducing map", "p": "mathlib"}, {"name": "dilation.maps_to_ball", "description": "A dilation maps balls to balls and scales the radius by `ratio f`.", "p": "mathlib"}, {"name": "dilation.to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "dilation.mk_of_dist_eq", "description": "Alternative `dilation` constructor when the distance hypothesis is over `dist`", "p": "mathlib"}, {"name": "dilation.monoid", "description": "", "p": "mathlib"}, {"name": "dilation.mk_coe_of_dist_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.vadd_ae_eq_self_of_mem_zmultiples", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_locally_finite_measure_of_vadd_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.smul_invariant_measure_tfae", "description": " Equivalent definitions of a measure invariant under a multiplicative action of a group.\n\n- 0: `smul_invariant_measure G \u03b1 \u03bc`;\n\n- 1: for every `c : G` and a measurable set `s`, the measure of the preimage of `s` under scalar\n     multiplication by `c` is equal to the measure of `s`;\n\n- 2: for every `c : G` and a measurable set `s`, the measure of the image `c \u2022 s` of `s` under\n     scalar multiplication by `c` is equal to the measure of `s`;\n\n- 3, 4: properties 2, 3 for any set, including non-measurable ones;\n\n- 5: for any `c : G`, scalar multiplication by `c` maps `\u03bc` to `\u03bc`;\n\n- 6: for any `c : G`, scalar multiplication by `c` is a measure preserving map.", "p": "mathlib"}, {"name": "measure_theory.measure_preserving_vadd", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preimage_vadd", "description": "", "p": "mathlib"}, {"name": "measure_theory.vadd_invariant_measure.vadd_nnreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_is_open_pos_of_vadd_invariant_of_compact_ne_zero", "description": " If measure `\u03bc` is invariant under an additive group action and is nonzero on a compact set `K`,\nthen it is positive on any nonempty open set. In case of a regular measure, one can assume `\u03bc \u2260 0`\ninstead of `\u03bc K \u2260 0`, see `measure_theory.measure_is_open_pos_of_vadd_invariant_of_ne_zero`.", "p": "mathlib"}, {"name": "measure_theory.vadd_invariant_measure.zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.smul_invariant_measure", "description": " A measure `\u03bc : measure \u03b1` is invariant under a multiplicative action of `M` on `\u03b1` if for any\nmeasurable set `s : set \u03b1` and `c : M`, the measure of its preimage under `\u03bb x, c \u2022 x` is equal to\nthe measure of `s`.", "p": "mathlib"}, {"name": "measure_theory.smul_invariant_measure.measure_preimage_smul", "description": " A measure `\u03bc : measure \u03b1` is invariant under a multiplicative action of `M` on `\u03b1` if for any\nmeasurable set `s : set \u03b1` and `c : M`, the measure of its preimage under `\u03bb x, c \u2022 x` is equal to\nthe measure of `s`.", "p": "mathlib"}, {"name": "measure_theory.measure_eq_zero_iff_eq_empty_of_vadd_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.vadd_invariant_measure.vadd", "description": "", "p": "mathlib"}, {"name": "measure_theory.smul_invariant_measure.add", "description": "", "p": "mathlib"}, {"name": "measure_theory.map_vadd", "description": "", "p": "mathlib"}, {"name": "measure_theory.map_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preimage_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.is_locally_finite_measure_of_smul_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_pos_iff_nonempty_of_smul_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_preserving_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.null_measurable_set.vadd", "description": "", "p": "mathlib"}, {"name": "measure_theory.smul_invariant_measure.zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_eq_zero_iff_eq_empty_of_smul_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.null_measurable_set.smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.vadd_invariant_measure.add", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_smul_null", "description": "", "p": "mathlib"}, {"name": "measure_theory.vadd_invariant_measure", "description": " A measure `\u03bc : measure \u03b1` is invariant under an additive action of `M` on `\u03b1` if for any\nmeasurable set `s : set \u03b1` and `c : M`, the measure of its preimage under `\u03bb x, c +\u1d65 x` is equal to\nthe measure of `s`.", "p": "mathlib"}, {"name": "measure_theory.vadd_invariant_measure.measure_preimage_vadd", "description": " A measure `\u03bc : measure \u03b1` is invariant under an additive action of `M` on `\u03b1` if for any\nmeasurable set `s : set \u03b1` and `c : M`, the measure of its preimage under `\u03bb x, c +\u1d65 x` is equal to\nthe measure of `s`.", "p": "mathlib"}, {"name": "measure_theory.measure_is_open_pos_of_smul_invariant_of_ne_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_is_open_pos_of_smul_invariant_of_compact_ne_zero", "description": " If measure `\u03bc` is invariant under a group action and is nonzero on a compact set `K`, then it is\npositive on any nonempty open set. In case of a regular measure, one can assume `\u03bc \u2260 0` instead of\n`\u03bc K \u2260 0`, see `measure_theory.measure_is_open_pos_of_smul_invariant_of_ne_zero`.", "p": "mathlib"}, {"name": "measure_theory.smul_invariant_measure.smul_nnreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_is_open_pos_of_vadd_invariant_of_ne_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.vadd_invariant_measure_tfae", "description": " Equivalent definitions of a measure invariant under an additive action of a group.\n\n- 0: `vadd_invariant_measure G \u03b1 \u03bc`;\n\n- 1: for every `c : G` and a measurable set `s`, the measure of the preimage of `s` under\n     vector addition `(+\u1d65) c` is equal to the measure of `s`;\n\n- 2: for every `c : G` and a measurable set `s`, the measure of the image `c +\u1d65 s` of `s` under\n     vector addition `(+\u1d65) c` is equal to the measure of `s`;\n\n- 3, 4: properties 2, 3 for any set, including non-measurable ones;\n\n- 5: for any `c : G`, vector addition of `c` maps `\u03bc` to `\u03bc`;\n\n- 6: for any `c : G`, vector addition of `c` is a measure preserving map.", "p": "mathlib"}, {"name": "measure_theory.measure_pos_iff_nonempty_of_vadd_invariant", "description": "", "p": "mathlib"}, {"name": "measure_theory.smul_invariant_measure.smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.smul_ae_eq_self_of_mem_zpowers", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure_vadd", "description": "", "p": "mathlib"}, {"name": "linarith.global_preprocessor", "description": "Some preprocessors need to examine the full list of hypotheses instead of working item by item.\nAs with `preprocessor`, the input to a `global_preprocessor` is replaced by, not added to, its\noutput.", "p": "mathlib"}, {"name": "linarith.global_preprocessor.name", "description": "Some preprocessors need to examine the full list of hypotheses instead of working item by item.\nAs with `preprocessor`, the input to a `global_preprocessor` is replaced by, not added to, its\noutput.", "p": "mathlib"}, {"name": "linarith.global_preprocessor.transform", "description": "Some preprocessors need to examine the full list of hypotheses instead of working item by item.\nAs with `preprocessor`, the input to a `global_preprocessor` is replaced by, not added to, its\noutput.", "p": "mathlib"}, {"name": "linarith.parse_into_comp_and_expr", "description": "`parse_into_comp_and_expr e` checks if `e` is of the form `t < 0`, `t \u2264 0`, or `t = 0`.\nIf it is, it returns the comparison along with `t`.", "p": "mathlib"}, {"name": "linarith.comp.scale", "description": "`comp.scale c n` scales the coefficients of `c` by `n`.", "p": "mathlib"}, {"name": "linarith.global_preprocessor_to_gb_preprocessor", "description": "", "p": "mathlib"}, {"name": "linarith.preprocessor.globalize", "description": "A `preprocessor` lifts to a `global_preprocessor` by folding it over the input list.", "p": "mathlib"}, {"name": "linarith.mk_single_comp_zero_pf", "description": "`mk_single_comp_zero_pf c h` assumes that `h` is a proof of `t R 0`.\nIt produces a pair `(R', h')`, where `h'` is a proof of `c*t R' 0`.\nTypically `R` and `R'` will be the same, except when `c = 0`, in which case `R'` is `=`.\nIf `c = 1`, `h'` is the same as `h` -- specifically, it does *not* change the type to `1*t R 0`.", "p": "mathlib"}, {"name": "linarith.linexp", "description": "A linear expression is a list of pairs of variable indices and coefficients,\nrepresenting the sum of the products of each coefficient with its corresponding variable.\n\nSome functions on `linexp` assume that `n : \u2115` occurs at most once as the first element of a pair,\nand that the list is sorted in decreasing order of the first argument.\nThis is not enforced by the type but the operations here preserve it.", "p": "mathlib"}, {"name": "linarith.comp.is_contr", "description": "A `comp` represents a contradiction if its expression has no coefficients and its strength is <,\nthat is, it represents the fact `0 < 0`.", "p": "mathlib"}, {"name": "linarith.ineq.has_to_string", "description": "", "p": "mathlib"}, {"name": "linarith.ineq", "description": " The three-element type `ineq` is used to represent the strength of a comparison between\nterms.", "p": "mathlib"}, {"name": "linarith.ineq.eq", "description": " The three-element type `ineq` is used to represent the strength of a comparison between\nterms.", "p": "mathlib"}, {"name": "linarith.ineq.le", "description": " The three-element type `ineq` is used to represent the strength of a comparison between\nterms.", "p": "mathlib"}, {"name": "linarith.ineq.lt", "description": " The three-element type `ineq` is used to represent the strength of a comparison between\nterms.", "p": "mathlib"}, {"name": "linarith.comp.cmp", "description": "`comp` has a lex order. First the `ineq`s are compared, then the `coeff`s.", "p": "mathlib"}, {"name": "linarith.ineq.to_const_mul_nm", "description": "Finds the name of a multiplicative lemma corresponding to an inequality strength.", "p": "mathlib"}, {"name": "linarith.preprocessor_to_gb_preprocessor", "description": "", "p": "mathlib"}, {"name": "linarith.get_rel_sides", "description": "`get_rel_sides e` returns the left and right hand sides of `e` if `e` is a comparison,\nand fails otherwise.\nThis function is more naturally in the `option` monad, but it is convenient to put in `tactic`\nfor compositionality.", "p": "mathlib"}, {"name": "linarith.comp", "description": "The main datatype for FM elimination.\nVariables are represented by natural numbers, each of which has an integer coefficient.\nIndex 0 is reserved for constants, i.e. `coeffs.find 0` is the coefficient of 1.\nThe represented term is `coeffs.sum (\u03bb \u27e8k, v\u27e9, v * Var[k])`.\nstr determines the strength of the comparison -- is it < 0, \u2264 0, or = 0?", "p": "mathlib"}, {"name": "linarith.comp.str", "description": "The main datatype for FM elimination.\nVariables are represented by natural numbers, each of which has an integer coefficient.\nIndex 0 is reserved for constants, i.e. `coeffs.find 0` is the coefficient of 1.\nThe represented term is `coeffs.sum (\u03bb \u27e8k, v\u27e9, v * Var[k])`.\nstr determines the strength of the comparison -- is it < 0, \u2264 0, or = 0?", "p": "mathlib"}, {"name": "linarith.comp.coeffs", "description": "The main datatype for FM elimination.\nVariables are represented by natural numbers, each of which has an integer coefficient.\nIndex 0 is reserved for constants, i.e. `coeffs.find 0` is the coefficient of 1.\nThe represented term is `coeffs.sum (\u03bb \u27e8k, v\u27e9, v * Var[k])`.\nstr determines the strength of the comparison -- is it < 0, \u2264 0, or = 0?", "p": "mathlib"}, {"name": "linarith.linarith_config", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.linarith_config.discharger", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.linarith_config.restrict_type", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.linarith_config.restrict_type_reflect", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.linarith_config.exfalso", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.linarith_config.transparency", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.linarith_config.split_hypotheses", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.linarith_config.split_ne", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.linarith_config.preprocessors", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.linarith_config.oracle", "description": "A configuration object for `linarith`.", "p": "mathlib"}, {"name": "linarith.ineq.decidable_eq", "description": "", "p": "mathlib"}, {"name": "linarith.ineq.cmp", "description": "`ineq` is ordered `eq < le < lt`.", "p": "mathlib"}, {"name": "linarith.linexp.cmp", "description": "Defines a lex ordering on `linexp`. This function is performance critical.", "p": "mathlib"}, {"name": "linarith.ineq.inhabited", "description": "", "p": "mathlib"}, {"name": "linarith.comp.add", "description": "`comp.add c1 c2` adds the expressions represented by `c1` and `c2`.\nThe coefficient of variable `a` in `c1.add c2`\nis the sum of the coefficients of `a` in `c1` and `c2`.", "p": "mathlib"}, {"name": "linarith.linexp.scale", "description": "`l.scale c` scales the values in `l` by `c` without modifying the order or keys.", "p": "mathlib"}, {"name": "linarith.linarith_config.update_reducibility", "description": "`cfg.update_reducibility reduce_semi` will change the transparency setting of `cfg` to\n`semireducible` if `reduce_semi` is true. In this case, it also sets the discharger to `ring!`,\nsince this is typically needed when using stronger unification.", "p": "mathlib"}, {"name": "linarith.comp.inhabited", "description": "", "p": "mathlib"}, {"name": "linarith.ineq.has_to_format", "description": "", "p": "mathlib"}, {"name": "linarith.global_branching_preprocessor.process", "description": "`process pp l` runs `pp.transform` on `l` and returns the result,\ntracing the result if `trace.linarith` is on.", "p": "mathlib"}, {"name": "linarith.certificate_oracle", "description": "A `certificate_oracle` is a function `produce_certificate : list comp \u2192 \u2115 \u2192 tactic (rb_map \u2115 \u2115)`.\n`produce_certificate hyps max_var` tries to derive a contradiction from the comparisons in `hyps`\nby eliminating all variables \u2264 `max_var`.\nIf successful, it returns a map `coeff : \u2115 \u2192 \u2115` as a certificate.\nThis map represents that we can find a contradiction by taking the sum  `\u2211 (coeff i) * hyps[i]`.\n\nThe default `certificate_oracle` used by `linarith` is\n`linarith.fourier_motzkin.produce_certificate`.", "p": "mathlib"}, {"name": "linarith.linexp.get", "description": "`l.get n` returns the value in `l` associated with key `n`, if it exists, and `none` otherwise.\nThis function assumes that `l` is sorted in decreasing order of the first argument,\nthat is, it will return `none` as soon as it finds a key smaller than `n`.", "p": "mathlib"}, {"name": "linarith.comp.coeff_of", "description": "`comp.coeff_of c a` projects the coefficient of variable `a` out of `c`.", "p": "mathlib"}, {"name": "linarith.comp.vars", "description": "`c.vars` returns the list of variables that appear in the linear expression contained in `c`.", "p": "mathlib"}, {"name": "linarith.linarith_trace_proofs", "description": "A shorthand for tracing the types of a list of proof terms\nwhen the `trace.linarith` option is set to true.", "p": "mathlib"}, {"name": "linarith.global_branching_preprocessor", "description": "Some preprocessors perform branching case splits.\nA `global_branching_preprocessor` produces a list of branches to run.\nEach branch is independent, so hypotheses that appear in multiple branches should be duplicated.\nThe preprocessor is responsible for making sure that each branch contains the correct goal\nmetavariable.", "p": "mathlib"}, {"name": "linarith.global_branching_preprocessor.name", "description": "Some preprocessors perform branching case splits.\nA `global_branching_preprocessor` produces a list of branches to run.\nEach branch is independent, so hypotheses that appear in multiple branches should be duplicated.\nThe preprocessor is responsible for making sure that each branch contains the correct goal\nmetavariable.", "p": "mathlib"}, {"name": "linarith.global_branching_preprocessor.transform", "description": "Some preprocessors perform branching case splits.\nA `global_branching_preprocessor` produces a list of branches to run.\nEach branch is independent, so hypotheses that appear in multiple branches should be duplicated.\nThe preprocessor is responsible for making sure that each branch contains the correct goal\nmetavariable.", "p": "mathlib"}, {"name": "linarith.branch", "description": "Some preprocessors perform branching case splits. A `branch` is used to track one of these case\nsplits. The first component, an `expr`, is the goal corresponding to this branch of the split,\ngiven as a metavariable. The `list expr` component is the list of hypotheses for `linarith`\nin this branch. Every `expr` in this list should be type correct in the context of the associated\ngoal.", "p": "mathlib"}, {"name": "linarith.linarith_trace", "description": "A shorthand for tracing when the `trace.linarith` option is set to true.", "p": "mathlib"}, {"name": "linarith.comp.to_format", "description": "", "p": "mathlib"}, {"name": "linarith.ineq.to_string", "description": "Prints an `ineq` as the corresponding infix symbol.", "p": "mathlib"}, {"name": "linarith.linexp.add", "description": "Add two `linexp`s together componentwise.\nPreserves sorting and uniqueness of the first argument.", "p": "mathlib"}, {"name": "linarith.linexp.vars", "description": "`l.vars` returns the list of variables that occur in `l`.", "p": "mathlib"}, {"name": "linarith.ineq.max", "description": "`max R1 R2` computes the strength of the sum of two inequalities. If `t1 R1 0` and `t2 R2 0`,\nthen `t1 + t2 (max R1 R2) 0`.", "p": "mathlib"}, {"name": "linarith.global_preprocessor.branching", "description": "A `global_preprocessor` lifts to a `global_branching_preprocessor` by producing only one branch.", "p": "mathlib"}, {"name": "linarith.preprocessor", "description": "A preprocessor transforms a proof of a proposition into a proof of a different propositon.\nThe return type is `list expr`, since some preprocessing steps may create multiple new hypotheses,\nand some may remove a hypothesis from the list.\nA \"no-op\" preprocessor should return its input as a singleton list.", "p": "mathlib"}, {"name": "linarith.preprocessor.name", "description": "A preprocessor transforms a proof of a proposition into a proof of a different propositon.\nThe return type is `list expr`, since some preprocessing steps may create multiple new hypotheses,\nand some may remove a hypothesis from the list.\nA \"no-op\" preprocessor should return its input as a singleton list.", "p": "mathlib"}, {"name": "linarith.preprocessor.transform", "description": "A preprocessor transforms a proof of a proposition into a proof of a different propositon.\nThe return type is `list expr`, since some preprocessing steps may create multiple new hypotheses,\nand some may remove a hypothesis from the list.\nA \"no-op\" preprocessor should return its input as a singleton list.", "p": "mathlib"}, {"name": "linarith.linexp.contains", "description": "`l.contains n` is true iff `n` is the first element of a pair in `l`.", "p": "mathlib"}, {"name": "linarith.linexp.zfind", "description": "`l.zfind n` returns the value associated with key `n` if there is one, and 0 otherwise.", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.forget.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.category", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.of", "description": "Turn a left exact functor into an object of the category `LeftExactFunctor C D`.", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.of_exact_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.of", "description": "Turn an exact functor into an object of the category `ExactFunctor C D`.", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.forget", "description": "An exact functor is in particular a functor.", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.obj.limits.preserves_finite_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.of_exact.full", "description": "", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.of", "description": "Turn a right exact functor into an object of the category `RightExactFunctor C D`.", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.forget_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.of_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor", "description": "Bundled exact functors.", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.of_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.of_exact_map", "description": "", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.category", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.forget_obj_of", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.of_exact_map", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.category", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.forget_map", "description": "", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.of_exact.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.forget.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.forget", "description": "A left exact functor is in particular a functor.", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor", "description": "Bundled right-exact functors.", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.forget", "description": "A right exact functor is in particular a functor.", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor", "description": "Bundled left-exact functors.", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.forget_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.forget_map", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.forget_obj_of", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.forget_map", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.forget.full", "description": "", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.of_exact", "description": "Turn an exact functor into a left exact functor.", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.of_exact_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.of_exact.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.obj.limits.preserves_finite_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.forget_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.of_exact", "description": "Turn an exact functor into a left exact functor.", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.of_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.LeftExactFunctor.obj.limits.preserves_finite_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.forget_obj_of", "description": "", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.forget.full", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.forget.faithful", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.forget.full", "description": "", "p": "mathlib"}, {"name": "category_theory.RightExactFunctor.of_exact.full", "description": "", "p": "mathlib"}, {"name": "category_theory.ExactFunctor.obj.limits.preserves_finite_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_obj_iso_limit_comp_evaluation_hom_\u03c0_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_obj_iso_colimit_comp_evaluation_\u03b9_inv_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_obj_iso_limit_comp_evaluation_hom_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_map_colimit_obj_iso_colimit_comp_evaluation_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_obj_iso_colimit_comp_evaluation_inv_colimit_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_iso_swap_comp_lim", "description": "For a functor `G : J \u2964 K \u2964 C`, its limit `K \u2964 C` is given by `(G' : K \u2964 J \u2964 C) \u22d9 lim`.\nNote that this does not require `K` to be small.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_const", "description": "The constant functor `C \u2964 (D \u2964 C)` preserves colimits.", "p": "mathlib"}, {"name": "category_theory.limits.combine_cocones", "description": "Given a functor `F` and a collection of colimit cocones for each diagram `X \u21a6 F X k`, we can stitch\nthem together to give a cocone for the diagram `F`.\n`combined_is_colimit` shows that the new cocone is colimiting, and `eval_combined` shows it is\n(essentially) made up of the original cocones.", "p": "mathlib"}, {"name": "category_theory.limits.limit_map_limit_obj_iso_limit_comp_evaluation_hom_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.combine_cocones_X_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.evaluation_jointly_reflects_colimits", "description": "The evaluation functors jointly reflect colimits: that is, to show a cocone is a colimit of `F`\nit suffices to show that each evaluation cocone is a colimit. In other words, to prove a cocone is\ncolimiting you can show it's pointwise colimiting.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limit_of_evaluation", "description": "`F : D \u2964 K \u2964 C` preserves the limit of some `G : J \u2964 D` if it does for each `k : K`.", "p": "mathlib"}, {"name": "category_theory.limits.limit.lift_\u03c0_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_obj_iso_colimit_comp_evaluation_\u03b9_app_hom_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_map_colimit_obj_iso_colimit_comp_evaluation_hom_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_evaluation", "description": "`F : D \u2964 K \u2964 C` preserves all limits if it does for each `k : K`.", "p": "mathlib"}, {"name": "category_theory.limits.colimit_iso_swap_comp_colim_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_obj_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.evaluate_combined_cones", "description": "The stitched together cones each project down to the original given cones (up to iso).", "p": "mathlib"}, {"name": "category_theory.limits.limit_iso_flip_comp_lim_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.evaluate_combined_cocones", "description": "The stitched together cocones each project down to the original given cocones (up to iso).", "p": "mathlib"}, {"name": "category_theory.limits.colimit_iso_swap_comp_colim", "description": "For a functor `G : J \u2964 K \u2964 C`, its colimit `K \u2964 C` is given by `(G' : K \u2964 J \u2964 C) \u22d9 colim`.\nNote that this does not require `K` to be small.", "p": "mathlib"}, {"name": "category_theory.limits.colimit.\u03b9_desc_app_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_evaluation", "description": "`F : D \u2964 K \u2964 C` preserves all colimits if it does for each `k : K`.", "p": "mathlib"}, {"name": "category_theory.limits.limit_flip_iso_comp_lim_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.combine_cones", "description": "Given a functor `F` and a collection of limit cones for each diagram `X \u21a6 F X k`, we can stitch\nthem together to give a cone for the diagram `F`.\n`combined_is_limit` shows that the new cone is limiting, and `eval_combined` shows it is\n(essentially) made up of the original cones.", "p": "mathlib"}, {"name": "category_theory.limits.combine_cones_X_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_obj_iso_colimit_comp_evaluation", "description": "If `F : J \u2964 K \u2964 C` is a functor into a functor category which has a colimit,\nthen the evaluation of that colimit at `k` is the colimit of the evaluations of `F.obj j` at `k`.", "p": "mathlib"}, {"name": "category_theory.limits.evaluation_preserves_limits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_obj_iso_colimit_comp_evaluation_inv_colimit_map_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_iso_flip_comp_lim", "description": " The limit of a diagram `F : J \u2964 K \u2964 C` is isomorphic to the functor given by\nthe individual limits on objects.", "p": "mathlib"}, {"name": "category_theory.limits.colimit_obj_iso_colimit_comp_evaluation_\u03b9_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_obj_iso_limit_comp_evaluation", "description": "If `F : J \u2964 K \u2964 C` is a functor into a functor category which has a limit,\nthen the evaluation of that limit at `k` is the limit of the evaluations of `F.obj j` at `k`.", "p": "mathlib"}, {"name": "category_theory.limits.limit_obj_iso_limit_comp_evaluation_inv_limit_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.evaluation_jointly_reflects_limits", "description": "The evaluation functors jointly reflect limits: that is, to show a cone is a limit of `F`\nit suffices to show that each evaluation cone is a limit. In other words, to prove a cone is\nlimiting you can show it's pointwise limiting.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimits_of_shape_of_evaluation", "description": "`F : D \u2964 K \u2964 C` preserves all colimits of shape `J` if it does for each `k : K`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_of_shape_of_evaluation", "description": "`F : D \u2964 K \u2964 C` preserves limits of shape `J` if it does for each `k : K`.", "p": "mathlib"}, {"name": "category_theory.limits.limit_obj_iso_limit_comp_evaluation_inv_\u03c0_app_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_flip_iso_comp_colim_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.combine_cones_\u03c0_app_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_flip_iso_comp_lim", "description": "A variant of `limit_iso_flip_comp_lim` where the arguemnts of `F` are flipped.", "p": "mathlib"}, {"name": "category_theory.limits.functor_category_has_limits_of_size", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.functor_category_has_limits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_flip_iso_comp_colim_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_obj_ext", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit.lift_\u03c0_app_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_iso_swap_comp_lim_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.functor_category_has_colimits_of_size", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_iso_swap_comp_lim_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.combine_cocones_X_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_map_limit_obj_iso_limit_comp_evaluation_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.limit_obj_iso_limit_comp_evaluation_inv_\u03c0_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.evaluation_preserves_limits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_iso_flip_comp_colim_hom_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_iso_flip_comp_colim_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_iso_swap_comp_colim_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_obj_iso_colimit_comp_evaluation_\u03b9_app_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.evaluation_preserves_colimits", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.combined_is_limit", "description": "Stitching together limiting cones gives a limiting cone.", "p": "mathlib"}, {"name": "category_theory.limits.combine_cones_X_map", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.combined_is_colimit", "description": "Stitching together colimiting cocones gives a colimiting cocone.", "p": "mathlib"}, {"name": "category_theory.limits.limit_obj_iso_limit_comp_evaluation_inv_limit_map_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.functor_category_has_colimits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit.\u03b9_desc_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.colimit_flip_iso_comp_colim", "description": "A variant of `colimit_iso_flip_comp_colim` where the arguemnts of `F` are flipped.", "p": "mathlib"}, {"name": "category_theory.limits.limit_flip_iso_comp_lim_inv_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.combine_cocones_\u03b9_app_app", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.evaluation_preserves_colimits_of_shape", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_limits_const", "description": "The constant functor `C \u2964 (D \u2964 C)` preserves limits.", "p": "mathlib"}, {"name": "category_theory.limits.colimit_iso_flip_comp_colim", "description": " The colimit of a diagram `F : J \u2964 K \u2964 C` is isomorphic to the functor given by\nthe individual colimits on objects.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_colimit_of_evaluation", "description": "`F : D \u2964 K \u2964 C` preserves the colimit of some `G : J \u2964 D` if it does for each `k : K`.", "p": "mathlib"}, {"name": "category_theory.limits.limit_iso_flip_comp_lim_hom_app", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate_one", "description": "", "p": "mathlib"}, {"name": "lagrange.nodal_eq", "description": "", "p": "mathlib"}, {"name": "lagrange.nat_degree_basis_divisor_self", "description": "", "p": "mathlib"}, {"name": "lagrange.degree_nodal", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_eq_prod_sub_inv_mul_nodal_div", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate_eq_add_interpolate_erase", "description": "", "p": "mathlib"}, {"name": "lagrange.values_eq_on_of_interpolate_eq", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_divisor_ne_zero_iff", "description": "", "p": "mathlib"}, {"name": "lagrange.degree_interpolate_le", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_interpolate_at_node", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_nodal_not_at_node", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_nodal", "description": "", "p": "mathlib"}, {"name": "lagrange.degree_interpolate_erase_lt", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_divisor_add_symm", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_basis_not_at_node", "description": "", "p": "mathlib"}, {"name": "lagrange.sum_basis", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_empty", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate_eq_nodal_weight_mul_nodal_div_X_sub_C", "description": "", "p": "mathlib"}, {"name": "lagrange.X_sub_C_dvd_nodal", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate_empty", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_nodal_derivative_eval_node_eq", "description": "", "p": "mathlib"}, {"name": "polynomial.eq_of_degrees_lt_of_eval_finset_eq", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_divisor", "description": " `basis_divisor x y` is the unique linear or constant polynomial such that\nwhen evaluated at `x` it gives `1` and `y` it gives `0` (where when `x = y` it is identically `0`).\nSuch polynomials are the building blocks for the Lagrange interpolants.", "p": "mathlib"}, {"name": "lagrange.eq_interpolate_of_eval_eq", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_pair_left", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_nodal_at_node", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate_apply", "description": "", "p": "mathlib"}, {"name": "polynomial.eq_of_degree_sub_lt_of_eval_finset_eq", "description": "", "p": "mathlib"}, {"name": "lagrange.nodal_eq_mul_nodal_erase", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_singleton", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate_eq_sum_interpolate_insert_sdiff", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate_singleton", "description": "", "p": "mathlib"}, {"name": "polynomial.eq_of_degrees_lt_of_eval_index_eq", "description": "", "p": "mathlib"}, {"name": "lagrange.nodal_insert_eq_nodal", "description": "", "p": "mathlib"}, {"name": "lagrange.nodal", "description": "`nodal s v` is the unique monic polynomial whose roots are the nodes defined by `v` and `s`.\n\nThat is, the roots of `nodal s v` are exactly the image of `v` on `s`,\nwith appropriate multiplicity.\n\nWe can use `nodal` to define the barycentric forms of the evaluated interpolant.", "p": "mathlib"}, {"name": "lagrange.nat_degree_basis", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate_eq_iff_values_eq_on", "description": "", "p": "mathlib"}, {"name": "lagrange.eq_interpolate_iff", "description": "This is the characteristic property of the interpolation: the interpolation is the\nunique polynomial of `degree < fintype.card \u03b9` which takes the value of the `r i` on the `v i`.", "p": "mathlib"}, {"name": "lagrange.degree_basis_divisor_self", "description": "", "p": "mathlib"}, {"name": "lagrange.nat_degree_basis_divisor_of_ne", "description": "", "p": "mathlib"}, {"name": "lagrange.nodal_erase_eq_nodal_div", "description": "", "p": "mathlib"}, {"name": "lagrange.nodal_weight_eq_eval_nodal_derative", "description": "", "p": "mathlib"}, {"name": "lagrange.basis", "description": " Lagrange basis polynomials indexed by `s : finset \u03b9`, defined at nodes `v i` for a\nmap `v : \u03b9 \u2192 F`. For `i, j \u2208 s`, `basis s v i` evaluates to 0 at `v j` for `i \u2260 j`. When\n`v` is injective on `s`, `basis s v i` evaluates to 1 at `v i`.", "p": "mathlib"}, {"name": "lagrange.basis_divisor_self", "description": "", "p": "mathlib"}, {"name": "lagrange.sum_nodal_weight_mul_inv_sub_ne_zero", "description": "", "p": "mathlib"}, {"name": "lagrange.eq_interpolate", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_ne_zero", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_divisor_inj", "description": "", "p": "mathlib"}, {"name": "lagrange.derivative_nodal", "description": "", "p": "mathlib"}, {"name": "lagrange.degree_interpolate_lt", "description": "", "p": "mathlib"}, {"name": "lagrange.degree_basis", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_interpolate_not_at_node'", "description": "This is the second barycentric form of the Lagrange interpolant.", "p": "mathlib"}, {"name": "lagrange.eval_basis_of_ne", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_pair_right", "description": "", "p": "mathlib"}, {"name": "lagrange.nodal_weight", "description": "This defines the nodal weight for a given set of node indexes and node mapping function `v`.", "p": "mathlib"}, {"name": "lagrange.fun_equiv_degree_lt", "description": " Lagrange interpolation induces isomorphism between functions from `s`\nand polynomials of degree less than `fintype.card \u03b9`.", "p": "mathlib"}, {"name": "lagrange.nodal_empty", "description": "", "p": "mathlib"}, {"name": "polynomial.eq_of_degree_sub_lt_of_eval_index_eq", "description": "", "p": "mathlib"}, {"name": "polynomial.eq_zero_of_degree_lt_of_eval_finset_eq_zero", "description": "", "p": "mathlib"}, {"name": "lagrange.nodal_weight_ne_zero", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_basis_divisor_right", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_basis_self", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate_eq_of_values_eq_on", "description": "", "p": "mathlib"}, {"name": "lagrange.nodal_weight_eq_eval_nodal_erase_inv", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_basis_divisor_left_of_ne", "description": "", "p": "mathlib"}, {"name": "lagrange.basis_divisor_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "lagrange.eval_interpolate_not_at_node", "description": "This is the first barycentric form of the Lagrange interpolant.", "p": "mathlib"}, {"name": "polynomial.eq_zero_of_degree_lt_of_eval_index_eq_zero", "description": "", "p": "mathlib"}, {"name": "lagrange.degree_basis_divisor_of_ne", "description": "", "p": "mathlib"}, {"name": "lagrange.interpolate", "description": " Lagrange interpolation: given a finset `s : finset \u03b9`, a nodal map  `v : \u03b9 \u2192 F` injective on\n`s` and a value function `r : \u03b9 \u2192 F`,  `interpolate s v r` is the unique\npolynomial of degree `< s.card` that takes value `r i` on `v i` for all `i` in `s`.", "p": "mathlib"}, {"name": "summable_norm_pow_mul_geometric_of_norm_lt_1", "description": "", "p": "mathlib"}, {"name": "normed_field.tendsto_zero_smul_of_tendsto_zero_of_bounded", "description": "The (scalar) product of a sequence that tends to zero with a bounded one also tends to zero.", "p": "mathlib"}, {"name": "not_summable_of_ratio_test_tendsto_gt_one", "description": "", "p": "mathlib"}, {"name": "norm_sum_neg_one_pow_le", "description": "", "p": "mathlib"}, {"name": "seminormed_add_comm_group.cauchy_seq_of_le_geometric", "description": "", "p": "mathlib"}, {"name": "is_o_pow_pow_of_abs_lt_left", "description": "", "p": "mathlib"}, {"name": "tsum_geometric_of_norm_lt_1", "description": "", "p": "mathlib"}, {"name": "has_sum_coe_mul_geometric_of_norm_lt_1", "description": "If `\u2016r\u2016 < 1`, then `\u2211' n : \u2115, n * r ^ n = r / (1 - r) ^ 2`, `has_sum` version.", "p": "mathlib"}, {"name": "not_summable_of_ratio_norm_eventually_ge", "description": "", "p": "mathlib"}, {"name": "tendsto_pow_const_div_const_pow_of_one_lt", "description": "", "p": "mathlib"}, {"name": "dist_partial_sum'", "description": "", "p": "mathlib"}, {"name": "norm_sub_le_of_geometric_bound_of_has_sum", "description": " If `\u2016f n\u2016 \u2264 C * r ^ n` for all `n : \u2115` and some `r < 1`, then the partial sums of `f` are within\ndistance `C * r ^ n / (1 - r)` of the sum of the series. This lemma does not assume `0 \u2264 r` or\n`0 \u2264 C`.", "p": "mathlib"}, {"name": "tendsto_norm_at_top_at_top", "description": "", "p": "mathlib"}, {"name": "tsum_geometric_of_abs_lt_1", "description": "", "p": "mathlib"}, {"name": "normed_add_comm_group.cauchy_series_of_le_geometric''", "description": "", "p": "mathlib"}, {"name": "summable_geometric_of_abs_lt_1", "description": "", "p": "mathlib"}, {"name": "summable_geometric_of_norm_lt_1", "description": "", "p": "mathlib"}, {"name": "dist_partial_sum", "description": "", "p": "mathlib"}, {"name": "summable_geometric_iff_norm_lt_1", "description": " A geometric series in a normed field is summable iff the norm of the common ratio is less than\none.", "p": "mathlib"}, {"name": "normed_add_comm_group.cauchy_series_of_le_geometric'", "description": "", "p": "mathlib"}, {"name": "real.tendsto_pow_div_factorial_at_top", "description": "", "p": "mathlib"}, {"name": "summable_of_ratio_norm_eventually_le", "description": "", "p": "mathlib"}, {"name": "has_sum_geometric_of_norm_lt_1", "description": "", "p": "mathlib"}, {"name": "tendsto_self_mul_const_pow_of_lt_one", "description": " If `0 \u2264 r < 1`, then `n * r ^ n` tends to zero. This is a specialized version of\n`tendsto_self_mul_const_pow_of_abs_lt_one`, singled out for ease of application.", "p": "mathlib"}, {"name": "cauchy_series_of_le_geometric", "description": "", "p": "mathlib"}, {"name": "tendsto_pow_const_mul_const_pow_of_lt_one", "description": " If `0 \u2264 r < 1`, then `n ^ k r ^ n` tends to zero for any natural `k`.\nThis is a specialized version of `tendsto_pow_const_mul_const_pow_of_abs_lt_one`, singled out\nfor ease of application.", "p": "mathlib"}, {"name": "tendsto_norm_zero'", "description": "", "p": "mathlib"}, {"name": "dist_partial_sum_le_of_le_geometric", "description": "", "p": "mathlib"}, {"name": "normed_field.continuous_at_inv", "description": "", "p": "mathlib"}, {"name": "mul_neg_geom_series", "description": "", "p": "mathlib"}, {"name": "monotone.tendsto_alternating_series_of_tendsto_zero", "description": "The **alternating series test** for monotone sequences.", "p": "mathlib"}, {"name": "is_O_pow_pow_of_le_left", "description": "", "p": "mathlib"}, {"name": "antitone.cauchy_seq_series_mul_of_tendsto_zero_of_bounded", "description": "**Dirichlet's test** for antitone sequences.", "p": "mathlib"}, {"name": "real.summable_pow_div_factorial", "description": " The series `\u2211' n, x ^ n / n!` is summable of any `x : \u211d`. See also `exp_series_div_summable`\nfor a version that also works in `\u2102`, and `exp_series_summable'` for a version that works in\nany normed algebra over `\u211d` or `\u2102`.", "p": "mathlib"}, {"name": "is_o_pow_pow_of_lt_left", "description": "", "p": "mathlib"}, {"name": "antitone.tendsto_alternating_series_of_tendsto_zero", "description": "The **alternating series test** for antitone sequences.", "p": "mathlib"}, {"name": "monotone.cauchy_seq_alternating_series_of_tendsto_zero", "description": " The **alternating series test** for monotone sequences.\nSee also `tendsto_alternating_series_of_monotone_tendsto_zero`.", "p": "mathlib"}, {"name": "monotone.cauchy_seq_series_mul_of_tendsto_zero_of_bounded", "description": "**Dirichlet's Test** for monotone sequences.", "p": "mathlib"}, {"name": "is_o_coe_const_pow_of_one_lt", "description": "For a real `r > 1` we have `n = o(r ^ n)` as `n \u2192 \u221e`.", "p": "mathlib"}, {"name": "normed_ring.tsum_geometric_of_norm_lt_1", "description": " Bound for the sum of a geometric series in a normed ring.  This formula does not assume that the\nnormed ring satisfies the axiom `\u20161\u2016 = 1`.", "p": "mathlib"}, {"name": "normed_field.tendsto_norm_zpow_nhds_within_0_at_top", "description": "", "p": "mathlib"}, {"name": "has_sum_geometric_of_abs_lt_1", "description": "", "p": "mathlib"}, {"name": "tendsto_self_mul_const_pow_of_abs_lt_one", "description": "If `|r| < 1`, then `n * r ^ n` tends to zero.", "p": "mathlib"}, {"name": "tfae_exists_lt_is_o_pow", "description": " Various statements equivalent to the fact that `f n` grows exponentially slower than `R ^ n`.\n\n* 0: $f n = o(a ^ n)$ for some $-R < a < R$;\n* 1: $f n = o(a ^ n)$ for some $0 < a < R$;\n* 2: $f n = O(a ^ n)$ for some $-R < a < R$;\n* 3: $f n = O(a ^ n)$ for some $0 < a < R$;\n* 4: there exist `a < R` and `C` such that one of `C` and `R` is positive and $|f n| \u2264 Ca^n$\n     for all `n`;\n* 5: there exists `0 < a < R` and a positive `C` such that $|f n| \u2264 Ca^n$ for all `n`;\n* 6: there exists `a < R` such that $|f n| \u2264 a ^ n$ for sufficiently large `n`;\n* 7: there exists `0 < a < R` such that $|f n| \u2264 a ^ n$ for sufficiently large `n`.\n\nNB: For backwards compatibility, if you add more items to the list, please append them at the end of\nthe list.", "p": "mathlib"}, {"name": "tendsto_pow_at_top_nhds_0_of_norm_lt_1", "description": "In a normed ring, the powers of an element x with `\u2016x\u2016 < 1` tend to zero.", "p": "mathlib"}, {"name": "antitone.cauchy_seq_alternating_series_of_tendsto_zero", "description": " The **alternating series test** for antitone sequences.\nSee also `tendsto_alternating_series_of_antitone_tendsto_zero`.", "p": "mathlib"}, {"name": "is_o_pow_const_mul_const_pow_const_pow_of_norm_lt", "description": "If `\u2016r\u2081\u2016 < r\u2082`, then for any naturak `k` we have `n ^ k r\u2081 ^ n = o (r\u2082 ^ n)` as `n \u2192 \u221e`.", "p": "mathlib"}, {"name": "tendsto_pow_at_top_nhds_0_of_abs_lt_1", "description": "", "p": "mathlib"}, {"name": "normed_field.continuous_at_zpow", "description": "", "p": "mathlib"}, {"name": "summable_of_absolute_convergence_real", "description": "", "p": "mathlib"}, {"name": "geom_series_mul_neg", "description": "", "p": "mathlib"}, {"name": "tendsto_pow_const_mul_const_pow_of_abs_lt_one", "description": "If `|r| < 1`, then `n ^ k r ^ n` tends to zero for any natural `k`.", "p": "mathlib"}, {"name": "tsum_coe_mul_geometric_of_norm_lt_1", "description": "If `\u2016r\u2016 < 1`, then `\u2211' n : \u2115, n * r ^ n = r / (1 - r) ^ 2`.", "p": "mathlib"}, {"name": "normed_ring.summable_geometric_of_norm_lt_1", "description": " A geometric series in a complete normed ring is summable.\nProved above (same name, different namespace) for not-necessarily-complete normed fields.", "p": "mathlib"}, {"name": "is_o_pow_const_const_pow_of_one_lt", "description": "For any natural `k` and a real `r > 1` we have `n ^ k = o(r ^ n)` as `n \u2192 \u221e`.", "p": "mathlib"}, {"name": "summable_of_ratio_test_tendsto_lt_one", "description": "", "p": "mathlib"}, {"name": "summable_pow_mul_geometric_of_norm_lt_1", "description": "", "p": "mathlib"}, {"name": "cauchy_seq_finset_of_geometric_bound", "description": " If `\u2016f n\u2016 \u2264 C * r ^ n` for all `n : \u2115` and some `r < 1`, then the partial sums of `f` form a\nCauchy sequence. This lemma does not assume `0 \u2264 r` or `0 \u2264 C`.", "p": "mathlib"}, {"name": "normed_field.tendsto_norm_inverse_nhds_within_0_at_top", "description": "", "p": "mathlib"}, {"name": "differentiable_within_at.zpow", "description": "", "p": "mathlib"}, {"name": "differentiable_on.zpow", "description": "", "p": "mathlib"}, {"name": "iter_deriv_inv'", "description": "", "p": "mathlib"}, {"name": "iter_deriv_pow", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at_zpow", "description": "", "p": "mathlib"}, {"name": "deriv_within_zpow", "description": "", "p": "mathlib"}, {"name": "has_strict_deriv_at_zpow", "description": "", "p": "mathlib"}, {"name": "differentiable_at.zpow", "description": "", "p": "mathlib"}, {"name": "differentiable_at_zpow", "description": "", "p": "mathlib"}, {"name": "differentiable_on_zpow", "description": "", "p": "mathlib"}, {"name": "iter_deriv_inv", "description": "", "p": "mathlib"}, {"name": "deriv_zpow'", "description": "", "p": "mathlib"}, {"name": "iter_deriv_pow'", "description": "", "p": "mathlib"}, {"name": "iter_deriv_zpow", "description": "", "p": "mathlib"}, {"name": "has_deriv_at_zpow", "description": "", "p": "mathlib"}, {"name": "deriv_zpow", "description": "", "p": "mathlib"}, {"name": "differentiable.zpow", "description": "", "p": "mathlib"}, {"name": "iter_deriv_zpow'", "description": "", "p": "mathlib"}, {"name": "differentiable_within_at_zpow", "description": "", "p": "mathlib"}, {"name": "io.set_rand_gen", "description": "", "p": "core"}, {"name": "monad_io_environment_impl", "description": "", "p": "core"}, {"name": "io_rand_nat", "description": "Auxiliary definition used in the builtin implementation of monad_io_random_impl", "p": "core"}, {"name": "io.stderr", "description": "", "p": "core"}, {"name": "io.fs.read_file", "description": "", "p": "core"}, {"name": "format.print", "description": "", "p": "core"}, {"name": "monad_io_process_impl", "description": "", "p": "core"}, {"name": "pp", "description": "", "p": "core"}, {"name": "io.proc.sleep", "description": "", "p": "core"}, {"name": "io.catch", "description": "", "p": "core"}, {"name": "io.finally", "description": "", "p": "core"}, {"name": "io.net.send", "description": "", "p": "core"}, {"name": "io.handle", "description": "", "p": "core"}, {"name": "io.fs.put_str_ln", "description": "", "p": "core"}, {"name": "io_core", "description": "", "p": "core"}, {"name": "io.fs.get_char", "description": "", "p": "core"}, {"name": "monad_io_random_impl", "description": "", "p": "core"}, {"name": "io.env.set_cwd", "description": "set the current working directory", "p": "core"}, {"name": "io.run_tactic", "description": "Execute the given tactic with a tactic_state object that contains:\n- The current environment in the virtual machine.\n- The current set of options in the virtual machine.\n- Empty metavariable and local contexts.\n- One single goal of the form `\u22a2 true`.\nThis action is mainly useful for writing tactics that inspect\nthe environment.", "p": "core"}, {"name": "io.iterate", "description": "", "p": "core"}, {"name": "io.proc.child", "description": "", "p": "core"}, {"name": "io", "description": "", "p": "core"}, {"name": "io.fs.rename", "description": "", "p": "core"}, {"name": "io.cmdline_args", "description": "", "p": "core"}, {"name": "io.fs.get_line", "description": "", "p": "core"}, {"name": "monad_io_file_system_impl", "description": "", "p": "core"}, {"name": "io.fs.flush", "description": "", "p": "core"}, {"name": "io.cmd", "description": "Run the external process specified by `args`.\n\n   The process will run to completion with its output captured by a pipe, and\n   read into `string` which is then returned.", "p": "core"}, {"name": "io.put_str_ln", "description": "", "p": "core"}, {"name": "monad_io_impl", "description": "", "p": "core"}, {"name": "io.mk_file_handle", "description": "", "p": "core"}, {"name": "io.print", "description": "", "p": "core"}, {"name": "format.print_using", "description": "", "p": "core"}, {"name": "io.fs.put_char", "description": "", "p": "core"}, {"name": "io.net.connect", "description": "", "p": "core"}, {"name": "io.fs.rmdir", "description": "", "p": "core"}, {"name": "io.proc.child.stdin", "description": "", "p": "core"}, {"name": "io.proc.child.stderr", "description": "", "p": "core"}, {"name": "io.deserialize", "description": "", "p": "core"}, {"name": "io.fs.read", "description": "", "p": "core"}, {"name": "io.serialize", "description": "", "p": "core"}, {"name": "io.rand", "description": "", "p": "core"}, {"name": "io.print_ln", "description": "", "p": "core"}, {"name": "io_core_is_monad_fail", "description": "", "p": "core"}, {"name": "io.fs.write", "description": "", "p": "core"}, {"name": "io.env.get_cwd", "description": "get the current working directory", "p": "core"}, {"name": "io.net.close", "description": "", "p": "core"}, {"name": "io.proc.wait", "description": "", "p": "core"}, {"name": "io.env.get", "description": "", "p": "core"}, {"name": "monad_io_net_system_impl", "description": "", "p": "core"}, {"name": "io.net.socket", "description": "", "p": "core"}, {"name": "io.unsafe_perform_io", "description": " Similarly to `tactic.unsafe_run_io`, this gives an unsafe backdoor to run io inside a pure function.\n\nIf `unsafe_perform_io` is used to perform side-effects, users need to take the following\nprecautions:\n\n- Use `@[noinline]` attribute in any function to invokes `tactic.unsafe_perform_io`.\n  Reason: if the call is inlined, the IO may be performed more than once.\n\n- Set `set_option compiler.cse false` before any function that invokes `tactic.unsafe_perform_io`.\n  This option disables common subexpression elimination. Common subexpression elimination\n  might combine two side effects that were meant to be separate.\n\nTODO[Leo]: add `[noinline]` attribute and option `compiler.cse`.", "p": "core"}, {"name": "monad_io_serial_impl", "description": "", "p": "core"}, {"name": "monad_io_terminal_impl", "description": "", "p": "core"}, {"name": "io.net.accept", "description": "", "p": "core"}, {"name": "io_core_is_alternative", "description": "", "p": "core"}, {"name": "io_core_is_monad", "description": "", "p": "core"}, {"name": "io.fs.remove", "description": "", "p": "core"}, {"name": "io.fs.close", "description": "", "p": "core"}, {"name": "io.fs.read_to_end", "description": "", "p": "core"}, {"name": "io.stdin", "description": "", "p": "core"}, {"name": "io.put_str", "description": "", "p": "core"}, {"name": "io.fs.dir_exists", "description": "", "p": "core"}, {"name": "io.net.listen", "description": "", "p": "core"}, {"name": "tactic.unsafe_run_io", "description": "This is the \"back door\" into the `io` monad, allowing IO computation to be performed during tactic execution.\nFor this to be safe, the IO computation should be ideally free of side effects and independent of its environment.\nThis primitive is used to invoke external tools (e.g., SAT and SMT solvers) from a tactic.", "p": "core"}, {"name": "io.fs.file_exists", "description": "", "p": "core"}, {"name": "io.get_line", "description": "", "p": "core"}, {"name": "io.proc.spawn", "description": "", "p": "core"}, {"name": "io.forever", "description": "", "p": "core"}, {"name": "io.fs.put_str", "description": "", "p": "core"}, {"name": "io.net.recv", "description": "", "p": "core"}, {"name": "io.proc.child.stdout", "description": "", "p": "core"}, {"name": "io.fail", "description": "", "p": "core"}, {"name": "io.stdout", "description": "", "p": "core"}, {"name": "io.fs.is_eof", "description": "", "p": "core"}, {"name": "pp_using", "description": "", "p": "core"}, {"name": "io.fs.mkdir", "description": "", "p": "core"}, {"name": "is_homeomorphic_trivial_fiber_bundle.proj_eq", "description": "", "p": "mathlib"}, {"name": "is_homeomorphic_trivial_fiber_bundle.is_open_map_proj", "description": "The projection from a trivial fiber bundle to its base is open.", "p": "mathlib"}, {"name": "is_homeomorphic_trivial_fiber_bundle", "description": " A trivial fiber bundle with fiber `F` over a base `B` is a space `Z`\nprojecting on `B` for which there exists a homeomorphism to `B \u00d7 F` that sends `proj`\nto `prod.fst`.", "p": "mathlib"}, {"name": "is_homeomorphic_trivial_fiber_bundle.surjective_proj", "description": "The projection from a trivial fiber bundle to its base is surjective.", "p": "mathlib"}, {"name": "is_homeomorphic_trivial_fiber_bundle.quotient_map_proj", "description": "The projection from a trivial fiber bundle to its base is open.", "p": "mathlib"}, {"name": "is_homeomorphic_trivial_fiber_bundle_snd", "description": "The second projection in a product is a trivial fiber bundle.", "p": "mathlib"}, {"name": "is_homeomorphic_trivial_fiber_bundle_fst", "description": "The first projection in a product is a trivial fiber bundle.", "p": "mathlib"}, {"name": "is_homeomorphic_trivial_fiber_bundle.continuous_proj", "description": "The projection from a trivial fiber bundle to its base is continuous.", "p": "mathlib"}, {"name": "real.arcsin_le_pi_div_two", "description": "", "p": "mathlib"}, {"name": "real.arcsin_mem_Icc", "description": "", "p": "mathlib"}, {"name": "real.cos_arccos", "description": "", "p": "mathlib"}, {"name": "real.arcsin_inj", "description": "", "p": "mathlib"}, {"name": "real.lt_arcsin_iff_sin_lt", "description": "", "p": "mathlib"}, {"name": "real.arccos_neg", "description": "", "p": "mathlib"}, {"name": "real.range_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arcsin_sin", "description": "", "p": "mathlib"}, {"name": "real.arccos_nonneg", "description": "", "p": "mathlib"}, {"name": "real.arcsin_eq_pi_div_two", "description": "", "p": "mathlib"}, {"name": "real.arcsin_lt_zero", "description": "", "p": "mathlib"}, {"name": "real.neg_pi_div_two_eq_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arcsin_eq_neg_pi_div_two", "description": "", "p": "mathlib"}, {"name": "real.strict_mono_on_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arccos_eq_pi", "description": "", "p": "mathlib"}, {"name": "real.arcsin_eq_of_sin_eq", "description": "", "p": "mathlib"}, {"name": "real.arcsin_neg_one", "description": "", "p": "mathlib"}, {"name": "real.sin_arcsin", "description": "", "p": "mathlib"}, {"name": "real.neg_pi_div_two_le_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arcsin_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "real.arcsin_le_neg_pi_div_two", "description": "", "p": "mathlib"}, {"name": "real.le_arcsin_iff_sin_le'", "description": "", "p": "mathlib"}, {"name": "real.arcsin_eq_pi_div_two_sub_arccos", "description": "", "p": "mathlib"}, {"name": "real.lt_arcsin_iff_sin_lt'", "description": "", "p": "mathlib"}, {"name": "real.arcsin_one", "description": "", "p": "mathlib"}, {"name": "real.arcsin_of_le_neg_one", "description": "", "p": "mathlib"}, {"name": "real.arccos_lt_pi_div_two", "description": "", "p": "mathlib"}, {"name": "real.tan_arcsin", "description": "", "p": "mathlib"}, {"name": "real.continuous_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arccos_cos", "description": "", "p": "mathlib"}, {"name": "real.arccos_inj", "description": "", "p": "mathlib"}, {"name": "real.arccos_inj_on", "description": "", "p": "mathlib"}, {"name": "real.arccos", "description": "Inverse of the `cos` function, returns values in the range `0 \u2264 arccos x` and `arccos x \u2264 \u03c0`.\n It defaults to `\u03c0` on `(-\u221e, -1)` and to `0` to `(1, \u221e)`.", "p": "mathlib"}, {"name": "real.le_arcsin_iff_sin_le", "description": "", "p": "mathlib"}, {"name": "real.arcsin", "description": " Inverse of the `sin` function, returns values in the range `-\u03c0 / 2 \u2264 arcsin x \u2264 \u03c0 / 2`.\nIt defaults to `-\u03c0 / 2` on `(-\u221e, -1)` and to `\u03c0 / 2` to `(1, \u221e)`.", "p": "mathlib"}, {"name": "real.arccos_pos", "description": "", "p": "mathlib"}, {"name": "real.arcsin_neg", "description": "", "p": "mathlib"}, {"name": "real.arcsin_le_iff_le_sin'", "description": "", "p": "mathlib"}, {"name": "real.arcsin_eq_arccos", "description": "", "p": "mathlib"}, {"name": "real.arcsin_lt_pi_div_two", "description": "", "p": "mathlib"}, {"name": "real.sin_local_homeomorph", "description": "`real.sin` as a `local_homeomorph` between `(-\u03c0 / 2, \u03c0 / 2)` and `(-1, 1)`.", "p": "mathlib"}, {"name": "real.arcsin_lt_iff_lt_sin'", "description": "", "p": "mathlib"}, {"name": "real.arccos_zero", "description": "", "p": "mathlib"}, {"name": "real.cos_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arccos_eq_arcsin", "description": "", "p": "mathlib"}, {"name": "real.zero_eq_arcsin_iff", "description": "", "p": "mathlib"}, {"name": "real.monotone_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arccos_of_le_neg_one", "description": "", "p": "mathlib"}, {"name": "real.arccos_le_pi_div_four", "description": "", "p": "mathlib"}, {"name": "real.arcsin_sin'", "description": "", "p": "mathlib"}, {"name": "real.arccos_eq_pi_div_two", "description": "", "p": "mathlib"}, {"name": "real.arcsin_lt_iff_lt_sin", "description": "", "p": "mathlib"}, {"name": "real.arccos_of_one_le", "description": "", "p": "mathlib"}, {"name": "real.continuous_at_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arcsin_nonneg", "description": "", "p": "mathlib"}, {"name": "real.inj_on_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arcsin_nonpos", "description": "", "p": "mathlib"}, {"name": "real.arccos_neg_one", "description": "", "p": "mathlib"}, {"name": "real.arcsin_zero", "description": "", "p": "mathlib"}, {"name": "real.arcsin_le_iff_le_sin", "description": "", "p": "mathlib"}, {"name": "real.maps_to_sin_Ioo", "description": "", "p": "mathlib"}, {"name": "real.arccos_le_pi_div_two", "description": "", "p": "mathlib"}, {"name": "real.tan_arccos", "description": "", "p": "mathlib"}, {"name": "real.continuous_arccos", "description": "", "p": "mathlib"}, {"name": "real.arcsin_eq_iff_eq_sin", "description": "", "p": "mathlib"}, {"name": "real.sin_arcsin'", "description": "", "p": "mathlib"}, {"name": "real.neg_pi_div_two_lt_arcsin", "description": "", "p": "mathlib"}, {"name": "real.pi_div_two_le_arcsin", "description": "", "p": "mathlib"}, {"name": "real.pi_div_four_le_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arcsin_of_one_le", "description": "", "p": "mathlib"}, {"name": "real.strict_anti_on_arccos", "description": "", "p": "mathlib"}, {"name": "real.arcsin_pos", "description": "", "p": "mathlib"}, {"name": "real.arccos_le_pi", "description": "", "p": "mathlib"}, {"name": "real.cos_arcsin_nonneg", "description": "", "p": "mathlib"}, {"name": "real.arccos_one", "description": "", "p": "mathlib"}, {"name": "real.arccos_eq_pi_div_two_sub_arcsin", "description": "", "p": "mathlib"}, {"name": "real.pi_div_two_eq_arcsin", "description": "", "p": "mathlib"}, {"name": "real.arccos_eq_zero", "description": "", "p": "mathlib"}, {"name": "real.sin_arccos", "description": "", "p": "mathlib"}, {"name": "real.arcsin_proj_Icc", "description": "", "p": "mathlib"}, {"name": "real.volume_pi_Ico_to_real", "description": "", "p": "mathlib"}, {"name": "real.volume_pi_ball", "description": "", "p": "mathlib"}, {"name": "real.volume_singleton", "description": "", "p": "mathlib"}, {"name": "real.volume_emetric_closed_ball", "description": "", "p": "mathlib"}, {"name": "real.is_finite_measure_restrict_Ioo", "description": "", "p": "mathlib"}, {"name": "measurable_set_graph", "description": "The graph of a measurable function is a measurable set.", "p": "mathlib"}, {"name": "real.volume_pi_le_diam_pow", "description": "", "p": "mathlib"}, {"name": "real.smul_map_volume_mul_left", "description": "", "p": "mathlib"}, {"name": "real.volume_Ico", "description": "", "p": "mathlib"}, {"name": "real.is_finite_measure_restrict_Ico", "description": "", "p": "mathlib"}, {"name": "real.volume_preserving_transvection_struct", "description": "A transvection preserves Lebesgue measure.", "p": "mathlib"}, {"name": "real.volume_closed_ball", "description": "", "p": "mathlib"}, {"name": "real.volume_pi_Ico", "description": "", "p": "mathlib"}, {"name": "real.volume_univ", "description": "", "p": "mathlib"}, {"name": "real.volume_ball", "description": "", "p": "mathlib"}, {"name": "real.has_no_atoms_volume", "description": "", "p": "mathlib"}, {"name": "real.map_volume_mul_right", "description": "", "p": "mathlib"}, {"name": "real.is_finite_measure_restrict_Icc", "description": "", "p": "mathlib"}, {"name": "real.volume_pi_le_prod_diam", "description": "", "p": "mathlib"}, {"name": "real.volume_pi_Ioo_to_real", "description": "", "p": "mathlib"}, {"name": "real.volume_Icc", "description": "", "p": "mathlib"}, {"name": "real.smul_map_diagonal_volume_pi", "description": " A diagonal matrix rescales Lebesgue according to its determinant. This is a special case of\n`real.map_matrix_volume_pi_eq_smul_volume_pi`, that one should use instead (and whose proof\nuses this particular case).", "p": "mathlib"}, {"name": "real.volume_emetric_ball", "description": "", "p": "mathlib"}, {"name": "volume_region_between_eq_lintegral'", "description": "", "p": "mathlib"}, {"name": "real.map_linear_map_volume_pi_eq_smul_volume_pi", "description": " Any invertible linear map rescales Lebesgue measure through the absolute value of its\ndeterminant.", "p": "mathlib"}, {"name": "region_between_subset", "description": "", "p": "mathlib"}, {"name": "measurable_set_region_between_oc", "description": " The region between two measurable functions on a measurable set is measurable;\na version for the region together with the graph of the upper function.", "p": "mathlib"}, {"name": "real.volume_interval", "description": "", "p": "mathlib"}, {"name": "ae_of_mem_of_ae_of_mem_inter_Ioo", "description": " Consider a real set `s`. If a property is true almost everywhere in `s \u2229 (a, b)` for\nall `a, b \u2208 s`, then it is true almost everywhere in `s`. Formulated with bare membership.\nSee also `ae_restrict_of_ae_restrict_inter_Ioo`.", "p": "mathlib"}, {"name": "real.volume_pi_Ioc", "description": "", "p": "mathlib"}, {"name": "real.volume_Ioo", "description": "", "p": "mathlib"}, {"name": "real.map_matrix_volume_pi_eq_smul_volume_pi", "description": " Any invertible matrix rescales Lebesgue measure through the absolute value of its\ndeterminant.", "p": "mathlib"}, {"name": "real.volume_le_diam", "description": "", "p": "mathlib"}, {"name": "real.volume_preimage_mul_left", "description": "", "p": "mathlib"}, {"name": "region_between", "description": "The region between two real-valued functions on an arbitrary set.", "p": "mathlib"}, {"name": "measurable_set_region_between", "description": "The region between two measurable functions on a measurable set is measurable.", "p": "mathlib"}, {"name": "real.is_finite_measure_restrict_Ioc", "description": "", "p": "mathlib"}, {"name": "real.volume_Ioc", "description": "", "p": "mathlib"}, {"name": "real.map_volume_mul_left", "description": "", "p": "mathlib"}, {"name": "measurable_set_region_between_cc", "description": " The region between two measurable functions on a measurable set is measurable;\na version for the region together with the graphs of both functions.", "p": "mathlib"}, {"name": "real.volume_Iic", "description": "", "p": "mathlib"}, {"name": "real.volume_pi_Ioo", "description": "", "p": "mathlib"}, {"name": "real.volume_preimage_mul_right", "description": "", "p": "mathlib"}, {"name": "real.volume_pi_Ioc_to_real", "description": "", "p": "mathlib"}, {"name": "filter.eventually.volume_pos_of_nhds_real", "description": "", "p": "mathlib"}, {"name": "real.volume_Icc_pi", "description": "", "p": "mathlib"}, {"name": "measurable_set_region_between_co", "description": " The region between two measurable functions on a measurable set is measurable;\na version for the region together with the graph of the lower function.", "p": "mathlib"}, {"name": "real.volume_Icc_pi_to_real", "description": "", "p": "mathlib"}, {"name": "real.volume_Iio", "description": "", "p": "mathlib"}, {"name": "volume_region_between_eq_lintegral", "description": "The volume of the region between two almost everywhere measurable functions on a measurable set\n   can be represented as a Lebesgue integral.", "p": "mathlib"}, {"name": "real.volume_eq_stieltjes_id", "description": " The volume on the real line (as a particular case of the volume on a finite-dimensional\ninner product space) coincides with the Stieltjes measure coming from the identity function.", "p": "mathlib"}, {"name": "real.volume_pi_closed_ball", "description": "", "p": "mathlib"}, {"name": "ae_restrict_of_ae_restrict_inter_Ioo", "description": " Consider a real set `s`. If a property is true almost everywhere in `s \u2229 (a, b)` for\nall `a, b \u2208 s`, then it is true almost everywhere in `s`. Formulated with `\u03bc.restrict`.\nSee also `ae_of_mem_of_ae_of_mem_inter_Ioo`.", "p": "mathlib"}, {"name": "real.locally_finite_volume", "description": "", "p": "mathlib"}, {"name": "real.volume_Ioi", "description": "", "p": "mathlib"}, {"name": "real.smul_map_volume_mul_right", "description": "", "p": "mathlib"}, {"name": "real.volume_Ici", "description": "", "p": "mathlib"}, {"name": "real.volume_val", "description": "", "p": "mathlib"}, {"name": "box_integral.norm_integral_le_of_le_const", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.sum_integral_congr", "description": " If `f` is integrable on `I`, then `\u03bb J, integral J l f vol` is box-additive on subboxes of `I`:\nif `\u03c0\u2081`, `\u03c0\u2082` are two prepartitions of `I` covering the same part of `I`, then the sum of integrals\nof `f` over the boxes of `\u03c0\u2081` is equal to the sum of integrals of `f` over the boxes of `\u03c0\u2082`.\n\nSee also `box_integral.integrable.to_box_additive` for a bundled version.", "p": "mathlib"}, {"name": "box_integral.integrable.smul", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral_iff", "description": "The `\u03b5`-`\u03b4` definition of `box_integral.has_integral`.", "p": "mathlib"}, {"name": "box_integral.integrable.convergence_r_cond", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.has_integral", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.to_box_additive_apply", "description": "", "p": "mathlib"}, {"name": "box_integral.norm_integral_le_of_norm_le", "description": " If `\u2016f x\u2016 \u2264 g x` on `[l, u]` and `g` is integrable, then the norm of the integral of `f` is less\nthan or equal to the integral of `g`.", "p": "mathlib"}, {"name": "box_integral.has_integral.integral_eq", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.tendsto_integral_sum_to_filter_Union_single", "description": " If `f` is integrable on a box `I`, then integral sums of `f` over tagged prepartitions\nthat cover exactly a subbox `J \u2264 I` tend to the integral of `f` over `J` along `l`.", "p": "mathlib"}, {"name": "box_integral.integrable.cauchy_map_integral_sum_to_filter_Union", "description": " If `f` is integrable on a box `I` along `l`, then for any fixed subset `s` of `I` that can be\nrepresented as a finite union of boxes, the integral sums of `f` over tagged prepartitions that\ncover exactly `s` form a Cauchy \u201csequence\u201d along `l`.", "p": "mathlib"}, {"name": "box_integral.has_integral_const", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_const", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_sum_fiberwise", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.dist_integral_sum_le_of_mem_base_set", "description": " **Henstock-Sacks inequality**. Let `r\u2081 r\u2082 : \u211d\u207f \u2192 (0, \u221e)` be function such that for any tagged\n*partition* of `I` subordinate to `r\u2096`, `k=1,2`, the integral sum of `f` over this partition differs\nfrom the integral of `f` by at most `\u03b5\u2096`. Then for any two tagged *prepartition* `\u03c0\u2081 \u03c0\u2082` subordinate\nto `r\u2081` and `r\u2082` respectively and covering the same part of `I`, the integral sums of `f` over these\nprepartitions differ from each other by at most `\u03b5\u2081 + \u03b5\u2082`.\n\nThe actual statement\n\n- uses `box_integral.integrable.convergence_r` instead of a predicate assumption on `r`;\n- uses `box_integral.integration_params.mem_base_set` instead of \u201csubordinate to `r`\u201d to\n  account for additional requirements like being a Henstock partition or having a bounded\n  distortion.\n\nSee also `box_integral.integrable.dist_integral_sum_sum_integral_le_of_mem_base_set_of_Union_eq` and\n`box_integral.integrable.dist_integral_sum_sum_integral_le_of_mem_base_set`.", "p": "mathlib"}, {"name": "box_integral.has_integral.integrable", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral_of_mul", "description": " Quite often it is more natural to prove an estimate of the form `a * \u03b5`, not `\u03b5` in the RHS of\n`box_integral.has_integral_iff`, so we provide this auxiliary lemma.", "p": "mathlib"}, {"name": "box_integral.has_integral_sum", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_neg", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral.tendsto", "description": " Reinterpret `box_integral.has_integral` as `filter.tendsto`, e.g., dot-notation theorems\nthat are shadowed in the `box_integral.has_integral` namespace.", "p": "mathlib"}, {"name": "box_integral.has_integral.mono", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_sum_smul", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral.unique", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_add", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.neg", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_sub", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral.smul", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.to_box_additive", "description": " If `f` is integrable on `I`, then `\u03bb J, integral J l f vol` is box-additive on subboxes of `I`:\nif `\u03c0\u2081`, `\u03c0\u2082` are two prepartitions of `I` covering the same part of `I`, then the sum of integrals\nof `f` over the boxes of `\u03c0\u2081` is equal to the sum of integrals of `f` over the boxes of `\u03c0\u2082`.\n\nSee also `box_integral.integrable.sum_integral_congr` for an unbundled version.", "p": "mathlib"}, {"name": "box_integral.integral_zero", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.tendsto_integral_sum_sum_integral", "description": " Integral sum of `f` over a tagged prepartition `\u03c0` such that `\u03c0.Union = \u03c0\u2080.Union` tends to the\nsum of integrals of `f` over the boxes of `\u03c0\u2080`.", "p": "mathlib"}, {"name": "box_integral.integrable_iff_cauchy", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_nonneg", "description": " The integral of a nonnegative function w.r.t. a volume generated by a locally-finite measure is\nnonnegative.", "p": "mathlib"}, {"name": "box_integral.integral_sum_add", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_sum_inf_partition", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_sum_disj_union", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral.neg", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral_zero", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral_of_bRiemann_eq_ff_of_forall_is_o", "description": " This is an auxiliary lemma used to prove two statements at once. Use one of the next two\nlemmas instead.", "p": "mathlib"}, {"name": "box_integral.has_integral_McShane_of_forall_is_o", "description": " Suppose that there exists a nonnegative box-additive function `B` with the following property.\n\nFor every `c : \u211d\u22650`, a point `x \u2208 I.Icc`, and a positive `\u03b5` there exists `\u03b4 > 0` such that for any\nbox `J \u2264 I` such that\n\n- `J.Icc \u2286 metric.closed_ball x \u03b4`;\n- if `l.bDistortion` (i.e., `l = \u22a5`), then the distortion of `J` is less than or equal to `c`,\n\nthe distance between the term `vol J (f x)` of an integral sum corresponding to `J` and `g J` is\nless than or equal to `\u03b5 * B J`.\n\nThen `f` is McShane integrable on `I` with integral `g I`.", "p": "mathlib"}, {"name": "box_integral.integrable.sub", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_sum_sub_partitions", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.of_neg", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_sum_neg", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable_neg", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.add", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_sum_bUnion_tagged", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.to_subbox", "description": "If `f` is integrable on a box `I`, then it is integrable on any subbox of `I`.", "p": "mathlib"}, {"name": "box_integral.has_integral", "description": " The predicate `has_integral I l f vol y` says that `y` is the integral of `f` over `I` along `l`\nw.r.t. volume `vol`. This means that integral sums of `f` tend to `\ud835\udcdd y` along\n`box_integral.integration_params.to_filter_Union I \u22a4`.", "p": "mathlib"}, {"name": "box_integral.integrable.of_smul", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.dist_integral_sum_sum_integral_le_of_mem_base_set_of_Union_eq", "description": " **Henstock-Sacks inequality**. Let `r : \u211d\u207f \u2192 (0, \u221e)` be a function such that for any tagged\n*partition* of `I` subordinate to `r`, the integral sum of `f` over this partition differs from the\nintegral of `f` by at most `\u03b5`. Then for any tagged *prepartition* `\u03c0` subordinate to `r`, the\nintegral sum of `f` over this prepartition differs from the integral of `f` over the part of `I`\ncovered by `\u03c0` by at most `\u03b5`.\n\nThe actual statement\n\n- uses `box_integral.integrable.convergence_r` instead of a predicate assumption on `r`;\n- uses `box_integral.integration_params.mem_base_set` instead of \u201csubordinate to `r`\u201d to\n  account for additional requirements like being a Henstock partition or having a bounded\n  distortion;\n- takes an extra argument `\u03c0\u2080 : prepartition I` and an assumption `\u03c0.Union = \u03c0\u2080.Union` instead of\n  using `\u03c0.to_prepartition`.", "p": "mathlib"}, {"name": "box_integral.integrable", "description": " A function is integrable if there exists a vector that satisfies the `has_integral`\npredicate.", "p": "mathlib"}, {"name": "box_integral.integrable.mono", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.dist_integral_sum_integral_le_of_mem_base_set", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable_zero", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral.sub", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_smul", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral.add", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable.tendsto_integral_sum_to_filter_prod_self_inf_Union_eq_uniformity", "description": " If `f` is integrable on `I` along `l`, then for two sufficiently fine tagged prepartitions\n(in the sense of the filter `box_integral.integration_params.to_filter l I`) such that they cover\nthe same part of `I`, the integral sums of `f` over `\u03c0\u2081` and `\u03c0\u2082` are very close to each other.", "p": "mathlib"}, {"name": "box_integral.integrable.to_subbox_aux", "description": "", "p": "mathlib"}, {"name": "box_integral.has_integral_of_le_Henstock_of_forall_is_o", "description": " A function `f` has Henstock (or `\u22a5`) integral over `I` is equal to the value of a box-additive\nfunction `g` on `I` provided that `vol J (f x)` is sufficiently close to `g J` for sufficiently\nsmall boxes `J \u220b x`. This lemma is useful to prove, e.g., to prove the Divergence theorem for\nintegral along `\u22a5`.\n\nLet `l` be either `box_integral.integration_params.Henstock` or `\u22a5`. Let `g` a box-additive function\non subboxes of `I`. Suppose that there exists a nonnegative box-additive function `B` and a\ncountable set `s` with the following property.\n\nFor every `c : \u211d\u22650`, a point `x \u2208 I.Icc`, and a positive `\u03b5` there exists `\u03b4 > 0` such that for any\nbox `J \u2264 I` such that\n\n- `x \u2208 J.Icc \u2286 metric.closed_ball x \u03b4`;\n- if `l.bDistortion` (i.e., `l = \u22a5`), then the distortion of `J` is less than or equal to `c`,\n\nthe distance between the term `vol J (f x)` of an integral sum corresponding to `J` and `g J` is\nless than or equal to `\u03b5` if `x \u2208 s` and is less than or equal to `\u03b5 * B J` otherwise.\n\nThen `f` is integrable on `I along `l` with integral `g I`.", "p": "mathlib"}, {"name": "box_integral.integrable_of_continuous_on", "description": " A continuous function is box-integrable with respect to any locally finite measure.\n\nThis is true for any volume with bounded variation.", "p": "mathlib"}, {"name": "box_integral.integrable.convergence_r", "description": " If `\u03b5 > 0`, then `box_integral.integrable.convergence_r` is a function `r : \u211d\u22650 \u2192 \u211d\u207f \u2192 (0, \u221e)`\nsuch that for every `c : \u211d\u22650`, for every tagged partition `\u03c0` subordinate to `r` (and satisfying\nadditional distortion estimates if `box_integral.integration_params.bDistortion l = tt`), the\ncorresponding integral sum is `\u03b5`-close to the integral.\n\nIf `box.integral.integration_params.bRiemann = tt`, then `r c x` does not depend on `x`. If `\u03b5 \u2264 0`,\nthen we use `r c x = 1`.", "p": "mathlib"}, {"name": "box_integral.integral_sum_bUnion_partition", "description": "", "p": "mathlib"}, {"name": "box_integral.integral_sum", "description": " The integral sum of `f : \u211d\u207f \u2192 E` over a tagged prepartition `\u03c0` w.r.t. box-additive volume `vol`\nwith codomain `E \u2192L[\u211d] F` is the sum of `vol J (f (\u03c0.tag J))` over all boxes of `\u03c0`.", "p": "mathlib"}, {"name": "box_integral.integral", "description": " The integral of a function `f` over a box `I` along a filter `l` w.r.t. a volume `vol`.  Returns\nzero on non-integrable functions.", "p": "mathlib"}, {"name": "box_integral.integrable_const", "description": "", "p": "mathlib"}, {"name": "box_integral.integrable_iff_cauchy_basis", "description": " In a complete space, a function is integrable if and only if its integral sums form a Cauchy\nnet. Here we restate this fact in terms of `\u2200 \u03b5 > 0, \u2203 r, ...`.", "p": "mathlib"}, {"name": "box_integral.integrable.dist_integral_sum_sum_integral_le_of_mem_base_set", "description": " **Henstock-Sacks inequality**. Let `r : \u211d\u207f \u2192 (0, \u221e)` be a function such that for any tagged\n*partition* of `I` subordinate to `r`, the integral sum of `f` over this partition differs from the\nintegral of `f` by at most `\u03b5`. Then for any tagged *prepartition* `\u03c0` subordinate to `r`, the\nintegral sum of `f` over this prepartition differs from the integral of `f` over the part of `I`\ncovered by `\u03c0` by at most `\u03b5`.\n\nThe actual statement\n\n- uses `box_integral.integrable.convergence_r` instead of a predicate assumption on `r`;\n- uses `box_integral.integration_params.mem_base_set` instead of \u201csubordinate to `r`\u201d to\n  account for additional requirements like being a Henstock partition or having a bounded\n  distortion;", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_symmL", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.base_set_at", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.module_fiber", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_at_apply_mk", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.mem_triv_change_source", "description": "", "p": "mathlib"}, {"name": "trivialization.linear_equiv_at_apply", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core", "description": " Analogous construction of `fiber_bundle_core` for vector bundles. This\nconstruction gives a way to construct vector bundles from a structure registering how\ntrivialization changes act on fibers.", "p": "mathlib"}, {"name": "vector_bundle_core.base_set", "description": " Analogous construction of `fiber_bundle_core` for vector bundles. This\nconstruction gives a way to construct vector bundles from a structure registering how\ntrivialization changes act on fibers.", "p": "mathlib"}, {"name": "vector_bundle_core.is_open_base_set", "description": " Analogous construction of `fiber_bundle_core` for vector bundles. This\nconstruction gives a way to construct vector bundles from a structure registering how\ntrivialization changes act on fibers.", "p": "mathlib"}, {"name": "vector_bundle_core.index_at", "description": " Analogous construction of `fiber_bundle_core` for vector bundles. This\nconstruction gives a way to construct vector bundles from a structure registering how\ntrivialization changes act on fibers.", "p": "mathlib"}, {"name": "vector_bundle_core.mem_base_set_at", "description": " Analogous construction of `fiber_bundle_core` for vector bundles. This\nconstruction gives a way to construct vector bundles from a structure registering how\ntrivialization changes act on fibers.", "p": "mathlib"}, {"name": "vector_bundle_core.coord_change", "description": " Analogous construction of `fiber_bundle_core` for vector bundles. This\nconstruction gives a way to construct vector bundles from a structure registering how\ntrivialization changes act on fibers.", "p": "mathlib"}, {"name": "vector_bundle_core.coord_change_self", "description": " Analogous construction of `fiber_bundle_core` for vector bundles. This\nconstruction gives a way to construct vector bundles from a structure registering how\ntrivialization changes act on fibers.", "p": "mathlib"}, {"name": "vector_bundle_core.continuous_on_coord_change", "description": " Analogous construction of `fiber_bundle_core` for vector bundles. This\nconstruction gives a way to construct vector bundles from a structure registering how\ntrivialization changes act on fibers.", "p": "mathlib"}, {"name": "vector_bundle_core.coord_change_comp", "description": " Analogous construction of `fiber_bundle_core` for vector bundles. This\nconstruction gives a way to construct vector bundles from a structure registering how\ntrivialization changes act on fibers.", "p": "mathlib"}, {"name": "continuous_linear_map.vector_bundle_core.in_coordinates_eq", "description": "rewrite `in_coordinates` in a `vector_bundle_core`.", "p": "mathlib"}, {"name": "pretrivialization.linear_map_at_def_of_not_mem", "description": "", "p": "mathlib"}, {"name": "trivialization.linear_map_at_def_of_mem", "description": "", "p": "mathlib"}, {"name": "pretrivialization.symm\u2097", "description": "A fiberwise linear inverse to `e`.", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv.is_linear", "description": "The standard local trivializations of a vector bundle constructed from core are linear.", "p": "mathlib"}, {"name": "trivialization.apply_eq_prod_continuous_linear_equiv_at", "description": "", "p": "mathlib"}, {"name": "pretrivialization.coe_linear_map_at_of_mem", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.mem_source_at", "description": "", "p": "mathlib"}, {"name": "trivialization.symm\u2097", "description": "A fiberwise linear inverse to `e`.", "p": "mathlib"}, {"name": "trivialization.symm_continuous_linear_equiv_at_eq", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.total_space_mk_preimage_source", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.vector_bundle", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_continuous_linear_map_at", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.is_open_map_proj", "description": "The projection on the base of a vector bundle created from core is an open map", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_symm_apply", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.trivialization_at_continuous_linear_map_at", "description": "", "p": "mathlib"}, {"name": "trivialization.coe_symm\u2097", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.coord_change", "description": "A randomly chosen coordinate change on a `vector_prebundle`, given by\n the field `exists_coord_change`.", "p": "mathlib"}, {"name": "trivialization.symm\u2097_linear_map_at", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.proj", "description": "The projection from the total space of a fiber bundle core, on its base.", "p": "mathlib"}, {"name": "vector_prebundle.to_fiber_prebundle", "description": "Natural identification of `vector_prebundle` as a `fiber_prebundle`.", "p": "mathlib"}, {"name": "vector_bundle_core.mem_local_triv_source", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.coord_change_apply", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.add_comm_group_fiber", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.to_fiber_bundle_core", "description": "Natural identification to a `fiber_bundle_core`.", "p": "mathlib"}, {"name": "trivialization.coord_changeL_apply", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.mem_local_triv_at_base_set", "description": "", "p": "mathlib"}, {"name": "pretrivialization.coe_linear_map_at", "description": "", "p": "mathlib"}, {"name": "trivialization.linear", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.in_coordinates_eq", "description": "rewrite `in_coordinates` using continuous linear equivalences.", "p": "mathlib"}, {"name": "trivialization.continuous_linear_equiv_at_symm_apply", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.mk_coord_change", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.triv_change", "description": "Local homeomorphism version of the trivialization change.", "p": "mathlib"}, {"name": "pretrivialization.is_linear", "description": " A mixin class for `pretrivialization`, stating that a pretrivialization is fiberwise linear with\nrespect to given module structures on its fibers and the model fiber.", "p": "mathlib"}, {"name": "pretrivialization.is_linear.linear", "description": " A mixin class for `pretrivialization`, stating that a pretrivialization is fiberwise linear with\nrespect to given module structures on its fibers and the model fiber.", "p": "mathlib"}, {"name": "trivialization.coe_linear_map_at", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv", "description": " One of the standard local trivializations of a vector bundle constructed from core, taken by\nconsidering this in particular as a fiber bundle constructed from core.", "p": "mathlib"}, {"name": "vector_bundle_core.to_topological_space", "description": " Topological structure on the total space of a vector bundle created from core, designed so\nthat all the local trivialization are continuous.", "p": "mathlib"}, {"name": "vector_prebundle.mem_trivialization_at_source", "description": "", "p": "mathlib"}, {"name": "trivialization.coe_coord_changeL", "description": "", "p": "mathlib"}, {"name": "bundle.zero_section_proj", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.linear_of_mem_pretrivialization_atlas", "description": "", "p": "mathlib"}, {"name": "pretrivialization.linear_map_at_def_of_mem", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_coord_change_eq", "description": "", "p": "mathlib"}, {"name": "vector_prebundle", "description": " This structure permits to define a vector bundle when trivializations are given as local\nequivalences but there is not yet a topology on the total space or the fibers.\nThe total space is hence given a topology in such a way that there is a fiber bundle structure for\nwhich the local equivalences are also local homeomorphisms and hence vector bundle trivializations.\nThe topology on the fibers is induced from the one on the total space.\n\nThe field `exists_coord_change` is stated as an existential statement (instead of 3 separate\nfields), since it depends on propositional information (namely `e e' \u2208 pretrivialization_atlas`).\nThis makes it inconvenient to explicitly define a `coord_change` function when constructing a\n`vector_prebundle`.", "p": "mathlib"}, {"name": "vector_prebundle.pretrivialization_atlas", "description": " This structure permits to define a vector bundle when trivializations are given as local\nequivalences but there is not yet a topology on the total space or the fibers.\nThe total space is hence given a topology in such a way that there is a fiber bundle structure for\nwhich the local equivalences are also local homeomorphisms and hence vector bundle trivializations.\nThe topology on the fibers is induced from the one on the total space.\n\nThe field `exists_coord_change` is stated as an existential statement (instead of 3 separate\nfields), since it depends on propositional information (namely `e e' \u2208 pretrivialization_atlas`).\nThis makes it inconvenient to explicitly define a `coord_change` function when constructing a\n`vector_prebundle`.", "p": "mathlib"}, {"name": "vector_prebundle.pretrivialization_linear'", "description": " This structure permits to define a vector bundle when trivializations are given as local\nequivalences but there is not yet a topology on the total space or the fibers.\nThe total space is hence given a topology in such a way that there is a fiber bundle structure for\nwhich the local equivalences are also local homeomorphisms and hence vector bundle trivializations.\nThe topology on the fibers is induced from the one on the total space.\n\nThe field `exists_coord_change` is stated as an existential statement (instead of 3 separate\nfields), since it depends on propositional information (namely `e e' \u2208 pretrivialization_atlas`).\nThis makes it inconvenient to explicitly define a `coord_change` function when constructing a\n`vector_prebundle`.", "p": "mathlib"}, {"name": "vector_prebundle.pretrivialization_at", "description": " This structure permits to define a vector bundle when trivializations are given as local\nequivalences but there is not yet a topology on the total space or the fibers.\nThe total space is hence given a topology in such a way that there is a fiber bundle structure for\nwhich the local equivalences are also local homeomorphisms and hence vector bundle trivializations.\nThe topology on the fibers is induced from the one on the total space.\n\nThe field `exists_coord_change` is stated as an existential statement (instead of 3 separate\nfields), since it depends on propositional information (namely `e e' \u2208 pretrivialization_atlas`).\nThis makes it inconvenient to explicitly define a `coord_change` function when constructing a\n`vector_prebundle`.", "p": "mathlib"}, {"name": "vector_prebundle.mem_base_pretrivialization_at", "description": " This structure permits to define a vector bundle when trivializations are given as local\nequivalences but there is not yet a topology on the total space or the fibers.\nThe total space is hence given a topology in such a way that there is a fiber bundle structure for\nwhich the local equivalences are also local homeomorphisms and hence vector bundle trivializations.\nThe topology on the fibers is induced from the one on the total space.\n\nThe field `exists_coord_change` is stated as an existential statement (instead of 3 separate\nfields), since it depends on propositional information (namely `e e' \u2208 pretrivialization_atlas`).\nThis makes it inconvenient to explicitly define a `coord_change` function when constructing a\n`vector_prebundle`.", "p": "mathlib"}, {"name": "vector_prebundle.pretrivialization_mem_atlas", "description": " This structure permits to define a vector bundle when trivializations are given as local\nequivalences but there is not yet a topology on the total space or the fibers.\nThe total space is hence given a topology in such a way that there is a fiber bundle structure for\nwhich the local equivalences are also local homeomorphisms and hence vector bundle trivializations.\nThe topology on the fibers is induced from the one on the total space.\n\nThe field `exists_coord_change` is stated as an existential statement (instead of 3 separate\nfields), since it depends on propositional information (namely `e e' \u2208 pretrivialization_atlas`).\nThis makes it inconvenient to explicitly define a `coord_change` function when constructing a\n`vector_prebundle`.", "p": "mathlib"}, {"name": "vector_prebundle.exists_coord_change", "description": " This structure permits to define a vector bundle when trivializations are given as local\nequivalences but there is not yet a topology on the total space or the fibers.\nThe total space is hence given a topology in such a way that there is a fiber bundle structure for\nwhich the local equivalences are also local homeomorphisms and hence vector bundle trivializations.\nThe topology on the fibers is induced from the one on the total space.\n\nThe field `exists_coord_change` is stated as an existential statement (instead of 3 separate\nfields), since it depends on propositional information (namely `e e' \u2208 pretrivialization_atlas`).\nThis makes it inconvenient to explicitly define a `coord_change` function when constructing a\n`vector_prebundle`.", "p": "mathlib"}, {"name": "vector_prebundle.total_space_mk_inducing", "description": " This structure permits to define a vector bundle when trivializations are given as local\nequivalences but there is not yet a topology on the total space or the fibers.\nThe total space is hence given a topology in such a way that there is a fiber bundle structure for\nwhich the local equivalences are also local homeomorphisms and hence vector bundle trivializations.\nThe topology on the fibers is induced from the one on the total space.\n\nThe field `exists_coord_change` is stated as an existential statement (instead of 3 separate\nfields), since it depends on propositional information (namely `e e' \u2208 pretrivialization_atlas`).\nThis makes it inconvenient to explicitly define a `coord_change` function when constructing a\n`vector_prebundle`.", "p": "mathlib"}, {"name": "trivialization.is_linear", "description": " A mixin class for `trivialization`, stating that a trivialization is fiberwise linear with\nrespect to given module structures on its fibers and the model fiber.", "p": "mathlib"}, {"name": "trivialization.is_linear.linear", "description": " A mixin class for `trivialization`, stating that a trivialization is fiberwise linear with\nrespect to given module structures on its fibers and the model fiber.", "p": "mathlib"}, {"name": "bundle.zero_section_snd", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.to_fiber_bundle_core_base_set", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.mem_local_triv_target", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.to_fiber_bundle_core_coord_change", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.inhabited", "description": "", "p": "mathlib"}, {"name": "trivialization.coe_linear_map_at_of_mem", "description": "", "p": "mathlib"}, {"name": "bundle.zero_section", "description": "The zero section of a vector bundle", "p": "mathlib"}, {"name": "pretrivialization.linear_map_at_symm\u2097", "description": "", "p": "mathlib"}, {"name": "trivialization.continuous_linear_map_at_apply", "description": "", "p": "mathlib"}, {"name": "pretrivialization.linear_map_at_eq_zero", "description": "", "p": "mathlib"}, {"name": "trivialization.coord_changeL", "description": "A coordinate change function between two trivializations, as a continuous linear equivalence.\n Defined to be the identity when `b` does not lie in the base set of both trivializations.", "p": "mathlib"}, {"name": "vector_prebundle.to_vector_bundle", "description": " Make a `vector_bundle` from a `vector_prebundle`.  Concretely this means\nthat, given a `vector_prebundle` structure for a sigma-type `E` -- which consists of a\nnumber of \"pretrivializations\" identifying parts of `E` with product spaces `U \u00d7 F` -- one\nestablishes that for the topology constructed on the sigma-type using\n`vector_prebundle.total_space_topology`, these \"pretrivializations\" are actually\n\"trivializations\" (i.e., homeomorphisms with respect to the constructed topology).", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_at", "description": " Preferred local trivialization of a vector bundle constructed from core, at a given point, as\na bundle trivialization", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_apply", "description": "", "p": "mathlib"}, {"name": "trivialization.symmL_continuous_linear_map_at", "description": "", "p": "mathlib"}, {"name": "trivialization.continuous_linear_map_at_symmL", "description": "", "p": "mathlib"}, {"name": "trivialization.continuous_linear_equiv_at_apply", "description": "", "p": "mathlib"}, {"name": "trivialization.symm_apply_eq_mk_continuous_linear_equiv_at_symm", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.total_space", "description": " The total space of the vector bundle, as a convenience function for dot notation.\nIt is by definition equal to `bundle.total_space Z.fiber`.", "p": "mathlib"}, {"name": "vector_bundle_core.to_fiber_bundle_core_coe", "description": "", "p": "mathlib"}, {"name": "pretrivialization.linear_equiv_at_symm_apply", "description": "", "p": "mathlib"}, {"name": "trivialization.linear_map_at_def_of_not_mem", "description": "", "p": "mathlib"}, {"name": "pretrivialization.linear", "description": "", "p": "mathlib"}, {"name": "trivial_vector_bundle_core", "description": " The trivial vector bundle core, in which all the changes of coordinates are the\nidentity.", "p": "mathlib"}, {"name": "trivialization.continuous_linear_map_at", "description": "Forward map of `continuous_linear_equiv_at` (only propositionally equal),\n defined everywhere (`0` outside domain).", "p": "mathlib"}, {"name": "trivialization.coe_continuous_linear_equiv_at_eq", "description": "", "p": "mathlib"}, {"name": "continuous_on_coord_change", "description": "", "p": "mathlib"}, {"name": "pretrivialization.linear_equiv_at_apply", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_at_apply", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.topological_space_fiber", "description": "", "p": "mathlib"}, {"name": "trivialization.coord_changeL_symm_apply", "description": "", "p": "mathlib"}, {"name": "trivialization.symm_coord_changeL", "description": "", "p": "mathlib"}, {"name": "trivialization_linear", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.trivialization_of_mem_pretrivialization_atlas", "description": " Promotion from a `trivialization` in the `pretrivialization_atlas` of a\n`vector_prebundle` to a `trivialization`.", "p": "mathlib"}, {"name": "vector_bundle_core.base", "description": "The base space of a vector bundle core, as a convenience function for dot notation", "p": "mathlib"}, {"name": "vector_bundle_core.coord_change_linear_comp", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.fiber", "description": " The fiber of a vector bundle core, as a convenience function for dot notation and\ntypeclass inference", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_symm_fst", "description": "", "p": "mathlib"}, {"name": "pretrivialization.linear_equiv_at", "description": " A pretrivialization for a vector bundle defines linear equivalences between the\nfibers and the model space.", "p": "mathlib"}, {"name": "vector_prebundle.total_space_topology", "description": "Topology on the total space that will make the prebundle into a bundle.", "p": "mathlib"}, {"name": "trivialization.symmL_apply", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.trivialization_at_coord_change_eq", "description": "", "p": "mathlib"}, {"name": "trivialization.linear_map_at_apply", "description": "", "p": "mathlib"}, {"name": "trivialization.continuous_linear_equiv_at", "description": " In a vector bundle, a trivialization in the fiber (which is a priori only linear)\nis in fact a continuous linear equiv between the fibers and the model fiber.", "p": "mathlib"}, {"name": "trivialization.coord_changeL_apply'", "description": " A version of `coord_change_apply` that fully unfolds `coord_change`. The right-hand side is\nugly, but has good definitional properties for specifically defined trivializations.", "p": "mathlib"}, {"name": "trivialization.to_pretrivialization.is_linear", "description": "", "p": "mathlib"}, {"name": "vector_prebundle.to_fiber_bundle", "description": " Make a `fiber_bundle` from a `vector_prebundle`; auxiliary construction for\n`vector_prebundle.vector_bundle`.", "p": "mathlib"}, {"name": "vector_bundle_core.index", "description": "The index set of a vector bundle core, as a convenience function for dot notation", "p": "mathlib"}, {"name": "pretrivialization.symm\u2097_linear_map_at", "description": "", "p": "mathlib"}, {"name": "pretrivialization.linear_map_at_apply", "description": "", "p": "mathlib"}, {"name": "trivialization.linear_equiv_at_symm_apply", "description": "", "p": "mathlib"}, {"name": "pretrivialization.linear_map_at", "description": "A fiberwise linear map equal to `e` on `e.base_set`.", "p": "mathlib"}, {"name": "trivialization.linear_map_at", "description": "A fiberwise linear map equal to `e` on `e.base_set`.", "p": "mathlib"}, {"name": "vector_bundle_core.continuous_proj", "description": "The projection on the base of a vector bundle created from core is continuous", "p": "mathlib"}, {"name": "vector_prebundle.continuous_total_space_mk", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.coe_coord_change", "description": "", "p": "mathlib"}, {"name": "trivialization.coe_coord_changeL'", "description": "", "p": "mathlib"}, {"name": "trivialization.continuous_linear_equiv_at_apply'", "description": "", "p": "mathlib"}, {"name": "trivialization.linear_equiv_at", "description": " A trivialization for a vector bundle defines linear equivalences between the\nfibers and the model space.", "p": "mathlib"}, {"name": "vector_prebundle.continuous_on_coord_change", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.fiber_bundle", "description": "", "p": "mathlib"}, {"name": "trivialization.linear_map_at_symm\u2097", "description": "", "p": "mathlib"}, {"name": "trivialization.mk_coord_changeL", "description": "", "p": "mathlib"}, {"name": "trivialization.comp_continuous_linear_equiv_at_eq_coord_change", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.trivialization_at_symmL", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.in_coordinates", "description": " When `\u03d5` is a continuous (semi)linear map between the fibers `E x` and `E' y` of two vector\nbundles `E` and `E'`, `continuous_linear_map.in_coordinates F E F' E' x\u2080 x y\u2080 y \u03d5` is a coordinate\nchange of this continuous linear map w.r.t. the chart around `x\u2080` and the chart around `y\u2080`.\n\nIt is defined by composing `\u03d5` with appropriate coordinate changes given by the vector bundles\n`E` and `E'`.\nWe use the operations `trivialization.continuous_linear_map_at` and `trivialization.symmL` in the\ndefinition, instead of `trivialization.continuous_linear_equiv_at`, so that\n`continuous_linear_map.in_coordinates` is defined everywhere (but see\n`continuous_linear_map.in_coordinates_eq`).\n\nThis is the (second component of the) underlying function of a trivialization of the hom-bundle\n(see `hom_trivialization_at_apply`). However, note that `continuous_linear_map.in_coordinates` is\ndefined even when `x` and `y` live in different base sets.\nTherefore, it is is also convenient when working with the hom-bundle between pulled back bundles.", "p": "mathlib"}, {"name": "trivialization.symmL", "description": "Backwards map of `continuous_linear_equiv_at`, defined everywhere.", "p": "mathlib"}, {"name": "vector_bundle_core.local_triv_at_def", "description": "", "p": "mathlib"}, {"name": "trivialization.zero_section", "description": "", "p": "mathlib"}, {"name": "pretrivialization.symm\u2097_apply", "description": "", "p": "mathlib"}, {"name": "trivialization.apply_symm_apply_eq_coord_changeL", "description": "", "p": "mathlib"}, {"name": "vector_bundle", "description": " The space `total_space F E` (for `E : B \u2192 Type*` such that each `E x` is a topological vector\nspace) has a topological vector space structure with fiber `F` (denoted with\n`vector_bundle R F E`) if around every point there is a fiber bundle trivialization\nwhich is linear in the fibers.", "p": "mathlib"}, {"name": "vector_bundle.trivialization_linear'", "description": " The space `total_space F E` (for `E : B \u2192 Type*` such that each `E x` is a topological vector\nspace) has a topological vector space structure with fiber `F` (denoted with\n`vector_bundle R F E`) if around every point there is a fiber bundle trivialization\nwhich is linear in the fibers.", "p": "mathlib"}, {"name": "vector_bundle.continuous_on_coord_change'", "description": " The space `total_space F E` (for `E : B \u2192 Type*` such that each `E x` is a topological vector\nspace) has a topological vector space structure with fiber `F` (denoted with\n`vector_bundle R F E`) if around every point there is a fiber bundle trivialization\nwhich is linear in the fibers.", "p": "mathlib"}, {"name": "vector_bundle_core.to_fiber_bundle_core_index_at", "description": "", "p": "mathlib"}, {"name": "vector_bundle_core.add_comm_monoid_fiber", "description": "", "p": "mathlib"}, {"name": "finset.gcd_eq_gcd_filter_ne_zero", "description": "", "p": "mathlib"}, {"name": "finset.lcm_def", "description": "", "p": "mathlib"}, {"name": "finset.gcd_mul_left", "description": "", "p": "mathlib"}, {"name": "finset.lcm_dvd_iff", "description": "", "p": "mathlib"}, {"name": "finset.gcd_def", "description": "", "p": "mathlib"}, {"name": "finset.normalize_lcm", "description": "", "p": "mathlib"}, {"name": "finset.normalize_gcd", "description": "", "p": "mathlib"}, {"name": "finset.lcm_eq_lcm_image", "description": "", "p": "mathlib"}, {"name": "finset.gcd_mono_fun", "description": "", "p": "mathlib"}, {"name": "finset.dvd_gcd", "description": "", "p": "mathlib"}, {"name": "finset.gcd_image", "description": "", "p": "mathlib"}, {"name": "finset.lcm_mono", "description": "", "p": "mathlib"}, {"name": "finset.gcd_union", "description": "", "p": "mathlib"}, {"name": "finset.extract_gcd", "description": "", "p": "mathlib"}, {"name": "finset.lcm_union", "description": "", "p": "mathlib"}, {"name": "finset.extract_gcd'", "description": "", "p": "mathlib"}, {"name": "finset.lcm_insert", "description": "", "p": "mathlib"}, {"name": "finset.gcd", "description": "Greatest common divisor of a finite set", "p": "mathlib"}, {"name": "finset.lcm_image", "description": "", "p": "mathlib"}, {"name": "finset.gcd_mul_right", "description": "", "p": "mathlib"}, {"name": "finset.gcd_eq_of_dvd_sub", "description": "", "p": "mathlib"}, {"name": "finset.gcd_mono", "description": "", "p": "mathlib"}, {"name": "finset.lcm", "description": "Least common multiple of a finite set", "p": "mathlib"}, {"name": "finset.lcm_singleton", "description": "", "p": "mathlib"}, {"name": "finset.gcd_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "finset.gcd_dvd", "description": "", "p": "mathlib"}, {"name": "finset.gcd_congr", "description": "", "p": "mathlib"}, {"name": "finset.lcm_congr", "description": "", "p": "mathlib"}, {"name": "finset.lcm_empty", "description": "", "p": "mathlib"}, {"name": "finset.lcm_dvd", "description": "", "p": "mathlib"}, {"name": "finset.gcd_empty", "description": "", "p": "mathlib"}, {"name": "finset.gcd_singleton", "description": "", "p": "mathlib"}, {"name": "finset.dvd_gcd_iff", "description": "", "p": "mathlib"}, {"name": "finset.gcd_insert", "description": "", "p": "mathlib"}, {"name": "finset.gcd_eq_gcd_image", "description": "", "p": "mathlib"}, {"name": "finset.dvd_lcm", "description": "", "p": "mathlib"}, {"name": "finset.lcm_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "finset.lcm_mono_fun", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.monotone", "description": "A functor between preorder categories is monotone.", "p": "mathlib"}, {"name": "category_theory.le_of_hom_hom_of_le", "description": "", "p": "mathlib"}, {"name": "category_theory.unique_to_top", "description": "", "p": "mathlib"}, {"name": "monotone.functor", "description": "A monotone function between preorders induces a functor between the associated categories.", "p": "mathlib"}, {"name": "category_theory.equivalence.to_order_iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.hom_of_le", "description": "Express an inequality as a morphism in the corresponding preorder category.", "p": "mathlib"}, {"name": "category_theory.hom_of_le_refl", "description": "", "p": "mathlib"}, {"name": "category_theory.unique_from_bot", "description": "", "p": "mathlib"}, {"name": "quiver.hom.le", "description": "**Alias** of `category_theory.le_of_hom`.", "p": "mathlib"}, {"name": "category_theory.equivalence.to_order_iso", "description": "A categorical equivalence between partial orders is just an order isomorphism.", "p": "mathlib"}, {"name": "category_theory.op_hom_of_le", "description": "Construct a morphism in the opposite of a preorder category from an inequality.", "p": "mathlib"}, {"name": "category_theory.le_of_op_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.hom_of_le_le_of_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.hom_of_le_comp", "description": "", "p": "mathlib"}, {"name": "has_le.le.hom", "description": "**Alias** of `category_theory.hom_of_le`.", "p": "mathlib"}, {"name": "monotone.functor_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.equivalence.to_order_iso_apply", "description": "", "p": "mathlib"}, {"name": "preorder.small_category", "description": "The category structure coming from a preorder. There is a morphism `X \u27f6 Y` if and only if `X \u2264 Y`.\n\nBecause we don't allow morphisms to live in `Prop`,\nwe have to define `X \u27f6 Y` as `ulift (plift (X \u2264 Y))`.\nSee `category_theory.hom_of_le` and `category_theory.le_of_hom`.\n\nSee <https://stacks.math.columbia.edu/tag/00D3>.", "p": "mathlib"}, {"name": "category_theory.iso.to_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.le_of_hom", "description": "Extract the underlying inequality from a morphism in a preorder category.", "p": "mathlib"}, {"name": "first_order.language.order.relations.subsingleton", "description": "", "p": "mathlib"}, {"name": "first_order.language.is_ordered", "description": "A language is ordered if it has a symbol representing `\u2264`.", "p": "mathlib"}, {"name": "first_order.language.is_ordered.le_symb", "description": "A language is ordered if it has a symbol representing `\u2264`.", "p": "mathlib"}, {"name": "first_order.language.term.realize_lt", "description": "", "p": "mathlib"}, {"name": "first_order.language.term.realize_le", "description": "", "p": "mathlib"}, {"name": "first_order.language.realize_densely_ordered_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.realize_no_bot_order", "description": "", "p": "mathlib"}, {"name": "first_order.language.realize_no_top_order", "description": "", "p": "mathlib"}, {"name": "first_order.language.sum.is_ordered", "description": "", "p": "mathlib"}, {"name": "first_order.language.order.first_order.language.is_relational", "description": "", "p": "mathlib"}, {"name": "first_order.language.model_partial_order", "description": "", "p": "mathlib"}, {"name": "first_order.language.DLO", "description": "The theory of dense linear orders without endpoints.", "p": "mathlib"}, {"name": "first_order.language.densely_ordered_sentence", "description": " A sentence indicating that an order is dense:\n$\\forall x, \\forall y, x < y \\to \\exists z, x < z \\wedge z < y$.", "p": "mathlib"}, {"name": "first_order.language.realize_no_bot_order_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.linear_order_theory", "description": "The theory of linear orders.", "p": "mathlib"}, {"name": "first_order.language.ordered_structure_has_le", "description": "", "p": "mathlib"}, {"name": "first_order.language.model_preorder", "description": "", "p": "mathlib"}, {"name": "first_order.language.order.is_ordered", "description": "", "p": "mathlib"}, {"name": "first_order.language.no_bot_order_sentence", "description": " A sentence indicating that an order has no bottom element:\n$\\forall x, \\exists y, \\neg x \\le y$.", "p": "mathlib"}, {"name": "first_order.language.model_linear_order", "description": "", "p": "mathlib"}, {"name": "first_order.language.ordered_structure_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.ordered_structure", "description": "A structure is ordered if its language has a `\u2264` symbol whose interpretation is", "p": "mathlib"}, {"name": "first_order.language.term.lt", "description": "Joins two terms `t\u2081, t\u2082` in a formula representing `t\u2081 < t\u2082`.", "p": "mathlib"}, {"name": "first_order.language.order", "description": "The language consisting of a single relation representing `\u2264`.", "p": "mathlib"}, {"name": "first_order.language.preorder_theory", "description": "The theory of preorders.", "p": "mathlib"}, {"name": "first_order.language.partial_order_theory", "description": "The theory of partial orders.", "p": "mathlib"}, {"name": "first_order.language.model_DLO", "description": "", "p": "mathlib"}, {"name": "first_order.language.order_Structure", "description": "", "p": "mathlib"}, {"name": "first_order.language.realize_densely_ordered", "description": "", "p": "mathlib"}, {"name": "first_order.language.term.le", "description": "Joins two terms `t\u2081, t\u2082` in a formula representing `t\u2081 \u2264 t\u2082`.", "p": "mathlib"}, {"name": "first_order.language.rel_map_le_symb", "description": "", "p": "mathlib"}, {"name": "first_order.language.realize_no_top_order_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.order_Lhom", "description": "The language homomorphism sending the unique symbol `\u2264` of `language.order` to `\u2264` in an ordered\nlanguage.", "p": "mathlib"}, {"name": "first_order.language.order_Lhom_order", "description": "", "p": "mathlib"}, {"name": "first_order.language.order_Lhom_le_symb", "description": "", "p": "mathlib"}, {"name": "first_order.language.no_top_order_sentence", "description": " A sentence indicating that an order has no top element:\n$\\forall x, \\exists y, \\neg y \\le x$.", "p": "mathlib"}, {"name": "nat.even_odd_rec_even", "description": "", "p": "mathlib"}, {"name": "nat.even_odd_rec", "description": " Recursion principle on even and odd numbers: if we have `P 0`, and for all `i : \u2115` we can\nextend from `P i` to both `P (2 * i)` and `P (2 * i + 1)`, then we have `P n` for all `n : \u2115`.\nThis is nothing more than a wrapper around `nat.binary_rec`, to avoid having to switch to\ndealing with `bit0` and `bit1`.", "p": "mathlib"}, {"name": "nat.even_odd_rec_odd", "description": "", "p": "mathlib"}, {"name": "nat.even_odd_rec_zero", "description": "", "p": "mathlib"}, {"name": "quot.induction_on\u2082", "description": "", "p": "mathlib"}, {"name": "quot.lift_on.decidable", "description": "", "p": "mathlib"}, {"name": "trunc.nonempty", "description": "", "p": "mathlib"}, {"name": "quotient.lift_on'.decidable", "description": "", "p": "mathlib"}, {"name": "quotient.induction_on_pi", "description": "", "p": "mathlib"}, {"name": "setoid.ext", "description": "", "p": "mathlib"}, {"name": "quotient.ind'", "description": " A version of `quotient.ind` taking `{s : setoid \u03b1}` as an implicit argument instead of an\ninstance argument.", "p": "mathlib"}, {"name": "quotient.subsingleton", "description": "", "p": "mathlib"}, {"name": "quot.surjective_lift", "description": "", "p": "mathlib"}, {"name": "quotient.hrec_on\u2082'_mk'", "description": "", "p": "mathlib"}, {"name": "quotient.lift_on'_mk", "description": "", "p": "mathlib"}, {"name": "quotient.map'_mk", "description": "", "p": "mathlib"}, {"name": "quotient.lift_on'_mk'", "description": "", "p": "mathlib"}, {"name": "trunc.rec", "description": "Recursion/induction principle for `trunc`.", "p": "mathlib"}, {"name": "quotient.map\u2082'_mk'", "description": "", "p": "mathlib"}, {"name": "quotient.map", "description": " Map a function `f : \u03b1 \u2192 \u03b2` that sends equivalent elements to equivalent elements\nto a function `quotient sa \u2192 quotient sb`. Useful to define unary operations on quotients.", "p": "mathlib"}, {"name": "quot.lift\u2082_mk", "description": "", "p": "mathlib"}, {"name": "quotient.lift_on_mk", "description": "", "p": "mathlib"}, {"name": "trunc.mk", "description": "Constructor for `trunc \u03b1`", "p": "mathlib"}, {"name": "quotient.rec_on_subsingleton'", "description": " A version of `quotient.rec_on_subsingleton` taking `{s\u2081 : setoid \u03b1}` as an implicit argument\ninstead of an instance argument.", "p": "mathlib"}, {"name": "quot.map\u2082", "description": " Descends a function `f : \u03b1 \u2192 \u03b2 \u2192 \u03b3` to quotients of `\u03b1` and `\u03b2` wih values in a quotient of\n`\u03b3`.", "p": "mathlib"}, {"name": "quot.induction_on\u2083", "description": "", "p": "mathlib"}, {"name": "quotient.map_mk", "description": "", "p": "mathlib"}, {"name": "quotient.choice_eq", "description": "", "p": "mathlib"}, {"name": "quotient.lift_mk", "description": "", "p": "mathlib"}, {"name": "trunc.lift", "description": "Any constant function lifts to a function out of the truncation", "p": "mathlib"}, {"name": "quotient.exact'", "description": "", "p": "mathlib"}, {"name": "quot.out", "description": "Choose an element of the equivalence class using the axiom of choice.\n Sound but noncomputable.", "p": "mathlib"}, {"name": "quotient.lift\u2082.decidable_pred", "description": "Note that this provides `decidable_rel (quotient.lift\u2082 f h)` when `\u03b1 = \u03b2`.", "p": "mathlib"}, {"name": "trunc", "description": "`trunc \u03b1` is the quotient of `\u03b1` by the always-true relation. This\n is related to the propositional truncation in HoTT, and is similar\n in effect to `nonempty \u03b1`, but unlike `nonempty \u03b1`, `trunc \u03b1` is data,\n so the VM representation is the same as `\u03b1`, and so this can be used to\n maintain computability.", "p": "mathlib"}, {"name": "quot.unquot", "description": "Unwrap the VM representation of a quotient to obtain an element of the equivalence class.\n Computable but unsound.", "p": "mathlib"}, {"name": "quotient.map'_mk'", "description": "", "p": "mathlib"}, {"name": "quotient.map\u2082", "description": " Map a function `f : \u03b1 \u2192 \u03b2 \u2192 \u03b3` that sends equivalent elements to equivalent elements\nto a function `f : quotient sa \u2192 quotient sb \u2192 quotient sc`.\nUseful to define binary operations on quotients.", "p": "mathlib"}, {"name": "quotient.surjective_lift_on'", "description": "", "p": "mathlib"}, {"name": "surjective_quot_mk", "description": "`quot.mk r` is a surjective function.", "p": "mathlib"}, {"name": "quotient.mk_out", "description": "", "p": "mathlib"}, {"name": "quotient.sound'", "description": "", "p": "mathlib"}, {"name": "quotient.out_eq'", "description": "", "p": "mathlib"}, {"name": "quotient.ind\u2082'", "description": " A version of `quotient.ind\u2082` taking `{s\u2081 : setoid \u03b1} {s\u2082 : setoid \u03b2}` as implicit arguments\ninstead of instance arguments.", "p": "mathlib"}, {"name": "quotient.map\u2082_mk", "description": "", "p": "mathlib"}, {"name": "quotient.map'", "description": " Map a function `f : \u03b1 \u2192 \u03b2` that sends equivalent elements to equivalent elements\nto a function `quotient sa \u2192 quotient sb`. Useful to define unary operations on quotients.", "p": "mathlib"}, {"name": "quotient.lift_on\u2082'_mk", "description": "", "p": "mathlib"}, {"name": "quotient.induction_on\u2082'", "description": " A version of `quotient.induction_on\u2082` taking `{s\u2081 : setoid \u03b1} {s\u2082 : setoid \u03b2}` as implicit\narguments instead of instance arguments.", "p": "mathlib"}, {"name": "pi_setoid", "description": "", "p": "mathlib"}, {"name": "trunc.inhabited", "description": "", "p": "mathlib"}, {"name": "trunc.out", "description": "Noncomputably extract a representative of `trunc \u03b1` (using the axiom of choice).", "p": "mathlib"}, {"name": "surjective_quotient_mk", "description": "`quotient.mk` is a surjective function.", "p": "mathlib"}, {"name": "quotient.eq_mk_iff_out", "description": "", "p": "mathlib"}, {"name": "quotient.lift.decidable_pred", "description": "", "p": "mathlib"}, {"name": "true_equivalence", "description": "", "p": "mathlib"}, {"name": "quotient.out_injective", "description": "", "p": "mathlib"}, {"name": "quotient.out'", "description": " A version of `quotient.out` taking `{s\u2081 : setoid \u03b1}` as an implicit argument instead of an\ninstance argument.", "p": "mathlib"}, {"name": "quot.inhabited", "description": "", "p": "mathlib"}, {"name": "quot.lift_on\u2082.decidable", "description": "", "p": "mathlib"}, {"name": "quotient.hrec_on'", "description": "Recursion on a `quotient` argument `a`, result type depends on `\u27e6a\u27e7`.", "p": "mathlib"}, {"name": "trunc.monad", "description": "", "p": "mathlib"}, {"name": "quotient.lift_on\u2082'.decidable", "description": "", "p": "mathlib"}, {"name": "quotient.eq'", "description": "", "p": "mathlib"}, {"name": "quotient.lift_on.decidable", "description": "", "p": "mathlib"}, {"name": "quot.factor", "description": "Weaken the relation of a quotient. This is the same as `quot.map id`.", "p": "mathlib"}, {"name": "nonempty_quotient_iff", "description": "", "p": "mathlib"}, {"name": "quotient.surjective_quotient_mk'", "description": "`quotient.mk'` is a surjective function.", "p": "mathlib"}, {"name": "quotient.out_inj", "description": "", "p": "mathlib"}, {"name": "quotient.choice", "description": " Given a function `f : \u03a0 i, quotient (S i)`, returns the class of functions `\u03a0 i, \u03b1 i` sending\neach `i` to an element of the class `f i`.", "p": "mathlib"}, {"name": "trunc.rec_on", "description": "A version of `trunc.rec` taking `q : trunc \u03b1` as the first argument.", "p": "mathlib"}, {"name": "quotient.rec_on_subsingleton\u2082'", "description": " A version of `quotient.rec_on_subsingleton\u2082` taking `{s\u2081 : setoid \u03b1} {s\u2082 : setoid \u03b1}`\nas implicit arguments instead of instance arguments.", "p": "mathlib"}, {"name": "quot.lift_on\u2082_mk", "description": "", "p": "mathlib"}, {"name": "quotient.lift_comp_mk", "description": "", "p": "mathlib"}, {"name": "quot.factor_mk_eq", "description": "", "p": "mathlib"}, {"name": "quot.map", "description": " Map a function `f : \u03b1 \u2192 \u03b2` such that `ra x y` implies `rb (f x) (f y)`\nto a map `quot ra \u2192 quot rb`.", "p": "mathlib"}, {"name": "quotient.mk_out'", "description": "", "p": "mathlib"}, {"name": "trunc.bind", "description": "The `bind` operator for the `trunc` monad.", "p": "mathlib"}, {"name": "quotient.lift_on\u2082.decidable", "description": "", "p": "mathlib"}, {"name": "trunc.rec_on_subsingleton", "description": "A version of `trunc.rec_on` assuming the codomain is a `subsingleton`.", "p": "mathlib"}, {"name": "quot.map_right", "description": "If `ra` is a subrelation of `ra'`, then we have a natural map `quot ra \u2192 quot ra'`.", "p": "mathlib"}, {"name": "quot.rec_on_subsingleton\u2082", "description": "A binary version of `quot.rec_on_subsingleton`.", "p": "mathlib"}, {"name": "quot.lift_mk", "description": "**Alias** of `quot.lift_beta`.", "p": "mathlib"}, {"name": "forall_quotient_iff", "description": "", "p": "mathlib"}, {"name": "true_setoid", "description": " Always-true relation as a `setoid`.\n\nNote that in later files the preferred spelling is `\u22a4 : setoid \u03b1`.", "p": "mathlib"}, {"name": "quot.lift_on_mk", "description": "", "p": "mathlib"}, {"name": "quotient.lift\u2082_mk", "description": "", "p": "mathlib"}, {"name": "quotient.mk_eq_iff_out", "description": "", "p": "mathlib"}, {"name": "quotient.map\u2082'", "description": "A version of `quotient.map\u2082` using curly braces and unification.", "p": "mathlib"}, {"name": "quot.lift_on\u2082", "description": "Descends a function `f : \u03b1 \u2192 \u03b2 \u2192 \u03b3` to quotients of `\u03b1` and `\u03b2` and applies it.", "p": "mathlib"}, {"name": "quotient.mk'", "description": " A version of `quotient.mk` taking `{s : setoid \u03b1}` as an implicit argument instead of an\ninstance argument.", "p": "mathlib"}, {"name": "quot.lift\u2082.decidable_pred", "description": "Note that this provides `decidable_rel (quot.lift\u2082 f ha hb)` when `\u03b1 = \u03b2`.", "p": "mathlib"}, {"name": "trunc.map", "description": "A function `f : \u03b1 \u2192 \u03b2` defines a function `map f : trunc \u03b1 \u2192 trunc \u03b2`.", "p": "mathlib"}, {"name": "quot.eq", "description": "", "p": "mathlib"}, {"name": "trunc.out_eq", "description": "", "p": "mathlib"}, {"name": "quot.lift\u2082", "description": "Descends a function `f : \u03b1 \u2192 \u03b2 \u2192 \u03b3` to quotients of `\u03b1` and `\u03b2`.", "p": "mathlib"}, {"name": "trunc.ind", "description": "", "p": "mathlib"}, {"name": "trunc.eq", "description": "", "p": "mathlib"}, {"name": "quotient.hrec_on'_mk'", "description": "", "p": "mathlib"}, {"name": "quotient.lift_on\u2082'", "description": " A version of `quotient.lift_on\u2082` taking `{s\u2081 : setoid \u03b1} {s\u2082 : setoid \u03b2}` as implicit arguments\ninstead of instance arguments.", "p": "mathlib"}, {"name": "quotient.lift_on\u2082_mk", "description": "", "p": "mathlib"}, {"name": "quotient.inhabited", "description": "", "p": "mathlib"}, {"name": "trunc.subsingleton", "description": "", "p": "mathlib"}, {"name": "quotient.hrec_on\u2082", "description": "Induction on two `quotient` arguments `a` and `b`, result type depends on `\u27e6a\u27e7` and `\u27e6b\u27e7`.", "p": "mathlib"}, {"name": "quotient.out_eq", "description": "", "p": "mathlib"}, {"name": "quot.subsingleton", "description": "", "p": "mathlib"}, {"name": "quot.map\u2082_mk", "description": "", "p": "mathlib"}, {"name": "quotient.lift_on'", "description": " A version of `quotient.lift_on` taking `{s : setoid \u03b1}` as an implicit argument instead of an\ninstance argument.", "p": "mathlib"}, {"name": "trunc.exists_rep", "description": "", "p": "mathlib"}, {"name": "quotient.lift_on\u2082'_mk'", "description": "", "p": "mathlib"}, {"name": "trunc.induction_on\u2082", "description": "", "p": "mathlib"}, {"name": "quot.out_eq", "description": "", "p": "mathlib"}, {"name": "quotient.out_equiv_out", "description": "", "p": "mathlib"}, {"name": "quotient.has_equiv.equiv.is_equiv", "description": "", "p": "mathlib"}, {"name": "trunc.is_lawful_monad", "description": "", "p": "mathlib"}, {"name": "trunc.lift_on", "description": "Lift a constant function on `q : trunc \u03b1`.", "p": "mathlib"}, {"name": "quotient.eq", "description": "", "p": "mathlib"}, {"name": "trunc.induction_on", "description": "", "p": "mathlib"}, {"name": "quotient.induction_on'", "description": " A version of `quotient.induction_on` taking `{s : setoid \u03b1}` as an implicit argument instead\nof an instance argument.", "p": "mathlib"}, {"name": "quot.lift.decidable_pred", "description": "", "p": "mathlib"}, {"name": "quotient.induction_on\u2083'", "description": " A version of `quotient.induction_on\u2083` taking `{s\u2081 : setoid \u03b1} {s\u2082 : setoid \u03b2} {s\u2083 : setoid \u03b3}`\nas implicit arguments instead of instance arguments.", "p": "mathlib"}, {"name": "quotient.out", "description": "Choose an element of the equivalence class using the axiom of choice.\n Sound but noncomputable.", "p": "mathlib"}, {"name": "quot.hrec_on\u2082", "description": "Recursion on two `quotient` arguments `a` and `b`, result type depends on `\u27e6a\u27e7` and `\u27e6b\u27e7`.", "p": "mathlib"}, {"name": "quotient.mk'_eq_mk", "description": "", "p": "mathlib"}, {"name": "quotient.hrec_on\u2082'", "description": "Recursion on two `quotient` arguments `a` and `b`, result type depends on `\u27e6a\u27e7` and `\u27e6b\u27e7`.", "p": "mathlib"}, {"name": "trunc.lift_mk", "description": "", "p": "mathlib"}, {"name": "konigsberg.adj.decidable_rel", "description": "", "p": "mathlib-archive"}, {"name": "konigsberg.edges", "description": " Each of the connections between the islands/mainlands and the bridges.\nThese are ordered pairs, but the data becomes symmetric in `konigsberg.adj`.", "p": "mathlib-archive"}, {"name": "konigsberg.graph", "description": " The K\u00f6nigsberg graph structure. While the K\u00f6nigsberg bridge problem\nis usually described using a multigraph, the we use a \"mediant\" construction\nto transform it into a simple graph -- every edge in the multigraph is subdivided\ninto a path of two edges. This construction preserves whether a graph is Eulerian.\n\n(TODO: once mathlib has multigraphs, either prove the mediant construction preserves the\nEulerian property or switch this file to use multigraphs.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.fintype", "description": "", "p": "mathlib-archive"}, {"name": "konigsberg.graph_adj", "description": "", "p": "mathlib-archive"}, {"name": "konigsberg.verts.decidable_eq", "description": "", "p": "mathlib-archive"}, {"name": "konigsberg.adj", "description": "The adjacency relation for the K\u00f6nigsberg graph.", "p": "mathlib-archive"}, {"name": "konigsberg.verts", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.V1", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.V2", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.V3", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.V4", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.B1", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.B2", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.B3", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.B4", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.B5", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.B6", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.verts.B7", "description": " The vertices for the K\u00f6nigsberg graph; four vertices for the bodies of land and seven\nvertices for the bridges.", "p": "mathlib-archive"}, {"name": "konigsberg.not_is_eulerian", "description": "The K\u00f6nigsberg graph is not Eulerian.", "p": "mathlib-archive"}, {"name": "konigsberg.degree_eq_degree", "description": "", "p": "mathlib-archive"}, {"name": "konigsberg.degree", "description": " To speed up the proof, this is a cache of all the degrees of each vertex,\nproved in `konigsberg.degree_eq_degree`.", "p": "mathlib-archive"}, {"name": "free_algebra.pre", "description": "This inductive type is used to express representatives of the free algebra.", "p": "mathlib"}, {"name": "free_algebra.pre.of", "description": "This inductive type is used to express representatives of the free algebra.", "p": "mathlib"}, {"name": "free_algebra.pre.of_scalar", "description": "This inductive type is used to express representatives of the free algebra.", "p": "mathlib"}, {"name": "free_algebra.pre.add", "description": "This inductive type is used to express representatives of the free algebra.", "p": "mathlib"}, {"name": "free_algebra.pre.mul", "description": "This inductive type is used to express representatives of the free algebra.", "p": "mathlib"}, {"name": "free_algebra.pre.has_coe_semiring", "description": "Coercion from `R` to `pre R X`. Note: Used for notation only.", "p": "mathlib"}, {"name": "free_algebra.equiv_monoid_algebra_free_monoid", "description": "The free algebra on `X` is \"just\" the monoid algebra on the free monoid on `X`.\n\nThis would be useful when constructing linear maps out of a free algebra,\nfor example.", "p": "mathlib"}, {"name": "free_algebra.lift_aux_eq", "description": "", "p": "mathlib"}, {"name": "free_algebra.induction", "description": " An induction principle for the free algebra.\n\nIf `C` holds for the `algebra_map` of `r : R` into `free_algebra R X`, the `\u03b9` of `x : X`, and is\npreserved under addition and muliplication, then it holds for all of `free_algebra R X`.", "p": "mathlib"}, {"name": "free_algebra.\u03b9", "description": "The canonical function `X \u2192 free_algebra R X`.", "p": "mathlib"}, {"name": "free_algebra.\u03b9_injective", "description": "", "p": "mathlib"}, {"name": "free_algebra.\u03b9_inj", "description": "", "p": "mathlib"}, {"name": "free_algebra.\u03b9_ne_one", "description": "", "p": "mathlib"}, {"name": "free_algebra.hom_ext", "description": "See note [partially-applied ext lemmas].", "p": "mathlib"}, {"name": "free_algebra.lift_unique", "description": "", "p": "mathlib"}, {"name": "free_algebra.algebra_map_left_inverse", "description": "", "p": "mathlib"}, {"name": "free_algebra.lift_fun", "description": "Given a function from `X` to an `R`-algebra `A`, `lift_fun` provides a lift of `f` to a function\nfrom `pre R X` to `A`. This is mainly used in the construction of `free_algebra.lift`.", "p": "mathlib"}, {"name": "free_algebra.\u03b9_ne_algebra_map", "description": "", "p": "mathlib"}, {"name": "free_algebra.lift_\u03b9_apply", "description": "", "p": "mathlib"}, {"name": "free_algebra.pre.has_mul", "description": "Multiplication in `pre R X` defined as `pre.mul`. Note: Used for notation only.", "p": "mathlib"}, {"name": "free_algebra.inhabited", "description": "", "p": "mathlib"}, {"name": "free_algebra.pre.has_smul", "description": "Scalar multiplication defined as multiplication by the image of elements from `R`.\nNote: Used for notation only.", "p": "mathlib"}, {"name": "free_algebra.pre.has_coe_generator", "description": "Coercion from `X` to `pre R X`. Note: Used for notation only.", "p": "mathlib"}, {"name": "free_algebra.\u03b9_ne_zero", "description": "", "p": "mathlib"}, {"name": "free_algebra.pre.has_zero", "description": "Zero in `pre R X` defined as the image of `0` from `R`. Note: Used for notation only.", "p": "mathlib"}, {"name": "free_algebra.lift_symm_apply", "description": "", "p": "mathlib"}, {"name": "free_algebra.nontrivial", "description": "", "p": "mathlib"}, {"name": "free_algebra.algebra_map_eq_one_iff", "description": "", "p": "mathlib"}, {"name": "free_algebra.has_smul", "description": "", "p": "mathlib"}, {"name": "free_algebra.algebra_map_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "free_algebra.pre.has_one", "description": "One in `pre R X` defined as the image of `1` from `R`. Note: Used for notation only.", "p": "mathlib"}, {"name": "free_algebra.algebra", "description": "", "p": "mathlib"}, {"name": "free_algebra.lift_comp_\u03b9", "description": "", "p": "mathlib"}, {"name": "free_algebra.algebra_map_inv", "description": "The left-inverse of `algebra_map`.", "p": "mathlib"}, {"name": "free_algebra.ring", "description": "", "p": "mathlib"}, {"name": "free_algebra.pre.has_add", "description": "Addition in `pre R X` defined as `pre.add`. Note: Used for notation only.", "p": "mathlib"}, {"name": "free_algebra.semiring", "description": "", "p": "mathlib"}, {"name": "free_algebra.rel", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.add_scalar", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.mul_scalar", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.central_scalar", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.add_assoc", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.add_comm", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.zero_add", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.mul_assoc", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.one_mul", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.mul_one", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.left_distrib", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.right_distrib", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.zero_mul", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.mul_zero", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.add_compat_left", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.add_compat_right", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.mul_compat_left", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.rel.mul_compat_right", "description": "An inductively defined relation on `pre R X` used to force the initial algebra structure on\nthe associated quotient.", "p": "mathlib"}, {"name": "free_algebra.lift", "description": "Given a function `f : X \u2192 A` where `A` is an `R`-algebra, `lift R f` is the unique lift\nof `f` to a morphism of `R`-algebras `free_algebra R X \u2192 A`.", "p": "mathlib"}, {"name": "free_algebra.algebra_map_inj", "description": "", "p": "mathlib"}, {"name": "free_algebra", "description": "The free algebra for the type `X` over the commutative semiring `R`.", "p": "mathlib"}, {"name": "free_algebra.quot_mk_eq_\u03b9", "description": "", "p": "mathlib"}, {"name": "free_algebra.\u03b9_comp_lift", "description": "", "p": "mathlib"}, {"name": "free_algebra.pre.inhabited", "description": "", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.star_apply", "description": "", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.star_add_monoid", "description": "", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.continuous_map.lift_zero_at_infty", "description": " A continuous function on a compact space is automatically a continuous function vanishing at\ninfinity.", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.is_scalar_tower", "description": "", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.coe_star", "description": "", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.has_coe_t", "description": "", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.has_sub", "description": "", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map", "description": " `C\u2080(\u03b1, \u03b2)` is the type of continuous functions `\u03b1 \u2192 \u03b2` which vanish at infinity from a\ntopological space to a metric space with a zero element.\n\nWhen possible, instead of parametrizing results over `(f : C\u2080(\u03b1, \u03b2))`,\nyou should parametrize over `(F : Type*) [zero_at_infty_continuous_map_class F \u03b1 \u03b2] (f : F)`.\n\nWhen you extend this structure, make sure to extend `zero_at_infty_continuous_map_class`.", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.to_continuous_map", "description": " `C\u2080(\u03b1, \u03b2)` is the type of continuous functions `\u03b1 \u2192 \u03b2` which vanish at infinity from a\ntopological space to a metric space with a zero element.\n\nWhen possible, instead of parametrizing results over `(f : C\u2080(\u03b1, \u03b2))`,\nyou should parametrize over `(F : Type*) [zero_at_infty_continuous_map_class F \u03b1 \u03b2] (f : F)`.\n\nWhen you extend this structure, make sure to extend `zero_at_infty_continuous_map_class`.", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.zero_at_infty'", "description": " `C\u2080(\u03b1, \u03b2)` is the type of continuous functions `\u03b1 \u2192 \u03b2` which vanish at infinity from a\ntopological space to a metric space with a zero element.\n\nWhen possible, instead of parametrizing results over `(f : C\u2080(\u03b1, \u03b2))`,\nyou should parametrize over `(F : Type*) [zero_at_infty_continuous_map_class F \u03b1 \u03b2] (f : F)`.\n\nWhen you extend this structure, make sure to extend `zero_at_infty_continuous_map_class`.", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.zero_at_infty_continuous_map_class.of_compact", "description": " A continuous function on a compact space is automatically a continuous function vanishing at\ninfinity. This is not an instance to avoid type class loops.", "p": "mathlib"}, {"name": "zero_at_infty_continuous_map.smul_comm_class", "description": "", "p":