coe_subgroup", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.add_subgroup_class", "description": "", "p": "mathlib"}, {"name": "open_subgroup.has_coe_opens", "description": "", "p": "mathlib"}, {"name": "open_subgroup.coe_prod", "description": "", "p": "mathlib"}, {"name": "open_subgroup.order_top", "description": "", "p": "mathlib"}, {"name": "subgroup.is_open_mono", "description": "", "p": "mathlib"}, {"name": "open_subgroup.is_open", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.coe_add_subgroup_injective", "description": "", "p": "mathlib"}, {"name": "subgroup.is_open_of_one_mem_interior", "description": "If a subgroup of a topological group has `1` in its interior, then it is open.", "p": "mathlib"}, {"name": "open_add_subgroup.inhabited", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.has_inf", "description": "", "p": "mathlib"}, {"name": "open_subgroup.is_clopen", "description": "", "p": "mathlib"}, {"name": "open_subgroup.has_top", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.order_top", "description": "", "p": "mathlib"}, {"name": "open_subgroup.coe_subgroup_comap", "description": "", "p": "mathlib"}, {"name": "open_subgroup.has_sup", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.coe_add_subgroup_inf", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.sum", "description": "The product of two open subgroups as an open subgroup of the product group.", "p": "mathlib"}, {"name": "open_subgroup.coe_comap", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.coe_add_subgroup_comap", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.is_clopen", "description": "", "p": "mathlib"}, {"name": "open_subgroup.mem_comap", "description": "", "p": "mathlib"}, {"name": "add_subgroup.is_open_of_open_add_subgroup", "description": "", "p": "mathlib"}, {"name": "open_subgroup.has_coe_subgroup", "description": "", "p": "mathlib"}, {"name": "open_subgroup.mem_inf", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.coe_opens_top", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.mem_nhds_zero", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.has_sup", "description": "", "p": "mathlib"}, {"name": "add_subgroup.is_open_of_mem_nhds", "description": "", "p": "mathlib"}, {"name": "open_subgroup", "description": "The type of open subgroups of a topological group.", "p": "mathlib"}, {"name": "open_subgroup.to_subgroup", "description": "The type of open subgroups of a topological group.", "p": "mathlib"}, {"name": "open_subgroup.is_open'", "description": "The type of open subgroups of a topological group.", "p": "mathlib"}, {"name": "open_subgroup.coe_subgroup_le", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.has_coe_add_subgroup", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.mem_comap", "description": "", "p": "mathlib"}, {"name": "open_subgroup.mem_coe_subgroup", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.coe_opens_inf", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.coe_top", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.coe_coe_opens", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.has_coe_opens", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.mem_inf", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.ext", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.has_top", "description": "", "p": "mathlib"}, {"name": "open_subgroup.mem_coe_opens", "description": "", "p": "mathlib"}, {"name": "open_subgroup.semilattice_inf", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.set_like", "description": "", "p": "mathlib"}, {"name": "add_subgroup.is_open_mono", "description": "", "p": "mathlib"}, {"name": "open_subgroup.coe_subgroup_inf", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.comap_comap", "description": "", "p": "mathlib"}, {"name": "open_subgroup.coe_coe_opens", "description": "", "p": "mathlib"}, {"name": "open_add_subgroup.coe_coe_add_subgroup", "description": "", "p": "mathlib"}, {"name": "tensor_product.tmul_neg", "description": "", "p": "mathlib"}, {"name": "tensor_product.congr_symm_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.tmul", "description": " The canonical function `M \u2192 N \u2192 M \u2297 N`. The localized notations are `m \u2297\u209c n` and `m \u2297\u209c[R] n`,\naccessed by `open_locale tensor_product`.", "p": "mathlib"}, {"name": "tensor_product.tmul_sum", "description": "", "p": "mathlib"}, {"name": "tensor_product.curry_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.tmul_smul", "description": "", "p": "mathlib"}, {"name": "tensor_product.tensor_tensor_tensor_comm", "description": " This special case is worth defining explicitly since it is useful for defining multiplication\non tensor products of modules carrying multiplications (e.g., associative rings, Lie rings, ...).\n\nE.g., suppose `M = P` and `N = Q` and that `M` and `N` carry bilinear multiplications:\n`M \u2297 M \u2192 M` and `N \u2297 N \u2192 N`. Using `map`, we can define `(M \u2297 M) \u2297 (N \u2297 N) \u2192 M \u2297 N` which, when\ncombined with this definition, yields a bilinear multiplication on `M \u2297 N`:\n`(M \u2297 N) \u2297 (M \u2297 N) \u2192 M \u2297 N`. In particular we could use this to define the multiplication in\nthe `tensor_product.semiring` instance (currently defined \"by hand\" using `tensor_product.mul`).\n\nSee also `mul_mul_mul_comm`.", "p": "mathlib"}, {"name": "tensor_product.tensor_tensor_tensor_comm_symm", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor", "description": "`ltensor M f : M \u2297 N \u2192\u2097 M \u2297 P` is the natural linear map induced by `f : N \u2192\u2097 P`.", "p": "mathlib"}, {"name": "tensor_product.rid_symm_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.zero_smul", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_smul", "description": "", "p": "mathlib"}, {"name": "tensor_product.rid_tmul", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_hom", "description": "`ltensor_hom M` is the natural linear map that sends a linear map `f : N \u2192\u2097 P` to `M \u2297 f`.", "p": "mathlib"}, {"name": "linear_map.rtensor_comp", "description": "", "p": "mathlib"}, {"name": "tensor_product.mk_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_bilinear", "description": "The tensor product of a pair of linear maps between modules, bilinear in both maps.", "p": "mathlib"}, {"name": "linear_map.ltensor_id_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.ext_threefold", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_range_eq_span_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.tmul_zero", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift_aux.smul", "description": "", "p": "mathlib"}, {"name": "tensor_product.tmul_add", "description": "", "p": "mathlib"}, {"name": "tensor_product.add_left_neg", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_mul", "description": "", "p": "mathlib"}, {"name": "tensor_product.comm", "description": "The tensor product of modules is commutative, up to linear equivalence.", "p": "mathlib"}, {"name": "tensor_product.sub_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.tmul_sub", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift.tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.is_central_scalar", "description": "", "p": "mathlib"}, {"name": "tensor_product.inhabited", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_comp_rtensor", "description": "", "p": "mathlib"}, {"name": "tensor_product.zero_tmul", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_comp_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.add_comm_semigroup", "description": "", "p": "mathlib"}, {"name": "tensor_product.comm_symm_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_one", "description": "", "p": "mathlib"}, {"name": "tensor_product.tensor_tensor_tensor_assoc", "description": " This special case is useful for describing the interplay between `dual_tensor_hom_equiv` and\ncomposition of linear maps.\n\nE.g., composition of linear maps gives a map `(M \u2192 N) \u2297 (N \u2192 P) \u2192 (M \u2192 P)`, and applying\n`dual_tensor_hom_equiv.symm` to the three hom-modules gives a map\n`(M.dual \u2297 N) \u2297 (N.dual \u2297 P) \u2192 (M.dual \u2297 P)`, which agrees with the application of `contract_right`\non `N \u2297 N.dual` after the suitable rebracketting.", "p": "mathlib"}, {"name": "tensor_product.add_smul", "description": "", "p": "mathlib"}, {"name": "tensor_product.smul.aux_of", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_zero", "description": "", "p": "mathlib"}, {"name": "tensor_product.rtensor_hom_to_hom_rtensor", "description": "The canonical linear map from `(M \u2192\u2097[R] P) \u2297[R] Q` to `(M \u2192\u2097[R] P \u2297[R] Q)`", "p": "mathlib"}, {"name": "tensor_product.has_neg", "description": "", "p": "mathlib"}, {"name": "tensor_product.add_zero_class", "description": "", "p": "mathlib"}, {"name": "tensor_product.neg.aux", "description": "Auxiliary function to defining negation multiplication on tensor product.", "p": "mathlib"}, {"name": "tensor_product.rtensor_hom_to_hom_rtensor_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product", "description": " The tensor product of two modules `M` and `N` over the same commutative semiring `R`.\nThe localized notations are `M \u2297 N` and `M \u2297[R] N`, accessed by `open_locale tensor_product`.", "p": "mathlib"}, {"name": "tensor_product.lift_compr\u2082", "description": "", "p": "mathlib"}, {"name": "tensor_product.left_comm_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift_aux", "description": " Auxiliary function to constructing a linear map `M \u2297 N \u2192 P` given a bilinear map `M \u2192 N \u2192 P`\nwith the property that its composition with the canonical bilinear map `M \u2192 N \u2192 M \u2297 N` is\nthe given bilinear map `M \u2192 N \u2192 P`.", "p": "mathlib"}, {"name": "linear_map.ltensor_neg", "description": "", "p": "mathlib"}, {"name": "tensor_product.ext'", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_sub", "description": "", "p": "mathlib"}, {"name": "tensor_product.lcurry_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_smul_left", "description": "", "p": "mathlib"}, {"name": "tensor_product.ltensor_hom_to_hom_ltensor_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_id_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.left_module", "description": "", "p": "mathlib"}, {"name": "tensor_product.lid", "description": "The base ring is a left identity for the tensor product of modules, up to linear equivalence.", "p": "mathlib"}, {"name": "tensor_product.span_tmul_eq_top", "description": "The simple (aka pure) elements span the tensor product.", "p": "mathlib"}, {"name": "tensor_product.assoc", "description": "The associator for tensor product of R-modules, as a linear equivalence.", "p": "mathlib"}, {"name": "linear_map.ltensor_add", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_comp_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.add_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.left_comm_symm_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.mk", "description": "The canonical bilinear map `M \u2192 N \u2192 M \u2297[R] N`.", "p": "mathlib"}, {"name": "linear_map.rtensor", "description": "`rtensor f M : N\u2081 \u2297 M \u2192\u2097 N\u2082 \u2297 M` is the natural linear map induced by `f : N\u2081 \u2192\u2097 N\u2082`.", "p": "mathlib"}, {"name": "tensor_product.rid", "description": "The base ring is a right identity for the tensor product of modules, up to linear equivalence.", "p": "mathlib"}, {"name": "tensor_product.smul_zero", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_rtensor_hom", "description": "", "p": "mathlib"}, {"name": "tensor_product.add_comm_group", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift.tmul'", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_smul_right", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_mul", "description": "", "p": "mathlib"}, {"name": "tensor_product.eqv", "description": " The relation on `free_add_monoid (M \u00d7 N)` that generates a congruence whose quotient is\nthe tensor product.", "p": "mathlib"}, {"name": "tensor_product.eqv.of_zero_left", "description": " The relation on `free_add_monoid (M \u00d7 N)` that generates a congruence whose quotient is\nthe tensor product.", "p": "mathlib"}, {"name": "tensor_product.eqv.of_zero_right", "description": " The relation on `free_add_monoid (M \u00d7 N)` that generates a congruence whose quotient is\nthe tensor product.", "p": "mathlib"}, {"name": "tensor_product.eqv.of_add_left", "description": " The relation on `free_add_monoid (M \u00d7 N)` that generates a congruence whose quotient is\nthe tensor product.", "p": "mathlib"}, {"name": "tensor_product.eqv.of_add_right", "description": " The relation on `free_add_monoid (M \u00d7 N)` that generates a congruence whose quotient is\nthe tensor product.", "p": "mathlib"}, {"name": "tensor_product.eqv.of_smul", "description": " The relation on `free_add_monoid (M \u00d7 N)` that generates a congruence whose quotient is\nthe tensor product.", "p": "mathlib"}, {"name": "tensor_product.eqv.add_comm", "description": " The relation on `free_add_monoid (M \u00d7 N)` that generates a congruence whose quotient is\nthe tensor product.", "p": "mathlib"}, {"name": "tensor_product.lcurry", "description": " Given a linear map `M \u2297 N \u2192 P`, compose it with the canonical bilinear map `M \u2192 N \u2192 M \u2297 N` to\nform a bilinear map `M \u2192 N \u2192 P`.", "p": "mathlib"}, {"name": "tensor_product.hom_tensor_hom_map_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.smul_tmul", "description": "`smul` can be moved from one side of the product to the other .", "p": "mathlib"}, {"name": "tensor_product.uncurry_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_comp_ltensor", "description": "", "p": "mathlib"}, {"name": "tensor_product.congr", "description": " If `M` and `P` are linearly equivalent and `N` and `Q` are linearly equivalent\nthen `M \u2297 N` and `P \u2297 Q` are linearly equivalent.", "p": "mathlib"}, {"name": "tensor_product.curry", "description": " Given a linear map `M \u2297 N \u2192 P`, compose it with the canonical bilinear map `M \u2192 N \u2192 M \u2297 N` to\nform a bilinear map `M \u2192 N \u2192 P`.", "p": "mathlib"}, {"name": "tensor_product.map_add_right", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift_mk", "description": "", "p": "mathlib"}, {"name": "tensor_product.neg_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift.equiv_apply", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_zero", "description": "", "p": "mathlib"}, {"name": "linear_map.map_comp_rtensor", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift_comp_map", "description": "", "p": "mathlib"}, {"name": "tensor_product.sum_tmul", "description": "", "p": "mathlib"}, {"name": "linear_map.map_comp_ltensor", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_comp_map", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_hom", "description": "`rtensor_hom M` is the natural linear map that sends a linear map `f : N \u2192\u2097 P` to `M \u2297 f`.", "p": "mathlib"}, {"name": "tensor_product.compatible_smul", "description": "A typeclass for `has_smul` structures which can be moved across a tensor product.\n\nThis typeclass is generated automatically from a `is_scalar_tower` instance, but exists so that\nwe can also add an instance for `add_comm_group.int_module`, allowing `z \u2022` to be moved even if\n`R` does not support negation.\n\nNote that `module R' (M \u2297[R] N)` is available even without this typeclass on `R'`; it's only\nneeded if `tensor_product.smul_tmul`, `tensor_product.smul_tmul'`, or `tensor_product.tmul_smul` is\nused.", "p": "mathlib"}, {"name": "tensor_product.compatible_smul.smul_tmul", "description": "A typeclass for `has_smul` structures which can be moved across a tensor product.\n\nThis typeclass is generated automatically from a `is_scalar_tower` instance, but exists so that\nwe can also add an instance for `add_comm_group.int_module`, allowing `z \u2022` to be moved even if\n`R` does not support negation.\n\nNote that `module R' (M \u2297[R] N)` is available even without this typeclass on `R'`; it's only\nneeded if `tensor_product.smul_tmul`, `tensor_product.smul_tmul'`, or `tensor_product.tmul_smul` is\nused.", "p": "mathlib"}, {"name": "linear_map.rtensor_add", "description": "", "p": "mathlib"}, {"name": "tensor_product.smul.aux", "description": "Auxiliary function to defining scalar multiplication on tensor product.", "p": "mathlib"}, {"name": "tensor_product.module", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_smul", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift.equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.lid_tmul", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_tmul", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_pow", "description": "", "p": "mathlib"}, {"name": "tensor_product.lid_symm_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.ext_fourfold'", "description": " Two linear maps (M \u2297 N) \u2297 (P \u2297 Q) \u2192 S which agree on all elements of the\nform (m \u2297\u209c n) \u2297\u209c (p \u2297\u209c q) are equal.", "p": "mathlib"}, {"name": "tensor_product.has_smul", "description": "", "p": "mathlib"}, {"name": "tensor_product.compatible_smul.int", "description": "While the tensor product will automatically inherit a \u2124-module structure from\n`add_comm_group.int_module`, that structure won't be compatible with lemmas like `tmul_smul` unless\nwe use a `\u2124-module` instance provided by `tensor_product.left_module`.\n\nWhen `R` is a `ring` we get the required `tensor_product.compatible_smul` instance through\n`is_scalar_tower`, but when it is only a `semiring` we need to build it from scratch.\nThe instance diamond in `compatible_smul` doesn't matter because it's in `Prop`.", "p": "mathlib"}, {"name": "tensor_product.map\u2082_mk_top_top_eq_top", "description": "", "p": "mathlib"}, {"name": "tensor_product.tmul_ite", "description": "", "p": "mathlib"}, {"name": "tensor_product.ltensor_hom_to_hom_ltensor", "description": "The canonical linear map from `P \u2297[R] (M \u2192\u2097[R] Q)` to `(M \u2192\u2097[R] P \u2297[R] Q)`", "p": "mathlib"}, {"name": "tensor_product.map_id", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_comp_map", "description": "", "p": "mathlib"}, {"name": "tensor_product.left_distrib_mul_action", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift.equiv", "description": " A linear equivalence constructing a linear map `M \u2297 N \u2192 P` given a bilinear map `M \u2192 N \u2192 P`\nwith the property that its composition with the canonical bilinear map `M \u2192 N \u2192 M \u2297 N` is\nthe given bilinear map `M \u2192 N \u2192 P`.", "p": "mathlib"}, {"name": "linear_map.ltensor_comp", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift_mk_compr\u2082", "description": "", "p": "mathlib"}, {"name": "tensor_product.assoc_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.ext", "description": "This used to be an `@[ext]` lemma, but it fails very slowly when the `ext` tactic tries to apply\nit in some cases, notably when one wants to show equality of two linear maps. The `@[ext]`\nattribute is now added locally where it is needed. Using this as the `@[ext]` lemma instead of\n`tensor_product.ext'` allows `ext` to apply lemmas specific to `M \u2192\u2097 _` and `N \u2192\u2097 _`.\n\nSee note [partially-applied ext lemmas].", "p": "mathlib"}, {"name": "tensor_product.compatible_smul.unit", "description": "", "p": "mathlib"}, {"name": "tensor_product.is_scalar_tower_left", "description": "`is_scalar_tower R'\u2082 R' M` implies `is_scalar_tower R'\u2082 R' (M \u2297[R] N)`", "p": "mathlib"}, {"name": "linear_map.rtensor_id", "description": "", "p": "mathlib"}, {"name": "tensor_product.one_smul", "description": "", "p": "mathlib"}, {"name": "tensor_product.smul_comm_class_left", "description": "`smul_comm_class R' R'\u2082 M` implies `smul_comm_class R' R'\u2082 (M \u2297[R] N)`", "p": "mathlib"}, {"name": "tensor_product.tensor_tensor_tensor_assoc_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift.unique", "description": "", "p": "mathlib"}, {"name": "tensor_product.induction_on", "description": "", "p": "mathlib"}, {"name": "tensor_product.is_scalar_tower", "description": " A short-cut instance for the common case, where the requirements for the `compatible_smul`\ninstances are sufficient.", "p": "mathlib"}, {"name": "tensor_product.left_has_smul", "description": " Given two modules over a commutative semiring `R`, if one of the factors carries a\n(distributive) action of a second type of scalars `R'`, which commutes with the action of `R`, then\nthe tensor product (over `R`) carries an action of `R'`.\n\nThis instance defines this `R'` action in the case that it is the left module which has the `R'`\naction. Two natural ways in which this situation arises are:\n * Extension of scalars\n * A tensor product of a group representation with a module not carrying an action\n\nNote that in the special case that `R = R'`, since `R` is commutative, we just get the usual scalar\naction on a tensor product of two modules. This special case is important enough that, for\nperformance reasons, we define it explicitly below.", "p": "mathlib"}, {"name": "tensor_product.map_incl", "description": "Given submodules `p \u2286 P` and `q \u2286 Q`, this is the natural map: `p \u2297 q \u2192 P \u2297 Q`.", "p": "mathlib"}, {"name": "linear_map.rtensor_neg", "description": "", "p": "mathlib"}, {"name": "tensor_product.comm_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.neg.aux_of", "description": "", "p": "mathlib"}, {"name": "tensor_product.congr_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.compatible_smul.is_scalar_tower", "description": " Note that this provides the default `compatible_smul R R M N` instance through\n`mul_action.is_scalar_tower.left`.", "p": "mathlib"}, {"name": "tensor_product.ite_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.tensor_tensor_tensor_assoc_symm_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.smul_add", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_add_left", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_bilinear_apply", "description": "", "p": "mathlib"}, {"name": "tensor_product.map_comp", "description": "", "p": "mathlib"}, {"name": "tensor_product.smul_tmul'", "description": "", "p": "mathlib"}, {"name": "tensor_product.hom_tensor_hom_map", "description": " The linear map from `(M \u2192\u2097 P) \u2297 (N \u2192\u2097 Q)` to `(M \u2297 N \u2192\u2097 P \u2297 Q)` sending `f \u2297\u209c g` to\nthe `tensor_product.map f g`, the tensor product of the two maps.", "p": "mathlib"}, {"name": "tensor_product.add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_pow", "description": "", "p": "mathlib"}, {"name": "linear_map.rtensor_sub", "description": "", "p": "mathlib"}, {"name": "tensor_product.map", "description": "The tensor product of a pair of linear maps between modules.", "p": "mathlib"}, {"name": "linear_map.ltensor_id", "description": "", "p": "mathlib"}, {"name": "tensor_product.uncurry", "description": " Linearly constructing a linear map `M \u2297 N \u2192 P` given a bilinear map `M \u2192 N \u2192 P`\nwith the property that its composition with the canonical bilinear map `M \u2192 N \u2192 M \u2297 N` is\nthe given bilinear map `M \u2192 N \u2192 P`.", "p": "mathlib"}, {"name": "tensor_product.tensor_tensor_tensor_comm_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.ext_fourfold", "description": "", "p": "mathlib"}, {"name": "linear_map.coe_ltensor_hom", "description": "", "p": "mathlib"}, {"name": "tensor_product.is_scalar_tower_right", "description": "`is_scalar_tower R'\u2082 R' N` implies `is_scalar_tower R'\u2082 R' (M \u2297[R] N)`", "p": "mathlib"}, {"name": "tensor_product.map_pow", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift", "description": " Constructing a linear map `M \u2297 N \u2192 P` given a bilinear map `M \u2192 N \u2192 P` with the property that\nits composition with the canonical bilinear map `M \u2192 N \u2192 M \u2297 N` is\nthe given bilinear map `M \u2192 N \u2192 P`.", "p": "mathlib"}, {"name": "tensor_product.curry_injective", "description": "", "p": "mathlib"}, {"name": "tensor_product.assoc_symm_tmul", "description": "", "p": "mathlib"}, {"name": "tensor_product.left_comm", "description": "A tensor product analogue of `mul_left_comm`.", "p": "mathlib"}, {"name": "tensor_product.distrib_mul_action", "description": "", "p": "mathlib"}, {"name": "tensor_product.lift_aux_tmul", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_tmul", "description": "", "p": "mathlib"}, {"name": "linear_map.ltensor_mul", "description": "", "p": "mathlib"}, {"name": "tensor_product.smul_tmul_smul", "description": "", "p": "mathlib"}, {"name": "enorm.map_zero", "description": "", "p": "mathlib"}, {"name": "enorm.finite_subspace.normed_add_comm_group", "description": "Normed group instance on `e.finite_subspace`.", "p": "mathlib"}, {"name": "enorm.semilattice_sup", "description": "", "p": "mathlib"}, {"name": "enorm.map_smul", "description": "", "p": "mathlib"}, {"name": "enorm.map_neg", "description": "", "p": "mathlib"}, {"name": "enorm.finite_dist_eq", "description": "", "p": "mathlib"}, {"name": "enorm.map_sub_rev", "description": "", "p": "mathlib"}, {"name": "enorm.eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "enorm.coe_fn_injective", "description": "", "p": "mathlib"}, {"name": "enorm.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "enorm.coe_inj", "description": "", "p": "mathlib"}, {"name": "enorm.ext_iff", "description": "", "p": "mathlib"}, {"name": "enorm", "description": " Extended norm on a vector space. As in the case of normed spaces, we require only\n`\u2016c \u2022 x\u2016 \u2264 \u2016c\u2016 * \u2016x\u2016` in the definition, then prove an equality in `map_smul`.", "p": "mathlib"}, {"name": "enorm.to_fun", "description": " Extended norm on a vector space. As in the case of normed spaces, we require only\n`\u2016c \u2022 x\u2016 \u2264 \u2016c\u2016 * \u2016x\u2016` in the definition, then prove an equality in `map_smul`.", "p": "mathlib"}, {"name": "enorm.eq_zero'", "description": " Extended norm on a vector space. As in the case of normed spaces, we require only\n`\u2016c \u2022 x\u2016 \u2264 \u2016c\u2016 * \u2016x\u2016` in the definition, then prove an equality in `map_smul`.", "p": "mathlib"}, {"name": "enorm.map_add_le'", "description": " Extended norm on a vector space. As in the case of normed spaces, we require only\n`\u2016c \u2022 x\u2016 \u2264 \u2016c\u2016 * \u2016x\u2016` in the definition, then prove an equality in `map_smul`.", "p": "mathlib"}, {"name": "enorm.map_smul_le'", "description": " Extended norm on a vector space. As in the case of normed spaces, we require only\n`\u2016c \u2022 x\u2016 \u2264 \u2016c\u2016 * \u2016x\u2016` in the definition, then prove an equality in `map_smul`.", "p": "mathlib"}, {"name": "enorm.top_map", "description": "", "p": "mathlib"}, {"name": "enorm.coe_max", "description": "", "p": "mathlib"}, {"name": "enorm.finite_edist_eq", "description": "", "p": "mathlib"}, {"name": "enorm.inhabited", "description": "", "p": "mathlib"}, {"name": "enorm.emetric_space", "description": "Structure of an `emetric_space` defined by an extended norm.", "p": "mathlib"}, {"name": "enorm.map_sub_le", "description": "", "p": "mathlib"}, {"name": "enorm.finite_subspace.normed_space", "description": "Normed space instance on `e.finite_subspace`.", "p": "mathlib"}, {"name": "enorm.max_map", "description": "", "p": "mathlib"}, {"name": "enorm.finite_subspace.metric_space", "description": " Metric space structure on `e.finite_subspace`. We use `emetric_space.to_metric_space`\nto ensure that this definition agrees with `e.emetric_space`.", "p": "mathlib"}, {"name": "enorm.ext", "description": "", "p": "mathlib"}, {"name": "enorm.partial_order", "description": "", "p": "mathlib"}, {"name": "enorm.finite_subspace", "description": "The subspace of vectors with finite enorm.", "p": "mathlib"}, {"name": "enorm.finite_norm_eq", "description": "", "p": "mathlib"}, {"name": "enorm.map_add_le", "description": "", "p": "mathlib"}, {"name": "enorm.order_top", "description": "", "p": "mathlib"}, {"name": "enorm.has_top", "description": "The `enorm` sending each non-zero vector to infinity.", "p": "mathlib"}, {"name": "affine_map.is_open_map", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.exists_nonlinear_right_inverse_of_surjective", "description": "", "p": "mathlib"}, {"name": "linear_map.continuous_of_is_closed_graph", "description": " The **closed graph theorem** : a linear map between two Banach spaces whose graph is closed\nis continuous.", "p": "mathlib"}, {"name": "continuous_linear_map.is_open_map", "description": " The Banach open mapping theorem: a surjective bounded linear map between Banach spaces is\nopen.", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse.right_inv", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.coe_fn_of_seq_closed_graph", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.of_seq_closed_graph", "description": " Upgrade a `linear_map` to a `continuous_linear_map` using a variation on the\n**closed graph theorem**.", "p": "mathlib"}, {"name": "continuous_linear_map.closed_complemented_range_of_is_compl_of_ker_eq_bot", "description": "", "p": "mathlib"}, {"name": "linear_equiv.coe_fn_to_continuous_linear_equiv_of_continuous", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse_of_surjective", "description": " A surjective continuous linear map between Banach spaces admits a (possibly nonlinear)\ncontrolled right inverse. In general, it is not possible to ensure that such a right inverse\nis linear (take for instance the map from `E` to `E/F` where `F` is a closed subspace of `E`\nwithout a closed complement. Then it doesn't have a continuous linear right inverse.)", "p": "mathlib"}, {"name": "continuous_linear_equiv.coe_of_bijective", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.interior_preimage", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.frontier_preimage", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.of_bijective", "description": " Convert a bijective continuous linear map `f : E \u2192L[\ud835\udd5c] F` from a Banach space to a normed space\nto a continuous linear equivalence.", "p": "mathlib"}, {"name": "continuous_linear_map.coe_of_is_closed_graph", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.exists_approx_preimage_norm_le", "description": "First step of the proof of the Banach open mapping theorem (using completeness of `F`):\nby Baire's theorem, there exists a ball in `E` whose image closure has nonempty interior.\nRescaling everything, it follows that any `y \u2208 F` is arbitrarily well approached by\nimages of elements of norm at most `C * \u2016y\u2016`.\nFor further use, we will only need such an element whose image\nis within distance `\u2016y\u2016/2` of `y`, to apply an iterative process.", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse", "description": " A (possibly nonlinear) right inverse to a continuous linear map, which doesn't have to be\nlinear itself but which satisfies a bound `\u2016inverse x\u2016 \u2264 C * \u2016x\u2016`. A surjective continuous linear\nmap doesn't always have a continuous linear right inverse, but it always has a nonlinear inverse\nin this sense, by Banach's open mapping theorem.", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse.to_fun", "description": " A (possibly nonlinear) right inverse to a continuous linear map, which doesn't have to be\nlinear itself but which satisfies a bound `\u2016inverse x\u2016 \u2264 C * \u2016x\u2016`. A surjective continuous linear\nmap doesn't always have a continuous linear right inverse, but it always has a nonlinear inverse\nin this sense, by Banach's open mapping theorem.", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse.nnnorm", "description": " A (possibly nonlinear) right inverse to a continuous linear map, which doesn't have to be\nlinear itself but which satisfies a bound `\u2016inverse x\u2016 \u2264 C * \u2016x\u2016`. A surjective continuous linear\nmap doesn't always have a continuous linear right inverse, but it always has a nonlinear inverse\nin this sense, by Banach's open mapping theorem.", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse.bound'", "description": " A (possibly nonlinear) right inverse to a continuous linear map, which doesn't have to be\nlinear itself but which satisfies a bound `\u2016inverse x\u2016 \u2264 C * \u2016x\u2016`. A surjective continuous linear\nmap doesn't always have a continuous linear right inverse, but it always has a nonlinear inverse\nin this sense, by Banach's open mapping theorem.", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse.right_inv'", "description": " A (possibly nonlinear) right inverse to a continuous linear map, which doesn't have to be\nlinear itself but which satisfies a bound `\u2016inverse x\u2016 \u2264 C * \u2016x\u2016`. A surjective continuous linear\nmap doesn't always have a continuous linear right inverse, but it always has a nonlinear inverse\nin this sense, by Banach's open mapping theorem.", "p": "mathlib"}, {"name": "continuous_linear_equiv.coe_fn_of_bijective", "description": "", "p": "mathlib"}, {"name": "linear_equiv.to_continuous_linear_equiv_of_continuous", "description": " Associating to a linear equivalence between Banach spaces a continuous linear equivalence when\nthe direct map is continuous, thanks to the Banach open mapping theorem that ensures that the\ninverse map is also continuous.", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse.inhabited", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.quotient_map", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse.bound", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.to_nonlinear_right_inverse", "description": " Given a continuous linear equivalence, the inverse is in particular an instance of\n`nonlinear_right_inverse` (which turns out to be linear).", "p": "mathlib"}, {"name": "continuous_linear_map.coe_fn_of_is_closed_graph", "description": "", "p": "mathlib"}, {"name": "linear_equiv.continuous_symm", "description": "If a bounded linear map is a bijection, then its inverse is also a bounded linear map.", "p": "mathlib"}, {"name": "continuous_linear_equiv.of_bijective_apply_symm_apply", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse_of_surjective_nnnorm_pos", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.closure_preimage", "description": "", "p": "mathlib"}, {"name": "continuous_linear_equiv.of_bijective_symm_apply_apply", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.nonlinear_right_inverse.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.of_is_closed_graph", "description": "Upgrade a `linear_map` to a `continuous_linear_map` using the **closed graph theorem**.", "p": "mathlib"}, {"name": "continuous_linear_map.range_eq_map_coprod_subtypeL_equiv_of_is_compl", "description": "", "p": "mathlib"}, {"name": "linear_equiv.coe_fn_to_continuous_linear_equiv_of_continuous_symm", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.exists_preimage_norm_le", "description": " The Banach open mapping theorem: if a bounded linear map between Banach spaces is onto, then\nany point has a preimage with controlled norm.", "p": "mathlib"}, {"name": "linear_map.continuous_of_seq_closed_graph", "description": " A useful form of the **closed graph theorem** : let `f` be a linear map between two Banach\nspaces. To show that `f` is continuous, it suffices to show that for any convergent sequence\n`u\u2099 \u27f6 x`, if `f(u\u2099) \u27f6 y` then `y = f(x)`.", "p": "mathlib"}, {"name": "continuous_linear_map.coe_of_seq_closed_graph", "description": "", "p": "mathlib"}, {"name": "continuous_linear_map.coprod_subtypeL_equiv_of_is_compl", "description": " Intermediate definition used to show\n`continuous_linear_map.closed_complemented_range_of_is_compl_of_ker_eq_bot`.\n\nThis is `f.coprod G.subtypeL` as an `continuous_linear_equiv`.", "p": "mathlib"}, {"name": "category_theory.arrow.category", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.square_to_snd_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.hom_mk_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.hom_mk'", "description": "We can also build a morphism in the arrow category out of any commutative square in `T`.", "p": "mathlib"}, {"name": "category_theory.arrow.epi_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow", "description": "The arrow category of `T` has as objects all morphisms in `T` and as morphisms commutative\n    squares in `T`.", "p": "mathlib"}, {"name": "category_theory.arrow.is_iso_of_iso_left_of_is_iso_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.left_func_map", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.right_func", "description": "The functor sending an arrow to its target.", "p": "mathlib"}, {"name": "category_theory.arrow.iso_of_nat_iso", "description": " The images of `f : arrow C` by two isomorphic functors `F : C \u2964 D` are\nisomorphic arrows in `D`.", "p": "mathlib"}, {"name": "category_theory.arrow.inhabited", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_arrow_obj_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.iso_w", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.has_coe", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.mk_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.is_iso_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.left_to_right", "description": "The natural transformation from `left_func` to `right_func`, given by the arrow itself.", "p": "mathlib"}, {"name": "category_theory.arrow.hom.congr_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.hom_mk'_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.left_hom_inv_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.inv_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.iso_mk_hom_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.iso_mk_hom_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.iso_mk'", "description": " A variant of `arrow.iso_mk` that creates an iso between two `arrow.mk`s with a better type\nsignature.", "p": "mathlib"}, {"name": "category_theory.arrow.w_mk_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.mk", "description": "An object in the arrow category is simply a morphism in `T`.", "p": "mathlib"}, {"name": "category_theory.functor.map_arrow_map_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.mono_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.left_func", "description": "The functor sending an arrow to its source.", "p": "mathlib"}, {"name": "category_theory.functor.map_arrow", "description": "A functor `C \u2964 D` induces a functor between the corresponding arrow categories.", "p": "mathlib"}, {"name": "category_theory.arrow.square_to_snd_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.id_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.square_to_snd", "description": " A helper construction: given a square between `i` and `f \u226b g`, produce a square between\n`i` and `g`, whose top leg uses `f`:\nA  \u2192 X\n     \u2193f\n\u2193i   Y             --> A \u2192 Y\n     \u2193g                \u2193i  \u2193g\nB  \u2192 Z                 B \u2192 Z", "p": "mathlib"}, {"name": "category_theory.arrow.w", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.mk_eq", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.mk_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.inv_left_hom_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.mk_injective", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.right_func_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.hom_mk", "description": "A morphism in the arrow category is a commutative square connecting two objects of the arrow\n   category.", "p": "mathlib"}, {"name": "category_theory.arrow.square_from_iso_invert", "description": " Given a square from an isomorphism `i` to an arrow `p`, express the target part of `sq`\nin terms of the inverse of `i`.", "p": "mathlib"}, {"name": "category_theory.arrow.hom_mk'_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.iso_mk", "description": " Create an isomorphism between arrows,\nby providing isomorphisms between the domains and codomains,\nand a proof that the square commutes.", "p": "mathlib"}, {"name": "category_theory.arrow.is_iso_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.mk_inj", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.left_to_right_app", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.iso_mk_inv_left", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_arrow_map_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.iso_w'", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.hom_mk_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.w_mk_right_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.mk_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.iso_mk_inv_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.left_func_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.square_to_iso_invert", "description": " Given a square from an arrow `i` to an isomorphism `p`, express the source part of `sq`\nin terms of the inverse of `p`.", "p": "mathlib"}, {"name": "category_theory.arrow.id_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.w_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.inv_left", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_arrow_obj_right", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_arrow_obj_left", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.hom.congr_right", "description": "", "p": "mathlib"}, {"name": "category_theory.arrow.right_func_map", "description": "", "p": "mathlib"}, {"name": "nat.log_div_mul_self", "description": "", "p": "mathlib"}, {"name": "nat.clog_of_right_le_one", "description": "", "p": "mathlib"}, {"name": "nat.clog_pow", "description": "", "p": "mathlib"}, {"name": "nat.log_mono_right", "description": "", "p": "mathlib"}, {"name": "nat.log_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "nat.lt_pow_iff_log_lt", "description": "", "p": "mathlib"}, {"name": "nat.log_antitone_left", "description": "", "p": "mathlib"}, {"name": "nat.le_pow_clog", "description": "", "p": "mathlib"}, {"name": "nat.log_one_right", "description": "", "p": "mathlib"}, {"name": "nat.log_le_clog", "description": "", "p": "mathlib"}, {"name": "nat.log_zero_left", "description": "", "p": "mathlib"}, {"name": "nat.pow_lt_iff_lt_clog", "description": "", "p": "mathlib"}, {"name": "nat.log_of_lt", "description": "", "p": "mathlib"}, {"name": "nat.log_anti_left", "description": "", "p": "mathlib"}, {"name": "nat.clog_antitone_left", "description": "", "p": "mathlib"}, {"name": "nat.log_zero_right", "description": "", "p": "mathlib"}, {"name": "nat.clog_pos", "description": "", "p": "mathlib"}, {"name": "nat.log_eq_one_iff'", "description": "", "p": "mathlib"}, {"name": "nat.pow_pred_clog_lt_self", "description": "", "p": "mathlib"}, {"name": "nat.clog_anti_left", "description": "", "p": "mathlib"}, {"name": "nat.log_monotone", "description": "", "p": "mathlib"}, {"name": "nat.clog_zero_left", "description": "", "p": "mathlib"}, {"name": "nat.clog_monotone", "description": "", "p": "mathlib"}, {"name": "nat.log_pow", "description": "", "p": "mathlib"}, {"name": "nat.clog_zero_right", "description": "", "p": "mathlib"}, {"name": "nat.clog_of_left_le_one", "description": "", "p": "mathlib"}, {"name": "nat.lt_pow_of_log_lt", "description": "", "p": "mathlib"}, {"name": "nat.log_pos_iff", "description": "", "p": "mathlib"}, {"name": "nat.log_eq_of_pow_le_of_lt_pow", "description": "", "p": "mathlib"}, {"name": "nat.pow_log_le_self", "description": "", "p": "mathlib"}, {"name": "nat.pow_log_le_add_one", "description": "", "p": "mathlib"}, {"name": "nat.log_pos", "description": "", "p": "mathlib"}, {"name": "nat.pow_le_iff_le_log", "description": " `pow b` and `log b` (almost) form a Galois connection. See also `nat.pow_le_of_le_log` and\n`nat.le_log_of_pow_le` for individual implications under weaker assumptions.", "p": "mathlib"}, {"name": "nat.le_log_of_pow_le", "description": "", "p": "mathlib"}, {"name": "nat.clog_one_right", "description": "", "p": "mathlib"}, {"name": "nat.log_of_one_lt_of_le", "description": "", "p": "mathlib"}, {"name": "nat.clog_of_two_le", "description": "", "p": "mathlib"}, {"name": "nat.log_eq_one_iff", "description": "", "p": "mathlib"}, {"name": "nat.clog", "description": " `clog b n`, is the upper logarithm of natural number `n` in base `b`. It returns the smallest\n`k : \u2115` such that `n \u2264 b^k`, so if `b^k = n`, it returns exactly `k`.", "p": "mathlib"}, {"name": "nat.log_of_left_le_one", "description": "", "p": "mathlib"}, {"name": "nat.clog_one_left", "description": "", "p": "mathlib"}, {"name": "nat.log", "description": " `log b n`, is the logarithm of natural number `n` in base `b`. It returns the largest `k : \u2115`\nsuch that `b^k \u2264 n`, so if `b^k = n`, it returns exactly `k`.", "p": "mathlib"}, {"name": "nat.log_div_base", "description": "", "p": "mathlib"}, {"name": "nat.log_one_left", "description": "", "p": "mathlib"}, {"name": "nat.log_lt_of_lt_pow", "description": "", "p": "mathlib"}, {"name": "nat.le_pow_iff_clog_le", "description": "`clog b` and `pow b` form a Galois connection.", "p": "mathlib"}, {"name": "nat.lt_pow_succ_log_self", "description": "", "p": "mathlib"}, {"name": "nat.clog_mono_right", "description": "", "p": "mathlib"}, {"name": "nat.clog_eq_one", "description": "", "p": "mathlib"}, {"name": "nat.log_mul_base", "description": "", "p": "mathlib"}, {"name": "nat.pow_le_of_le_log", "description": "", "p": "mathlib"}, {"name": "nat.log_eq_iff", "description": "", "p": "mathlib"}, {"name": "tactic_doc.tactic.skip", "description": "A do-nothing tactic that always succeeds.", "p": "mathlib"}, {"name": "tactic_doc.tactic.refl / reflexivity", "description": "This tactic applies to a goal whose target has the form `t ~ u` where `~` is a reflexive relation,\nthat is, a relation which has a reflexivity lemma tagged with the attribute `[refl]`.\nThe tactic checks whether `t` and `u` are definitionally equal and then solves the goal.", "p": "mathlib"}, {"name": "tactic_doc.tactic.cases_type", "description": "* `cases_type I` applies the `cases` tactic to a hypothesis `h : (I ...)`\n* `cases_type I_1 ... I_n` applies the `cases` tactic to a hypothesis\n  `h : (I_1 ...)` or ... or `h : (I_n ...)`\n* `cases_type* I` is shorthand for `focus1 { repeat { cases_type I } }`\n* `cases_type! I` only applies `cases` if the number of resulting subgoals is <= 1.\n\nExample: The following tactic destructs all conjunctions and disjunctions in the current context.\n```lean\ncases_type* or and\n```", "p": "mathlib"}, {"name": "tactic_doc.tactic.unfold_projs", "description": "This tactic unfolds all structure projections.", "p": "mathlib"}, {"name": "tactic_doc.tactic.conv: for", "description": "Navigate into the numbered scopes matching the expression.\n\nFor a target of `| \u03bb c, 10 * c + 20 * c + 30 * c`, `for (_ * _) [1, 3] { ... }` will run the\ntactics within the `{}` with first a target of `| 10 * c`, then a target of `| 30 * c`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.injections", "description": "`injections with h\u2081 ... h\u2099` iteratively applies `injection` to hypotheses using the names `h\u2081 ... h\u2099`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.match_target", "description": "`match_target t` fails if target does not match pattern `t`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.conv: to_rhs", "description": "Navigate to the right-hand-side of a relation.\nA goal of `| a = b` will turn into the goal `| b`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.sorry / admit", "description": "Closes the main goal using `sorry`. Takes an optional ignored tactic block.\n\nThe ignored tactic block is useful for \"commenting out\" part of a proof during development:\n```lean\nbegin\n  split,\n  sorry { expensive_tactic },\n\nend\n```", "p": "mathlib"}, {"name": "tactic_doc.tactic.eapply", "description": "Similar to the `apply` tactic, but only creates subgoals for non-dependent premises that have not been fixed by type inference or type class resolution.", "p": "mathlib"}, {"name": "tactic_doc.tactic.clear", "description": "`clear h\u2081 ... h\u2099` tries to clear each hypothesis `h\u1d62` from the local context.", "p": "mathlib"}, {"name": "tactic_doc.tactic.any_goals", "description": "`any_goals { t }` applies the tactic `t` to every goal, and succeeds if at least one application succeeds.", "p": "mathlib"}, {"name": "tactic_doc.tactic.transitivity", "description": "This tactic applies to a goal whose target has the form `t ~ u` where `~` is a transitive relation, that is, a relation which has a transitivity lemma tagged with the attribute `[trans]`.\n\n`transitivity s` replaces the goal with the two subgoals `t ~ s` and `s ~ u`. If `s` is omitted, then a metavariable is used instead.", "p": "mathlib"}, {"name": "tactic_doc.tactic.unfold", "description": "Given defined constants `e\u2081 ... e\u2099`, `unfold e\u2081 ... e\u2099` iteratively unfolds all occurrences in the target of the main goal, using equational lemmas associated with the definitions.\n\nAs with `simp`, the `at` modifier can be used to specify locations for the unfolding.", "p": "mathlib"}, {"name": "tactic_doc.tactic.case", "description": "Focuses on a goal ('case') generated by `induction`, `cases` or `with_cases`.\n\nThe goal is selected by giving one or more names which must match exactly one\ngoal. A goal is matched if the given names are a suffix of its goal tag.\nAdditionally, each name in the sequence can be abbreviated to a suffix of the\ncorresponding name in the goal tag. Thus, a goal with tag\n```lean\nnat.zero, list.nil\n```\ncan be selected with any of these invocations (among others):\n```lean\ncase nat.zero list.nil {...}\ncase nat.zero nil      {...}\ncase zero     nil      {...}\ncase          nil      {...}\n```\n\nAdditionally, the form\n```lean\ncase C : N\u2080 ... N\u2099 {...}\n```\ncan be used to rename hypotheses introduced by the preceding\n`cases`/`induction`/`with_cases`, using the names `N\u1d62`. For example:\n```lean\nexample (xs : list \u2115) : xs = xs :=\nbegin\n  induction xs,\n  case nil { reflexivity },\n  case cons : x xs ih {\n    -- x : \u2115, xs : list \u2115, ih : xs = xs\n    reflexivity }\nend\n```\n\nNote that this renaming functionality only work reliably *directly after* an\n`induction`/`cases`/`with_cases`. If you need to perform additional work after\nan `induction` or `cases` (e.g. introduce hypotheses in all goals), use\n`with_cases`.\n\nMultiple cases can be handled by the same tactic block with\n```lean\ncase [A : N\u2080 ... N\u2099, B : M\u2080 ... M\u2099] {...}\n```", "p": "mathlib"}, {"name": "tactic_doc.tactic.iterate", "description": "`iterate { t }` repeatedly applies tactic `t` until `t` fails. `iterate { t }` always succeeds.\n\n`iterate n { t }` applies `t` `n` times.", "p": "mathlib"}, {"name": "tactic_doc.tactic.guard_target", "description": "`guard_target t` fails if the target of the main goal is not `t`.\nWe use this tactic for writing tests.", "p": "mathlib"}, {"name": "tactic_doc.tactic.rwa", "description": "`rewrite` followed by `assumption`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.assumption", "description": "This tactic looks in the local context for a hypothesis whose type is equal to the goal target. If it finds one, it uses it to prove the goal, and otherwise it fails.", "p": "mathlib"}, {"name": "tactic_doc.tactic.apply_auto_param", "description": "If the target of the main goal is an `auto_param`, executes the associated tactic.", "p": "mathlib"}, {"name": "tactic_doc.tactic.congr", "description": "The `congr` tactic attempts to identify both sides of an equality goal `A = B`,\nleaving as new goals the subterms of `A` and `B` which are not definitionally equal.\nExample: suppose the goal is `x * f y = g w * f z`. Then `congr` will produce two goals:\n`x = g w` and `y = z`.\n\nIf `x y : t`, and an instance `subsingleton t` is in scope, then any goals of the form\n`x = y` are solved automatically.\n\nNote that `congr` can be over-aggressive at times; the `congr'` tactic in mathlib\nprovides a more refined approach, by taking a parameter that limits the recursion depth.", "p": "mathlib"}, {"name": "tactic_doc.tactic.split", "description": "Applies the constructor when the type of the target is an inductive data type with one constructor.", "p": "mathlib"}, {"name": "tactic_doc.tactic.mapply", "description": "Similar to the `apply` tactic, but uses matching instead of unification.\n`apply_match t` is equivalent to `apply_with t {unify := ff}`", "p": "mathlib"}, {"name": "tactic_doc.tactic.fapply", "description": "Similar to the `apply` tactic, but does not reorder goals.", "p": "mathlib"}, {"name": "tactic_doc.tactic.suffices", "description": "`suffices h : t` is the same as `have h : t, tactic.swap`. In other words, it adds the hypothesis `h : t` to the current goal and opens a new subgoal with target `t`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.injection", "description": "The `injection` tactic is based on the fact that constructors of inductive data types are injections. That means that if `c` is a constructor of an inductive datatype, and if `(c t\u2081)` and `(c t\u2082)` are two terms that are equal then  `t\u2081` and `t\u2082` are equal too.\n\nIf `q` is a proof of a statement of conclusion `t\u2081 = t\u2082`, then injection applies injectivity to derive the equality of all arguments of `t\u2081` and `t\u2082` placed in the same positions. For example, from `(a::b) = (c::d)` we derive `a=c` and `b=d`. To use this tactic `t\u2081` and `t\u2082` should be constructor applications of the same constructor.\n\nGiven `h : a::b = c::d`, the tactic `injection h` adds two new hypothesis with types `a = c` and `b = d` to the main goal. The tactic `injection h with h\u2081 h\u2082` uses the names `h\u2081` and `h\u2082` to name the new hypotheses.", "p": "mathlib"}, {"name": "tactic_doc.tactic.apply_instance", "description": "This tactic tries to close the main goal `... \u22a2 t` by generating a term of type `t` using type class resolution.", "p": "mathlib"}, {"name": "tactic_doc.tactic.specialize", "description": "The tactic `specialize h a\u2081 ... a\u2099` works on local hypothesis `h`. The premises of this hypothesis, either universal quantifications or non-dependent implications, are instantiated by concrete terms coming either from arguments `a\u2081` ... `a\u2099`. The tactic adds a new hypothesis with the same name `h := h a\u2081 ... a\u2099` and tries to clear the previous one.", "p": "mathlib"}, {"name": "tactic_doc.tactic.trace_state", "description": "This tactic displays the current state in the tracing buffer.", "p": "mathlib"}, {"name": "tactic_doc.tactic.change", "description": "`change u` replaces the target `t` of the main goal to `u` provided that `t` is well formed with respect to the local context of the main goal and `t` and `u` are definitionally equal.\n\n`change u at h` will change a local hypothesis to `u`.\n\n`change t with u at h1 h2 ...` will replace `t` with `u` in all the supplied hypotheses (or `*`), or in the goal if no `at` clause is specified, provided that `t` and `u` are definitionally equal.", "p": "mathlib"}, {"name": "tactic_doc.tactic.trivial", "description": "Tries to solve the current goal using a canonical proof of `true`, or the `reflexivity` tactic, or the `contradiction` tactic.", "p": "mathlib"}, {"name": "tactic_doc.tactic.destruct", "description": "Assuming `x` is a variable in the local context with an inductive type, `destruct x` splits the main goal, producing one goal for each constructor of the inductive type, in which `x` is assumed to be a general instance of that constructor. In contrast to `cases`, the local context is unchanged, i.e. no elements are reverted or introduced.\n\nFor example, given `n : nat` and a goal with a hypothesis `h : P n` and target `Q n`, `destruct n` produces one goal with target `n = 0 \u2192 Q n`, and one goal with target `\u2200 (a : \u2115), (\u03bb (w : \u2115), n = w \u2192 Q n) (nat.succ a)`. Here the name `a` is chosen automatically.", "p": "mathlib"}, {"name": "tactic_doc.tactic.let", "description": "`let h : t := p` adds the hypothesis `h : t := p` to the current goal if `p` a term of type `t`.\nIf `t` is omitted, it will be inferred.\n\n`let h : t` adds the hypothesis `h : t := ?M` to the current goal and opens a new subgoal `?M : t`.\nThe new subgoal becomes the main goal. If `t` is omitted, it will be replaced by a fresh\nmetavariable.\n\nIf `h` is omitted, the name `this` is used.\n\nNote the related mathlib tactic `set a := t with h`, which adds the hypothesis `h : a = t` to\nthe local context and replaces `t` with `a` everywhere it can.", "p": "mathlib"}, {"name": "tactic_doc.tactic.fail_if_success", "description": "Fails if the given tactic succeeds.", "p": "mathlib"}, {"name": "tactic_doc.tactic.induction", "description": "Assuming `x` is a variable in the local context with an inductive type, `induction x` applies induction on `x` to the main goal, producing one goal for each constructor of the inductive type, in which the target is replaced by a general instance of that constructor and an inductive hypothesis is added for each recursive argument to the constructor. If the type of an element in the local context depends on `x`, that element is reverted and reintroduced afterward, so that the inductive hypothesis incorporates that hypothesis as well.\n\nFor example, given `n : nat` and a goal with a hypothesis `h : P n` and target `Q n`, `induction n` produces one goal with hypothesis `h : P 0` and target `Q 0`, and one goal with hypotheses `h : P (nat.succ a)` and `ih\u2081 : P a \u2192 Q a` and target `Q (nat.succ a)`. Here the names `a` and `ih\u2081` ire chosen automatically.\n\n`induction e`, where `e` is an expression instead of a variable, generalizes `e` in the goal, and then performs induction on the resulting variable.\n\n`induction e with y\u2081 ... y\u2099`, where `e` is a variable or an expression, specifies that the sequence of names `y\u2081 ... y\u2099` should be used for the arguments to the constructors and inductive hypotheses, including implicit arguments. If the list does not include enough names for all of the arguments, additional names are generated automatically. If too many names are given, the extra ones are ignored. Underscores can be used in the list, in which case the corresponding names are generated automatically. Note that for long sequences of names, the `case` tactic provides a more convenient naming mechanism.\n\n`induction e using r` allows the user to specify the principle of induction that should be used. Here `r` should be a theorem whose result type must be of the form `C t`, where `C` is a bound variable and `t` is a (possibly empty) sequence of bound variables\n\n`induction e generalizing z\u2081 ... z\u2099`, where `z\u2081 ... z\u2099` are variables in the local context, generalizes over `z\u2081 ... z\u2099` before applying the induction but then introduces them in each goal. In other words, the net effect is that each inductive hypothesis is generalized.\n\n`induction h : t` will introduce an equality of the form `h : t = C x y`, asserting that the input term is equal to the current constructor case, to the context.", "p": "mathlib"}, {"name": "tactic_doc.tactic.simp_intros", "description": "`simp_intros h\u2081 h\u2082 ... h\u2099` is similar to `intros h\u2081 h\u2082 ... h\u2099` except that each hypothesis is simplified as it is introduced, and each introduced hypothesis is used to simplify later ones and the final target.\n\nAs with `simp`, a list of simplification lemmas can be provided. The modifiers `only` and `with` behave as with `simp`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.abstract", "description": "`abstract id { t }` tries to use tactic `t` to solve the main goal. If it succeeds, it abstracts the goal as an independent definition or theorem with name `id`. If `id` is omitted, a name is generated automatically.", "p": "mathlib"}, {"name": "tactic_doc.tactic.existsi", "description": "`existsi e` will instantiate an existential quantifier in the target with `e` and leave the\ninstantiated body as the new target. More generally, it applies to any inductive type with one\nconstructor and at least two arguments, applying the constructor with `e` as the first argument\nand leaving the remaining arguments as goals.\n\n`existsi [e\u2081, ..., e\u2099]` iteratively does the same for each expression in the list.\n\nNote: in mathlib, the `use` tactic is an equivalent tactic which sometimes is smarter with\nunification.", "p": "mathlib"}, {"name": "tactic_doc.tactic.revert", "description": "`revert h\u2081 ... h\u2099` applies to any goal with hypotheses `h\u2081` ... `h\u2099`. It moves the hypotheses and their dependencies to the target of the goal. This tactic is the inverse of `intro`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.comp_val", "description": "Close goals of the form `n \u2260 m` when `n` and `m` have type `nat`, `char`, `string`, `int`\nor `fin sz`, and they are literals. It also closes goals of the form `n < m`, `n > m`, `n \u2264 m` and\n`n \u2265 m` for `nat`. If the goal is of the form `n = m`, then it tries to close it using reflexivity.\n\nIn mathlib, consider using `norm_num` instead for numeric types.", "p": "mathlib"}, {"name": "tactic_doc.tactic.exact", "description": "This tactic provides an exact proof term to solve the main goal. If `t` is the goal and `p` is a term of type `u` then `exact p` succeeds if and only if `t` and `u` can be unified.", "p": "mathlib"}, {"name": "tactic_doc.tactic.exacts", "description": "Like `exact`, but takes a list of terms and checks that all goals are discharged after the tactic.", "p": "mathlib"}, {"name": "tactic_doc.tactic.exfalso", "description": "Replaces the target of the main goal by `false`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.show", "description": "`show t` finds the first goal whose target unifies with `t`. It makes that the main goal, performs the unification, and replaces the target with the unified version of `t`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.by_cases", "description": "`by_cases p` splits the main goal into two cases, assuming `h : p` in the first branch, and\n`h : \u00ac p` in the second branch. You can specify the name of the new hypothesis using the syntax\n`by_cases h : p`.\n\nIf `p` is not already decidable, `by_cases` will use the instance `classical.prop_decidable p`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.focus", "description": "`focus { t }` temporarily hides all goals other than the first, applies `t`, and then restores the other goals. It fails if there are no goals.", "p": "mathlib"}, {"name": "tactic_doc.tactic.erewrite / erw", "description": "A variant of `rw` that uses the unifier more aggressively, unfolding semireducible definitions.", "p": "mathlib"}, {"name": "tactic_doc.tactic.success_if_fail", "description": "Succeeds if the given tactic fails.", "p": "mathlib"}, {"name": "tactic_doc.tactic.dsimp", "description": "`dsimp` is similar to `simp`, except that it only uses definitional equalities.", "p": "mathlib"}, {"name": "tactic_doc.tactic.apply", "description": "The `apply` tactic tries to match the current goal against the conclusion of the type of term. The argument term should be a term well-formed in the local context of the main goal. If it succeeds, then the tactic returns as many subgoals as the number of premises that have not been fixed by type inference or type class resolution. Non-dependent premises are added before dependent ones.\n\nThe `apply` tactic uses higher-order pattern matching, type class resolution, and first-order unification with dependent types.", "p": "mathlib"}, {"name": "tactic_doc.tactic.solve1", "description": "`solve1 { t }` applies the tactic `t` to the main goal and fails if it is not solved.", "p": "mathlib"}, {"name": "tactic_doc.tactic.introv", "description": "The tactic `introv` allows the user to automatically introduce the variables of a theorem and explicitly name the hypotheses involved. The given names are used to name non-dependent hypotheses.\n\nExamples:\n```lean\nexample : \u2200 a b : nat, a = b \u2192 b = a :=\nbegin\n  introv h,\n  exact h.symm\nend\n```\nThe state after `introv h` is\n```lean\na b : \u2115,\nh : a = b\n\u22a2 b = a\n```\n\n```lean\nexample : \u2200 a b : nat, a = b \u2192 \u2200 c, b = c \u2192 a = c :=\nbegin\n  introv h\u2081 h\u2082,\n  exact h\u2081.trans h\u2082\nend\n```\nThe state after `introv h\u2081 h\u2082` is\n```lean\na b : \u2115,\nh\u2081 : a = b,\nc : \u2115,\nh\u2082 : b = c\n\u22a2 a = c\n```", "p": "mathlib"}, {"name": "tactic_doc.tactic.repeat", "description": "`repeat { t }` applies `t` to each goal. If the application succeeds,\nthe tactic is applied recursively to all the generated subgoals until it eventually fails.\nThe recursion stops in a subgoal when the tactic has failed to make progress.\nThe tactic `repeat { t }` never fails.", "p": "mathlib"}, {"name": "tactic_doc.tactic.assume", "description": "Assuming the target of the goal is a Pi or a let, `assume h : t` unifies the type of the binder with `t` and introduces it with name `h`, just like `intro h`. If `h` is absent, the tactic uses the name `this`. If `t` is omitted, it will be inferred.\n\n`assume (h\u2081 : t\u2081) ... (h\u2099 : t\u2099)` introduces multiple hypotheses. Any of the types may be omitted, but the names must be present.", "p": "mathlib"}, {"name": "tactic_doc.tactic.conv: congr", "description": "Navigate into every argument of the current head function.\nA target of `| (a * b) * c` will turn into the two targets `| a * b` and `| c`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.with_cases", "description": "Apply `t` to the main goal and revert any new hypothesis in the generated goals.\nIf `t` is a supported tactic or chain of supported tactics (e.g. `induction`,\n`cases`, `apply`, `constructor`), the generated goals are also tagged with case\ntags. You can then use `case` to focus such tagged goals.\n\nTwo typical uses of `with_cases`:\n\n1. Applying a custom eliminator:\n\n   ```lean\n   lemma my_nat_rec :\n     \u2200 n {P : \u2115 \u2192 Prop} (zero : P 0) (succ : \u2200 n, P n \u2192 P (n + 1)), P n := ...\n\n   example (n : \u2115) : n = n :=\n   begin\n     with_cases { apply my_nat_rec n },\n     case zero { refl },\n     case succ : m ih { refl }\n   end\n   ```\n\n2. Enabling the use of `case` after a chain of case-splitting tactics:\n\n   ```lean\n   example (n m : \u2115) : unit :=\n   begin\n     with_cases { cases n; induction m },\n     case nat.zero nat.zero { exact () },\n     case nat.zero nat.succ : k { exact () },\n     case nat.succ nat.zero : i { exact () },\n     case nat.succ nat.succ : k i ih_i { exact () }\n   end\n   ```", "p": "mathlib"}, {"name": "tactic_doc.tactic.done", "description": "Fail if there are unsolved goals.", "p": "mathlib"}, {"name": "tactic_doc.tactic.by_contra / by_contradiction", "description": "If the target of the main goal is a proposition `p`, `by_contra h` reduces the goal to proving\n`false` using the additional hypothesis `h : \u00ac p`. If `h` is omitted, a name is generated\nautomatically.\n\nThis tactic requires that `p` is decidable. To ensure that all propositions are decidable via\nclassical reasoning, use `open_locale classical`\n(or `local attribute [instance, priority 10] classical.prop_decidable` if you are not using\nmathlib).", "p": "mathlib"}, {"name": "tactic_doc.tactic.try", "description": "`try { t }` tries to apply tactic `t`, but succeeds whether or not `t` succeeds.", "p": "mathlib"}, {"name": "tactic_doc.tactic.delta", "description": "Similar to `dunfold`, but performs a raw delta reduction, rather than using an equation associated with the defined constants.", "p": "mathlib"}, {"name": "tactic_doc.tactic.subst", "description": "Given hypothesis `h : x = t` or `h : t = x`, where `x` is a local constant, `subst h` substitutes `x` by `t` everywhere in the main goal and then clears `h`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.symmetry", "description": "This tactic applies to a goal whose target has the form `t ~ u` where `~` is a symmetric relation, that is, a relation which has a symmetry lemma tagged with the attribute `[symm]`. It replaces the target with `u ~ t`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.trace_simp_set", "description": "Just construct the simp set and trace it. Used for debugging.", "p": "mathlib"}, {"name": "tactic_doc.tactic.guard_hyp", "description": "`guard_hyp h : t` fails if the hypothesis `h` does not have type `t`.\nWe use this tactic for writing tests.", "p": "mathlib"}, {"name": "tactic_doc.tactic.assumption'", "description": "Try to apply `assumption` to all goals.", "p": "mathlib"}, {"name": "tactic_doc.tactic.have", "description": "`have h : t := p` adds the hypothesis `h : t` to the current goal if `p` a term of type `t`. If `t` is omitted, it will be inferred.\n\n`have h : t` adds the hypothesis `h : t` to the current goal and opens a new subgoal with target `t`. The new subgoal becomes the main goal. If `t` is omitted, it will be replaced by a fresh metavariable.\n\nIf `h` is omitted, the name `this` is used.", "p": "mathlib"}, {"name": "tactic_doc.tactic.ac_refl", "description": " Proves a goal of the form `s = t` when `s` and `t` are expressions built up out of a binary\noperation, and equality can be proved using associativity and commutativity of that operation.", "p": "mathlib"}, {"name": "tactic_doc.tactic.conv: to_lhs", "description": "Navigate to the left-hand-side of a relation.\nA goal of `| a = b` will turn into the goal `| a`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.contradiction", "description": "The contradiction tactic attempts to find in the current local context a hypothesis that is equivalent to an empty inductive type (e.g. `false`), a hypothesis of the form `c_1 ... = c_2 ...` where `c_1` and `c_2` are distinct constructors, or two contradictory hypotheses.", "p": "mathlib"}, {"name": "tactic_doc.tactic.rename", "description": "Rename one or more local hypotheses. The renamings are given as follows:\n\n```lean\nrename x y             -- rename x to y\nrename x \u2192 y           -- ditto\nrename [x y, a b]      -- rename x to y and a to b\nrename [x \u2192 y, a \u2192 b]  -- ditto\n```\n\nNote that if there are multiple hypotheses called `x` in the context, then\n`rename x y` will rename *all* of them. If you want to rename only one, use\n`dedup` first.", "p": "mathlib"}, {"name": "tactic_doc.tactic.cases_matching / casesm", "description": "`cases_matching p` applies the `cases` tactic to a hypothesis `h : type`\nif `type` matches the pattern `p`.\n\n`cases_matching [p_1, ..., p_n]` applies the `cases` tactic to a hypothesis `h : type`\nif `type` matches one of the given patterns.\n\n`cases_matching* p` is a more efficient and compact version\nof `focus1 { repeat { cases_matching p } }`.\nIt is more efficient because the pattern is compiled once.\n\n`casesm` is shorthand for `cases_matching`.\n\nExample: The following tactic destructs all conjunctions and disjunctions in the current context.\n```lean\ncases_matching* [_ \u2228 _, _ \u2227 _]\n```", "p": "mathlib"}, {"name": "tactic_doc.tactic.all_goals", "description": "`all_goals { t }` applies the tactic `t` to every goal, and succeeds if each application succeeds.", "p": "mathlib"}, {"name": "tactic_doc.tactic.subst_vars", "description": "Apply `subst` to all hypotheses of the form `h : x = t` or `h : t = x`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.from", "description": "A synonym for `exact` that allows writing `have/suffices/show ..., from ...` in tactic mode.", "p": "mathlib"}, {"name": "tactic_doc.tactic.left / right", "description": "`left` applies the first constructor when the type of the target is an inductive data type with\ntwo constructors.\n\nSimilarly, `right` applies the second constructor.", "p": "mathlib"}, {"name": "tactic_doc.tactic.econstructor", "description": "Similar to `constructor`, but only non-dependent premises are added as new goals.", "p": "mathlib"}, {"name": "tactic_doc.tactic.generalize", "description": "`generalize : e = x` replaces all occurrences of `e` in the target with a new hypothesis `x` of the same type.\n\n`generalize h : e = x` in addition registers the hypothesis `h : e = x`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.funext", "description": "Apply function extensionality and introduce new hypotheses.\nThe tactic `funext` will keep applying new the `funext` lemma until the goal target is not reducible\nto\n```lean\n  |-  ((fun x, ...) = (fun x, ...))\n```\nThe variant `funext h\u2081 ... h\u2099` applies `funext` `n` times, and uses the given identifiers to name\nthe new hypotheses.\n\nNote also the mathlib tactic `ext`, which applies as many extensionality lemmas as possible.", "p": "mathlib"}, {"name": "tactic_doc.tactic.rw / rewrite", "description": "`rw e` applies an equation or iff `e` as a rewrite rule to the main goal. If `e` is preceded by\nleft arrow (`\u2190` or `<-`), the rewrite is applied in the reverse direction. If `e` is a defined\nconstant, then the equational lemmas associated with `e` are used. This provides a convenient\nway to unfold `e`.\n\n`rw [e\u2081, ..., e\u2099]` applies the given rules sequentially.\n\n`rw e at l` rewrites `e` at location(s) `l`, where `l` is either `*` or a list of hypotheses\nin the local context. In the latter case, a turnstile `\u22a2` or `|-` can also be used, to signify\nthe target of the goal.\n\n`rewrite` is synonymous with `rw`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.conv: funext", "description": "Navigate into the contents of top-level `\u03bb` binders.\nA target of `| \u03bb a, a + b` will turn into the target `| a + b` and introduce `a` into the local\ncontext.\nIf there are multiple binders, all of them will be entered, and if there are none, this tactic is a\nno-op.", "p": "mathlib"}, {"name": "tactic_doc.tactic.conv: find", "description": "Navigate into the first scope matching the expression.\n\nFor a target of `| \u2200 c, a + (b + c) = 1`, `find (b + _) { ... }` will run the tactics within the\n`{}` with a target of `| b + c`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.refine", "description": "This tactic behaves like `exact`, but with a big difference: the user can put underscores `_` in the expression as placeholders for holes that need to be filled, and `refine` will generate as many subgoals as there are holes.\n\nNote that some holes may be implicit. The type of each hole must either be synthesized by the system or declared by an explicit type ascription like `(_ : nat \u2192 Prop)`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.trace", "description": "`trace a` displays `a` in the tracing buffer.", "p": "mathlib"}, {"name": "tactic_doc.tactic.type_check", "description": "Type check the given expression, and trace its type.", "p": "mathlib"}, {"name": "tactic_doc.tactic.async", "description": "Proves the first goal asynchronously as a separate lemma.", "p": "mathlib"}, {"name": "tactic_doc.tactic.apply_with", "description": "Similar to the `apply` tactic, but allows the user to provide a `apply_cfg` configuration object.", "p": "mathlib"}, {"name": "tactic_doc.tactic.conv: skip", "description": "End conversion of the current goal. This is often what is needed when muscle memory would type\n`sorry`.", "p": "mathlib"}, {"name": "tactic_doc.tactic.cases", "description": "Assuming `x` is a variable in the local context with an inductive type, `cases x` splits the main goal, producing one goal for each constructor of the inductive type, in which the target is replaced by a general instance of that constructor. If the type of an element in the local context depends on `x`, that element is reverted and reintroduced afterward, so that the case split affects that hypothesis as well.\n\nFor example, given `n : nat` and a goal with a hypothesis `h : P n` and target `Q n`, `cases n` produces one goal with hypothesis `h : P 0` and target `Q 0`, and one goal with hypothesis `h : P (nat.succ a)` and target `Q (nat.succ a)`. Here the name `a` is chosen automatically.\n\n`cases e`, where `e` is an expression instead of a variable, generalizes `e` in the goal, and then cases on the resulting variable.\n\n`cases e with y\u2081 ... y\u2099`, where `e` is a variable or an expression, specifies that the sequence of names `y\u2081 ... y\u2099` should be used for the arguments to the constructors, including implicit arguments. If the list does not include enough names for all of the arguments, additional names are generated automatically. If too many names are given, the extra ones are ignored. Underscores can be used in the list, in which case the corresponding names are generated automatically.\n\n`cases h : e`, where `e` is a variable or an expression, performs cases on `e` as above, but also adds a hypothesis `h : e = ...` to each hypothesis, where `...` is the constructor instance for that particular case.", "p": "mathlib"}, {"name": "tactic_doc.tactic.dunfold", "description": "Similar to `unfold`, but only uses definitional equalities.", "p": "mathlib"}, {"name": "tactic_doc.tactic.intro / intros", "description": "If the current goal is a Pi/forall `\u2200 x : t, u` (resp. `let x := t in u`) then `intro` puts\n`x : t` (resp. `x := t`) in the local context. The new subgoal target is `u`.\n\nIf the goal is an arrow `t \u2192 u`, then it puts `h : t` in the local context and the new goal\ntarget is `u`.\n\nIf the goal is neither a Pi/forall nor begins with a let binder, the tactic `intro` applies the\ntactic `whnf` until an introduction can be applied or the goal is not head reducible. In the latter\ncase, the tactic fails.\n\nThe variant `intro z` uses the identifier `z` to name the new hypothesis.\n\nThe variant `intros` will keep introducing new hypotheses until the goal target is not a Pi/forall\nor let binder.\n\nThe variant `intros h\u2081 ... h\u2099` introduces `n` new hypotheses using the given identifiers to name\nthem.", "p": "mathlib"}, {"name": "tactic_doc.tactic.constructor", "description": "This tactic applies to a goal such that its conclusion is an inductive type (say `I`). It tries to apply each constructor of `I` until it succeeds.", "p": "mathlib"}, {"name": "tactic_doc.tactic.unfold1", "description": "Similar to `unfold`, but does not iterate the unfolding.", "p": "mathlib"}, {"name": "tactic_doc.tactic.apply_opt_param", "description": "If the target of the main goal is an `opt_param`, assigns the default value.", "p": "mathlib"}, {"name": "multiset.Ico_filter_le", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_eq_zero_of_le", "description": "", "p": "mathlib"}, {"name": "multiset.right_not_mem_Ioo", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_filter_lt_of_le_left", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_inter_Ico", "description": "", "p": "mathlib"}, {"name": "multiset.map_add_right_Ioo", "description": "", "p": "mathlib"}, {"name": "multiset.card_Ico_eq_card_Icc_sub_one", "description": "", "p": "mathlib"}, {"name": "multiset.Ioc_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "multiset.Ioo_cons_left", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_filter_le_left", "description": "", "p": "mathlib"}, {"name": "multiset.left_mem_Icc", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "multiset.map_add_left_Ioo", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_filter_lt_of_le_right", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_inter_Ico_of_le", "description": "", "p": "mathlib"}, {"name": "multiset.nodup_Ioc", "description": "", "p": "mathlib"}, {"name": "multiset.nodup_Ioo", "description": "", "p": "mathlib"}, {"name": "multiset.Ioo_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "multiset.right_mem_Icc", "description": "", "p": "mathlib"}, {"name": "multiset.card_Ioc_eq_card_Icc_sub_one", "description": "", "p": "mathlib"}, {"name": "multiset.map_add_right_Ico", "description": "", "p": "mathlib"}, {"name": "multiset.card_Ioo_eq_card_Icc_sub_two", "description": "", "p": "mathlib"}, {"name": "multiset.left_not_mem_Ioc", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_subset_Ico_iff", "description": "", "p": "mathlib"}, {"name": "multiset.map_add_left_Ico", "description": "", "p": "mathlib"}, {"name": "multiset.right_mem_Ioc", "description": "", "p": "mathlib"}, {"name": "multiset.map_add_left_Ioc", "description": "", "p": "mathlib"}, {"name": "multiset.Ioc_eq_zero", "description": "**Alias** of the reverse direction of `multiset.Ioc_eq_zero_iff`.", "p": "mathlib"}, {"name": "multiset.Ico_filter_le_of_left_le", "description": "", "p": "mathlib"}, {"name": "multiset.left_not_mem_Ioo", "description": "", "p": "mathlib"}, {"name": "multiset.nodup_Ico", "description": "", "p": "mathlib"}, {"name": "multiset.nodup_Icc", "description": "", "p": "mathlib"}, {"name": "multiset.Ioc_self", "description": "", "p": "mathlib"}, {"name": "multiset.map_add_right_Icc", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_sub_Ico_left", "description": "", "p": "mathlib"}, {"name": "multiset.left_mem_Ico", "description": "", "p": "mathlib"}, {"name": "multiset.Icc_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "multiset.Ioo_eq_zero_of_le", "description": "", "p": "mathlib"}, {"name": "multiset.Ioo_eq_zero", "description": "", "p": "mathlib"}, {"name": "multiset.Icc_eq_zero_of_lt", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_add_Ico_eq_Ico", "description": "", "p": "mathlib"}, {"name": "multiset.map_add_right_Ioc", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_sub_Ico_right", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_filter_lt", "description": "", "p": "mathlib"}, {"name": "multiset.Ioo_self", "description": "", "p": "mathlib"}, {"name": "multiset.card_Ioo_eq_card_Ico_sub_one", "description": "", "p": "mathlib"}, {"name": "multiset.Ioc_eq_zero_of_le", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_filter_lt_of_right_le", "description": "", "p": "mathlib"}, {"name": "multiset.Icc_self", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_eq_zero", "description": "**Alias** of the reverse direction of `multiset.Ico_eq_zero_iff`.", "p": "mathlib"}, {"name": "multiset.Ico_cons_right", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_filter_le_of_right_le", "description": "", "p": "mathlib"}, {"name": "multiset.Ico_disjoint_Ico", "description": "", "p": "mathlib"}, {"name": "multiset.