er_unbounded", "description": "", "p": "mathlib"}, {"name": "continuous.if_le", "description": "", "p": "mathlib"}, {"name": "is_open_Ioo", "description": "", "p": "mathlib"}, {"name": "interior_Iio", "description": "", "p": "mathlib"}, {"name": "nhds_within_Ici_ne_bot", "description": "", "p": "mathlib"}, {"name": "disjoint_nhds_at_top", "description": "", "p": "mathlib"}, {"name": "dense.exists_lt", "description": "", "p": "mathlib"}, {"name": "filter.tendsto_nhds_min_right", "description": "", "p": "mathlib"}, {"name": "closure_Icc", "description": "", "p": "mathlib"}, {"name": "order_separated", "description": "", "p": "mathlib"}, {"name": "Icc_mem_nhds", "description": "", "p": "mathlib"}, {"name": "exists_Ico_subset_of_mem_nhds", "description": "", "p": "mathlib"}, {"name": "filter.tendsto_nhds_min_left", "description": "", "p": "mathlib"}, {"name": "filter.map_neg_eq_comap_neg", "description": "", "p": "mathlib"}, {"name": "nhds_within_Iio_ne_bot'", "description": "", "p": "mathlib"}, {"name": "Ico_mem_nhds", "description": "", "p": "mathlib"}, {"name": "tendsto_Ioo_at_top", "description": "", "p": "mathlib"}, {"name": "mem_nhds_within_Iic_iff_exists_Icc_subset", "description": " A set is a neighborhood of `a` within `(-\u221e, a]` if and only if it contains an interval `[l, a]`\nwith `l < a`.", "p": "mathlib"}, {"name": "monotone.map_csupr_of_continuous_at", "description": " If a monotone function is continuous at the indexed supremum of a bounded function on\na nonempty `Sort`, then it sends this supremum to the supremum of the composition.", "p": "mathlib"}, {"name": "not_tendsto_nhds_of_tendsto_at_bot", "description": "", "p": "mathlib"}, {"name": "map_coe_Ioo_at_bot", "description": "", "p": "mathlib"}, {"name": "continuous_within_at_Ioo_iff_Ioi", "description": "", "p": "mathlib"}, {"name": "nhds_basis_Ioo'", "description": "", "p": "mathlib"}, {"name": "inf_nhds_at_top", "description": "", "p": "mathlib"}, {"name": "nhds_eq_infi_abs_sub", "description": "", "p": "mathlib"}, {"name": "exists_seq_strict_mono_tendsto", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.min", "description": "", "p": "mathlib"}, {"name": "interior_Ioi", "description": "", "p": "mathlib"}, {"name": "is_closed.hypograph", "description": "", "p": "mathlib"}, {"name": "right_nhds_within_Ioo_ne_bot", "description": "", "p": "mathlib"}, {"name": "is_glb.mem_upper_bounds_of_tendsto", "description": "", "p": "mathlib"}, {"name": "mem_nhds_within_Ici_iff_exists_Icc_subset", "description": " A set is a neighborhood of `a` within `[a, +\u221e)` if and only if it contains an interval `[a, u]`\nwith `a < u`.", "p": "mathlib"}, {"name": "tendsto_nhds_top_mono'", "description": "", "p": "mathlib"}, {"name": "antitone.map_cSup_of_continuous_at", "description": " If an antitone function is continuous at the supremum of a nonempty bounded above set `s`,\nthen it sends this supremum to the infimum of the image of `s`.", "p": "mathlib"}, {"name": "nhds_within_Iio_self_ne_bot'", "description": "", "p": "mathlib"}, {"name": "closure_Ioo", "description": "The closure of the open interval `(a, b)` is the closed interval `[a, b]`.", "p": "mathlib"}, {"name": "exists_seq_strict_anti_tendsto_nhds_within", "description": "", "p": "mathlib"}, {"name": "nhds_bot_basis_Iic", "description": "", "p": "mathlib"}, {"name": "Ico_mem_nhds_within_Iic", "description": "", "p": "mathlib"}, {"name": "nhds_within_Ioi_self_ne_bot'", "description": "", "p": "mathlib"}, {"name": "nhds_within_Ioi_ne_bot'", "description": "", "p": "mathlib"}, {"name": "monotone.map_cSup_of_continuous_at", "description": " If a monotone function is continuous at the supremum of a nonempty bounded above set `s`,\nthen it sends this supremum to the supremum of the image of `s`.", "p": "mathlib"}, {"name": "is_lub_of_mem_closure", "description": "", "p": "mathlib"}, {"name": "dense_iff_exists_between", "description": " A set in a nontrivial densely linear ordered type is dense in the sense of topology if and only\nif for any `a < b` there exists `c \u2208 s`, `a < c < b`. Each implication requires less typeclass\nassumptions.", "p": "mathlib"}, {"name": "tendsto_order_unbounded", "description": "", "p": "mathlib"}, {"name": "frontier_Iio'", "description": "", "p": "mathlib"}, {"name": "exists_Icc_mem_subset_of_mem_nhds_within_Iic", "description": "", "p": "mathlib"}, {"name": "Ioo_subset_closure_interior", "description": "", "p": "mathlib"}, {"name": "tfae_mem_nhds_within_Ioi", "description": " The following statements are equivalent:\n\n0. `s` is a neighborhood of `a` within `(a, +\u221e)`\n1. `s` is a neighborhood of `a` within `(a, b]`\n2. `s` is a neighborhood of `a` within `(a, b)`\n3. `s` includes `(a, u)` for some `u \u2208 (a, b]`\n4. `s` includes `(a, u)` for some `u > a`", "p": "mathlib"}, {"name": "frontier_Ici_subset", "description": "", "p": "mathlib"}, {"name": "preorder.topology", "description": " (Order) topology on a partial order `\u03b1` generated by the subbase of open intervals\n`(a, \u221e) = { x \u2223 a < x }, (-\u221e , b) = {x \u2223 x < b}` for all `a, b` in `\u03b1`. We do not register it as an\ninstance as many ordered sets are already endowed with the same topology, most often in a non-defeq\nway though. Register as a local instance when necessary.", "p": "mathlib"}, {"name": "subtype.order_closed_topology", "description": "", "p": "mathlib"}, {"name": "monotone.map_cInf_of_continuous_at", "description": " If a monotone function is continuous at the infimum of a nonempty bounded below set `s`,\nthen it sends this infimum to the infimum of the image of `s`.", "p": "mathlib"}, {"name": "antitone.map_Sup_of_continuous_at'", "description": " An antitone function continuous at the supremum of a nonempty set sends this supremum to\nthe infimum of the image of this set.", "p": "mathlib"}, {"name": "ge_of_tendsto", "description": "", "p": "mathlib"}, {"name": "is_open_Iio", "description": "", "p": "mathlib"}, {"name": "nhds_bot_order", "description": "", "p": "mathlib"}, {"name": "classical.inhabited_of_nonempty'", "description": "Using `classical.choice`, lifts a (`Prop`-valued) `nonempty` instance to a (`Type`-valued)\n `inhabited` instance. `classical.inhabited_of_nonempty` already exists, in\n `core/init/classical.lean`, but the assumption is not a type class argument,\n which makes it unsuitable for some applications.", "p": "mathlib"}, {"name": "classical.arbitrary", "description": "Using `classical.choice`, extracts a term from a `nonempty` type.", "p": "mathlib"}, {"name": "nonempty_sum", "description": "", "p": "mathlib"}, {"name": "nonempty_sigma", "description": "", "p": "mathlib"}, {"name": "nonempty_empty", "description": "", "p": "mathlib"}, {"name": "nonempty_ulift", "description": "", "p": "mathlib"}, {"name": "nonempty.map2", "description": "", "p": "mathlib"}, {"name": "nonempty.map", "description": "Given `f : \u03b1 \u2192 \u03b2`, if `\u03b1` is nonempty then `\u03b2` is also nonempty.\n `nonempty` cannot be a `functor`, because `functor` is restricted to `Type`.", "p": "mathlib"}, {"name": "nonempty_psigma", "description": "", "p": "mathlib"}, {"name": "prod.nonempty", "description": "", "p": "mathlib"}, {"name": "nonempty.elim_to_inhabited", "description": "", "p": "mathlib"}, {"name": "function.surjective.nonempty", "description": "", "p": "mathlib"}, {"name": "nonempty_Prop", "description": "", "p": "mathlib"}, {"name": "pi.nonempty", "description": "", "p": "mathlib"}, {"name": "has_zero.nonempty", "description": "", "p": "mathlib"}, {"name": "nonempty_subtype", "description": "", "p": "mathlib"}, {"name": "nonempty.some", "description": "Using `classical.choice`, extracts a term from a `nonempty` type.", "p": "mathlib"}, {"name": "subsingleton_of_not_nonempty", "description": "", "p": "mathlib"}, {"name": "classical.nonempty_pi", "description": "", "p": "mathlib"}, {"name": "nonempty.congr", "description": "", "p": "mathlib"}, {"name": "nonempty_plift", "description": "", "p": "mathlib"}, {"name": "exists_true_iff_nonempty", "description": "", "p": "mathlib"}, {"name": "has_one.nonempty", "description": "", "p": "mathlib"}, {"name": "nonempty.exists", "description": "", "p": "mathlib"}, {"name": "nonempty_psum", "description": "", "p": "mathlib"}, {"name": "not_nonempty_iff_imp_false", "description": "", "p": "mathlib"}, {"name": "nonempty_prod", "description": "", "p": "mathlib"}, {"name": "nonempty_pprod", "description": "", "p": "mathlib"}, {"name": "nonempty.forall", "description": "", "p": "mathlib"}, {"name": "finset.center_mass_singleton", "description": "", "p": "mathlib"}, {"name": "mem_Icc_of_mem_std_simplex", "description": "All values of a function `f \u2208 std_simplex \ud835\udd5c \u03b9` belong to `[0, 1]`.", "p": "mathlib"}, {"name": "finset.center_mass_pair", "description": "", "p": "mathlib"}, {"name": "convex_iff_sum_mem", "description": "", "p": "mathlib"}, {"name": "convex.finsum_mem", "description": " A version of `convex.sum_mem` for `finsum`s. If `s` is a convex set, `w : \u03b9 \u2192 R` is a family of\nnonnegative weights with sum one and `z : \u03b9 \u2192 E` is a family of elements of a module over `R` such\nthat `z i \u2208 s` whenever `w i \u2260 0``, then the sum `\u2211\u1da0 i, w i \u2022 z i` belongs to `s`. See also\n`partition_of_unity.finsum_smul_mem_convex`.", "p": "mathlib"}, {"name": "convex.center_mass_mem", "description": " The center of mass of a finite subset of a convex set belongs to the set\nprovided that all weights are non-negative, and the total weight is positive.", "p": "mathlib"}, {"name": "finset.inf_le_center_mass", "description": "", "p": "mathlib"}, {"name": "finset.center_mass", "description": " Center of mass of a finite collection of points with prescribed weights.\nNote that we require neither `0 \u2264 w i` nor `\u2211 w = 1`.", "p": "mathlib"}, {"name": "finset.center_mass_ite_eq", "description": "", "p": "mathlib"}, {"name": "convex.sum_mem", "description": "", "p": "mathlib"}, {"name": "affine_combination_eq_center_mass", "description": "", "p": "mathlib"}, {"name": "convex_hull_list_sum", "description": "", "p": "mathlib"}, {"name": "convex_hull_sub", "description": "", "p": "mathlib"}, {"name": "convex_hull_range_eq_exists_affine_combination", "description": "", "p": "mathlib"}, {"name": "convex_hull_multiset_sum", "description": "", "p": "mathlib"}, {"name": "convex_hull_eq_union_convex_hull_finite_subsets", "description": "A weak version of Carath\u00e9odory's theorem.", "p": "mathlib"}, {"name": "finset.center_mass_id_mem_convex_hull", "description": " A refinement of `finset.center_mass_mem_convex_hull` when the indexed family is a `finset` of\nthe space.", "p": "mathlib"}, {"name": "finset.mem_convex_hull", "description": "", "p": "mathlib"}, {"name": "affine_combination_mem_convex_hull", "description": "", "p": "mathlib"}, {"name": "finset.center_mass_segment", "description": " A convex combination of two centers of mass is a center of mass as well. This version\nworks if two centers of mass share the set of original points.", "p": "mathlib"}, {"name": "finset.center_mass_le_sup", "description": "", "p": "mathlib"}, {"name": "finset.center_mass_empty", "description": "", "p": "mathlib"}, {"name": "convex_hull_basis_eq_std_simplex", "description": "`std_simplex \ud835\udd5c \u03b9` is the convex hull of the canonical basis in `\u03b9 \u2192 \ud835\udd5c`.", "p": "mathlib"}, {"name": "finset.center_mass_mem_convex_hull", "description": "", "p": "mathlib"}, {"name": "finset.center_mass_segment'", "description": " A convex combination of two centers of mass is a center of mass as well. This version\ndeals with two different index types.", "p": "mathlib"}, {"name": "affine_basis.convex_hull_eq_nonneg_coord", "description": " The convex hull of an affine basis is the intersection of the half-spaces defined by the\ncorresponding barycentric coordinates.", "p": "mathlib"}, {"name": "finset.centroid_mem_convex_hull", "description": "", "p": "mathlib"}, {"name": "convex_hull_add", "description": "", "p": "mathlib"}, {"name": "set.finite.convex_hull_eq", "description": "", "p": "mathlib"}, {"name": "mk_mem_convex_hull_prod", "description": "", "p": "mathlib"}, {"name": "finset.center_mass_filter_ne_zero", "description": "", "p": "mathlib"}, {"name": "set.finite.convex_hull_eq_image", "description": " The convex hull of a finite set is the image of the standard simplex in `s \u2192 \u211d`\nunder the linear map sending each function `w` to `\u2211 x in s, w x \u2022 x`.\n\nSince we have no sums over finite sets, we use sum over `@finset.univ _ hs.fintype`.\nThe map is defined in terms of operations on `(s \u2192 \u211d) \u2192\u2097[\u211d] \u211d` so that later we will not need\nto prove that this map is linear.", "p": "mathlib"}, {"name": "convex_hull_prod", "description": "", "p": "mathlib"}, {"name": "finset.center_mass_subset", "description": "", "p": "mathlib"}, {"name": "finset.convex_hull_eq", "description": "", "p": "mathlib"}, {"name": "convex_hull_eq", "description": " Convex hull of `s` is equal to the set of all centers of masses of `finset`s `t`, `z '' t \u2286 s`.\nThis version allows finsets in any type in any universe.", "p": "mathlib"}, {"name": "convex_hull_sum", "description": "", "p": "mathlib"}, {"name": "finset.center_mass_insert", "description": "", "p": "mathlib"}, {"name": "finset.center_mass_smul", "description": "", "p": "mathlib"}, {"name": "finset.center_mass_eq_of_sum_1", "description": "", "p": "mathlib"}, {"name": "convex_hull_add_monoid_hom", "description": "`convex_hull` is an additive monoid morphism under pointwise addition.", "p": "mathlib"}, {"name": "finset.centroid_eq_center_mass", "description": "The centroid can be regarded as a center of mass.", "p": "mathlib"}, {"name": "convex_hull_add_monoid_hom_apply", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.comp_prod_apply_univ_le", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.set_lintegral_comp_prod", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.map", "description": " The pushforward of a kernel along a measurable function.\nWe include measurability in the assumptions instead of using junk values\nto make sure that typeclass inference can infer that the `map` of a Markov kernel\nis again a Markov kernel.", "p": "mathlib"}, {"name": "probability_theory.kernel.comp_prod_apply_eq_comp_prod_fun", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.measurable_comp_prod_fun_of_finite", "description": "Auxiliary lemma for `measurable_comp_prod_fun`.", "p": "mathlib"}, {"name": "probability_theory.kernel.map_apply'", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.is_markov_kernel.prod_mk_left", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.comp_prod_fun", "description": " Auxiliary function for the definition of the composition-product of two kernels.\nFor all `a : \u03b1`, `comp_prod_fun \u03ba \u03b7 a` is a countably additive function with value zero on the empty\nset, and the composition-product of kernels is defined in `kernel.comp_prod` through\n`measure.of_measurable`.", "p": "mathlib"}, {"name": "probability_theory.kernel.lintegral_fst", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.comp", "description": "Composition of two s-finite kernels.", "p": "mathlib"}, {"name": "probability_theory.kernel.is_finite_kernel.fst", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.prod", "description": "Product of two s-finite kernels.", "p": "mathlib"}, {"name": "probability_theory.kernel.comp_prod_fun_Union", "description": "", "p": "mathlib"}, {"name": "probability_theory.kernel.snd", "description": "Define a `kernel \u03b1 \u03b3` from a `kernel \u03b1 (\u03b2 \u00d7 \u03b3)` by taking the map of the second projection.", "p": "mathlib"}, {"name": "probability_theory.kernel.i