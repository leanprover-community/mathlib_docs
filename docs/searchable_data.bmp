m_monoid_with_zero.min", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.min_def", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.mul", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.mul_assoc", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.one", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.one_mul", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.mul_one", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.npow", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.npow_zero'", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.npow_succ'", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.mul_comm", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.mul_le_mul_left", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.zero", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.zero_mul", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.mul_zero", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.zero_le_one", "description": "A linearly ordered commutative monoid with a zero element.", "p": "mathlib"}, {"name": "with_zero.linear_order", "description": "", "p": "mathlib"}, {"name": "with_zero.canonically_ordered_add_monoid", "description": "Adding a new zero to a canonically ordered additive monoid produces another one.", "p": "mathlib"}, {"name": "with_zero.le_max_iff", "description": "", "p": "mathlib"}, {"name": "with_zero.preorder", "description": "", "p": "mathlib"}, {"name": "with_zero.ordered_add_comm_monoid", "description": "If `0` is the least element in `\u03b1`, then `with_zero \u03b1` is an `ordered_add_comm_monoid`.\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "with_zero.order_bot", "description": "", "p": "mathlib"}, {"name": "with_zero.min_le_iff", "description": "", "p": "mathlib"}, {"name": "with_zero.has_exists_add_of_le", "description": "", "p": "mathlib"}, {"name": "with_zero.zero_lt_coe", "description": "", "p": "mathlib"}, {"name": "with_zero.covariant_class_add_le", "description": "", "p": "mathlib"}, {"name": "canonically_ordered_add_monoid.to_zero_le_one_class", "description": "", "p": "mathlib"}, {"name": "with_zero.zero_eq_bot", "description": "", "p": "mathlib"}, {"name": "with_zero.zero_le", "description": "", "p": "mathlib"}, {"name": "with_zero.lattice", "description": "", "p": "mathlib"}, {"name": "with_zero.canonically_linear_ordered_add_monoid", "description": "", "p": "mathlib"}, {"name": "linear_ordered_comm_monoid_with_zero.to_linear_ordered_comm_monoid", "description": "", "p": "mathlib"}, {"name": "with_zero.ordered_comm_monoid", "description": "", "p": "mathlib"}, {"name": "with_zero.partial_order", "description": "", "p": "mathlib"}, {"name": "with_zero.covariant_class_mul_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.rn_deriv", "description": " If a pair of measures `have_lebesgue_decomposition`, then `rn_deriv` chooses the\nmeasurable function from `have_lebesgue_decomposition`, otherwise it returns the zero function.\nFor sigma-finite measures, `\u03bc = \u03bc.singular_part \u03bd + \u03bd.with_density (\u03bc.rn_deriv \u03bd)`.", "p": "mathlib"}, {"name": "measure_theory.signed_measure.have_lebesgue_decomposition_mk", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.rn_deriv_sub", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.rn_deriv_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.rn_deriv", "description": " The Radon-Nikodym derivative between a signed measure and a positive measure.\n\n`rn_deriv s \u03bc` satisfies `\u03bc.with_density\u1d65 (s.rn_deriv \u03bc) = s`\nif and only if `s` is absolutely continuous with respect to `\u03bc` and this fact is known as\n`measure_theory.signed_measure.absolutely_continuous_iff_with_density_rn_deriv_eq`\nand can be found in `measure_theory.decomposition.radon_nikodym`.", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.restrict.measure_theory.is_finite_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.rn_deriv_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.supr_monotone", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.singular_part.measure_theory.is_locally_finite_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.eq_with_density_rn_deriv", "description": " Given measures `\u03bc` and `\u03bd`, if `s` is a measure mutually singular to `\u03bd` and `f` is a\nmeasurable function such that `\u03bc = s + f\u03bd`, then `f = \u03bc.rn_deriv \u03bd`.\n\nThis theorem provides the uniqueness of the `rn_deriv` in the Lebesgue decomposition\ntheorem, while `measure_theory.measure.eq_singular_part` provides the uniqueness of the\n`singular_part`. Here, the uniqueness is given in terms of the measures, while the uniqueness in\nterms of the functions is given in `eq_rn_deriv`.", "p": "mathlib"}, {"name": "measure_theory.measure.with_density.measure_theory.is_finite_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.singular_part_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.mutually_singular_singular_part", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.singular_part", "description": " If a pair of measures `have_lebesgue_decomposition`, then `singular_part` chooses the\nmeasure from `have_lebesgue_decomposition`, otherwise it returns the zero measure. For sigma-finite\nmeasures, `\u03bc = \u03bc.singular_part \u03bd + \u03bd.with_density (\u03bc.rn_deriv \u03bd)`.", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.measurable_le_eval", "description": "`measurable_le_eval \u03bc \u03bd` is the set of `\u222b\u207b x, f x \u2202\u03bc` for all `f \u2208 measurable_le \u03bc \u03bd`.", "p": "mathlib"}, {"name": "measure_theory.complex_measure.have_lebesgue_decomposition", "description": " A complex measure is said to `have_lebesgue_decomposition` with respect to a positive measure\nif both its real and imaginary part `have_lebesgue_decomposition` with respect to that measure.", "p": "mathlib"}, {"name": "measure_theory.complex_measure.have_lebesgue_decomposition.re_part", "description": " A complex measure is said to `have_lebesgue_decomposition` with respect to a positive measure\nif both its real and imaginary part `have_lebesgue_decomposition` with respect to that measure.", "p": "mathlib"}, {"name": "measure_theory.complex_measure.have_lebesgue_decomposition.im_part", "description": " A complex measure is said to `have_lebesgue_decomposition` with respect to a positive measure\nif both its real and imaginary part `have_lebesgue_decomposition` with respect to that measure.", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.supr_le_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.supr_succ_eq_sup", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.integrable_rn_deriv", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.singular_part.measure_theory.is_finite_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.measurable_rn_deriv", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.with_density.measure_theory.is_locally_finite_measure", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.with_density_rn_deriv_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part_sub", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.have_lebesgue_decomposition_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.measurable_rn_deriv", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.have_lebesgue_decomposition_of_sigma_finite", "description": "", "p": "mathlib"}, {"name": "measure_theory.complex_measure.singular_part_add_with_density_rn_deriv_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.rn_deriv_lt_top", "description": " The Radon-Nikodym derivative of a sigma-finite measure `\u03bc` with respect to another\nmeasure `\u03bd` is `\u03bd`-almost everywhere finite.", "p": "mathlib"}, {"name": "measure_theory.complex_measure.rn_deriv", "description": "The Radon-Nikodym derivative between a complex measure and a positive measure.", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part", "description": " Given a signed measure `s` and a measure `\u03bc`, `s.singular_part \u03bc` is the signed measure\nsuch that `s.singular_part \u03bc + \u03bc.with_density\u1d65 (s.rn_deriv \u03bc) = s` and\n`s.singular_part \u03bc` is mutually singular with respect to `\u03bc`.", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part_mutually_singular", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.to_jordan_decomposition_eq_of_eq_add_with_density", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.rn_deriv_restrict", "description": " The Radon-Nikodym derivative of the restriction of a measure to a measurable set is the\nindicator function of this set.", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.supr_mem_measurable_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.lintegral_rn_deriv_lt_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.singular_part_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.have_lebesgue_decomposition_smul_real", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part_add_with_density_rn_deriv_eq", "description": " **The Lebesgue Decomposition theorem between a signed measure and a measure**:\nGiven a signed measure `s` and a \u03c3-finite measure `\u03bc`, there exist a signed measure `t` and a\nmeasurable and integrable function `f`, such that `t` is mutually singular with respect to `\u03bc`\nand `s = t + \u03bc.with_density\u1d65 f`. In this case `t = s.singular_part \u03bc` and\n`f = s.rn_deriv \u03bc`.", "p": "mathlib"}, {"name": "measure_theory.measure.have_lebesgue_decomposition_of_finite_measure", "description": " Any pair of finite measures `\u03bc` and `\u03bd`, `have_lebesgue_decomposition`. That is to say,\nthere exist a measure `\u03be` and a measurable function `f`, such that `\u03be` is mutually singular\nwith respect to `\u03bd` and `\u03bc = \u03be + \u03bd.with_density f`.\n\nThis is not an instance since this is also shown for the more general \u03c3-finite measures with\n`measure_theory.measure.have_lebesgue_decomposition_of_sigma_finite`.", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part_total_variation", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.measurable_le", "description": " Given two measures `\u03bc` and `\u03bd`, `measurable_le \u03bc \u03bd` is the set of measurable\nfunctions `f`, such that, for all measurable sets `A`, `\u222b\u207b x in A, f x \u2202\u03bc \u2264 \u03bd A`.\n\nThis is useful for the Lebesgue decomposition theorem.", "p": "mathlib"}, {"name": "measure_theory.measure.singular_part.measure_theory.sigma_finite", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.singular_part_zero", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.not_have_lebesgue_decomposition_iff", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.rn_deriv_with_density", "description": "The Radon-Nikodym derivative of `f \u03bd` with respect to `\u03bd` is `f`.", "p": "mathlib"}, {"name": "measure_theory.signed_measure.have_lebesgue_decomposition_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.mutually_singular_singular_part", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.eq_rn_deriv", "description": " Given a measure `\u03bc`, signed measures `s` and `t`, and a function `f` such that `t` is\nmutually singular with respect to `\u03bc` and `s = t + \u03bc.with_density\u1d65 f`, we have\n`f = rn_deriv s \u03bc`, i.e. `f` is the Radon-Nikodym derivative of `s` and `\u03bc`.", "p": "mathlib"}, {"name": "measure_theory.complex_measure.integrable_rn_deriv", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.sup_mem_measurable_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.singular_part_smul_nnreal", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.have_lebesgue_decomposition_neg", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.eq_singular_part", "description": " Given a measure `\u03bc`, signed measures `s` and `t`, and a function `f` such that `t` is\nmutually singular with respect to `\u03bc` and `s = t + \u03bc.with_density\u1d65 f`, we have\n`t = singular_part s \u03bc`, i.e. `t` is the singular part of the Lebesgue decomposition between\n`s` and `\u03bc`.", "p": "mathlib"}, {"name": "measure_theory.measure.singular_part_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.have_lebesgue_decomposition", "description": " A signed measure `s` is said to `have_lebesgue_decomposition` with respect to a measure `\u03bc`\nif the positive part and the negative part of `s` both `have_lebesgue_decomposition` with\nrespect to `\u03bc`.", "p": "mathlib"}, {"name": "measure_theory.signed_measure.have_lebesgue_decomposition.pos_part", "description": " A signed measure `s` is said to `have_lebesgue_decomposition` with respect to a measure `\u03bc`\nif the positive part and the negative part of `s` both `have_lebesgue_decomposition` with\nrespect to `\u03bc`.", "p": "mathlib"}, {"name": "measure_theory.signed_measure.have_lebesgue_decomposition.neg_part", "description": " A signed measure `s` is said to `have_lebesgue_decomposition` with respect to a measure `\u03bc`\nif the positive part and the negative part of `s` both `have_lebesgue_decomposition` with\nrespect to `\u03bc`.", "p": "mathlib"}, {"name": "measure_theory.measure.lintegral_rn_deriv_lt_top_of_measure_ne_top", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.eq_singular_part", "description": " Given measures `\u03bc` and `\u03bd`, if `s` is a measure mutually singular to `\u03bd` and `f` is a\nmeasurable function such that `\u03bc = s + f\u03bd`, then `s = \u03bc.singular_part \u03bc`.\n\nThis theorem provides the uniqueness of the `singular_part` in the Lebesgue decomposition theorem,\nwhile `measure_theory.measure.eq_rn_deriv` provides the uniqueness of the\n`rn_deriv`.", "p": "mathlib"}, {"name": "measure_theory.measure.singular_part_with_density", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.have_lebesgue_decomposition_spec", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.exists_positive_of_not_mutually_singular", "description": " If two finite measures `\u03bc` and `\u03bd` are not mutually singular, there exists some `\u03b5 > 0` and\na measurable set `E`, such that `\u03bd(E) > 0` and `E` is positive with respect to `\u03bc - \u03b5\u03bd`.\n\nThis lemma is useful for the Lebesgue decomposition theorem.", "p": "mathlib"}, {"name": "measure_theory.measure.with_density.measure_theory.sigma_finite", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.have_lebesgue_decomposition_smul", "description": "", "p": "mathlib"}, {"name": "measure_theory.complex_measure.singular_part", "description": " The singular part between a complex measure `c` and a positive measure `\u03bc` is the complex\nmeasure satisfying `c.singular_part \u03bc + \u03bc.with_density\u1d65 (c.rn_deriv \u03bc) = c`. This property is given\nby `measure_theory.complex_measure.singular_part_add_with_density_rn_deriv_eq`.", "p": "mathlib"}, {"name": "measure_theory.measure.eq_rn_deriv", "description": " Given measures `\u03bc` and `\u03bd`, if `s` is a measure mutually singular to `\u03bd` and `f` is a\nmeasurable function such that `\u03bc = s + f\u03bd`, then `f = \u03bc.rn_deriv \u03bd`.\n\nThis theorem provides the uniqueness of the `rn_deriv` in the Lebesgue decomposition\ntheorem, while `measure_theory.measure.eq_singular_part` provides the uniqueness of the\n`singular_part`. Here, the uniqueness is given in terms of the functions, while the uniqueness in\nterms of the functions is given in `eq_with_density_rn_deriv`.", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.supr_mem_measurable_le'", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.have_lebesgue_decomposition_of_sigma_finite", "description": " **The Lebesgue decomposition theorem**: Any pair of \u03c3-finite measures `\u03bc` and `\u03bd`\n`have_lebesgue_decomposition`. That is to say, there exist a measure `\u03be` and a measurable function\n`f`, such that `\u03be` is mutually singular with respect to `\u03bd` and `\u03bc = \u03be + \u03bd.with_density f`", "p": "mathlib"}, {"name": "measure_theory.measure.have_lebesgue_decomposition", "description": " A pair of measures `\u03bc` and `\u03bd` is said to `have_lebesgue_decomposition` if there exists a\nmeasure `\u03be` and a measurable function `f`, such that `\u03be` is mutually singular with respect to\n`\u03bd` and `\u03bc = \u03be + \u03bd.with_density f`.", "p": "mathlib"}, {"name": "measure_theory.measure.have_lebesgue_decomposition.lebesgue_decomposition", "description": " A pair of measures `\u03bc` and `\u03bd` is said to `have_lebesgue_decomposition` if there exists a\nmeasure `\u03be` and a measurable function `f`, such that `\u03be` is mutually singular with respect to\n`\u03bd` and `\u03bc = \u03be + \u03bd.with_density f`.", "p": "mathlib"}, {"name": "measure_theory.signed_measure.rn_deriv_add", "description": "", "p": "mathlib"}, {"name": "measure_theory.signed_measure.jordan_decomposition_add_with_density_mutually_singular", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.zero_mem_measurable_le", "description": "", "p": "mathlib"}, {"name": "measure_theory.measure.lebesgue_decomposition.supr_monotone'", "description": "", "p": "mathlib"}, {"name": "option.mem_pmem", "description": "", "p": "mathlib"}, {"name": "option.pmap_map", "description": "", "p": "mathlib"}, {"name": "option.mem_map_of_mem", "description": "", "p": "mathlib"}, {"name": "option.map_map", "description": "", "p": "mathlib"}, {"name": "option.is_none_some", "description": "", "p": "mathlib"}, {"name": "option.map_bind", "description": "", "p": "mathlib"}, {"name": "option.bind_eq_none'", "description": "", "p": "mathlib"}, {"name": "option.pmap_some", "description": "", "p": "mathlib"}, {"name": "option.cases_on'", "description": " Given an element of `a : option \u03b1`, a default element `b : \u03b2` and a function `\u03b1 \u2192 \u03b2`, apply this\nfunction to `a` if it comes from `\u03b1`, and return `b` otherwise.", "p": "mathlib"}, {"name": "option.ne_none_iff_exists", "description": "", "p": "mathlib"}, {"name": "option.cases_on'_none", "description": "", "p": "mathlib"}, {"name": "option.bind_pmap", "description": "", "p": "mathlib"}, {"name": "option.mem.left_unique", "description": "", "p": "mathlib"}, {"name": "option.ext", "description": "", "p": "mathlib"}, {"name": "option.pbind_map", "description": "", "p": "mathlib"}, {"name": "option.coe_get", "description": "", "p": "mathlib"}, {"name": "option.guard_eq_some'", "description": "", "p": "mathlib"}, {"name": "option.cases_on'_coe", "description": "", "p": "mathlib"}, {"name": "option.get_or_else_map", "description": "", "p": "mathlib"}, {"name": "option.join_ne_none", "description": "", "p": "mathlib"}, {"name": "option.get_or_else_some", "description": "", "p": "mathlib"}, {"name": "option.pmap_none", "description": "", "p": "mathlib"}, {"name": "option.orelse_none", "description": "", "p": "mathlib"}, {"name": "option.get_of_mem", "description": "", "p": "mathlib"}, {"name": "option.orelse_eq_none", "description": "", "p": "mathlib"}, {"name": "option.map_none