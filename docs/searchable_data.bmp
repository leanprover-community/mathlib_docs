cont_on_cl.const_add", "description": "", "p": "mathlib"}, {"name": "differentiable_on.diff_cont_on_cl_ball", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl", "description": " A predicate saying that a function is differentiable on a set and is continuous on its\nclosure. This is a common assumption in complex analysis.", "p": "mathlib"}, {"name": "diff_cont_on_cl.differentiable_on", "description": " A predicate saying that a function is differentiable on a set and is continuous on its\nclosure. This is a common assumption in complex analysis.", "p": "mathlib"}, {"name": "diff_cont_on_cl.continuous_on", "description": " A predicate saying that a function is differentiable on a set and is continuous on its\nclosure. This is a common assumption in complex analysis.", "p": "mathlib"}, {"name": "differentiable.diff_cont_on_cl", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.sub_const", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl_univ", "description": "", "p": "mathlib"}, {"name": "differentiable.comp_diff_cont_on_cl", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.const_smul", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.smul_const", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.sub", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.continuous_on_ball", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.smul", "description": "", "p": "mathlib"}, {"name": "differentiable_on.diff_cont_on_cl", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.add", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.neg", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.add_const", "description": "", "p": "mathlib"}, {"name": "is_closed.diff_cont_on_cl_iff", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.const_sub", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.mono", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.inv", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.comp", "description": "", "p": "mathlib"}, {"name": "diff_cont_on_cl.differentiable_at'", "description": "", "p": "mathlib"}, {"name": "add_monoid_hom.to_real_linear_map", "description": " Reinterpret a continuous additive homomorphism between two real vector spaces\nas a continuous real-linear map.", "p": "mathlib"}, {"name": "add_equiv.to_real_linear_equiv", "description": " Reinterpret a continuous additive equivalence between two real vector spaces\nas a continuous real-linear map.", "p": "mathlib"}, {"name": "real.is_scalar_tower", "description": " A topological group carries at most one structure of a topological `\u211d`-module, so for any\ntopological `\u211d`-algebra `A` (e.g. `A = \u2102`) and any topological group that is both a topological\n`\u211d`-module and a topological `A`-module, these structures agree.", "p": "mathlib"}, {"name": "map_real_smul", "description": "A continuous additive map between two vector spaces over `\u211d` is `\u211d`-linear.", "p": "mathlib"}, {"name": "add_monoid_hom.coe_to_real_linear_map", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.colimits.prequotient.inhabited", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.colimits.desc_fun", "description": "The function from the colimit abelian group to the cone point of any other cocone.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.cocone_morphism", "description": " The group homomorphism from a given abelian group in the diagram to the colimit abelian\ngroup.", "p": "mathlib"}, {"name": "AddCommGroup.cokernel_iso_quotient", "description": "The categorical cokernel of a morphism in `AddCommGroup`\nagrees with the usual group-theoretical quotient.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.colimit_type.add_comm_group", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.colimits.colimit_setoid", "description": "The setoid corresponding to group expressions modulo abelian group relations and identifications.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.desc_morphism", "description": "The group homomorphism from the colimit abelian group to the cone point of any other cocone.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.colimit_cocone", "description": "The cocone over the proposed colimit abelian group.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.quot_neg", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.colimits.colimit_type", "description": "The underlying type of the colimit of a diagram in `AddCommGroup`.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.quot_zero", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.colimits.quot_add", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.colimits.desc_fun_lift", "description": " The function from the free abelian group on the diagram to the cone point of any other\ncocone.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.cocone_naturality_components", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.refl", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.symm", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.trans", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.map", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.zero", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.neg", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.add", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.neg_1", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.add_1", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.add_2", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.zero_add", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.add_zero", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.add_left_neg", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.add_comm", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.relation.add_assoc", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the abelian group laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.cocone_fun", "description": "The function from a given abelian group in the diagram to the colimit abelian group.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.colimit", "description": "The bundled abelian group giving the colimit of a diagram.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.has_colimits_AddCommGroup", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.colimits.colimit_cocone_is_colimit", "description": "Evidence that the proposed colimit is the colimit.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.colimit_type.inhabited", "description": "", "p": "mathlib"}, {"name": "AddCommGroup.colimits.prequotient", "description": "An inductive type representing all group expressions (without relations)\non a collection of types indexed by the objects of `J`.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.prequotient.of", "description": "An inductive type representing all group expressions (without relations)\non a collection of types indexed by the objects of `J`.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.prequotient.zero", "description": "An inductive type representing all group expressions (without relations)\non a collection of types indexed by the objects of `J`.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.prequotient.neg", "description": "An inductive type representing all group expressions (without relations)\non a collection of types indexed by the objects of `J`.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.prequotient.add", "description": "An inductive type representing all group expressions (without relations)\non a collection of types indexed by the objects of `J`.", "p": "mathlib"}, {"name": "AddCommGroup.colimits.cocone_naturality", "description": "", "p": "mathlib"}, {"name": "measure_theory.conservative.inter_frequently_image_mem_ae_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.conservative.frequently_measure_inter_ne_zero", "description": " If `f` is a conservative map and `s` is a measurable set of nonzero measure, then\nfor infinitely many values of `m` a positive measure of points `x \u2208 s` returns back to `s`\nafter `m` iterations of `f`.", "p": "mathlib"}, {"name": "measure_theory.conservative.ae_frequently_mem_of_mem_nhds", "description": " Poincar\u00e9 recurrence theorem. Let `f : \u03b1 \u2192 \u03b1` be a conservative dynamical system on a topological\nspace with second countable topology and measurable open sets. Then almost every point `x : \u03b1`\nis recurrent: it visits every neighborhood `s \u2208 \ud835\udcdd x` infinitely many times.", "p": "mathlib"}, {"name": "measure_theory.conservative.ae_forall_image_mem_imp_frequently_image_mem", "description": " Poincar\u00e9 recurrence theorem: if `f` is a conservative dynamical system and `s` is a measurable\nset, then for `\u03bc`-a.e. `x`, if the orbit of `x` visits `s` at least once, then it visits `s`\ninfinitely many times.", "p": "mathlib"}, {"name": "measure_theory.conservative.iterate", "description": "Iteration of a conservative system is a conservative system.", "p": "mathlib"}, {"name": "measure_theory.conservative.measure_inter_frequently_image_mem_eq", "description": "", "p": "mathlib"}, {"name": "measure_theory.conservative.frequently_ae_mem_and_frequently_image_mem", "description": " If `f` is a conservative self-map and `s` is a measurable set of positive measure, then\n`\u03bc.ae`-frequently we have `x \u2208 s` and `s` returns to `s` under infinitely many iterations of `f`.", "p": "mathlib"}, {"name": "measure_theory.conservative.exists_gt_measure_inter_ne_zero", "description": " If `f` is a conservative map and `s` is a measurable set of nonzero measure, then\nfor an arbitrarily large `m` a positive measure of points `x \u2208 s` returns back to `s`\nafter `m` iterations of `f`.", "p": "mathlib"}, {"name": "measure_theory.measure_preserving.conservative", "description": "A self-map preserving a finite measure is conservative.", "p": "mathlib"}, {"name": "measure_theory.conservative.ae_mem_imp_frequently_image_mem", "description": " Poincar\u00e9 recurrence theorem: given a conservative map `f` and a measurable set `s`,\nalmost every point `x \u2208 s` returns back to `s` infinitely many times.", "p": "mathlib"}, {"name": "measure_theory.conservative.id", "description": "The identity map is conservative w.r.t. any measure.", "p": "mathlib"}, {"name": "measure_theory.conservative", "description": " We say that a non-singular (`measure_theory.quasi_measure_preserving`) self-map is\n*conservative* if for any measurable set `s` of positive measure there exists `x \u2208 s` such that `x`\nreturns back to `s` under some iteration of `f`.", "p": "mathlib"}, {"name": "measure_theory.conservative.to_quasi_measure_preserving", "description": " We say that a non-singular (`measure_theory.quasi_measure_preserving`) self-map is\n*conservative* if for any measurable set `s` of positive measure there exists `x \u2208 s` such that `x`\nreturns back to `s` under some iteration of `f`.", "p": "mathlib"}, {"name": "measure_theory.conservative.exists_mem_image_mem", "description": " We say that a non-singular (`measure_theory.quasi_measure_preserving`) self-map is\n*conservative* if for any measurable set `s` of positive measure there exists `x \u2208 s` such that `x`\nreturns back to `s` under some iteration of `f`.", "p": "mathlib"}, {"name": "measure_theory.conservative.measure_mem_forall_ge_image_not_mem_eq_zero", "description": " Poincar\u00e9 recurrence theorem: given a conservative map `f` and a measurable set `s`, the set\nof points `x \u2208 s` such that `x` does not return to `s` after `\u2265 n` iterations has measure zero.", "p": "mathlib"}, {"name": "multiset.nat.antidiagonal_zero", "description": "The antidiagonal of `0` is the list `[(0, 0)]`", "p": "mathlib"}, {"name": "multiset.nat.antidiagonal_succ", "description": "", "p": "mathlib"}, {"name": "multiset.nat.antidiagonal", "description": "The antidiagonal of a natural number `n` is\n   the multiset of pairs `(i, j)` such that `i + j = n`.", "p": "mathlib"}, {"name": "multiset.nat.card_antidiagonal", "description": "The cardinality of the antidiagonal of `n` is `n+1`.", "p": "mathlib"}, {"name": "multiset.nat.antidiagonal_succ_succ'", "description": "", "p": "mathlib"}, {"name": "multiset.nat.antidiagonal_succ'", "description": "", "p": "mathlib"}, {"name": "multiset.nat.mem_antidiagonal", "description": "A pair (i, j) is contained in the antidiagonal of `n` if and only if `i + j = n`.", "p": "mathlib"}, {"name": "multiset.nat.nodup_antidiagonal", "description": "The antidiagonal of `n` does not contain duplicate entries.", "p": "mathlib"}, {"name": "multiset.nat.map_swap_antidiagonal", "description": "", "p": "mathlib"}, {"name": "matrix.proj_diagonal", "description": "", "p": "mathlib"}, {"name": "matrix.ker_diagonal_to_lin'", "description": "", "p": "mathlib"}, {"name": "matrix.range_diagonal", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_to_lin'", "description": "", "p": "mathlib"}, {"name": "matrix.rank_diagonal", "description": "", "p": "mathlib"}, {"name": "matrix.diagonal_comp_std_basis", "description": "", "p": "mathlib"}, {"name": "int.nat_abs_le_of_dvd_ne_zero", "description": "", "p": "mathlib"}, {"name": "int.eq_zero_of_dvd_of_nonneg_of_lt", "description": "", "p": "mathlib"}, {"name": "int.of_nat_add_neg_succ_of_nat_of_ge", "description": "", "p": "mathlib"}, {"name": "int.eq_mul_div_of_mul_eq_mul_of_dvd_left", "description": "", "p": "mathlib"}, {"name": "int.eq_zero_of_dvd_of_nat_abs_lt_nat_abs", "description": " If an integer with larger absolute value divides an integer, it is\nzero.", "p": "mathlib"}, {"name": "int.eq_of_mod_eq_of_nat_abs_sub_lt_nat_abs", "description": " If two integers are congruent to a sufficiently large modulus,\nthey are equal.", "p": "mathlib"}, {"name": "category_theory.is_isomorphic_setoid", "description": "`is_isomorphic` defines a setoid.", "p": "mathlib"}, {"name": "category_theory.groupoid.is_isomorphic_iff_nonempty_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.is_isomorphic", "description": "An object `X` is isomorphic to an object `Y`, if `X \u2245 Y` is not empty.", "p": "mathlib"}, {"name": "category_theory.isomorphism_classes", "description": "The functor that sends each category to the quotient space of its objects up to an isomorphism.", "p": "mathlib"}, {"name": "submodule.quotient_pi_apply", "description": "", "p": "mathlib"}, {"name": "submodule.pi_quotient_lift_mk", "description": "", "p": "mathlib"}, {"name": "submodule.pi_quotient_lift", "description": "Lift a family of maps to the direct sum of quotients.", "p": "mathlib"}, {"name": "submodule.pi_quotient_lift_single", "description": "", "p": "mathlib"}, {"name": "submodule.quotient_pi_symm_apply", "description": "", "p": "mathlib"}, {"name": "submodule.quotient_pi", "description": "The quotient of a direct sum is the direct sum of quotients.", "p": "mathlib"}, {"name": "submodule.quotient_pi_lift", "description": "Lift a family of maps to a quotient of direct sums.", "p": "mathlib"}, {"name": "submodule.quotient_pi_lift_mk", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.N_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.equivalence_counit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.N_map_f", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.\u03b7_inv_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.\u03b5", "description": "The unit isomorphism induced by `\u0393\u2082N\u2081`.", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.\u03b7", "description": "The counit isomorphism induced by `N\u2081\u0393\u2080`", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.h\u0393\u2080", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.equivalence_functor", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.\u0393_map_app", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.equivalence_inverse", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.equivalence", "description": " The Dold-Kan equivalence for pseudoabelian categories given\nby the functors `N` and `\u0393`. It is obtained by applying the results in\n`compatibility.lean` to the equivalence `preadditive.dold_kan.equivalence`.", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.equivalence_unit_iso", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.\u0393_obj_map", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.\u03b7_hom_app_f", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.h\u03b7", "description": " The natural isomorphism `N\u0393' satisfies the compatibility that is needed\nfor the construction of our counit isomorphism `\u03b7`", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.hN\u2081", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.\u0393_obj_obj", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.h\u03b5", "description": "", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.\u0393", "description": "The functor `\u0393` for the equivalence is `\u0393'`.", "p": "mathlib"}, {"name": "category_theory.idempotents.dold_kan.N", "description": " The functor `N` for the equivalence is obtained by composing\n`N' : simplicial_object C \u2964 karoubi (chain_complex C \u2115)` and the inverse\nof the equivalence `chain_complex C \u2115 \u224c karoubi (chain_complex C \u2115)`.", "p": "mathlib"}, {"name": "tactic.mk_assoc_pattern'", "description": "", "p": "mathlib"}, {"name": "tactic.assoc_refl", "description": "", "p": "mathlib"}, {"name": "tactic.assoc_rewrite_intl", "description": "", "p": "mathlib"}, {"name": "tactic.match_assoc_pattern", "description": "", "p": "mathlib"}, {"name": "tactic.assoc_root", "description": "", "p": "mathlib"}, {"name": "tactic.match_assoc_pattern'", "description": "", "p": "mathlib"}, {"name": "tactic.enum_assoc_subexpr", "description": "", "p": "mathlib"}, {"name": "tactic.assoc_refl'", "description": "", "p": "mathlib"}, {"name": "tactic.fill_args", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.assoc_rw", "description": "synonym for `assoc_rewrite`", "p": "mathlib"}, {"name": "tactic.mk_assoc_pattern", "description": "", "p": "mathlib"}, {"name": "tactic.enum_assoc_subexpr'", "description": "", "p": "mathlib"}, {"name": "tactic.assoc_rewrite", "description": "", "p": "mathlib"}, {"name": "tactic.assoc_rewrite_hyp", "description": "", "p": "mathlib"}, {"name": "tactic.mk_assoc", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.assoc_rewrite", "description": "`assoc_rewrite [h\u2080,\u2190 h\u2081] at \u22a2 h\u2082` behaves like `rewrite [h\u2080,\u2190 h\u2081] at \u22a2 h\u2082`\nwith the exception that associativity is used implicitly to make rewriting\npossible.\n\nIt works for any function `f` for which an `is_associative f` instance can be found.\n\n```lean\nexample {\u03b1 : Type*} (f : \u03b1 \u2192 \u03b1 \u2192 \u03b1) [is_associative \u03b1 f] (a b c d x : \u03b1) :\n  let infix ` ~ ` := f in\n  b ~ c = x \u2192 (a ~ b ~ c ~ d) = (a ~ x ~ d) :=\nbegin\n  intro h,\n  assoc_rw h,\nend\n```", "p": "mathlib"}, {"name": "tactic_doc.tactic.assoc_rewrite", "description": "`assoc_rewrite [h\u2080,\u2190 h\u2081] at \u22a2 h\u2082` behaves like `rewrite [h\u2080,\u2190 h\u2081] at \u22a2 h\u2082`\nwith the exception that associativity is used implicitly to make rewriting\npossible.\n\nIt works for any function `f` for which an `is_associative f` instance can be found.\n\n```lean\nexample {\u03b1 : Type*} (f : \u03b1 \u2192 \u03b1 \u2192 \u03b1) [is_associative \u03b1 f] (a b c d x : \u03b1) :\n  let infix ` ~ ` := f in\n  b ~ c = x \u2192 (a ~ b ~ c ~ d) = (a ~ x ~ d) :=\nbegin\n  intro h,\n  assoc_rw h,\nend\n```", "p": "mathlib"}, {"name": "tactic.mk_assoc_instance", "description": "", "p": "mathlib"}, {"name": "tactic.chain_eq_trans", "description": "", "p": "mathlib"}, {"name": "tactic.id_tag.assoc_proof", "description": "Tag for proofs generated by `assoc_rewrite`.", "p": "mathlib"}, {"name": "tactic.flatten", "description": "", "p": "mathlib"}, {"name": "tactic.unify_prefix", "description": "", "p": "mathlib"}, {"name": "tactic.mk_eq_proof", "description": "", "p": "mathlib"}, {"name": "tactic.assoc_rewrite_target", "description": "", "p": "mathlib"}, {"name": "tactic.match_fn", "description": "", "p": "mathlib"}, {"name": "commutator_element_def", "description": "", "p": "mathlib"}, {"name": "commutator_element", "description": "The commutator of two elements `g\u2081` and `g\u2082`.", "p": "mathlib"}, {"name": "id.is_lawful_traversable", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.preserves_map", "description": "", "p": "mathlib"}, {"name": "option.traversable", "description": "", "p": "mathlib"}, {"name": "applicative_transformation", "description": " A transformation between applicative functors.  It is a natural\ntransformation such that `app` preserves the `has_pure.pure` and\n`functor.map` (`<*>`) operations. See\n`applicative_transformation.preserves_map` for naturality.", "p": "mathlib"}, {"name": "applicative_transformation.app", "description": " A transformation between applicative functors.  It is a natural\ntransformation such that `app` preserves the `has_pure.pure` and\n`functor.map` (`<*>`) operations. See\n`applicative_transformation.preserves_map` for naturality.", "p": "mathlib"}, {"name": "applicative_transformation.preserves_pure'", "description": " A transformation between applicative functors.  It is a natural\ntransformation such that `app` preserves the `has_pure.pure` and\n`functor.map` (`<*>`) operations. See\n`applicative_transformation.preserves_map` for naturality.", "p": "mathlib"}, {"name": "applicative_transformation.preserves_seq'", "description": " A transformation between applicative functors.  It is a natural\ntransformation such that `app` preserves the `has_pure.pure` and\n`functor.map` (`<*>`) operations. See\n`applicative_transformation.preserves_map` for naturality.", "p": "mathlib"}, {"name": "applicative_transformation.inhabited", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.coe_inj", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.coe_mk", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.preserves_map'", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.congr_fun", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.comp_apply", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.id_comp", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.preserves_seq", "description": "", "p": "mathlib"}, {"name": "list.traversable", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.ext", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.comp_id", "description": "", "p": "mathlib"}, {"name": "is_lawful_traversable", "description": " A traversable functor is lawful if its `traverse` satisfies a\nnumber of additional properties.  It must send `id.mk` to `id.mk`,\nsend the composition of applicative functors to the composition of the\n`traverse` of each, send each function `f` to `\u03bb x, f <$> x`, and\nsatisfy a naturality condition with respect to applicative\ntransformations.", "p": "mathlib"}, {"name": "is_lawful_traversable.to_is_lawful_functor", "description": " A traversable functor is lawful if its `traverse` satisfies a\nnumber of additional properties.  It must send `id.mk` to `id.mk`,\nsend the composition of applicative functors to the composition of the\n`traverse` of each, send each function `f` to `\u03bb x, f <$> x`, and\nsatisfy a naturality condition with respect to applicative\ntransformations.", "p": "mathlib"}, {"name": "is_lawful_traversable.id_traverse", "description": " A traversable functor is lawful if its `traverse` satisfies a\nnumber of additional properties.  It must send `id.mk` to `id.mk`,\nsend the composition of applicative functors to the composition of the\n`traverse` of each, send each function `f` to `\u03bb x, f <$> x`, and\nsatisfy a naturality condition with respect to applicative\ntransformations.", "p": "mathlib"}, {"name": "is_lawful_traversable.comp_traverse", "description": " A traversable functor is lawful if its `traverse` satisfies a\nnumber of additional properties.  It must send `id.mk` to `id.mk`,\nsend the composition of applicative functors to the composition of the\n`traverse` of each, send each function `f` to `\u03bb x, f <$> x`, and\nsatisfy a naturality condition with respect to applicative\ntransformations.", "p": "mathlib"}, {"name": "is_lawful_traversable.traverse_eq_map_id", "description": " A traversable functor is lawful if its `traverse` satisfies a\nnumber of additional properties.  It must send `id.mk` to `id.mk`,\nsend the composition of applicative functors to the composition of the\n`traverse` of each, send each function `f` to `\u03bb x, f <$> x`, and\nsatisfy a naturality condition with respect to applicative\ntransformations.", "p": "mathlib"}, {"name": "is_lawful_traversable.naturality", "description": " A traversable functor is lawful if its `traverse` satisfies a\nnumber of additional properties.  It must send `id.mk` to `id.mk`,\nsend the composition of applicative functors to the composition of the\n`traverse` of each, send each function `f` to `\u03bb x, f <$> x`, and\nsatisfy a naturality condition with respect to applicative\ntransformations.", "p": "mathlib"}, {"name": "applicative_transformation.has_coe_to_fun", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.congr_arg", "description": "", "p": "mathlib"}, {"name": "sum.traverse", "description": " Defines a `traverse` function on the second component of a sum type.\nThis is used to give a `traversable` instance for the functor `\u03c3 \u2295 -`.", "p": "mathlib"}, {"name": "applicative_transformation.comp", "description": "The composition of applicative transformations.", "p": "mathlib"}, {"name": "applicative_transformation.ext_iff", "description": "", "p": "mathlib"}, {"name": "traversable", "description": " A traversable functor is a functor along with a way to commute\nwith all applicative functors (see `sequence`).  For example, if `t`\nis the traversable functor `list` and `m` is the applicative functor\n`io`, then given a function `f : \u03b1 \u2192 io \u03b2`, the function `functor.map f` is\n`list \u03b1 \u2192 list (io \u03b2)`, but `traverse f` is `list \u03b1 \u2192 io (list \u03b2)`.", "p": "mathlib"}, {"name": "traversable.to_functor", "description": " A traversable functor is a functor along with a way to commute\nwith all applicative functors (see `sequence`).  For example, if `t`\nis the traversable functor `list` and `m` is the applicative functor\n`io`, then given a function `f : \u03b1 \u2192 io \u03b2`, the function `functor.map f` is\n`list \u03b1 \u2192 list (io \u03b2)`, but `traverse f` is `list \u03b1 \u2192 io (list \u03b2)`.", "p": "mathlib"}, {"name": "traversable.traverse", "description": " A traversable functor is a functor along with a way to commute\nwith all applicative functors (see `sequence`).  For example, if `t`\nis the traversable functor `list` and `m` is the applicative functor\n`io`, then given a function `f : \u03b1 \u2192 io \u03b2`, the function `functor.map f` is\n`list \u03b1 \u2192 list (io \u03b2)`, but `traverse f` is `list \u03b1 \u2192 io (list \u03b2)`.", "p": "mathlib"}, {"name": "sequence", "description": "A traversable functor commutes with all applicative functors.", "p": "mathlib"}, {"name": "applicative_transformation.id_transformation", "description": "The identity applicative transformation from an applicative functor to itself.", "p": "mathlib"}, {"name": "applicative_transformation.preserves_pure", "description": "", "p": "mathlib"}, {"name": "sum.traversable", "description": "", "p": "mathlib"}, {"name": "id.traversable", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.comp_assoc", "description": "", "p": "mathlib"}, {"name": "applicative_transformation.app_eq_coe", "description": "", "p": "mathlib"}, {"name": "rat.lt_one_iff_num_lt_denom", "description": "", "p": "mathlib"}, {"name": "rat.num_nonneg_iff_zero_le", "description": "", "p": "mathlib"}, {"name": "rat.nonneg_antisymm", "description": "", "p": "mathlib"}, {"name": "rat.has_inf", "description": "", "p": "mathlib"}, {"name": "rat.ordered_semiring", "description": "", "p": "mathlib"}, {"name": "rat.ordered_ring", "description": "", "p": "mathlib"}, {"name": "rat.linear_ordered_add_comm_group", "description": "", "p": "mathlib"}, {"name": "rat.preorder", "description": "", "p": "mathlib"}, {"name": "rat.num_pos_iff_pos", "description": "", "p": "mathlib"}, {"name": "rat.le_trans", "description": "", "p": "mathlib"}, {"name": "rat.partial_order", "description": "", "p": "mathlib"}, {"name": "rat.nonneg_add", "description": "", "p": "mathlib"}, {"name": "rat.le", "description": " Relation `a \u2264 b` on `\u211a` defined as `a \u2264 b \u2194 rat.nonneg (b - a)`. Use `a \u2264 b` instead of\n`rat.le a b`.", "p": "mathlib"}, {"name": "rat.linear_ordered_ring", "description": "", "p": "mathlib"}, {"name": "rat.nonneg_total", "description": "", "p": "mathlib"}, {"name": "rat.linear_order", "description": "", "p": "mathlib"}, {"name": "rat.linear_ordered_comm_ring", "description": "", "p": "mathlib"}, {"name": "rat.le_antisymm", "description": "", "p": "mathlib"}, {"name": "rat.distrib_lattice", "description": "", "p": "mathlib"}, {"name": "rat.le_def", "description": "", "p": "mathlib"}, {"name": "rat.le_def'", "description": "", "p": "mathlib"}, {"name": "rat.le_total", "description": "", "p": "mathlib"}, {"name": "rat.lt_def", "description": "", "p": "mathlib"}, {"name": "rat.decidable_nonneg", "description": "", "p": "mathlib"}, {"name": "rat.nonneg", "description": "A rational number is called nonnegative if its numerator is nonnegative.", "p": "mathlib"}, {"name": "rat.has_sup", "description": "", "p": "mathlib"}, {"name": "rat.decidable_le", "description": "", "p": "mathlib"}, {"name": "rat.nonneg_mul", "description": "", "p": "mathlib"}, {"name": "rat.ordered_cancel_add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "rat.nonneg_iff_zero_le", "description": "", "p": "mathlib"}, {"name": "rat.mul_nonneg", "description": "", "p": "mathlib"}, {"name": "rat.has_lt", "description": "", "p": "mathlib"}, {"name": "rat.ordered_add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "rat.abs_def", "description": "", "p": "mathlib"}, {"name": "rat.mk_nonneg", "description": "", "p": "mathlib"}, {"name": "rat.linear_ordered_semiring", "description": "", "p": "mathlib"}, {"name": "rat.le_refl", "description": "", "p": "mathlib"}, {"name": "rat.div_lt_div_iff_mul_lt_mul", "description": "", "p": "mathlib"}, {"name": "rat.ordered_add_comm_group", "description": "", "p": "mathlib"}, {"name": "rat.semilattice_inf", "description": "", "p": "mathlib"}, {"name": "rat.lattice", "description": "", "p": "mathlib"}, {"name": "rat.has_le", "description": "", "p": "mathlib"}, {"name": "rat.semilattice_sup", "description": "", "p": "mathlib"}, {"name": "rat.add_le_add_left", "description": "", "p": "mathlib"}, {"name": "rat.linear_ordered_field", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.cg'", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.rel_map_unify_equiv", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.cg", "description": "The direct limit of countably many countably generated structures is countably generated.", "p": "mathlib"}, {"name": "first_order.language.directed_system.map_self", "description": " A copy of `directed_system.map_self` specialized to `L`-embeddings, as otherwise the\n`\u03bb i j h, f i j h` can confuse the simplifier.", "p": "mathlib"}, {"name": "first_order.language.direct_limit.equiv_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.prestructure", "description": "The direct limit `setoid` respects the structure `sigma_structure`, so quotienting by it\n gives rise to a valid structure.", "p": "mathlib"}, {"name": "first_order.language.direct_limit.rel_map_equiv_unify", "description": "", "p": "mathlib"}, {"name": "first_order.language.directed_system.nat_le_rec.directed_system", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit", "description": "The direct limit of a directed system is the structures glued together along the embeddings.", "p": "mathlib"}, {"name": "first_order.language.directed_system.map_map", "description": " A copy of `directed_system.map_map` specialized to `L`-embeddings, as otherwise the\n`\u03bb i j h, f i j h` can confuse the simplifier.", "p": "mathlib"}, {"name": "first_order.language.direct_limit.of_f", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.exists_unify_eq", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.lift_quotient_mk_sigma_mk", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.setoid", "description": "The directed limit glues together the structures along the embeddings.", "p": "mathlib"}, {"name": "first_order.language.direct_limit.fun_map_quotient_mk_sigma_mk", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.induction_on", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.fun_map_equiv_unify", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.inhabited", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.lift_unique", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.lift", "description": " The universal property of the direct limit: maps from the components to another module\nthat respect the directed system structure (i.e. make some diagram commute) give rise\nto a unique map out of the direct limit.", "p": "mathlib"}, {"name": "first_order.language.direct_limit.exists_of", "description": " Every element of the direct limit corresponds to some element in\nsome component of the directed system.", "p": "mathlib"}, {"name": "first_order.language.direct_limit.unify", "description": "Raises a family of elements in the `\u03a3`-type to the same level along the embeddings.", "p": "mathlib"}, {"name": "first_order.language.direct_limit.of_apply", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.sigma_structure", "description": "The structure on the `\u03a3`-type which becomes the structure on the direct limit after quotienting.", "p": "mathlib"}, {"name": "first_order.language.directed_system.coe_nat_le_rec", "description": "", "p": "mathlib"}, {"name": "first_order.language.directed_system.nat_le_rec", "description": " Given a chain of embeddings of structures indexed by `\u2115`, defines a `directed_system` by\ncomposing them.", "p": "mathlib"}, {"name": "first_order.language.direct_limit.unify_sigma_mk_self", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.fun_map_unify_equiv", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.lift_of", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.rel_map_quotient_mk_sigma_mk", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.comp_unify", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.exists_quotient_mk_sigma_mk_eq", "description": "", "p": "mathlib"}, {"name": "first_order.language.direct_limit.Structure", "description": "The `L.Structure` on a direct limit of `L.Structure`s.", "p": "mathlib"}, {"name": "first_order.language.direct_limit.of", "description": "The canonical map from a component to the direct limit.", "p": "mathlib"}, {"name": "isometry_equiv.coe_fn_to_real_affine_isometry_equiv", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.midpoint_fixed", "description": " If an isometric self-homeomorphism of a normed vector space over `\u211d` fixes `x` and `y`,\nthen it fixes the midpoint of `[x, y]`. This is a lemma for a more general Mazur-Ulam theorem,\nsee below.", "p": "mathlib"}, {"name": "isometry_equiv.to_real_linear_equiv_apply", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.coe_to_real_linear_equiv_of_map_zero_symm", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.to_real_linear_isometry_equiv_of_map_zero", "description": " **Mazur-Ulam Theorem**: if `f` is an isometric bijection between two normed vector spaces\nover `\u211d` and `f 0 = 0`, then `f` is a linear isometry equivalence.", "p": "mathlib"}, {"name": "isometry_equiv.coe_to_real_linear_equiv_of_map_zero", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.to_real_affine_isometry_equiv", "description": " **Mazur-Ulam Theorem**: if `f` is an isometric bijection between two normed add-torsors over\nnormed vector spaces over `\u211d`, then `f` is an affine isometry equivalence.", "p": "mathlib"}, {"name": "isometry_equiv.to_real_linear_isometry_equiv", "description": " **Mazur-Ulam Theorem**: if `f` is an isometric bijection between two normed vector spaces\nover `\u211d`, then `x \u21a6 f x - f 0` is a linear isometry equivalence.", "p": "mathlib"}, {"name": "isometry_equiv.map_midpoint", "description": "A bijective isometry sends midpoints to midpoints.", "p": "mathlib"}, {"name": "isometry_equiv.to_real_linear_isometry_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.coe_to_real_affine_isometry_equiv", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.rat_linear", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.linear", "description": "An additive functor `F` is `R`-linear provided `F.map` is an `R`-module morphism.", "p": "mathlib"}, {"name": "category_theory.functor.linear.map_smul'", "description": "An additive functor `F` is `R`-linear provided `F.map` is an `R`-module morphism.", "p": "mathlib"}, {"name": "category_theory.functor.map_smul", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_linear_map", "description": "`F.map_linear_map` is an `R`-linear map whose underlying function is `F.map`.", "p": "mathlib"}, {"name": "category_theory.functor.comp.linear", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.int_linear", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.full_subcategory_inclusion_linear", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.coe_map_linear_map", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_linear_map_apply", "description": "", "p": "mathlib"}, {"name": "category_theory.equivalence.inverse_linear", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.induced_functor_linear", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.nat_linear", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.id.linear", "description": "", "p": "mathlib"}, {"name": "list.lex.is_strict_total_order", "description": "", "p": "mathlib"}, {"name": "list.lex.ne_iff", "description": "", "p": "mathlib"}, {"name": "list.lex.is_asymm", "description": "", "p": "mathlib"}, {"name": "list.lex.to_ne", "description": "", "p": "mathlib"}, {"name": "list.has_lt'", "description": "", "p": "mathlib"}, {"name": "list.has_le'", "description": "", "p": "mathlib"}, {"name": "list.lex.append_left", "description": "", "p": "mathlib"}, {"name": "list.lex.append_right", "description": "", "p": "mathlib"}, {"name": "list.lex.imp", "description": "", "p": "mathlib"}, {"name": "list.lex.cons_iff", "description": "", "p": "mathlib"}, {"name": "list.nil_lt_cons", "description": "", "p": "mathlib"}, {"name": "decidable.list.lex.ne_iff", "description": "", "p": "mathlib"}, {"name": "list.lex.is_trichotomous", "description": "", "p": "mathlib"}, {"name": "list.lex.is_order_connected", "description": "", "p": "mathlib"}, {"name": "list.linear_order", "description": "", "p": "mathlib"}, {"name": "list.lex.not_nil_right", "description": "", "p": "mathlib"}, {"name": "list.lex", "description": " Given a strict order `<` on `\u03b1`, the lexicographic strict order on `list \u03b1`, for which\n`[a0, ..., an] < [b0, ..., b_k]` if `a0 < b0` or `a0 = b0` and `[a1, ..., an] < [b1, ..., bk]`.\nThe definition is given for any relation `r`, not only strict orders.", "p": "mathlib"}, {"name": "list.lex.nil", "description": " Given a strict order `<` on `\u03b1`, the lexicographic strict order on `list \u03b1`, for which\n`[a0, ..., an] < [b0, ..., b_k]` if `a0 < b0` or `a0 = b0` and `[a1, ..., an] < [b1, ..., bk]`.\nThe definition is given for any relation `r`, not only strict orders.", "p": "mathlib"}, {"name": "list.lex.cons", "description": " Given a strict order `<` on `\u03b1`, the lexicographic strict order on `list \u03b1`, for which\n`[a0, ..., an] < [b0, ..., b_k]` if `a0 < b0` or `a0 = b0` and `[a1, ..., an] < [b1, ..., bk]`.\nThe definition is given for any relation `r`, not only strict orders.", "p": "mathlib"}, {"name": "list.lex.rel", "description": " Given a strict order `<` on `\u03b1`, the lexicographic strict order on `list \u03b1`, for which\n`[a0, ..., an] < [b0, ..., b_k]` if `a0 < b0` or `a0 = b0` and `[a1, ..., an] < [b1, ..., bk]`.\nThe definition is given for any relation `r`, not only strict orders.", "p": "mathlib"}, {"name": "list.lex.decidable_rel", "description": "", "p": "mathlib"}, {"name": "hall_marriage_theorem.hall_cond_of_restrict", "description": "", "p": "mathlib"}, {"name": "hall_marriage_theorem.hall_cond_of_compl", "description": "", "p": "mathlib"}, {"name": "hall_marriage_theorem.hall_hard_inductive", "description": "Here we combine the two inductive steps into a full strong induction proof,\ncompleting the proof the harder direction of **Hall's Marriage Theorem**.", "p": "mathlib"}, {"name": "hall_marriage_theorem.hall_hard_inductive_step_A", "description": "First case of the inductive step: assuming that\n`\u2200 (s : finset \u03b9), s.nonempty \u2192 s \u2260 univ \u2192 s.card < (s.bUnion t).card`\nand that the statement of **Hall's Marriage Theorem** is true for all\n`\u03b9'` of cardinality \u2264 `n`, then it is true for `\u03b9` of cardinality `n + 1`.", "p": "mathlib"}, {"name": "hall_marriage_theorem.hall_cond_of_erase", "description": "", "p": "mathlib"}, {"name": "finset.all_card_le_bUnion_card_iff_exists_injective'", "description": "This is the version of **Hall's Marriage Theorem** in terms of indexed\nfamilies of finite sets `t : \u03b9 \u2192 finset \u03b1` with `\u03b9` finite.\nIt states that there is a set of distinct representatives if and only\nif every union of `k` of the sets has at least `k` elements.\n\nSee `finset.all_card_le_bUnion_card_iff_exists_injective` for a version\nwhere the `finite \u03b9` constraint is removed.", "p": "mathlib"}, {"name": "hall_marriage_theorem.hall_hard_inductive_step_B", "description": "Second case of the inductive step: assuming that\n`\u2203 (s : finset \u03b9), s \u2260 univ \u2192 s.card = (s.bUnion t).card`\nand that the statement of **Hall's Marriage Theorem** is true for all\n`\u03b9'` of cardinality \u2264 `n`, then it is true for `\u03b9` of cardinality `n + 1`.", "p": "mathlib"}, {"name": "finset.card_disj_sum", "description": "", "p": "mathlib"}, {"name": "finset.disj_sum", "description": "Disjoint sum of finsets.", "p": "mathlib"}, {"name": "finset.disj_sum_strict_mono_right", "description": "", "p": "mathlib"}, {"name": "finset.disjoint_map_inl_map_inr", "description": "", "p": "mathlib"}, {"name": "finset.empty_disj_sum", "description": "", "p": "mathlib"}, {"name": "finset.disj_sum_ssubset_disj_sum_of_ssubset_of_subset", "description": "", "p": "mathlib"}, {"name": "finset.disj_sum_strict_mono_left", "description": "", "p": "mathlib"}, {"name": "finset.mem_disj_sum", "description": "", "p": "mathlib"}, {"name": "finset.disj_sum_ssubset_disj_sum_of_subset_of_ssubset", "description": "", "p": "mathlib"}, {"name": "finset.disj_sum_mono_right", "description": "", "p": "mathlib"}, {"name": "finset.disj_sum_eq_empty", "description": "", "p": "mathlib"}, {"name": "finset.disj_sum_empty", "description": "", "p": "mathlib"}, {"name": "finset.disj_sum_mono_left", "description": "", "p": "mathlib"}, {"name": "finset.disj_sum_mono", "description": "", "p": "mathlib"}, {"name": "finset.val_disj_sum", "description": "", "p": "mathlib"}, {"name": "finset.map_inl_disj_union_map_inr", "description": "", "p": "mathlib"}, {"name": "finset.inr_mem_disj_sum", "description": "", "p": "mathlib"}, {"name": "finset.inl_mem_disj_sum", "description": "", "p": "mathlib"}, {"name": "Module.image_iso_range", "description": "The categorical image of a morphism in `Module R`\nagrees with the linear algebraic range.", "p": "mathlib"}, {"name": "Module.image.lift", "description": "The universal property for the image factorisation", "p": "mathlib"}, {"name": "Module.image_iso_range_hom_subtype", "description": "", "p": "mathlib"}, {"name": "Module.image_iso_range_inv_image_\u03b9", "description": "", "p": "mathlib"}, {"name": "Module.image.lift_fac", "description": "", "p": "mathlib"}, {"name": "Module.is_image", "description": " The factorisation of any morphism in `Module R` through a mono has the universal property of\nthe image.", "p": "mathlib"}, {"name": "Module.image.fac", "description": "", "p": "mathlib"}, {"name": "Module.image_iso_range_inv_image_\u03b9_apply", "description": "", "p": "mathlib"}, {"name": "Module.factor_thru_image", "description": "The corestriction map to the image", "p": "mathlib"}, {"name": "Module.image.\u03b9", "description": "The inclusion of `image f` into the target", "p": "mathlib"}, {"name": "Module.image.\u03b9.category_theory.mono", "description": "", "p": "mathlib"}, {"name": "Module.image_iso_range_hom_subtype_assoc", "description": "", "p": "mathlib"}, {"name": "Module.image", "description": "The image of a morphism in `Module R` is just the bundling of `linear_map.range f`", "p": "mathlib"}, {"name": "Module.image_iso_range_inv_image_\u03b9_assoc", "description": "", "p": "mathlib"}, {"name": "Module.mono_factorisation", "description": "The factorisation of any morphism in `Module R` through a mono.", "p": "mathlib"}, {"name": "Module.image_iso_range_hom_subtype_apply", "description": "", "p": "mathlib"}, {"name": "miu.le_pow2_and_pow2_eq_mod3", "description": "If `a` is 1 or 2 modulo 3, then exists `k` a power of 2 for which `a \u2264 k` and `a \u2261 k [MOD 3]`.", "p": "mathlib-archive"}, {"name": "miu.der_cons_replicate_I_replicate_U_append_of_der_cons_replicate_I_append", "description": "We may replace several consecutive occurrences of  `\"III\"` with the same number of `\"U\"`s.\nIn application of the following lemma, `xs` will either be `[]` or `[U]`.", "p": "mathlib-archive"}, {"name": "miu.mem_of_count_U_eq_succ", "description": "", "p": "mathlib-archive"}, {"name": "miu.base_case_suf", "description": "`base_case_suf` is the base case of the sufficiency result.", "p": "mathlib-archive"}, {"name": "miu.derivable.decidable_pred", "description": "Finally, we have the main result, namely that `derivable` is a decidable predicate.", "p": "mathlib-archive"}, {"name": "miu.der_of_decstr", "description": "`der_of_decstr` states that `derivable en` follows from `decstr en`.", "p": "mathlib-archive"}, {"name": "miu.count_I_eq_length_of_count_U_zero_and_neg_mem", "description": "If an `miustr` has a zero `count U` and contains no `M`, then its `count I` is its length.", "p": "mathlib-archive"}, {"name": "miu.replicate_pow_minus_append", "description": "", "p": "mathlib-archive"}, {"name": "miu.der_replicate_I_of_mod3", "description": "`der_replicate_I_of_mod3` states that `M::y` is `derivable` if `y` is any `miustr` consisiting just\nof `I`s, where `count I y` is 1 or 2 modulo 3.", "p": "mathlib-archive"}, {"name": "miu.add_mod2", "description": "For every `a`, the number `a + a % 2` is even.", "p": "mathlib-archive"}, {"name": "miu.ind_hyp_suf", "description": "`ind_hyp_suf` is the inductive step of the sufficiency result.", "p": "mathlib-archive"}, {"name": "miu.eq_append_cons_U_of_count_U_pos", "description": "", "p": "mathlib-archive"}, {"name": "miu.der_of_der_append_replicate_U_even", "description": "Any number of successive occurrences of `\"UU\"` can be removed from the end of a `derivable` `miustr`\nto produce another `derivable` `miustr`.", "p": "mathlib-archive"}, {"name": "option.bind", "description": "", "p": "core"}, {"name": "option.orelse", "description": "", "p": "core"}, {"name": "option.is_none", "description": "", "p": "core"}, {"name": "option.rhoare", "description": "", "p": "core"}, {"name": "option.to_monad", "description": "", "p": "core"}, {"name": "option.map", "description": "", "p": "core"}, {"name": "option.map_id", "description": "", "p": "core"}, {"name": "option.inhabited", "description": "", "p": "core"}, {"name": "option.get", "description": "", "p": "core"}, {"name": "option.lhoare", "description": "", "p": "core"}, {"name": "option.alternative", "description": "", "p": "core"}, {"name": "option.is_some", "description": "", "p": "core"}, {"name": "option.monad", "description": "", "p": "core"}, {"name": "option.get_or_else", "description": "", "p": "core"}, {"name": "option.decidable_eq", "description": "", "p": "core"}, {"name": "set.Icc_infinite", "description": "", "p": "mathlib"}, {"name": "set.Ioc.infinite", "description": "", "p": "mathlib"}, {"name": "set.Iio.infinite", "description": "", "p": "mathlib"}, {"name": "set.Ici_infinite", "description": "", "p": "mathlib"}, {"name": "set.Ico_infinite", "description": "", "p": "mathlib"}, {"name": "no_max_order.infinite", "description": " A nonempty preorder with no maximal element is infinite. This is not an instance to avoid\na cycle with `infinite \u03b1 \u2192 nontrivial \u03b1 \u2192 nonempty \u03b1`.", "p": "mathlib"}, {"name": "set.Ico.infinite", "description": "", "p": "mathlib"}, {"name": "set.Iic_infinite", "description": "", "p": "mathlib"}, {"name": "set.Iic.infinite", "description": "", "p": "mathlib"}, {"name": "set.Ioo.infinite", "description": "", "p": "mathlib"}, {"name": "set.Ioc_infinite", "description": "", "p": "mathlib"}, {"name": "set.Ioi.infinite", "description": "", "p": "mathlib"}, {"name": "set.Ici.infinite", "description": "", "p": "mathlib"}, {"name": "set.Ioo_infinite", "description": "", "p": "mathlib"}, {"name": "set.Ioi_infinite", "description": "", "p": "mathlib"}, {"name": "set.Icc.infinite", "description": "", "p": "mathlib"}, {"name": "set.Iio_infinite", "description": "", "p": "mathlib"}, {"name": "no_min_order.infinite", "description": " A nonempty preorder with no minimal element is infinite. This is not an instance to avoid\na cycle with `infinite \u03b1 \u2192 nontrivial \u03b1 \u2192 nonempty \u03b1`.", "p": "mathlib"}, {"name": "tactic.pi_instance", "description": "`pi_instance` constructs an instance of `my_class (\u03a0 i : I, f i)`\nwhere we know `\u03a0 i, my_class (f i)`. If an order relation is required,\nit defaults to `pi.partial_order`. Any field of the instance that\n`pi_instance` cannot construct is left untouched and generated as a new goal.", "p": "mathlib"}, {"name": "tactic_doc.tactic.pi_instance", "description": "`pi_instance` constructs an instance of `my_class (\u03a0 i : I, f i)`\nwhere we know `\u03a0 i, my_class (f i)`. If an order relation is required,\nit defaults to `pi.partial_order`. Any field of the instance that\n`pi_instance` cannot construct is left untouched and generated as a new goal.", "p": "mathlib"}, {"name": "tactic.pi_instance_derive_field", "description": "Attempt to clear a goal obtained by refining a `pi_instance` goal.", "p": "mathlib"}, {"name": "tactic.interactive.pi_instance", "description": "`pi_instance` constructs an instance of `my_class (\u03a0 i : I, f i)`\nwhere we know `\u03a0 i, my_class (f i)`. If an order relation is required,\nit defaults to `pi.partial_order`. Any field of the instance that\n`pi_instance` cannot construct is left untouched and generated as a new goal.", "p": "mathlib"}, {"name": "matrix.charpoly_coeff_eq_prod_coeff_of_le", "description": "", "p": "mathlib"}, {"name": "matrix.charpoly_sub_diagonal_degree_lt", "description": "", "p": "mathlib"}, {"name": "mat_poly_equiv_eq_X_pow_sub_C", "description": "", "p": "mathlib"}, {"name": "matrix.eval_det", "description": "", "p": "mathlib"}, {"name": "matrix.det_of_card_zero", "description": "", "p": "mathlib"}, {"name": "charmatrix_apply_nat_degree", "description": "", "p": "mathlib"}, {"name": "matrix.mat_poly_equiv_eval", "description": "", "p": "mathlib"}, {"name": "matrix.aeval_eq_aeval_mod_charpoly", "description": " Any matrix polynomial `p` is equivalent under evaluation to `p %\u2098 M.charpoly`; that is, `p`\nis equivalent to a polynomial with degree less than the dimension of the matrix.", "p": "mathlib"}, {"name": "matrix.trace_eq_neg_charpoly_coeff", "description": "", "p": "mathlib"}, {"name": "matrix.charpoly_degree_eq_dim", "description": "", "p": "mathlib"}, {"name": "coeff_charpoly_mem_ideal_pow", "description": "", "p": "mathlib"}, {"name": "matrix.det_eq_sign_charpoly_coeff", "description": "", "p": "mathlib"}, {"name": "matrix.pow_eq_aeval_mod_charpoly", "description": " Any matrix power can be computed as the sum of matrix powers less than `fintype.card n`.\n\nTODO: add the statement for negative powers phrased with `zpow`.", "p": "mathlib"}, {"name": "matrix.charpoly_monic", "description": "", "p": "mathlib"}, {"name": "charmatrix_apply_nat_degree_le", "description": "", "p": "mathlib"}, {"name": "matrix.charpoly_nat_degree_eq_dim", "description": "", "p": "mathlib"}, {"name": "CommRing.colimits.desc_fun_lift", "description": " The function from the free commutative ring on the diagram to the cone point of any other\ncocone.", "p": "mathlib"}, {"name": "CommRing.colimits.quot_mul", "description": "", "p": "mathlib"}, {"name": "CommRing.colimits.relation", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.refl", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.symm", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.trans", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.map", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.zero", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.one", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.neg", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.add", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.mul", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.neg_1", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.add_1", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.add_2", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.mul_1", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.mul_2", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.zero_add", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.add_zero", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.one_mul", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.mul_one", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.add_left_neg", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.add_comm", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.mul_comm", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.add_assoc", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.mul_assoc", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.left_distrib", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.relation.right_distrib", "description": "The relation on `prequotient` saying when two expressions are equal\nbecause of the commutative ring laws, or\nbecause one element is mapped to another by a morphism in the diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.colimit_type.inhabited", "description": "", "p": "mathlib"}, {"name": "CommRing.colimits.colimit_type", "description": "The underlying type of the colimit of a diagram in `CommRing`.", "p": "mathlib"}, {"name": "CommRing.colimits.colimit_cocone", "description": "The cocone over the proposed colimit commutative ring.", "p": "mathlib"}, {"name": "CommRing.colimits.cocone_naturality_components", "description": "", "p": "mathlib"}, {"name": "CommRing.colimits.colimit", "description": "The bundled commutative ring giving the colimit of a diagram.", "p": "mathlib"}, {"name": "CommRing.colimits.quot_add", "description": "", "p": "mathlib"}, {"name": "CommRing.colimits.cocone_fun", "description": "The function from a given commutative ring in the diagram to the colimit commutative ring.", "p": "mathlib"}, {"name": "CommRing.colimits.prequotient.inhabited", "description": "", "p": "mathlib"}, {"name": "CommRing.colimits.quot_neg", "description": "", "p": "mathlib"}, {"name": "CommRing.colimits.prequotient", "description": "An inductive type