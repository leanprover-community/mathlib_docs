` for free.", "p": "mathlib"}, {"name": "lie_module_hom.id_apply", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.zsmul_apply", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.has_neg", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.has_nsmul", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.mk_coe", "description": "", "p": "mathlib"}, {"name": "lie_nsmul", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.map_add", "description": "", "p": "mathlib"}, {"name": "lie_hom.map_lie", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.has_zero", "description": "The constant 0 map is a Lie module morphism.", "p": "mathlib"}, {"name": "leibniz_lie", "description": "", "p": "mathlib"}, {"name": "lie_module.comp_lie_hom", "description": " A Lie module may be pulled back along a morphism of Lie algebras.\n\nSee note [reducible non-instances].", "p": "mathlib"}, {"name": "lie_module_equiv.ext", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.coe_nsmul", "description": "", "p": "mathlib"}, {"name": "lie_hom.map_sub", "description": "", "p": "mathlib"}, {"name": "lie_hom.map_add", "description": "", "p": "mathlib"}, {"name": "zero_lie", "description": "", "p": "mathlib"}, {"name": "lie_add", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.trans", "description": "Lie module equivalences are transitive.", "p": "mathlib"}, {"name": "lie_algebra_self_module", "description": "Every Lie algebra is a module over itself.", "p": "mathlib"}, {"name": "lie_equiv.one_apply", "description": "", "p": "mathlib"}, {"name": "lie_equiv.coe_injective", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.coe_id", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.has_smul", "description": "", "p": "mathlib"}, {"name": "lie_module_equiv.symm_apply_apply", "description": "", "p": "mathlib"}, {"name": "lie_module_hom.linear_map.has_coe", "description": "", "p": "mathlib"}, {"name": 