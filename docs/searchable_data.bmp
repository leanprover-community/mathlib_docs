r", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.is_local_max_on_iff", "description": "", "p": "mathlib"}, {"name": "is_local_max.min", "description": "", "p": "mathlib"}, {"name": "is_local_max_on.sup", "description": "", "p": "mathlib"}, {"name": "is_local_max_on.is_local_max", "description": "", "p": "mathlib"}, {"name": "filter.eventually_le.is_local_min", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.not_nhds_le_map", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.comp_mono", "description": "", "p": "mathlib"}, {"name": "is_local_min.sup", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.neg", "description": "", "p": "mathlib"}, {"name": "is_extr_on.localize", "description": "", "p": "mathlib"}, {"name": "is_local_max_on.comp_mono", "description": "", "p": "mathlib"}, {"name": "is_local_extr.on", "description": "", "p": "mathlib"}, {"name": "is_local_max_on.congr", "description": "", "p": "mathlib"}, {"name": "filter.eventually_le.is_local_max", "description": "", "p": "mathlib"}, {"name": "is_local_extr_on", "description": "`is_local_extr_on f s a` means `is_local_min_on f s a \u2228 is_local_max_on f s a`.", "p": "mathlib"}, {"name": "is_local_max_const", "description": "", "p": "mathlib"}, {"name": "is_local_max_on", "description": "`is_local_max_on f s a` means that `f x \u2264 f a` for all `x \u2208 s` in some neighborhood of `a`.", "p": "mathlib"}, {"name": "is_local_min_on_const", "description": "", "p": "mathlib"}, {"name": "is_max_on.localize", "description": "", "p": "mathlib"}, {"name": "is_local_extr_on.not_nhds_le_map", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.max", "description": "", "p": "mathlib"}, {"name": "is_local_max_on.on_subset", "description": "", "p": "mathlib"}, {"name": "filter.eventually_le.is_local_min_on", "description": "", "p": "mathlib"}, {"name": "is_local_extr_on.comp_antitone", "description": "", "p": "mathlib"}, {"name": "is_local_min.comp_antitone", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.is_local_max_iff", "description": "", "p": "mathlib"}, {"name": "is_local_max.sub", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.is_local_min_iff", "description": "", "p": "mathlib"}, {"name": "is_local_max_on.inter", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.is_local_min", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.comp_antitone", "description": "", "p": "mathlib"}, {"name": "is_local_extr", "description": "`is_local_extr_on f s a` means `is_local_min_on f s a \u2228 is_local_max_on f s a`.", "p": "mathlib"}, {"name": "is_local_min.inf", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.inter", "description": "", "p": "mathlib"}, {"name": "is_local_min.comp_continuous", "description": "", "p": "mathlib"}, {"name": "is_local_max_on.comp_continuous_on", "description": "", "p": "mathlib"}, {"name": "is_local_min.neg", "description": "", "p": "mathlib"}, {"name": "is_local_min_on", "description": "`is_local_min_on f s a` means that `f a \u2264 f x` for all `x \u2208 s` in some neighborhood of `a`.", "p": "mathlib"}, {"name": "is_local_max", "description": "`is_local_max f a` means that `f x \u2264 f a` for all `x \u2208 s` in some neighborhood of `a`.", "p": "mathlib"}, {"name": "is_local_min_on.on_subset", "description": "", "p": "mathlib"}, {"name": "is_local_extr_on.is_local_extr", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.sup", "description": "", "p": "mathlib"}, {"name": "is_local_max.inf", "description": "", "p": "mathlib"}, {"name": "is_local_max.max", "description": "", "p": "mathlib"}, {"name": "is_local_min_on.bicomp_mono", "description": "", "p": "mathlib"}, {"name": "filter.eventually_eq.is_local_extr_on_iff", "description": "", "p": "mathlib"}, {"name": "filter.eventually_le.is_local_max_on", "description": "", "p": "mathlib"}, {"name": "is_local_max.comp_mono", "description": "", "p": "mathlib"}, {"name": "is_local_min.on", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_iff_tendsto_uniformly_on_filter", "description": "", "p": "mathlib"}, {"name": "uniform_continuous_on.tendsto_uniformly", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.uniform_cauchy_seq_on_filter", "description": "A sequence that converges uniformly is also uniformly Cauchy", "p": "mathlib"}, {"name": "filter.tendsto.tendsto_uniformly_on_const", "description": " If a sequence `g` converges to some `b`, then the sequence of constant functions\n`\u03bb n, \u03bb a, g n` converges to the constant function `\u03bb a, b` on any set `s`", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on_Union", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly.tendsto_comp", "description": "If `F\u2099` tends uniformly to `f`, and `g\u2099` tends to `x`, then `F\u2099 g\u2099` tends to `f x`.", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.mono_left", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on_iff_tendsto_locally_uniformly_comp_coe", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly.comp", "description": "Composing on the right by a function preserves uniform convergence", "p": "mathlib"}, {"name": "tendsto_uniformly_on.prod", "description": "", "p": "mathlib"}, {"name": "tendsto_comp_of_locally_uniform_limit", "description": " If `F\u2099` converges locally uniformly on a neighborhood of `x` to a function `f` which is\ncontinuous at `x`, and `g\u2099` tends to `x`, then `F\u2099 (g\u2099)` tends to `f x`.", "p": "mathlib"}, {"name": "tendsto_uniformly_on.congr", "description": "", "p": "mathlib"}, {"name": "continuous_on_of_uniform_approx_of_continuous_on", "description": " A function which can be uniformly approximated by functions which are continuous on a set\nis continuous on this set.", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.cauchy_map", "description": " If a sequence of functions is uniformly Cauchy on a set, then the values at each point form\na Cauchy sequence.", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on_iff_forall_is_compact", "description": "", "p": "mathlib"}, {"name": "tendsto_prod_principal_iff", "description": " Uniform convergence on a set `s` to a constant function is equivalent to convergence in\n`p \u00d7\u1da0 \ud835\udcdf s`.", "p": "mathlib"}, {"name": "tendsto_uniformly_on_iff_tendsto", "description": "A sequence of functions `F\u2099` converges uniformly on a set `s` to a limiting function `f` w.r.t.\nfilter `p` iff the function `(n, x) \u21a6 (f x, F\u2099 x)` converges along `p \u00d7\u1da0 \ud835\udcdf s` to the uniformity.\nIn other words: one knows nothing about the behavior of `x` in this limit besides it being in `s`.", "p": "mathlib"}, {"name": "tendsto_locally_uniformly", "description": " A sequence of functions `F\u2099` converges locally uniformly to a limiting function `f` with respect\nto a filter `p` if, for any entourage of the diagonal `u`, for any `x`, one has `p`-eventually\n`(f y, F\u2099 y) \u2208 u` for all `y` in a neighborhood of `x`.", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.mono_right", "description": "", "p": "mathlib"}, {"name": "continuous_at_of_locally_uniform_approx_of_continuous_at", "description": " A function which can be locally uniformly approximated by functions which are continuous at\na point is continuous at this point.", "p": "mathlib"}, {"name": "tendsto_uniformly.prod_map", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly.tendsto_comp", "description": "If `F\u2099` tends locally uniformly to `f`, and `g\u2099` tends to `x`, then `F\u2099 g\u2099` tends to `f x`.", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_iff_uniform_cauchy_seq_on_filter", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on_sUnion", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on.tendsto_comp", "description": " If `F\u2099` tends locally uniformly to `f` on a set `s`, and `g\u2099` tends to `x` within `s`, then\n`F\u2099 g\u2099` tends to `f x` if `f` is continuous at `x` within `s` and `x \u2208 s`.", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on_bUnion", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.comp", "description": "Composing on the right by a function preserves uniform Cauchy sequences", "p": "mathlib"}, {"name": "continuous_of_uniform_approx_of_continuous", "description": "A function which can be uniformly approximated by continuous functions is continuous.", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on_iff_tendsto_uniformly_on_of_compact", "description": "For a compact set `s`, locally uniform convergence on `s` is just uniform convergence on `s`.", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.prod", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_iff_tendsto_uniformly_of_compact_space", "description": "On a compact space, locally uniform convergence is just uniform convergence.", "p": "mathlib"}, {"name": "tendsto_uniformly_on.tendsto_at", "description": "Uniform converence implies pointwise convergence.", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.prod_map", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_iff_seq_tendsto_uniformly_on", "description": "", "p": "mathlib"}, {"name": "tendsto_prod_filter_iff", "description": " Uniform convergence on a filter `p'` to a constant function is equivalent to convergence in\n`p \u00d7\u1da0 p'`.", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.mono", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly.tendsto_locally_uniformly_on", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_iff_tendsto", "description": "A sequence of functions `F\u2099` converges uniformly to a limiting function `f` w.r.t.\nfilter `p` iff the function `(n, x) \u21a6 (f x, F\u2099 x)` converges along `p \u00d7\u1da0 \u22a4` to the uniformity.\nIn other words: one knows nothing about the behavior of `x` in this limit.", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.prod", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.prod_map", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.comp", "description": "Composing on the right by a function preserves uniform convergence on a filter", "p": "mathlib"}, {"name": "tendsto_uniformly_on.continuous_on", "description": " A uniform limit on a set of functions which are continuous on this set is itself continuous\non this set.", "p": "mathlib"}, {"name": "tendsto_uniformly", "description": " A sequence of functions `F\u2099` converges uniformly to a limiting function `f` with respect to a\nfilter `p` if, for any entourage of the diagonal `u`, one has `p`-eventually\n`(f x, F\u2099 x) \u2208 u` for all `x`.", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on", "description": " A sequence is uniformly Cauchy if eventually all of its pairwise differences are\nuniformly bounded", "p": "mathlib"}, {"name": "tendsto_uniformly_on.uniform_cauchy_seq_on", "description": "A sequence that converges uniformly is also uniformly Cauchy", "p": "mathlib"}, {"name": "filter.tendsto.tendsto_uniformly_on_filter_const", "description": " If a sequence `g` converges to some `b`, then the sequence of constant functions\n`\u03bb n, \u03bb a, g n` converges to the constant function `\u03bb a, b` on any set `s`", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on.continuous_on", "description": " A locally uniform limit on a set of functions which are continuous on this set is itself\ncontinuous on this set.", "p": "mathlib"}, {"name": "tendsto_uniformly_on_univ", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly.comp", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on.tendsto_comp", "description": " If `F\u2099` tends uniformly to `f` on a set `s`, and `g\u2099` tends to `x` within `s`, then `F\u2099 g\u2099`\ntends to `f x` if `f` is continuous at `x` within `s`.", "p": "mathlib"}, {"name": "tendsto_uniformly_on_singleton_iff_tendsto", "description": "Uniform convergence on a singleton is equivalent to regular convergence", "p": "mathlib"}, {"name": "uniform_continuous.comp_uniform_cauchy_seq_on", "description": " Composing on the left by a uniformly continuous function preserves\nuniform Cauchy sequences", "p": "mathlib"}, {"name": "tendsto_uniformly.prod", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly.tendsto_uniformly_on", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly.continuous", "description": "A uniform limit of continuous functions is continuous.", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on.union", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.uniform_cauchy_seq_on_filter", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on.prod_map", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_of_seq_tendsto_uniformly_on", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on_univ", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.comp_tendsto_uniformly_on", "description": "Composing on the left by a uniformly continuous function preserves\n uniform convergence on a set", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on_tfae", "description": "", "p": "mathlib"}, {"name": "continuous_of_locally_uniform_approx_of_continuous_at", "description": "A function which can be locally uniformly approximated by continuous functions is continuous.", "p": "mathlib"}, {"name": "tendsto_uniformly_iff_seq_tendsto_uniformly", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.tendsto_uniformly_on", "description": "**Alias** of the reverse direction of `tendsto_uniformly_on_iff_tendsto_uniformly_on_filter`.", "p": "mathlib"}, {"name": "tendsto_uniformly_on.congr_right", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.congr", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on.tendsto_at", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_iff_forall_tendsto", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on.congr_right", "description": "", "p": "mathlib"}, {"name": "tendsto_prod_top_iff", "description": "Uniform convergence to a constant function is equivalent to convergence in `p \u00d7\u1da0 \u22a4`.", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on", "description": " A sequence of functions `F\u2099` converges locally uniformly on a set `s` to a limiting function\n`f` with respect to a filter `p` if, for any entourage of the diagonal `u`, for any `x \u2208 s`, one\nhas `p`-eventually `(f y, F\u2099 y) \u2208 u` for all `y` in a neighborhood of `x` in `s`.", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on.comp", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_filter.mono_left", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_filter", "description": " A sequence is uniformly Cauchy if eventually all of its pairwise differences are\nuniformly bounded", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_filter.comp", "description": "Composing on the right by a function preserves uniform Cauchy sequences", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter.tendsto_at", "description": "Uniform converence implies pointwise convergence.", "p": "mathlib"}, {"name": "tendsto_uniformly_on.seq_tendsto_uniformly_on", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_iff_tendsto_uniformly_on_filter", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on.congr", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_iff_filter", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_filter.mono_right", "description": "", "p": "mathlib"}, {"name": "uniform_continuous\u2082.tendsto_uniformly", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter", "description": " A sequence of functions `F\u2099` converges uniformly on a filter `p'` to a limiting function `f`\nwith respect to the filter `p` if, for any entourage of the diagonal `u`, one has\n`p \u00d7\u1da0 p'`-eventually `(f x, F\u2099 x) \u2208 u`.", "p": "mathlib"}, {"name": "tendsto_comp_of_locally_uniform_limit_within", "description": " If `F\u2099` converges locally uniformly on a neighborhood of `x` within a set `s` to a function `f`\nwhich is continuous at `x` within `s `, and `g\u2099` tends to `x` within `s`, then `F\u2099 (g\u2099)` tends\nto `f x`.", "p": "mathlib"}, {"name": "tendsto_uniformly_on.tendsto_locally_uniformly_on", "description": "", "p": "mathlib"}, {"name": "tendsto_locally_uniformly.continuous", "description": "A locally uniform limit of continuous functions is continuous.", "p": "mathlib"}, {"name": "tendsto_uniformly.tendsto_uniformly_on_filter", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.tendsto_uniformly_on_of_tendsto", "description": "A uniformly Cauchy sequence converges uniformly to its limit", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on_filter.tendsto_uniformly_on_filter_of_tendsto", "description": "A uniformly Cauchy sequence converges uniformly to its limit", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on_iff_filter", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly.tendsto_locally_uniformly", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on_filter_iff_tendsto", "description": "A sequence of functions `F\u2099` converges uniformly on a filter `p'` to a limiting function `f` w.r.t.\nfilter `p` iff the function `(n, x) \u21a6 (f x, F\u2099 x)` converges along `p \u00d7\u1da0 p'` to the uniformity.\nIn other words: one knows nothing about the behavior of `x` in this limit besides it being in `p'`.", "p": "mathlib"}, {"name": "tendsto_uniformly_on.mono", "description": "", "p": "mathlib"}, {"name": "uniform_cauchy_seq_on.prod'", "description": "", "p": "mathlib"}, {"name": "uniform_continuous.comp_tendsto_uniformly_on_filter", "description": "Composing on the left by a uniformly continuous function preserves\n uniform convergence on a filter", "p": "mathlib"}, {"name": "continuous_on_of_locally_uniform_approx_of_continuous_within_at", "description": " A function which can be locally uniformly approximated by functions which are continuous\non a set is continuous on this set.", "p": "mathlib"}, {"name": "tendsto_uniformly_on_iff_tendsto_uniformly_comp_coe", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on.tendsto_uniformly_on_filter", "description": "**Alias** of the forward direction of `tendsto_uniformly_on_iff_tendsto_uniformly_on_filter`.", "p": "mathlib"}, {"name": "tendsto_uniformly_on_empty", "description": "Uniform convergence on the empty set is vacuously true", "p": "mathlib"}, {"name": "tendsto_uniformly_on", "description": " A sequence of functions `F\u2099` converges uniformly on a set `s` to a limiting function `f` with\nrespect to the filter `p` if, for any entourage of the diagonal `u`, one has `p`-eventually\n`(f x, F\u2099 x) \u2208 u` for all `x \u2208 s`.", "p": "mathlib"}, {"name": "uniform_continuous.comp_tendsto_uniformly", "description": "Composing on the left by a uniformly continuous function preserves uniform convergence", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on.unique", "description": "", "p": "mathlib"}, {"name": "tendsto_uniformly_on.comp", "description": "Composing on the right by a function preserves uniform convergence on a set", "p": "mathlib"}, {"name": "continuous_within_at_of_locally_uniform_approx_of_continuous_within_at", "description": " A function which can be locally uniformly approximated by functions which are continuous\nwithin a set at a point is continuous within this set at this point.", "p": "mathlib"}, {"name": "tendsto_uniformly.tendsto_at", "description": "Uniform converence implies pointwise convergence.", "p": "mathlib"}, {"name": "tendsto_locally_uniformly_on.mono", "description": "", "p": "mathlib"}, {"name": "category_theory.is_kernel_pair.is_reflexive_pair", "description": "If `f,g` is a kernel pair for some morphism `q`, then it is reflexive.", "p": "mathlib"}, {"name": "category_theory.right_comp_retraction", "description": "", "p": "mathlib"}, {"name": "category_theory.right_comp_retraction_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_reflexive_coequalizers", "description": "`C` has reflexive coequalizers if it has coequalizers for every reflexive pair.", "p": "mathlib"}, {"name": "category_theory.limits.has_reflexive_coequalizers.has_coeq", "description": "`C` has reflexive coequalizers if it has coequalizers for every reflexive pair.", "p": "mathlib"}, {"name": "category_theory.section_comp_right_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.is_coreflexive_pair.swap", "description": "If `f,g` is coreflexive, then `g,f` is coreflexive.", "p": "mathlib"}, {"name": "category_theory.limits.has_coequalizer_of_common_section", "description": "", "p": "mathlib"}, {"name": "category_theory.section_comp_left_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.common_retraction", "description": "Get the common retraction for a coreflexive pair.", "p": "mathlib"}, {"name": "category_theory.app.is_reflexive_pair", "description": "For an adjunction `F \u22a3 G` with counit `\u03b5`, the pair `(FG\u03b5_B, \u03b5_FGB)` is reflexive.", "p": "mathlib"}, {"name": "category_theory.limits.has_reflexive_coequalizers_of_has_coequalizers", "description": "If `C` has coequalizers, then it has reflexive coequalizers.", "p": "mathlib"}, {"name": "category_theory.is_coreflexive_pair.mk'", "description": "", "p": "mathlib"}, {"name": "category_theory.is_reflexive_pair.swap", "description": "If `f,g` is reflexive, then `g,f` is reflexive.", "p": "mathlib"}, {"name": "category_theory.is_reflexive_pair.mk'", "description": "", "p": "mathlib"}, {"name": "category_theory.left_comp_retraction", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_equalizer_of_common_retraction", "description": "", "p": "mathlib"}, {"name": "category_theory.common_section", "description": "Get the common section for a reflexive pair.", "p": "mathlib"}, {"name": "category_theory.left_comp_retraction_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.is_coreflexive_pair", "description": "The pair `f g : A \u27f6 B` is coreflexive if there is a morphism `B \u27f6 A` which is a retraction for both.", "p": "mathlib"}, {"name": "category_theory.is_coreflexive_pair.common_retraction", "description": "The pair `f g : A \u27f6 B` is coreflexive if there is a morphism `B \u27f6 A` which is a retraction for both.", "p": "mathlib"}, {"name": "category_theory.limits.has_coreflexive_equalizers", "description": "`C` has coreflexive equalizers if it has equalizers for every coreflexive pair.", "p": "mathlib"}, {"name": "category_theory.limits.has_coreflexive_equalizers.has_eq", "description": "`C` has coreflexive equalizers if it has equalizers for every coreflexive pair.", "p": "mathlib"}, {"name": "category_theory.section_comp_left", "description": "", "p": "mathlib"}, {"name": "category_theory.is_reflexive_pair", "description": "The pair `f g : A \u27f6 B` is reflexive if there is a morphism `B \u27f6 A` which is a section for both.", "p": "mathlib"}, {"name": "category_theory.is_reflexive_pair.common_section", "description": "The pair `f g : A \u27f6 B` is reflexive if there is a morphism `B \u27f6 A` which is a section for both.", "p": "mathlib"}, {"name": "category_theory.section_comp_right", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.has_coreflexive_equalizers_of_has_equalizers", "description": "If `C` has equalizers, then it has coreflexive equalizers.", "p": "mathlib"}, {"name": "is_spectral_map.comp", "description": "", "p": "mathlib"}, {"name": "spectral_map.id", "description": "`id` as a `spectral_map`.", "p": "mathlib"}, {"name": "spectral_map.coe_comp_continuous_map", "description": "", "p": "mathlib"}, {"name": "spectral_map.comp_apply", "description": "", "p": "mathlib"}, {"name": "spectral_map.comp_id", "description": "", "p": "mathlib"}, {"name": "is_spectral_map.continuous", "description": "", "p": "mathlib"}, {"name": "spectral_map.coe_copy", "description": "", "p": "mathlib"}, {"name": "spectral_map.copy_eq", "description": "", "p": "mathlib"}, {"name": "is_compact.preimage_of_is_open", "description": "", "p": "mathlib"}, {"name": "spectral_map_class", "description": " `spectral_map_class F \u03b1 \u03b2` states that `F` is a type of spectral maps.\n\nYou should extend this class when you extend `spectral_map`.", "p": "mathlib"}, {"name": "spectral_map_class.coe", "description": " `spectral_map_class F \u03b1 \u03b2` states that `F` is a type of spectral maps.\n\nYou should extend this class when you extend `spectral_map`.", "p": "mathlib"}, {"name": "spectral_map_class.coe_injective'", "description": " `spectral_map_class F \u03b1 \u03b2` states that `F` is a type of spectral maps.\n\nYou should extend this class when you extend `spectral_map`.", "p": "mathlib"}, {"name": "spectral_map_class.map_spectral", "description": " `spectral_map_class F \u03b1 \u03b2` states that `F` is a type of spectral maps.\n\nYou should extend this class when you extend `spectral_map`.", "p": "mathlib"}, {"name": "spectral_map.ext", "description": "", "p": "mathlib"}, {"name": "spectral_map.to_continuous_map", "description": "Reinterpret a `spectral_map` as a `continuous_map`.", "p": "mathlib"}, {"name": "is_spectral_map_id", "description": "", "p": "mathlib"}, {"name": "spectral_map.copy", "description": " Copy of a `spectral_map` with a new `to_fun` equal to the old one. Useful to fix definitional\nequalities.", "p": "mathlib"}, {"name": "spectral_map.inhabited", "description": "", "p": "mathlib"}, {"name": "spectral_map.spectral_map_class", "description": "", "p": "mathlib"}, {"name": "spectral_map_class.to_fun_like", "description": "", "p": "mathlib"}, {"name": "spectral_map", "description": "The type of spectral maps from `\u03b1` to `\u03b2`.", "p": "mathlib"}, {"name": "spectral_map.to_fun", "description": "The type of spectral maps from `\u03b1` to `\u03b2`.", "p": "mathlib"}, {"name": "spectral_map.spectral'", "description": "The type of spectral maps from `\u03b1` to `\u03b2`.", "p": "mathlib"}, {"name": "spectral_map.has_coe_to_fun", "description": " Helper instance for when there's too many metavariables to apply `fun_like.has_coe_to_fun`\ndirectly.", "p": "mathlib"}, {"name": "spectral_map.to_fun_eq_coe", "description": "", "p": "mathlib"}, {"name": "spectral_map.cancel_right", "description": "", "p": "mathlib"}, {"name": "spectral_map.comp_assoc", "description": "", "p": "mathlib"}, {"name": "spectral_map.coe_id", "description": "", "p": "mathlib"}, {"name": "spectral_map_class.to_continuous_map_class", "description": "", "p": "mathlib"}, {"name": "is_spectral_map", "description": " A function between topological spaces is spectral if it is continuous and the preimage of every\ncompact open set is compact open.", "p": "mathlib"}, {"name": "is_spectral_map.to_continuous", "description": " A function between topological spaces is spectral if it is continuous and the preimage of every\ncompact open set is compact open.", "p": "mathlib"}, {"name": "is_spectral_map.is_compact_preimage_of_is_open", "description": " A function between topological spaces is spectral if it is continuous and the preimage of every\ncompact open set is compact open.", "p": "mathlib"}, {"name": "spectral_map.id_apply", "description": "", "p": "mathlib"}, {"name": "spectral_map.has_coe_t", "description": "", "p": "mathlib"}, {"name": "spectral_map.id_comp", "description": "", "p": "mathlib"}, {"name": "spectral_map.comp", "description": "Composition of `spectral_map`s as a `spectral_map`.", "p": "mathlib"}, {"name": "spectral_map.coe_comp", "description": "", "p": "mathlib"}, {"name": "spectral_map.cancel_left", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_neg", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_add", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.truncate_surjective", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.has_neg", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.ext", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.coeff_mk", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.has_nat_scalar", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_lift", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.out", "description": "We can turn a truncated Witt vector `x` into a Witt vector\nby setting all coefficients after `x` to be 0.", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_zero", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_lift_fun", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.coeff_out", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.truncate_truncate", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.mk_coeff", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_surjective", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.card", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_nat_cast", "description": "", "p": "mathlib"}, {"name": "witt_vector.lift_equiv", "description": "The universal property of `\ud835\udd4e R` as projective limit of truncated Witt vector rings.", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_int_cast", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.inhabited", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_nsmul", "description": "", "p": "mathlib"}, {"name": "witt_vector.hom_ext", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.out_injective", "description": "", "p": "mathlib"}, {"name": "witt_vector.mem_ker_truncate", "description": "", "p": "mathlib"}, {"name": "witt_vector.coeff_truncate", "description": "", "p": "mathlib"}, {"name": "witt_vector.lift_fun", "description": "Given a family `f\u2096 : S \u2192 truncated_witt_vector p k R` and `s : S`, we produce a Witt vector by\ndefining the `k`th entry to be the final entry of `f\u2096 s`.", "p": "mathlib"}, {"name": "truncated_witt_vector", "description": "A truncated Witt vector over `R` is a vector of elements of `R`,\ni.e., the first `n` coefficients of a Witt vector.\nWe will define operations on this type that are compatible with the (untruncated) Witt\nvector operations.\n\n`truncated_witt_vector p n R` takes a parameter `p : \u2115` that is not used in the definition.\nIn practice, this number `p` is assumed to be a prime number,\nand under this assumption we construct a ring structure on `truncated_witt_vector p n R`.\n(`truncated_witt_vector p\u2081 n R` and `truncated_witt_vector p\u2082 n R` are definitionally\nequal as types but will have different ring operations.)", "p": "mathlib"}, {"name": "witt_vector.lift_unique", "description": "The uniqueness part of the universal property of `\ud835\udd4e R`.", "p": "mathlib"}, {"name": "truncated_witt_vector.has_zero", "description": "", "p": "mathlib"}, {"name": "witt_vector.lift_equiv_symm_apply_coe", "description": "", "p": "mathlib"}, {"name": "witt_vector.lift", "description": "Given compatible ring homs from `S` into `truncated_witt_vector n` for each `n`, we can lift these\nto a ring hom `S \u2192 \ud835\udd4e R`.\n\n`lift` defines the universal property of `\ud835\udd4e R` as the inverse limit of `truncated_witt_vector n`.", "p": "mathlib"}, {"name": "truncated_witt_vector.coeff", "description": "`x.coeff i` is the `i`th entry of `x`.", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_mul", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_pow", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.ext_iff", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.has_nat_cast", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.has_one", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_one", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.coeff_truncate", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate", "description": " `truncate n` is a ring homomorphism that truncates `x` to its first `n` entries\nto obtain a `truncated_witt_vector`, which has the same base `p` as `x`.", "p": "mathlib"}, {"name": "truncated_witt_vector.truncate_comp_witt_vector_truncate", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_sub", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_comp_lift", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.has_sub", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_surjective", "description": "", "p": "mathlib"}, {"name": "witt_vector.coeff_truncate_fun", "description": "", "p": "mathlib"}, {"name": "witt_vector.out_truncate_fun", "description": "", "p": "mathlib"}, {"name": "witt_vector.lift_equiv_apply", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.truncate_comp", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.has_add", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun_zsmul", "description": "", "p": "mathlib"}, {"name": "witt_vector.truncate_fun", "description": " `truncate_fun n x` uses the first `n` entries of `x` to construct a `truncated_witt_vector`,\nwhich has the same base `p` as `x`.\nThis function is bundled into a ring homomorphism in `witt_vector.truncate`", "p": "mathlib"}, {"name": "truncated_witt_vector.coeff_zero", "description": "", "p": "mathlib"}, {"name": "tactic.interactive.witt_truncate_fun_tac", "description": "A macro tactic used to prove that `truncate_fun` respects ring operations.", "p": "mathlib"}, {"name": "witt_vector.truncate_mk", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.truncate_witt_vector_truncate", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.has_nat_pow", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.infi_ker_truncate", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.has_int_cast", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.fintype", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.comm_ring", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.truncate_fun_out", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.truncate", "description": "A ring homomorphism that truncates a truncated Witt vector of length `m` to\na truncated Witt vector of length `n`, for `n \u2264 m`.", "p": "mathlib"}, {"name": "truncated_witt_vector.mk", "description": "Create a `truncated_witt_vector` from a vector `x`.", "p": "mathlib"}, {"name": "truncated_witt_vector.has_mul", "description": "", "p": "mathlib"}, {"name": "truncated_witt_vector.has_int_scalar", "description": "", "p": "mathlib"}, {"name": "simp_attr.integral_simps", "description": "Simp set for integral rules.", "p": "mathlib"}, {"name": "simp_attr.field_simps", "description": "The simpset `field_simps` is used by the tactic `field_simp` to\nreduce an expression in a field to an expression of the form `n / d` where `n` and `d` are\ndivision-free.", "p": "mathlib"}, {"name": "simp_attr.push_cast", "description": "The `push_cast` simp attribute uses `norm_cast` lemmas\nto move casts toward the leaf nodes of the expression.", "p": "mathlib"}, {"name": "simp_attr.typevec", "description": "simp set for the manipulation of typevec and arrow expressions", "p": "mathlib"}, {"name": "simp_attr.is_R_or_C_simps", "description": "Simp attribute for lemmas about `is_R_or_C`", "p": "mathlib"}, {"name": "tactic.mk_simp_attribute_cmd", "description": "The command `mk_simp_attribute simp_name \"description\"` creates a simp set with name `simp_name`.\nLemmas tagged with `@[simp_name]` will be included when `simp with simp_name` is called.\n`mk_simp_attribute simp_name none` will use a default description.\n\nAppending the command with `with attr1 attr2 ...` will include all declarations tagged with\n`attr1`, `attr2`, ... in the new simp set.\n\nThis command is preferred to using ``run_cmd mk_simp_attr `simp_name`` since it adds a doc string\nto the attribute that is defined. If you need to create a simp set in a file where this command is\nnot available, you should use\n```lean\nrun_cmd mk_simp_attr `simp_name\nrun_cmd add_doc_string `simp_attr.simp_name \"Description of the simp set here\"\n```", "p": "mathlib"}, {"name": "tactic_doc.command.mk_simp_attribute", "description": "The command `mk_simp_attribute simp_name \"description\"` creates a simp set with name `simp_name`.\nLemmas tagged with `@[simp_name]` will be included when `simp with simp_name` is called.\n`mk_simp_attribute simp_name none` will use a default description.\n\nAppending the command with `with attr1 attr2 ...` will include all declarations tagged with\n`attr1`, `attr2`, ... in the new simp set.\n\nThis command is preferred to using ``run_cmd mk_simp_attr `simp_name`` since it adds a doc string\nto the attribute that is defined. If you need to create a simp set in a file where this command is\nnot available, you should use\n```lean\nrun_cmd mk_simp_attr `simp_name\nrun_cmd add_doc_string `simp_attr.simp_name \"Description of the simp set here\"\n```", "p": "mathlib"}, {"name": "simp_attr.parity_simps", "description": "Simp attribute for lemmas about `even`", "p": "mathlib"}, {"name": "simp_attr.ghost_simps", "description": "Simplification rules for ghost equations", "p": "mathlib"}, {"name": "simp_attr.functor_norm", "description": "Simp set for functor_norm", "p": "mathlib"}, {"name": "simp_attr.split_if_reduction", "description": "Simp set for if-then-else statements, used in the `split_ifs` tactic", "p": "mathlib"}, {"name": "simp_attr.mfld_simps", "description": "The simpset `mfld_simps` records several simp lemmas that are\nespecially useful in manifolds. It is a subset of the whole set of simp lemmas, but it makes it\npossible to have quicker proofs (when used with `squeeze_simp` or `simp only`) while retaining\nreadability.\n\nThe typical use case is the following, in a file on manifolds:\nIf `simp [foo, bar]` is slow, replace it with `squeeze_simp [foo, bar] with mfld_simps` and paste\nits output. The list of lemmas should be reasonable (contrary to the output of\n`squeeze_simp [foo, bar]` which might contain tens of lemmas), and the outcome should be quick\nenough.", "p": "mathlib"}, {"name": "simp_attr.nontriviality", "description": "Simp lemmas for `nontriviality` tactic", "p": "mathlib"}, {"name": "simp_attr.equiv_rw_simp", "description": "The simpset `equiv_rw_simp` is used by the tactic `equiv_rw` to\nsimplify applications of equivalences and their inverses.", "p": "mathlib"}, {"name": "simp_attr.monad_norm", "description": "simp set for monad_norm", "p": "mathlib"}, {"name": "simp_attr.transport_simps", "description": "The simpset `transport_simps` is used by the tactic `transport`\nto simplify certain expressions involving application of equivalences,\nand trivial `eq.rec` or `ep.mpr` conversions.\nIt's probably best not to adjust it without understanding the algorithm used by `transport`.", "p": "mathlib"}, {"name": "category_theory.functor.has_biproduct_of_preserves", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biproduct_comparison'_comp_biproduct_comparison_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_lift_map_biprod", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_bicone_whisker", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.split_mono_biproduct_comparison'", "description": "`biproduct_comparison' F f` is a split monomorphism.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_biproduct_inv_map_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison_snd_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_biproducts_of_shape", "description": "A functor `F` preserves biproducts of shape `J` if it preserves biproducts of `f` for every\n   `f : J \u2192 C`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_biproducts_of_shape.preserves", "description": "A functor `F` preserves biproducts of shape `J` if it preserves biproducts of `f` for every\n   `f : J \u2192 C`.", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_biproduct_hom_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_biproduct_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison.category_theory.is_split_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_bicone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_binary_bilimit_of_preserves", "description": "A functor `F` preserves binary biproducts of `X` and `Y` if `F` maps every bilimit bicone over\n   `X` and `Y` to a bilimit bicone over `F.obj X` and `F.obj Y`.", "p": "mathlib"}, {"name": "category_theory.functor.biproduct_comparison'.category_theory.is_split_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_biproducts_shrink", "description": " Preserving biproducts at a bigger universe level implies preserving biproducts at a\nsmaller universe level.", "p": "mathlib"}, {"name": "category_theory.functor.split_mono_biprod_comparison'_retraction", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.split_mono_biprod_comparison'", "description": "`biprod_comparison' F X Y` is a split mono.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_biproducts", "description": "A functor `F` preserves biproducts if it preserves biproducts of any shape `J` of size `w`.\n   The usual notion of preservation of biproducts is recovered by choosing `w` to be the universe\n   of the morphisms of `C`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_biproducts.preserves", "description": "A functor `F` preserves biproducts if it preserves biproducts of any shape `J` of size `w`.\n   The usual notion of preservation of biproducts is recovered by choosing `w` to be the universe\n   of the morphisms of `C`.", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison_fst_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison'_comp_biprod_comparison", "description": "The composition in the opposite direction is equal to the identity if and only if `F` preserves\n   the biproduct, see `preserves_binary_biproduct_of_mono_biprod_comparison`.", "p": "mathlib"}, {"name": "category_theory.functor.split_epi_biprod_comparison_section_", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.has_binary_biproduct_of_preserves", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_finite_biproducts", "description": "A functor `F` preserves finite biproducts if it preserves biproducts of shape `J` whenever\n   `J` is a fintype.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_finite_biproducts.preserves", "description": "A functor `F` preserves finite biproducts if it preserves biproducts of shape `J` whenever\n   `J` is a fintype.", "p": "mathlib"}, {"name": "category_theory.functor.\u03b9_biproduct_comparison'", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison", "description": "As for products, any functor between categories with binary biproducts gives rise to a\n   morphism `F.obj (X \u229e Y) \u27f6 F.obj X \u229e F.obj Y`.", "p": "mathlib"}, {"name": "category_theory.functor.map_binary_bicone_X", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_biprod_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_binary_bicone_inl", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_bicone_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_biprod_inv", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.split_epi_biprod_comparison", "description": "`biprod_comparison F X Y` is a split epi.", "p": "mathlib"}, {"name": "category_theory.functor.inl_biprod_comparison'_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_binary_biproducts_of_preserves_biproducts", "description": "A functor that preserves biproducts of a pair preserves binary biproducts.", "p": "mathlib"}, {"name": "category_theory.functor.map_biproduct_hom", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.inr_biprod_comparison'", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.\u03b9_biproduct_comparison'_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.split_mono_biproduct_comparison'_retraction", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_binary_biproduct", "description": "A functor `F` preserves binary biproducts of `X` and `Y` if `F` maps every bilimit bicone over\n   `X` and `Y` to a bilimit bicone over `F.obj X` and `F.obj Y`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_binary_biproduct.preserves", "description": "A functor `F` preserves binary biproducts of `X` and `Y` if `F` maps every bilimit bicone over\n   `X` and `Y` to a bilimit bicone over `F.obj X` and `F.obj Y`.", "p": "mathlib"}, {"name": "category_theory.functor.biproduct_comparison'", "description": "As for coproducts, any functor between categories with biproducts gives rise to a morphism\n   `\u2a01 (F.obj \u2218 f) \u27f6 F.obj (\u2a01 f)`", "p": "mathlib"}, {"name": "category_theory.functor.map_binary_bicone_snd", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biproduct_comparison_\u03c0", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_finite_biproducts_of_preserves_biproducts", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.split_epi_biproduct_comparison", "description": "`biproduct_comparison F f` is a split epimorphism.", "p": "mathlib"}, {"name": "category_theory.functor.inr_biprod_comparison'_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_binary_bicone_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison'.category_theory.is_split_mono", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.is_bilimit_of_preserves", "description": "A functor `F` preserves biproducts of `f` if `F` maps every bilimit bicone over `f` to a\n   bilimit bicone over `F.obj \u2218 f`.", "p": "mathlib"}, {"name": "category_theory.functor.split_epi_biproduct_comparison_section_", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison'_comp_biprod_comparison_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biproduct_comparison'_comp_biproduct_comparison", "description": "The composition in the opposite direction is equal to the identity if and only if `F` preserves\n   the biproduct, see `preserves_biproduct_of_mono_biproduct_comparison`.", "p": "mathlib"}, {"name": "category_theory.functor.biproduct_comparison", "description": "As for products, any functor between categories with biproducts gives rise to a morphism\n   `F.obj (\u2a01 f) \u27f6 \u2a01 (F.obj \u2218 f)`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_binary_biproduct_of_preserves_biproduct", "description": "A functor that preserves biproducts of a pair preserves binary biproducts.", "p": "mathlib"}, {"name": "category_theory.functor.map_binary_bicone", "description": "The image of a binary bicone under a functor.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_binary_biproducts", "description": "A functor `F` preserves binary biproducts if it preserves the binary biproduct of `X` and `Y`\n   for all `X` and `Y`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_binary_biproducts.preserves", "description": "A functor `F` preserves binary biproducts if it preserves the binary biproduct of `X` and `Y`\n   for all `X` and `Y`.", "p": "mathlib"}, {"name": "category_theory.functor.map_binary_bicone_inr", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_biprod_hom_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison'", "description": "As for coproducts, any functor between categories with binary biproducts gives rise to a\n   morphism `F.obj X \u229e F.obj Y \u27f6 F.obj (X \u229e Y)`.", "p": "mathlib"}, {"name": "category_theory.functor.biprod_comparison_fst", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.map_biprod_inv_map_desc", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_biproduct", "description": "If `F` preserves a biproduct, we get a definitionally nice isomorphism\n   `F.obj (\u2a01 f) \u2245 \u2a01 (F.obj \u2218 f)`.", "p": "mathlib"}, {"name": "category_theory.functor.map_bicone", "description": "The image of a bicone under a functor.", "p": "mathlib"}, {"name": "category_theory.functor.inl_biprod_comparison'", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biproduct.map_lift_map_biprod", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biproduct_comparison.category_theory.is_split_epi", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.biprod.lift_map_biprod", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.biproduct_comparison_\u03c0_assoc", "description": "", "p": "mathlib"}, {"name": "category_theory.limits.preserves_biproduct", "description": "A functor `F` preserves biproducts of `f` if `F` maps every bilimit bicone over `f` to a\n   bilimit bicone over `F.obj \u2218 f`.", "p": "mathlib"}, {"name": "category_theory.limits.preserves_biproduct.preserves", "description": "A functor `F` preserves biproducts of `f` if `F` maps every bilimit bicone over `f` to a\n   bilimit bicone over `F.obj \u2218 f`.", "p": "mathlib"}, {"name": "category_theory.functor.map_bicone_\u03b9", "description": "", "p": "mathlib"}, {"name": "category_theory.functor.map_biprod", "description": "If `F` preserves a binary biproduct, we get a definitionally nice isomorphism\n   `F.obj (X \u229e Y) \u2245 F.obj X \u229e F.obj Y`.", "p": "mathlib"}, {"name": "continuous.arsinh", "description": "", "p": "mathlib"}, {"name": "real.arsinh_nonpos_iff", "description": "", "p": "mathlib"}, {"name": "differentiable_on.arsinh", "description": "", "p": "mathlib"}, {"name": "real.arsinh_zero", "description": "", "p": "mathlib"}, {"name": "cont_diff.arsinh", "description": "", "p": "mathlib"}, {"name": "cont_diff_on.arsinh", "description": "", "p": "mathlib"}, {"name": "differentiable_within_at.arsinh", "description": "", "p": "mathlib"}, {"name": "cont_diff_within_at.arsinh", "description": "", "p": "mathlib"}, {"name": "differentiable.arsinh", "description": "", "p": "mathlib"}, {"name": "real.arsinh_eq_zero_iff", "description": "", "p": "mathlib"}, {"name": "real.differentiable_arsinh", "description": "", "p": "mathlib"}, {"name": "has_deriv_at.arsinh", "description": "", "p": "mathlib"}, {"name": "real.sinh_bijective", "description": "`sinh` is bijective, both injective and surjective.", "p": "mathlib"}, {"name": "real.arsinh_strict_mono", "description": "", "p": "mathlib"}, {"name": "continuous_at.arsinh", "description": "", "p": "mathlib"}, {"name": "continuous_on.arsinh", "description": "", "p": "mathlib"}, {"name": "real.sinh_order_iso_symm_apply", "description": "", "p": "mathlib"}, {"name": "real.arsinh_injective", "description": "", "p": "mathlib"}, {"name": "real.cont_diff_arsinh", "description": "", "p": "mathlib"}, {"name": "real.arsinh_inj", "description": "", "p": "mathlib"}, {"name": "has_fderiv_at.arsinh", "description": "", "p": "mathlib"}, {"name": "real.sinh_order_iso_apply", "description": "", "p": "mathlib"}, {"name": "real.sinh_homeomorph_apply", "description": "", "p": "mathlib"}, {"name": "real.exp_arsinh", "description": "", "p": "mathlib"}, {"name": "real.arsinh_bijective", "description": "", "p": "mathlib"}, {"name": "real.arsinh_sinh", "description": "`arsinh` is the left inverse of `sinh`.", "p": "mathlib"}, {"name": "real.arsinh_pos_iff", "description": "", "p": "mathlib"}, {"name": "real.arsinh_neg", "description": "", "p": "mathlib"}, {"name": "real.arsinh", "description": "`arsinh` is defined using a logarithm, `arsinh x = log (x + sqrt(1 + x^2))`.", "p": "mathlib"}, {"name": "real.sinh_equiv_symm_apply", "description": "", "p": "mathlib"}, {"name": "differentiable_at.arsinh", "description": "", "p": "mathlib"}, {"name": "real.sinh_order_iso", "description": "`real.sinh` as an `order_iso`.", "p": "mathlib"}, {"name": "has_strict_deriv_at.arsinh", "description": "", "p": "mathlib"}, {"name": "has_strict_fderiv_at.arsinh", "description": "", "p": "mathlib"}, {"name": "real.arsinh_le_arsinh", "description": "", "p": "mathlib"}, {"name": "real.has_strict_deriv_at_arsinh", "description": "", "p": "mathlib"}, {"name": "continuous_within_at.arsinh", "description": "", "p": "mathlib"}, {"name": "real.arsinh_neg_iff", "description": "", "p": "mathlib"}, {"name": "real.arsinh_lt_arsinh", "description": "", "p": "mathlib"}, {"name": "real.sinh_homeomorph_symm_apply", "description": "", "p": "mathlib"}, {"name": "real.arsinh_surjective", "description": "", "p": "mathlib"}, {"name": "cont_diff_at.arsinh", "description": "", "p": "mathlib"}, {"name": "real.continuous_arsinh", "description": "", "p": "mathlib"}, {"name": "has_fderiv_within_at.arsinh", "description": "", "p": "mathlib"}, {"name": "has_deriv_within_at.arsinh", "description": "", "p": "mathlib"}, {"name": "real.sinh_surjective", "description": "`sinh` is surjective, `\u2200 b, \u2203 a, sinh a = b`. In this case, we use `a = arsinh b`.", "p": "mathlib"}, {"name": "real.sinh_equiv", "description": "`real.sinh` as an `equiv`.", "p": "mathlib"}, {"name": "filter.tendsto.arsinh", "description": "", "p": "mathlib"}, {"name": "real.arsinh_nonneg_iff", "description": "", "p": "mathlib"}, {"name": "real.sinh_equiv_apply", "description": "", "p": "mathlib"}, {"name": "real.has_deriv_at_arsinh", "description": "", "p": "mathlib"}, {"name": "real.sinh_arsinh", "description": "`arsinh` is the right inverse of `sinh`.", "p": "mathlib"}, {"name": "real.sinh_homeomorph", "description": "`real.sinh` as a `homeomorph`.", "p": "mathlib"}, {"name": "real.cosh_arsinh", "description": "", "p": "mathlib"}, {"name": "self_adjoint.coe_re_map_spectrum", "description": "The spectrum of a selfadjoint is real", "p": "mathlib"}, {"name": "is_self_adjoint.spectral_radius_eq_nnnorm", "description": "", "p": "mathlib"}, {"name": "weak_dual.character_space.complex.star_alg_hom_class", "description": "", "p": "mathlib"}, {"name": "star_alg_hom.norm_apply_le", "description": "A star algebra homomorphism of complex C\u22c6-algebras is norm contractive.", "p": "mathlib"}, {"name": "unitary.spectrum_subset_circle", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint.mem_spectrum_eq_re", "description": "Any element of the spectrum of a selfadjoint is real.", "p": "mathlib"}, {"name": "weak_dual.complex.star_hom_class", "description": " This instance is provided instead of `star_alg_hom_class` to avoid type class inference loops.\nSee note [lower instance priority]", "p": "mathlib"}, {"name": "spectrum.subset_circle_of_unitary", "description": "", "p": "mathlib"}, {"name": "is_self_adjoint.coe_re_map_spectrum", "description": "The spectrum of a selfadjoint is real", "p": "mathlib"}, {"name": "star_alg_hom.continuous_linear_map_class", "description": " Star algebra homomorphisms between C\u22c6-algebras are continuous linear maps.\nSee note [lower instance priority]", "p": "mathlib"}, {"name": "star_alg_hom.nnnorm_apply_le", "description": "A star algebra homomorphism of complex C\u22c6-algebras is norm contractive.", "p": "mathlib"}, {"name": "self_adjoint.mem_spectrum_eq_re", "description": "Any element of the spectrum of a selfadjoint is real.", "p": "mathlib"}, {"name": "is_star_normal.spectral_radius_eq_nnnorm", "description": "", "p": "mathlib"}, {"name": "alg_hom_class.star_alg_hom_class", "description": " This is not an instance to avoid type class inference loops. See\n`weak_dual.complex.star_hom_class`.", "p": "mathlib"}, {"name": "set.finite.lt_cInf_iff", "description": "", "p": "mathlib"}, {"name": "finset.nonempty.sup'_eq_cSup_image", "description": "", "p": "mathlib"}, {"name": "finset.nonempty.cSup_mem", "description": "", "p": "mathlib"}, {"name": "set.nonempty.cInf_mem", "description": "", "p": "mathlib"}, {"name": "finset.sup'_id_eq_cSup", "description": "", "p": "mathlib"}, {"name": "set.nonempty.cSup_mem", "description": "", "p": "mathlib"}, {"name": "finset.nonempty.cSup_eq_max'", "description": "", "p": "mathlib"}, {"name": "finset.nonempty.cInf_eq_min'", "description": "", "p": "mathlib"}, {"name": "finset.sup'_eq_cSup_image", "description": "", "p": "mathlib"}, {"name": "finset.nonempty.cInf_mem", "description": "", "p": "mathlib"}, {"name": "finset.inf'_id_eq_cInf", "description": "", "p": "mathlib"}, {"name": "set.finite.cSup_lt_iff", "description": "", "p": "mathlib"}, {"name": "finset.inf'_eq_cInf_image", "description": "", "p": "mathlib"}, {"name": "finset.nonempty.sup'_id_eq_cSup", "description": "", "p": "mathlib"}, {"name": "nndist_vadd_right", "description": "", "p": "mathlib"}, {"name": "metric_space_of_normed_add_comm_group_of_add_torsor", "description": " The distance defines a metric space structure on the torsor. This\nis not an instance because it depends on `V` to define a `metric_space\nP`.", "p": "mathlib"}, {"name": "uniform_continuous_vadd", "description": "", "p": "mathlib"}, {"name": "continuous.vsub", "description": "", "p": "mathlib"}, {"name": "normed_add_torsor.to_add_torsor'", "description": "Shortcut instance to help typeclass inference out.", "p": "mathlib"}, {"name": "pseudo_metric_space_of_normed_add_comm_group_of_add_torsor", "description": " The pseudodistance defines a pseudometric space structure on the torsor. This\nis not an instance because it depends on `V` to define a `metric_space\nP`.", "p": "mathlib"}, {"name": "normed_add_torsor.to_has_continuous_vadd", "description": "", "p": "mathlib"}, {"name": "seminormed_add_comm_group.to_normed_add_torsor", "description": "A `seminormed_add_comm_group` is a `normed_add_torsor` over itself.", "p": "mathlib"}, {"name": "uniform_continuous_vsub", "description": "", "p": "mathlib"}, {"name": "dist_vadd_left", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.const_vsub_to_equiv", "description": "", "p": "mathlib"}, {"name": "nndist_eq_nnnorm_vsub'", "description": "", "p": "mathlib"}, {"name": "nndist_vsub_vsub_le", "description": "", "p": "mathlib"}, {"name": "nndist_vadd_cancel_right", "description": "", "p": "mathlib"}, {"name": "continuous_within_at.vsub", "description": "", "p": "mathlib"}, {"name": "normed_add_torsor", "description": " A `normed_add_torsor V P` is a torsor of an additive seminormed group\naction by a `seminormed_add_comm_group V` on points `P`. We bundle the pseudometric space\nstructure and require the distance to be the same as results from the\nnorm (which in fact implies the distance yields a pseudometric space, but\nbundling just the distance and using an instance for the pseudometric space\nresults in type class problems).", "p": "mathlib"}, {"name": "normed_add_torsor.to_add_torsor", "description": " A `normed_add_torsor V P` is a torsor of an additive seminormed group\naction by a `seminormed_add_comm_group V` on points `P`. We bundle the pseudometric space\nstructure and require the distance to be the same as results from the\nnorm (which in fact implies the distance yields a pseudometric space, but\nbundling just the distance and using an instance for the pseudometric space\nresults in type class problems).", "p": "mathlib"}, {"name": "normed_add_torsor.dist_eq_norm'", "description": " A `normed_add_torsor V P` is a torsor of an additive seminormed group\naction by a `seminormed_add_comm_group V` on points `P`. We bundle the pseudometric space\nstructure and require the distance to be the same as results from the\nnorm (which in fact implies the distance yields a pseudometric space, but\nbundling just the distance and using an instance for the pseudometric space\nresults in type class problems).", "p": "mathlib"}, {"name": "filter.tendsto.line_map", "description": "", "p": "mathlib"}, {"name": "dist_eq_norm_vsub'", "description": " The distance equals the norm of subtracting two points. In this\nlemma, it is necessary to have `V` as an explicit argument; otherwise\n`rw dist_eq_norm_vsub'` sometimes doesn't work.", "p": "mathlib"}, {"name": "continuous_at.vsub", "description": "", "p": "mathlib"}, {"name": "isometry_equiv.const_vsub_symm_apply", "description": "", "p": "mathlib"}, {"name": "dist_vadd_vadd_le", "description": "", "p": "mathlib"}, {"name": "filter.tendsto.vsub", "description": "", "p": "mathl