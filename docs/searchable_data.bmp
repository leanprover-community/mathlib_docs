ib"}, {"name": "rat.to_nnrat_bit0", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_one", "description": "", "p": "mathlib"}, {"name": "rat.le_coe_to_nnrat", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_hom", "description": "Coercion `\u211a\u22650 \u2192 \u211a` as a `ring_hom`.", "p": "mathlib"}, {"name": "nnrat.coe_sum", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_inj", "description": "", "p": "mathlib"}, {"name": "nnrat.bdd_below_coe", "description": "", "p": "mathlib"}, {"name": "nnrat.has_sub", "description": "", "p": "mathlib"}, {"name": "nnrat.mul_action", "description": "A `mul_action` over `\u211a` restricts to a `mul_action` over `\u211a\u22650`.", "p": "mathlib"}, {"name": "rat.lt_to_nnrat_iff_coe_lt", "description": "", "p": "mathlib"}, {"name": "nnrat.has_ordered_sub", "description": "", "p": "mathlib"}, {"name": "rat.to_nnrat_add", "description": "", "p": "mathlib"}, {"name": "nnrat.val_eq_coe", "description": "", "p": "mathlib"}, {"name": "rat.to_nnrat_one", "description": "", "p": "mathlib"}, {"name": "rat.to_nnrat_bit1", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_bit0", "description": "", "p": "mathlib"}, {"name": "rat.to_nnrat_lt_to_nnrat_iff", "description": "", "p": "mathlib"}, {"name": "nnrat.to_nnrat_coe", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_list_prod", "description": "", "p": "mathlib"}, {"name": "rat.to_nnrat_lt_to_nnrat_iff'", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_mono", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_pos", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_pow", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_zero", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_mk", "description": "", "p": "mathlib"}, {"name": "nnrat", "description": "Nonnegative rational numbers.", "p": "mathlib"}, {"name": "nnrat.denom", "description": "The denominator of a nonnegative rational.", "p": "mathlib"}, {"name": "rat.to_nnrat_of_nonpos", "description": "**Alias** of the reverse direction of `rat.to_nnrat_eq_zero`.", "p": "mathlib"}, {"name": "rat.to_nnrat_zero", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_multiset_prod", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_coe_hom", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_div", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_ne_zero", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_max", "description": "", "p": "mathlib"}, {"name": "rat.to_nnrat_pos", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_inv", "description": "", "p": "mathlib"}, {"name": "rat.to_nnrat_mul", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_nat_cast", "description": "", "p": "mathlib"}, {"name": "nnrat.denom_coe", "description": "", "p": "mathlib"}, {"name": "nnrat.to_nnrat_mono", "description": "", "p": "mathlib"}, {"name": "nnrat.distrib_mul_action", "description": "A `distrib_mul_action` over `\u211a` restricts to a `distrib_mul_action` over `\u211a\u22650`.", "p": "mathlib"}, {"name": "rat.to_nnrat_div'", "description": "", "p": "mathlib"}, {"name": "rat.to_nnrat_div", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_injective", "description": "", "p": "mathlib"}, {"name": "nnrat.module", "description": "A `module` over `\u211a` restricts to a `module` over `\u211a\u22650`.", "p": "mathlib"}, {"name": "nnrat.to_nnrat_prod_of_nonneg", "description": "", "p": "mathlib"}, {"name": "nnrat.rat.algebra", "description": "The rational numbers are an algebra over the non-negative rationals.", "p": "mathlib"}, {"name": "nnrat.ext_num_denom_iff", "description": "", "p": "mathlib"}, {"name": "nnrat.nat_abs_num_coe", "description": "", "p": "mathlib"}, {"name": "nnrat.inhabited", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_mul", "description": "", "p": "mathlib"}, {"name": "nnrat.num", "description": "The numerator of a nonnegative rational.", "p": "mathlib"}, {"name": "nnrat.bdd_above_coe", "description": "", "p": "mathlib"}, {"name": "nnrat.rec", "description": "A recursor for nonnegative rationals in terms of numerators and denominators.", "p": "mathlib"}, {"name": "rat.to_nnrat_eq_zero", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_add", "description": "", "p": "mathlib"}, {"name": "nnrat.ne_iff", "description": "", "p": "mathlib"}, {"name": "nnrat.num_div_denom", "description": "", "p": "mathlib"}, {"name": "nnrat.abs_coe", "description": "", "p": "mathlib"}, {"name": "nnrat.ext_num_denom", "description": "", "p": "mathlib"}, {"name": "nnrat.sub_def", "description": "", "p": "mathlib"}, {"name": "nnrat.to_nnrat_sum_of_nonneg", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_sub", "description": "", "p": "mathlib"}, {"name": "nnrat.densely_ordered", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_nonneg", "description": "", "p": "mathlib"}, {"name": "rat.to_nnrat", "description": "Reinterpret a rational number `q` as a non-negative rational number. Returns `0` if `q \u2264 0`.", "p": "mathlib"}, {"name": "rat.to_nnrat_add_le", "description": "", "p": "mathlib"}, {"name": "nnrat.canonically_ordered_comm_semiring", "description": "", "p": "mathlib"}, {"name": "nnrat.coe_min", "description": "", "p": "mathlib"}, {"name": "BoolAlg.to_BddDistLat", "description": "Turn a `BoolAlg` into a `BddDistLat` by forgetting its complement operation.", "p": "mathlib"}, {"name": "BoolAlg.category_theory.concrete_category", "description": "", "p": "mathlib"}, {"name": "BoolAlg.dual_obj", "description": "", "p": "mathlib"}, {"name": "BoolAlg_dual_comp_forget_to_BddDistLat", "description": "", "p": "mathlib"}, {"name": "BoolAlg.coe_to_BddDistLat", "description": "", "p": "mathlib"}, {"name": "BoolAlg.has_forget_to_HeytAlg_forget\u2082_obj_str", "description": "", "p": "mathlib"}, {"name": "BoolAlg", "description": "The category of boolean algebras.", "p": "mathlib"}, {"name": "BoolAlg.boolean_algebra", "description": "", "p": "mathlib"}, {"name": "BoolAlg.dual_equiv_inverse", "description": "", "p": "mathlib"}, {"name": "BoolAlg.dual_map", "description": "", "p": "mathlib"}, {"name": "BoolAlg.dual", "description": "`order_dual` as a functor.", "p": "mathlib"}, {"name": "BoolAlg.has_forget_to_HeytAlg", "description": "", "p": "mathlib"}, {"name": "BoolAlg.category_theory.large_category", "description": "", "p": "mathlib"}, {"name": "BoolAlg.dual_equiv", "description": "The equivalence between `BoolAlg` and itself induced by `order_dual` both ways.", "p": "mathlib"}, {"name": "BoolAlg.has_forget_to_HeytAlg_forget\u2082_obj_\u03b1", "description": "", "p": "mathlib"}, {"name": "BoolAlg.coe_of", "description": "", "p": "mathlib"}, {"name": "BoolAlg.iso.mk", "description": "Constructs an equivalence between Boolean algebras from an order isomorphism between them.", "p": "mathlib"}, {"name": "BoolAlg.of", "description": "Construct a bundled `BoolAlg` from a `boolean_algebra`.", "p": "mathlib"}, {"name": "BoolAlg.has_forget_to_HeytAlg_forget\u2082_map", "description": "", "p": "mathlib"}, {"name": "BoolAlg.iso.mk_inv", "description": "", "p": "mathlib"}, {"name": "BoolAlg.dual_equiv_functor", "description": "", "p": "mathlib"}, {"name": "BoolAlg.inhabited", "description": "", "p": "mathlib"}, {"name": "BoolAlg.iso.mk_hom", "description": "", "p": "mathlib"}, {"name": "BoolAlg.has_forget_to_BddDistLat", "description": "", "p": "mathlib"}, {"name": "BoolAlg.has_coe_to_sort", "description": "", "p": "mathlib"}, {"name": "counterexample.F.inhabited", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.list.drop_until", "description": "  The same as `list.get_rest`, except that we take the \"rest\" from the first match, rather than\nfrom the beginning, returning `[]` if there is no match.  For instance,\n```lean\n#eval [1,2].drop_until [3,1,2,4,1,2]  -- [4, 1, 2]\n```", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.val", "description": "  `val` maps `0 1 : F` to their counterparts in `\u2115`.\nWe use it to lift the linear order on `\u2115`.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.decidable_eq", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.has_one", "description": "`1` is not really needed, but it is nice to use the notation.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.f110", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.z01", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.f1", "description": "A few `simp`-lemmas to take care of trivialities in the proof of the example below.", "p": "mathlib-counterexamples"}, {"name": "counterexample.guard_decl_in_file", "description": " `guard_decl_in_file na loc` makes sure that the declaration with name `na` is in the file with\nrelative path `\"src/\" ++ \"/\".intercalate loc ++ \".lean\"`.\n```lean\n#eval guard_decl_in_file `nat.nontrivial [\"data\", \"nat\", \"basic\"]  -- does nothing\n\n#eval guard_decl_in_file `nat.nontrivial [\"not\", \"in\", \"here\"]\n-- fails giving the location 'data/nat/basic.lean'\n```\n\nThis test makes sure that the comment referring to this example is in the file claimed in the\ndoc-module to this counterexample.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.f111", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.zero_divisors_of_periodic", "description": "  This is a simple example showing that if `R` is a non-trivial ring and `A` is an additive\nmonoid with an element `a` satisfying `n \u2022 a = a` and `(n - 1) \u2022 a \u2260 a`, for some `2 \u2264 n`,\nthen `add_monoid_algebra R A` contains non-zero zero-divisors.  The elements are easy to write down:\n`[a]` and `[a] ^ (n - 1) - 1` are non-zero elements of `add_monoid_algebra R A` whose product\nis zero.\n\nObserve that such an element `a` *cannot* be invertible.  In particular, this lemma never applies\nif `A` is a group.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.f011", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.F", "description": "  `F` is the type with two elements `zero` and `one`.  We define the \"obvious\" linear order and\nabsorbing addition on it to generate our counterexample.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.zero", "description": "  `F` is the type with two elements `zero` and `one`.  We define the \"obvious\" linear order and\nabsorbing addition on it to generate our counterexample.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.one", "description": "  `F` is the type with two elements `zero` and `one`.  We define the \"obvious\" linear order and\nabsorbing addition on it to generate our counterexample.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.has_zero", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.f010", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.zero_divisors_of_torsion", "description": "  This is a simple example showing that if `R` is a non-trivial ring and `A` is an additive\nmonoid with a non-zero element `a` of finite order `oa`, then `add_monoid_algebra R A` contains\nnon-zero zero-divisors.  The elements are easy to write down:\n`\u2211 i in finset.range oa, [a] ^ i` and `[a] - 1` are non-zero elements of `add_monoid_algebra R A`\nwhose product is zero.\n\nIn particular, this applies whenever the additive monoid `A` is an additive group with a non-zero\ntorsion element.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.boom", "description": "A tactic to prove trivial goals by enumeration.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.add_comm_monoid", "description": "`F` would be a `comm_semiring`, using `min` as multiplication.  Again, we do not need this.", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.covariant_class_add_le", "description": "The `covariant_class`es asserting monotonicity of addition hold for `F`.", "p": "mathlib-counterexamples"}, {"name": "counterexample.single_zero_one", "description": "", "p": "mathlib-counterexamples"}, {"name": "counterexample.F.linear_order", "description": "", "p": "mathlib-counterexamples"}, {"name": "pnat.find_eq_one", "description": "", "p": "mathlib"}, {"name": "pnat.le_find_iff", "description": "", "p": "mathlib"}, {"name": "pnat.decidable_pred_exists_nat", "description": "", "p": "mathlib"}, {"name": "pnat.find_x", "description": "The `pnat` version of `nat.find_x`", "p": "mathlib"}, {"name": "pnat.find_le_iff", "description": "", "p": "mathlib"}, {"name": "pnat.one_le_find", "description": "", "p": "mathlib"}, {"name": "pnat.lt_find_iff", "description": "", "p": "mathlib"}, {"name": "pnat.find_lt_iff", "description": "", "p": "mathlib"}, {"name": "pnat.find_le", "description": "", "p": "mathlib"}, {"name": "pnat.find", "description": "If `p` is a (decidable) predicate on `\u2115+` and `hp : \u2203 (n : \u2115+), p n` is a proof that\nthere exists some positive natural number satisfying `p`, then `pnat.find hp` is the\nsmallest positive natural number satisfying `p`. Note that `pnat.find` is protected,\nmeaning that you can't just write `find`, even if the `pnat` namespace is open.\n\nThe API for `pnat.find` is:\n\n* `pnat.find_spec` is the proof that `pnat.find hp` satisfies `p`.\n* `pnat.find_min` is the proof that if `m < pnat.find hp` then `m` does not satisfy `p`.\n* `pnat.find_min'` is the proof that if `m` does satisfy `p` then `pnat.find hp \u2264 m`.", "p": "mathlib"}, {"name": "pnat.find_mono", "description": "", "p": "mathlib"}, {"name": "pnat.find_min", "description": "", "p": "mathlib"}, {"name": "pnat.find_eq_iff", "description": "", "p": "mathlib"}, {"name": "pnat.find_min'", "description": "", "p": "mathlib"}, {"name": "pnat.find_spec", "description": "", "p": "mathlib"}, {"name": "pnat.find_comp_succ", "description": "", "p": "mathlib"}, {"name": "inhomogeneous_cochains.d_apply", "description": "", "p": "mathlib"}, {"name": "group_cohomology.inhomogeneous_cochains", "description": " Given a `k`-linear `G`-representation `A`, this is the complex of inhomogeneous cochains\n$$0 \\to \\mathrm{Fun}(G^0, A) \\to \\mathrm{Fun}(G^1, A) \\to \\mathrm{Fun}(G^2, A) \\to \\dots$$\nwhich calculates the group cohomology of `A`.", "p": "mathlib"}, {"name": "group_cohomology_iso_Ext", "description": " The `n`th group cohomology of a `k`-linear `G`-representation `A` is isomorphic to\n`Ext\u207f(k, A)` (taken in `Rep k G`), where `k` is a trivial `k`-linear `G`-representation.", "p": "mathlib"}, {"name": "group_cohomology.linear_yoneda_obj_resolution_d_apply", "description": "", "p": "mathlib"}, {"name": "inhomogeneous_cochains.d", "description": " The differential in the complex of inhomogeneous cochains used to\ncalculate group cohomology.", "p": "mathlib"}, {"name": "inhomogeneous_cochains.d_eq", "description": " The theorem that our isomorphism `Fun(G\u207f, A) \u2245 Hom(k[G\u207f\u207a\u00b9], A)` (where the righthand side is\nmorphisms in `Rep k G`) commutes with the differentials in the complex of inhomogeneous cochains\nand the homogeneous `linear_yoneda_obj_resolution`.", "p": "mathlib"}, {"name": "group_cohomology.linear_yoneda_obj_resolution", "description": " The complex `Hom(P, A)`, where `P` is the standard resolution of `k` as a trivial `k`-linear\n`G`-representation.", "p": "mathlib"}, {"name": "group_cohomology.inhomogeneous_cochains_iso", "description": " Given a `k`-linear `G`-representation `A`, the complex of inhomogeneous cochains is isomorphic\nto `Hom(P, A)`, where `P` is the standard resolution of `k` as a trivial `G`-representation.", "p": "mathlib"}, {"name": "group_cohomology", "description": " The group cohomology of a `k`-linear `G`-representation `A`, as the cohomology of its complex\nof inhomogeneous cochains.", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.to_embedding", "description": "An elementary embedding is also a first-order embedding.", "p": "mathlib"}, {"name": "first_order.language.elementary_substructure.elementarily_equivalent", "description": "", "p": "mathlib"}, {"name": "first_order.language.substructure.to_elementary_substructure", "description": "Bundles a substructure satisfying the Tarski-Vaught test as an elementary substructure.", "p": "mathlib"}, {"name": "first_order.language.substructure.is_elementary_of_exists", "description": "The Tarski-Vaught test for elementarity of a substructure.", "p": "mathlib"}, {"name": "first_order.language.equiv.to_elementary_embedding_to_embedding", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.comp", "description": "Composition of elementary embeddings", "p": "mathlib"}, {"name": "first_order.language.elementary_substructure.set_like", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_diagram", "description": "The elementary diagram of an `L`-structure is the set of all sentences with parameters it\n satisfies.", "p": "mathlib"}, {"name": "first_order.language.embedding.to_elementary_embedding", "description": "Bundles an embedding satisfying the Tarski-Vaught test as an elementary embedding.", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.injective", "description": "", "p": "mathlib"}, {"name": "first_order.language.equiv.to_elementary_embedding", "description": "A first-order equivalence is also an elementary embedding.", "p": "mathlib"}, {"name": "first_order.language.equiv.coe_to_elementary_embedding", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_substructure.coe_subtype", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.map_fun", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_substructure.Theory_model", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_substructure.inhabited", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.map_bounded_formula", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.map_formula", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.of_models_elementary_diagram", "description": "The canonical elementary embedding of an `L`-structure into any model of its elementary diagram", "p": "mathlib"}, {"name": "first_order.language.realize_term_substructure", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.refl", "description": "The identity elementary embedding from a structure to itself", "p": "mathlib"}, {"name": "first_order.language.elementary_substructure.has_top", "description": "The substructure `M` of the structure `M` is elementary.", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.map_rel", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.ext", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.ext_iff", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.to_hom", "description": "An elementary embedding is also a first-order homomorphism.", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.fun_like", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.refl_apply", "description": "", "p": "mathlib"}, {"name": "first_order.language.embedding.to_elementary_embedding_to_fun", "description": "", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding", "description": "An elementary embedding of first-order structures is an embedding that commutes with the\n realizations of formulas.", "p": "mathlib"}, {"name": "first_order.language.elementary_embedding.to_fun", "description": "An elementary embedding of first-order structures is an embedding th