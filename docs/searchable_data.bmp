omputability.\u0393'.bit", "description": "A standard Turing machine alphabet, consisting of blank,bit0,bit1,bra,ket,comma.", "p": "mathlib"}, {"name": "computability.\u0393'.bra", "description": "A standard Turing machine alphabet, consisting of blank,bit0,bit1,bra,ket,comma.", "p": "mathlib"}, {"name": "computability.\u0393'.ket", "description": "A standard Turing machine alphabet, consisting of blank,bit0,bit1,bra,ket,comma.", "p": "mathlib"}, {"name": "computability.\u0393'.comma", "description": "A standard Turing machine alphabet, consisting of blank,bit0,bit1,bra,ket,comma.", "p": "mathlib"}, {"name": "computability.\u0393'.decidable_eq", "description": "", "p": "mathlib"}, {"name": "computability.fin_encoding_bool_bool", "description": "A fin_encoding of bool in bool.", "p": "mathlib"}, {"name": "lie_module.coe_linear_map_max_triv_linear_map_equiv_lie_module_hom", "description": "", "p": "mathlib"}, {"name": "lie_module.coe_max_triv_linear_map_equiv_lie_module_hom", "description": "", "p": "mathlib"}, {"name": "is_lie_abelian", "description": "A Lie algebra is Abelian iff it is trivial as a Lie module over itself.", "p": "mathlib"}, {"name": "lie_module.coe_max_triv_equiv_apply", "description": "", "p": "mathlib"}, {"name": "lie_module.mem_ker", "description": "", "p": "mathlib"}, {"name": "lie_algebra.self_module_ker_eq_center", "description": "", "p": "mathlib"}, {"name": "lie_module.max_triv_equiv_of_refl_eq_refl", "description": "", "p": "mathlib"}, {"name": "commutative_ring_iff_abelian_lie_ring", "description": "", "p": "mathlib"}, {"name": "lie_module.max_triv_equiv", "description": "The maximal trivial submodules of Lie-equivalent Lie modules are Lie-equivalent.", "p": "mathlib"}, {"name": "lie_algebra.center.is_lie_abelian", "description": "", "p": "mathlib"}, {"name": "lie_module.coe_max_triv_hom_apply", "description": "", "p": "mathlib"}, {"name": "lie_module.coe_max_triv_linear_map_equiv_lie_module_hom_symm", "description": "", "p": "mathlib"}, {"name": "lie_submodule.trivial_lie_oper_zero", "description": "", "p": "mathlib"}, {"name": "lie_module.ideal_oper_max_triv_submodule_eq_bot", "description": "", "p": "mathlib"}, {"name": "lie_module.mem_max_triv_submodule", "description": "", "p": "mathlib"}, {"name": "lie_module.trivial_iff_le_maximal_trivial", "description": "", "p": "mathlib"}, {"name": "lie_ideal.is_lie_abelian_of_trivial", "description": "", "p": "mathlib"}, {"name": "trivial_lie_zero", "description": "", "p": "mathlib"}, {"name": "function.surjective.is_lie_abelian", "description": "", "p": "mathlib"}, {"name": "lie_module.max_triv_submodule", "description": "The largest submodule of a Lie module `M` on which the Lie algebra `L` acts trivially.", "p": "mathlib"}, {"name": "lie_module.coe_linear_map_max_triv_linear_map_equiv_lie_module_hom_symm", "description": "", "p": "mathlib"}, {"name": "lie_algebra.is_lie_abelian_iff_center_eq_top", "description": "", "p": "mathlib"}, {"name": "lie_algebra.abelian_of_le_center", "description": "", "p": "mathlib"}, {"name": "lie_module.le_max_triv_iff_bracket_eq_bot", "description": "", "p": "mathlib"}, {"name": "function.injective.is_lie_abelian", "description": "", "p": "mathlib"}, {"name": "lie_module.max_triv_hom", "description": "`max_triv_submodule` is functorial.", "p": "mathlib"}, {"name": "lie_algebra.ad_ker_eq_self_module_ker", "description": "", "p": "mathlib"}, {"name": "lie_module.max_triv_linear_map_equiv_lie_module_hom", "description": " A linear map between two Lie modules is a morphism of Lie modules iff the Lie algebra action\non it is trivial.", "p": "mathlib"}, {"name": "lie_submodule.lie_abelian_iff_lie_self_eq_bot", "description": "", "p": "mathlib"}, {"name": "lie_algebra.center", "description": " The center of a Lie algebra is the set of elements that commute with everything. It can\nbe viewed as the maximal trivial submodule of the Lie algebra as a Lie module over itself via the\nadjoint representation.", "p": "mathlib"}, {"name": "lie_module.is_trivial", "description": "A Lie (ring) module is trivial iff all brackets vanish.", "p": "mathlib"}, {"name": "lie_module.is_trivial.trivial", "description": "A Lie (ring) module is trivial iff all brackets vanish.", "p": "mathlib"}, {"name": "lie_module.is_trivial_iff_max_triv_eq_top", "description": "", "p": "mathlib"}, {"name": "lie_algebra.is_lie_abelian_bot", "description": "", "p": "mathlib"}, {"name": "lie_abelian_iff_equiv_lie_abelian", "description": "", "p": "mathlib"}, {"name": "lie_module.max_triv_equiv_of_equiv_symm_eq_symm", "description": "", "p": "mathlib"}, {"name": "lie_module.max_triv_submodule.is_trivial", "description": "", "p": "mathlib"}, {"name": "lie_module.ker", "description": "The kernel of the action of a Lie algebra `L` on a Lie module `M` as a Lie ideal in `L`.", "p": "mathlib"}, {"name": "lie_submodule.quotient.map_mk'_eq_bot_le", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.mk'", "description": "`lie_submodule.quotient.mk` as a `lie_module_hom`.", "p": "mathlib"}, {"name": "lie_submodule.quotient.lie_submodule_invariant", "description": " Given a Lie module `M` over a Lie algebra `L`, together with a Lie submodule `N \u2286 M`, there\nis a natural linear map from `L` to the endomorphisms of `M` leaving `N` invariant.", "p": "mathlib"}, {"name": "lie_hom.quot_ker_equiv_range_to_lie_hom_apply", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.mk_eq_zero", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.is_central_scalar", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.action_as_endo_map_bracket", "description": " Given a Lie module `M` over a Lie algebra `L`, together with a Lie submodule `N \u2286 M`, there is\na natural bracket action of `L` on the quotient `M/N`.", "p": "mathlib"}, {"name": "lie_submodule.quotient.mk", "description": " Map sending an element of `M` to the corresponding element of `M/N`, when `N` is a\nlie_submodule of the lie_module `N`.", "p": "mathlib"}, {"name": "lie_submodule.quotient.inhabited", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.mk_bracket", "description": "", "p": "mathlib"}, {"name": "lie_hom.quot_ker_equiv_range_inv_fun", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.module", "description": "", "p": "mathlib"}, {"name": "lie_hom.quot_ker_equiv_range", "description": "The first isomorphism theorem for morphisms of Lie algebras.", "p": "mathlib"}, {"name": "lie_submodule.quotient.lie_quotient_lie_module", "description": "The quotient of a Lie module by a Lie submodule, is a Lie module.", "p": "mathlib"}, {"name": "lie_submodule.quotient.is_quotient_mk", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.mk'_to_linear_map_apply", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.lie_module_hom_ext", "description": " Two `lie_module_hom`s from a quotient lie module are equal if their compositions with\n`lie_submodule.quotient.mk'` are equal.\n\nSee note [partially-applied ext lemmas].", "p": "mathlib"}, {"name": "lie_submodule.quotient.add_comm_group", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.module'", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.lie_quotient_lie_ring", "description": "", "p": "mathlib"}, {"name": "lie_hom.quot_ker_equiv_range_to_lie_hom_to_linear_map_apply", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.lie_quotient_lie_algebra", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.action_as_endo_map", "description": " Given a Lie module `M` over a Lie algebra `L`, together with a Lie submodule `N \u2286 M`, there\nis a natural Lie algebra morphism from `L` to the linear endomorphism of the quotient `M/N`.", "p": "mathlib"}, {"name": "lie_submodule.quotient.mk'_ker", "description": "", "p": "mathlib"}, {"name": "lie_submodule.has_quotient", "description": "The quotient of a Lie module by a Lie submodule. It is a Lie module.", "p": "mathlib"}, {"name": "lie_submodule.quotient.lie_quotient_lie_ring_module", "description": "", "p": "mathlib"}, {"name": "lie_submodule.quotient.lie_quotient_has_bracket", "description": "", "p": "mathlib"}, {"name": "seminorm.closed_ball_finset_sup'", "description": "", "p": "mathlib"}, {"name": "seminorm.le_def", "description": "", "p": "mathlib"}, {"name": "seminorm.closed_ball_sup", "description": "", "p": "mathlib"}, {"name": "seminorm.mem_ball", "description": "", "p": "mathlib"}, {"name": "seminorm.smul_closed_ball_subset", "description": "", "p": "mathlib"}, {"name": "seminorm.ball_smul_ball", "description": "", "p": "mathlib"}, {"name": "seminorm.add_monoid", "description": "", "p": "mathlib"}, {"name": "seminorm.bdd_below_range_add", "description": "Auxiliary lemma to show that the infimum of seminorms is well-defined.", "p": "mathlib"}, {"name": "seminorm.conditionally_complete_lattice", "description": " `seminorm \ud835\udd5c E` is a conditionally complete lattice.\n\nNote that, while `inf`, `sup` and `Sup` have good definitional properties (corresponding to\n`seminorm.has_inf`, `seminorm.has_sup` and `seminorm.has_Sup` respectively), `Inf s` is just\ndefined as the supremum of the lower bounds of `s`, which is not really useful in practice. If you\nneed to use `Inf` on seminorms, then you should probably provide a more workable definition first,\nbut this is unlikely to happen so we keep the \"bad\" definition for now.", "p": "mathlib"}, {"name": "seminorm.mem_ball_zero", "description": "", "p": "mathlib"}, {"name": "seminorm.restrict_scalars_closed_ball", "description": "", "p": "mathlib"}, {"name": "seminorm.has_smul", "description": "Any action on `\u211d` which factors through `\u211d\u22650` applies to a seminorm.", "p": "mathlib"}, {"name": "seminorm.closed_ball_eq_emptyset", "description": "", "p": "mathlib"}, {"name": "seminorm.seminorm_class", "description": "", "p": "mathlib"}, {"name": "seminorm.zero_comp", "description": "", "p": "mathlib"}, {"name": "seminorm.comp", "description": "Composition of a seminorm with a linear map is a seminorm.", "p": "mathlib"}, {"name": "seminorm.finset_sup_apply_lt", "description": "", "p": "mathlib"}, {"name": "seminorm.ball_antitone", "description": "", "p": "mathlib"}, {"name": "seminorm.mem_closed_ball", "description": "", "p": "mathlib"}, {"name": "seminorm.ordered_cancel_add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "seminorm.uniform_continuous", "description": "", "p": "mathlib"}, {"name": "absorbent_ball", "description": "Balls containing the origin are absorbent.", "p": "mathlib"}, {"name": "seminorm.add_apply", "description": "", "p": "mathlib"}, {"name": "seminorm.ball_zero_absorbs_ball_zero", "description": "", "p": "mathlib"}, {"name": "seminorm.balanced_ball_zero", "description": "Seminorm-balls at the origin are balanced.", "p": "mathlib"}, {"name": "seminorm.bdd_above_iff", "description": "", "p": "mathlib"}, {"name": "seminorm.neg_ball", "description": "", "p": "mathlib"}, {"name": "seminorm.smul_ball_preimage", "description": "", "p": "mathlib"}, {"name": "seminorm.inf_apply", "description": "", "p": "mathlib"}, {"name": "seminorm.continuous'", "description": "", "p": "mathlib"}, {"name": "ball_norm_seminorm", "description": "", "p": "mathlib"}, {"name": "seminorm.restrict_scalars", "description": " Reinterpret a seminorm over a field `\ud835\udd5c'` as a seminorm over a smaller field `\ud835\udd5c`. This will\ntypically be used with `is_R_or_C \ud835\udd5c'` and `\ud835\udd5c = \u211d`.", "p": "mathlib"}, {"name": "seminorm.finset_sup_apply", "description": "", "p": "mathlib"}, {"name": "seminorm.absorbent_ball_zero", "description": "Seminorm-balls at the origin are absorbent.", "p": "mathlib"}, {"name": "seminorm.to_add_group_seminorm", "description": "", "p": "mathlib"}, {"name": "seminorm.vadd_ball", "description": "The image of a ball under addition with a singleton is ano