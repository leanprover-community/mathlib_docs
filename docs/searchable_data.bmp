 that extend\n`slash_invariant_form_class` by requiring that the functions be holomorphic and zero\nat infinity.", "p": "mathlib"}, {"name": "cusp_form_class.holo", "description": "`cusp_form_class F \u0393 k` says that `F` is a type of bundled functions that extend\n`slash_invariant_form_class` by requiring that the functions be holomorphic and zero\nat infinity.", "p": "mathlib"}, {"name": "cusp_form_class.zero_at_infty", "description": "`cusp_form_class F \u0393 k` says that `F` is a type of bundled functions that extend\n`slash_invariant_form_class` by requiring that the functions be holomorphic and zero\nat infinity.", "p": "mathlib"}, {"name": "modular_form.sub_apply", "description": "", "p": "mathlib"}, {"name": "cusp_form_class.cusp_form", "description": "", "p": "mathlib"}, {"name": "cusp_form.module", "description": "", "p": "mathlib"}, {"name": "cusp_form.add_apply", "description": "", "p": "mathlib"}, {"name": "modular_form.zero_apply", "description": "", "p": "mathlib"}, {"name": "cusp_form", "description": "These are `slash_invariant_form`s that are holomophic and zero at infinity.", "p": "mathlib"}, {"name": "cusp_form.to_fun", "description": "These are `slash_invariant_form`s that are holomophic and zero at infinity.", "p": "mathlib"}, {"name": "cusp_form.slash_action_eq'", "description": "These are `slash_invariant_form`s that are holomophic and zero at infinity.", "p": "mathlib"}, {"name": "cusp_form.holo'", "description": "These are `slash_invariant_form`s that are holomophic and zero at infinity.", "p": "mathlib"}, {"name": "cusp_form.zero_at_infty'", "description": "These are `slash_invariant_form`s that are holomophic and zero at infinity.", "p": "mathlib"}, {"name": "modular_form.coe_neg", "description": "", "p": "mathlib"}, {"name": "modular_form.has_add", "description": "", "p": "mathlib"}, {"name": "cusp_form.has_zero", "description": "", "p": "mathlib"}, {"name": "modular_form.one_coe_eq_one", "description": "", "p": "mathlib"}, {"name": "