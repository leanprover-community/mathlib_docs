y element.\n\nThis is available as an instance in the `pointwise` locale.\n\nThis is a stronger version of `submodule.pointwise_distrib_mul_action`. Note that `add_smul` does\nnot hold so this cannot be stated as a `module`.", "p": "mathlib"}, {"name": "submodule.span_smul", "description": "", "p": "mathlib"}, {"name": "submodule.neg_eq_self", "description": "", "p": "mathlib"}, {"name": "submodule.neg_bot", "description": "", "p": "mathlib"}, {"name": "submodule.pointwise_add_comm_monoid", "description": "", "p": "mathlib"}, {"name": "submodule.neg_order_iso", "description": "`submodule.has_pointwise_neg` as an order isomorphism.", "p": "mathlib"}, {"name": "submodule.smul_mem_pointwise_smul", "description": "", "p": "mathlib"}, {"name": "submodule.neg_infi", "description": "", "p": "mathlib"}, {"name": "submodule.closure_neg", "description": "", "p": "mathlib"}, {"name": "submodule.smul_bot'", "description": "See also `submodule.smul_bot`.", "p": "mathlib"}, {"name": "submodule.neg_le_neg", "description": "", "p": "mathlib"}, {"name": "submodule.pointwise_smul_to_add_subgroup", "description": "", "p": "mathlib"}, {"name": "submodule.smul_le_self_of_tower", "description": "", "p": "mathlib"}, {"name": "submodule.add_eq_sup", "description": "", "p": "mathlib"}, {"name": "submodule.neg_sup", "description": "", "p": "mathlib"}, {"name": "submodule.neg_to_add_submonoid", "description": "", "p": "mathlib"}, {"name": "submodule.coe_set_neg", "description": "", "p": "mathlib"}, {"name": "submodule.smul_span", "description": "", "p": "mathlib"}, {"name": "submodule.smul_sup'", "description": "See also `submodule.smul_sup`.", "p": "mathlib"}, {"name": "submodule.zero_eq_bot", "description": "", "p": "mathlib"}, {"name": "submodule.neg_top", "description": "", "p": "mathlib"}, {"name": "submodule.coe_pointwise_smul", "description": "", "p": "mathlib"}, {"name": "add_comm_semigroup.is_central_vadd", "description": "", "p": "mathlib"}, {"name": "mul_opposite.smul_comm_class", 