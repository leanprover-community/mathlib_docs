, {"name": "linear_map.conjugate_i", "description": "", "p": "mathlib"}, {"name": "pi.const_ring_hom_apply", "description": "", "p": "mathlib"}, {"name": "pi.non_unital_comm_semiring", "description": "", "p": "mathlib"}, {"name": "pi.eval_non_unital_ring_hom", "description": " Evaluation of functions into an indexed collection of non-unital rings at a point is a\nnon-unital ring homomorphism. This is `function.eval` as a `non_unital_ring_hom`.", "p": "mathlib"}, {"name": "pi.non_assoc_semiring", "description": "", "p": "mathlib"}, {"name": "pi.comm_semiring", "description": "", "p": "mathlib"}, {"name": "pi.non_unital_ring", "description": "", "p": "mathlib"}, {"name": "pi.eval_ring_hom_apply", "description": "", "p": "mathlib"}, {"name": "non_unital_ring_hom.comp_left", "description": " Non-unital ring homomorphism between the function spaces `I \u2192 \u03b1` and `I \u2192 \u03b2`, induced by a\nnon-unital ring homomorphism `f` between `\u03b1` and `\u03b2`.", "p": "mathlib"}, {"name": "pi.non_unital_ring_hom_to_fun", "description": "", "p": "mathlib"}, {"name": "non_unital_ring_hom.comp_left_to_fun", "description": "", "p": "mathlib"}, {"name": "pi.non_unital_semiring", "description": "", "p": "mathlib"}, {"name": "pi.ring_hom_injective", "description": "", "p": "mathlib"}, {"name": "pi.eval_non_unital_ring_hom_to_fun", "description": "", "p": "mathlib"}, {"name": "pi.non_assoc_ring", "description": "", "p": "mathlib"}, {"name": "pi.non_unital_ring_hom_injective", "description": "", "p": "mathlib"}, {"name": "pi.non_unital_comm_ring", "description": "", "p": "mathlib"}, {"name": "pi.non_unital_non_assoc_ring", "description": "", "p": "mathlib"}, {"name": "pi.const_ring_hom", "description": "`function.const` as a `ring_hom`.", "p": "mathlib"}, {"name": "pi.const_non_unital_ring_hom", "description": "`function.const` as a `non_unital_ring_hom`.", "p": "mathlib"}, {"name": "pi.non_unital_ring_hom", "description": " A family of non-unital ring homomorphisms `f a : \u